﻿﻿---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');

const productOptions = [
  'HN300 Hydraulic Oil Press',
  'HN325 Hydraulic Oil Press',
  'HN325S Hydraulic Oil Press',
  'HN355 Hydraulic Oil Press',
  'HN400 Hydraulic Oil Press',
  'HN426 Hydraulic Oil Press',
  'HN480B Hydraulic Oil Press',
  'HN500 Hydraulic Oil Press',
  'Sesame Special Oil Press',
  'Coconut/VCO Special Oil Press',
  'Barrel Type Oil Press',
  'Custom / Other Product',
];

const countryOptions = [
  'India', 'Nigeria', 'Pakistan', 'Philippines', 'Kenya',
  'Saudi Arabia', 'UAE', 'Egypt', 'Ghana', 'Tanzania', 'Indonesia',
  'Vietnam', 'Thailand', 'Myanmar', 'Sri Lanka', 'Turkey', 'Iraq',
  'Uganda', 'Kazakhstan', 'Uzbekistan', 'Other',
];

const whatToExpect = [
  { step: '1', title: 'Quote Typically Within 24 Hours', desc: 'We aim to provide a detailed quotation with specifications, pricing, and delivery timeline within one business day.' },
  { step: '2', title: 'Technical Consultation', desc: 'Our engineers discuss your specific oil seeds, capacity needs, and production setup.' },
  { step: '3', title: 'Custom Solution', desc: 'Get a tailored recommendation with the right machine model and configuration for your business.' },
  { step: '4', title: 'Factory Tour Available', desc: 'Visit our factory in Qingzhou or schedule a live video tour to see production firsthand.' },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact Us', item: 'https://www.hydoilpress.com/contact' },
  ],
};
---

<BaseLayout title={t.contact.title} description="Contact Haonuo Machinery for hydraulic oil press machine inquiries. Get a quote within 24 hours. WhatsApp, Email, Phone support available." jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Contact Us</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.contact.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.contact.subtitle}</p>
      <div class="mt-6 inline-flex items-center gap-2 bg-green-500/20 text-green-400 px-4 py-2 rounded-full text-sm font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        We respond within 24 hours
      </div>
    </div>
  </section>

  <!-- Quick Contact Methods -->
  <!-- 移除，避免和右侧侧边栏重复 -->

  <!-- Main Contact Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-steel-100 shadow-sm">
            <h2 class="font-display text-2xl text-charcoal-900 mb-2">Send Us an Inquiry</h2>
            <p class="text-sm text-steel-500 mb-6">Fill out the form below and our team will get back to you within 24 hours with a detailed quotation.</p>
            <form id="contact-form" data-form-type="contact" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.name} *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Your full name"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.email} *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="your@email.com"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-medium text-charcoal-900 mb-1.5">Phone / WhatsApp</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="+1 234 567 8900"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.company}</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    placeholder="Your company name"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="country" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.country} *</label>
                  <input
                    type="text"
                    id="country"
                    name="country"
                    list="country-list"
                    required
                    placeholder="Type or select your country"
                    autocomplete="off"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                  <datalist id="country-list">
                    {countryOptions.map(country => (
                      <option value={country}>{country}</option>
                    ))}
                  </datalist>
                </div>
                <div>
                  <label for="product" class="block text-sm font-medium text-charcoal-900 mb-1.5">Product Interest *</label>
                  <input
                    type="text"
                    id="product"
                    name="product"
                    list="product-list"
                    required
                    placeholder="Type or select a product"
                    autocomplete="off"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                  <datalist id="product-list">
                    {productOptions.map(product => (
                      <option value={product}>{product}</option>
                    ))}
                  </datalist>
                </div>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.message} *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Tell us about your requirements: oil seeds to process, daily production capacity needed, budget range, etc."
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm resize-none"
                ></textarea>
              </div>

              <button type="submit" class="btn-primary text-base w-full justify-center">
                {t.contact.submit}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </form>
            <div id="form-success" class="hidden text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-green-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">Inquiry Sent!</h3>
              <p class="text-steel-500">Thank you for contacting us. We'll get back to you within 24 hours.</p>
            </div>
          </div>
        </div>

        <!-- Contact Info Sidebar -->
        <div>
          <div class="bg-steel-900 rounded-2xl p-6 md:p-8 text-white mb-6">
            <h2 class="font-display text-2xl mb-6">Contact Information</h2>
            <div class="space-y-5">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.phone}</div>
                  <a href="tel:+8618957149128" class="font-medium hover:text-amber-500 transition-colors">+86 18957149128</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.email}</div>
                  <a href="mailto:info@hydoilpress.com" class="font-medium hover:text-amber-500 transition-colors">info@hydoilpress.com</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-green-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.whatsapp}</div>
                  <a href="https://wa.me/8618957149128" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-amber-500 transition-colors">+86 18957149128</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="currentColor"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18z"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.wechat}</div>
                  <div class="font-medium">18957149128</div>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.address}</div>
                  <a href="https://maps.google.com/?q=Qingzhou+Weifang+Shandong+China" target="_blank" rel="noopener noreferrer" class="font-medium text-sm hover:text-amber-500 transition-colors">Qingzhou, Weifang, Shandong, China</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.workingHours}</div>
                  <div class="font-medium text-sm">Mon - Sat: 8:00 - 18:00 (GMT+8)</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Contact Buttons -->
          <div class="space-y-3">
            <a
              href="https://wa.me/8618957149128?text=Hello, I'm interested in your oil press products."
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
              {t.chat.whatsapp}
            </a>
            <a
              href="mailto:info@hydoilpress.com"
              class="flex items-center justify-center gap-2 w-full bg-amber-500 hover:bg-amber-600 text-charcoal-900 font-semibold px-6 py-3 rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {t.chat.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">What to Expect After You Contact Us</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">Our streamlined inquiry process ensures you get the information and support you need quickly.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whatToExpect.map((item, i) => (
          <div class="reveal bg-white p-6 rounded-2xl shadow-sm text-center" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-12 h-12 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center font-display text-xl text-charcoal-900">{item.step}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">Our Location</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-8 reveal">Shandong Haonuo Machinery Equipment Group Co., Ltd. is located in Qingzhou, Weifang, Shandong Province, China — a major machinery manufacturing hub with convenient transportation access.</p>
      <div class="reveal rounded-2xl overflow-hidden border border-steel-200 shadow-sm">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d104856.876!2d118.47!3d36.69!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x35fda3e8c4c4c4c4%3A0x1234567890abcdef!2sQingzhou%2C%20Weifang%2C%20Shandong%2C%20China!5e0!3m2!1sen!2s!4v1700000000000"
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Haonuo Machinery Location - Qingzhou, Weifang, Shandong, China"
        ></iframe>
      </div>
      <div class="mt-6 text-center">
        <a href="https://maps.google.com/?q=Qingzhou+Weifang+Shandong+China" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-amber-600 hover:text-amber-700 font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Open in Google Maps
        </a>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = fd.get('name') || '';
      const email = fd.get('email') || '';
      const phone = fd.get('phone') || '';
      const company = fd.get('company') || '';
      const country = fd.get('country') || '';
      const product = fd.get('product') || '';
      const message = fd.get('message') || '';

      const subject = `Inquiry from ${name} - ${product}`;
      const body = `Name: ${name}\nEmail: ${email}\nPhone/WhatsApp: ${phone}\nCompany: ${company}\nCountry: ${country}\nProduct Interest: ${product}\n\nMessage:\n${message}`;
      const mailto = `mailto:info@hydoilpress.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;

      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    });
  </script>
</BaseLayout>
