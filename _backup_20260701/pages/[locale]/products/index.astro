---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');

const categoryOrder: Record<string, number> = {
  'hydraulic-oil-press': 1,
  'seed-processing-equipment': 2,
  'roasting-steaming-equipment': 3,
  'filtration-refining-equipment': 4,
};

const hydraulicOrder: Record<string, number> = {
  'mini-hydraulic-oil-press': 1,
  'standard-hydraulic-oil-press': 2,
  'stainless-steel-hydraulic-oil-press': 3,
  'heavy-duty-hydraulic-oil-press': 4,
  'medium-hydraulic-oil-press': 5,
  'cold-press-hydraulic-oil-press': 6,
  'high-pressure-hydraulic-oil-press': 7,
  'ultra-high-pressure-cold-press': 8,
  'ultra-high-pressure-hydraulic-oil-press': 9,
  'sesame-oil-hydraulic-press': 10,
  'coconut-oil-hydraulic-press': 11,
  'large-barrel-hydraulic-oil-press': 12,
  'animal-fat-hydraulic-press': 13,
};

const sortedProducts = allProducts.sort((a, b) => {
  const catA = categoryOrder[a.data.category] ?? 99;
  const catB = categoryOrder[b.data.category] ?? 99;
  if (catA !== catB) return catA - catB;

  if (a.data.category === 'hydraulic-oil-press') {
    const orderA = hydraulicOrder[a.slug] ?? 99;
    const orderB = hydraulicOrder[b.slug] ?? 99;
    if (orderA !== orderB) return orderA - orderB;
  }

  const numA = parseInt(a.data.model.replace(/\D/g, '')) || 0;
  const numB = parseInt(b.data.model.replace(/\D/g, '')) || 0;
  return numA - numB;
});
const allCategories = await getCollection('categories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
  ],
};
---

<BaseLayout locale={currentLocale} title={t.products.title} description={t.products.subtitle} jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.products.title}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.products.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.products.subtitle}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filter -->
        <aside class="lg:w-56 shrink-0">
          <div class="sticky top-24">
            <h3 class="font-display text-lg text-charcoal-900 mb-4">{t.products.allCategories}</h3>
            <nav class="space-y-1">
              <a
                href={localePath('/products')}
                class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-amber-500 text-charcoal-900"
              >
                {t.products.allCategories}
              </a>
              {sortedCategories.map(cat => (
                <a
                  href={localePath(`/products/${cat.slug}`)}
                  class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  {cat.data.name[currentLocale] || cat.data.name.en}
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="flex-1">
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {sortedProducts.map((product) => (
              <a
                href={localePath(`/products/${product.slug}`)}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden relative">
                  <img
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo%20on%20white%20background%2C%20professional%20product%20photography&image_size=landscape_4_3'"
                  />
                  <div class="absolute inset-0 bg-steel-900/0 group-hover:bg-steel-900/20 transition-colors duration-300 flex items-center justify-center">
                    <span class="bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-medium text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      {t.products.viewDetails}
                    </span>
                  </div>
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
                  <p class="text-sm text-steel-500 mb-3 line-clamp-2">{product.body?.slice(0, 100)}...</p>
                  <div class="flex flex-wrap gap-2">
                    {product.data.applicableSeeds.slice(0, 3).map(seed => (
                      <span class="text-xs bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full">
                        {seed}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
