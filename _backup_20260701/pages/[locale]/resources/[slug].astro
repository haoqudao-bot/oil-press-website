---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  const locales: Locale[] = ['fr', 'ar', 'id'];
  return locales.flatMap(locale =>
    resources.map(resource => ({
      params: { locale, slug: resource.slug },
      props: { resource },
    }))
  );
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const { resource } = Astro.props;
const t = getTranslations(currentLocale);
const { Content } = await resource.render();

const typeLabels: Record<string, string> = {
  comparison: t.resources.comparison,
  guide: t.resources.guide,
  blog: t.resources.blog,
};

const typeColors: Record<string, string> = {
  comparison: 'bg-blue-100 text-blue-700',
  guide: 'bg-green-100 text-green-700',
  blog: 'bg-purple-100 text-purple-700',
};

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}
---

<BaseLayout locale={currentLocale} title={resource.data.title[currentLocale] || resource.data.title.en} description={resource.data.description[currentLocale] || resource.data.description.en} keywords={resource.data.seoKeywords}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/resources')} class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{resource.data.title[currentLocale] || resource.data.title.en}</span>
      </nav>
    </div>
  </section>

  <article class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Article Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
            {typeLabels[resource.data.type] || resource.data.type}
          </span>
          <time class="text-sm text-steel-400">
            {resource.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-4">
          {resource.data.title[currentLocale] || resource.data.title.en}
        </h1>
        <p class="text-lg text-steel-600 leading-relaxed">
          {resource.data.description[currentLocale] || resource.data.description.en}
        </p>
      </div>

      <!-- Article Content -->
      <div class="prose-solution max-w-none text-steel-700 leading-relaxed">
        <Content />
      </div>

      <!-- CTA -->
      <div class="mt-12 p-8 bg-amber-50 rounded-2xl border border-amber-200">
        <h3 class="font-display text-2xl text-charcoal-900 mb-3">{t.resources.ctaTitle}</h3>
        <p class="text-steel-600 mb-4">{t.resources.ctaDesc}</p>
        <a href={localePath('/contact')} class="btn-primary text-sm">
          {t.resources.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <!-- Back Button -->
      <div class="mt-12 pt-8 border-t border-steel-100">
        <a href={localePath('/resources')} class="inline-flex items-center gap-2 text-steel-600 hover:text-amber-500 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          {t.resources.backToResources}
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
