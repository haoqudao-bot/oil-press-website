﻿﻿---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'ROI Calculator', item: 'https://www.hydoilpress.com/roi-calculator' },
  ],
};
---

<BaseLayout
  title="Hydraulic Oil Press ROI Calculator"
  description="Estimate your return on investment for Haonuo hydraulic oil press machines. Calculate daily oil production, revenue, profit, and payback period."
  keywords={['hydraulic oil press ROI calculator', 'oil press investment', 'oil press payback period', 'oil press profit calculator']}
  jsonLd={[breadcrumbLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">ROI Calculator</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Hydraulic Oil Press ROI Calculator</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Estimate your return on investment</p>
    </div>
  </section>

  <!-- Calculator -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Disclaimer Banner - BEFORE calculator -->
      <div class="mb-8 bg-amber-50 border border-amber-200 rounded-2xl p-6">
        <div class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <div>
            <h3 class="font-display text-lg text-amber-800 mb-1">Important Disclaimer</h3>
            <p class="text-sm text-amber-700 leading-relaxed">
              This calculator provides <strong>rough estimates only</strong> for your preliminary planning. It is <strong>NOT a guarantee</strong> of actual returns. Actual results depend on many factors including raw material quality, operator skill, local market conditions, electricity costs, labor costs, and maintenance expenses. <strong>Do not make purchasing decisions based solely on these estimates.</strong> Please <a href="/contact" class="text-amber-800 underline font-medium">contact our team</a> for a detailed, case-specific analysis tailored to your business.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-steel-100 p-8 md:p-10">
        <!-- Input Fields -->
        <div class="space-y-6">
          <!-- Machine Model -->
          <div>
            <label for="machine-model" class="block font-display text-xl text-charcoal-900 mb-2">Machine Model</label>
            <select id="machine-model" class="w-full border border-steel-200 rounded-lg px-4 py-3 text-charcoal-900 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
              <option value="HN325">HN325 — Standard Hydraulic Oil Press</option>
              <option value="HN355">HN355 — Heavy Duty Hydraulic Oil Press</option>
              <option value="HN426">HN426 — Cold Press Hydraulic Oil Press</option>
              <option value="HN480">HN480 — High Pressure Hydraulic Oil Press</option>
            </select>
          </div>

          <!-- Machine Price -->
          <div>
            <label for="machine-price" class="block font-display text-xl text-charcoal-900 mb-2">Machine Price (USD)</label>
            <input
              type="number"
              id="machine-price"
              min="0"
              step="100"
              placeholder="Enter your quoted machine price"
              class="w-full border border-steel-200 rounded-lg px-4 py-3 text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
            />
            <p class="text-xs text-steel-400 mt-1">Enter the price from your quotation. <a href="/contact" class="text-amber-500 underline">Request a quote</a> if you don't have one yet.</p>
          </div>

          <!-- Daily Operating Hours -->
          <div>
            <label for="daily-hours" class="block font-display text-xl text-charcoal-900 mb-2">
              Daily Operating Hours: <span id="hours-display" class="text-amber-500">8</span>
            </label>
            <input
              type="range"
              id="daily-hours"
              min="1"
              max="24"
              value="8"
              class="w-full h-2 bg-steel-200 rounded-lg appearance-none cursor-pointer accent-amber-500"
            />
            <div class="flex justify-between text-xs text-steel-400 mt-1">
              <span>1 hr</span>
              <span>24 hrs</span>
            </div>
          </div>

          <!-- Raw Material Type -->
          <div>
            <label for="raw-material" class="block font-display text-xl text-charcoal-900 mb-2">Raw Material Type</label>
            <select id="raw-material" class="w-full border border-steel-200 rounded-lg px-4 py-3 text-charcoal-900 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
              <option value="sesame">Sesame (approx. 45% oil content)</option>
              <option value="peanut">Peanut (approx. 42% oil content)</option>
              <option value="coconut">Coconut (approx. 55% oil content)</option>
              <option value="sunflower">Sunflower (approx. 40% oil content)</option>
              <option value="rapeseed">Rapeseed (approx. 38% oil content)</option>
            </select>
            <p class="text-xs text-steel-400 mt-1">Oil content varies by variety, region, and moisture. Values shown are typical ranges, not guarantees.</p>
          </div>

          <!-- Raw Material Cost -->
          <div>
            <label for="material-cost" class="block font-display text-xl text-charcoal-900 mb-2">Raw Material Cost per kg (USD)</label>
            <input
              type="number"
              id="material-cost"
              min="0"
              step="0.01"
              placeholder="Enter raw material cost per kg in your local market"
              class="w-full border border-steel-200 rounded-lg px-4 py-3 text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
            />
            <p class="text-xs text-steel-400 mt-1">Please enter the actual cost in your local market. Raw material prices fluctuate significantly.</p>
          </div>

          <!-- Oil Selling Price -->
          <div>
            <label for="oil-price" class="block font-display text-xl text-charcoal-900 mb-2">Oil Selling Price per kg (USD)</label>
            <input
              type="number"
              id="oil-price"
              min="0"
              step="0.01"
              placeholder="Enter your expected selling price per kg"
              class="w-full border border-steel-200 rounded-lg px-4 py-3 text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
            />
            <p class="text-xs text-steel-400 mt-1">Please enter the actual selling price in your target market. Prices vary by region and quality grade.</p>
          </div>

          <!-- Additional Operating Costs -->
          <div>
            <label for="daily-opcost" class="block font-display text-xl text-charcoal-900 mb-2">
              Estimated Daily Operating Costs (USD)
            </label>
            <input
              type="number"
              id="daily-opcost"
              min="0"
              step="1"
              placeholder="e.g. electricity, labor, maintenance, packaging"
              class="w-full border border-steel-200 rounded-lg px-4 py-3 text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
            />
            <p class="text-xs text-steel-400 mt-1">Include electricity, labor, maintenance, packaging, transportation, and other daily costs. This significantly affects actual profitability.</p>
          </div>

          <!-- Acknowledgment Checkbox -->
          <div class="bg-steel-50 rounded-xl p-4 border border-steel-200">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="acknowledge" class="mt-1 w-4 h-4 text-amber-500 border-steel-300 rounded focus:ring-amber-500" />
              <span class="text-sm text-steel-600 leading-relaxed">
                I understand that this calculator provides <strong>rough estimates only</strong> and is <strong>not a guarantee</strong> of actual investment returns. Actual results depend on many factors including raw material quality, operating conditions, local market prices, and production efficiency. I will not make purchasing decisions based solely on these estimates.
              </span>
            </label>
          </div>

          <!-- Calculate Button -->
          <button
            id="calculate-btn"
            disabled
            class="btn-primary w-full justify-center text-lg py-4 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Calculate ROI
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>

        <!-- Results -->
        <div id="results" class="hidden mt-10 pt-10 border-t border-steel-200">
          <!-- Result Disclaimer -->
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
            <p class="text-sm text-amber-800 leading-relaxed">
              <strong>⚠️ These are rough estimates, not guarantees.</strong> Actual returns may be significantly lower or higher depending on your specific conditions. These figures do not account for all real-world variables. <a href="/contact" class="text-amber-800 underline font-medium">Contact us</a> for a personalized analysis.
            </p>
          </div>

          <h2 class="font-display text-3xl text-charcoal-900 mb-6">Your Estimated Returns</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-steel-50 rounded-2xl p-6">
              <div class="text-sm text-steel-500 mb-1">Daily Oil Production (estimated)</div>
              <div class="font-display text-3xl text-charcoal-900" id="result-daily-oil">—</div>
            </div>
            <div class="bg-steel-50 rounded-2xl p-6">
              <div class="text-sm text-steel-500 mb-1">Daily Revenue (estimated)</div>
              <div class="font-display text-3xl text-charcoal-900" id="result-daily-revenue">—</div>
            </div>
            <div class="bg-steel-50 rounded-2xl p-6">
              <div class="text-sm text-steel-500 mb-1">Daily Raw Material Cost</div>
              <div class="font-display text-3xl text-charcoal-900" id="result-daily-cost">—</div>
            </div>
            <div class="bg-steel-50 rounded-2xl p-6">
              <div class="text-sm text-steel-500 mb-1">Daily Operating Costs</div>
              <div class="font-display text-3xl text-charcoal-900" id="result-daily-opcost">—</div>
            </div>
            <div class="bg-amber-50 rounded-2xl p-6 border border-amber-200">
              <div class="text-sm text-amber-700 mb-1">Daily Net Profit (estimated)</div>
              <div class="font-display text-3xl text-amber-600" id="result-daily-profit">—</div>
            </div>
            <div class="bg-steel-50 rounded-2xl p-6">
              <div class="text-sm text-steel-500 mb-1">Monthly Net Profit (25 days, estimated)</div>
              <div class="font-display text-3xl text-charcoal-900" id="result-monthly-profit">—</div>
            </div>
            <div class="bg-steel-50 rounded-2xl p-6">
              <div class="text-sm text-steel-500 mb-1">Estimated Payback Period</div>
              <div class="font-display text-3xl text-charcoal-900" id="result-payback">—</div>
            </div>
            <div class="bg-amber-50 rounded-2xl p-6 border border-amber-200">
              <div class="text-sm text-amber-700 mb-1">Estimated Annual ROI</div>
              <div class="font-display text-4xl text-amber-600" id="result-roi">—</div>
            </div>
          </div>

          <!-- Bottom Disclaimer -->
          <div class="mt-6 bg-steel-50 rounded-xl p-5 border border-steel-200">
            <h4 class="font-display text-sm text-charcoal-900 mb-2">Important Notes</h4>
            <ul class="text-xs text-steel-500 space-y-1.5">
              <li>• All figures are <strong>rough estimates</strong> based on the values you entered and typical industry parameters — they are <strong>NOT guarantees</strong> of actual performance.</li>
              <li>• Actual oil yield depends on raw material variety, moisture content, pressing temperature, operator skill, and machine condition.</li>
              <li>• This calculation uses a conservative <strong>60% utilization rate</strong> (batch loading/unloading time, setup, cleaning). Actual throughput may vary.</li>
              <li>• Operating costs (electricity, labor, maintenance, packaging, transportation, rent) are often underestimated. Please enter realistic figures.</li>
              <li>• Market prices for both raw materials and finished oil fluctuate. Do not assume constant prices over the payback period.</li>
              <li>• This calculator does not account for taxes, import duties, shipping costs, or currency exchange risks.</li>
              <li>• <strong>Haonuo makes no warranty, express or implied, regarding the accuracy or reliability of these estimates.</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 p-8 bg-steel-900 rounded-2xl text-center">
        <h3 class="font-display text-3xl text-white mb-3">Need a Reliable Estimate?</h3>
        <p class="text-steel-300 mb-6">Our team can provide a detailed, case-specific ROI analysis based on your actual market conditions, raw material sources, and production goals.</p>
        <a href="/contact" class="btn-primary text-lg">
          Get a Personalized Analysis
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Machine data - conservative estimates with utilization rate
  // Utilization rate ~60% accounts for loading/unloading, setup, cleaning between batches
  const machineData: Record<string, { capacity: number; cycleMinutes: number }> = {
    HN325: { capacity: 10, cycleMinutes: 15 },
    HN355: { capacity: 15, cycleMinutes: 15 },
    HN426: { capacity: 20, cycleMinutes: 15 },
    HN480: { capacity: 25, cycleMinutes: 15 },
  };

  // Oil content - conservative mid-range values from industry data
  // Actual yield depends on variety, moisture, pressing method, and operator skill
  const oilContent: Record<string, number> = {
    sesame: 0.45,
    peanut: 0.42,
    coconut: 0.55,
    sunflower: 0.40,
    rapeseed: 0.38,
  };

  // Utilization rate - conservative estimate accounting for batch transitions
  const utilizationRate = 0.60;

  const hoursSlider = document.getElementById('daily-hours') as HTMLInputElement;
  const hoursDisplay = document.getElementById('hours-display')!;
  const ackCheckbox = document.getElementById('acknowledge') as HTMLInputElement;
  const calcBtn = document.getElementById('calculate-btn') as HTMLButtonElement;

  hoursSlider.addEventListener('input', () => {
    hoursDisplay.textContent = hoursSlider.value;
  });

  // Enable/disable calculate button based on acknowledgment checkbox
  ackCheckbox.addEventListener('change', () => {
    calcBtn.disabled = !ackCheckbox.checked;
  });

  calcBtn.addEventListener('click', () => {
    if (!ackCheckbox.checked) return;

    const model = (document.getElementById('machine-model') as HTMLSelectElement).value;
    const machinePrice = parseFloat((document.getElementById('machine-price') as HTMLInputElement).value) || 0;
    const hours = parseFloat(hoursSlider.value);
    const material = (document.getElementById('raw-material') as HTMLSelectElement).value;
    const materialCost = parseFloat((document.getElementById('material-cost') as HTMLInputElement).value) || 0;
    const oilPrice = parseFloat((document.getElementById('oil-price') as HTMLInputElement).value) || 0;
    const dailyOpcost = parseFloat((document.getElementById('daily-opcost') as HTMLInputElement).value) || 0;

    const machine = machineData[model];
    const yieldPct = oilContent[material];

    // Calculate with utilization rate
    const batchesPerHour = 60 / machine.cycleMinutes;
    const effectiveBatchesPerHour = batchesPerHour * utilizationRate;
    const dailyBatches = effectiveBatchesPerHour * hours;
    const dailyRawMaterial = machine.capacity * dailyBatches;
    const dailyOil = dailyRawMaterial * yieldPct;
    const dailyRevenue = dailyOil * oilPrice;
    const dailyMaterialCost = dailyRawMaterial * materialCost;
    const dailyProfit = dailyRevenue - dailyMaterialCost - dailyOpcost;
    const monthlyProfit = dailyProfit * 25;
    const paybackMonths = dailyProfit > 0 ? machinePrice / monthlyProfit : Infinity;
    const annualProfit = monthlyProfit * 12;
    const annualROI = machinePrice > 0 ? (annualProfit / machinePrice) * 100 : 0;

    const fmt = (n: number) => n >= 1000 ? `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : `$${n.toFixed(2)}`;

    document.getElementById('result-daily-oil')!.textContent = `${dailyOil.toFixed(1)} kg`;
    document.getElementById('result-daily-revenue')!.textContent = fmt(dailyRevenue);
    document.getElementById('result-daily-cost')!.textContent = fmt(dailyMaterialCost);
    document.getElementById('result-daily-opcost')!.textContent = fmt(dailyOpcost);
    document.getElementById('result-daily-profit')!.textContent = fmt(dailyProfit);
    document.getElementById('result-monthly-profit')!.textContent = fmt(monthlyProfit);
    document.getElementById('result-payback')!.textContent = paybackMonths === Infinity ? 'N/A' : `${paybackMonths.toFixed(1)} months`;
    document.getElementById('result-roi')!.textContent = `${annualROI.toFixed(1)}%`;

    document.getElementById('results')!.classList.remove('hidden');
  });
</script>
