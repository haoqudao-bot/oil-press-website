              <td class="px-4 py-3 text-steel-600">Popular, versatile, peanut &amp; rapeseed</td>
            </tr>
            <tr class="border-b border-steel-100">
              <td class="px-4 py-3 font-semibold text-charcoal-900">HN325S</td>
