            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-steel-100">
              <td class="px-4 py-3 font-semibold text-charcoal-900">HN300</td>
              <td class="px-4 py-3 text-steel-600">300 Tons</td>
              <td class="px-4 py-3 text-steel-600">3-5 kg/batch</td>
