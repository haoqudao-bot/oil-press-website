---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map(resource => ({
    params: { slug: resource.slug },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await resource.render();
const t = getTranslations('en');

const typeLabels: Record<string, string> = {
  comparison: t.resources.comparison,
  guide: t.resources.guide,
  blog: t.resources.blog,
};

const typeColors: Record<string, string> = {
  comparison: 'bg-blue-100 text-blue-700',
  guide: 'bg-green-100 text-green-700',
  blog: 'bg-purple-100 text-purple-700',
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: resource.data.title.en,
  description: resource.data.description.en,
  author: {
    '@type': 'Person',
    name: 'Haonuo Engineering Team',
    jobTitle: 'Senior Oil Press Engineer',
    worksFor: {
      '@type': 'Organization',
      name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.',
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.hydoilpress.com/images/logo.png',
    },
  },
  datePublished: resource.data.publishedAt.toISOString(),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: resource.data.title.en, item: `https://www.hydoilpress.com/resources/${resource.slug}` },
  ],
};
---

<BaseLayout title={resource.data.title.en} description={resource.data.description.en} keywords={resource.data.seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{resource.data.title.en}</span>
      </nav>
    </div>
  </section>

  <article class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Article Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
            {typeLabels[resource.data.type] || resource.data.type}
          </span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-4">
          {resource.data.title.en}
        </h1>
        <p class="text-lg text-steel-600 leading-relaxed">
          {resource.data.description.en}
        </p>

        <!-- Author Info -->
        <div class="flex items-center gap-3 mb-8 pb-8 border-b border-steel-100">
          <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-charcoal-900">Haonuo Engineering Team</p>
            <p class="text-xs text-steel-500">Senior Oil Press Engineer · 15+ Years Experience</p>
          </div>
          <time class="text-sm text-steel-400 ml-auto">
            {resource.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>

      <!-- Article Content -->
      <div class="prose prose-lg max-w-none text-steel-700 leading-relaxed
        prose-headings:font-display prose-headings:text-charcoal-900
        prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:mb-5
        prose-a:text-amber-600 prose-a:no-underline hover:prose-a:underline
        prose-strong:text-charcoal-900
        prose-table:border-collapse prose-table:w-full
        prose-th:bg-steel-50 prose-th:p-3 prose-th:text-left prose-th:text-sm prose-th:font-semibold prose-th:text-charcoal-900 prose-th:border prose-th:border-steel-200
        prose-td:p-3 prose-td:text-sm prose-td:border prose-td:border-steel-200
        prose-li:mb-1
        prose-blockquote:border-amber-300 prose-blockquote:bg-amber-50 prose-blockquote:p-4 prose-blockquote:rounded-lg">
        <Content />
      </div>

      <!-- CTA -->
      <div class="mt-12 p-8 bg-amber-50 rounded-2xl border border-amber-200">
        <h3 class="font-display text-2xl text-charcoal-900 mb-3">Need Help Choosing the Right Equipment?</h3>
        <p class="text-steel-600 mb-4">Our experts can help you select the best oil press machine for your specific needs.</p>
        <a href="/contact" class="btn-primary text-sm">
          Contact Us
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <!-- Back Button -->
      <div class="mt-12 pt-8 border-t border-steel-100">
        <a href="/resources" class="inline-flex items-center gap-2 text-steel-600 hover:text-amber-500 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back to Resources
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
