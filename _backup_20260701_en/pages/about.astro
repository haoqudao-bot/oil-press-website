﻿﻿---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');

const stats = [
  { value: '15+', label: t.home.statsYears },
  { value: '50+', label: t.home.statsCountries },
  { value: '200+', label: t.home.statsEmployees },
  { value: '3,000', label: t.home.statsArea },
];

const milestones = [
  { year: '2010', event: 'Company founded in Qingzhou, Shandong — began designing and manufacturing hydraulic oil press machines for the domestic market' },
  { year: '2013', event: 'Completed first export order to Southeast Asia, marking the start of international business' },
  { year: '2016', event: 'Expanded to 20+ export countries across Middle East and Africa; developed ultra-high pressure hydraulic press series' },
  { year: '2020', event: 'Exported to 40+ countries worldwide; established dedicated after-sales service network in Africa and South Asia' },
  { year: '2025', event: 'Reached 50+ export countries with 200+ employees; new 3,000m² modern factory with tripled production capacity' },
];

const certificates = [];

const capabilities = [
  { icon: 'cnc', title: 'CNC Machining Centers', desc: 'Advanced CNC lathes and milling machines ensure precision parts with tolerances within ±0.01mm' },
  { icon: 'assembly', title: 'Professional Assembly Lines', desc: 'Dedicated assembly lines with standardized procedures for consistent product quality' },
  { icon: 'qc', title: 'Quality Control Lab', desc: 'In-house testing lab for material analysis, pressure testing, and performance validation' },
  { icon: 'rd', title: 'R&D Center', desc: 'Experienced engineering team focused on hydraulic system innovation and product improvement' },
  { icon: 'paint', title: 'Surface Treatment', desc: 'Professional sandblasting and anti-corrosion coating for long-lasting machine durability' },
  { icon: 'warehouse', title: 'Large Inventory', desc: 'Sufficient raw material and spare parts stock for production within 20-30 working days (shipping time additional)' },
];

const whyChooseUs = [
  { title: 'Factory-Direct Pricing', desc: 'As a manufacturer, we eliminate middlemen and offer competitive factory-direct prices — typically saving compared to trading company prices (actual savings vary by product and market).' },
  { title: '15+ Years of Expertise', desc: 'Since 2010, we have specialized exclusively in hydraulic oil press machines, accumulating deep technical knowledge and proven solutions.' },
  { title: 'Strict Quality Control', desc: 'Every machine undergoes 48-hour continuous testing, material inspection, and pre-shipment trial run before delivery.' },
  { title: 'Global Export Experience', desc: 'Successfully exported to 50+ countries with full documentation support including CO, Form A/E, and embassy legalization.' },
  { title: 'Fast Delivery & Response', desc: '20-30 working days production time; inquiries answered within 24 hours with professional technical consultation.' },
  { title: 'Lifetime Technical Support', desc: 'Free installation guidance, operation training, and lifetime technical support via video call, WhatsApp, or on-site service.' },
];

const keyMarkets = [
  { region: 'South Asia', countries: ['India', 'Pakistan', 'Sri Lanka'] },
  { region: 'Africa', countries: ['Nigeria', 'Kenya', 'Ghana', 'Tanzania', 'Uganda'] },
  { region: 'Southeast Asia', countries: ['Philippines', 'Indonesia', 'Vietnam', 'Thailand', 'Myanmar'] },
  { region: 'Middle East', countries: ['Saudi Arabia', 'UAE', 'Egypt', 'Turkey', 'Iraq'] },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'About Us', item: 'https://www.hydoilpress.com/about' },
  ],
};
---

<BaseLayout title={t.about.title} description="Shandong Haonuo Machinery Equipment Group Co., Ltd. — professional hydraulic oil press machine manufacturer since 2010. Factory with 200+ employees, exporting to 50+ countries." jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">About Us</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.about.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.about.subtitle}</p>
    </div>
  </section>

  <!-- Company Overview -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <img
            src="/images/hero/hydraulic-oil-press-production.webp"
            alt="Haonuo Machinery Factory - Hydraulic Oil Press Machine Manufacturer"
            class="w-full rounded-2xl shadow-lg"
          />
        </div>
        <div class="reveal">
          <h2 class="section-title">Professional Hydraulic Oil Press Machine Manufacturer</h2>
          <p class="text-steel-600 leading-relaxed mb-4">
            Shandong Haonuo Machinery Equipment Group Co., Ltd. (山东浩诺机械设备集团有限公司) is a professional manufacturer specializing in hydraulic oil press machines since 2010. With over 15 years of industry experience, we have grown into a trusted oil press machine factory serving customers in 50+ countries worldwide.
          </p>
          <p class="text-steel-600 leading-relaxed mb-4">
            Located in Qingzhou, Weifang, Shandong Province — China's renowned machinery manufacturing hub — our 3,000m² factory is equipped with advanced CNC machining centers, professional assembly lines, and strict quality control systems. With over 200 skilled employees, we deliver reliable oil pressing equipment to customers worldwide.
          </p>
          <p class="text-steel-600 leading-relaxed mb-8">
            As a direct oil press machine China manufacturer, we provide factory-direct pricing, comprehensive technical support, and lifetime after-sales service to every customer.
          </p>

          <!-- Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            {stats.map(stat => (
              <div class="text-center">
                <div class="font-display text-3xl md:text-4xl text-amber-500">{stat.value}</div>
                <div class="text-xs text-steel-500 mt-1">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 md:py-24 bg-amber-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="section-title">Our Story</h2>
      <p class="text-lg text-steel-700 leading-relaxed mb-6">
        Founded in 2010 in Qingzhou, Shandong — a city with a deep tradition in mechanical engineering — Haonuo Machinery began with a simple mission: to build reliable, efficient hydraulic oil press machines that help oil producers maximize their yield and minimize their costs.
      </p>
      <p class="text-lg text-steel-700 leading-relaxed mb-6">
        Our founder, with over 20 years of experience in hydraulic systems, recognized that many oil producers were struggling with low-efficiency presses and unreliable suppliers. Starting from a small workshop with just 10 workers, we focused relentlessly on product quality and customer satisfaction.
      </p>
      <p class="text-lg text-steel-700 leading-relaxed">
        Today, that dedication has made us an established hydraulic oil press machine manufacturer in China, trusted by thousands of customers across 50+ countries — from India and Nigeria to the Philippines and the Middle East. Our story is still being written, and we invite you to be part of it.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="section-title">{t.about.mission}</h2>
      <p class="text-lg text-steel-700 leading-relaxed">
        {t.about.missionDesc}
      </p>
    </div>
  </section>

  <!-- History Timeline -->
  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12 reveal">{t.about.history}</h2>
      <div class="relative">
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-steel-200 md:-translate-x-0.5"></div>

        {milestones.map((item, i) => (
          <div class:list={[
            'relative flex items-start mb-8 last:mb-0 reveal',
            i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'
          ]}>
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-amber-500 rounded-full -translate-x-1.5 md:-translate-x-1.5 mt-2 z-10"></div>
            <div class:list={[
              'ml-12 md:ml-0 md:w-1/2',
              i % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12'
            ]}>
              <div class="font-display text-2xl text-amber-500 mb-1">{item.year}</div>
              <p class="text-steel-700 text-sm leading-relaxed">{item.event}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Manufacturing Capabilities -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">Manufacturing Capabilities</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">Our 3,000m² factory in Qingzhou is equipped with state-of-the-art machinery and staffed by 200+ skilled professionals dedicated to producing high-quality hydraulic oil press machines.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {capabilities.map((cap, i) => (
          <div class="reveal p-6 bg-steel-50 rounded-2xl hover:bg-amber-50 transition-colors" style={`animation-delay: ${i * 80}ms`}>
            <div class="w-12 h-12 bg-amber-500 rounded-xl flex items-center justify-center mb-4">
              {cap.icon === 'cnc' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>
              )}
              {cap.icon === 'assembly' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              )}
              {cap.icon === 'qc' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              )}
              {cap.icon === 'rd' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m-7.07-3.93l4.24-4.24m5.66-5.66l4.24-4.24M1 12h6m6 0h6m-3.93 7.07l-4.24-4.24m-5.66-5.66L4.93 4.93"/></svg>
              )}
              {cap.icon === 'paint' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
              )}
              {cap.icon === 'warehouse' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              )}
            </div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{cap.title}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Assurance -->
  <section class="py-16 md:py-24 bg-steel-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal text-white">Quality Assurance</h2>
      <p class="text-center text-steel-300 max-w-2xl mx-auto mb-12 reveal">Every hydraulic oil press machine undergoes rigorous quality checks before leaving our factory, ensuring reliable performance and long service life.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="reveal text-center p-8 bg-white/5 rounded-2xl border border-white/10">
          <div class="w-14 h-14 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="font-display text-xl mb-3">Quality Management</h3>
          <p class="text-sm text-steel-300 leading-relaxed">Comprehensive quality management system covering design, procurement, production, inspection, and delivery — every machine is rigorously tested before shipment.</p>
        </div>
        <div class="reveal text-center p-8 bg-white/5 rounded-2xl border border-white/10">
          <div class="w-14 h-14 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="font-display text-xl mb-3">Material Testing</h3>
          <p class="text-sm text-steel-300 leading-relaxed">All raw materials (steel, hydraulic components, seals) are inspected and tested upon arrival. Only certified materials enter production.</p>
        </div>
        <div class="reveal text-center p-8 bg-white/5 rounded-2xl border border-white/10">
          <div class="w-14 h-14 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <h3 class="font-display text-xl mb-3">Pre-Shipment Inspection</h3>
          <p class="text-sm text-steel-300 leading-relaxed">Every machine undergoes 48-hour continuous running test, pressure test, and performance validation before packaging. Video proof provided to customers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Reach -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">Global Reach</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">Our hydraulic oil press machines are trusted by customers in 50+ countries. Key markets include India, Nigeria, Pakistan, Philippines, Kenya, and the Middle East.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {keyMarkets.map((market, i) => (
          <div class="reveal p-6 bg-steel-50 rounded-2xl" style={`animation-delay: ${i * 80}ms`}>
            <h3 class="font-display text-lg text-amber-500 mb-3">{market.region}</h3>
            <ul class="space-y-1.5">
              {market.countries.map(country => (
                <li class="flex items-center gap-2 text-sm text-steel-700">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {country}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="text-center reveal">
        <p class="text-steel-500 text-sm">...and many more countries across Central Asia, South America, and Europe.</p>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24 bg-amber-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">Why Choose Haonuo Machinery</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">As a direct hydraulic oil press machine manufacturer, we offer unique advantages that trading companies simply cannot match.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {whyChooseUs.map((reason, i) => (
          <div class="reveal bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow" style={`animation-delay: ${i * 80}ms`}>
            <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center mb-4 font-display text-lg text-charcoal-900">{i + 1}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{reason.title}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{reason.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Factory Tour -->
  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.about.factory}</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">Take a virtual tour of our manufacturing facility. Factory visits are also welcome — contact us to schedule a tour.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { src: '/images/factory/machining-workshop.webp', label: 'Machining Workshop' },
          { src: '/images/factory/assembly-line.webp', label: 'Assembly Line' },
          { src: '/images/factory/quality-control.webp', label: 'Quality Control Center' },
          { src: '/images/factory/warehouse.webp', label: 'Finished Product Warehouse' },
          { src: '/images/factory/painting-workshop.webp', label: 'Painting Workshop' },
          { src: '/images/factory/office-building.webp', label: 'Office Building' },
        ].map((img, i) => (
          <div class="reveal aspect-[4/3] rounded-2xl overflow-hidden group" style={`animation-delay: ${i * 80}ms`}>
            <img
              src={img.src}
              alt={img.label}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror={`this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<div class="flex items-center justify-center h-full bg-steel-100 text-steel-400 text-sm">${img.label}</div>'`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 md:py-20 bg-amber-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display text-3xl md:text-4xl text-charcoal-900 mb-4">Our Services</h2>
        <p class="text-steel-600 text-lg max-w-2xl mx-auto">Beyond manufacturing — we provide complete business support from OEM branding to lifetime technical assistance.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { icon: '🏷️', title: 'Standard Procurement', desc: 'Factory-direct ordering with full documentation, customs-ready packing, and global shipping coordination.' },
          { icon: '🏭', title: 'OEM / ODM', desc: 'Custom branding, label design, and machine modifications. Build your own brand with our manufacturing expertise.' },
          { icon: '🔧', title: 'Technical Support & Parts', desc: 'Lifetime remote support, genuine spare parts, and equipment upgrades — always available when you need us.' },
        ].map((svc, i) => (
          <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow reveal" style={`animation-delay: ${i * 60}ms`}>
            <span class="text-3xl mb-3 block">{svc.icon}</span>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{svc.title}</h3>
            <p class="text-steel-600 text-sm">{svc.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8 reveal">
        <a href="/services" class="inline-flex items-center gap-2 text-amber-600 hover:text-amber-700 font-semibold transition-colors">
          View All Services
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="font-display text-3xl md:text-4xl text-white mb-4">Ready to Get Factory-Direct Pricing?</h2>
      <p class="text-steel-300 text-lg mb-8 max-w-2xl mx-auto">Contact us today for a free quotation on hydraulic oil press machines. As a direct manufacturer, we offer competitive pricing and full technical support.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary text-base">
          Request a Quote
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
