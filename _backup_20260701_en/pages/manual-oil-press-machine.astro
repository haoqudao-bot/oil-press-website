﻿﻿---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const manualProducts = allProducts.filter(p =>
  p.data.category === 'hydraulic-oil-press' &&
  (p.data.model?.toLowerCase().includes('hn300') ||
   p.data.model?.toLowerCase().includes('hn325') ||
   p.data.model?.toLowerCase().includes('mini') ||
   p.data.title?.en?.toLowerCase().includes('mini'))
).slice(0, 4);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
    { '@type': 'ListItem', position: 3, name: 'Manual Oil Press Machine', item: 'https://www.hydoilpress.com/manual-oil-press-machine' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is a manual oil press machine?',
      acceptedAnswer: { '@type': 'Answer', text: 'A manual oil press machine is a hand-operated device that extracts oil from seeds without electricity. It uses mechanical force applied by a hand crank or lever to press oil from seeds like sesame, peanut, and shea nuts. Manual presses are ideal for off-grid areas, remote villages, and traditional oil pressing where electricity is unavailable or unreliable.' },
    },
    {
      '@type': 'Question',
      name: 'How much oil can a manual press produce?',
      acceptedAnswer: { '@type': 'Answer', text: 'Manual oil presses typically produce 1-3 liters of oil per hour depending on the seed type and operator effort. Yield is lower than hydraulic presses (typically 25-35% vs 42-50% for sesame). For comparison, a Haonuo HN300 hydraulic press produces 3-5 kg per batch in 8-15 minutes with much higher yield and less physical effort.' },
    },
    {
      '@type': 'Question',
      name: 'Is a manual oil press better than electric?',
      acceptedAnswer: { '@type': 'Answer', text: 'Manual presses are better only when electricity is completely unavailable. For all other situations, a hydraulic oil press like the Haonuo HN300 (only 2.2 KW, compatible with a small 5 KVA generator) offers significantly higher yield, faster production, less labor, and better oil quality. The hydraulic press requires minimal power and is the recommended choice even in areas with unreliable electricity.' },
    },
    {
      '@type': 'Question',
      name: 'What seeds work best with a manual press?',
      acceptedAnswer: { '@type': 'Answer', text: 'Softer, high-oil seeds work best with manual presses: sesame, shea nuts, and peanut are the most common. Hard-shell nuts like walnut and coconut are very difficult to press manually. For hard seeds, a hydraulic press is strongly recommended — the higher pressure makes extraction efficient and practical.' },
    },
    {
      '@type': 'Question',
      name: 'How much does a manual oil press cost?',
      acceptedAnswer: { '@type': 'Answer', text: 'Manual oil presses are the most affordable entry point into oil production, with basic models available at low cost. However, Haonuo\'s compact hydraulic presses (HN300/HN325) are competitively priced and offer far superior yield, speed, and ease of use. The small additional investment in a hydraulic press pays for itself quickly through higher oil output and less labor.' },
    },
    {
      '@type': 'Question',
      name: 'Can I upgrade from manual to hydraulic later?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Many customers start with manual pressing and upgrade to a Haonuo hydraulic press as their business grows. The transition is straightforward — hydraulic presses use the same seeds but deliver 2-3x higher yield with minimal physical effort. Haonuo offers trade-in guidance and financing options to help you scale up when ready.' },
    },
  ],
};

const faqs = [
  { question: 'What is a manual oil press machine?', answer: 'A manual oil press machine is a hand-operated device that extracts oil from seeds without electricity. It uses mechanical force applied by a hand crank or lever to press oil from seeds like sesame, peanut, and shea nuts. Manual presses are ideal for off-grid areas, remote villages, and traditional oil pressing where electricity is unavailable or unreliable.' },
  { question: 'How much oil can a manual press produce?', answer: 'Manual oil presses typically produce 1-3 liters of oil per hour depending on the seed type and operator effort. Yield is lower than hydraulic presses (typically 25-35% vs 42-50% for sesame). For comparison, a Haonuo HN300 hydraulic press produces 3-5 kg per batch in 8-15 minutes with much higher yield and less physical effort.' },
  { question: 'Is a manual oil press better than electric?', answer: 'Manual presses are better only when electricity is completely unavailable. For all other situations, a hydraulic oil press like the Haonuo HN300 (only 2.2 KW, compatible with a small 5 KVA generator) offers significantly higher yield, faster production, less labor, and better oil quality. The hydraulic press requires minimal power and is the recommended choice even in areas with unreliable electricity.' },
  { question: 'What seeds work best with a manual press?', answer: 'Softer, high-oil seeds work best with manual presses: sesame, shea nuts, and peanut are the most common. Hard-shell nuts like walnut and coconut are very difficult to press manually. For hard seeds, a hydraulic press is strongly recommended — the higher pressure makes extraction efficient and practical.' },
  { question: 'How much does a manual oil press cost?', answer: 'Manual oil presses are the most affordable entry point into oil production, with basic models available at low cost. However, Haonuo\'s compact hydraulic presses (HN300/HN325) are competitively priced and offer far superior yield, speed, and ease of use. The small additional investment in a hydraulic press pays for itself quickly through higher oil output and less labor.' },
  { question: 'Can I upgrade from manual to hydraulic later?', answer: 'Yes. Many customers start with manual pressing and upgrade to a Haonuo hydraulic press as their business grows. The transition is straightforward — hydraulic presses use the same seeds but deliver 2-3x higher yield with minimal physical effort. Haonuo offers trade-in guidance and financing options to help you scale up when ready.' },
];
---

<BaseLayout
  title="Manual Oil Press Machine — Traditional Pressing, Modern Quality | Haonuo"
  description="Hand-operated oil press machines for off-grid and traditional oil production. No electricity needed. Haonuo also offers low-power hydraulic presses for better yield. Factory-direct."
  keywords={['manual oil press machine', 'manual oil press machine for home use', 'hand operated oil press', 'manual oil extractor', 'non electric oil press machine']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products" class="hover:text-amber-500 transition-colors">Products</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Manual Oil Press Machine</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4">Manual Oil Press Machine — Traditional Pressing, Modern Quality</h1>
      <p class="text-steel-300 text-lg max-w-3xl mb-8">Hand-operated oil press machines for small-scale and off-grid oil production. No electricity needed. Ideal for remote areas, home use, and traditional oil pressing.</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Find the Right Oil Press
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/hydraulic-oil-press-machine" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white hover:text-steel-900 transition-colors text-lg">
          See Hydraulic Presses
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Manual -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">Why Choose Manual</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#128293;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">No Electricity Required</h3>
          <p class="text-steel-600 text-sm leading-relaxed">Works completely off-grid. Hand-operated mechanism needs no power source — ideal for remote villages and areas without electricity infrastructure.</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#128736;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Simple & Reliable</h3>
          <p class="text-steel-600 text-sm leading-relaxed">No motor, no electrical components, fewer parts to maintain. The simple mechanical design means fewer breakdowns and easy field repairs.</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#128181;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Affordable</h3>
          <p class="text-steel-600 text-sm leading-relaxed">A low-cost entry into oil production. Manual presses require minimal investment, making oil production accessible to the widest range of users.</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#127980;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Traditional Method</h3>
          <p class="text-steel-600 text-sm leading-relaxed">Preserves cultural oil pressing traditions. Hand pressing maintains the artisanal craft that has produced cooking oil for centuries in many communities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Note: Hydraulic Recommendation -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 border-2 border-amber-200">
        <div class="flex items-start gap-4">
          <div class="text-3xl shrink-0">&#128161;</div>
          <div>
            <h3 class="font-display text-xl text-charcoal-900 mb-3">Consider a Hydraulic Press for Better Results</h3>
            <p class="text-steel-600 leading-relaxed mb-3">Haonuo primarily manufactures hydraulic oil presses, which need only <strong class="text-charcoal-900">2.2 KW of power</strong> — compatible with a small 5 KVA generator. Even in off-grid areas, a hydraulic press is the recommended choice because it delivers:</p>
            <ul class="text-steel-600 space-y-2 mb-4">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong class="text-charcoal-900">2-3x higher oil yield</strong> — 42-50% vs 25-35% for sesame</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong class="text-charcoal-900">One-button operation</strong> — no physical labor required</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong class="text-charcoal-900">Cold pressing capability</strong> — premium quality oil</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span><strong class="text-charcoal-900">Works with generator</strong> — 5 KVA is sufficient</span>
              </li>
            </ul>
            <a href="/hydraulic-oil-press-machine" class="inline-flex items-center gap-2 text-amber-500 font-semibold hover:text-amber-600 transition-colors">
              Explore Haonuo Hydraulic Presses
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recommended Products -->
  {manualProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-center mb-12">Compact Hydraulic Presses — Closest to Manual Use Case</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {manualProducts.map(product => (
            <a
              href={`/products/${product.slug}`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Compact%20hydraulic%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Popular Manual-Pressed Oils -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">Popular Manual-Pressed Oils</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#127807;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sesame Oil</h3>
          <p class="text-sm text-amber-500 font-medium mb-2">Traditional Asian</p>
          <p class="text-steel-600 text-sm mb-3">Soft seeds ideal for manual pressing. A cornerstone of traditional oil pressing across East and South Asia for centuries.</p>
          <div class="flex items-center gap-2">
            <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">Manual yield: 25-35%</span>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#127804;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Shea Butter</h3>
          <p class="text-sm text-amber-500 font-medium mb-2">West African traditional</p>
          <p class="text-steel-600 text-sm mb-3">Hand-pressed shea butter is a vital traditional product in Ghana, Nigeria, and Burkina Faso for cooking and skincare.</p>
          <div class="flex items-center gap-2">
            <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">Manual yield: 30-40%</span>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#129372;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Peanut Oil</h3>
          <p class="text-sm text-amber-500 font-medium mb-2">Rural African</p>
          <p class="text-steel-600 text-sm mb-3">Groundnut oil pressing is a widespread rural tradition across West Africa, providing essential cooking oil for village communities.</p>
          <div class="flex items-center gap-2">
            <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">Manual yield: 20-30%</span>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-4">&#127795;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Palm Kernel Oil</h3>
          <p class="text-sm text-amber-500 font-medium mb-2">Village-level processing</p>
          <p class="text-steel-600 text-sm mb-3">Village-level palm kernel processing provides affordable cooking oil and soap-making material in rural palm-growing regions.</p>
          <div class="flex items-center gap-2">
            <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">Manual yield: 25-35%</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Find the Right Oil Press for You</h2>
      <p class="text-steel-300 text-lg mb-8">Whether you need a manual press for off-grid use or a hydraulic press for better yield, Haonuo can help you choose the right solution.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Get a Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="https://wa.me/8618957149128?text=Hello%20Haonuo%2C%20I%20am%20interested%20in%20a%20manual%20or%20hydraulic%20oil%20press%20machine" target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white font-semibold px-8 py-4 rounded-lg hover:bg-green-500 transition-colors text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
