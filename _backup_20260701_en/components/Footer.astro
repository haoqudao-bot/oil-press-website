        <h3 class="font-display text-lg text-white mb-4">{t.footer.quickLinks}</h3>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={localePath(link.href)} class="text-sm text-steel-400 hover:text-amber-500 transition-colors">
