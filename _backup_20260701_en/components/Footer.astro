          <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center">
            <span class="text-charcoal-900 font-display text-xl font-bold">HN</span>
          </div>
          <span class="font-display text-lg text-white tracking-wide leading-tight">
            HAONUO<br />
            <span class="text-xs font-normal tracking-widest">MACHINERY</span>
