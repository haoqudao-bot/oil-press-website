---
import { type Locale, getTranslations, isRtl } from '../i18n/index.ts';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Clarity from '../components/Clarity.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  jsonLd?: object;
  locale?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Transparent header that overlays the first screen (homepage hero) */
  overlayHeader?: boolean;
}

const { title, description, keywords, jsonLd, locale = 'en', ogImage, noindex = false, overlayHeader = false } = Astro.props;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);
const rtl = isRtl(currentLocale);

// Title: soft cap 70 chars — truncate at word boundary only as a safety net.
// Keyword integrity beats length: Google display-truncates but still indexes
// the full title, while HTML-side truncation would delete keywords outright.
// No brand suffix: Google shows the site name from Organization schema,
// and the freed 9 chars keep keywords intact.
const maxTitleLen = 70;
function smartTruncate(str: string, max: number): string {
  if (str.length <= max) return str;
  const cut = str.substring(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  const base = (lastSpace > max * 0.6 ? cut.substring(0, lastSpace) : cut).replace(/[\s—–\-\/|,;:.(]+$/, '');
  return base + '…';
}
let pageTitle: string;
if (title) {
  pageTitle = smartTruncate(title, maxTitleLen);
} else {
  pageTitle = (t as any).common?.defaultTitle || 'Haonuo Machinery - Hydraulic Oil Press Manufacturer';
}

// Description: max 160 chars (Google desktop limit), smart CTA suffix.
// CTA space is reserved BEFORE truncating, so the CTA always survives.
const defaultDesc = (t as any).common?.defaultDesc || 'Shandong Haonuo Machinery - Professional hydraulic oil press manufacturer since 2010. Cold press technology for coconut, sesame, peanut & more. Get a free quote!';
const maxDescLen = 160;
const ctaSuffix = (t as any).common?.ctaSuffix || ' Get a free quote!';
let pageDesc: string;
if (description) {
  // Skip CTA suffix if description already contains CTA intent words
  const hasCtaIntent = /quote|contact|inquiry|inquire|reach us|get in touch|free consultation/i.test(description);
  if (hasCtaIntent) {
    const body = /[.!]$/.test(description) ? description : description + '.';
    pageDesc = smartTruncate(body, maxDescLen);
  } else {
    const suffix = /[.!]$/.test(description) ? ctaSuffix : '.' + ctaSuffix;
    const budget = maxDescLen - suffix.length;
    if (description.length <= budget) {
      pageDesc = description + suffix;
    } else {
      const body = smartTruncate(description, budget); // ends with …
      pageDesc = body + ctaSuffix;
    }
  }
} else {
  pageDesc = defaultDesc;
}

const pageKeywords = keywords || ((t as any).common?.defaultKeywords ? String((t as any).common.defaultKeywords).split(', ') : ['hydraulic oil press', 'oil press machine', 'cold press', 'coconut oil press', 'sesame oil press', 'Haonuo Machinery']);

// Canonical URL
const canonicalUrl = `https://www.hydoilpress.com${Astro.url.pathname}`;

// OG Image
const defaultOgImage = 'https://www.hydoilpress.com/images/og-default.webp';
const pageOgImage = ogImage || defaultOgImage;

const orgUrl = currentLocale !== 'en' ? `https://www.hydoilpress.com/${currentLocale}` : 'https://www.hydoilpress.com';
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${orgUrl}/#organization`,
  name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.',
  alternateName: 'Haonuo Machinery',
  url: orgUrl,
  sameAs: ['https://grainocraft.com'],
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'section:first-of-type p:first-of-type'],
  },
  logo: 'https://www.hydoilpress.com/apple-touch-icon.png',
  description: (t as any).common?.orgDesc || 'Professional hydraulic oil press manufacturer since 2010',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'No. 88, Nanyang Road, Qingzhou Economic Development Zone',
    addressLocality: 'Qingzhou, Weifang',
    addressRegion: 'Shandong',
    postalCode: '262500',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+86-18957149128',
    contactType: currentLocale === 'fr' ? 'ventes' : currentLocale === 'ar' ? 'مبيعات' : currentLocale === 'id' ? 'penjualan' : 'sales',
    availableLanguage: currentLocale === 'fr'
      ? ['Anglais', 'Français', 'Arabe', 'Indonésien']
      : currentLocale === 'ar'
      ? ['الإنجليزية', 'الفرنسية', 'العربية', 'الإندونيسية']
      : currentLocale === 'id'
      ? ['Inggris', 'Prancis', 'Arab', 'Indonesia']
      : ['English', 'French', 'Arabic', 'Indonesian'],
  },
  foundingDate: '2010',
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${orgUrl}/#website`,
  name: 'Haonuo Machinery — Hydraulic Oil Press Machines',
  alternateName: 'Haonuo Machinery',
  url: orgUrl,
  publisher: { '@id': `${orgUrl}/#organization` },
  inLanguage: currentLocale,
};

const rawLd = jsonLd ? [organizationLd, websiteLd, jsonLd] : [organizationLd, websiteLd];
const mergedLd = rawLd.flat();
---

<!DOCTYPE html>
<html lang={currentLocale} dir={rtl ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="author" content="Shandong Haonuo Machinery Equipment Group Co., Ltd." />
  <meta name="google-site-verification" content="07toNqzXrhC9mvL5gLmZMdMfVBzblwpT0wXMGpoBuEE" />
  <meta name="msvalidate.01" content="1BBADBD1B20D77F8EFD40C58597F8133" />
  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Haonuo Machinery" />
  <meta property="og:image" content={pageOgImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={currentLocale === 'fr' ? 'fr_FR' : currentLocale === 'ar' ? 'ar_SA' : currentLocale === 'id' ? 'id_ID' : 'en_US'} />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={pageOgImage} />
  <!-- Hreflang -->
  <link rel="alternate" hreflang="en" href={`https://www.hydoilpress.com${Astro.url.pathname.replace(/^\/(fr|ar|id)/, '')}`} />
  <link rel="alternate" hreflang="fr" href={`https://www.hydoilpress.com/fr${Astro.url.pathname.replace(/^\/(fr|ar|id)/, '')}`} />
  <link rel="alternate" hreflang="ar" href={`https://www.hydoilpress.com/ar${Astro.url.pathname.replace(/^\/(fr|ar|id)/, '')}`} />
  <link rel="alternate" hreflang="id" href={`https://www.hydoilpress.com/id${Astro.url.pathname.replace(/^\/(fr|ar|id)/, '')}`} />
  <link rel="alternate" hreflang="x-default" href={`https://www.hydoilpress.com${Astro.url.pathname.replace(/^\/(fr|ar|id)/, '')}`} />
  <!-- JSON-LD -->
  {mergedLd.map((ld, i) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
  <!-- Favicon & Fonts -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" />
</head>
<body class="min-h-screen flex flex-col font-body">
  <div class="fixed top-0 inset-x-0 z-50 no-print">
    <CookieConsentBanner locale={currentLocale} />
    <Navbar locale={currentLocale} overlay={overlayHeader} />
  </div>
  <!-- Spacer for fixed header (skipped in overlay mode: hero sits underneath) -->
  {!overlayHeader && <div class="h-16 md:h-20"></div>}
  <main class="flex-1">
    <slot />
  </main>
  <Footer locale={currentLocale} />
  <ChatWidget locale={currentLocale} />
  <script>
    // Scroll reveal animation
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
  <GoogleAnalytics />
  <Clarity />
</body>
</html>
