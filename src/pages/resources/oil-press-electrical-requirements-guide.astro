---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'oil-press-electrical-requirements-guide');
const t = getTranslations('en');

const title = resource?.data.title.en || 'Oil Press Electrical Requirements Guide';
const description = resource?.data.description.en || 'Power supply and generator configuration';
const seoKeywords = resource?.data.seoKeywords || ['oil press electrical requirements', 'generator for oil press', 'power supply configuration'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/electrical-guide-hero.webp',
  author: { '@type': 'Person', name: 'Eason', jobTitle: 'Senior Hydraulic Press Engineer', url: 'https://www.hydoilpress.com/about', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.', url: 'https://www.hydoilpress.com' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/oil-press-electrical-requirements-guide' },
  ],
};

const voltageSpecs = ['220V Single Phase (common in many countries)', '380V Three Phase (industrial standard)', '415V Three Phase (some regions)', 'Frequency: 50Hz or 60Hz', 'Voltage can be adjusted at no extra cost'];
const powerConsumption = ['Motor Power: All Haonuo models: 2.2 KW', 'Standby: 0.5-1.0 KW', 'Pressing: 1.5-2.2 KW', 'Peak: Up to 3.0 KW (during pressure build-up)'];
const currentRequirements = ['Single Phase (220V): Running 10-15 A, Starting 20-30 A', 'Three Phase (380V): Running 5-8 A, Starting 10-15 A', 'Recommended Circuit Breaker: Single phase 30 A, Three phase 16 A per phase'];

const generatorCapacity = [
  { model: 'HN325', singlePhase: '5 kVA', threePhase: '5 kVA' },
  { model: 'HN365', singlePhase: '5.5 kVA', threePhase: '5.5 kVA' },
  { model: 'HN426', singlePhase: '5.5 kVA', threePhase: '5.5 kVA' },
  { model: 'HN480', singlePhase: '5.5 kVA', threePhase: '5.5 kVA' },
  { model: 'HN500', singlePhase: '7 kVA', threePhase: '7 kVA' },
];

const safetyMargin = ['Add 20-30% for starting current', 'Account for other equipment on the same circuit', 'Account for voltage drop'];
const recommendedGenerator = [
  { models: 'HN325/HN365', size: '6-7 kVA' },
  { models: 'HN426/HN480', size: '7-8 kVA' },
  { models: 'HN500', size: '8-10 kVA' },
];

const generatorSelection = [
  { title: 'Type', desc: 'Diesel (most common), Gasoline, Solar' },
  { title: 'Quality', desc: 'Reputable brand, inverter type recommended' },
  { title: 'Features', desc: 'Voltage regulation, overload protection, auto start/stop' },
];

const wiringRequirements = [
  { distance: '10m', singlePhase: '2.5 mm²', threePhase: '2.5 mm²' },
  { distance: '20m', singlePhase: '4 mm²', threePhase: '2.5 mm²' },
  { distance: '30m', singlePhase: '6 mm²', threePhase: '4 mm²' },
  { distance: '50m', singlePhase: '10 mm²', threePhase: '6 mm²' },
];

const controlPanelComponents = ['Main switch', 'Circuit breaker', 'Motor starter', 'Control button', 'Emergency stop', 'Indicator lights'];
const electricalSafety = ['Use insulated gloves', 'Use insulated tools', 'Follow lockout procedures'];
const voltageFluctuations = [
  { type: 'Low Voltage', effects: 'Motor overheating, reduced performance', solution: 'Voltage stabilizer' },
  { type: 'High Voltage', effects: 'Motor damage, component failure', solution: 'Surge protector' },
];

const lightningProtection = ['Lightning rod installation', 'Surge protection devices', 'Grounding system'];
const upsInfo = ['Application: Control panel backup, emergency shutdown', 'Size: 500-1000 VA typically sufficient'];
const solarInfo = ['Application: Off-grid locations, sustainable operation', 'Considerations: Solar panel size, battery storage, backup generator recommended'];

const powerManagement = ['Run during low-peak hours when possible', 'Batch processing to reduce startup cycles'];
const costCalculation = ['Energy Cost per Day = (Energy Consumption x Hours x Rate) / 1000', 'Example: Energy cost varies by region and tariff rates. Contact us for a personalized estimate.'];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">TECHNICAL GUIDE</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Eason</div>
            <div class="text-sm text-steel-500">Oil Press Technical Engineer · 15+ Years Experience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Why Electrical Planning Comes Before Your Press Arrives</h2>
        <p class="text-steel-700 leading-relaxed">Understanding the electrical requirements of your hydraulic oil press is crucial for safe and efficient operation.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Proper electrical configuration ensures safe operation and extends equipment life.</p>
        </div>
      </section>

      <section id="basic-requirements" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Basic Electrical Requirements for an Oil Press</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Voltage Specifications</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
          {voltageSpecs.map((spec, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-lg border border-blue-100 flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span class="text-steel-700 text-sm">{spec}</span>
            </div>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Power Consumption</h3>
        <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl p-6 border border-purple-100 mb-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {powerConsumption.map((item, index) => (
              <div key={index} class="bg-white p-3 rounded-lg text-center">
                <p class="text-sm text-steel-600">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Current Requirements</h3>
        <div class="space-y-2">
          {currentRequirements.map((req, index) => (
            <div key={index} class="bg-white p-4 rounded-lg border border-steel-100 shadow-sm flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="text-steel-700">{req}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="generator" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Generator Requirements</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Generator Capacity</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-green-500 to-emerald-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Model</th><th class="px-4 py-3 text-left font-semibold">Single Phase</th><th class="px-4 py-3 text-left font-semibold">Three Phase</th></tr>
            </thead>
            <tbody>
              {generatorCapacity.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-green-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.model}</td>
                  <td class="px-4 py-3 text-green-600">{item.singlePhase}</td>
                  <td class="px-4 py-3 text-green-600">{item.threePhase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="bg-orange-50 p-5 rounded-xl border border-orange-100">
            <h4 class="font-semibold text-orange-800 mb-3">Safety Margin</h4>
            <ul class="space-y-2">
              {safetyMargin.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-amber-50 p-5 rounded-xl border border-amber-100">
            <h4 class="font-semibold text-amber-800 mb-3">Recommended Generator Size</h4>
            <ul class="space-y-2">
              {recommendedGenerator.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-center justify-between">
                  <span>{item.models}</span>
                  <span class="font-bold text-amber-600">{item.size}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="power-supply" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Power Supply Configuration</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Wiring Requirements</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Distance</th><th class="px-4 py-3 text-left font-semibold">Single Phase (220V)</th><th class="px-4 py-3 text-left font-semibold">Three Phase (380V)</th></tr>
            </thead>
            <tbody>
              {wiringRequirements.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.distance}</td>
                  <td class="px-4 py-3 text-blue-600">{item.singlePhase}</td>
                  <td class="px-4 py-3 text-blue-600">{item.threePhase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="safety" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Electrical Safety Around Your Oil Press</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-red-50 p-5 rounded-xl border border-red-100">
            <h3 class="font-semibold text-red-800 mb-3">Electrical Safety</h3>
            <ul class="space-y-2">
              {electricalSafety.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-orange-50 p-5 rounded-xl border border-orange-100">
            <h3 class="font-semibold text-orange-800 mb-3">Voltage Fluctuations</h3>
            <ul class="space-y-3">
              {voltageFluctuations.map((item, index) => (
                <li key={index} class="text-sm">
                  <p class="font-medium text-steel-700">{item.type}</p>
                  <p class="text-steel-500">{item.effects}</p>
                  <p class="text-green-600 font-medium">Solution: {item.solution}</p>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-purple-50 p-5 rounded-xl border border-purple-100">
            <h3 class="font-semibold text-purple-800 mb-3">Lightning Protection</h3>
            <ul class="space-y-2">
              {lightningProtection.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 16.326A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.973"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="backup-power" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Backup Power Solutions</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-blue-50 p-5 rounded-xl border border-blue-100">
            <h3 class="font-semibold text-blue-800 mb-3">UPS (Uninterruptible Power Supply)</h3>
            <ul class="space-y-2">
              {upsInfo.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M7 6V4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-green-50 p-5 rounded-xl border border-green-100">
            <h3 class="font-semibold text-green-800 mb-3">Solar Energy System</h3>
            <ul class="space-y-2">
              {solarInfo.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="energy-efficiency" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Energy Efficiency Tips</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Energy Management</h3>
        <div class="flex flex-wrap gap-2 mb-8">
          {powerManagement.map((item, index) => (
            <span key={index} class="bg-green-100 text-green-700 px-4 py-2 rounded-lg text-sm font-medium">{item}</span>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Cost Calculation</h3>
        <div class="bg-gradient-to-r from-charcoal-800 to-charcoal-900 p-6 rounded-xl text-white">
          <div class="space-y-2">
            {costCalculation.map((item, index) => (
              <p key={index}>{item}</p>
            ))}
          </div>
        </div>
      </section>

      <section id="site-survey" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">The Pre-Delivery Site Survey</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Most electrical problems are decided before the machine arrives. A single photograph of the distribution board and five minutes with a clamp meter prevent the commonest commissioning delays: missing neutral, an undersized service, or phase imbalance that trips the breaker mid-cycle. Walk the site with this checklist before the press ships.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li><strong>Service capacity:</strong> confirmed kVA at the meter, not the transformer nameplate down the street.</li>
            <li><strong>Phase balance:</strong> measured current on each phase at peak load; under 10% imbalance.</li>
            <li><strong>Voltage stability:</strong> note the swing between midday and evening; brownouts damage motors and contactors.</li>
            <li><strong>Earth path:</strong> a true grounding electrode with measured resistance below 4 ohms.</li>
            <li><strong>Panel space:</strong> room for the press breaker plus roaster, cleaner, crusher, and filter circuits.</li>
            <li><strong>Cable route:</strong> protected from forklift traffic, water wash-down, and hot roaster surfaces.</li>
          </ul>
        </div>
      </section>

      <section id="full-line-distribution" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Distributing Power Across the Whole Line</h2>
        <p class="text-steel-700 leading-relaxed mb-4">The press motor is only 2.2 kW, but a complete line draws 20–40 kVA, and the roaster dominates the total. Put each major machine on its own breaker sized to 1.25× its full-load current, sequence startup so the roaster does not start on top of the press motor, and interlock the crusher and conveyor so a stopped machine does not keep getting fed.</p>
        <p class="text-steel-700 leading-relaxed mb-4">Power quality matters as much as quantity. Long cable runs with undersized conductors create voltage sag at the very moment the pump starts against load; the motor then draws excess current, heats, and trips — a failure that is frequently misdiagnosed as a machine fault. Size cable for voltage drop under 3% over the actual run length, not just for ampacity. If generator power is planned, follow the sizing and grounding rules in our generator section above rather than renting a unit matched only to the press nameplate.</p>
      </section>

      <section id="commissioning-verification" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Commissioning and Acceptance Checks</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Before accepting installation, verify the electrical installation under load, not at idle. Run a full pressing cycle and record phase currents, voltage at the motor terminals during pump startup, and the temperature of breakers and main cable lugs after an hour of operation. Hot lugs indicate loose connections and are the leading cause of later panel fires.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Confirm motor rotation with the pump decoupled, then check pump flow under pressure.</li>
          <li>Test every emergency stop and the pressure-limit switch independently — do not assume they work because the lamp lights.</li>
          <li>Verify the earth-bond reading between the press frame and the panel earth bar.</li>
          <li>Label every circuit and leave the updated single-line diagram with the owner; the next fault is fixed in minutes with labels and by the hour without them.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed">These checks take a competent electrician about half a day and are the cheapest insurance a mill can buy. For the complete facility picture — power, water, drainage, and floor load — see the <a href="/resources/complete-oil-production-line-guide/" class="text-amber-600 hover:underline">complete production line guide</a>.</p>
        <h3 class="font-semibold text-lg mt-6 mb-3 text-charcoal-900">Diagnosing recurring breaker trips</h3>
        <p class="text-steel-700 leading-relaxed mb-4">A breaker that trips only at peak pressure, or only in the afternoon, is giving diagnostic information rather than merely failing. Trips under load with a warm cable point to undersized conductors or a loose connection adding resistance; trips that track the time of day point to grid voltage sag as neighbouring loads come online; random trips with cool equipment point to a weak breaker or earth leakage. Resist the common instinct to fit a larger breaker — that removes the warning while leaving the fault, and converts a nuisance trip into a burnt motor or a panel fire. Measure first: clamp current at the trip moment, read voltage at the motor terminals, and tighten lugs to torque before changing any protective device.</p>
        <p class="text-steel-700 leading-relaxed">Document every recurring event with time, machine state, and weather; patterns that look random across a week usually line up against roast-cycle timing or generator handover, and the log lets an electrician fix the cause in one visit instead of three.</p>
        <p class="text-steel-700 leading-relaxed mt-4">Two final habits prevent most of the faults described here: keep water and oil away from the panel and conduit during wash-down — damp panels fail weeks later, not on the day they get wet — and never bypass an earth-leakage device "to keep production running". Residual-current protection exists because a press floor combines water, oil, conductive steelwork, and human operators; its nuisance trips are themselves a signal that insulation or earthing needs attention, and the correct response is to find the leakage, never to disable the guard.</p>
      </section>

