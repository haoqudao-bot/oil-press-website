---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'aflatoxin-control-guide');
const t = getTranslations('en');

const title = resource?.data.title.en || 'Aflatoxin Control Guide';
const description = resource?.data.description.en || 'Comprehensive strategies for preventing and controlling aflatoxin contamination in oil seeds';
const seoKeywords = resource?.data.seoKeywords || ['aflatoxin control', 'aflatoxin prevention', 'oil food safety'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/aflatoxin-guide-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about/' },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' },
  },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/aflatoxin-control-guide/' },
  ],
};

const typesOfAflatoxins = [
  { type: 'Aflatoxin B1', danger: 'Highly toxic', sources: 'Corn, peanuts, rice', effects: 'Carcinogenic, hepatotoxic' },
  { type: 'Aflatoxin B2', danger: 'Toxic', sources: 'Peanuts, corn', effects: 'Less toxic than B1' },
  { type: 'Aflatoxin G1', danger: 'Toxic', sources: 'Grains, nuts', effects: 'Carcinogenic' },
  { type: 'Aflatoxin G2', danger: 'Less toxic', sources: 'Grains', effects: 'Minor effects' },
];

const contaminationSources = [
  { title: 'Humid Storage Conditions', desc: 'Storage in humid or flooded areas promotes fungal growth', icon: 'droplet' },
  { title: 'Extended Storage Time', desc: 'The longer seeds are stored, the higher the risk', icon: 'clock' },
  { title: 'Climate Conditions', desc: 'Warm temperatures and high humidity promote growth', icon: 'sun' },
  { title: 'Pre-Harvest', desc: 'Wet weather before harvest can contaminate crops', icon: 'cloud-rain' },
];

const preventionStrategies = [
  { title: 'Seed Control', items: ['Inspect quality before purchase', 'Avoid damaged or moldy seeds', 'Test batches for aflatoxin'] },
  { title: 'Proper Storage', items: ['Store in dry conditions', 'Use waterproof bags', 'Control relative humidity'] },
  { title: 'Immediate Drying', items: ['Dry seeds within 24 hours', 'Maintain moisture below 12%', 'Use industrial dryers'] },
];

const detectionMethods = [
  { method: 'Rapid Field Test', time: '5-10 minutes', accuracy: 'Low', useCase: 'Initial screening' },
  { method: 'ELISA Test', time: '2-4 hours', accuracy: 'Medium', useCase: 'Quality control' },
  { method: 'HPLC', time: '4-6 hours', accuracy: 'High', useCase: 'Certification' },
];

const regulations = [
  { region: 'EU', limit: '2 ppb', products: 'Edible oils' },
  { region: 'USA', limit: '20 ppb', products: 'Seeds and oils' },
  { region: 'Codex Alimentarius', limit: '10 ppb', products: 'Food products' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources/" class="hover:text-amber-500 transition-colors">Resources</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-red-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-red-500/10 text-red-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">
          FOOD SAFETY
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">
          {title.toUpperCase()}
        </h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">
          {description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-red-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
              <div class="text-sm text-steel-500">Engineering Team · Haonuo Machinery</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Why Aflatoxin Control Matters for Oil Mills</h2>
        <p class="text-steel-700 leading-relaxed">
          Aflatoxins are toxins produced by certain fungi (Aspergillus flavus and Aspergillus parasiticus) that can contaminate seeds used for oil production. Aflatoxin control is crucial for ensuring food safety and meeting international standards.
        </p>
      </section>

      <section id="types" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Types of Aflatoxins</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {typesOfAflatoxins.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="font-bold text-lg text-red-600 mb-3">{item.type}</div>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Danger:</span>
                  <span class="text-sm text-charcoal-900">{item.danger}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Sources:</span>
                  <span class="text-sm text-charcoal-900">{item.sources}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Effects:</span>
                  <span class="text-sm text-charcoal-900">{item.effects}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="sources" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Where Aflatoxin Contamination Begins</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {contaminationSources.map((item, index) => (
            <div key={index} class="bg-orange-50 p-5 rounded-xl border border-orange-200">
              <h3 class="font-semibold text-lg text-orange-800 mb-2">{item.title}</h3>
              <p class="text-steel-700 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="prevention" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Aflatoxin Prevention From Field to Storage</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {preventionStrategies.map((item, index) => (
            <div key={index} class="bg-green-50 p-5 rounded-xl border border-green-200">
              <h3 class="font-semibold text-lg text-green-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {task}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="detection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">How to Test for Aflatoxin Before Pressing</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-indigo-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Method</th>
                <th class="px-4 py-3 text-left font-semibold">Time</th>
                <th class="px-4 py-3 text-left font-semibold">Accuracy</th>
                <th class="px-4 py-3 text-left font-semibold">Use Case</th>
              </tr>
            </thead>
            <tbody>
              {detectionMethods.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.method}</td>
                  <td class="px-4 py-3 text-amber-600">{item.time}</td>
                  <td class="px-4 py-3 text-emerald-600">{item.accuracy}</td>
                  <td class="px-4 py-3 text-steel-700">{item.useCase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="regulations" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Aflatoxin Limits in Major Export Markets</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {regulations.map((item, index) => (
            <div key={index} class="bg-purple-50 p-5 rounded-xl border border-purple-200">
              <h3 class="font-semibold text-lg text-purple-800 mb-3">{item.region}</h3>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Limit:</span>
                  <span class="text-sm text-red-600 font-bold">{item.limit}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Products:</span>
                  <span class="text-sm text-charcoal-900">{item.products}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="processing-reduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Does Pressing or Refining Remove Aflatoxin?</h2>
        <p class="text-steel-700 leading-relaxed mb-4">This is the question mill owners ask most — and the honest answer is partial, never complete. Aflatoxins are far more soluble in the solid meal than in oil, so mechanical pressing partitions most of any contamination into the cake; crude oil from contaminated seed typically carries substantially less toxin than the seed itself. Full refining — alkaline neutralisation, bleaching with activated clay, and deodorisation — reduces oil-borne aflatoxin further, often to below regulatory limits. Filtration alone removes only the solids-bound fraction.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Why processing is not a safety strategy</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>Removal is variable and depends on contamination level, seed type, and process — it cannot be guaranteed batch to batch.</li>
            <li>The cake concentrates the toxin; contaminated cake entering food or feed channels creates a second, larger compliance problem.</li>
            <li>Small and medium workshops selling crude or lightly filtered oil do not have the refining steps that do most of the removal.</li>
            <li>No buyer or regulator accepts "the press removes it" as a control measure; the documented control point is accepted seed, not processing.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">Treat processing as a secondary barrier that reduces risk, and build the primary barrier at intake: reject contaminated seed before it enters the building.</p>
      </section>

      <section id="mill-testing-protocol" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">A Practical Mill-Side Testing Protocol</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Laboratory HPLC and accredited ELISA are the reference methods, but a mill does not need a laboratory to control risk — it needs a repeatable intake routine using screening tools that flag suspect loads before unloading.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li><strong>Visual and organoleptic screen first:</strong> mould, discolouration, shrivelled kernels, musty smell, and visible insect damage reject or quarantine a load immediately.</li>
          <li><strong>Sample correctly:</strong> pull many small increments from multiple bags and depths — contamination is concentrated in a tiny fraction of kernels, and a single handful decides nothing.</li>
          <li><strong>Rapid screening:</strong> lateral-flow or qualitative ELISA test kits give a yes/no result against your limit in minutes and are cost-effective on every intake lot or every supplier delivery.</li>
          <li><strong>Escalate positives:</strong> send borderline or failed lots to an accredited laboratory for quantitative confirmation before any disposition decision.</li>
          <li><strong>Retain samples</strong> from each accepted lot, labelled with supplier, date, and batch, until well beyond the product's shelf life.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed">Screening is cheap relative to one rejected export shipment or a blocked brand listing; build its cost into the price per tonne of accepted seed rather than treating it as an optional expense.</p>
      </section>

      <section id="lot-disposition-suppliers" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Failed Lots and Supplier Contracts</h2>
        <p class="text-steel-700 leading-relaxed mb-4">What happens to a failed lot must be decided before the first delivery, not at the gate with a truck waiting. Mixing a failed lot into good seed to "dilute" it is illegal in virtually every regulated market and destroys the evidence trail; quarantine, label, and segregate suspect material physically, and dispose of confirmed lots through the channel local regulation prescribes — often supervised destruction or diversion to permitted non-food uses, never silently into cake for dairy or poultry feed.</p>
        <p class="text-steel-700 leading-relaxed mb-4">The durable fix is upstream. Put aflatoxin limits, sampling methods, and rejection-or-replacement terms in writing with every supplier, pay a documented premium for dry, clean, properly stored nut and seed, and give preferred suppliers the simple harvest advice that controls most contamination: full maturity, rapid drying to under 8% moisture, clean dry storage off the floor, and first-in-first-out rotation. Suppliers who cannot accept these terms are not cheap seed — they are contingent liability.</p>
        <p class="text-steel-700 leading-relaxed">The same moisture and storage discipline that protects against aflatoxin also improves oil yield and protects equipment, which ties food safety directly to the economics covered in our <a href="/resources/oil-press-raw-materials-guide/" class="text-amber-600 hover:underline">raw materials guide</a> and <a href="/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">yield guide</a>: a controlled, dry, traceable intake is simultaneously the safest and the most profitable way to run a mill.</p>
        <h3 class="font-semibold text-lg mt-6 mb-3 text-charcoal-900">Record-keeping and recall readiness</h3>
        <p class="text-steel-700 leading-relaxed mb-4">Exporters and branded sellers are increasingly asked to demonstrate the control system, not just pass one test. A workable system needs only four linked records per lot: supplier and origin, intake screening result with date, which pressing and filtration batches consumed the lot, and which customers received the finished oil. On paper or in a simple spreadsheet, this chain lets a mill trace any bottle back to its seed within an hour — the capability buyers and auditors actually look for — and limits any recall to defined batches instead of an entire production month.</p>
        <p class="text-steel-700 leading-relaxed">Review the records monthly: suppliers linked to repeated borderline results get warnings or replacement terms, seasonal risk windows become visible year over year, and the discipline quietly converts food-safety compliance from a cost into a selling point with importers who have been burnt by undocumented suppliers.</p>
        <p class="text-steel-700 leading-relaxed mt-4">Training completes the system. The people who unload trucks and turn bins must be able to name the three rejection signals — mould, moisture, and musty smell — and know that accepting a suspicious load to avoid an argument is the one decision the rest of the process cannot undo. A five-minute toolbox talk each harvest week, repeated for every new worker, keeps the documented procedure real at the gate rather than merely correct on paper.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Building an Aflatoxin-Safe Oil Production Routine</h2>
        <p class="text-steel-700 leading-relaxed">
          Aflatoxin control requires a proactive approach at every stage of the supply chain. By combining rigorous raw material selection, proper storage, and reliable detection methods, you can ensure product safety and meet international standards.
        </p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">READY TO ENSURE YOUR PRODUCTION SAFETY?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Our engineering team can help you implement complete quality control procedures.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          {t.resources.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/resources/" class="btn-outline border-white text-white hover:bg-white/10">
          {t.resources.backToResources}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
