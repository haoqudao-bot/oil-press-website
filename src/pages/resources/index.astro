﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('en');

const allResources = await getCollection('resources');
const sortedResources = allResources.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const newsItems = sortedResources.filter(r => r.data.type === 'news');
const guideItems = sortedResources.filter(r => ['guide', 'comparison'].includes(r.data.type));

const typeLabels: Record<string, string> = {
  comparison: 'Comparison',
  guide: 'Guide',
  blog: 'Article',
  news: 'News',
};

const typeColors: Record<string, string> = {
  comparison: 'bg-blue-100 text-blue-700',
  guide: 'bg-green-100 text-green-700',
  blog: 'bg-purple-100 text-purple-700',
  news: 'bg-amber-100 text-amber-700',
};
---

<BaseLayout title={t.resources.title} description={t.resources.subtitle} jsonLd={{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
  ],
}}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.resources.title}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.resources.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.resources.subtitle}</p>
    </div>
  </section>

  <!-- News Section -->
  {newsItems.length > 0 && (
  <section class="py-12 md:py-16 bg-amber-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">📰</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">News & Updates</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {newsItems.map((resource, i) => (
          <a href={`/resources/${resource.slug}`} class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group" style={`animation-delay: ${i * 80}ms`}>
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
                  {typeLabels[resource.data.type] || resource.data.type}
                </span>
                <time class="text-xs text-steel-400">
                  {resource.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
                {resource.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
                {resource.data.description.en}
              </p>
              <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
                Read More
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Guides & Tutorials Section -->
  {guideItems.length > 0 && (
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">📖</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">Guides & Tutorials</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {guideItems.map((resource, i) => (
          <a href={`/resources/${resource.slug}`} class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group" style={`animation-delay: ${i * 80}ms`}>
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
                  {typeLabels[resource.data.type] || resource.data.type}
                </span>
                <time class="text-xs text-steel-400">
                  {resource.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
                {resource.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
                {resource.data.description.en}
              </p>
              <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
                Read More
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Tools Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">🛠️</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">Tools</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <a href="/roi-calculator" class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group">
          <div class="p-6">
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">Tool</span>
            </div>
            <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
              ROI Calculator
            </h3>
            <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
              Calculate your return on investment for hydraulic oil press machines. Input your expected daily capacity and seed costs to see your projected profits.
            </p>
            <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
              Start Calculating
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
