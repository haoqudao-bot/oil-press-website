﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('en');

const allResources = await getCollection('resources');
const sortedResources = allResources.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const newsItems = sortedResources.filter(r => r.data.type === 'news');
const guideItems = sortedResources.filter(r => ['guide', 'comparison'].includes(r.data.type));

const typeLabels: Record<string, string> = {
  comparison: 'Comparison',
  guide: 'Guide',
  blog: 'Article',
  news: 'News',
};

const typeColors: Record<string, string> = {
  comparison: 'bg-blue-100 text-blue-700',
  guide: 'bg-green-100 text-green-700',
  blog: 'bg-purple-100 text-purple-700',
  news: 'bg-amber-100 text-amber-700',
};
---

<BaseLayout title={t.resources.title} description={t.resources.subtitle} jsonLd={{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
  ],
}}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.resources.title}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.resources.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.resources.subtitle}</p>
    </div>
  </section>

  <!-- Start Here: Reading Path -->
  <section class="py-12 md:py-16 bg-white border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 mb-3">Start Here — A Reading Path for New Buyers</h2>
        <p class="text-steel-600 leading-relaxed">These guides follow the same decision path our sales engineers walk buyers through: <strong class="text-charcoal-900">(1) choose your pressing method and raw material, (2) size the machine to your daily output, (3) plan power, filtration and the full production line</strong>. If you are new to oil pressing, read the four topic groups below in order — each links to the most relevant guide.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-steel-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 rounded-full bg-amber-500 text-charcoal-900 font-display font-bold flex items-center justify-center text-sm flex-shrink-0">1</span>
            <h3 class="font-display text-lg text-charcoal-900">Choose your method &amp; material</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed mb-3">Cold pressing preserves nutrients; hot pressing gives higher yield. First confirm which fits your seeds and market.</p>
          <ul class="text-sm space-y-1.5">
            <li><a href="/resources/cold-press-vs-hot-press-oil" class="text-amber-600 hover:text-amber-700 underline">Cold Press vs Hot Press Oil</a></li>
            <li><a href="/resources/oil-press-raw-materials-guide" class="text-amber-600 hover:text-amber-700 underline">Oil Press Raw Materials Guide</a></li>
          </ul>
        </div>
        <div class="bg-steel-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 rounded-full bg-amber-500 text-charcoal-900 font-display font-bold flex items-center justify-center text-sm flex-shrink-0">2</span>
            <h3 class="font-display text-lg text-charcoal-900">Select the right machine</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed mb-3">Compare hydraulic, screw and manual presses, then match model capacity to your planned daily output.</p>
          <ul class="text-sm space-y-1.5">
            <li><a href="/resources/hydraulic-oil-press-buying-guide" class="text-amber-600 hover:text-amber-700 underline">Hydraulic Oil Press Buying Guide</a></li>
            <li><a href="/resources/hydraulic-oil-press-vs-other-types" class="text-amber-600 hover:text-amber-700 underline">Hydraulic Press vs Other Press Types</a></li>
          </ul>
        </div>
        <div class="bg-steel-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 rounded-full bg-amber-500 text-charcoal-900 font-display font-bold flex items-center justify-center text-sm flex-shrink-0">3</span>
            <h3 class="font-display text-lg text-charcoal-900">Improve quality &amp; yield</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed mb-3">Get more oil per batch, filter it to market-ready clarity, and turn press cake into a second income stream.</p>
          <ul class="text-sm space-y-1.5">
            <li><a href="/resources/how-to-maximize-oil-yield" class="text-amber-600 hover:text-amber-700 underline">How to Maximize Oil Yield</a></li>
            <li><a href="/resources/crude-oil-filtration-guide" class="text-amber-600 hover:text-amber-700 underline">Crude Oil Filtration Guide</a></li>
            <li><a href="/resources/oil-cake-byproduct-guide" class="text-amber-600 hover:text-amber-700 underline">Oil Cake By-product Guide</a></li>
          </ul>
        </div>
        <div class="bg-steel-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 rounded-full bg-amber-500 text-charcoal-900 font-display font-bold flex items-center justify-center text-sm flex-shrink-0">4</span>
            <h3 class="font-display text-lg text-charcoal-900">Plan &amp; run your business</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed mb-3">Plan the full line, prepare the right power supply, maintain the machine, and check when the investment pays back.</p>
          <ul class="text-sm space-y-1.5">
            <li><a href="/resources/complete-oil-production-line-guide" class="text-amber-600 hover:text-amber-700 underline">Complete Oil Production Line Guide</a></li>
            <li><a href="/resources/oil-press-electrical-requirements-guide" class="text-amber-600 hover:text-amber-700 underline">Electrical Requirements Guide</a></li>
            <li><a href="/resources/hydraulic-oil-press-maintenance-guide" class="text-amber-600 hover:text-amber-700 underline">Maintenance Guide</a></li>
            <li><a href="/roi-calculator" class="text-amber-600 hover:text-amber-700 underline">ROI Calculator</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- News Section -->
  {newsItems.length > 0 && (
  <section class="py-12 md:py-16 bg-amber-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">📰</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">News & Updates</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {newsItems.map((resource, i) => (
          <a href={`/resources/${resource.slug}`} class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group" style={`animation-delay: ${i * 80}ms`}>
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
                  {typeLabels[resource.data.type] || resource.data.type}
                </span>
                <time class="text-xs text-steel-400">
                  {resource.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
                {resource.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
                {resource.data.description.en}
              </p>
              <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
                Read More
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Guides & Tutorials Section -->
  {guideItems.length > 0 && (
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">📖</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">Guides & Tutorials</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {guideItems.map((resource, i) => (
          <a href={`/resources/${resource.slug}`} class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group" style={`animation-delay: ${i * 80}ms`}>
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
                  {typeLabels[resource.data.type] || resource.data.type}
                </span>
                <time class="text-xs text-steel-400">
                  {resource.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
                {resource.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
                {resource.data.description.en}
              </p>
              <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
                Read More
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Tools Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">🛠️</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">Tools</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <a href="/roi-calculator" class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group no-underline" data-static-en-only="true">
          <div class="p-6">
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">Tool</span>
            </div>
            <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
              ROI Calculator
            </h3>
            <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
              Calculate your return on investment for hydraulic oil press machines. Input your expected daily capacity and seed costs to see your projected profits.
            </p>
            <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
              Start Calculating
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
