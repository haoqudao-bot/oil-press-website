---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'crude-oil-filtration-guide');
const t = getTranslations('en');

const title = resource?.data.title.en || 'Crude Oil Filtration Guide';
const description = resource?.data.description.en || 'Clean, pure oil from every press';
const seoKeywords = resource?.data.seoKeywords || ['oil filtration', 'crude oil refining', 'oil filter system'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/filtration-guide-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Oil Processing Engineer', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/crude-oil-filtration-guide' },
  ],
};

const filtrationImportance = [
  { icon: 'shield', title: 'Remove Impurities', desc: 'Eliminate solid particles, moisture, and contaminants' },
  { icon: 'star', title: 'Improve Quality', desc: 'Clearer, purer oil with better appearance' },
  { icon: 'trending-up', title: 'Higher Value', desc: 'Clean oil commands premium market price' },
  { icon: 'clock', title: 'Longer Shelf Life', desc: 'Prevent oxidation and rancidity' },
  { icon: 'flask', title: 'Better Taste', desc: 'Remove bitter compounds and sediment' },
];

const filtrationMethods = [
  { name: 'Gravity Filtration', pros: ['Simple, no power needed', 'Low cost', 'Good for small batches'], cons: ['Slow process', 'Not completely effective', 'Large space needed'], bestFor: 'Home production, small batches < 20L' },
  { name: 'Pressure Filtration', pros: ['Fast process', 'Effective removal', 'Compact design'], cons: ['Requires pump', 'Filter cartridges needed'], bestFor: 'Small to medium workshops, 20-200L batches' },
  { name: 'Vacuum Filtration', pros: ['Very fast', 'High purity', 'Can handle large volumes'], cons: ['More complex setup', 'Higher cost'], bestFor: 'Commercial production, 200L+ batches' },
  { name: 'Centrifugal Separation', pros: ['Extremely fast', 'Removes water and solids', 'No filter consumables'], cons: ['High initial cost', 'Requires electricity'], bestFor: 'Large commercial operations' },
];

const stepByStep = [
  { step: '1', title: 'Settling', desc: 'Let crude oil sit in a tank for 24-48 hours. Water and heavy solids settle to the bottom.' },
  { step: '2', title: 'Pre-Filtration', desc: 'Pass oil through a coarse filter (50-100 micron) to remove large particles.' },
  { step: '3', title: 'Main Filtration', desc: 'Filter through fine filter (5-20 micron) to remove fine sediment.' },
  { step: '4', title: 'Polishing', desc: 'Optional: filter through activated carbon or bleaching earth for crystal-clear oil.' },
  { step: '5', title: 'Drying', desc: 'Heat oil to 80-90°C to remove residual moisture (for long-term storage).' },
  { step: '6', title: 'Final Testing', desc: 'Check clarity, moisture content, and purity before bottling.' },
];

const filterSelection = [
  { filter: 'Paper Filter', micron: '5-20', life: 'Single use or 10-50L', cost: 'Contact for pricing', use: 'Most common, good for home/small workshop' },
  { filter: 'Metal Mesh', micron: '50-100', life: 'Reusable (clean)', cost: 'Contact for pricing', use: 'Pre-filtration, coarse removal' },
  { filter: 'Centrifuge', micron: '0.1-5', life: 'Permanent', cost: 'Contact for pricing', use: 'Commercial, high-volume production' },
  { filter: 'Cross-flow Filter', micron: '1-10', life: 'Reusable', cost: 'Contact for pricing', use: 'Medium to large production' },
];

const qualityChecks = [
  { test: 'Visual Clarity', method: 'Hold oil up to light - should be clear, no visible sediment', standard: 'No visible particles' },
  { test: 'Moisture Content', method: 'Use moisture meter or heat test', standard: '< 0.1% moisture' },
  { test: 'Taste & Odor', method: 'Smell and taste sample', standard: 'Clean, fresh taste and aroma' },
  { test: 'pH Level', method: 'Use pH test strips or meter', standard: 'pH 6-7 (neutral)' },
];

const storageTips = [
  'Store filtered oil in clean, dark glass bottles',
  'Keep away from direct sunlight',
  'Use food-grade containers only',
  'Leave headspace in containers to prevent oxidation',
  'Label with production date and type of oil',
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PROCESSING GUIDE</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Oil Processing Engineer · 15+ Years Experience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Crude oil filtration is a critical step in oil production that separates the raw extracted oil from solid particles, water, and other impurities. Proper filtration transforms raw pressed oil into a valuable, marketable product.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>After pressing, crude oil typically contains 2-5% solid particles and 0.5-2% water. Filtration removes these impurities to produce clean, marketable oil.</p>
        </div>
      </section>

      <section id="importance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Why Filtration Matters</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filtrationImportance.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
                  {item.icon === 'star' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
                  {item.icon === 'trending-up' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                  {item.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                  {item.icon === 'flask' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3h6M10 3v18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3"/><path d="M14 3v18a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V3"/></svg>}
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="methods" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Filtration Methods Compared</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {filtrationMethods.map((method, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden hover:shadow-lg transition-all duration-300">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-gray-500 to-gray-600' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-purple-500 to-pink-500' : 'bg-gradient-to-r from-green-500 to-emerald-500'}`}>
                <h3 class="font-display text-lg text-white">{method.name}</h3>
              </div>
              <div class="p-5">
                <div class="grid grid-cols-3 gap-3">
                  <div class="bg-green-50 p-3 rounded-lg">
                    <p class="text-xs text-green-600 mb-1">Pros</p>
                    {method.pros.map((pro, idx) => <p key={idx} class="text-xs text-steel-700">+ {pro}</p>)}
                  </div>
                  <div class="bg-red-50 p-3 rounded-lg">
                    <p class="text-xs text-red-600 mb-1">Cons</p>
                    {method.cons.map((con, idx) => <p key={idx} class="text-xs text-steel-700">- {con}</p>)}
                  </div>
                  <div class="bg-blue-50 p-3 rounded-lg">
                    <p class="text-xs text-blue-600 mb-1">Best For</p>
                    <p class="text-xs text-steel-700">{method.bestFor}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="step-by-step" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Step-by-Step Filtration Process</h2>
        <div class="space-y-4">
          {stepByStep.map((step, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{step.step}</div>
                {index < stepByStep.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < stepByStep.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{step.title}</h3>
                <p class="text-steel-600">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="filter-selection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Filter Media Selection Guide</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Filter Type</th>
                <th class="px-4 py-3 text-left font-semibold">Micron Rating</th>
                <th class="px-4 py-3 text-left font-semibold">Life Span</th>
                <th class="px-4 py-3 text-left font-semibold">Cost</th>
                <th class="px-4 py-3 text-left font-semibold">Recommended Use</th>
              </tr>
            </thead>
            <tbody>
              {filterSelection.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.filter}</td>
                  <td class="px-4 py-3 text-blue-600">{item.micron}</td>
                  <td class="px-4 py-3">{item.life}</td>
                  <td class="px-4 py-3 text-green-600">{item.cost}</td>
                  <td class="px-4 py-3 text-steel-600 text-sm">{item.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="quality-checks" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Quality Control Checks</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {qualityChecks.map((check, index) => (
            <div key={index} class="bg-gradient-to-br from-green-50 to-emerald-50 p-5 rounded-xl border border-green-100">
              <h3 class="font-semibold text-green-800 mb-2">{check.test}</h3>
              <p class="text-steel-700 text-sm mb-2"><strong>Method:</strong> {check.method}</p>
              <p class="text-green-700 text-sm"><strong>Standard:</strong> {check.standard}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="storage" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Proper Storage After Filtration</h2>
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <ul class="space-y-3">
            {storageTips.map((tip, index) => (
              <li key={index} class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-steel-700">{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Investing in proper filtration equipment is essential for producing high-quality, marketable oil. By following the methods and techniques outlined in this guide, you can significantly improve your oil quality and profitability. For equipment recommendations, contact our team.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">PRODUCE PREMIUM OIL TODAY</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Our team can recommend the right filtration equipment for your production scale and budget.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Get Expert Advice<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/products" class="btn-outline border-white text-white hover:bg-white/10">View Equipment</a>
        <a href="/resources" class="btn-outline border-white text-white hover:bg-white/10">Back to Resources</a>
      </div>
    </div>
  </section>
</BaseLayout>