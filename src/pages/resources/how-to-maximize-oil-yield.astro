---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'how-to-maximize-oil-yield');
const t = getTranslations('en');

const title = resource?.data.title.en || 'How to Maximize Oil Yield';
const description = resource?.data.description.en || 'Get more oil from every seed';
const seoKeywords = resource?.data.seoKeywords || ['maximize oil yield', 'increase oil extraction', 'oil yield optimization'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/maximize-yield-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Senior Oil Press Engineer', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/how-to-maximize-oil-yield' },
  ],
};

const yieldFactors = [
  { icon: 'seed', title: 'Raw Material Quality', desc: 'High-quality seeds = higher yield' },
  { icon: 'droplet', title: 'Moisture Content', desc: 'Optimal moisture = 5-8%' },
  { icon: 'flame', title: 'Roasting', desc: 'Proper roasting breaks down cell walls' },
  { icon: 'gear', title: 'Grinding', desc: 'Proper particle size increases surface area' },
  { icon: 'pressure', title: 'Pressure', desc: 'Higher pressure = more oil extraction' },
  { icon: 'clock', title: 'Pressing Time', desc: 'Adequate holding time at peak pressure' },
];

const moistureGuide = [
  { material: 'Sesame', optimal: '5-6%', tooDry: 'Brittle, reduced yield', tooWet: 'Emulsification, sticky cake' },
  { material: 'Peanut', optimal: '5-7%', tooDry: 'Difficult to press', tooWet: 'Slippery, uneven extraction' },
  { material: 'Rapeseed', optimal: '6-8%', tooDry: 'Hard cake, low yield', tooWet: 'Wet cake, oil loss' },
  { material: 'Walnut', optimal: '7-9%', tooDry: 'Crumbles, hard to press', tooWet: 'Mold risk' },
];

const roastingGuide = [
  { material: 'Sesame', temp: '160-180°C', time: '25-30 min', color: 'Golden brown', yield: '48-54%' },
  { material: 'Peanut', temp: '165-185°C', time: '30-35 min', color: 'Light brown', yield: '45-50%' },
  { material: 'Rapeseed', temp: '150-170°C', time: '20-25 min', color: 'Dark brown', yield: '38-42%' },
];

const pressureGuide = [
  { step: 'Loading', pressure: 'Initial loading pressure', time: 'Load material evenly into press chamber' },
  { step: 'Pre-pressing', pressure: '30-40 MPa', time: 'Hold for 2-3 minutes to expel air' },
  { step: 'Main pressing', pressure: '50-60 MPa', time: 'Hold for 5-10 minutes depending on material' },
  { step: 'Release', pressure: 'Gradual release', time: 'Slow release prevents oil loss through foam' },
];

const proTips = [
  { title: 'Clean Seeds Thoroughly', desc: 'Remove all stones, metal, and debris before processing. Even small stones can damage the press and reduce yield.' },
  { title: 'Dehull Properly', desc: 'Remove seed coats as they absorb oil and reduce yield. Aim for 95%+ dehulling for most seeds.' },
  { title: 'Control Moisture Precisely', desc: 'Use a moisture meter if possible. Or test by squeezing - material should hold together but crumble easily.' },
  { title: 'Roast Consistently', desc: 'Use a thermometer to maintain consistent roasting temperature. Inconsistent roasting = inconsistent yield.' },
  { title: 'Grind to Optimal Size', desc: '2-4mm for most seeds, 3-5mm for nuts. Too fine = difficult to press, too coarse = uneven extraction.' },
  { title: 'Load Evenly', desc: 'Distribute material evenly in the press chamber. Uneven loading causes uneven pressure and reduced yield.' },
  { title: 'Peak Pressure Hold Time', desc: 'Hold at maximum pressure for 5-10 minutes. Rushing this step can reduce yield by 5-10%.' },
  { title: 'Progressive Pressing', desc: 'Apply pressure gradually rather than suddenly. Sudden pressure can trap oil in the cake.' },
];

const yieldComparison = [
  { scenario: 'Poor preparation', sesam: '30-35%', peanut: '28-32%', rapeseed: '25-28%' },
  { scenario: 'Average preparation', sesam: '40-45%', peanut: '38-42%', rapeseed: '32-35%' },
  { scenario: 'Excellent preparation', sesam: '48-54%', peanut: '45-50%', rapeseed: '38-42%' },
];

const maintenanceTips = [
  'Keep hydraulic system well-maintained for consistent pressure',
  'Check and replace filter regularly to prevent flow restriction',
  'Keep the press chamber clean to avoid contamination',
  'Follow manufacturer maintenance schedule',
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PRODUCTION GUIDE</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Senior Oil Press Engineer · 15+ Years Experience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Maximizing oil yield is the key to profitability in oil production. Small improvements in process can dramatically increase your oil output and revenue.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Proper technique can increase yield by 10-20%. That's 10-20 kg more oil from every 100 kg of seeds processed.</p>
        </div>
      </section>

      <section id="factors" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Key Factors Affecting Yield</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {yieldFactors.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'seed' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a10 10 0 0 0 10-10V2H12a10 10 0 0 0 0 20Z"/><path d="M12 22V12h10"/></svg>}
                  {item.icon === 'droplet' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S6 13 6 15a7 7 0 0 0 7 7z"/></svg>}
                  {item.icon === 'flame' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>}
                  {item.icon === 'gear' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>}
                  {item.icon === 'pressure' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10M18 20V4M6 20v-6"/></svg>}
                  {item.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="moisture" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Moisture Content Optimization</h2>
        <div class="overflow-x-auto mb-4">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Material</th><th class="px-4 py-3 text-left font-semibold">Optimal Moisture</th><th class="px-4 py-3 text-left font-semibold">Too Dry</th><th class="px-4 py-3 text-left font-semibold">Too Wet</th></tr>
            </thead>
            <tbody>
              {moistureGuide.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.material}</td>
                  <td class="px-4 py-3 text-green-600 font-medium">{item.optimal}</td>
                  <td class="px-4 py-3 text-red-500 text-sm">{item.tooDry}</td>
                  <td class="px-4 py-3 text-red-500 text-sm">{item.tooWet}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="roasting" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Roasting for Maximum Yield</h2>
        <p class="text-steel-700 mb-6">Proper roasting is one of the most critical factors in maximizing oil yield. It breaks down cell walls and releases trapped oil.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {roastingGuide.map((item, index) => (
            <div key={index} class="bg-gradient-to-br from-orange-50 to-amber-50 p-5 rounded-xl border border-orange-100">
              <h3 class="font-display text-lg mb-3 text-orange-800">{item.material}</h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between"><span class="text-steel-500">Temperature:</span><span class="font-semibold text-orange-700">{item.temp}</span></div>
                <div class="flex justify-between"><span class="text-steel-500">Time:</span><span class="font-semibold text-orange-700">{item.time}</span></div>
                <div class="flex justify-between"><span class="text-steel-500">Color:</span><span class="font-semibold text-orange-700">{item.color}</span></div>
                <div class="flex justify-between"><span class="text-steel-500">Yield:</span><span class="font-bold text-green-600">{item.yield}</span></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="pressure" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Optimal Pressing Technique</h2>
        <div class="space-y-4">
          {pressureGuide.map((item, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{index + 1}</div>
                {index < pressureGuide.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < pressureGuide.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{item.step}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  <p class="text-amber-600 font-medium mb-1">{item.pressure}</p>
                  <p class="text-steel-600">{item.time}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="pro-tips" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Professional Tips</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {proTips.map((tip, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 p-5 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{tip.title}</h4>
                  <p class="text-steel-600 text-sm">{tip.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="comparison" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Yield Comparison</h2>
        <p class="text-steel-700 mb-6">See the dramatic difference proper preparation makes on final oil yield:</p>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-green-500 to-emerald-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Preparation Level</th><th class="px-4 py-3 text-left font-semibold">Sesame</th><th class="px-4 py-3 text-left font-semibold">Peanut</th><th class="px-4 py-3 text-left font-semibold">Rapeseed</th></tr>
            </thead>
            <tbody>
              {yieldComparison.map((item, index) => (
                <tr key={index} class={index === 0 ? 'bg-red-50' : index === 1 ? 'bg-amber-50' : 'bg-green-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.scenario}</td>
                  <td class={`px-4 py-3 font-medium ${index === 0 ? 'text-red-600' : index === 1 ? 'text-amber-600' : 'text-green-600'}`}>{item.sesam}</td>
                  <td class={`px-4 py-3 font-medium ${index === 0 ? 'text-red-600' : index === 1 ? 'text-amber-600' : 'text-green-600'}`}>{item.peanut}</td>
                  <td class={`px-4 py-3 font-medium ${index === 0 ? 'text-red-600' : index === 1 ? 'text-amber-600' : 'text-green-600'}`}>{item.rapeseed}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Equipment Maintenance for Consistent Yield</h2>
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <ul class="space-y-3">
            {maintenanceTips.map((tip, index) => (
              <li key={index} class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-steel-700">{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Maximizing oil yield is a combination of proper preparation, correct technique, and consistent practice. By implementing the tips in this guide, you can significantly increase your oil production and profitability. For personalized optimization advice, contact our engineering team.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">BOOST YOUR YIELD TODAY</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Our engineers can help you optimize every step of your oil production process for maximum yield.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Contact Our Experts<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/products" class="btn-outline border-white text-white hover:bg-white/10">Browse Equipment</a>
        <a href="/resources" class="btn-outline border-white text-white hover:bg-white/10">Back to Resources</a>
      </div>
    </div>
  </section>
</BaseLayout>