---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-buying-guide');
const t = getTranslations('en');

const title = resource?.data.title.en || 'Hydraulic Oil Press Buying Guide';
const description = resource?.data.description.en || 'Invest in the right press with confidence';
const seoKeywords = resource?.data.seoKeywords || ['oil press buying guide', 'how to choose oil press', 'oil press purchase checklist'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/buying-guide-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Senior Oil Press Engineer', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/hydraulic-oil-press-buying-guide' },
  ],
};

const buyingChecklist = [
  { category: 'Production Needs', items: [
    'Daily production target (kg/day)',
    'Types of materials to process',
    'Required oil quality (virgin, cooking, etc.)',
    'Cold pressing capability needed?',
  ]},
  { category: 'Technical Specifications', items: [
    'Hydraulic pressure (40-60 MPa recommended)',
    'Motor power (2.2 kW standard)',
    'Voltage (220V or 380V)',
    'Machine dimensions and weight',
  ]},
  { category: 'Quality & Warranty', items: [
    'Manufacturer reputation and experience',
    'Warranty period (1 year minimum)',
    'After-sales service availability',
    'Spare parts availability',
  ]},
  { category: 'Budget Considerations', items: [
    'Machine purchase price',
    'Installation and training costs',
    'Spare parts and maintenance',
    'Operating costs (power, labor)',
  ]},
];

const modelSelection = [
  { model: 'HN325', capacity: '5-10 kg/h', pressure: '50 MPa', materials: 'Sesame, peanut, rapeseed', price: '$3,500-$4,500', highlight: 'Best for home business' },
  { model: 'HN355', capacity: '10-20 kg/h', pressure: '50 MPa', materials: 'Most oil seeds', price: '$5,000-$6,500', highlight: 'Best for small workshop' },
  { model: 'HN426', capacity: '15-25 kg/h', pressure: '55 MPa', materials: 'Walnut, almond, coconut', price: '$7,000-$9,000', highlight: 'Premium cold pressing' },
  { model: 'HN480', capacity: '20-35 kg/h', pressure: '60 MPa', materials: 'Various high-oil seeds', price: '$9,000-$12,000', highlight: 'Medium production' },
  { model: 'HN500', capacity: '30-50 kg/h', pressure: '60 MPa', materials: 'Commercial scale', price: '$12,000-$18,000', highlight: 'Commercial production' },
];

const questionsToAsk = [
  'What is your daily production target?',
  'Which seeds/nuts will you process?',
  'Do you need cold pressing capability?',
  'What is your budget range?',
  'Do you have a power source?',
  'What is your available workspace?',
  'Do you need training and installation support?',
  'What is your target oil market (virgin, cooking, cosmetic)?',
];

const redFlags = [
  'Unrealistically low price',
  'No warranty offered',
  'No after-sales service',
  'Unknown manufacturer location',
  'No technical documentation',
  'Pressure below 40 MPa',
  'Used/refurbished equipment',
];

const investment = [
  { type: 'Initial Investment', range: '$3,000 - $18,000', note: 'Depending on model and accessories' },
  { type: 'Installation & Training', range: '$500 - $2,000', note: 'On-site installation and operator training' },
  { type: 'Annual Maintenance', range: '$300 - $800', note: 'Spare parts, oil change, inspection' },
  { type: 'Operational Cost', range: '$0.5 - $1.5 per kg', note: 'Electricity + labor + maintenance' },
];

const roiExample = [
  { item: 'Machine: HN325', value: '$4,000' },
  { item: 'Daily output: 8 kg sesame oil', value: '' },
  { item: 'Monthly revenue (8 kg x 30 days x $15/kg)', value: '$3,600' },
  { item: 'Monthly cost (power + labor)', value: '$400' },
  { item: 'Monthly profit', value: '$3,200' },
  { item: 'Payback period', value: '≈ 1.2 months' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">BUYING GUIDE</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Senior Oil Press Engineer · 15+ Years Experience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Investing in a hydraulic oil press is a significant decision that can transform your oil production business. This comprehensive guide covers everything you need to know to make the right purchase.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>A good oil press can pay for itself in 1-3 months. A bad purchase can result in years of frustration and lost revenue. This guide will help you avoid costly mistakes.</p>
        </div>
      </section>

      <section id="checklist" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Pre-Purchase Checklist</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {buyingChecklist.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-md overflow-hidden">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <h3 class="font-semibold text-white flex items-center gap-2">
                  <span class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.category}
                </h3>
              </div>
              <div class="p-5">
                <ul class="space-y-2">
                  {item.items.map((item2, idx) => (
                    <li key={idx} class="flex items-start gap-3">
                      <div class="w-5 h-5 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                      </div>
                      <span class="text-steel-700 text-sm">{item2}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="models" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Model Selection Guide</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-charcoal-800 to-charcoal-900 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Model</th>
                <th class="px-4 py-3 text-left font-semibold">Capacity</th>
                <th class="px-4 py-3 text-left font-semibold">Pressure</th>
                <th class="px-4 py-3 text-left font-semibold">Best For</th>
                <th class="px-4 py-3 text-left font-semibold">Price Range</th>
              </tr>
            </thead>
            <tbody>
              {modelSelection.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-bold text-amber-600">{item.model}</td>
                  <td class="px-4 py-3 text-charcoal-900">{item.capacity}</td>
                  <td class="px-4 py-3 text-charcoal-900">{item.pressure}</td>
                  <td class="px-4 py-3">
                    <p class="text-steel-700 text-sm">{item.highlight}</p>
                    <p class="text-steel-500 text-xs">{item.materials}</p>
                  </td>
                  <td class="px-4 py-3 text-green-600 font-medium">{item.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="questions" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Questions to Ask Your Supplier</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {questionsToAsk.map((question, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-xl border border-blue-100 flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{index + 1}</div>
              <p class="text-steel-700">{question}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="red-flags" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Red Flags to Avoid</h2>
        <div class="bg-red-50 rounded-xl border border-red-200 p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {redFlags.map((flag, index) => (
              <div key={index} class="bg-white p-3 rounded-lg flex items-center gap-3 border border-red-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="text-steel-700">{flag}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="investment" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Investment Analysis</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Cost Breakdown</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          {investment.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-sm">
              <div class="flex justify-between items-start mb-2">
                <h4 class="font-semibold text-charcoal-900">{item.type}</h4>
                <span class="text-amber-600 font-bold">{item.range}</span>
              </div>
              <p class="text-steel-500 text-sm">{item.note}</p>
            </div>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">ROI Example (HN325)</h3>
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-xl border border-green-100">
          <div class="space-y-3">
            {roiExample.map((item, index) => (
              <div key={index} class="flex justify-between items-center py-2 border-b border-green-200 last:border-0">
                <span class="text-steel-700">{item.item}</span>
                <span class="font-semibold text-green-700">{item.value}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Choosing the right hydraulic oil press is crucial for your business success. By following this guide's checklist and working with a reputable manufacturer, you can make a confident investment that will pay off for years to come.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">GET YOUR FREE QUOTE TODAY</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Send us your production needs and get a personalized recommendation with detailed pricing.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Request a Quote<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/products" class="btn-outline border-white text-white hover:bg-white/10">View All Models</a>
        <a href="/resources" class="btn-outline border-white text-white hover:bg-white/10">Back to Resources</a>
      </div>
    </div>
  </section>
</BaseLayout>