---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-buying-guide');
const t = getTranslations('en');

const title = resource?.data.title.en || 'Hydraulic Oil Press Buying Guide';
const description = resource?.data.description.en || 'Invest in the right press with confidence';
const seoKeywords = resource?.data.seoKeywords || ['oil press buying guide', 'how to choose oil press', 'oil press purchase checklist'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/buying-guide-hero.webp',
  author: { '@type': 'Person', name: 'Eason', jobTitle: 'Senior Hydraulic Press Engineer', url: 'https://www.hydoilpress.com/about', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.', url: 'https://www.hydoilpress.com' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/hydraulic-oil-press-buying-guide' },
  ],
};

const buyingChecklist = [
  { category: 'Production Needs', items: [
    'Daily production target (kg/day)',
    'Types of materials to process',
    'Required oil quality (virgin, cooking, etc.)',
    'Cold pressing capability needed?',
  ]},
  { category: 'Technical Specifications', items: [
    'Hydraulic pressure (40-60 MPa recommended)',
    'Motor power (2.2 kW standard)',
    'Voltage (220V or 380V)',
    'Machine dimensions and weight',
  ]},
  { category: 'Quality & Warranty', items: [
    'Manufacturer reputation and experience',
    'Warranty period (1 year minimum)',
    'After-sales service availability',
    'Spare parts availability',
  ]},
  { category: 'Operational Considerations', items: [
    'Daily production capacity target',
    'Installation and training costs',
    'Spare parts and maintenance',
    'Operating costs (power, labor)',
  ]},
];

const questionsToAsk = [
  'What is your daily production target?',
  'Which seeds/nuts will you process?',
  'Do you need cold pressing capability?',
  'What is your target production capacity?',
  'Do you have a power source?',
  'What is your available workspace?',
  'Do you need training and installation support?',
  'What is your target oil market (virgin, cooking, cosmetic)?',
];

const redFlags = [
  'Unrealistically low price',
  'No warranty offered',
  'No after-sales service',
  'Unknown manufacturer location',
  'No technical documentation',
  'Pressure below 40 MPa',
  'Used/refurbished equipment',
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">BUYING GUIDE</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Eason</div>
            <div class="text-sm text-steel-500">Senior Hydraulic Press Engineer · 15+ Years Experience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">What to Know Before Buying a Hydraulic Oil Press</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Investing in a hydraulic oil press is a significant decision that can transform your oil production business. This comprehensive guide covers everything you need to know to make the right purchase.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>A good oil press can pay for itself in 1-3 months. A bad purchase can result in years of frustration and lost revenue. This guide will help you avoid costly mistakes.</p>
        </div>
      </section>

      <section id="checklist" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Your Hydraulic Oil Press Pre-Purchase Checklist</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {buyingChecklist.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-md overflow-hidden">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <h3 class="font-semibold text-white flex items-center gap-2">
                  <span class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.category}
                </h3>
              </div>
              <div class="p-5">
                <ul class="space-y-2">
                  {item.items.map((item2, idx) => (
                    <li key={idx} class="flex items-start gap-3">
                      <div class="w-5 h-5 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                      </div>
                      <span class="text-steel-700 text-sm">{item2}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="models" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Choosing the Right Hydraulic Oil Press Model</h2>
        <p class="text-steel-600 mb-6">
          The right model depends on your <strong>main seed type</strong> (softer seeds need less pressure;
          hard nuts and in-shell coconut need higher force), your <strong>target daily output</strong>,
          and whether you plan to do mostly <strong>cold or hot pressing</strong>.
        </p>
        <p class="text-steel-600 mb-6">
          This guide covers the questions you should ask <em>any</em> supplier. For a side-by-side
          comparison of the full Haonuo model range (HN300 through HN500) with real specs and
          seed-based recommendations, see the dedicated
          <a href="/products/model-comparison/" class="text-amber-600 hover:underline font-semibold">Model Comparison</a>
          page. For an overview of the whole hydraulic range at a glance, visit the
          <a href="/hydraulic-oil-press-machine/" class="text-amber-600 hover:underline font-semibold">Hydraulic Oil Press Buyer Guide</a>.
        </p>
      </section>

      <section id="questions" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Questions to Ask Your Oil Press Supplier</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {questionsToAsk.map((question, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-xl border border-blue-100 flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{index + 1}</div>
              <p class="text-steel-700">{question}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="red-flags" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Red Flags When Buying an Oil Press</h2>
        <div class="bg-red-50 rounded-xl border border-red-200 p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {redFlags.map((flag, index) => (
              <div key={index} class="bg-white p-3 rounded-lg flex items-center gap-3 border border-red-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="text-steel-700">{flag}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="total-cost-ownership" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Total Cost of Ownership</h2>
        <p class="text-steel-700 leading-relaxed mb-4">The quoted machine price is typically only 60–75% of the landed, running cost in year one. Freight, port charges and duties, electrical installation, foundation work, commissioning, operator training, and an initial spare-parts package all land on top of the invoice, and a cheap machine that lacks local support often becomes the most expensive quote on the table. Learning how to choose an oil press machine therefore starts with the total bill, not the first number quoted.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Ask every shortlisted supplier to quote the same scope</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>Machine price with the exact barrel configuration — single or double barrel changes both price and throughput.</li>
            <li>Standard spare parts supplied with the machine and the price of a recommended annual kit.</li>
            <li>Electrical panel scope: what is pre-wired on the machine and what the customer must install.</li>
            <li>Installation support: remote guidance or an on-site technician, and who pays travel and days.</li>
            <li>Warranty terms: duration, what is covered, and how claims are handled across borders.</li>
            <li>Delivery in weeks against a defined deposit date, not "in stock" claims.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">Compare the resulting totals, not the first line. A 10% lower machine price disappears in one week of delayed commissioning or a single air-freighted seal kit.</p>
      </section>

      <section id="verifying-manufacturer" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Verifying the Manufacturer Before Paying</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Factory photographs in a brochure are free; evidence is not. Before paying a deposit, verify the builder with the same seriousness you apply to the machine specification.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Request a live video walk-through of the workshop showing the model you are buying under assembly, not a showroom.</li>
          <li>Ask for two or three reference customers in similar markets and contact them about installation support, not just machine quality.</li>
          <li>Check that the pressure rating, steel thickness, and motor brand in the quotation match what was discussed verbally — HN-class machines run from 325 t / 60 MPa upward on 2.2–3 kW drives, and vague spec sheets are a warning sign.</li>
          <li>Confirm serial-numbered nameplates, a stamped pressure certificate for the barrel and cylinder, and electrical documentation in a language your electrician can read.</li>
          <li>Pay through traceable trade instruments with a defined deposit–balance structure tied to inspection and shipment milestones; avoid full prepayment or off-platform payment pressure.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed mt-4">Pressure tactics belong on this list of warning signs too. A seller who insists on an immediate deposit, refuses to put agreed specifications and delivery dates in writing, or steers every technical question back to "trust us, we export everywhere" is selling confidence rather than equipment. Legitimate manufacturers are comfortable with questions, references, and milestones — because a well-built machine and a documented factory survive all three.</p>
      </section>

      <section id="installation-training" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Installation, Training, and the First Month</h2>
        <p class="text-steel-700 leading-relaxed mb-4">A good supplier treats delivery as the middle of the transaction, not the end. Agree before ordering what commissioning support is included: machine positioning and anchoring, hydraulic and electrical connection, the first pressing trials with your actual seed, pressure and timing setup, and operator training on loading, holding, unloading, cleaning, and the daily inspection routine.</p>
        <p class="text-steel-700 leading-relaxed mb-4">Plan the first month deliberately: run one seed and one recipe, keep batch records, and verify cake residual oil against the supplier's stated figure — 6–8% for a slotted cold-press barrel, around 5–7% for well-run hot pressing. Problems accepted silently in the first month become "normal" by month six. Sizing and model choice for the workload itself — HN325 for small-batch and entry production, HN365 for higher daily volumes, HN426 for dedicated cold pressing, HN500 for the heaviest duty — is mapped in our <a href="/products/" class="text-amber-600 hover:underline">product range</a>, and the facility and power prerequisites are detailed in the <a href="/resources/oil-press-electrical-requirements-guide/" class="text-amber-600 hover:underline">electrical requirements guide</a>.</p>
        <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Used machines and delivery timing</h3>
        <p class="text-steel-700 leading-relaxed mb-4">A used hydraulic press can be excellent value because the frame and pressure vessel outlast several generations of seals and controls — but only when history is verifiable. Inspect barrel and cylinder condition, ask for maintenance and oil-analysis records, pressure-test before purchase, and price a full seal, hose, and electrical refresh into the comparison against new. A used machine sold without records, by contrast, is an unknown pressure vessel with no manufacturer standing behind it, and the saving rarely survives the first rebuild.</p>
        <p class="text-steel-700 leading-relaxed">Finally, plan purchase timing around seed, not sentiment. Ordering at the start of harvest season means competing for factory slots and freight while the cheapest raw material waits in the yard; the best-run shops place orders so commissioning finishes before their buying season, and spend the quiet months training and running trial batches on cheaper seed.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Buy Your Hydraulic Oil Press With Confidence</h2>
        <p class="text-steel-700 leading-relaxed">Choosing the right hydraulic oil press is crucial for your business success. By following this guide's checklist and working with a reputable manufacturer, you can make a confident investment that will pay off for years to come.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">GET YOUR FREE QUOTE TODAY</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Send us your production needs and get a personalized recommendation with detailed pricing.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Get Factory Price<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/products/" class="btn-outline border-white text-white hover:bg-white/10">View All Models</a>
        <a href="/resources/" class="btn-outline border-white text-white hover:bg-white/10">Back to Resources</a>
      </div>
    </div>
  </section>
</BaseLayout>