---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-maintenance-guide');
const t = getTranslations('en');

const title = resource?.data.title.en || 'Hydraulic Oil Press Maintenance';
const description = resource?.data.description.en || 'Complete maintenance guide';
const seoKeywords = resource?.data.seoKeywords || ['hydraulic oil press maintenance', 'oil press servicing'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/maintenance-guide-hero.webp',
  author: {
    '@type': 'Person',
    name: 'Haonuo Engineering Team',
    jobTitle: 'Senior Oil Press Engineer',
    worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' },
  },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/resources/hydraulic-oil-press-maintenance-guide' },
  ],
};

const maintenanceSchedule = [
  { frequency: 'Daily', tasks: ['Clean the machine and surrounding area', 'Check oil levels in hydraulic system', 'Inspect pressing chamber for residue', 'Verify safety devices are functional'] },
  { frequency: 'Weekly', tasks: ['Clean hydraulic oil tank filter', 'Check hydraulic connections for leaks', 'Inspect electrical connections', 'Lubricate moving parts'] },
  { frequency: 'Monthly', tasks: ['Check hydraulic oil quality', 'Inspect seals and gaskets', 'Test pressure gauges', 'Calibrate temperature sensors'] },
  { frequency: 'Quarterly', tasks: ['Replace hydraulic oil (every 2,000 hours)', 'Inspect hydraulic cylinder', 'Check frame and structural components', 'Test emergency stop function'] },
];

const hydraulicSystem = [
  { title: 'Hydraulic Oil Management', items: ['Use ISO VG 46 hydraulic oil', 'Maintain proper temperature (30-50°C)', 'Replace oil every 2,000 operating hours', 'Capacity: <a href="/products/standard-hydraulic-oil-press">HN325</a>/<a href="/products/heavy-duty-hydraulic-oil-press">HN355</a>: 30-40 liters, <a href="/products/ultra-high-pressure-hydraulic-oil-press">HN500</a>: 50-60 liters'] },
  { title: 'Hydraulic Cylinder Care', items: ['Keep cylinder rod clean', 'Protect from dust and debris', 'Inspect seals for wear', 'Replace if leaking'] },
  { title: 'Hydraulic Filter Maintenance', items: ['Clean every 50-100 operating hours', 'Replace if damaged or excessively dirty', 'Use genuine Haonuo replacement filters'] },
];

const electricalSystem = [
  { title: 'Power Supply Check', items: ['Verify input voltage', 'Check for voltage fluctuations', 'Use surge protectors'] },
  { title: 'Motor Maintenance', items: ['Check motor housing for damage', 'Inspect fan and cooling system', 'Clean cooling fins regularly'] },
  { title: 'Control Panel Maintenance', items: ['Remove dust from panel', 'Check button functionality', 'Tighten terminal connections'] },
];

const troubleshooting = [
  { problem: 'Low Pressure', causes: ['Low hydraulic oil level', 'Contaminated oil', 'Worn pump', 'Leaking seals'], solutions: ['Add oil', 'Filter or replace oil', 'Inspect pump', 'Replace seals'] },
  { problem: 'Slow Pressing Cycle', causes: ['Low hydraulic oil temperature', 'Dirty filter', 'Worn pump', 'Low voltage'], solutions: ['Warm up system', 'Clean filter', 'Inspect pump', 'Check power supply'] },
  { problem: 'Oil Leaks', causes: ['Worn seals', 'Loose connections', 'Damaged hoses'], solutions: ['Replace seals', 'Tighten connections', 'Replace hoses'] },
  { problem: 'Machine Won\'t Start', causes: ['No power', 'Emergency stop engaged', 'Safety guard open'], solutions: ['Check power supply', 'Reset emergency stop', 'Close safety guards'] },
];

const spareParts = [
  { name: 'Hydraulic oil filter elements', stock: 'Critical' },
  { name: 'Seals and gaskets', stock: 'Critical' },
  { name: 'Hydraulic hoses', stock: 'Wear' },
  { name: 'Pressing plates', stock: 'Wear' },
  { name: 'O-rings', stock: 'Consumables' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-green-50 to-emerald-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-green-500/10 text-green-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">
          MAINTENANCE GUIDE
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">
          {title.toUpperCase()}
        </h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">
          {description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-green-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
              <div class="text-sm text-steel-500">Senior Oil Press Engineer · 15+ Years Experience</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Introduction -->
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed">
          Proper maintenance is essential for ensuring the long-term performance and reliability of your hydraulic oil press.
        </p>
      </section>

      <!-- Maintenance Schedule -->
      <section id="maintenance-schedule" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Maintenance Schedule</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {maintenanceSchedule.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${index === 0 ? 'bg-red-100 text-red-600' : index === 1 ? 'bg-orange-100 text-orange-600' : index === 2 ? 'bg-blue-100 text-blue-600' : 'bg-green-100 text-green-600'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
                </div>
                <h3 class="font-semibold text-lg text-charcoal-900">{item.frequency}</h3>
              </div>
              <ul class="space-y-2">
                {item.tasks.map((task, idx) => (
                  <li key={idx} class="flex items-center gap-2 text-steel-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {task}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Hydraulic System Maintenance -->
      <section id="hydraulic-system" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Hydraulic System Maintenance</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {hydraulicSystem.map((item, index) => (
            <div key={index} class="bg-blue-50 p-5 rounded-xl border border-blue-200">
              <h3 class="font-semibold text-blue-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm" set:html={task}></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Electrical System Maintenance -->
      <section id="electrical-system" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Electrical System Maintenance</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {electricalSystem.map((item, index) => (
            <div key={index} class="bg-purple-50 p-5 rounded-xl border border-purple-200">
              <h3 class="font-semibold text-purple-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm">{task}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Safety Maintenance -->
      <section id="safety-maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Safety Maintenance</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="bg-red-50 p-5 rounded-xl border border-red-200">
            <h3 class="font-semibold text-red-800 mb-4">Emergency Systems</h3>
            <ul class="space-y-2">
              <li class="text-steel-700">• Test emergency stop monthly</li>
              <li class="text-steel-700">• Ensure quick response</li>
              <li class="text-steel-700">• Replace if faulty</li>
            </ul>
          </div>
          <div class="bg-orange-50 p-5 rounded-xl border border-orange-200">
            <h3 class="font-semibold text-orange-800 mb-4">Lockout/Tagout Procedures</h3>
            <ol class="space-y-1 list-decimal list-inside text-steel-700 text-sm">
              <li>Turn off power</li>
              <li>Lock power switch</li>
              <li>Place "Do Not Operate" tag</li>
              <li>Verify power is off</li>
              <li>Perform maintenance</li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Troubleshooting Guide -->
      <section id="troubleshooting" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Troubleshooting Guide</h2>
        <div class="space-y-6">
          {troubleshooting.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <h3 class="font-semibold text-lg text-red-600 mb-3">{item.problem}</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <h4 class="font-medium text-steel-500 mb-2">Causes:</h4>
                  <ul class="space-y-1">
                    {item.causes.map((cause, idx) => (
                      <li key={idx} class="text-steel-700 text-sm">{cause}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="font-medium text-steel-500 mb-2">Solutions:</h4>
                  <ul class="space-y-1">
                    {item.solutions.map((solution, idx) => (
                      <li key={idx} class="text-green-600 text-sm">{solution}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Spare Parts Inventory -->
      <section id="spare-parts" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Spare Parts Inventory</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Essential Spare Parts</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {spareParts.map((item, index) => (
            <div key={index} class="bg-white p-4 rounded-xl border border-steel-100 shadow-sm flex justify-between items-center">
              <span class="text-charcoal-900 font-medium">{item.name}</span>
              <span class={`px-2 py-1 rounded text-xs font-bold ${item.stock === 'Critical' ? 'bg-red-100 text-red-700' : item.stock === 'Wear' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'}`}>{item.stock}</span>
            </div>
          ))}
        </div>
        <div class="mt-6 bg-steel-50 p-4 rounded-xl">
          <h4 class="font-semibold text-charcoal-900 mb-2">Recommended Stock Levels</h4>
          <ul class="text-steel-700 text-sm space-y-1">
            <li>• Critical parts: 1-2 in stock</li>
            <li>• Wear parts: 2-3 in stock</li>
            <li>• Consumables: 3-6 months supply</li>
          </ul>
        </div>
      </section>

      <!-- Conclusion -->
      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">
          Regular maintenance is the key to maximizing the lifespan and performance of your hydraulic oil press. For personalized maintenance advice or to order spare parts, contact Haonuo's technical support team.
        </p>
      </section>
    </div>
  </main>

  <!-- CTA Section -->
  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">READY TO START YOUR OIL PRODUCTION?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Our engineering team can help you select the best equipment and optimize your investment for maximum returns.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          {t.resources.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/products" class="btn-outline border-white text-white hover:bg-white/10">
          {t.nav.products}
        </a>
        <a href="/resources" class="btn-outline border-white text-white hover:bg-white/10">
          {t.resources.backToResources}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
