﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const solutions = await getCollection('solutions');
  return solutions.map(solution => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props;
const { Content } = await solution.render();
const t = getTranslations('en');

const seedIcons: Record<string, string> = {
  coconut: '🥥',
  sesame: '🫘',
  peanut: '🥜',
  mustard: '🌾',
  sunflower: '🌻',
  shea: '🧈',
  palm: '🌴',
  avocado: '🥑',
  almond: '🌰',
  castor: '🌱',
  olive: '🫒',
  cottonseed: '🎯',
  soybean: '🫘',
  walnut: '🌰',
  flaxseed: '🌾',
  'small-business': '🏪',
  commercial: '🏭',
  industrial: '⚙️',
};

const allProducts = await getCollection('products');
const recommendedProducts = solution.data.recommendedProducts
  .map(slug => allProducts.find(p => p.slug === slug))
  .filter(Boolean);

const allSolutions = await getCollection('solutions');
const otherSolutions = allSolutions
  .filter(s => s.slug !== solution.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.hydoilpress.com/solutions' },
    { '@type': 'ListItem', position: 3, name: solution.data.title.en, item: `https://www.hydoilpress.com/solutions/${solution.slug}` },
  ],
};

const faqLd = solution.data.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: solution.data.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const allLd = [breadcrumbLd];
if (faqLd) allLd.push(faqLd);
---

<BaseLayout title={solution.data.title.en} description={solution.data.description.en} keywords={solution.data.seoKeywords} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/solutions" class="hover:text-amber-500 transition-colors">{t.solutions.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{solution.data.title.en}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{solution.data.title.en}</h1>
      <p class="text-steel-300 text-lg max-w-3xl">{solution.data.description.en}</p>
    </div>
  </section>

  <!-- Body Content (Overview, Oil Yield, Why Choose Haonuo, etc.) -->
  {solution.body && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-solution">
        <Content />
      </div>
    </section>
  )}

  <!-- Process Flow -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{t.solutions.processFlow}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {solution.data.processSteps.map((step, i) => (
          <div class="reveal relative bg-steel-50 rounded-2xl p-6" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-charcoal-900 font-display text-xl mb-4">
              {i + 1}
            </div>
            <h3 class="font-display text-xl text-charcoal-900 mb-2">{step.step}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{step.description}</p>
            {i < solution.data.processSteps.length - 1 && (
              <div class="hidden lg:block absolute -right-3 top-1/2 -translate-y-1/2 z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recommended Equipment -->
  {recommendedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{t.solutions.recommendedEquipment}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {recommendedProducts.map(product => product && (
            <a
              href={`/products/${product.slug}`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {solution.data.faq.length > 0 && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-center mb-8">{t.solutions.faq}</h2>
        <div class="space-y-4">
          {solution.data.faq.map((item, i) => (
            <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
              <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
                <span class="font-display text-lg text-charcoal-900">{item.question}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other Solutions -->
  {otherSolutions.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">Other Solutions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {otherSolutions.map(s => (
            <a
              href={`/solutions/${s.slug}`}
              class="card-hover bg-white rounded-2xl p-6 border border-steel-100 group hover:border-amber-300"
            >
              <div class="text-4xl mb-4">{seedIcons[s.data.seedName] || '🛢️'}</div>
              <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">
                {s.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 line-clamp-2">{s.data.description.en}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your {solution.data.seedName.charAt(0).toUpperCase() + solution.data.seedName.slice(1)} Oil Business?</h2>
      <p class="text-steel-300 text-lg mb-8">Contact us for a complete solution with professional equipment recommendations.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get a Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
