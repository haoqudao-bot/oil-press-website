﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('en');

const allSolutions = await getCollection('solutions');

const marketOrder: Record<string, number> = {
  soybean: 1, palm: 2, sunflower: 3, peanut: 4, cottonseed: 5,
  mustard: 6, sesame: 7, olive: 8, coconut: 9, shea: 10,
  castor: 11, almond: 12, avocado: 13, flaxseed: 14, walnut: 15,
};

const seedSolutions = allSolutions
  .filter(s => !['small-business', 'commercial', 'industrial'].includes(s.data.seedName))
  .sort((a, b) => (marketOrder[a.data.seedName] || 99) - (marketOrder[b.data.seedName] || 99));

const seedIcons: Record<string, string> = {
  coconut: '🥥', sesame: '🫘', peanut: '🥜', mustard: '🌾',
  sunflower: '🌻', shea: '🧈', palm: '🌴', avocado: '🥑',
  almond: '🌰', castor: '🌱', olive: '🫒', cottonseed: '🎯',
  soybean: '🫘', walnut: '🌰', flaxseed: '🌾',
};

const seedDetails: Record<string, {
  description: string;
  oilContent: string;
  bestFor: string;
  typicalYield: string;
}> = {
  soybean: {
    description: 'The world\'s most produced vegetable oil. Our hydraulic presses handle 18-22% oil content soybeans with maximum yield and minimal residual oil in cake.',
    oilContent: '18-22%',
    bestFor: 'Industrial & Commercial Scale',
    typicalYield: '16-19%',
  },
  palm: {
    description: 'Tropical palm kernel oil extraction. High-efficiency pressing solutions for palm kernel and fruit with specialized equipment for small hard seeds.',
    oilContent: '45-55%',
    bestFor: 'Commercial & Industrial',
    typicalYield: '40-48%',
  },
  sunflower: {
    description: 'Premium cold-pressed sunflower oil production. Preserve natural Vitamin E and nutrients with our low-temperature hydraulic press technology.',
    oilContent: '40-45%',
    bestFor: 'All Scales',
    typicalYield: '36-40%',
  },
  peanut: {
    description: 'High-yield groundnut oil pressing. Robust machines built for continuous operation in African and Asian markets with high-temperature roasting capability.',
    oilContent: '45-50%',
    bestFor: 'Commercial & Industrial',
    typicalYield: '40-45%',
  },
  cottonseed: {
    description: 'Industrial cottonseed oil extraction. High-capacity solutions with integrated filtration and refining equipment for large-scale operations.',
    oilContent: '18-22%',
    bestFor: 'Industrial Scale',
    typicalYield: '15-19%',
  },
  mustard: {
    description: 'Traditional mustard oil production. Heavy-duty presses designed for small hard seeds with high pungency preservation for the Indian market.',
    oilContent: '35-40%',
    bestFor: 'All Scales',
    typicalYield: '30-35%',
  },
  sesame: {
    description: 'Premium sesame oil extraction. Temperature-controlled cold pressing preserves the delicate flavor and natural aroma of white and black sesame.',
    oilContent: '50-55%',
    bestFor: 'All Scales',
    typicalYield: '45-50%',
  },
  olive: {
    description: 'Extra virgin olive oil production. Gentle cold pressing technology that preserves polyphenols and authentic flavor for Mediterranean markets.',
    oilContent: '15-25%',
    bestFor: 'Small Business & Commercial',
    typicalYield: '12-20%',
  },
  coconut: {
    description: 'Virgin coconut oil (VCO) production. Our hydraulic presses deliver pure, cold-pressed coconut oil with exceptional quality and aroma.',
    oilContent: '60-65%',
    bestFor: 'Small Business & Commercial',
    typicalYield: '55-60%',
  },
  shea: {
    description: 'Shea butter and shea oil production. Specialized hydraulic presses for high-value West African shea products with controlled temperature pressing.',
    oilContent: '30-40%',
    bestFor: 'Small Business & Commercial',
    typicalYield: '25-35%',
  },
  castor: {
    description: 'Industrial castor oil pressing. Heavy-duty machines for high-viscosity oil extraction used in lubricants, polymers, and pharmaceutical applications.',
    oilContent: '45-50%',
    bestFor: 'Commercial & Industrial',
    typicalYield: '40-45%',
  },
  almond: {
    description: 'Premium almond oil production. Cold-pressed to preserve natural Vitamin E and delicate nutty flavor for cosmetic and culinary applications.',
    oilContent: '45-55%',
    bestFor: 'Small Business & Commercial',
    typicalYield: '40-50%',
  },
  avocado: {
    description: 'Rich avocado oil extraction. Cold-pressed to maintain high monounsaturated fat content and natural chlorophyll for premium culinary and cosmetic markets.',
    oilContent: '15-25%',
    bestFor: 'Small Business',
    typicalYield: '12-20%',
  },
  flaxseed: {
    description: 'Omega-3 rich flaxseed oil production. Gentle cold pressing preserves the delicate essential fatty acids for nutritional supplement applications.',
    oilContent: '35-45%',
    bestFor: 'Small Business',
    typicalYield: '30-40%',
  },
  walnut: {
    description: 'Luxury walnut oil extraction. Low-temperature pressing preserves omega-3 fatty acids and natural flavor for gourmet culinary markets.',
    oilContent: '50-60%',
    bestFor: 'Small Business',
    typicalYield: '45-55%',
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.hydoilpress.com/solutions' },
    { '@type': 'ListItem', position: 3, name: 'All Oil Types', item: 'https://www.hydoilpress.com/solutions/all-oil-types' },
  ],
};
---

<BaseLayout title="All Oil Types - Hydraulic Oil Press Solutions by Seed Type" description="Complete hydraulic oil pressing solutions for 15+ oil seeds including soybean, coconut, sesame, sunflower, peanut, olive, and more. Find the best oil press machine for your raw material with detailed specifications." keywords={['oil press machine by oil type', 'hydraulic oil press solutions', 'oil press for coconut sesame sunflower', 'cold press oil machine', 'oil extraction equipment']} jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/solutions" class="hover:text-amber-500 transition-colors">Solutions</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">All Oil Types</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-5xl text-white mb-4">All Oil Types</h1>
      <p class="text-steel-300 text-lg max-w-2xl">
        Our hydraulic oil presses handle a wide range of oil seeds. Choose your raw material to find the best pressing solution, recommended equipment, and expected yield for maximum productivity.
      </p>
    </div>
  </section>

  <!-- Oil Type Grid -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {seedSolutions.map((solution) => {
          const details = seedDetails[solution.data.seedName];
          return (
            <a
              href={`/solutions/${solution.slug}`}
              class="group bg-white rounded-2xl p-6 border border-steel-100 hover:border-amber-300 hover:bg-amber-50/50 transition-all"
            >
              <div class="flex items-start gap-4 mb-4">
                <span class="text-4xl flex-shrink-0">{seedIcons[solution.data.seedName] || '🛢️'}</span>
                <div class="min-w-0">
                  <h3 class="font-display text-lg text-charcoal-900 mb-1.5 group-hover:text-amber-600 transition-colors">
                    {solution.data.title.en}
                  </h3>
                  <div class="flex flex-wrap gap-2">
                    <span class="text-xs bg-steel-100 text-steel-600 px-2 py-0.5 rounded-full">Oil: {details?.oilContent}</span>
                    <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Yield: {details?.typicalYield}</span>
                  </div>
                </div>
              </div>
              <p class="text-sm text-steel-600 leading-relaxed line-clamp-2 mb-4">
                {details?.description}
              </p>
              <div class="flex items-center justify-between pt-4 border-t border-steel-100">
                <span class="text-xs text-steel-500">Best for: {details?.bestFor}</span>
                <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
                  View Solution
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Oil Pressing Guide Section -->
  <section class="py-16 md:py-20 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 mb-4">How to Choose the Right Oil Press</h2>
          <p class="text-steel-600 mb-6">
            Selecting the right hydraulic oil press depends on several factors including your raw material, production capacity, and desired oil quality. Our guide helps you make the best decision.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-amber-500 font-bold">1.</span>
              <div>
                <h4 class="font-medium text-charcoal-900">Determine Your Raw Material</h4>
                <p class="text-sm text-steel-600">Different oil seeds require different pressing pressures and temperatures.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-amber-500 font-bold">2.</span>
              <div>
                <h4 class="font-medium text-charcoal-900">Calculate Daily Capacity</h4>
                <p class="text-sm text-steel-600">From 50kg/hour to 5 tons/hour, we have machines for all scales.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-amber-500 font-bold">3.</span>
              <div>
                <h4 class="font-medium text-charcoal-900">Choose Cold or Hot Press</h4>
                <p class="text-sm text-steel-600">Cold press preserves nutrients; hot press gives higher yield.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-amber-500 font-bold">4.</span>
              <div>
                <h4 class="font-medium text-charcoal-900">Consider Your Budget</h4>
                <p class="text-sm text-steel-600">We offer machines from basic to fully automated production lines.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-display text-xl text-charcoal-900 mb-4">Quick Reference Chart</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-steel-100">
                  <th class="text-left py-2 px-3 text-steel-500 font-medium">Oil Seed</th>
                  <th class="text-right py-2 px-3 text-steel-500 font-medium">Oil Content</th>
                  <th class="text-right py-2 px-3 text-steel-500 font-medium">Typical Yield</th>
                </tr>
              </thead>
              <tbody>
                {seedSolutions.slice(0, 8).map((solution) => {
                  const details = seedDetails[solution.data.seedName];
                  return (
                    <tr key={solution.slug} class="border-b border-steel-50 hover:bg-amber-50/30">
                      <td class="py-2 px-3 font-medium text-charcoal-900">{solution.data.title.en}</td>
                      <td class="py-2 px-3 text-right text-steel-600">{details?.oilContent}</td>
                      <td class="py-2 px-3 text-right text-amber-600 font-medium">{details?.typicalYield}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <a href="/resources/which-seeds-can-be-pressed" class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-4 hover:text-amber-600">
            View Full Compatibility Guide
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl text-white mb-4">
        Not Sure Which Oil Type?
      </h2>
      <p class="text-steel-300 text-lg mb-8 max-w-2xl mx-auto">
        Tell us your raw material, daily capacity, and budget — our engineers will recommend the best oil press setup for your business.
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get Free Consultation
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>