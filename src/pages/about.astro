﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../i18n';

const { locale = 'en' } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

function localePath(path: string): string {
  if (currentLocale === 'en') return path;
  return `/${currentLocale}${path}`;
}

const stats = [
  { value: '15+', label: t.home.statsYears },
  { value: '50+', label: t.home.statsCountries },
  { value: '200+', label: t.home.statsEmployees },
  { value: '3,000', label: t.home.statsArea },
];

const milestones = [
    { year: '2010', event: t.about.milestone2010 },
    { year: '2013', event: t.about.milestone2013 },
    { year: '2016', event: t.about.milestone2016 },
    { year: '2020', event: t.about.milestone2020 },
    { year: '2025', event: t.about.milestone2025 },
  ];

  const certificates = [];

  const capabilities = [
    { icon: 'cnc', title: t.about.capCncTitle, desc: t.about.capCncDesc },
    { icon: 'assembly', title: t.about.capAssemblyTitle, desc: t.about.capAssemblyDesc },
    { icon: 'qc', title: t.about.capQcTitle, desc: t.about.capQcDesc },
    { icon: 'rd', title: t.about.capRdTitle, desc: t.about.capRdDesc },
    { icon: 'paint', title: t.about.capPaintTitle, desc: t.about.capPaintDesc },
    { icon: 'warehouse', title: t.about.capWarehouseTitle, desc: t.about.capWarehouseDesc },
  ];

  const whyChooseUs = [
    { title: t.about.why1Title, desc: t.about.why1Desc },
    { title: t.about.why2Title, desc: t.about.why2Desc },
    { title: t.about.why3Title, desc: t.about.why3Desc },
    { title: t.about.why4Title, desc: t.about.why4Desc },
    { title: t.about.why5Title, desc: t.about.why5Desc },
    { title: t.about.why6Title, desc: t.about.why6Desc },
  ];

  const keyMarkets = [
    { region: t.about.regionSouthAsia, countries: ['India', 'Pakistan', 'Sri Lanka'] },
    { region: t.about.regionAfrica, countries: ['Nigeria', 'Kenya', 'Ghana', 'Tanzania', 'Uganda'] },
    { region: t.about.regionSeAsia, countries: ['Philippines', 'Indonesia', 'Vietnam', 'Thailand', 'Myanmar'] },
    { region: t.about.regionMiddleEast, countries: ['Saudi Arabia', 'UAE', 'Egypt', 'Turkey', 'Iraq'] },
  ];
  const breadcrumbLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.about.breadcrumbHome, item: 'https://www.hydoilpress.com/' },
      { '@type': 'ListItem', position: 2, name: t.about.breadcrumbAbout, item: 'https://www.hydoilpress.com/about' },
    ],
  };
---

<BaseLayout title={t.about.title} description="Shandong Haonuo Machinery Equipment Group Co., Ltd. — professional hydraulic oil press machine manufacturer since 2010. Factory with 200+ employees, exporting to 50+ countries." jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.about.breadcrumbHome}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.about.breadcrumbAbout}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.about.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.about.subtitle}</p>
    </div>
  </section>

  <!-- Company Overview -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <img
            src="/images/hero/hydraulic-oil-press-production.webp"
            alt={t.about.overviewImgAlt}
            class="w-full rounded-2xl shadow-lg"
          />
        </div>
        <div class="reveal">
          <h2 class="section-title">{t.about.overviewTitle}</h2>
          <p class="text-steel-600 leading-relaxed mb-4">
            {t.about.overviewP1}
          </p>
          <p class="text-steel-600 leading-relaxed mb-4">
            {t.about.overviewP2}
          </p>
          <p class="text-steel-600 leading-relaxed mb-8">
            {t.about.overviewP3}
          </p>

          <!-- Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            {stats.map(stat => (
              <div class="text-center">
                <div class="font-display text-3xl md:text-4xl text-amber-500">{stat.value}</div>
                <div class="text-xs text-steel-500 mt-1">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 md:py-24 bg-amber-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="section-title">{t.about.storyTitle}</h2>
      <p class="text-lg text-steel-700 leading-relaxed mb-6">
        {t.about.storyP1}
      </p>
      <p class="text-lg text-steel-700 leading-relaxed mb-6">
        {t.about.storyP2}
      </p>
      <p class="text-lg text-steel-700 leading-relaxed">
        {t.about.storyP3}
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <h2 class="section-title">{t.about.mission}</h2>
      <p class="text-lg text-steel-700 leading-relaxed">
        {t.about.missionDesc}
      </p>
    </div>
  </section>

  <!-- History Timeline -->
  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12 reveal">{t.about.history}</h2>
      <div class="relative">
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-steel-200 md:-translate-x-0.5"></div>

        {milestones.map((item, i) => (
          <div class:list={[
            'relative flex items-start mb-8 last:mb-0 reveal',
            i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'
          ]}>
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-amber-500 rounded-full -translate-x-1.5 md:-translate-x-1.5 mt-2 z-10"></div>
            <div class:list={[
              'ml-12 md:ml-0 md:w-1/2',
              i % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12'
            ]}>
              <div class="font-display text-2xl text-amber-500 mb-1">{item.year}</div>
              <p class="text-steel-700 text-sm leading-relaxed">{item.event}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Manufacturing Capabilities -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.about.manufacturingTitle}</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">{t.about.manufacturingDesc}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {capabilities.map((cap, i) => (
          <div class="reveal p-6 bg-steel-50 rounded-2xl hover:bg-amber-50 transition-colors" style={`animation-delay: ${i * 80}ms`}>
            <div class="w-12 h-12 bg-amber-500 rounded-xl flex items-center justify-center mb-4">
              {cap.icon === 'cnc' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>
              )}
              {cap.icon === 'assembly' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              )}
              {cap.icon === 'qc' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              )}
              {cap.icon === 'rd' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m-7.07-3.93l4.24-4.24m5.66-5.66l4.24-4.24M1 12h6m6 0h6m-3.93 7.07l-4.24-4.24m-5.66-5.66L4.93 4.93"/></svg>
              )}
              {cap.icon === 'paint' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
              )}
              {cap.icon === 'warehouse' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              )}
            </div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{cap.title}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Assurance -->
  <section class="py-16 md:py-24 bg-steel-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal text-white">{t.about.qualityTitle}</h2>
      <p class="text-center text-steel-300 max-w-2xl mx-auto mb-12 reveal">{t.about.qualityDesc}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="reveal text-center p-8 bg-white/5 rounded-2xl border border-white/10">
          <div class="w-14 h-14 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="font-display text-xl mb-3">{t.about.qualityIsoTitle}</h3>
          <p class="text-sm text-steel-300 leading-relaxed">{t.about.qualityIsoDesc}</p>
        </div>
        <div class="reveal text-center p-8 bg-white/5 rounded-2xl border border-white/10">
          <div class="w-14 h-14 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="font-display text-xl mb-3">{t.about.qualityMaterialTitle}</h3>
          <p class="text-sm text-steel-300 leading-relaxed">{t.about.qualityMaterialDesc}</p>
        </div>
        <div class="reveal text-center p-8 bg-white/5 rounded-2xl border border-white/10">
          <div class="w-14 h-14 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <h3 class="font-display text-xl mb-3">{t.about.qualityInspectionTitle}</h3>
          <p class="text-sm text-steel-300 leading-relaxed">{t.about.qualityInspectionDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Reach -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.about.globalTitle}</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">{t.about.globalDesc}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {keyMarkets.map((market, i) => (
          <div class="reveal p-6 bg-steel-50 rounded-2xl" style={`animation-delay: ${i * 80}ms`}>
            <h3 class="font-display text-lg text-amber-500 mb-3">{market.region}</h3>
            <ul class="space-y-1.5">
              {market.countries.map(country => (
                <li class="flex items-center gap-2 text-sm text-steel-700">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {country}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="text-center reveal">
        <p class="text-steel-500 text-sm">{t.about.globalMore}</p>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24 bg-amber-50" id="why-choose-us">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.about.whyChooseTitle}</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">{t.about.whyChooseDesc}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {whyChooseUs.map((reason, i) => (
          <div class="reveal bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow" style={`animation-delay: ${i * 80}ms`}>
            <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center mb-4 font-display text-lg text-charcoal-900">{i + 1}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{reason.title}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{reason.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Premium Materials Details -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="section-title">{t.about.premiumMaterialsTitle}</h2>
        <p class="section-subtitle mx-auto">{t.about.premiumMaterialsDesc}</p>
      </div>
      <div class="bg-steel-900 rounded-2xl p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-steel-800/50 border border-amber-500/30 rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <span class="w-12 h-12 bg-amber-500/20 rounded-xl flex items-center justify-center text-amber-500 font-bold text-lg">A</span>
              <div>
                <h4 class="font-display text-xl text-white">{t.about.matA_title}</h4>
                <div class="text-xs text-amber-500">{t.about.matA_sub}</div>
              </div>
            </div>
            <p class="text-sm text-steel-300 leading-relaxed mb-4">{t.about.matA_desc}</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matA_tag1}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matA_tag2}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matA_tag3}</span>
            </div>
          </div>
          <div class="bg-steel-800/50 border border-amber-500/30 rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <span class="w-12 h-12 bg-amber-500/20 rounded-xl flex items-center justify-center text-amber-500 font-bold text-lg">B</span>
              <div>
                <h4 class="font-display text-xl text-white">{t.about.matB_title}</h4>
                <div class="text-xs text-amber-500">{t.about.matB_sub}</div>
              </div>
            </div>
            <p class="text-sm text-steel-300 leading-relaxed mb-4">{t.about.matB_desc}</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matB_tag1}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matB_tag2}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matB_tag3}</span>
            </div>
          </div>
          <div class="bg-steel-800/50 border border-amber-500/30 rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <span class="w-12 h-12 bg-amber-500/20 rounded-xl flex items-center justify-center text-amber-500 font-bold text-lg">C</span>
              <div>
                <h4 class="font-display text-xl text-white">{t.about.matC_title}</h4>
                <div class="text-xs text-amber-500">{t.about.matC_sub}</div>
              </div>
            </div>
            <p class="text-sm text-steel-300 leading-relaxed mb-4">{t.about.matC_desc}</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matC_tag1}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matC_tag2}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matC_tag3}</span>
            </div>
          </div>
          <div class="bg-steel-800/50 border border-amber-500/30 rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <span class="w-12 h-12 bg-amber-500/20 rounded-xl flex items-center justify-center text-amber-500 font-bold text-lg">D</span>
              <div>
                <h4 class="font-display text-xl text-white">{t.about.matD_title}</h4>
                <div class="text-xs text-amber-500">{t.about.matD_sub}</div>
              </div>
            </div>
            <p class="text-sm text-steel-300 leading-relaxed mb-4">{t.about.matD_desc}</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matD_tag1}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matD_tag2}</span>
              <span class="text-xs bg-amber-500/20 text-amber-500 px-3 py-1.5 rounded-full">{t.about.matD_tag3}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- High Returns Details -->
  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="section-title">{t.about.highReturnsTitle}</h2>
        <p class="section-subtitle mx-auto">{t.about.highReturnsDesc}</p>
      </div>
      <div class="bg-charcoal-900 rounded-2xl p-6 md:p-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-charcoal-800/50 border border-amber-500/20 rounded-xl p-6 text-center">
            <div class="w-14 h-14 mx-auto mb-3 bg-amber-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h4 class="font-display text-lg text-white mb-2">{t.about.returns1_title}</h4>
