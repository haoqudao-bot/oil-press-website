---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('en');

const allSolutions = await getCollection('solutions');

const featuredSolutions = allSolutions.sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const scaleSolutions = allSolutions
  .filter(s => ['small-business', 'commercial', 'industrial'].includes(s.data.seedName))
  .sort((a, b) => a.data.order - b.data.order);

const seedIcons: Record<string, string> = {
  coconut: '🥥',
  sesame: '🫘',
  peanut: '🥜',
  mustard: '🌾',
  sunflower: '🌻',
  shea: '🧈',
  palm: '🌴',
  avocado: '🥑',
  almond: '🌰',
  castor: '🌱',
  olive: '🫒',
  cottonseed: '🎯',
  soybean: '🫘',
  walnut: '🌰',
  flaxseed: '🌾',
  'small-business': '🏪',
  commercial: '🏭',
  industrial: '⚙️',
};

/* Four core models — image and model verified one-to-one */
const models = [
  {
    badge: '325 Tons', img: '/images/models/hn325.webp',
    name: 'HN325 Hydraulic Oil Press',
    desc: 'Best-selling dual-barrel commercial press — 325 tons, 60 MPa system pressure.',
    href: '/products/standard-hydraulic-oil-press/',
  },
  {
    badge: '365 Tons', img: '/images/models/hn365.webp',
    name: 'HN365 Hydraulic Oil Press',
    desc: 'Upgraded from the HN355 — 3 cm high-strength steel frame, double-station barrels.',
    href: '/products/commercial-hydraulic-oil-press/',
  },
  {
    badge: '500 Tons', img: '/images/models/hn426.webp',
    name: 'HN426 Hydraulic Oil Press',
    desc: '500-ton ultra-high pressure for hard seeds — single or dual barrel.',
    href: '/products/cold-press-hydraulic-oil-press/',
  },
  {
    badge: '620 Tons', img: '/images/models/hn500.webp',
    name: 'HN500 Hydraulic Oil Press',
    desc: 'Flagship 620-ton press for large-scale processors and tonnage operations.',
    href: '/products/ultra-high-pressure-hydraulic-oil-press/',
  },
];

/* Four core product categories — one row */
const lineItems = [
  { title: 'Hydraulic Oil Press', img: '/images/models/hn500.webp', href: '/products/hydraulic-oil-press/' },
  { title: 'Seed Processing', img: '/images/line/pulverizer.webp', href: '/products/seed-processing-equipment/' },
  { title: 'Roasting & Steaming', img: '/images/line/roaster.webp', href: '/products/roasting-steaming-equipment/' },
  { title: 'Filtration & Refining', img: '/images/products/pneumatic-oil-filter-press-v2.webp', href: '/products/filtration-refining-equipment/' },
];

const marqueeSeeds = ['Sesame','Peanut','Coconut','Mustard','Sunflower','Shea Butter','Rapeseed','Walnut','Camellia','Avocado','Palm Kernel','Soybean'];

/* Same option lists as the contact page form */
const productOptions = [
  'HN300 Hydraulic Oil Press',
  'HN325 Hydraulic Oil Press',
  'HN325S Hydraulic Oil Press',
  'HN365 Hydraulic Oil Press',
  'HN400 Hydraulic Oil Press',
  'HN426 Hydraulic Oil Press',
  'HN480B Hydraulic Oil Press',
  'HN500 Hydraulic Oil Press',
  'Sesame Special Oil Press',
  'Coconut/VCO Special Oil Press',
  'Barrel Type Oil Press',
  'Custom / Other Product',
];

const countryOptions = [
  'India', 'Nigeria', 'Pakistan', 'Philippines', 'Kenya',
  'Saudi Arabia', 'UAE', 'Egypt', 'Ghana', 'Tanzania', 'Indonesia',
  'Vietnam', 'Thailand', 'Myanmar', 'Sri Lanka', 'Turkey', 'Iraq',
  'Uganda', 'Kazakhstan', 'Uzbekistan', 'Other',
];

const stats = [
  { value: '2010', label: 'Established' },
  { value: '200+', label: 'Skilled Workers & Engineers' },
  { value: '50+', label: 'Export Countries' },
  { value: '2,000+', label: 'Buyers Served Worldwide' },
];

const parts = [
  { no: '01', title: 'Hydraulic Cylinder', body: '27SiMn alloy steel (GB/T 3077), rated for 60–75 MPa system pressure and 300–620 tonnes of pressing force.' },
  { no: '02', title: 'Oil Pressure Plate', body: 'Transfers the cylinder’s force evenly over the whole seed cake, so pressure reaches every seed uniformly instead of concentrating in the centre.' },
  { no: '03', title: 'Material Bucket', body: 'Q690 high-strength steel, welded and nickel-plated inside and out. Strip-slotted walls release oil faster than a conventional drilled barrel, with no bare metal touching the seed.' },
  { no: '04', title: 'Oil Outlet', body: 'Pressed oil collects here after draining through the bucket walls and runs straight into the tray below; the outlet is nickel-plated for food-grade contact.' },
  { no: '05', title: 'Control Panel', body: 'Pressure gauges, adjustable cycle timer and safety interlocks grouped on one button-controlled panel.' },
  { no: '06', title: 'Directional Control Valve', body: 'Electroplated valve block with enlarged ports for fast, smooth cycle switching.' },
  { no: '07', title: 'Hydraulic Oil Tank', body: 'Built-in oil tank with filter and cooling keeps system oil clean and at a stable temperature.' },
];

const promises = [
  { title: 'Full-pressure test', body: 'Every press is run to working pressure and checked for leaks before packing.' },
  { title: 'Spare parts included', body: 'Wear parts ship with the order so day-one failures never stop the line.' },
  { title: 'English manual & support', body: 'Printed English manual with remote guidance from our own engineers by email and chat.' },
  { title: 'On-site installation', body: 'Engineer installation available overseas; buyer covers travel and accommodation.' },
];

const faqs = [
  {
    q: 'How do I pick the right press model for my seeds?',
    a: 'Start from your raw material and your daily output target. Small shops working sesame or peanut usually run the HN300 or HN325; hard, low-oil seeds such as walnut or camellia call for the HN365 or above, while the HN426 and HN500 fit high-volume plants. Send us your seed type and target capacity and we will size the machine honestly — not upward.',
  },
  {
    q: 'What is the difference between cold pressing and hot pressing?',
    a: 'Cold pressing skips roasting, keeps oil temperature low and preserves natural nutrients and a light flavor preferred by premium markets, though the yield is smaller and downstream refining is often needed. Hot pressing roasts the seed first, extracting more oil with a stronger aroma for mainstream cooking oil. Every Haonuo model runs both processes.',
  },
  {
    q: 'How long does production take after I order?',
    a: 'Standard configurations are normally completed within 15–25 working days after the deposit arrives; custom setups may take 30–40 days depending on workshop load. Your confirmed loading window is written into the proforma invoice.',
  },
  {
    q: 'Do you provide installation and operator training?',
    a: 'Most single-press buyers install the machine themselves using the printed English manual and our online support. For complete lines, a Haonuo engineer can travel to your site for installation and training; the buyer covers flights, visa, accommodation and a daily service fee.',
  },
];

// SEO: breadcrumb + model list
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/' },
  ],
};
const modelListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Haonuo Hydraulic Oil Press Models',
  itemListElement: models.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://www.hydoilpress.com${m.href}`,
    name: m.name,
  })),
};
---

<BaseLayout overlayHeader jsonLd={[breadcrumbLd, modelListLd]}>
  <!-- ============ HERO CAROUSEL ============ -->
  <section class="relative h-[88vh] min-h-[600px] overflow-hidden bg-steel-950" id="hero-carousel">
    <div class="hero-slides" id="hero-slides">
      <!-- Slide 1: workshop -->
      <div class="hero-slide active" data-index="0">
        <div class="absolute inset-0">
          <img
            src="/images/factory/workshop-cranes.webp"
            alt="Haonuo assembly workshop with overhead crane bays and hydraulic oil presses in production"
            width="5472"
            height="3648"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-steel-950/95 via-steel-900/55 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-steel-950/55 to-transparent"></div>
        </div>
        <div class="relative h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center">
          <div class="max-w-2xl pt-16 px-12 lg:px-0">
            <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white leading-tight mb-4 sm:mb-6">
              {t.home.heroTitle}
            </h1>
            <p class="text-base sm:text-lg md:text-xl text-steel-200 mb-8 leading-relaxed">
              {t.home.heroSlide1Tag}
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/contact/" class="btn-primary text-base">
                {t.home.heroSlide1Cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href="/products/" class="btn-outline border-white text-white hover:bg-white hover:text-steel-900 text-base">
                {t.home.heroSlide1Secondary}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2: cold press line -->
      <div class="hero-slide" data-index="1">
        <div class="absolute inset-0">
          <img
            src="/images/hero/cold-press-production-line.webp"
            alt="Cold press hydraulic oil press production line"
            width="1440"
            height="960"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-steel-950/90 via-steel-900/65 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/75 via-transparent to-steel-950/25"></div>
        </div>
        <div class="relative h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center">
          <div class="max-w-2xl pt-16 px-12 lg:px-0">
            <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white leading-tight mb-4 sm:mb-6">
              {t.home.heroSlide2Title}
            </h2>
            <p class="text-base sm:text-lg md:text-xl text-steel-200 mb-8 leading-relaxed">
              {t.home.heroSlide2Desc}
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/cold-press-oil-machine/" class="btn-primary text-base">
                {t.home.heroSlide2Cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href="/solutions/" class="btn-outline border-white text-white hover:bg-white hover:text-steel-900 text-base">
                {t.home.heroSlide2Secondary}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 3: factory video -->
      <div class="hero-slide" data-index="2">
        <div class="absolute inset-0">
          <video
            src="/videos/factory-tour-silent.mp4"
            poster="/images/hero/factory-workshop.webp"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Video tour of the Haonuo factory workshop"
            class="w-full h-full object-cover"
          ></video>
          <div class="absolute inset-0 bg-steel-950/35"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-steel-950/90 via-steel-900/65 to-steel-900/10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/75 via-transparent to-steel-950/25"></div>
        </div>
        <div class="relative h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center">
          <div class="max-w-2xl pt-16 px-12 lg:px-0">
            <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white leading-tight mb-4 sm:mb-6">
              {t.home.heroSlide3Title}
            </h2>
            <p class="text-base sm:text-lg md:text-xl text-steel-200 mb-8 leading-relaxed">
              {t.home.heroSlide3Desc}
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/about/" class="btn-primary text-base">
                {t.home.heroSlide3Cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href="/contact/" class="btn-outline border-white text-white hover:bg-white hover:text-steel-900 text-base">
                {t.home.heroSlide3Secondary}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dots -->
    <div class="absolute bottom-7 left-1/2 -translate-x-1/2 flex items-center gap-3 z-10">
      <button class="hero-dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-colors active" data-slide="0" aria-label="Slide 1: workshop"></button>
      <button class="hero-dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-colors" data-slide="1" aria-label="Slide 2: cold press technology"></button>
      <button class="hero-dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-colors" data-slide="2" aria-label="Slide 3: factory direct"></button>
    </div>

    <!-- Arrows -->
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors backdrop-blur-sm" aria-label="Previous slide">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors backdrop-blur-sm" aria-label="Next slide">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </section>

  <style>
    .hero-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1s ease-in-out; pointer-events: none; }
    .hero-slide.active { opacity: 1; pointer-events: auto; }
    .hero-dot.active { background-color: #E8A838; width: 2rem; border-radius: 9999px; }
    @media (prefers-reduced-motion: reduce) {
      .hero-slide { transition: none; }
    }

    /* Yellow oilseed marquee */
    .mq-track { display: flex; gap: 3.5rem; width: max-content; animation: mq 38s linear infinite; }
    .mq-wrap:hover .mq-track { animation-play-state: paused; }
    .mq-track span { font-family: 'Bebas Neue', sans-serif; font-size: 1.15rem; letter-spacing: .12em; color: #1A1A2E; display: inline-flex; align-items: center; gap: 3.5rem; white-space: nowrap; }
    .mq-track span::after { content: ""; width: 7px; height: 7px; border-radius: 9999px; background: #1B3A5C; }
    @keyframes mq { to { transform: translateX(-50%); } }
    @media (prefers-reduced-motion: reduce) { .mq-track { animation: none; } }
  </style>

  <script>
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const dots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');
    let current = 0;
    let interval: ReturnType<typeof setInterval>;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function goToSlide(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('active', k === current));
      dots.forEach((d, k) => d.classList.toggle('active', k === current));
    }
    function startAutoplay() {
      if (reduceMotion) return;
      clearInterval(interval);
      interval = setInterval(() => goToSlide(current + 1), 6000);
    }
    function stopAutoplay() { clearInterval(interval); }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        goToSlide(parseInt(dot.getAttribute('data-slide') || '0', 10));
        startAutoplay();
      });
    });
    document.getElementById('hero-prev')?.addEventListener('click', () => { goToSlide(current - 1); startAutoplay(); });
    document.getElementById('hero-next')?.addEventListener('click', () => { goToSlide(current + 1); startAutoplay(); });
    const heroEl = document.getElementById('hero-carousel');
    heroEl?.addEventListener('mouseenter', stopAutoplay);
    heroEl?.addEventListener('mouseleave', startAutoplay);
    startAutoplay();

    /* Homepage inquiry form */
    function submitHomeForm(event: Event) {
      event.preventDefault();
      const form = event.target as HTMLFormElement;
      const btn = document.getElementById('hp-btn') as HTMLButtonElement | null;
      const ok = document.getElementById('hp-success');
      const err = document.getElementById('hp-error');
      btn?.setAttribute('disabled', 'true');
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then(r => { if (!r.ok) throw new Error('fail'); form.classList.add('hidden'); ok?.classList.remove('hidden'); })
        .catch(() => { err?.classList.remove('hidden'); })
        .finally(() => btn?.removeAttribute('disabled'));
      return false;
    }
    (window as any).submitHomeForm = submitHomeForm;
    document.getElementById('hp-another')?.addEventListener('click', () => {
      document.getElementById('hp-success')?.classList.add('hidden');
      document.getElementById('hp-error')?.classList.add('hidden');
      const f = document.getElementById('hp-form') as HTMLFormElement | null;
      f?.reset();
      f?.classList.remove('hidden');
      (window as any).turnstile?.reset();
    });
  </script>

  <!-- ============ YELLOW OILSEED MARQUEE ============ -->
  <div class="mq-wrap bg-amber-500 border-b-4 border-steel-900 py-3 overflow-hidden" aria-label="Oilseeds we press">
    <div class="mq-track">
      {marqueeSeeds.concat(marqueeSeeds).map(seed => <span>{seed}</span>)}
    </div>
  </div>

  <!-- ============ STATS ============ -->
  <section class="bg-steel-950 py-14 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map(s => (
          <div class="reveal text-center">
            <div class="font-display text-4xl md:text-5xl text-white">{s.value}</div>
            <div class="text-xs md:text-sm tracking-widest uppercase text-steel-200 mt-2">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 01 THE RANGE (4 models) ============ -->
  <section class="py-16 md:py-24 bg-white" id="models">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-10 md:mb-14 reveal">
        <div>
          <p class="font-display text-amber-600 tracking-[0.25em] text-sm mb-2">01 — THE RANGE</p>
          <h2 class="font-display text-3xl md:text-5xl text-steel-900 leading-none">Most Popular Hydraulic Oil Presses</h2>
          <p class="text-steel-500 mt-3 max-w-2xl text-sm md:text-base">Proven models requested by buyers worldwide — 325 to 620 tons of pressing force.</p>
        </div>
        <a href="/products/" class="hidden md:inline-flex btn-outline text-sm whitespace-nowrap">{t.home.viewAllProducts}</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7">
        {models.map((m, i) => (
          <a
            href={m.href}
            class="reveal group bg-white rounded-2xl overflow-hidden border border-steel-100 hover:border-amber-300 hover:shadow-[0_20px_44px_-22px_rgba(16,42,67,0.35)] transition-all duration-300"
            style={`transition-delay:${i * 60}ms`}
          >
            <div class="relative aspect-square bg-steel-50 overflow-hidden">
              <span class="absolute top-4 left-4 z-10 bg-amber-500 text-charcoal-900 font-display tracking-wider text-sm px-3 py-1.5 rounded-full">{m.badge}</span>
              <img
                src={m.img}
                alt={`${m.name} hydraulic oil press`}
                width="900"
                height="900"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain p-5 md:p-7 group-hover:scale-[1.04] transition-transform duration-500"
              />
            </div>
            <div class="p-5 md:p-6">
              <h3 class="font-bold text-lg md:text-xl text-charcoal-900 leading-snug">{m.name}</h3>
              <p class="text-sm text-steel-500 mt-2 leading-relaxed min-h-[2.6rem]">{m.desc}</p>
              <span class="inline-flex items-center gap-1.5 text-amber-600 font-semibold text-sm mt-4">
                View Details
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center md:hidden">
        <a href="/products/" class="btn-outline text-sm">{t.home.viewAllProducts}</a>
      </div>
    </div>
  </section>

  <!-- ============ 02 COMPLETE LINES (carousel) ============ -->
  <section class="py-16 md:py-24 bg-steel-50" id="complete-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 md:mb-10 reveal">
        <div>
          <p class="font-display text-amber-600 tracking-[0.25em] text-sm mb-2">02 — COMPLETE LINES</p>
          <h2 class="font-display text-3xl md:text-5xl text-steel-900 leading-none">Our Product Range</h2>
          <p class="text-steel-500 mt-3 max-w-2xl text-sm md:text-base">Everything you need to extract oil, from a single press to a full production line. Our <a href="/cold-press-oil-machine/" class="text-amber-600 underline underline-offset-2 hover:text-amber-700">cold pressed oil machine</a> runs both cold and hot pressing on one machine.</p>
        </div>
      </div>

      <div class="reveal">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
          {lineItems.map(item => (
            <a
              href={item.href}
              class="line-card group relative aspect-[4/3] rounded-2xl overflow-hidden block"
            >
              <img
                src={item.img}
                alt={item.title}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-steel-950/85 via-steel-950/15 to-transparent"></div>
              <div class="absolute left-5 right-5 bottom-4">
                <h3 class="text-white font-bold text-lg md:text-xl leading-snug drop-shadow">{item.title}</h3>
                <span class="inline-flex items-center gap-1.5 text-amber-400 font-semibold text-sm mt-1.5">
                  Explore
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-steel-900 rounded-xl px-6 py-5 reveal">
        <p class="text-steel-100 text-sm md:text-base">Planning a line? Tell us your <strong class="text-amber-400">seed, target tons per day and voltage</strong> — we return a machine count, layout and FOB quote.</p>
        <a href="/contact/" class="btn-primary shrink-0">Plan my line</a>
      </div>
    </div>
  </section>

  <!-- ============ 03 BY OILSEED + BY SCALE (merged) ============ -->
  <section class="py-16 md:py-24 bg-white" id="solutions">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14 reveal">
        <p class="font-display text-amber-600 tracking-[0.25em] text-sm mb-2">03 — BY OILSEED &amp; SCALE</p>
        <h2 class="font-display text-3xl md:text-5xl text-steel-900 leading-none">Find Your Oilseed Setup</h2>
        <p class="text-steel-500 mt-3 text-sm md:text-base">Pick your seed, then match the machine count to your daily target.</p>
      </div>

      <!-- Seeds -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {featuredSolutions.map((solution, i) => (
          <a
            href={`/solutions/${solution.slug}/`}
            class="reveal group bg-steel-50 hover:bg-amber-50 border border-transparent hover:border-amber-200 rounded-xl p-5 text-center transition-colors"
            style={`transition-delay:${i * 40}ms`}
          >
            <div class="text-3xl mb-2">{seedIcons[solution.data.seedName] || '🛢️'}</div>
            <h3 class="font-bold text-sm text-charcoal-900 group-hover:text-amber-600 transition-colors leading-snug">{solution.data.title.en}</h3>
          </a>
        ))}
      </div>

      <!-- Scale -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-6">
        {scaleSolutions.map((solution, i) => (
          <a
            href={`/solutions/${solution.slug}/`}
            class="reveal group flex items-center gap-4 bg-white border border-steel-100 hover:border-amber-300 rounded-xl p-5 transition-colors"
            style={`transition-delay:${i * 60}ms`}
          >
            <div class="text-3xl shrink-0">{seedIcons[solution.data.seedName] || '🏭'}</div>
            <div class="min-w-0">
              <h3 class="font-bold text-base text-charcoal-900 group-hover:text-amber-600 transition-colors">{solution.data.title.en}</h3>
              <p class="text-sm text-steel-500 line-clamp-1 mt-0.5">{solution.data.description.en}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/solutions/" class="btn-outline text-sm">{t.home.viewAllSolutions}</a>
      </div>
    </div>
  </section>

  <!-- ============ 04 ANATOMY ============ -->
  <section class="py-16 md:py-24 bg-steel-950 text-white" id="anatomy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-5 reveal">
          <p class="font-display text-amber-400 tracking-[0.25em] text-sm mb-2">04 — PRESS ANATOMY</p>
          <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">Seven Parts Take the Load</h2>
          <p class="text-steel-200 text-sm md:text-base mb-6">The parts that fail cheap presses are the cylinder, barrel and valve block. This is exactly where Haonuo spends the steel.</p>
          <div class="rounded-2xl overflow-hidden bg-[#E9ECF0] p-3">
            <img
              src="/images/home/press-anatomy.webp"
              alt="Diagram of the seven core components inside a Haonuo hydraulic press"
              width="750"
              height="750"
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-lg"
            />
          </div>
        </div>
        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-x-10">
          {parts.map((p, i) => (
            <div class="reveal flex gap-4 py-5 border-t border-white/10" style={`transition-delay:${i * 40}ms`}>
              <span class="font-display text-3xl text-amber-400 leading-none shrink-0">{p.no}</span>
              <div>
                <h3 class="font-bold text-base mb-1">{p.title}</h3>
                <p class="text-sm text-steel-200 leading-relaxed" set:html={p.body.replace(/27SiMn[^,]*/, '<strong class="text-amber-400 font-semibold">$&</strong>').replace(/Q690 high-strength steel/, '<strong class="text-amber-400 font-semibold">Q690 high-strength steel</strong>').replace(/nickel-plated inside and out/, '<strong class="text-amber-400 font-semibold">nickel-plated inside and out</strong>')}></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 05 FACTORY ============ -->
  <section class="py-10 md:py-12 bg-white" id="factory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-5 md:mb-6 reveal">
        <p class="font-display text-amber-600 tracking-[0.25em] text-sm mb-2">05 — FACTORY DIRECT</p>
        <h2 class="font-display text-3xl md:text-4xl xl:text-[38px] 2xl:text-[42px] text-steel-900 leading-tight xl:leading-none mb-3 xl:whitespace-nowrap">Built, Then Run Under Pressure, Before It Leaves</h2>
        <p class="text-steel-500 text-sm md:text-base max-w-3xl xl:max-w-none">No trading company and no showroom stock. Welding, assembly, control cabinets and load testing happen in our own Qingzhou workshop — buyers are welcome to inspect in person before their machine ships.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 md:gap-4">
        <figure class="reveal relative rounded-2xl overflow-hidden aspect-[21/9] bg-steel-100">
          <img
            src="/images/factory/workshop-cranes.webp"
            alt="Overhead crane bays across the welding and assembly hall"
            width="5472"
            height="3648"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/70 to-transparent"></div>
          <figcaption class="absolute left-6 bottom-5 z-10 text-white font-bold text-xs md:text-sm tracking-[0.12em] uppercase flex items-center gap-3">
            <span class="w-7 h-0.5 bg-amber-500"></span>
            Assembly Hall · Overhead Crane Bays
          </figcaption>
        </figure>
        <figure class="reveal relative rounded-2xl overflow-hidden aspect-[21/9] bg-steel-100">
          <img
            src="/images/factory/buyer-inspection.webp"
            alt="Overseas buyers inspecting finished hydraulic presses during a factory visit"
            width="5472"
            height="3648"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/70 to-transparent"></div>
          <figcaption class="absolute left-6 bottom-5 z-10 text-white font-bold text-xs md:text-sm tracking-[0.12em] uppercase flex items-center gap-3">
            <span class="w-7 h-0.5 bg-amber-500"></span>
            Buyer Inspection · Assembly Workshop
          </figcaption>
        </figure>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mt-3 md:mt-4">
        <figure class="reveal relative rounded-xl overflow-hidden aspect-[4/3] bg-steel-100 group">
          <img src="/images/factory/finished-presses.webp" alt="Finished hydraulic oil presses lined up before dispatch" width="1600" height="900" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/65 to-transparent"></div>
          <figcaption class="absolute left-4 bottom-3 z-10 text-white font-bold text-[11px] md:text-xs tracking-[0.1em] uppercase">Finished Presses · Pre-Dispatch</figcaption>
        </figure>
        <figure class="reveal relative rounded-xl overflow-hidden aspect-[4/3] bg-steel-100 group">
          <img src="/images/factory/assembly-line.webp" alt="Packaged stainless presses lined up for loading with a truck behind" width="1600" height="900" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/65 to-transparent"></div>
          <figcaption class="absolute left-4 bottom-3 z-10 text-white font-bold text-[11px] md:text-xs tracking-[0.1em] uppercase">Packed Presses · Ready to Load</figcaption>
        </figure>
        <figure class="reveal relative rounded-xl overflow-hidden aspect-[4/3] bg-steel-100 group">
          <img src="/images/factory/export-loading.webp" alt="Machines wrapped and secured for export container loading" width="1600" height="1000" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/65 to-transparent"></div>
          <figcaption class="absolute left-4 bottom-3 z-10 text-white font-bold text-[11px] md:text-xs tracking-[0.1em] uppercase">Export Packing &amp; Container Loading</figcaption>
        </figure>
        <figure class="reveal relative rounded-xl overflow-hidden aspect-[4/3] bg-steel-100 group">
          <img src="/images/factory/factory-exterior.webp" alt="Haonuo factory building exterior with assembly bays in Qingzhou" width="1600" height="1200" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
          <div class="absolute inset-0 bg-gradient-to-t from-steel-950/65 to-transparent"></div>
          <figcaption class="absolute left-4 bottom-3 z-10 text-white font-bold text-[11px] md:text-xs tracking-[0.1em] uppercase">Our Factory · Qingzhou, Shandong</figcaption>
        </figure>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border border-steel-100 rounded-2xl mt-5 overflow-hidden reveal">
        {promises.map(p => (
          <div class="p-4 sm:border-l border-steel-100 first:border-l-0 max-sm:border-t max-sm:first:border-t-0">
            <p class="font-display text-amber-600 tracking-[0.2em] text-xs mb-1">{promises.indexOf(p) + 1 < 10 ? `0${promises.indexOf(p) + 1}` : promises.indexOf(p) + 1}</p>
            <h3 class="font-bold text-charcoal-900 text-sm mb-0.5">{p.title}</h3>
            <p class="text-xs text-steel-500 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 06 FAQ ============ -->
  <section class="py-16 md:py-20 bg-steel-50" id="faq">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-10 reveal">
        <p class="font-display text-amber-600 tracking-[0.25em] text-sm mb-2">06 — QUESTIONS</p>
        <h2 class="font-display text-3xl md:text-5xl text-charcoal-900 leading-none">Frequently Asked Questions</h2>
      </div>
      <div>
        {faqs.map((f, i) => (
          <details class="reveal group bg-white border border-steel-200 rounded-2xl mb-4 px-6 md:px-8 open:shadow-[0_8px_30px_-18px_rgba(16,42,67,0.25)]" {...i === 0 ? { open: true } : {}}>
            <summary class="cursor-pointer list-none py-5 font-bold text-base md:text-lg text-charcoal-900 flex justify-between items-center gap-4 [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 shrink-0 transition-transform duration-300 group-open:rotate-0 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
            </summary>
            <p class="text-sm md:text-[15px] text-steel-600 leading-relaxed pb-5 -mt-1">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 07 QUOTE ============ -->
  <section class="py-16 md:py-24 bg-steel-950 text-white relative overflow-hidden" id="contact">
    <div class="absolute -right-32 -top-32 w-96 h-96 rounded-full border-[30px] border-amber-400/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <p class="font-display text-amber-400 tracking-[0.25em] text-sm mb-2">07 — GET A QUOTE</p>
          <h2 class="font-display text-3xl md:text-5xl leading-tight mb-4">Tell Us Your Seed and Daily Target</h2>
          <p class="text-steel-200 mb-8 text-sm md:text-base">Replies come from the factory, usually within one working day. Include your voltage if you know it.</p>
          <ul class="space-y-4 text-sm md:text-base text-steel-100">
            <li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-amber-400/15 text-amber-400 grid place-items-center text-xs font-bold shrink-0">1</span> Model recommendation with barrel and pressure specs</li>
            <li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-amber-400/15 text-amber-400 grid place-items-center text-xs font-bold shrink-0">2</span> FOB Qingdao price and production lead time</li>
            <li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-amber-400/15 text-amber-400 grid place-items-center text-xs font-bold shrink-0">3</span> Machine count and workshop layout for multi-press lines</li>
            <li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-amber-400/15 text-amber-400 grid place-items-center text-xs font-bold shrink-0">4</span> Free consultation · Factory-direct pricing · Custom solution for your oil seed and production scale</li>
          </ul>
        </div>

        <div class="reveal">
          <form id="hp-form" action="/api/inquiry" method="POST" class="bg-white rounded-2xl p-6 md:p-8 border border-steel-100 shadow-sm text-charcoal-900" onsubmit="return submitHomeForm(event)">
            <input type="hidden" name="source" value={t.contact.formSubject} />
            <input type="text" name="_gotcha" style="display:none" />
            <h3 class="font-display text-2xl text-charcoal-900 mb-2">{t.contact.sendInquiry}</h3>
            <p class="text-sm text-steel-500 mb-6">{t.contact.response24h}</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="hp-name" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.name} *</label>
                <input
                  type="text"
                  id="hp-name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder={t.contact.namePlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                />
              </div>
              <div>
                <label for="hp-email" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.email} *</label>
                <input
                  type="email"
                  id="hp-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="your@email.com"
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
              <div>
                <label for="hp-phone" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.phoneLabel}</label>
                <input
                  type="tel"
                  id="hp-phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder={t.contact.phonePlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                />
              </div>
              <div>
                <label for="hp-company" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.company}</label>
                <input
                  type="text"
                  id="hp-company"
                  name="company"
                  autocomplete="organization"
                  placeholder={t.contact.companyPlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
              <div>
                <label for="hp-country" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.country}</label>
                <input
                  type="text"
                  id="hp-country"
                  name="country"
                  list="hp-country-list"
                  placeholder={t.contact.countryPlaceholder}
                  autocomplete="off"
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                />
                <datalist id="hp-country-list">
                  {countryOptions.map(country => (
                    <option value={country}>{country}</option>
                  ))}
                </datalist>
              </div>
              <div>
                <label for="hp-product" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.productInterestLabel}</label>
                <input
                  type="text"
                  id="hp-product"
                  name="product"
                  list="hp-product-list"
                  placeholder={t.contact.productPlaceholder}
                  autocomplete="off"
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                />
                <datalist id="hp-product-list">
                  {productOptions.map(product => (
                    <option value={product}>{product}</option>
                  ))}
                </datalist>
              </div>
            </div>

            <div class="mt-5">
              <label for="hp-message" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.message} *</label>
              <p class="text-xs text-steel-500 mb-1.5">{t.contact.messageHint}</p>
              <textarea
                id="hp-message"
                name="message"
                required
                rows="5"
                placeholder={t.contact.messagePlaceholder}
                class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <div class="cf-turnstile mt-5" data-sitekey="0x4AAAAAAFIiDuJVsJp4_WlY"></div>

            <button id="hp-btn" type="submit" class="btn-primary text-base w-full justify-center mt-6">
              <span id="hp-btn-text">{t.contact.submit}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>

          <div id="hp-success" class="hidden bg-white rounded-2xl p-6 md:p-8 border border-steel-100 shadow-sm text-charcoal-900 text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-green-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.contact.inquirySent}</h3>
              <p class="text-steel-500">{t.contact.inquirySentDesc}</p>
              <button type="button" id="hp-another" class="btn-outline mt-6 mx-auto">{t.contact.sendAnother}</button>
            </div>
          <div id="hp-error" class="hidden bg-white rounded-2xl p-6 md:p-8 border border-steel-100 shadow-sm text-charcoal-900 text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-red-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.contact.inquiryFailed}</h3>
              <p class="text-steel-500">{t.contact.inquiryFailedDesc}</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
