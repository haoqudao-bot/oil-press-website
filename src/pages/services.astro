---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');

const services = [
  {
    icon: 'machine',
    data: t.services.standardPurchase,
  },
  {
    icon: 'oem',
    data: t.services.oem,
  },
  {
    icon: 'odm',
    data: t.services.odm,
  },
  {
    icon: 'parts',
    data: t.services.spareParts,
  },
  {
    icon: 'support',
    data: t.services.technicalSupport,
  },
  {
    icon: 'upgrade',
    data: t.services.upgrade,
  },
];

const iconPaths: Record<string, string> = {
  machine: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  oem: 'M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82zM7 7h.01',
  odm: 'M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z',
  parts: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  support: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  upgrade: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.services.breadcrumbHome, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: t.services.breadcrumbAbout, item: 'https://www.hydoilpress.com/about' },
    { '@type': 'ListItem', position: 3, name: t.services.breadcrumbServices, item: 'https://www.hydoilpress.com/services' },
  ],
};
---

<BaseLayout title="OEM/ODM Manufacturing & Services | Haonuo Machinery" description="Haonuo Machinery offers standard machine purchase, OEM white label manufacturing, ODM custom engineering, spare parts, technical support, and equipment upgrades for hydraulic oil press machines." keywords={['oil press OEM manufacturer', 'hydraulic oil press ODM', 'custom oil press machine', 'oil press machine manufacturer China']} jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.services.breadcrumbHome}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/about" class="hover:text-amber-500 transition-colors">{t.services.breadcrumbAbout}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{t.services.breadcrumbServices}</span>
      </nav>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 bg-amber-50 text-amber-700 px-4 py-2 rounded-full text-sm font-medium mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {t.services.factoryBadge}
        </div>
        <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-4">{t.services.title}</h1>
        <p class="text-steel-500 text-lg max-w-3xl mx-auto">{t.services.subtitle}</p>
      </div>

      <!-- Service Cards -->
      <div class="space-y-8 mb-20">
        {services.map((service, index) => (
          <div class={`bg-white rounded-2xl border border-steel-100 overflow-hidden ${index === 1 || index === 2 ? 'border-amber-200 shadow-md' : ''}`}>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-0">
              <!-- Left: Info -->
              <div class={`p-8 ${index === 1 || index === 2 ? 'bg-amber-50/50' : 'bg-steel-50/50'}`}>
                <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[service.icon]}/></svg>
                </div>
                <h2 class="font-display text-2xl text-charcoal-900 mb-1">{service.data.title}</h2>
                <p class="text-amber-600 font-medium text-sm mb-4">{service.data.subtitle}</p>
                <p class="text-steel-600 leading-relaxed">{service.data.description}</p>
                <div class="mt-4">
                  <span class="text-xs font-semibold text-steel-400 uppercase tracking-wider">{t.services.bestForLabel}</span>
                  <p class="text-sm text-steel-700 mt-1">{service.data.bestFor}</p>
                </div>
              </div>
              <!-- Right: Features -->
              <div class="lg:col-span-2 p-8">
                <h3 class="font-display text-lg text-charcoal-900 mb-4">{t.services.whatsIncluded}</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {service.data.features.map(feature => (
                    <div class="flex items-start gap-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      <span class="text-sm text-steel-700">{feature}</span>
                    </div>
                  ))}
                </div>
                <div class="mt-6">
                  <a href="/contact" class="inline-flex items-center text-amber-600 hover:text-amber-700 font-medium transition-colors text-sm">
                    {service.data.quoteLink}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- OEM/ODM Highlight -->
      <div class="bg-gradient-to-br from-steel-900 to-steel-800 rounded-2xl p-8 md:p-12 mb-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-3xl text-white mb-4">{t.services.oemOdmHighlight.title}</h2>
            <p class="text-steel-300 text-lg mb-8">{t.services.oemOdmHighlight.subtitle}</p>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-amber-500/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-1">{t.services.oemOdmHighlight.directFactory.title}</h3>
                  <p class="text-steel-400 text-sm">{t.services.oemOdmHighlight.directFactory.desc}</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-amber-500/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-1">{t.services.oemOdmHighlight.exportExperience.title}</h3>
                  <p class="text-steel-400 text-sm">{t.services.oemOdmHighlight.exportExperience.desc}</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-amber-500/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-1">{t.services.oemOdmHighlight.flexibleMoq.title}</h3>
                  <p class="text-steel-400 text-sm">{t.services.oemOdmHighlight.flexibleMoq.desc}</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-amber-500/20 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-1">{t.services.oemOdmHighlight.fullCustomization.title}</h3>
                  <p class="text-steel-400 text-sm">{t.services.oemOdmHighlight.fullCustomization.desc}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-steel-800 rounded-xl p-8 border border-steel-700">
            <h3 class="font-display text-xl text-white mb-4">{t.services.oemOdmHighlight.readyForCustom.title}</h3>
            <p class="text-steel-400 text-sm mb-6">{t.services.oemOdmHighlight.readyForCustom.subtitle}</p>
            <ul class="space-y-2 mb-6 text-sm text-steel-300">
              {t.services.oemOdmHighlight.readyForCustom.benefits.map(benefit => (
                <li class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {benefit}
                </li>
              ))}
            </ul>
            <a href="/contact" class="block w-full text-center bg-amber-500 text-charcoal-900 font-semibold py-3 rounded-xl hover:bg-amber-400 transition-colors">
              {t.services.oemOdmHighlight.readyForCustom.cta}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 inline ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Process -->
      <div class="mb-20">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl text-charcoal-900 mb-3">{t.services.process.title}</h2>
          <p class="text-steel-500 max-w-2xl mx-auto">{t.services.process.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
          {[1, 2, 3, 4, 5].map(step => (
            <div class="text-center">
              <div class="w-12 h-12 mx-auto mb-4 bg-amber-500 text-white rounded-full flex items-center justify-center font-display text-xl font-bold">{step}</div>
              <h3 class="font-display text-lg text-charcoal-900 mb-2">{t.services.process[`step${step}`].title}</h3>
              <p class="text-sm text-steel-600">{t.services.process[`step${step}`].desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-amber-500 rounded-2xl p-8 md:p-12 text-center">
        <h2 class="font-display text-3xl text-charcoal-900 mb-4">{t.services.cta.title}</h2>
        <p class="text-charcoal-700 text-lg max-w-2xl mx-auto mb-8">{t.services.cta.subtitle}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-charcoal-900 text-white font-semibold rounded-xl hover:bg-charcoal-800 transition-colors">
            {t.services.cta.requestQuote}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="https://wa.me/8618957149128" target="_blank" rel="noopener" class="inline-flex items-center justify-center px-8 py-4 bg-white text-charcoal-900 font-semibold rounded-xl hover:bg-steel-50 transition-colors">
            {t.services.cta.chatWhatsApp}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>