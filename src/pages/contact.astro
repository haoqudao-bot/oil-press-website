---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');
const isSuccess = Astro.url.searchParams.get('success') === 'true';
const wechatId = '18957149128';

const productOptions = [
  'HN300 Hydraulic Oil Press',
  'HN325 Hydraulic Oil Press',
  'HN325S Hydraulic Oil Press',
  'HN355 Hydraulic Oil Press',
  'HN400 Hydraulic Oil Press',
  'HN426 Hydraulic Oil Press',
  'HN480B Hydraulic Oil Press',
  'HN500 Hydraulic Oil Press',
  'Sesame Special Oil Press',
  'Coconut/VCO Special Oil Press',
  'Barrel Type Oil Press',
  'Custom / Other Product',
];

const countryOptions = [
  'India', 'Nigeria', 'Pakistan', 'Philippines', 'Kenya',
  'Saudi Arabia', 'UAE', 'Egypt', 'Ghana', 'Tanzania', 'Indonesia',
  'Vietnam', 'Thailand', 'Myanmar', 'Sri Lanka', 'Turkey', 'Iraq',
  'Uganda', 'Kazakhstan', 'Uzbekistan', 'Other',
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.contact.breadcrumbHome, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: t.contact.breadcrumbContact, item: 'https://www.hydoilpress.com/contact' },
  ],
};
---

<BaseLayout title={t.contact.title} description={t.contact.subtitle} jsonLd={breadcrumbLd}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.contact.breadcrumbHome}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.contact.breadcrumbContact}</span>
      </nav>
    </div>
  </section>

  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.contact.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.contact.subtitle}</p>
      <div class="mt-6 inline-flex items-center gap-2 bg-green-500/20 text-green-400 px-4 py-2 rounded-full text-sm font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {t.contact.response24h}
      </div>
    </div>
  </section>

  <section class="py-6 bg-steel-50 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-steel-100">
          <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-charcoal-900">{t.contact.trustBadge1Title}</div>
            <div class="text-xs text-steel-500">{t.contact.trustBadge1Desc}</div>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-steel-100">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-charcoal-900">{t.contact.trustBadge2Title}</div>
            <div class="text-xs text-steel-500">{t.contact.trustBadge2Desc}</div>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-steel-100">
          <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-charcoal-900">{t.contact.trustBadge3Title}</div>
            <div class="text-xs text-steel-500">{t.contact.trustBadge3Desc}</div>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-4 border border-steel-100">
          <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-purple-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-charcoal-900">{t.contact.trustBadge4Title}</div>
            <div class="text-xs text-steel-500">{t.contact.trustBadge4Desc}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-steel-100 shadow-sm">
            <h2 class="font-display text-2xl text-charcoal-900 mb-2">{t.contact.sendInquiry}</h2>
            <p class="text-sm text-steel-500 mb-6">{t.contact.response24h}</p>
            <form id="contact-form" action="https://formspree.io/f/mbdnqajz" method="POST" class="space-y-5">
              <input type="hidden" name="_subject" value={t.contact.formSubject} />
              <input type="text" name="_gotcha" style="display:none" />
              <input type="hidden" name="_next" value={`${Astro.url.origin}/contact?success=true`} />
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.name} *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder={t.contact.namePlaceholder}
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.email} *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="your@email.com"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.phoneLabel}</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder={t.contact.phonePlaceholder}
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.company}</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    placeholder={t.contact.companyPlaceholder}
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="country" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.country}</label>
                  <input
                    type="text"
                    id="country"
                    name="country"
                    list="country-list"
                    placeholder={t.contact.countryPlaceholder}
                    autocomplete="off"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                  <datalist id="country-list">
                    {countryOptions.map(country => (
                      <option value={country}>{country}</option>
                    ))}
                  </datalist>
                </div>
                <div>
                  <label for="product" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.productInterestLabel}</label>
                  <input
                    type="text"
                    id="product"
                    name="product"
                    list="product-list"
                    placeholder={t.contact.productPlaceholder}
                    autocomplete="off"
                    class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm"
                  />
                  <datalist id="product-list">
                    {productOptions.map(product => (
                      <option value={product}>{product}</option>
                    ))}
                  </datalist>
                </div>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.message} *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder={t.contact.messagePlaceholder}
                  class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm resize-none"
                ></textarea>
              </div>

              <button type="submit" class="btn-primary text-base w-full justify-center">
                {t.contact.submit}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </form>
            {isSuccess ? (
              <div id="form-success" class="text-center py-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-green-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.contact.inquirySent}</h3>
                <p class="text-steel-500">{t.contact.inquirySentDesc}</p>
              </div>
            ) : null}
          </div>
        </div>

        <div>
          <div class="bg-steel-900 rounded-2xl p-6 md:p-8 text-white mb-6">
            <h2 class="font-display text-2xl mb-6">{t.contact.contactInfo}</h2>
            <div class="space-y-5">
              <a
                href={`https://wa.me/8618957149128?text=${encodeURIComponent(t.contact.whatsappPresetMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                {t.chat.whatsapp}
              </a>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.phone}</div>
                  <a href="tel:+8618957149128" class="font-medium hover:text-amber-500 transition-colors">{t.contact.phoneNum}</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.email}</div>
                  <a href="mailto:info@hydoilpress.com" class="font-medium hover:text-amber-500 transition-colors">{t.contact.emailAddr}</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.address}</div>
                  <a href="https://maps.google.com/?q=Qingzhou+Weifang+Shandong+China" target="_blank" rel="noopener noreferrer" class="font-medium text-sm hover:text-amber-500 transition-colors">{t.contact.addressText}</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18z"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.chat.wechat}</div>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="font-medium">{wechatId}</span>
                    <button data-copy-wechat-page type="button" class="text-green-400 hover:text-green-300 text-xs font-medium transition-colors">{t.chat.copyId}</button>
                  </div>
                  <span data-copy-toast-page class="hidden text-green-400 text-xs">{t.chat.copied}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                  <div class="text-sm text-steel-300 mb-0.5">{t.contact.workingHours}</div>
                  <div class="font-medium text-sm">{t.contact.workingHoursDesc}</div>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-3">
            <a
              href="mailto:info@hydoilpress.com"
              class="flex items-center justify-center gap-2 w-full bg-amber-500 hover:bg-amber-600 text-charcoal-900 font-semibold px-6 py-3 rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {t.chat.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.contact.whatToExpect}</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-12 reveal">{t.contact.response24h}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[1, 2, 3, 4].map((step, i) => (
          <div class="reveal bg-white p-6 rounded-2xl shadow-sm text-center" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-12 h-12 mx-auto mb-4 bg-amber-500 rounded-full flex items-center justify-center font-display text-xl text-charcoal-900">{step}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{t.contact[`expect${step}Title`]}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{t.contact[`expect${step}Desc`]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.contact.ourLocation}</h2>
      <p class="text-center text-steel-600 max-w-2xl mx-auto mb-8 reveal">{t.contact.mapDescription}</p>
      <div class="reveal rounded-2xl overflow-hidden border border-steel-200 shadow-sm">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d104856.876!2d118.47!3d36.69!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x35fda3e8c4c4c4c4%3A0x1234567890abcdef!2sQingzhou%2C%20Weifang%2C%20Shandong%2C%20China!5e0!3m2!1sen!2s!4v1700000000000"
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={t.contact.mapTitle}
        ></iframe>
      </div>
      <div class="mt-6 text-center">
        <a href="https://maps.google.com/?q=Qingzhou+Weifang+Shandong+China" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-amber-600 hover:text-amber-700 font-medium transition-colors">
