---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } }];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const pageTitle = currentLocale === 'fr' ? 'Presse à Huile Hydraulique en Vente — HN300–HN500, Direct Usine' :
                  currentLocale === 'ar' ? 'مكابس الزيت الهيدروليكية للبيع — HN300–HN500، مباشرة من المصنع' :
                  'Mesin Press Minyak Hidrolik Dijual — HN300–HN500, Langsung Pabrik';

const pageDesc = currentLocale === 'fr' ? 'Presse à huile hydraulique de 300 à 620 tonnes. Pressage à froid et à chaud sur la même machine. Prix d\'usine direct, garantie 1 an, test de charge 48 h. Comparez les modèles et demandez un devis.' :
                 currentLocale === 'ar' ? 'مكابس زيت هيدروليكية من 300 إلى 620 طن. عصر بارد وساخن على نفس الماكينة. أسعار مباشرة من المصنع، ضمان سنة، اختبار حمل 48 ساعة. قارن الموديلات واطلب عرض سعر.' :
                 'Mesin press minyak hidrolik 300 hingga 620 ton. Press dingin dan panas di satu mesin. Harga langsung pabrik, garansi 1 tahun, uji beban 48 jam. Bandingkan model dan minta penawaran.';

type Ui = {
  badge: string;
  whatIsTitle: string;
  p1: string; p2: string; p3: string;
  factsTitle: string;
  facts: { label: string; value: string }[];
  factsNote: string;
  cards: { title: string; desc: string }[];
  chooseBadge: string; chooseTitle: string; chooseIntro: string;
  scenarios: {
    tag: string; title: string; seeds: string; force: string; desc: string;
    models: { name: string; href: string; note: string }[];
  }[];
  rangeTitle: string; rangeSub: string; compareAll: string;
  yieldsSub: string;
  fitTitle: string; fitDesc: string; fitLink: string;
  trustTitle: string; trustSub: string;
  trust: { stat: string; text: string }[];
  buyTitle: string; buySub: string;
  buyCards: { title: string; body: string[]; ordered?: boolean; pre?: string }[];
  finalPre: string; finalLink: string;
};

