const L = ui[currentLocale];

const richHtml = (s: string, cls = 'text-charcoal-900') =>
  s.replace(/\*\*(.+?)\*\*/g, `<b class="${cls}">$1</b>`);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.nav.products, item: `https://www.hydoilpress.com/${currentLocale}/products` },
    { '@type': 'ListItem', position: 3, name: t.common.hydraulicOilPressMachine, item: `https://www.hydoilpress.com/${currentLocale}/hydraulic-oil-press-machine` }],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.hydraulic.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const rangeModels = [
  { model: 'HN300', force: '300 t', pressure: '25 MPa', href: '/products/mini-hydraulic-oil-press/' },
  { model: 'HN325', force: '325 t', pressure: '27 MPa', href: '/products/standard-hydraulic-oil-press/' },
  { model: 'HN365', force: '365 t', pressure: '30 MPa', href: '/products/commercial-hydraulic-oil-press/' },
  { model: 'HN426', force: '500 t', pressure: '42 MPa', href: '/products/cold-press-hydraulic-oil-press/' },
  { model: 'HN500', force: '620 t', pressure: '52 MPa', href: '/products/ultra-high-pressure-hydraulic-oil-press/' },
];
---

<BaseLayout
  locale={currentLocale}
  title={pageTitle}
  description={pageDesc}
  keywords={currentLocale === 'fr' ? ['presse à huile hydraulique', 'presse hydraulique', 'machine pressage à froid', 'presse pour extraction huile', 'fabricant machine pressage huile'] : currentLocale === 'ar' ? ['مكينة ضغط زيت هيدروليكية', 'مكينة ضغط هيدروليكي', 'مكينة ضغط بارد', 'مكينة استخراج الزيت', 'مصنع مكائن ضغط الزيت'] : ['mesin press minyak hidrolik', 'press hidrolik', 'mesin press dingin', 'mesin ekstraksi minyak', 'pabrik mesin press minyak']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products/')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.common.hydraulicOilPressMachine}</span>
      </nav>
    </div>
  </section>

  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4">{t.hydraulic.heroTitle}</h1>
          <p class="text-steel-300 text-lg max-w-3xl mb-8">{t.hydraulic.heroDesc}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={localePath('/contact/')} class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
              {t.hydraulic.requestQuote}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href={localePath('/products/model-comparison/')} class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white hover:text-steel-900 transition-colors text-lg">
              {t.hydraulic.compareModels}
            </a>
          </div>
        </div>
        <div class="relative">
          <picture class="block overflow-hidden rounded-2xl shadow-2xl">
            <img src="/images/models/hn426.webp" alt="Haonuo HN426 hydraulic oil press — 426 ton flagship, cold and hot pressing" class="w-full h-full object-cover" loading="eager" width="800" height="600">
          </picture>
          <div class="absolute -bottom-4 -right-4 bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-display font-semibold text-sm shadow-lg">Built &amp; load-tested in our own factory</div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is a hydraulic oil press -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-4">{L.badge}</span>
          <h2 class="font-display text-3xl md:text-4xl text-charcoal-900 mb-4">{L.whatIsTitle}</h2>
          <p class="text-steel-600 leading-relaxed mb-4" set:html={richHtml(L.p1)}></p>
          <p class="text-steel-600 leading-relaxed mb-4" set:html={richHtml(L.p2)}></p>
          <p class="text-steel-600 leading-relaxed" set:html={richHtml(L.p3)}></p>
        </div>
        <div class="bg-steel-50 rounded-2xl border border-steel-100 overflow-hidden">
          <div class="bg-steel-900 px-6 py-4">
            <h3 class="font-display text-lg text-white">{L.factsTitle}</h3>
          </div>
          <dl class="divide-y divide-steel-100">
            {L.facts.map(f => (
              <div class="flex items-center justify-between px-6 py-3.5">
                <dt class="text-steel-500 text-sm">{f.label}</dt>
                <dd class="text-charcoal-900 font-semibold text-sm text-right">{f.value}</dd>
              </div>
            ))}
          </dl>
          <div class="px-6 py-4 bg-amber-50">
            <p class="text-xs text-amber-800">{L.factsNote}</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        {L.cards.map(card => (
          <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{card.title}</h3>
            <p class="text-steel-600 text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-12 md:py-16 bg-steel-50 border-y border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.hydraulic.howWorksTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center text-white font-display text-2xl mx-auto mb-4">1</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.howWorksStep1.title}</h3>
          <p class="text-steel-600">{t.hydraulic.howWorksStep1.desc}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center text-white font-display text-2xl mx-auto mb-4">2</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.howWorksStep2.title}</h3>
          <p class="text-steel-600">{t.hydraulic.howWorksStep2.desc}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center text-white font-display text-2xl mx-auto mb-4">3</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.howWorksStep3.title}</h3>
          <p class="text-steel-600">{t.hydraulic.howWorksStep3.desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Scenario gateway + range bar -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-4">{L.chooseBadge}</span>
      <h2 class="font-display text-3xl md:text-4xl text-charcoal-900 mb-3">{L.chooseTitle}</h2>
      <p class="text-steel-600 max-w-3xl mb-10">{L.chooseIntro}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        {L.scenarios.map(s => (
          <div class="flex flex-col bg-steel-50 rounded-2xl p-7 border border-steel-100 hover:border-amber-300 transition-colors">
            <span class="self-start text-xs font-semibold uppercase tracking-wide bg-steel-900 text-white px-3 py-1 rounded-full mb-4">{s.tag}</span>
            <h3 class="font-display text-xl text-charcoal-900 mb-2">{s.title}</h3>
            <p class="text-amber-700 text-sm font-medium mb-1">{s.seeds}</p>
            <p class="text-steel-500 text-sm mb-3">{s.force}</p>
            <p class="text-steel-600 text-sm leading-relaxed mb-5">{s.desc}</p>
            <div class="mt-auto flex flex-wrap gap-2">
              {s.models.map(m => (
                <a href={localePath(m.href)} class="inline-flex items-center gap-1.5 bg-white border border-steel-200 hover:border-amber-400 hover:text-amber-600 text-charcoal-900 text-sm font-semibold px-3.5 py-2 rounded-lg transition-colors">
                  {m.name}
                  <span class="text-xs font-normal text-steel-400">{m.note}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="bg-steel-900 rounded-2xl p-7 md:p-9">
        <h3 class="font-display text-xl text-white mb-1">{L.rangeTitle}</h3>
        <p class="text-steel-400 text-sm mb-3">{L.rangeSub}</p>
        <p class="text-steel-500 text-xs mb-8">
          {(L.priceHint || 'HN model pricing')}
          <a href={localePath('/oil-machine-price/')} class="text-amber-400 hover:text-amber-300 ml-1">{(L.priceLink || 'see our factory price page')}</a>
        </p>
        <div class="relative">
          <div class="hidden md:block absolute top-[42px] left-6 right-6 h-1 bg-gradient-to-r from-amber-300 via-amber-500 to-amber-600 rounded"></div>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4 relative">
            {rangeModels.map(m => (
              <a href={localePath(m.href)} class="flex md:flex-col items-center gap-3 md:gap-0 group">
                <div class="w-4 h-4 rounded-full bg-amber-500 ring-4 ring-steel-900 shrink-0 md:mb-4 group-hover:scale-125 transition-transform"></div>
