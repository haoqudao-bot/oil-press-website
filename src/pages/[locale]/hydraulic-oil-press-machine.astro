---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');
const hydraulicProducts = allProducts.filter(p => p.data.category === 'hydraulic-oil-press');

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const pageTitle = currentLocale === 'fr' ? 'Presse à Huile Hydraulique — Directe d\'Usine chez Haonuo' :
                  currentLocale === 'ar' ? 'آلة ضغط الزيت الهيدروليكي — مباشرة من المصنع' :
                  'Mesin Press Minyak Hidrolik — Langsung dari Pabrik';

const pageDesc = currentLocale === 'fr' ? 'Presse à huile hydraulique professionnelle pour le pressage à froid du sésame, arachide, coco et 20+ graines oléagineuses. 15+ ans de fabrication. Prix d\'usine. Garantie 1 an.' :
                 currentLocale === 'ar' ? 'آلة ضغط الزيت الهيدروليكي المحترفة لضغط السمسم والفول السوداني والجوز الهنديadi والكركديهadi و20+ نباتات زيتية. 15+ سنة من التصنيع. أسعار مصنع. ضمان سنة واحدة.' :
                 'Mesin press minyak hidrolik profesional untuk press dingin wijen, kacang tanah, kelapa, dan 20+ biji minyak. 15+ tahun manufaktur. Harga pabrik. Garansi 1 tahun.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.nav.products, item: `https://www.hydoilpress.com/${currentLocale}/products` },
    { '@type': 'ListItem', position: 3, name: t.common.hydraulicOilPressMachine, item: `https://www.hydoilpress.com/${currentLocale}/hydraulic-oil-press-machine` },
  ],
};

const faqs = [
  { question: currentLocale === 'fr' ? 'Qu\'est-ce qu\'une presse à huile hydraulique ?' :
              currentLocale === 'ar' ? 'ما هو ماكينة الضغط الهيدروليكي؟' :
              'Apa itu mesin press minyak hidrolik?',
    answer: currentLocale === 'fr' ? 'Une presse à huile hydraulique utilise la pression hydraulique pour extraire l\'huile des graines et noix. Contrairement aux presses à vis qui génèrent de la chaleur par friction, les presses hydrauliques appliquent une pression statique uniforme à des températures contrôlées, ce qui les rend idéales pour le pressage à froid d\'huiles premium comme le sésame, la noix et l\'huile de coco. Le processus préserve les nutriments naturels, la saveur et l\'arôme.' :
            currentLocale === 'ar' ? 'تستخدم آلة الضغط الهيدروليكي الضغط الهيدروليكي لاستخراج الزيت من البذور والجوز. على عكس الماكينات الضاغطة بالبرغي التي تولد الحرارة عن طريق الاحتكاك، تطبق الماكينات الهيدروليكية ضغطاً ساكناً موحداً عند درجات حرارة مضبوطة، مما يجعلها مثالية لضغط الأزياء الفاخرة مثل السمسم والجوز والجوز الهنديadi. الحفاظ على العناصر الغذائية الطبيعية والنكهة والرائحة.' :
            'Mesin press minyak hidrolik menggunakan tekanan hidrolik untuk mengekstraksi minyak dari biji dan kacang. Tidak seperti press sekrup yang menghasilkan panas melalui gesekan, press hidrolik menerapkan tekanan statis seragam pada suhu terkontrol, membuatnya ideal untuk press dingin minyak premium seperti wijen, kacang walnut, dan minyak kelapa. Proses ini melestarikan nutrisi alami, rasa, dan aroma.' },
  { question: currentLocale === 'fr' ? 'Comment fonctionne une presse à huile hydraulique ?' :
              currentLocale === 'ar' ? 'كيف تعمل ماكينة الضغط الهيدروليكي؟' :
              'Bagaimana cara kerja mesin press minyak hidrolik?',
    answer: currentLocale === 'fr' ? 'La machine utilise une pompe hydraulique pour générer une haute pression (jusqu\'à 75 Mpa) qui entraîne un piston dans un fût rempli de graines oléagineuses préparées. La pression expulse l\'huile à travers un fût rainuré tandis que la tourteau comprimé reste à l\'intérieur. Un cycle de pressage typique dure 8-15 minutes. Le système de commande micro-ordinateur automatise l\'ensemble du processus du pressage à la vidange du tourteau.' :
            currentLocale === 'ar' ? 'تستخدم الماكينة مضخة هيدروليكية لتوليد ضغط عالٍ (حتى 75 ميجاباسكال) الذي يقود المكبس إلى داخل برميل مملوء بالبذور الزيتية المعدة. الضغط يخرج الزيت عبر البرميل المقطر بينما يبقى الكيكة المضغوطة بداخله. دورة الضغط النموذجية تستغرق 8-15 دقيقة. نظام التحكم بالكمبيوتر الصغير يقوم بأتمتة جميع مراحل العملية من الضغط إلى إخراج الكيكة.' :
            'Mesin menggunakan pompa hidrolik untuk menghasilkan tekanan tinggi (sampai 75 Mpa) yang menggerakkan piston ke dalam barrel yang diisi biji minyak yang sudah dipersiapkan. Tekanan ini memeras minyak keluar melalui barrel berlubang sementara ampas biji terkompresi tetap berada di dalam. Siklus press khas membutuhkan 8-15 menit. Sistem kontrol mikrokomputer mengotomatiskan seluruh proses dari press hingga pengeluaran ampas.' },
  { question: currentLocale === 'fr' ? 'Quelles graines peut traiter une presse à huile hydraulique ?' :
              currentLocale === 'ar' ? 'ما هي البذور التي يمكن معالجتها بواسطة ماكينة الضغط الهيدروليكي؟' :
              'Biji apa saja yang dapat diproses oleh mesin press minyak hidrolik?',
    answer: currentLocale === 'fr' ? 'Les presses à huile hydrauliques peuvent traiter plus de 20 types de graines oléagineuses dont le sésame, l\'arachide, le coco, la noix, l\'amande, le tournesol, le lin, la moutarde, le colza, la graine de thé, le soja, le cotonnier, la noisette et bien plus. Différents modèles sont optimisés pour différents types de graines — modèles plus petits pour le sésame et les graines molles, modèles haute pression pour les noix à coque dure comme la noix et l\'amande.' :
            currentLocale === 'ar' ? 'يمكن لمكائن الضغط الهيدروليكي معالجة أكثر من 20 نوع من البذور الزيتية بما في ذلك السمسم والفول السوداني والجوز الهنديadi والجوز واللوز والذرة الصفراء والخس والخردل والكركديهadi وجوز الهند ومصنوعات الصنوبر وذرة الشاي والصنوبر واللوز الصنوبريadi. تم تحسين النماذج المختلفة لنوع مختلف من البذور — نماذج أصغر للسمسم والبذور الناعمة، نماذج عالية الضغط للجوز الصلب مثل الجوز واللوز.' :
            'Mesin press minyak hidrolik dapat memproses lebih dari 20 jenis biji minyak termasuk wijen, kacang tanah, kelapa, kacang walnut, almond, bunga matahari, biji rami, sawi, rapeseed, biji teh, kedelai, kapas, apricot kernel, dan banyak lagi. Model berbeda dioptimalkan untuk jenis biji yang berbeda — model kecil untuk wijen dan biji lunak, model bertekanan tinggi untuk kacang keras seperti walnut dan almond.' },
  { question: currentLocale === 'fr' ? 'Quel est le rendement en huile d\'une presse à huile hydraulique ?' :
              currentLocale === 'ar' ? 'ما هو العائد من الزيت لماكينة الضغط الهيدروليكي؟' :
              'Berapa hasil minyak dari mesin press minyak hidrolik?',
    answer: currentLocale === 'fr' ? 'Le rendement varie selon le type de graine : sésame 42-50%, arachide 38-45%, coco 55-65%, noix 50-60%, colza 35-45%, tournesol 40-48%. Les presses hydrauliques Haonuo utilisent une conception de fût rainuré de type barre qui atteint environ 2-3% de rendement supérieur aux presses traditionnelles à fût percé (selon nos tests internes, les résultats varient), avec une huile résiduelle dans le tourteau aussi basse que 6-8%.' :
            currentLocale === 'ar' ? 'يختلف العائد حسب نوع البذرة: السمسم 42-50%، الفول السوداني 38-45%، الجوز الهنديadi 55-65%، الجوز 50-60%، الكركديهadi 35-45%، الذرة الصفراء 40-48%. تستخدم مكائن الضغط الهيدروليكي Haonuo تصميم برميل مقطر من نوع القضبان الذي يحقق حوالي 2-3% عائد أعلى من المكائن الضاغطة التقليدية بالبرميل المثقوب (حسب اختباراتنا الداخلية، والنتائج تختلف)، مع زيت باقي في الكيكة يصل إلى 6-8%.' :
            'Hasil minyak bervariasi tergantung jenis biji: wijen 42-50%, kacang tanah 38-45%, kelapa 55-65%, walnut 50-60%, rapeseed 35-45%, bunga matahari 40-48%. Mesin press hidrolik Haonuo menggunakan desain barrel beralur tipe batang yang mencapai hasil sekitar 2-3% lebih tinggi daripada press konvensional dengan barrel bolong (berdasarkan pengujian internal, hasil dapat bervariasi), dengan sisa minyak di ampas sedikitnya 6-8%.' },
  { question: currentLocale === 'fr' ? 'Combien coûte une presse à huile hydraulique ?' :
              currentLocale === 'ar' ? 'كم تكلفة ماكينة الضغط الهيدروليكي؟' :
              'Berapa harga mesin press minyak hidrolik?',
    answer: currentLocale === 'fr' ? 'Contactez Haonuo pour un prix d\'usine direct. Nous proposons des tarifs compétitifs sans majoration d\'intermédiaire — économisez par rapport aux prix des distributeurs locaux (les économies réelles varient). Le prix dépend du modèle, de la configuration du fût (simple/double) et des options de personnalisation. Demandez un devis et recevez une cotation détaillée incluant le prix de la machine, l\'expédition et les droits estimés dans les 24 heures.' :
            currentLocale === 'ar' ? 'اتصل بـ Haonuo للحصول على أسعار مصنع مباشرة. نقدم أسعاراً تنافسية بدون ربح وسيط — وفورات مقارنة بأسعار الموزعين المحليين (الوفورات الفعلية تختلف). السعر يعتمد على النموذج وتكوين البرميل (مفرد/مزدوج) وخيارات التخصيص. اطلب عرض أسعار وتلقي عرضاً مفصلاً يشتمل على سعر الماكينة والشحن والرسوم المستحقة المقدرة في غضون 24 ساعة.' :
            'Hubungi Haonuo untuk harga pabrik langsung. Kami menawarkan harga kompetitif tanpa markup perantara — hemat dibanding harga distributor lokal (penghematan aktual dapat bervariasi). Harga tergantung model, konfigurasi barrel (tunggal/ganda), dan opsi kustomisasi. Minta penawaran dan terima penawaran detail termasuk harga mesin, pengiriman, dan biaya taksiran dalam 24 jam.' },
  { question: currentLocale === 'fr' ? 'Quelle est la différence entre pressage à froid et pressage à chaud ?' :
              currentLocale === 'ar' ? 'ما هو الفرق بين الضغط البارد والضغط الساخن؟' :
              'Apa perbedaan antara press dingin dan press panas?',
    answer: currentLocale === 'fr' ? 'Le pressage à froid fonctionne en dessous de 60°C en préservant les nutriments, la saveur naturelle et l\'arôme — idéal pour les huiles premium comme le sésame, la noix et l\'huile de coco vierge. Le pressage à chaud consiste à torréfier les graines avant pressage, ce qui augmente légèrement le rendement mais peut altérer la saveur et réduire la valeur nutritionnelle. Les presses à huile hydrauliques sont naturellement adaptées au pressage à froid car elles appliquent une pression statique sans chaleur générée par friction.' :
            currentLocale === 'ar' ? 'الضغط البارد يعمل تحت 60 درجة مئوية مع الحفاظ على العناصر الغذائية والنكهة الطبيعية والرائحة — مثالي للأزياء الفاخرة مثل السمسم والجوز والجوز الهنديadi البري. الضغط الساخن يتضمن تحميص البذور قبل الضغط، مما يزيد قليلاً العائد ولكن قد يغير النكهة ويقلل من القيمة الغذائية. المكائن الضاغطة الهيدروليكية مناسبة بشكل طبيعي للضغط البارد لأنها تطبق ضغطاً ساكناً بدون حرارة ناتجة عن الاحتكاك.' :
            'Press dingin beroperasi di bawah 60°C melestarikan nutrisi, rasa alami, dan aroma — ideal untuk minyak premium seperti wijen, walnut, dan minyak kelapa virgin. Press panas melibatkan pemanggangan biji sebelum press, yang meningkatkan hasil sedikit tetapi dapat mengubah rasa dan mengurangi nilai nutrisi. Mesin press minyak hidrolik secara alami cocok untuk press dingin karena menerapkan tekanan statis tanpa panas dari gesekan.' },
  { question: currentLocale === 'fr' ? 'La machine peut-elle fonctionner sur générateur ?' :
              currentLocale === 'ar' ? 'يمكن للماكينة العمل على المولد؟' :
              'Bisakah mesin beroperasi dengan generator?',
    answer: currentLocale === 'fr' ? 'Oui, les presses hydrauliques Haonuo n\'ont besoin que de 2.2 KW de puissance moteur, ce qui les rend totalement compatibles avec un générateur de 5-7 KVA. Cela les rend idéales pour les zones avec une électricité instable ou inexistante, comme les zones rurales du Nigéria, du Kenya et d\'autres régions d\'Afrique et d\'Asie du Sud-Est.' :
            currentLocale === 'ar' ? 'نعم، مكائن الضغط الهيدروليكي Haonuo تحتاج فقط 2.2 كيلو وات من قوة المحرك، مما يجعلها متوافقة تماماً مع مولد 5-7 كيلو فولت آمبير. هذا يجعلها مثالية للمناطق التي بها كهرباء غير مستقرة أو معدومة، مثل المناطق الريفية في النيجيريا والكينيا وغيرها من المناطق في أفريقيا وجنوب آسيا.' :
            'Ya, mesin press hidrolik Haonuo hanya membutuhkan daya motor 2.2 KW, membuatnya sepenuhnya kompatibel dengan generator 5-7 KVA. Ini membuatnya ideal untuk area dengan listrik tidak stabil atau tidak ada, seperti daerah pedesaan Nigeria, Kenya, dan wilayah lain di Afrika dan Asia Tenggara.' },
  { question: currentLocale === 'fr' ? 'Quelle garantie fournissez-vous ?' :
              currentLocale === 'ar' ? 'ما هو الضمان الذي توفره؟' :
              'Berapa garansi yang Anda berikan?',
    answer: currentLocale === 'fr' ? 'Toutes les machines Haonuo sont livrées avec une garantie de 1 an couvrant les défauts de fabrication, plus un support technique à vie. Les pièces de rechange sont disponibles en stock. Chaque machine subit un test continu de 48 heures à pleine charge avant l\'expédition pour garantir un fonctionnement fiable.' :
            currentLocale === 'ar' ? 'تأتي جميع مكائن Haonuo مع ضمان 1 سنة يغطي العيوب التصنيعية، بالإضافة إلى دعم فني مدى الحياة. قطع الغيار متوفرة في المخزن. تخضع كل ماكينة لاختبار مستمر لمدة 48 ساعة بحد أقصى من الحمل قبل الشحن لضمان التشغيل الموثوق.' :
            'Semua mesin Haonuo dilengkapi garansi 1 tahun yang mencakup cacat manufaktur, plus dukungan teknis seumur hidup. Spare part tersedia di stok. Setiap mesin menjalani pengujian berkelanjutan 48 jam dengan beban penuh sebelum pengiriman untuk memastikan operasi andal.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  locale={currentLocale}
  title={pageTitle}
  description={pageDesc}
  keywords={currentLocale === 'fr' ? ['presse à huile hydraulique', 'presse hydraulique', 'machine pressage à froid', 'presse pour extraction huile', 'fabricant machine pressage huile'] : currentLocale === 'ar' ? ['مكينة ضغط زيت هيدروليكية', 'مكينة ضغط هيدروليكي', 'مكينة ضغط بارد', 'مكينة استخراج الزيت', 'مصنع مكائن ضغط الزيت'] : ['mesin press minyak hidrolik', 'press hidrolik', 'mesin press dingin', 'mesin ekstraksi minyak', 'pabrik mesin press minyak']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.common.hydraulicOilPressMachine}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4">{pageTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl mb-8">{pageDesc}</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={localePath('/contact')} class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          {currentLocale === 'fr' ? 'Demander un devis' : currentLocale === 'ar' ? 'طلب عرض أسعار' : 'Minta Penawaran'}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={localePath('/products/model-comparison')} class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white hover:text-steel-900 transition-colors text-lg">
          {currentLocale === 'fr' ? 'Comparer les modèles' : currentLocale === 'ar' ? 'مقارنة النماذج' : 'Bandingkan Model'}
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Hydraulic Oil Press -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{currentLocale === 'fr' ? 'Pourquoi choisir une Presse à Huile Hydraulique' : currentLocale === 'ar' ? 'لماذا تختار ماكينة الضغط الهيدروليكي' : 'Mengapa Memilih Mesin Press Minyak Hidrolik'}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{currentLocale === 'fr' ? 'Rendement en Huile Élevé' : currentLocale === 'ar' ? 'عائد زيت عالي' : 'Hasil Minyak Tinggi'}</h3>
          <p class="text-sm text-steel-600 mb-3">{currentLocale === 'fr' ? 'Généralement 42-50% pour le sésame, 55-65% pour le coco selon la qualité des graines et les conditions de traitement. Les résultats varient.' : currentLocale === 'ar' ? 'عادة 42-50% للسمسم، 55-65% للجوز الهنديadi حسب جودة البذور وشروط المعالجة. النتائج تختلف.' : 'Biasanya 42-50% untuk wijen, 55-65% untuk kelapa tergantung kualitas biji dan kondisi pemrosesan. Hasil dapat bervariasi.'}</p>
          <div class="text-amber-500 font-semibold text-sm">{currentLocale === 'fr' ? 'Sésame: 42-50% de rendement' : currentLocale === 'ar' ? 'السمسم: عائد 42-50%' : 'Wijen: Hasil 42-50%'}</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{currentLocale === 'fr' ? 'Consommation Énergétique Basse' : currentLocale === 'ar' ? 'استهلاك طاقة منخفض' : 'Konsumsi Energi Rendah'}</h3>
