﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allResources = await getCollection('resources');
const sortedResources = allResources.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const typeLabels: Record<string, string> = {
  comparison: t.resources.comparison,
  guide: t.resources.guide,
  blog: t.resources.blog,
  news: (t as any).resources?.news || 'News',
};

const typeColors: Record<string, string> = {
  comparison: 'bg-blue-100 text-blue-700',
  guide: 'bg-green-100 text-green-700',
  blog: 'bg-purple-100 text-purple-700',
  news: 'bg-amber-100 text-amber-700',
};

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: `https://www.hydoilpress.com/${currentLocale}/resources` },
  ],
};

const readingContent = {
  heading: { en: 'Start Here — A Reading Path for New Buyers', fr: 'Commencez ici — parcours de lecture pour les nouveaux acheteurs', ar: 'ابدأ من هنا — مسار قراءة للمشترين الجدد', id: 'Mulai dari sini — jalur membaca untuk pembeli baru' },
  intro: { en: 'These guides follow the same decision path our sales engineers walk buyers through: (1) choose your pressing method and raw material, (2) size the machine to your daily output, (3) plan power, filtration and the full production line. If you are new to oil pressing, read the four topic groups below in order.', fr: 'Ces guides suivent le même parcours que celui de nos ingénieurs commerciaux : (1) choisissez votre méthode et votre matière, (2) dimensionnez la machine selon votre production quotidienne, (3) planifiez l\'alimentation, la filtration et la ligne complète. Nouveau dans le pressage ? Lisez les quatre groupes ci-dessous dans l\'ordre.', ar: 'تتبع هذه الأدلة نفس مسار القرار الذي يسلكه مهندسو المبيعات مع المشترين: (1) اختر طريقة العصر والمادة الخام، (2) حدّد حجم الآلة حسب إنتاجك اليومي، (3) خطط للكهرباء والفلترة وخط الإنتاج الكامل. إن كنت جديدًا في عصر الزيوت، اقرأ المجموعات الأربع أدناه بالترتيب.', id: 'Panduan ini mengikuti jalur keputusan yang dipakai teknisi penjualan kami: (1) pilih metode press dan bahan baku, (2) sesuaikan ukuran mesin dengan produksi harian, (3) rencanakan kelistrikan, filtrasi, dan lini lengkap. Baru mengenal pemerasan minyak? Baca empat grup topik di bawah secara berurutan.' },
  cards: [
    { title: { en: 'Choose your method & material', fr: 'Choisissez votre méthode et votre matière', ar: 'اختر طريقة العصر والمادة', id: 'Pilih metode & bahan' }, desc: { en: 'Cold pressing preserves nutrients; hot pressing gives higher yield. First confirm which fits your seeds and market.', fr: 'Le pressage à froid préserve les nutriments ; le pressage à chaud donne un meilleur rendement. Confirmez d\'abord ce qui convient à vos graines et votre marché.', ar: 'العصر البارد يحافظ على العناصر الغذائية؛ والعصر الساخن يعطي إنتاجية أعلى. حدّد أولاً ما يناسب بذورك وسوقك.', id: 'Cold press menjaga nutrisi; hot press memberi hasil lebih tinggi. Pastikan dulu mana yang cocok untuk biji dan pasar Anda.' }, links: [
      { href: '/resources/cold-press-vs-hot-press-oil', label: { en: 'Cold Press vs Hot Press Oil', fr: 'Pressage à froid vs à chaud', ar: 'العصر البارد مقابل العصر الساخن', id: 'Cold press vs hot press' } },
      { href: '/resources/oil-press-raw-materials-guide', label: { en: 'Oil Press Raw Materials Guide', fr: 'Guide des matières premières', ar: 'دليل المواد الخام', id: 'Panduan bahan baku' } },
    ]},
    { title: { en: 'Select the right machine', fr: 'Sélectionnez la bonne machine', ar: 'اختر الآلة المناسبة', id: 'Pilih mesin yang tepat' }, desc: { en: 'Compare hydraulic, screw and manual presses, then match model capacity to your planned daily output.', fr: 'Comparez les presses hydrauliques, à vis et manuelles, puis adaptez la capacité du modèle à votre production quotidienne prévue.', ar: 'قارن المكابس الهيدروليكية واللولبية واليدوية، ثم طابق سعة الطراز مع إنتاجك اليومي المخطط.', id: 'Bandingkan press hidrolik, ulir (screw), dan manual, lalu cocokkan kapasitas model dengan rencana produksi harian.' }, links: [
      { href: '/resources/hydraulic-oil-press-buying-guide', label: { en: 'Hydraulic Oil Press Buying Guide', fr: 'Guide d\'achat d\'une presse hydraulique', ar: 'دليل شراء المكبس الهيدروليكي', id: 'Panduan membeli mesin press hidrolik' } },
      { href: '/resources/hydraulic-oil-press-vs-other-types', label: { en: 'Hydraulic Press vs Other Press Types', fr: 'Presse hydraulique vs autres types', ar: 'المكبس الهيدروليكي مقابل الأنواع الأخرى', id: 'Press hidrolik vs jenis lain' } },
    ]},
    { title: { en: 'Improve quality & yield', fr: 'Améliorez la qualité et le rendement', ar: 'حسّن الجودة والإنتاجية', id: 'Tingkatkan kualitas & hasil' }, desc: { en: 'Get more oil per batch, filter it to market-ready clarity, and turn press cake into a second income stream.', fr: 'Obtenez plus d\'huile par lot, filtrez-la pour un rendu commercial, et faites du tourteau une seconde source de revenus.', ar: 'احصل على مزيد من الزيت لكل دفعة، ورشّحه لنقاء جاهز للسوق، وحوّل الكسبة إلى مصدر دخل ثانٍ.', id: 'Dapatkan lebih banyak minyak per batch, saring hingga jernih siap jual, dan jadikan bungkil sumber pendapatan kedua.' }, links: [
      { href: '/resources/how-to-maximize-oil-yield', label: { en: 'How to Maximize Oil Yield', fr: 'Comment maximiser le rendement', ar: 'كيف ترفع إنتاج الزيت', id: 'Cara memaksimalkan hasil minyak' } },
      { href: '/resources/crude-oil-filtration-guide', label: { en: 'Crude Oil Filtration Guide', fr: 'Guide de filtration de l\'huile brute', ar: 'دليل فلترة الزيت الخام', id: 'Panduan filtrasi minyak mentah' } },
      { href: '/resources/oil-cake-byproduct-guide', label: { en: 'Oil Cake By-product Guide', fr: 'Guide des tourteaux', ar: 'دليل كسبة الزيت', id: 'Panduan bungkil minyak' } },
    ]},
    { title: { en: 'Plan & run your business', fr: 'Planifiez et gérez votre activité', ar: 'خطط وأدر مشروعك', id: 'Rencanakan & jalankan bisnis' }, desc: { en: 'Plan the full line, prepare the right power supply, maintain the machine, and check when the investment pays back.', fr: 'Planifiez la ligne complète, préparez l\'alimentation électrique, entretenez la machine et vérifiez le retour sur investissement.', ar: 'خطط للخط الكامل، جهّز مصدر الكهرباء المناسب، حافظ على صيانة الآلة، وتحقق متى يسترد الاستثمار.', id: 'Rencanakan lini lengkap, siapkan pasokan listrik yang tepat, rawat mesin, dan cek kapan investasi kembali.' }, links: [
      { href: '/resources/complete-oil-production-line-guide', label: { en: 'Complete Oil Production Line Guide', fr: 'Guide de la ligne complète', ar: 'دليل خط الإنتاج الكامل', id: 'Panduan lini produksi lengkap' } },
      { href: '/resources/oil-press-electrical-requirements-guide', label: { en: 'Electrical Requirements Guide', fr: 'Guide des besoins électriques', ar: 'دليل المتطلبات الكهربائية', id: 'Panduan kebutuhan listrik' } },
      { href: '/resources/hydraulic-oil-press-maintenance-guide', label: { en: 'Maintenance Guide', fr: 'Guide de maintenance', ar: 'دليل الصيانة', id: 'Panduan perawatan' } },
      { href: '/roi-calculator', label: { en: 'ROI Calculator', fr: 'Calculateur de rentabilité', ar: 'حاسبة العائد على الاستثمار', id: 'Kalkulator ROI' } },
    ]},
  ],
};
---

<BaseLayout locale={currentLocale} title={t.resources.title} description={t.resources.subtitle} jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.resources.title}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.resources.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.resources.subtitle}</p>
    </div>
  </section>

  <!-- Start Here: Reading Path -->
  <section class="py-12 md:py-16 bg-white border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 mb-3">{readingContent.heading[currentLocale]}</h2>
        <p class="text-steel-600 leading-relaxed">{readingContent.intro[currentLocale]}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {readingContent.cards.map((card, i) => (
          <div class="bg-steel-50 rounded-xl p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="w-7 h-7 rounded-full bg-amber-500 text-charcoal-900 font-display font-bold flex items-center justify-center text-sm flex-shrink-0">{i + 1}</span>
              <h3 class="font-display text-lg text-charcoal-900">{card.title[currentLocale]}</h3>
            </div>
            <p class="text-sm text-steel-600 leading-relaxed mb-3">{card.desc[currentLocale]}</p>
            <ul class="text-sm space-y-1.5">
              {card.links.map(link => (
                <li><a href={link.href === '/roi-calculator' ? '/roi-calculator' : localePath(link.href)} class="text-amber-600 hover:text-amber-700 underline">{link.label[currentLocale]}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {sortedResources.map((resource, i) => (
          <a
            href={localePath(`/resources/${resource.slug}`)}
            class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            style={`animation-delay: ${i * 80}ms`}
          >
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${typeColors[resource.data.type] || 'bg-steel-100 text-steel-700'}`}>
                  {typeLabels[resource.data.type] || resource.data.type}
                </span>
                <time class="text-xs text-steel-400">
                  {resource.data.publishedAt.toLocaleDateString(currentLocale === 'fr' ? 'fr-FR' : currentLocale === 'ar' ? 'ar-SA' : 'id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-display text-xl text-charcoal-900 mb-3 group-hover:text-amber-600 transition-colors">
                {resource.data.title[currentLocale] || resource.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 leading-relaxed line-clamp-3 mb-4">
                {resource.data.description[currentLocale] || resource.data.description.en}
              </p>
              <span class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium">
                {t.resources.readMore}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
