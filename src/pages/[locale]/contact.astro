  </section>

  <!-- Map Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4 reveal">{t.contact.ourLocation}</h2>
      <div class="reveal rounded-2xl overflow-hidden border border-steel-200 shadow-sm">
        <iframe
          src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d104856.876!2d118.47!3d36.69!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x35fda3e8c4c4c4c4%3A0x1234567890abcdef!2sQingzhou%2C%20Weifang%2C%20Shandong%2C%20China!5e0!3m2!1s${currentLocale === 'fr' ? 'fr' : currentLocale === 'ar' ? 'ar' : currentLocale === 'id' ? 'id' : 'en'}!2s!4v1700000000000`}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={(t as any).contact?.mapTitle || "Haonuo Machinery Location - Qingzhou, Weifang, Shandong, China"}
        ></iframe>
      </div>
      <div class="mt-6 text-center">
        <a href="https://maps.google.com/?q=Qingzhou+Weifang+Shandong+China" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-amber-600 hover:text-amber-700 font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          {t.contact.googleMaps}
        </a>
      </div>
    </div>
  </section>



</BaseLayout>

<script is:inline define:vars={{ wechatId: "18957149128" }}>
  const copyBtn = document.querySelector('[data-copy-wechat-page]');
  const copyToast = document.querySelector('[data-copy-toast-page]');
  if (copyBtn && copyToast) {
    copyBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (navigator.clipboard) {
        navigator.clipboard.writeText(wechatId).then(() => {
          copyToast.classList.remove('hidden');
          setTimeout(() => copyToast.classList.add('hidden'), 2000);
        });
      } else {
        const ta = document.createElement('textarea');
        ta.value = wechatId;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        copyToast.classList.remove('hidden');
        setTimeout(() => copyToast.classList.add('hidden'), 2000);
      }
    });
  }
</script>
