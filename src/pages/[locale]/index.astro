            </span>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href={localePath('/solutions')} class="btn-outline text-sm">
          {t.home.viewAllSolutions}
        </a>
      </div>
    </div>
  </section>

