  <!-- Featured Products Section -->
  <section class="py-16 md:py-24 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-4 reveal">
        <div>
          <h2 class="section-title">{t.home.featuredProducts}</h2>
        </div>
        <a href={localePath('/products')} class="hidden sm:inline-flex btn-outline text-sm">
          {t.home.viewAllProducts}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <p class="text-steel-600 max-w-3xl mb-10 reveal">{t.home.featuredProductsIntro}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {featuredProducts.map((product, i) => (
          <a
            href={localePath(`/products/${product.slug}`)}
            class="reveal card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            style={`animation-delay: ${i * 100}ms`}
          >
            <div class="aspect-[4/3] bg-steel-100 overflow-hidden relative">
              <img
                src={product.data.images[0]}
                alt={product.data.title[currentLocale] || product.data.title.en}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.onerror=null;this.src='/images/hero/hydraulic-oil-press-machine.webp'"
              />
              <div class="absolute inset-0 bg-steel-900/0 group-hover:bg-steel-900/20 transition-colors duration-300 flex items-center justify-center">
                <span class="bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-medium text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  {t.products.viewDetails}
                </span>
              </div>
            </div>
            <div class="p-5">
              <div class="text-xs text-amber-500 font-medium mb-1">{currentLocale === 'id' && product.data.modelId ? product.data.modelId : currentLocale === 'fr' && product.data.modelFr ? product.data.modelFr : product.data.model}</div>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
              <div class="flex flex-wrap gap-2">
                {getLocalizedSpecs(product).slice(0, 2).map(spec => (
                  <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                    {spec.name}: {spec.value}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href={localePath('/products')} class="btn-outline text-sm">
          {t.home.viewAllProducts}
        </a>
      </div>
    </div>
  </section>

