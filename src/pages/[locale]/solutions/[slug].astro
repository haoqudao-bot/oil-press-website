---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { frSolutionBodies } from '../../../data/fr-solution-bodies';
import { arSolutionBodies } from '../../../data/ar-solution-bodies';
import { idSolutionBodies } from '../../../data/id-solution-bodies';

export async function getStaticPaths() {
  const solutions = await getCollection('solutions');
  const locales: Locale[] = ['fr', 'ar', 'id'];
  return locales.flatMap(locale =>
    solutions.map(solution => ({
      params: { locale, slug: solution.slug },
      props: { solution },
    }))
  );
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const { solution } = Astro.props;
const t = getTranslations(currentLocale);
const { Content } = await solution.render();

// Arabic oil-name phrase for keyword-rich template H2s (e.g. "عصر زيت الخردل")
const arPressPhrases: Record<string, string> = {
  almond: 'عصر زيت اللوز',
  'animal-fat': 'عصر الدهون الحيوانية',
  avocado: 'عصر زيت الأفوكادو',
  castor: 'عصر زيت الخروع',
  coconut: 'عصر زيت جوز الهند',
  commercial: 'عصر الزيت التجاري',
  cottonseed: 'عصر زيت بذرة القطن',
  flaxseed: 'عصر زيت بذور الكتان',
  industrial: 'العصر الصناعي للزيت',
  mustard: 'عصر زيت الخردل',
  olive: 'عصر زيت الزيتون',
  palm: 'عصر زيت نواة النخيل',
  peanut: 'عصر زيت الفول السوداني',
  'rice-bran': 'عصر زيت نخالة الأرز',
  sesame: 'عصر زيت السمسم',
  shea: 'عصر زبدة الشيا',
  'small-business': 'عصر الزيت للمشاريع الصغيرة',
  soybean: 'عصر زيت الصويا',
  sunflower: 'عصر زيت عباد الشمس',
  walnut: 'عصر زيت الجوز',
};
const arPress = currentLocale === 'ar' ? (arPressPhrases[solution.data.seedName] ?? 'عصر الزيت') : '';

// Select localized content (id > ar > fr > en four-level fallback)
const steps = currentLocale === 'id' && solution.data.processStepsId?.length > 0
  ? solution.data.processStepsId
  : currentLocale === 'ar' && solution.data.processStepsAr?.length > 0
  ? solution.data.processStepsAr
  : currentLocale === 'fr' && solution.data.processStepsFr?.length > 0
  ? solution.data.processStepsFr
  : solution.data.processSteps;
const faqItems = currentLocale === 'id' && solution.data.faqId?.length > 0
  ? solution.data.faqId
  : currentLocale === 'ar' && solution.data.faqAr?.length > 0
  ? solution.data.faqAr
  : currentLocale === 'fr' && solution.data.faqFr?.length > 0
  ? solution.data.faqFr
  : solution.data.faq;

// Arabic body content
const arBodyHtml = currentLocale === 'ar' && arSolutionBodies[solution.slug]
  ? marked(arSolutionBodies[solution.slug])
  : null;
// French body content
const frBodyHtml = currentLocale === 'fr' && frSolutionBodies[solution.slug]
  ? marked(frSolutionBodies[solution.slug])
  : null;
// Indonesian body content
const idBodyHtml = currentLocale === 'id' && idSolutionBodies[solution.slug]
  ? marked(idSolutionBodies[solution.slug])
  : null;

const allProducts = await getCollection('products');
const recommendedProducts = solution.data.recommendedProducts
  .map(s => allProducts.find(p => p.slug === s))
  .filter(Boolean);

const allSolutions = await getCollection('solutions');
// 相关方案优先（related 字段），其余按 order 排序补足
const relatedSlugs = solution.data.related || [];
const relatedSolutions = relatedSlugs
  .map(slug => allSolutions.find(s => s.slug === slug))
  .filter(Boolean);
const otherSolutions = [
  ...relatedSolutions,
  ...allSolutions
    .filter(s => s.slug !== solution.slug && !relatedSlugs.includes(s.slug))
    .sort((a, b) => a.data.order - b.data.order),
].slice(0, 3);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.solutions.title, item: `https://www.hydoilpress.com/${currentLocale}/solutions` },
    { '@type': 'ListItem', position: 3, name: solution.data.title[currentLocale] || solution.data.title.en, item: `https://www.hydoilpress.com/${currentLocale}/solutions/${solution.slug}` },
  ],
};

// FAQ structured data for SEO
const faqLd = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const allLd = [breadcrumbLd];
if (faqLd) allLd.push(faqLd);

// Use localized keywords for all locales (fall back to English if no specific keywords)
const seoKeywords = solution.data.seoKeywords;
---

<BaseLayout locale={currentLocale} title={solution.data.seoTitle?.[currentLocale] || solution.data.title[currentLocale] || solution.data.title.en} description={solution.data.description[currentLocale] || solution.data.description.en} keywords={seoKeywords} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/solutions/')} class="hover:text-amber-500 transition-colors">{t.solutions.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{solution.data.title[currentLocale] || solution.data.title.en}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{solution.data.title[currentLocale] || solution.data.title.en}</h1>
      <p class="text-steel-300 text-lg max-w-3xl">{solution.data.description[currentLocale] || solution.data.description.en}</p>
    </div>
  </section>

  {solution.slug === 'mustard-oil-pressing' && (
    <section class="py-8 md:py-10 bg-amber-50 border-b border-amber-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-charcoal-900 font-semibold mb-2 text-lg">💡 Making cold-pressed Kachi Ghani mustard oil?</p>
        <p class="text-steel-600 text-sm mb-4 max-w-2xl mx-auto">HN325S and HN426 engineered for Indian 415V/50Hz. CIF to Mundra / Nhava Sheva / Kandla. Tell us your daily mustard target — full factory quote in 24 hours.</p>
        <a href={localePath('/kachi-ghani-mustard-oil-machine-price/')} class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-charcoal-900 font-semibold px-6 py-3 rounded-lg transition-colors">
          Get Kachi Ghani Price →
        </a>
      </div>
    </section>
  )}

  <!-- Solution Content -->
  {solution.body && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {idBodyHtml ? (
          <div class="prose-solution max-w-none text-steel-700 leading-relaxed" set:html={idBodyHtml} />
        ) : arBodyHtml ? (
          <div class="prose-solution max-w-none text-steel-700 leading-relaxed" set:html={arBodyHtml} />
        ) : frBodyHtml ? (
          <div class="prose-solution max-w-none text-steel-700 leading-relaxed" set:html={frBodyHtml} />
        ) : (
          <div class="prose-solution max-w-none text-steel-700 leading-relaxed">
            <Content />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Process Flow -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{currentLocale === 'ar' ? `تدفق عملية ${arPress}` : t.solutions.processFlow}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((step, i) => (
          <div class="reveal relative bg-steel-50 rounded-2xl p-6" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-charcoal-900 font-display text-xl mb-4">
              {i + 1}
            </div>
            <h3 class="font-display text-xl text-charcoal-900 mb-2">{step.step}</h3>
            <p class="text-sm text-steel-600 leading-relaxed">{step.description}</p>
            {i < steps.length - 1 && (
              <div class="hidden lg:block absolute -right-3 top-1/2 -translate-y-1/2 z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recommended Equipment -->
  {recommendedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{currentLocale === 'ar' ? `معدات ${arPress} الموصى بها` : t.solutions.recommendedEquipment}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {recommendedProducts.map(product => product && (
            <a
              href={localePath(`/products/${product.slug}/`)}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title[currentLocale] || product.data.title.en}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{currentLocale === 'id' && product.data.modelId ? product.data.modelId : currentLocale === 'fr' && product.data.modelFr ? product.data.modelFr : product.data.model}</div>
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
	                  {(currentLocale === 'id' && product.data.specificationsId?.length > 0 ? product.data.specificationsId : currentLocale === 'ar' && product.data.specificationsAr?.length > 0 ? product.data.specificationsAr : currentLocale === 'fr' && product.data.specificationsFr?.length > 0 ? product.data.specificationsFr : product.data.specifications).slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faqItems.length > 0 && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-center mb-8">{currentLocale === 'ar' ? `الأسئلة الشائعة حول ${arPress}` : `${solution.data.title[currentLocale] || solution.data.title.en} — ${t.solutions.faq}`}</h2>
        <div class="space-y-4">
          {faqItems.map((item, i) => (
            <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
              <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
                <span class="font-display text-lg text-charcoal-900">{item.question}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="px-6 pb-4 text-steel-600 leading-relaxed" set:html={item.answer}></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other Solutions -->
  {otherSolutions.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{t.solutions.otherSolutions}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {otherSolutions.map(s => (
            <a
              href={localePath(`/solutions/${s.slug}/`)}
              class="card-hover bg-white rounded-2xl p-6 border border-steel-100 group hover:border-amber-300"
            >
              <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">
                {s.data.title[currentLocale] || s.data.title.en}
              </h3>
              <p class="text-sm text-steel-600 line-clamp-2">{s.data.description[currentLocale] || s.data.description.en}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      {solution.slug === 'mustard-oil-pressing' ? (
        <>
          <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Need Kachi Ghani Cold-Press Factory Quote?</h2>
          <p class="text-steel-300 text-lg mb-8">HN325S and HN426 engineered for Indian 415V/50Hz. Full spec sheet, CIF price to Mundra / Kandla in 24 hours.</p>
          <a href={localePath('/kachi-ghani-mustard-oil-machine-price/')} class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
            Get Kachi Ghani Price
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </>
      ) : (
        <>
          <h2 class="font-display text-4xl md:text-5xl text-white mb-4">{currentLocale === 'ar' ? `هل أنت مستعد لبدء مشروع ${arPress}؟` : t.solutions.ctaTitle}</h2>
          <p class="text-steel-300 text-lg mb-8">{t.solutions.ctaDesc}</p>
          <a href={localePath('/contact/')} class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
            {t.solutions.ctaButton}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </>
      )}
    </div>
  </section>
</BaseLayout>
