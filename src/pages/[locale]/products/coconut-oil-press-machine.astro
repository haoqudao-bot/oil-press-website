﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');
const seedProducts = allProducts.filter(p =>
  p.data.applicableSeeds.some(s => s.toLowerCase().includes('coconut'))
).slice(0, 3);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const pageTitle = currentLocale === 'fr' ? 'Presse à Huile de Coco — Presse Hydraulique à Froid pour VCO' :
                  currentLocale === 'ar' ? 'مكينة ضغط زيت جوز الهند — ضغط هيدروليكي بارد لـ VCO' :
                  'Mesin Press Minyak Kelapa — Press Hidrolik Dingin untuk VCO';

const pageDesc = currentLocale === 'fr' ? 'Presse à huile de coco professionnelle par Haonuo Machinery. Technologie de presse hydraulique à froid pour la production d\'huile de coco vierge (VCO). Construction en acier inoxydable 304, rendement en huile de 60-65%. Prix direct d\'usine.' :
                 currentLocale === 'ar' ? 'مكينة ضغط زيت جوز الهند محترفة من Haonuo Machinery. تقنية الضغط الهيدروليكي البارد لإنتاج زيت جوز الهند البكر (VCO). هيكل من الفولاذ المقاوم للصدأ 304، عائد زيت 60-65%. أسعار مباشرة من المصنع.' :
                 'Mesin press minyak kelapa profesional oleh Haonuo Machinery. Teknologi press hidrolik dingin untuk produksi VCO (Virgin Coconut Oil). Konstruksi baja tahan karat 304, hasil minyak 60-65%. Harga langsung pabrik.';

const heroTitle = currentLocale === 'fr' ? 'Presse à Huile de Coco' :
                  currentLocale === 'ar' ? 'مكينة ضغط زيت جوز الهند' :
                  'Mesin Press Minyak Kelapa';

const heroDesc = currentLocale === 'fr' ? 'Presse hydraulique à froid professionnelle pour la production d\'huile de coco vierge (VCO) — acier inoxydable 304, rendement en huile de 60-65%, prix direct d\'usine.' :
                 currentLocale === 'ar' ? 'ضغط هيدروليكي بارد محترف لإنتاج زيت جوز الهند البكر (VCO) — فولاذ مقاوم للصدأ 304، عائد زيت 60-65%， أسعار مباشرة من المصنع.' :
                 'Press hidrolik dingin profesional untuk produksi VCO (Virgin Coconut Oil) — baja tahan karat 304, hasil minyak 60-65%, harga langsung pabrik.';

const seoIntro1 = currentLocale === 'fr' ? 'L\'huile de coco est l\'une des huiles les plus recherchées au monde, prisée pour sa polyvalence en cuisine, en cosmétique et dans les compléments alimentaires. Produire une huile de coco de haute qualité nécessite un équipement spécialisé capable de traiter les propriétés uniques de la chair et du jus de coco. Une presse à huile de coco utilise une technologie de presse hydraulique à froid pour extraire l\'huile de coco sans chaleur excessive, préservant les triglycérides à chaîne moyenne (TCM) naturels, l\'acide laurique et l\'arôme délicat qui rendent l\'huile de coco vierge si précieuse.' :
                  currentLocale === 'ar' ? 'زيت جوز الهند هو أحد أكثر الأزياء طلباً في العالم، يُقدر لتعدد استخداماته في الطبخ ومستحضرات التجميل والمكملات الغذائية. إنتاج زيت جوز الهند عالي الجودة يتطلب معدات متخصصة يمكنها التعامل مع خصائص لحم وعصير جوز الهند الفريدة. مكينة ضغط زيت جوز الهند تستخدم تقنية الضغط الهيدروليكي البارد لاستخراج الزيت بدون حرارة مفرطة، مع الحفاظ على الدهون الثلاثية متوسطة السلسلة (MCT) الطبيعية وحمض اللوريك والرائحة الرقيقة التي تجعل زيت جوز الهند البكر ثميناً جداً.' :
                  'Minyak kelapa adalah salah satu minyak yang paling dicari di dunia, dihargai karena serbaguna dalam memasak, kosmetik, dan suplemen kesehatan. Memproduksi minyak kelapa berkualitas tinggi membutuhkan peralatan khusus yang dapat menangani sifat unik daging dan air kelapa. Mesin press minyak kelapa menggunakan teknologi press hidrolik dingin untuk mengekstraksi minyak tanpa pemanasan berlebihan, mempertahankan trigliserida rantai menengah (MCT) alami, asam laurat, dan aroma halus yang membuat minyak kelapa virgin begitu berharga.';

const seoIntro2 = currentLocale === 'fr' ? 'Les presses à huile de coco de Haonuo Machinery sont conçues spécifiquement pour le traitement du coco, avec une construction complète en acier inoxydable 304 de qualité alimentaire pour résister aux effets corrosifs du jus de coco. Que vous produisiez de l\'huile de coco vierge (VCO) à partir de chair de coco fraîche ou que vous pressiez du coprah pour de l\'huile de coco raffinée, nos presses hydrauliques offrent des rendements constants de 60-65% à partir de coco séchée, avec un minimum d\'huile résiduelle dans le tourteau. Avec des modèles allant de 50 kg/h à 125 kg/h de capacité, il existe une presse à huile de coco Haonuo adaptée à chaque échelle de production.' :
                  currentLocale === 'ar' ? 'مكائن ضغط زيت جوز الهند من Haonuo Machinery مصممة خصيصاً لمعالجة جوز الهند، مع هيكل كامل من الفولاذ المقاوم للصدأ 304 بدرجة غذائية لمقاومة التأثيرات التآكلية لعصير جوز الهند. سواء كنت تنتج زيت جوز الهند البكر (VCO) من لحم جوز الهند الطازج أو تضغط لب جوز الهند للحصول على زيت مكرر، مكائننا الهيدروليكية توفر عوائد ثابتة 60-65% من جوز الهند المجفف، مع حد أدنى من الزيت المتبقي في الكيكة. مع نماذج تتراوح من 50 إلى 125 كجم/ساعة، هناك مكينة ضغط زيت جوز الهند Haonuo مناسبة لكل حجم إنتاج.' :
                  'Mesin press minyak kelapa Haonuo Machinery dirancang khusus untuk pengolahan kelapa, dengan konstruksi penuh baja tahan karat 304 food-grade untuk menahan efek korosif air kelapa. Baik Anda memproduksi VCO (Virgin Coconut Oil) dari daging kelapa segar atau mempress kopra untuk minyak kelapa dimurnikan, press hidrolik kami memberikan hasil konsisten 60-65% dari kelapa kering, dengan sisa minyak minimal di ampas. Dengan model mulai dari 50 hingga 125 kg/jam kapasitas, ada mesin press minyak kelapa Haonuo yang cocok untuk setiap skala produksi.';

const productSectionTitle = currentLocale === 'fr' ? 'Nos Presses à Huile de Coco' :
                           currentLocale === 'ar' ? 'مكائن ضغط زيت جوز الهند لدينا' :
                           'Mesin Press Minyak Kelapa Kami';

const faqSectionTitle = currentLocale === 'fr' ? 'Foire aux questions' :
                        currentLocale === 'ar' ? 'أسئلة شائعة' :
                        'Pertanyaan yang Sering Diajukan';

const relatedTitle = currentLocale === 'fr' ? 'Solutions Associées' :
                     currentLocale === 'ar' ? 'حلول ذات صلة' :
                     'Solusi Terkait';

const faqs = [
  { question: currentLocale === 'fr' ? 'Quel est le rendement en huile de coco avec une presse hydraulique ?' :
              currentLocale === 'ar' ? 'ما هو عائد زيت جوز الهند باستخدام مكينة الضغط الهيدروليكي؟' :
              'Berapa hasil minyak kelapa menggunakan mesin press hidrolik?',
    answer: currentLocale === 'fr' ? 'Une presse à huile hydraulique peut extraire environ 60-65% d\'huile de la chair de coco séchée (coprah). Pour l\'huile de coco vierge (VCO) à partir de chair de coco fraîche, le rendement est généralement d\'environ 30-35% selon la teneur en humidité et les paramètres de pressage.' :
            currentLocale === 'ar' ? 'مكينة الضغط الهيدروليكي يمكنها استخراج حوالي 60-65% من الزيت من لحم جوز الهند المجفف (الكوبرة). لزيت جوز الهند البكر (VCO) من لحم جوز الهند الطازج، العائد عادة حوالي 30-35% حسب محتوى الرطوبة ومعلمات الضغط.' :
            'Mesin press hidrolik dapat mengekstraksi sekitar 60-65% minyak dari daging kelapa kering (kopra). Untuk VCO (Virgin Coconut Oil) dari daging kelapa segar, hasilnya biasanya sekitar 30-35% tergantung kadar kelembapan dan parameter press.' },
  { question: currentLocale === 'fr' ? 'Une presse hydraulique peut-elle produire de l\'huile de coco vierge (VCO) ?' :
              currentLocale === 'ar' ? 'هل يمكن لمكينة الضغط الهيدروليكي إنتاج زيت جوز الهند البكر (VCO)؟' :
              'Apakah mesin press hidrolik dapat memproduksi VCO (Virgin Coconut Oil)?',
    answer: currentLocale === 'fr' ? 'Oui, la presse hydraulique à coco de Haonuo est spécialement conçue pour la production de VCO. La technologie de presse à froid fonctionne à basse température, préservant la saveur naturelle, l\'arôme et la teneur en TCM de l\'huile de coco vierge sans raffinage chimique.' :
            currentLocale === 'ar' ? 'نعم، مكينة الضغط الهيدروليكي لجوز الهند من Haonuo مصممة خصيصاً لإنتاج VCO. تقنية الضغط البارد تعمل في درجة حرارة منخفضة، مع الحفاظ على النكهة الطبيعية والرائحة ومحتوى MCT لزيت جوز الهند البكر بدون تكرير كيميائي.' :
            'Ya, mesin press hidrolik kelapa Haonuo dirancang khusus untuk produksi VCO. Teknologi press dingin beroperasi pada suhu rendah, mempertahankan rasa alami, aroma, dan kandungan MCT dari minyak kelapa virgin tanpa pemurnian kimia.' },
  { question: currentLocale === 'fr' ? 'Combien de coco la machine peut-elle traiter par heure ?' :
              currentLocale === 'ar' ? 'كم جوز هند يمكن للمكينة معالجته في الساعة؟' :
              'Berapa banyak kelapa yang dapat diproses mesin per jam?',
    answer: currentLocale === 'fr' ? 'Selon le modèle, les presses hydrauliques Haonuo peuvent traiter 50 à 125 kg de coco par heure. Le HN325 traite 50 kg/h, le HN355 traite 75 kg/h, le HN426 traite 100 kg/h, et le HN500 traite 125 kg/h.' :
            currentLocale === 'ar' ? 'حسب النموذج، مكائن الضغط الهيدروليكي Haonuo يمكنها معالجة 50-125 كجم من جوز الهند في الساعة. HN325 يعالج 50 كجم/ساعة، HN355 يعالج 75 كجم/ساعة، HN426 يعالج 100 كجم/ساعة، وHN500 يعالج 125 كجم/ساعة.' :
            'Tergantung modelnya, mesin press hidrolik Haonuo dapat memproses 50-125 kg kelapa per jam. HN325 menangani 50 kg/jam, HN355 menangani 75 kg/jam, HN426 menangani 100 kg/jam, dan HN500 menangani 125 kg/jam.' },
  { question: currentLocale === 'fr' ? 'La construction en acier inoxydable est-elle nécessaire pour le pressage d\'huile de coco ?' :
              currentLocale === 'ar' ? 'هل البناء من الفولاذ المقاوم للصدأ ضروري لضغط زيت جوز الهند؟' :
              'Apakah konstruksi baja tahan karat diperlukan untuk press minyak kelapa?',
    answer: currentLocale === 'fr' ? 'Oui, le jus de coco est très corrosif pour l\'acier au carbone ordinaire. Les modèles spécifiques à la coco de Haonuo disposent d\'un revêtement complet en acier inoxydable 304 de qualité alimentaire sur le fût, le bac à huile et le châssis de la machine pour assurer la résistance à la corrosion et la conformité à la sécurité alimentaire.' :
            currentLocale === 'ar' ? 'نعم، عصير جوز الهند شديد التآكل للفولاذ الكربوني العادي. نماذج جوز الهند المخصصة من Haonuo تتمتع بغطاء كامل من الفولاذ المقاوم للصدأ 304 بدرجة غذائية على البرميل وصينية الزيت وهيكل الماكينة لضمان مقاومة التآكل والامتثال لسلامة الغذاء.' :
            'Ya, air kelapa sangat korosif terhadap baja karbon biasa. Model khusus kelapa Haonuo memiliki pelapisan penuh baja tahan karat 304 food-grade pada barrel, bak minyak, dan rangka mesin untuk memastikan ketahanan korosi dan kepatuhan keamanan pangan.' },
  { question: currentLocale === 'fr' ? 'Quelle est la différence entre presse à froid et presse à chaud pour l\'huile de coco ?' :
              currentLocale === 'ar' ? 'ما هو الفرق بين الضغط البارد والضغط الساخن لزيت جوز الهند؟' :
              'Apa perbedaan antara press dingin dan press panas untuk minyak kelapa?',
    answer: currentLocale === 'fr' ? 'Le pressage à froid extrait l\'huile à basse température, préservant l\'arôme naturel, la saveur et les nutriments de la coco — idéal pour le VCO. Le pressage à chaud consiste à chauffer la coco avant pressage, ce qui peut augmenter le rendement mais peut altérer la saveur et réduire la valeur nutritionnelle. Pour une huile de coco premium, le pressage à froid est recommandé.' :
            currentLocale === 'ar' ? 'الضغط البارد يستخرج الزيت في درجة حرارة منخفضة، مع الحفاظ على الرائحة الطبيعية والنكهة والمغذيات لجوز الهند — مثالي لـ VCO. الضغط الساخن يتضمن تسخين جوز الهند قبل الضغط، مما قد يزيد العائد ولكن قد يغير النكهة ويقلل القيمة الغذائية. لزيت جوز الهند الفاخر، يُوصى بالضغط البارد.' :
            'Press dingin mengekstraksi minyak pada suhu rendah, mempertahankan aroma alami, rasa, dan nutrisi kelapa — ideal untuk VCO. Press panas melibatkan pemanasan kelapa sebelum press, yang dapat meningkatkan hasil tetapi dapat mengubah rasa dan mengurangi nilai nutrisi. Untuk minyak kelapa premium, press dingin direkomendasikan.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.nav.products, item: `https://www.hydoilpress.com/${currentLocale}/products` },
    { '@type': 'ListItem', position: 3, name: heroTitle, item: `https://www.hydoilpress.com/${currentLocale}/products/coconut-oil-press-machine` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const ctaTitle = currentLocale === 'fr' ? 'Prêt à Démarrer Votre Entreprise d\'Huile de Coco ?' :
                currentLocale === 'ar' ? 'هل أنت مستعد لبدء مشروع زيت جوز الهند؟' :
                'Siap Memulai Bisnis Minyak Kelapa Anda?';

const ctaDesc = currentLocale === 'fr' ? 'Contactez-nous pour un devis gratuit et une recommandation d\'équipement professionnelle.' :
                currentLocale === 'ar' ? 'اتصل بنا للحصول على عرض أسعار مجاني وتوصية معدات احترافية.' :
                'Hubungi kami untuk penawaran gratis dan rekomendasi peralatan profesional.';

const ctaBtn = currentLocale === 'fr' ? 'Demander un devis gratuit' :
               currentLocale === 'ar' ? 'طلب عرض أسعار مجاني' :
               'Minta Penawaran Gratis';

const relatedSol1Title = currentLocale === 'fr' ? 'Solution de Pressage d\'Huile de Coco' :
                         currentLocale === 'ar' ? 'حل ضغط زيت جوز الهند' :
                         'Solusi Press Minyak Kelapa';
const relatedSol1Desc = currentLocale === 'fr' ? 'Ligne de production complète d\'huile de coco de la coco brute au VCO premium.' :
                        currentLocale === 'ar' ? 'خط إنتاج زيت جوز الهند الكامل من جوز الهند الخام إلى VCO الفاخر.' :
                        'Lini produksi minyak kelapa lengkap dari kelapa mentah hingga VCO premium.';
const relatedSol2Title = currentLocale === 'fr' ? 'Solution de Presse à Huile Commerciale' :
                         currentLocale === 'ar' ? 'حل المكينة الضاغطة التجارية' :
                         'Solusi Press Minyak Komersial';
const relatedSol2Desc = currentLocale === 'fr' ? 'Solutions de pressage d\'huile évolutives pour les installations de production commerciales.' :
                        currentLocale === 'ar' ? 'حلول ضغط الزيت القابلة للتطوير للمنشآت الإنتاجية التجارية.' :
                        'Solusi press minyak yang dapat diskalakan untuk fasilitas produksi komersial.';
---

<BaseLayout
  locale={currentLocale}
  title={pageTitle}
  description={pageDesc}
  keywords={currentLocale === 'fr' ? ['presse à huile de coco', 'machine huile de coco', 'presse VCO', 'presse huile coco vierge', 'machine extraction huile coco', 'presse hydraulique coco'] : currentLocale === 'ar' ? ['مكينة ضغط زيت جوز الهند', 'مكينة زيت جوز الهند', 'مكينة VCO', 'مكينة ضغط زيت جوز الهند البكر', 'مكينة استخراج زيت جوز الهند', 'مكينة ضغط هيدروليكي جوز الهند'] : ['mesin press minyak kelapa', 'mesin minyak kelapa', 'mesin VCO', 'mesin press kelapa virgin', 'mesin ekstraksi minyak kelapa', 'mesin press hidrolik kelapa']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{heroTitle}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{heroTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl">{heroDesc}</p>
    </div>
  </section>

  <!-- SEO Introduction -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose-solution">
        <p>{seoIntro1}</p>
        <p>{seoIntro2}</p>
      </div>
    </div>
  </section>

  <!-- Products -->
  {seedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{productSectionTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {seedProducts.map(product => (
            <a
              href={localePath(`/products/${product.slug}`)}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title[currentLocale] || product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20coconut%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{currentLocale === 'id' && product.data.modelId ? product.data.modelId : currentLocale === 'fr' && product.data.modelFr ? product.data.modelFr : product.data.model}</div>
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {(currentLocale === 'id' && product.data.specificationsId?.length > 0 ? product.data.specificationsId : currentLocale === 'ar' && product.data.specificationsAr?.length > 0 ? product.data.specificationsAr : currentLocale === 'fr' && product.data.specificationsFr?.length > 0 ? product.data.specificationsFr : product.data.specifications).slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">{faqSectionTitle}</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Solutions -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{relatedTitle}</h2>
