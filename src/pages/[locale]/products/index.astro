﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');

const categoryOrder: Record<string, number> = {
  'hydraulic-oil-press': 1,
  'seed-processing-equipment': 2,
  'roasting-steaming-equipment': 3,
  'filtration-refining-equipment': 4,
};

const hydraulicOrder: Record<string, number> = {
  'mini-hydraulic-oil-press': 1,
  'standard-hydraulic-oil-press': 2,
  'stainless-steel-hydraulic-oil-press': 3,
  'heavy-duty-hydraulic-oil-press': 4,
  'medium-hydraulic-oil-press': 5,
  'cold-press-hydraulic-oil-press': 6,
  'high-pressure-hydraulic-oil-press': 7,
  'ultra-high-pressure-cold-press': 8,
  'ultra-high-pressure-hydraulic-oil-press': 9,
  'sesame-oil-hydraulic-press': 10,
  'coconut-oil-hydraulic-press': 11,
  'large-barrel-hydraulic-oil-press': 12,
  'animal-fat-hydraulic-press': 13,
};

const sortedProducts = allProducts.sort((a, b) => {
  const catA = categoryOrder[a.data.category] ?? 99;
  const catB = categoryOrder[b.data.category] ?? 99;
  if (catA !== catB) return catA - catB;

  if (a.data.category === 'hydraulic-oil-press') {
    const orderA = hydraulicOrder[a.slug] ?? 99;
    const orderB = hydraulicOrder[b.slug] ?? 99;
    if (orderA !== orderB) return orderA - orderB;
  }

  const numA = parseInt(a.data.model.replace(/\D/g, '')) || 0;
  const numB = parseInt(b.data.model.replace(/\D/g, '')) || 0;
  return numA - numB;
});
const allCategories = await getCollection('categories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);

// Localized seeds helper
function getLocalizedSeeds(product: any): string[] {
  if (currentLocale === 'id' && product.data.applicableSeedsId?.length > 0) {
    return product.data.applicableSeedsId;
  }
  if (currentLocale === 'ar' && product.data.applicableSeedsAr?.length > 0) {
    return product.data.applicableSeedsAr;
  }
  if (currentLocale === 'fr' && product.data.applicableSeedsFr?.length > 0) {
    return product.data.applicableSeedsFr;
  }
  return product.data.applicableSeeds;
}

// Localized model helper
function getLocalizedModel(product: any): string {
  if (currentLocale === 'id' && product.data.modelId) {
    return product.data.modelId;
  }
  if (currentLocale === 'fr' && product.data.modelFr) {
    return product.data.modelFr;
  }
  return product.data.model;
}

// Pages that only exist in English (no [locale] version)
// Map to locale fallback pages so French users stay on French pages
const englishOnlyPages: Record<string, string> = {};

function localePath(path: string): string {
  if (currentLocale === 'en') return path;
  // Check if path is an English-only page with a locale fallback
  if (englishOnlyPages[path] !== undefined) {
    const fallback = englishOnlyPages[path];
    return fallback ? `/${currentLocale}${fallback}` : path; // empty string = link to English version
  }
  return `/${currentLocale}${path}`;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.products.title, item: `https://www.hydoilpress.com/${currentLocale}/products` },
  ],
};
---

<BaseLayout locale={currentLocale} title={t.products.title} description={t.products.subtitle} jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.products.title}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.products.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.products.subtitle}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filter -->
        <aside class="lg:w-56 shrink-0">
          <div class="sticky top-24 space-y-8">
            <div>
              <h3 class="font-display text-lg text-charcoal-900 mb-4">{t.products.allCategories}</h3>
              <nav class="space-y-1">
                <a
                  href={localePath('/products')}
                  class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-amber-500 text-charcoal-900"
                >
                  {t.products.allCategories}
                </a>
                {sortedCategories.map(cat => (
                  <a
                    href={localePath(`/products/${cat.slug}`)}
                    class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                  >
                    {cat.data.name[currentLocale] || cat.data.name.en}
                  </a>
                ))}
              </nav>
            </div>

            <div class="pt-6 border-t border-steel-100">
              <nav class="space-y-1">
                <a
                  href={localePath('/hydraulic-oil-press-machine')}
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  <span>{t.common.hydraulicOilPressMachine}</span>
                </a>
                <a
                  href={localePath('/cold-press-oil-machine')}
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <span>{t.common.coldPressOilMachine}</span>
                </a>
                <a
                  href={localePath('/manual-oil-press-machine')}
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m-7.07-3.93l4.24-4.24m5.66-5.66l4.24-4.24M1 12h6m6 0h6m-3.93 7.07l-4.24-4.24m-5.66-5.66L4.93 4.93"/></svg>
                  <span>{t.common.manualOilPressMachine}</span>
                </a>
              </nav>
            </div>

            <div class="pt-6 border-t border-steel-100">
              <a
                href={localePath('/catalog')}
                class="flex items-center gap-3 px-4 py-3 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors group mb-2"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                <div>
                  <div class="text-sm font-semibold">{t.nav.catalog}</div>
                  <div class="text-xs opacity-70">{t.common.browseCatalog}</div>
                </div>
              </a>
              <a
                href={localePath('/products/model-comparison')}
                class="flex items-center gap-3 px-4 py-3 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                <div>
                  <div class="text-sm font-semibold">{t.nav.modelComparison}</div>
                  <div class="text-xs opacity-70">{t.common.compareAllModels}</div>
                </div>
              </a>
            </div>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="flex-1">
          <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {sortedProducts.map((product) => (
              <a
                href={localePath(`/products/${product.slug}`)}
                class="product-card card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden relative">
                  <img
                    src={product.data.images[0]}
                    alt={product.data.title[currentLocale] || product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo%20on%20white%20background%2C%20professional%20product%20photography&image_size=landscape_4_3'"
                  />
                  <div class="absolute inset-0 bg-steel-900/0 group-hover:bg-steel-900/20 transition-colors duration-300 flex items-center justify-center">
                    <span class="bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-medium text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      {t.products.viewDetails}
                    </span>
                  </div>
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{getLocalizedModel(product)}</div>
                  <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
                  <p class="text-sm text-steel-500 mb-3 line-clamp-2">{product.data.description[currentLocale] || product.data.description.en}</p>
                  <div class="flex flex-wrap gap-2 items-center">
                    {getLocalizedSeeds(product).slice(0, 3).map(seed => (
                      <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded-full whitespace-nowrap">
                        {seed}
                      </span>
                    ))}
                    <span class="text-xs text-steel-400">+ more</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
          <div id="load-more-wrap" class="mt-8 text-center hidden">
            <button id="load-more-btn" class="bg-amber-500 hover:bg-amber-400 text-charcoal-900 font-semibold px-8 py-3 rounded-lg transition-colors">
              {currentLocale === 'fr' ? 'Voir plus' : currentLocale === 'ar' ? 'عرض المزيد' : 'Muat Lebih Banyak'}
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment Categories -->
  <section class="py-12 md:py-16 bg-white border-t border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-4 text-charcoal-900">
        {currentLocale === 'fr' ? 'Catégories d\'équipement' : currentLocale === 'ar' ? 'فئات المعدات' : 'Kategori Peralatan'}
      </h2>
      <p class="text-steel-600 mb-8 leading-relaxed">
        {currentLocale === 'fr'
          ? 'Haonuo propose quatre catégories d\'équipement couvrant le workflow complet de pressage d\'huile — de la préparation des graines au pressage puis à la filtration. Chaque catégorie sert une étape spécifique de la ligne de production, et la plupart des opérations ont besoin d\'équipement de deux catégories ou plus pour produire de l\'huile finie.'
          : currentLocale === 'ar'
          ? 'توفر Haonuo أربع فئات من المعدات التي تغطي سير عمل كامل لعصر الزيت — من تحضير البذور مروراً بالعصر وحتى الترشيح. تخدم كل فئة مرحلة محددة في خط الإنتاج، وتحتاج معظم العمليات إلى معدات من فئتين أو أكثر لإنتاج زيت نهائي.'
          : 'Haonuo menyediakan empat kategori peralatan yang mencakup alur kerja pengepresan minyak lengkap — dari persiapan biji hingga pengepresan dan filtrasi. Setiap kategori melayani tahap tertentu dalam jalur produksi, dan sebagian besar operasi memerlukan peralatan dari dua kategori atau lebih untuk menghasilkan minyak jadi.'}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- 1. Seed Processing -->
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center text-amber-600 font-bold text-sm">1</span>
            <h3 class="font-display text-lg text-charcoal-900">
              {currentLocale === 'fr' ? 'Préparation des graines' : currentLocale === 'ar' ? 'معالجة البذور' : 'Pengolahan Biji'}
            </h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed">
            {currentLocale === 'fr'
              ? 'Équipement de nettoyage, décorticage et broyage qui prépare les graines brutes au pressage. Élimine les débris et corps étrangers, augmente la surface d\'extraction de l\'huile et améliore le rendement de 10 à 20 %.'
              : currentLocale === 'ar'
              ? 'معدات التنظيف والتقشير والطحن التي تحضر البذور الخام للعصر. تزيل الحطام والشوائب، تزيد مساحة السطح لاستخلاص الزيت، وتحسن الإنتاج بنسبة 10-20٪.'
              : 'Peralatan pembersihan, pengupasan kulit, dan penghancuran yang mempersiapkan biji mentah untuk pengepresan. Menghilangkan kotoran dan benda asing, meningkatkan luas permukaan untuk ekstraksi minyak, dan meningkatkan hasil sebesar 10-20%.'}
          </p>
          <a href={localePath('/products/seed-processing-equipment')} class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">
            {currentLocale === 'fr' ? 'Voir l\'équipement' : currentLocale === 'ar' ? 'عرض المعدات' : 'Lihat peralatan'}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <!-- 2. Roasting & Steaming -->
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold text-sm">2</span>
            <h3 class="font-display text-lg text-charcoal-900">
              {currentLocale === 'fr' ? 'Torréfaction & Cuisson à la vapeur' : currentLocale === 'ar' ? 'التحميص والبخار' : 'Pemanggangan & Pengukusan'}
            </h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed">
            {currentLocale === 'fr'
              ? 'Application contrôlée de chaleur qui décompose les parois cellulaires, réduit la viscosité de l\'huile et développe la saveur. Augmente le rendement de 5 à 15 % par rapport au pressage de graines non chauffées.'
              : currentLocale === 'ar'
              ? 'تطبيق حراري متحكم يكسر جدران الخلايا، يقلل من لزوجة الزيت ويطور النكهة. يزيد من إنتاج الزيت بنسبة 5-15٪ مقارنة بعصر البذور غير المسخنة.'
              : 'Penerapan panas terkontrol yang memecah dinding sel, mengurangi viskositas minyak, dan mengembangkan rasa. Meningkatkan hasil 5-15% dibanding pengepresan biji yang tidak dipanaskan.'}
          </p>
          <a href={localePath('/products/roasting-steaming-equipment')} class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">
            {currentLocale === 'fr' ? 'Voir l\'équipement' : currentLocale === 'ar' ? 'عرض المعدات' : 'Lihat peralatan'}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <!-- 3. Hydraulic Oil Press -->
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center text-green-600 font-bold text-sm">3</span>
            <h3 class="font-display text-lg text-charcoal-900">
              {currentLocale === 'fr' ? 'Presse à huile hydraulique' : currentLocale === 'ar' ? 'مكبس زيت هيدروليكي' : 'Mesin Press Minyak Hidrolik'}
            </h3>
          </div>
          <p class="text-steel-600 leading-relaxed text-sm">
            {currentLocale === 'fr'
              ? 'Pressage par lots avec rétention de basse température (inférieure à 60 °C). 12 modèles de 300 à 620 tonnes de force de pressage avec une capacité de 100 kg par lot. Idéal pour les graines de haute valeur où la qualité de l\'huile compte plus que le débit.'
              : currentLocale === 'ar'
              ? 'عصر دفعي مع الاحتفاظ بدرجة حرارة منخفضة (أقل من 60 درجة مئوية). 12 نموذجاً من 300 إلى 620 طن من قوة العصر بسعة 100 كجم لكل دفعة. الأفضل للبذور عالية القيمة حيث تكون جودة الزيت أكثر أهمية من الإنتاج.'
              : 'Pengepresan batch dengan retensi suhu rendah (di bawah 60°C). 12 model dari 300 hingga 620 ton gaya pengepres dengan kapasitas 100 kg per batch. Terbaik untuk biji bernilai tinggi di mana kualitas minyak lebih penting daripada throughput.'}
          </p>
          <a href={localePath('/products/hydraulic-oil-press')} class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">
            {currentLocale === 'fr' ? 'Voir l\'équipement' : currentLocale === 'ar' ? 'عرض المعدات' : 'Lihat peralatan'}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <!-- 4. Filtration & Refining -->
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600 font-bold text-sm">4</span>
            <h3 class="font-display text-lg text-charcoal-900">
              {currentLocale === 'fr' ? 'Filtration & Raffinage' : currentLocale === 'ar' ? 'الترشيح والتكرير' : 'Filtrasi & Pemurnian'}
            </h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed">
            {currentLocale === 'fr'
              ? 'Transforme l\'huile pressée brute en produit clair, stable et prêt à la vente. De la filtration de base à 50 microns pour la vente en vrac au raffinage complet pour l\'huile alimentaire de détail.'
              : currentLocale === 'ar'
              ? 'يحول الزيت المعصور الخام إلى منتج صافٍ ومستعد للبيع. من الترشيح الأساسي 50 ميكرون للبيع بالجملة إلى التكرير الكامل لزيت الطعام بالتجزئة.'
              : 'Mengubah minyak hasil pengepresan kasar menjadi produk yang jernih, stabil, dan siap dipasarkan. Dari filtrasi dasar 50 mikron untuk penjualan curah hingga pemurnian lengkap untuk minyak makanan eceran.'}
          </p>
          <a href={localePath('/products/filtration-refining-equipment')} class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">
            {currentLocale === 'fr' ? 'Voir l\'équipement' : currentLocale === 'ar' ? 'عرض المعدات' : 'Lihat peralatan'}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg">
        <p class="text-steel-700">
          <strong>
            {currentLocale === 'fr' ? 'Vous ne savez pas quelle catégorie vous avez besoin ?' : currentLocale === 'ar' ? 'غير متأكد من الفئة التي تحتاجها؟' : 'Tidak yakin kategori mana yang Anda butuhkan?'}
          </strong>
          {currentLocale === 'fr'
            ? ' Si vous commencez de zéro, la plupart des opérations ont besoin d\'équipement des quatre catégories. Pour un aperçu du processus de production complet de la graine à l\'huile en bouteille, consultez notre '
            : currentLocale === 'ar'
            ? ' إذا كنت تبدأ من الصفر، فمعظم العمليات تحتاج إلى معدات من جميع الفئات الأربع. للحصول على نظرة عامة على عملية الإنتاج الكاملة من البذور إلى الزيت المعبأ في زجاجات، راجع '
            : ' Jika Anda memulai dari awal, sebagian besar operasi memerlukan peralatan dari keempat kategori. Untuk gambaran umum proses produksi lengkap dari biji hingga minyak dalam botol, lihat '}
          <a href={localePath('/resources/complete-oil-production-line-guide')} class="text-amber-600 underline hover:text-amber-700">
