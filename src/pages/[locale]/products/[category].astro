                        <td class="px-4 py-3 text-steel-700">{item.desc}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg mb-10">
                <p class="text-steel-700"><strong>{currentLocale === 'fr' ? 'Position dans le processus' : currentLocale === 'ar' ? 'الموضع في العملية' : 'Posisi proses'}:</strong> {catContent.processPosition}</p>
