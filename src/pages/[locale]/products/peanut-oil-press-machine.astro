﻿﻿﻿﻿---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');
const seedProducts = allProducts.filter(p =>
  p.data.applicableSeeds.some(s => s.toLowerCase().includes('peanut'))
).slice(0, 3);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const pageTitle = currentLocale === 'fr' ? 'Presse à Huile d\'Arachide — Presse Hydraulique à Froid pour Huile Premium' :
                  currentLocale === 'ar' ? 'مكينة ضغط زيت الفول السوداني — ضغط هيدروليكي بارد لزيت فاخر' :
                  'Mesin Press Minyak Kacang Tanah — Press Hidrolik Dingin untuk Minyak Premium';

const pageDesc = currentLocale === 'fr' ? 'Presse à huile d\'arachide professionnelle par Haonuo Machinery. Technologie de presse hydraulique à froid pour la production d\'huile d\'arachide premium. Rendement en huile de 40-45%, polyvalence multi-graines. Prix direct d\'usine.' :
                 currentLocale === 'ar' ? 'مكينة ضغط زيت الفول السوداني محترفة من Haonuo Machinery. تقنية الضغط الهيدروليكي البارد لإنتاج زيت فول سوداني فاخر. عائد زيت 40-45%، قدرة متعددة البذور. أسعار مباشرة من المصنع.' :
                 'Mesin press minyak kacang tanah profesional oleh Haonuo Machinery. Teknologi press hidrolik dingin untuk produksi minyak kacang tanah premium. Hasil minyak 40-45%, kemampuan multi-biji. Harga langsung pabrik.';

const heroTitle = currentLocale === 'fr' ? 'Presse à Huile d\'Arachide' :
                  currentLocale === 'ar' ? 'مكينة ضغط زيت الفول السوداني' :
                  'Mesin Press Minyak Kacang Tanah';

const heroDesc = currentLocale === 'fr' ? 'Presse hydraulique à froid pour huile d\'arachide premium — rendement en huile de 40-45%, polyvalence multi-graines, prix direct d\'usine.' :
                 currentLocale === 'ar' ? 'ضغط هيدروليكي بارد لزيت فول سوداني فاخر — عائد زيت 40-45%، قدرة متعددة البذور، أسعار مباشرة من المصنع.' :
                 'Press hidrolik dingin untuk minyak kacang tanah premium — hasil minyak 40-45%, kemampuan multi-biji, harga langsung pabrik.';

const seoIntro1 = currentLocale === 'fr' ? 'L\'huile d\'arachide (aussi appelée huile de groundnut) est une huile de cuisine populaire en Asie, en Afrique et dans les Amériques, valorisée pour son point de fumée élevé, sa saveur riche et ses bienfaits pour la santé, notamment les graisses mono-insaturées bénéfiques pour le cœur et la vitamine E. Produire une huile d\'arachide de haute qualité nécessite une presse à huile d\'arachide fiable capable d\'extraire efficacement l\'huile tout en préservant le goût naturel et les propriétés nutritionnelles. La technologie de presse hydraulique à froid est la méthode privilégiée pour l\'huile d\'arachide premium, appliquant une pression intense sans chaleur excessive pour atteindre des rendements en huile de 40-45%.' :
                  currentLocale === 'ar' ? 'زيت الفول السوداني (المعروف أيضاً بزيت الفول السوداني الأرضي) هو زيت طبخ شائع في آسيا وأفريقيا والأمريكتين، يُقدر لنقطة دخانه العالية ونكهته الغنية وفوائده الصحية بما في ذلك الدهون الأحادية غير المشبعة الصحية للقلب وفيتامين E. إنتاج زيت فول سوداني عالي الجودة يتطلب مكينة ضغط زيت موثوقة يمكنها استخراج الزيت بكفاءة مع الحفاظ على الطعم الطبيعي والخصائص الغذائية. تقنية الضغط الهيدروليكي البارد هي الطريقة المفضلة لزيت الفول السوداني الفاخر، تطبيق ضغط شديد بدون حرارة مفرطة لتحقيق عوائد زيت 40-45%.' :
                  'Minyak kacang tanah (juga dikenal sebagai minyak groundnut) adalah minyak masak populer di Asia, Afrika, dan Amerika, dihargai karena titik asap tinggi, rasa kaya, dan manfaat kesehatan termasuk lemak tak jenuh tunggal yang sehat untuk jantung dan vitamin E. Memproduksi minyak kacang tanah berkualitas tinggi membutuhkan mesin press minyak kacang tanah yang andal yang dapat mengekstraksi minyak secara efisien sambil mempertahankan rasa alami dan sifat nutrisi. Teknologi press hidrolik dingin adalah metode yang disukai untuk minyak kacang tanah premium, menerapkan tekanan intensif tanpa pemanasan berlebihan untuk mencapai hasil minyak 40-45%.';

const seoIntro2 = currentLocale === 'fr' ? 'Les presses à huile d\'arachide de Haonuo Machinery sont conçues pour la polyvalence et la performance. Que vous produisiez de l\'huile d\'arachide pressée à froid à partir d\'arachides crues pour le marché des aliments santé, ou de l\'huile d\'arachide torréfiée pour un usage culinaire, nos presses hydrauliques s\'adaptent facilement aux deux. La même machine peut également traiter le sésame, le colza, le tournesol et plus encore — en faisant un investissement polyvalent pour toute entreprise de production d\'huile. Avec des modèles allant de 50 à 125 kg/h de capacité, Haonuo a la machine adaptée à chaque échelle de production d\'huile d\'arachide.' :
                  currentLocale === 'ar' ? 'مكائن ضغط زيت الفول السوداني من Haonuo Machinery مصممة للتعدد والأداء. سواء كنت تنتج زيت فول سوداني مضغوط بارد من الفول السوداني الخام لسوق الأغذية الصحية، أو زيت فول سوداني محمص للاستخدام الطبخي، مكائننا الهيدروليكية تتعامل مع الاثنين بسهولة. نفس المكينة يمكنها أيضاً معالجة السمسم والكركديه وعباد الشمس والمزيد — مما يجعلها استثماراً متعدد الاستخدامات لأي مشروع إنتاج زيت. مع نماذج تتراوح من 50 إلى 125 كجم/ساعة، Haonuo لديها المكينة المناسبة لكل حجم إنتاج زيت الفول السوداني.' :
                  'Mesin press minyak kacang tanah Haonuo Machinery dirancang untuk keserbagunaan dan performa. Baik Anda memproduksi minyak kacang tanah press dingin dari kacang tanah mentah untuk pasar makanan kesehatan, atau minyak kacang tanah sangrai untuk penggunaan kuliner, press hidrolik kami menangani keduanya dengan mudah. Mesin yang sama juga dapat memproses wijen, rapeseed, bunga matahari, dan banyak lagi — menjadikannya investasi serbaguna untuk bisnis produksi minyak. Dengan model mulai dari 50 hingga 125 kg/jam kapasitas, Haonuo memiliki mesin yang tepat untuk setiap skala produksi minyak kacang tanah.';

const productSectionTitle = currentLocale === 'fr' ? 'Nos Presses à Huile d\'Arachide' :
                           currentLocale === 'ar' ? 'مكائن ضغط زيت الفول السوداني لدينا' :
                           'Mesin Press Minyak Kacang Tanah Kami';

const faqSectionTitle = currentLocale === 'fr' ? 'Foire aux questions' :
                        currentLocale === 'ar' ? 'أسئلة شائعة' :
                        'Pertanyaan yang Sering Diajukan';

const relatedTitle = currentLocale === 'fr' ? 'Solutions Associées' :
                     currentLocale === 'ar' ? 'حلول ذات صلة' :
                     'Solusi Terkait';

const faqs = [
  { question: currentLocale === 'fr' ? 'Quel est le rendement en huile d\'arachide avec une presse hydraulique ?' :
              currentLocale === 'ar' ? 'ما هو عائد زيت الفول السوداني باستخدام مكينة الضغط الهيدروليكي؟' :
              'Berapa hasil minyak kacang tanah menggunakan mesin press hidrolik?',
    answer: currentLocale === 'fr' ? 'Une presse à huile hydraulique peut extraire environ 40-45% d\'huile des arachides. Le rendement exact dépend de la variété d\'arachide, de la teneur en humidité et de si les arachides sont torréfiées avant pressage. Les arachides torréfiées donnent généralement légèrement plus d\'huile avec une saveur plus riche.' :
            currentLocale === 'ar' ? 'مكينة الضغط الهيدروليكي يمكنها استخراج حوالي 40-45% من الزيت من الفول السوداني. العائد الدقيق يعتمد على نوع الفول السوداني ومحتوى الرطوبة وما إذا كان الفول السوداني محمصاً قبل الضغط. الفول السوداني المحمص عادة يعطي زيادة طفيفة في الزيت مع نكهة أغنى.' :
            'Mesin press hidrolik dapat mengekstraksi sekitar 40-45% minyak dari kacang tanah. Hasil tepat tergantung pada varietas kacang tanah, kadar kelembapan, dan apakah kacang tanah disangrai sebelum press. Kacang tanah sangrai biasanya menghasilkan sedikit lebih banyak minyak dengan rasa yang lebih kaya.' },
  { question: currentLocale === 'fr' ? 'Faut-il torréfier les arachides avant pressage ?' :
              currentLocale === 'ar' ? 'هل يجب تحميص الفول السوداني قبل الضغط؟' :
              'Apakah kacang tanah harus disangrai sebelum dipress?',
    answer: currentLocale === 'fr' ? 'La torréfaction des arachides avant pressage améliore la saveur et l\'arôme de l\'huile, et peut légèrement augmenter le rendement en huile. Cependant, pour l\'huile d\'arachide pressée à froid qui conserve une valeur nutritionnelle maximale, les arachides crues peuvent être pressées directement. Le choix dépend de la priorité entre saveur (torréfiée) ou nutrition (pressée à froid).' :
            currentLocale === 'ar' ? 'تحميص الفول السوداني قبل الضغط يعزز النكهة والرائحة للزيت، ويمكن أن يزيد قليلاً من عائد الزيت. لكن، لزيت الفول السوداني المضغوط بارد الذي يحتفظ بأقصى قيمة غذائية، يمكن ضغط الفول السوداني الخام مباشرة. الاختيار يعتمد على ما إذا كنت تعطي الأولوية للنكهة (محمص) أو التغذية (مضغوط بارد).' :
            'Menyangrai kacang tanah sebelum press meningkatkan rasa dan aroma minyak, dan dapat sedikit meningkatkan hasil minyak. Namun, untuk minyak kacang tanah press dingin yang mempertahankan nilai nutrisi maksimal, kacang tanah mentah dapat dipress langsung. Pilihan tergantung pada apakah Anda memprioritaskan rasa (sangrai) atau nutrisi (press dingin).' },
  { question: currentLocale === 'fr' ? 'Quelle est la différence entre huile d\'arachide pressée à froid et torréfiée ?' :
              currentLocale === 'ar' ? 'ما هو الفرق بين زيت الفول السوداني المضغوط بارد والمحمص؟' :
              'Apa perbedaan antara minyak kacang tanah press dingin dan sangrai?',
    answer: currentLocale === 'fr' ? 'L\'huile d\'arachide pressée à froid est extraite à basse température à partir d\'arachides crues, préservant les nutriments, la vitamine E et une saveur d\'arachide douce. L\'huile d\'arachide torréfiée est fabriquée à partir d\'arachides pré-torréfiées, produisant une huile plus foncée avec une saveur plus forte et plus fruitée idéale pour la cuisine. Les deux ont leur marché — le pressage à froid commande une prime pour les consommateurs soucieux de leur santé.' :
            currentLocale === 'ar' ? 'زيت الفول السوداني المضغوط بارد يُستخرج في درجة حرارة منخفضة من الفول السوداني الخام، مع الحفاظ على المغذيات وفيتامين E ونكهة فول سوداني خفيفة. زيت الفول السوداني المحمص يُصنع من فول سوداني محمص مسبقاً، منتجاً زيتاً أغمق بنكهة أقوى وأكثر جوزية مثالية للطبخ. كلاهما له سوقه — الضغط البارد يحصل على علاوة للمستهلكين المهتمين بالصحة.' :
            'Minyak kacang tanah press dingin diekstraksi pada suhu rendah dari kacang tanah mentah, mempertahankan nutrisi, vitamin E, dan rasa kacang tanah yang lembut. Minyak kacang tanah sangrai dibuat dari kacang tanah pra-sangrai, menghasilkan minyak yang lebih gelap dengan rasa lebih kuat dan beraroma kacang ideal untuk memasak. Keduanya memiliki pasarnya — press dingin mendapatkan premium untuk konsumen yang sadar kesehatan.' },
  { question: currentLocale === 'fr' ? 'Combien d\'arachides la machine peut-elle traiter par heure ?' :
              currentLocale === 'ar' ? 'كم فول سوداني يمكن للمكينة معالجته في الساعة؟' :
              'Berapa banyak kacang tanah yang dapat diproses mesin per jam?',
    answer: currentLocale === 'fr' ? 'Selon le modèle, les presses hydrauliques Haonuo peuvent traiter 50 à 125 kg d\'arachides par heure. Le HN325 traite 50 kg/h, le HN355 traite 75 kg/h, le HN426 traite 100 kg/h, et le HN500 traite 125 kg/h. Chaque lot prend environ 10-15 minutes.' :
            currentLocale === 'ar' ? 'حسب النموذج، مكائن الضغط الهيدروليكي Haonuo يمكنها معالجة 50-125 كجم من الفول السوداني في الساعة. HN325 يعالج 50 كجم/ساعة، HN355 يعالج 75 كجم/ساعة، HN426 يعالج 100 كجم/ساعة، وHN500 يعالج 125 كجم/ساعة. كل دفعة تستغرق حوالي 10-15 دقيقة.' :
            'Tergantung modelnya, mesin press hidrolik Haonuo dapat memproses 50-125 kg kacang tanah per jam. HN325 menangani 50 kg/jam, HN355 menangani 75 kg/jam, HN426 menangani 100 kg/jam, dan HN500 menangani 125 kg/jam. Setiap batch membutuhkan sekitar 10-15 menit.' },
  { question: currentLocale === 'fr' ? 'La presse à huile d\'arachide peut-elle aussi traiter d\'autres graines ?' :
              currentLocale === 'ar' ? 'هل يمكن لمكينة ضغط زيت الفول السوداني معالجة بذور أخرى أيضاً؟' :
              'Apakah mesin press minyak kacang tanah juga dapat memproses biji lain?',
    answer: currentLocale === 'fr' ? 'Oui, les presses à huile hydrauliques Haonuo sont des machines polyvalentes qui peuvent traiter une large gamme de graines oléagineuses dont le sésame, le colza, le tournesol, la graine de thé, le lin et plus encore. La même machine peut être utilisée pour différents matériaux avec un ajustement minimal, ce qui en fait un excellent investissement pour les entreprises d\'huile multi-produits.' :
            currentLocale === 'ar' ? 'نعم، مكائن الضغط الهيدروليكي Haonuo هي مكائن متعددة الاستخدامات يمكنها معالجة مجموعة واسعة من البذور الزيتية بما في ذلك السمسم والكركديه وعباد الشمس وبذور الشاي والكتان والمزيد. نفس المكينة يمكن استخدامها لمواد مختلفة مع تعديل بسيط، مما يجعلها استثماراً ممتازاً لمشاريع الزيت متعددة المنتجات.' :
            'Ya, mesin press minyak hidrolik Haonuo adalah mesin serbaguna yang dapat memproses berbagai jenis biji minyak termasuk wijen, rapeseed, bunga matahari, biji teh, biji rami, dan banyak lagi. Mesin yang sama dapat digunakan untuk bahan berbeda dengan penyesuaian minimal, menjadikannya investasi yang sangat baik untuk bisnis minyak multi-produk.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.nav.products, item: `https://www.hydoilpress.com/${currentLocale}/products` },
    { '@type': 'ListItem', position: 3, name: heroTitle, item: `https://www.hydoilpress.com/${currentLocale}/products/peanut-oil-press-machine` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const ctaTitle = currentLocale === 'fr' ? 'Prêt à Démarrer Votre Entreprise d\'Huile d\'Arachide ?' :
                currentLocale === 'ar' ? 'هل أنت مستعد لبدء مشروع زيت الفول السوداني؟' :
                'Siap Memulai Bisnis Minyak Kacang Tanah Anda?';

const ctaDesc = currentLocale === 'fr' ? 'Contactez-nous pour un devis gratuit et une recommandation d\'équipement professionnelle.' :
                currentLocale === 'ar' ? 'اتصل بنا للحصول على عرض أسعار مجاني وتوصية معدات احترافية.' :
                'Hubungi kami untuk penawaran gratis dan rekomendasi peralatan profesional.';

const ctaBtn = currentLocale === 'fr' ? 'Demander un devis gratuit' :
               currentLocale === 'ar' ? 'طلب عرض أسعار مجاني' :
               'Minta Penawaran Gratis';

const relatedSol1Title = currentLocale === 'fr' ? 'Solution de Pressage d\'Huile d\'Arachide' :
                         currentLocale === 'ar' ? 'حل ضغط زيت الفول السوداني' :
                         'Solusi Press Minyak Kacang Tanah';
const relatedSol1Desc = currentLocale === 'fr' ? 'Ligne de production complète d\'huile d\'arachide des arachides brutes à l\'huile premium.' :
                        currentLocale === 'ar' ? 'خط إنتاج زيت الفول السوداني الكامل من الفول السوداني الخام إلى الزيت الفاخر.' :
                        'Lini produksi minyak kacang tanah lengkap dari kacang tanah mentah hingga minyak premium.';
const relatedSol2Title = currentLocale === 'fr' ? 'Solution de Presse à Huile Commerciale' :
                         currentLocale === 'ar' ? 'حل المكينة الضاغطة التجارية' :
                         'Solusi Press Minyak Komersial';
const relatedSol2Desc = currentLocale === 'fr' ? 'Solutions de pressage d\'huile évolutives pour les installations de production commerciales.' :
                        currentLocale === 'ar' ? 'حلول ضغط الزيت القابلة للتطوير للمنشآت الإنتاجية التجارية.' :
                        'Solusi press minyak yang dapat diskalakan untuk fasilitas produksi komersial.';
---

<BaseLayout
  locale={currentLocale}
  title={pageTitle}
  description={pageDesc}
  keywords={currentLocale === 'fr' ? ['presse à huile d\'arachide', 'presse hydraulique arachide', 'presse huile groundnut', 'machine extraction huile arachide', 'huile arachide pressée à froid', 'machine huile arachide'] : currentLocale === 'ar' ? ['مكينة ضغط زيت الفول السوداني', 'مكينة ضغط هيدروليكي فول سوداني', 'مكينة ضغط زيت الفول السوداني الأرضي', 'مكينة استخراج زيت الفول السوداني', 'زيت فول سوداني مضغوط بارد', 'مكينة زيت الفول السوداني'] : ['mesin press minyak kacang tanah', 'mesin press hidrolik kacang tanah', 'mesin press minyak groundnut', 'mesin ekstraksi minyak kacang tanah', 'minyak kacang tanah press dingin', 'mesin minyak kacang tanah']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{heroTitle}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{heroTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl">{heroDesc}</p>
    </div>
  </section>

  <!-- SEO Introduction -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose-solution">
        <p>{seoIntro1}</p>
        <p>{seoIntro2}</p>
      </div>
    </div>
  </section>

  <!-- Products -->
  {seedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{productSectionTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {seedProducts.map(product => (
            <a
              href={localePath(`/products/${product.slug}`)}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title[currentLocale] || product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20peanut%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{currentLocale === 'id' && product.data.modelId ? product.data.modelId : currentLocale === 'fr' && product.data.modelFr ? product.data.modelFr : product.data.model}</div>
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {(currentLocale === 'id' && product.data.specificationsId?.length > 0 ? product.data.specificationsId : currentLocale === 'ar' && product.data.specificationsAr?.length > 0 ? product.data.specificationsAr : currentLocale === 'fr' && product.data.specificationsFr?.length > 0 ? product.data.specificationsFr : product.data.specifications).slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">{faqSectionTitle}</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Solutions -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{relatedTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href={localePath('/solutions/peanut-oil-pressing')} class="card-hover bg-white rounded-2xl p-6 border border-steel-100 group hover:border-amber-300">
          <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">{relatedSol1Title}</h3>
          <p class="text-sm text-steel-600 line-clamp-2">{relatedSol1Desc}</p>
        </a>
        <a href={localePath('/solutions/commercial-oil-press')} class="card-hover bg-white rounded-2xl p-6 border border-steel-100 group hover:border-amber-300">
          <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">{relatedSol2Title}</h3>
          <p class="text-sm text-steel-600 line-clamp-2">{relatedSol2Desc}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">{ctaTitle}</h2>
      <p class="text-steel-300 text-lg mb-8">{ctaDesc}</p>
      <a href={localePath('/contact')} class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        {ctaBtn}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
