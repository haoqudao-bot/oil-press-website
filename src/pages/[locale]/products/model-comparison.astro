                <th class="px-3 py-3 text-left font-semibold">{tr(ui.customColNote)}</th>
                <th class="px-3 py-3 text-center font-semibold">{tr(ui.customColPage)}</th>
              </tr>
            </thead>
            <tbody>
              {customModels.map((m, i) => (
                <tr class={i % 2 === 0 ? 'border-b border-steel-100 bg-steel-50/40' : 'border-b border-steel-100'}>
