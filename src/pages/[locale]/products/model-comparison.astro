              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specSystemPressure)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{localSpec(m.systemPressure)}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specCakePressure)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{localSpec(m.cakePressure)}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specBarrel)}</td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center text-steel-700">
                    {m.barrelDiameter === 'On request'
                      ? localSpec('On request')
                      : `${localSpec(m.barrelDiameter)} × ${localSpec(m.barrelHeight)}`}
                  </td>
                ))}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specMotor)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{localSpec(m.motorPower)}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specWeight)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{localSpec(m.weight)}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specDimensions)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700 text-xs">{localSpec(m.dimensions)}</td>)}
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specTopSeeds)}</td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <div class="flex flex-wrap gap-1 justify-center">
                      {m.seeds.slice(0, 3).map(seed => (
                        <span class="text-xs bg-green-50 text-green-700 px-1.5 py-0.5 rounded">{seedNames[seed]?.[currentLocale] || seedNames[seed]?.en || seed}</span>
                      ))}
                      {m.seeds.length > 3 && <span class="text-xs text-steel-400">+{m.seeds.length - 3}</span>}
                    </div>
