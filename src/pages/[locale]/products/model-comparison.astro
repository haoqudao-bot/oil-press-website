                ))}
              </tr>
            </tbody>
            <tfoot>
              <tr class="bg-steel-50">
                <td class="px-4 py-3"></td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <a href={localePath(`/products/${m.slug}/`)} class="inline-flex items-center text-xs font-semibold text-amber-600 hover:text-amber-700">
                      {tr(ui.specViewSpecs)}
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                  </td>
                ))}
              </tr>
            </tfoot>
          </table>
        </div>
      </details>
      <p class="text-xs text-steel-500 mt-4 leading-relaxed">{tr(ui.specFootnote)}</p>

      <!-- Specialized & custom models -->
      <div class="mt-12">
        <div class="text-center mb-8">
          <div class="inline-block text-xs font-bold tracking-widest text-steel-500 bg-steel-100 px-3 py-1 rounded-full mb-3">{tr(ui.customBadge)}</div>
          <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">{tr(ui.customTitle)}</h2>
