  id: 'Perbandingan Model Penekan Minyak Hidrolik | Haonuo Machinery',
};

const pageDescription = {
  en: 'Compare all Haonuo hydraulic oil press models side by side. Pick by seed type or scenario — find your model instantly. HN300 to HN500 plus sesame, coconut, sludge specialists.',
  fr: 'Comparez tous les modèles de presse à huile hydraulique Haonuo côte à côte. Choisissez par type de graine ou scénario — trouvez votre modèle instantanément. HN300 à HN500 plus sésame, coco, boue.',
  ar: 'قارن جميع نماذج معاصر الزيت الهيدروليكي Haonuo جنباً إلى جنب. اختر حسب نوع البذور أو السيناريو — اعثر على نموذجك فوراً. HN300 إلى HN500 بالإضافة إلى سمسم، جوز هند، حمأة.',
  id: 'Bandingkan semua model penekan minyak hidrolik Haonuo berdampingan. Pilih berdasarkan jenis biji atau skenario — temukan model Anda secara instan. HN300 hingga HN500 plus wijen, kelapa, lumpur.',
};

const pageKeywords = {
  en: ['oil press model comparison', 'hydraulic oil press comparison', 'HN325 vs HN426', 'oil press by seed type', 'cold press model guide', 'coconut oil press machine'],
  fr: ['comparaison modèle presse à huile', 'comparaison presse hydraulique', 'HN325 vs HN426', 'presse à huile par type de graine', 'guide modèle pressage à froid', 'machine presse huile de coco'],
  ar: ['مقارنة نموذج معصرة زيت', 'مقارنة معصرة هيدروليكية', 'HN325 مقابل HN426', 'معصرة زيت حسب نوع البذور', 'دليل نموذج الضغط البارد', 'آلة عصر زيت جوز الهند'],
  id: ['perbandingan model penekan minyak', 'perbandingan penekan minyak hidrolik', 'HN325 vs HN426', 'penekan minyak berdasarkan jenis biji', 'panduan model cold press', 'mesin penekan minyak kelapa'],
};

function tr(obj: Record<string, string>): string {
  return obj[currentLocale] || obj.en;
}
---

<BaseLayout locale={currentLocale} title={tr(pageTitle)} description={tr(pageDescription)} keywords={pageKeywords[currentLocale] || pageKeywords.en} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-3 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.nav.modelComparison}</span>
      </nav>
    </div>
  </section>

  <!-- ===== HERO ===== -->
  <section class="bg-gradient-to-br from-steel-900 via-steel-800 to-charcoal-900 text-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-4">
          {tr(ui.heroTitle)}
        </h1>
        <p class="text-steel-300 text-lg md:text-xl leading-relaxed">
          {tr(ui.heroSubtitleLead)}<b class="text-amber-400">{tr(ui.heroSubtitleSeed)}</b>{tr(ui.heroSubtitleOr)}<b class="text-amber-400">{tr(ui.heroSubtitleScenario)}</b>{tr(ui.heroSubtitleTail)}
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-6 pt-4">
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">15+</div>
          <div class="text-xs text-steel-300 mt-1">{tr(ui.statYears)}</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">50+</div>
          <div class="text-xs text-steel-300 mt-1">{tr(ui.statCountries)}</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">200+</div>
          <div class="text-xs text-steel-300 mt-1">{tr(ui.statEngineers)}</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">3,000</div>
          <div class="text-xs text-steel-300 mt-1">{tr(ui.statFacility)}</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">2,000+</div>
          <div class="text-xs text-steel-300 mt-1">{tr(ui.statMachines)}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TAB: Seed / Scenario (centered, prominent) ===== -->
  <section class="py-6 md:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center mb-8">
        <div id="sel-tabs" class="inline-flex p-1.5 bg-white rounded-2xl shadow-lg border border-steel-200">
          <button type="button" data-sel-tab="seed" class="sel-tab-btn active px-6 py-3 rounded-xl font-bold text-base bg-amber-500 text-charcoal-900 shadow-md">
            {tr(ui.tabSeed)}
          </button>
          <button type="button" data-sel-tab="scenario" class="sel-tab-btn px-6 py-3 rounded-xl font-bold text-base text-steel-600 hover:text-amber-600 hover:bg-amber-50 transition-colors">
            {tr(ui.tabScenario)}
          </button>
        </div>
      </div>

      <!-- Tab A: Pick by Seed — SEEDS are the HERO -->
      <div id="sel-tab-seed" class="sel-tab-panel">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {seedCards.map(card => (
            <a href={localePath(card.href)} class="relative bg-white border border-steel-100 rounded-2xl p-5 shadow-sm overflow-hidden hover:shadow-lg hover:border-steel-200 transition-all group flex flex-col">
              <span class={`absolute top-0 right-0 text-white text-[0.7rem] font-bold px-3 py-1 rounded-bl-xl ${badgeColors[card.badgeColor]}`}>{tr(card.badge)}</span>
              <!-- Seed chips as HERO -->
              <div class="mb-3">
                <div class="flex flex-wrap gap-1.5">
                  {card.seeds.map(seed => (
                    <span class={`inline-block text-sm font-bold px-2.5 py-1 rounded-lg border ${
                      card.badgeColor === 'amber' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                      card.badgeColor === 'amber-light' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                      card.badgeColor === 'blue' ? 'bg-blue-50 text-blue-700 border-blue-200' :
                      card.badgeColor === 'green' ? 'bg-green-50 text-green-700 border-green-200' :
                      card.badgeColor === 'steel' ? 'bg-steel-100 text-steel-700 border-steel-200' :
                      card.badgeColor === 'purple' ? 'bg-purple-50 text-purple-700 border-purple-200' :
                      card.badgeColor === 'cyan' ? 'bg-cyan-50 text-cyan-700 border-cyan-200' :
                      card.badgeColor === 'orange' ? 'bg-orange-50 text-orange-700 border-orange-200' :
                      'bg-steel-50 text-steel-700 border-steel-200'
                    }`}>{seedNames[seed]?.[currentLocale] || seedNames[seed]?.en || seed}</span>
                  ))}
                </div>
              </div>
              <!-- Model as secondary info -->
              <div class="flex items-center gap-2 mb-3 pb-3 border-b border-steel-100">
                <span class="text-xs text-steel-400">{tr(ui.modelLabel)}</span>
                <span class={`font-bold text-base ${modelAccentColors[card.modelColor]}`}>{card.model}</span>
                <span class="text-xs text-steel-400 ml-auto">{tr(card.seedHint)}</span>
              </div>
              <p class="text-sm text-steel-600 leading-relaxed flex-1">{tr(card.desc)}</p>
              <div class="mt-3 flex items-center text-xs font-semibold text-amber-600 group-hover:text-amber-700 transition-colors">
                {tr(ui.viewDetails)}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Tab B: Pick by Scenario -->
      <div id="sel-tab-scenario" class="sel-tab-panel hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {scenarioCards.map(card => (
            <a href={localePath(card.href)} class="relative bg-white border border-steel-100 rounded-2xl p-5 shadow-sm overflow-hidden hover:shadow-lg transition-all group">
              <span class={`absolute top-0 right-0 text-white text-[0.7rem] font-bold px-3 py-1 rounded-bl-xl ${badgeColors[card.badgeColor]}`}>{tr(card.badge)}</span>
              <div class="text-xs text-steel-500 mb-1">{tr(card.subtitle)}</div>
              <div class={`font-black text-2xl mb-2 ${modelAccentColors[card.modelColor]}`}>
                {card.model}
              </div>
              <p class="text-sm text-steel-600 leading-relaxed">{tr(card.desc)}</p>
              <div class="mt-3 flex items-center text-xs font-semibold text-amber-600 group-hover:text-amber-700 transition-colors">
                {tr(ui.viewDetails)}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== NOTE: One model, many seeds ===== -->
  <section class="py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-green-50 via-white to-blue-50 rounded-2xl p-5 md:p-6 border-2 border-green-200">
        <div class="flex items-start gap-3 md:gap-4">
          <span class="shrink-0 text-2xl md:text-3xl">🫒</span>
          <div>
            <h3 class="font-display text-lg md:text-xl text-charcoal-900 font-bold mb-2">{tr(ui.noteTitle)}</h3>
            <p class="text-steel-700 text-sm md:text-base leading-relaxed mb-3">
              {tr(ui.noteBody)}<a href={localePath('/contact')} class="text-amber-600 font-semibold hover:text-amber-700 underline underline-offset-2">{tr(ui.noteContact)}</a>.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{seedNames.Peanut[currentLocale] || seedNames.Peanut.en}</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{seedNames.Rapeseed[currentLocale] || seedNames.Rapeseed.en}</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{seedNames.Sesame[currentLocale] || seedNames.Sesame.en}</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{seedNames.TeaSeed[currentLocale] || seedNames.TeaSeed.en}</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{seedNames.Walnut[currentLocale] || seedNames.Walnut.en}</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{seedNames.Flaxseed[currentLocale] || seedNames.Flaxseed.en}</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">{tr(ui.notePlusMore)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== QUICK TIPS (selection knowledge, before spec table) ===== -->
  <section class="py-6 md:py-8 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-5">
        <h2 class="font-display text-lg md:text-xl text-charcoal-900 font-bold mb-1">{tr(ui.tipsTitle)}</h2>
        <p class="text-steel-500 text-sm">{tr(ui.tipsSubtitle)}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white border border-amber-200 rounded-xl p-4 flex items-start gap-3 shadow-sm">
          <span class="shrink-0 text-xl">🪣</span>
          <div>
            <h3 class="text-sm font-bold text-amber-700 mb-1">{tr(ui.tip1Title)}</h3>
            <p class="text-xs text-steel-700 leading-relaxed">{tr(ui.tip1Body)}</p>
          </div>
        </div>
        <div class="bg-white border border-blue-200 rounded-xl p-4 flex items-start gap-3 shadow-sm">
          <span class="shrink-0 text-xl">💪</span>
          <div>
            <h3 class="text-sm font-bold text-blue-700 mb-1">{tr(ui.tip2Title)}</h3>
            <p class="text-xs text-steel-700 leading-relaxed">{tr(ui.tip2Body)}</p>
          </div>
        </div>
        <div class="bg-white border border-green-200 rounded-xl p-4 flex items-start gap-3 shadow-sm">
          <span class="shrink-0 text-xl">⚡</span>
          <div>
            <h3 class="text-sm font-bold text-green-700 mb-1">{tr(ui.tip3Title)}</h3>
            <p class="text-xs text-steel-700 leading-relaxed">{tr(ui.tip3Body)}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FULL SPEC TABLE (collapsible) ===== -->
  <section id="full-specs" class="py-10 md:py-14 scroll-mt-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <details class="bg-white rounded-2xl border border-steel-100 shadow-sm group">
        <summary class="flex items-center justify-between cursor-pointer list-none p-6 md:p-8">
          <div>
            <h2 class="font-display text-xl md:text-2xl text-charcoal-900 font-bold">{tr(ui.specTitle)}</h2>
            <p class="text-steel-500 text-sm mt-1">{tr(ui.specSubtitle)}</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-steel-400 group-open:rotate-180 transition-transform shrink-0 ml-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="px-4 md:px-8 pb-8 overflow-x-auto">
          <table class="w-full min-w-[900px] border-collapse bg-white text-sm">
            <thead>
              <tr class="bg-steel-900 text-white">
                <th class="px-4 py-3 text-left font-semibold">{tr(ui.specSpecification)}</th>
                {models.map(m => (
                  <th class={`px-3 py-3 text-center font-semibold whitespace-nowrap ${m.highlight ? 'bg-amber-500' : ''}`}>
                    <div>{m.model}</div>
                    <div class="text-xs font-normal opacity-80">{modelNames[m.model]?.[currentLocale] || modelNames[m.model]?.en}</div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specPressingForce)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700 font-bold text-amber-700">{m.pressingForce}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specSystemPressure)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{m.systemPressure}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specCakePressure)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{m.cakePressure}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specBarrel)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{m.barrelDiameter} × {m.barrelHeight}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specMotor)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{m.motorPower}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specWeight)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700">{m.weight}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specDimensions)}</td>
                {models.map(m => <td class="px-3 py-3 text-center text-steel-700 text-xs">{m.dimensions}</td>)}
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-charcoal-900">{tr(ui.specTopSeeds)}</td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <div class="flex flex-wrap gap-1 justify-center">
                      {m.seeds.slice(0, 3).map(seed => (
                        <span class="text-xs bg-green-50 text-green-700 px-1.5 py-0.5 rounded">{seedNames[seed]?.[currentLocale] || seedNames[seed]?.en || seed}</span>
                      ))}
                      {m.seeds.length > 3 && <span class="text-xs text-steel-400">+{m.seeds.length - 3}</span>}
                    </div>
                  </td>
                ))}
              </tr>
            </tbody>
            <tfoot>
              <tr class="bg-steel-50">
                <td class="px-4 py-3"></td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <a href={localePath(`/products/${m.slug}`)} class="inline-flex items-center text-xs font-semibold text-amber-600 hover:text-amber-700">
                      {tr(ui.specViewSpecs)}
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                  </td>
                ))}
              </tr>
            </tfoot>
          </table>
        </div>
      </details>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold mb-2">{tr(ui.faqTitle)}</h2>
        <p class="text-steel-500">{tr(ui.faqSubtitle)}</p>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="bg-white rounded-xl border border-steel-100 p-5 group shadow-sm">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <h3 class="font-bold text-charcoal-900 text-base">{faq.question[currentLocale] || faq.question.en}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-steel-400 group-open:rotate-180 transition-transform shrink-0 ml-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-steel-600 text-sm leading-relaxed">{faq.answer[currentLocale] || faq.answer.en}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-10 md:py-14 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-charcoal-900 to-steel-800 rounded-3xl p-8 md:p-12 text-center">
        <h2 class="font-display text-2xl md:text-3xl text-white font-bold mb-3">{tr(ui.ctaTitle)}</h2>
        <p class="text-steel-300 text-base md:text-lg max-w-2xl mx-auto mb-7">
          {tr(ui.ctaBody)}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={localePath('/contact')} class="inline-flex items-center justify-center px-7 py-3.5 bg-amber-500 text-charcoal-900 font-bold rounded-xl hover:bg-amber-400 transition-colors">
            {tr(ui.ctaQuote)}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="mailto:sale@hydoilpress.com" class="inline-flex items-center justify-center px-7 py-3.5 bg-white/10 text-white font-bold rounded-xl hover:bg-white/20 transition-colors border border-white/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            {tr(ui.ctaEmail)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TAB TOGGLE SCRIPT ===== -->
  <script is:inline>
  (function(){
    var btns = document.querySelectorAll('#sel-tabs .sel-tab-btn');
    var panels = document.querySelectorAll('.sel-tab-panel');
    function showTab(name){
      btns.forEach(function(b){
        if(b.getAttribute('data-sel-tab')===name){
          b.classList.add('active','bg-amber-500','text-charcoal-900','shadow-md');
          b.classList.remove('text-steel-600','hover:text-amber-600','hover:bg-amber-50');
        } else {
          b.classList.remove('active','bg-amber-500','text-charcoal-900','shadow-md');
          b.classList.add('text-steel-600','hover:text-amber-600','hover:bg-amber-50');
        }
      });
      panels.forEach(function(p){
        if(p.id === 'sel-tab-'+name){ p.classList.remove('hidden'); } else { p.classList.add('hidden'); }
      });
    }
    btns.forEach(function(b){ b.addEventListener('click', function(){ showTab(b.getAttribute('data-sel-tab')); }); });
    showTab('seed');
  })();
  </script>

  <!-- ===== MOBILE STICKY CTA BAR ===== -->
  <div class="fixed bottom-0 inset-x-0 z-50 md:hidden bg-white border-t border-steel-200 px-4 py-3 flex gap-2 shadow-lg" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
    <a href={localePath('/contact')} class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-amber-500 text-charcoal-900 font-bold rounded-xl text-sm">
      {tr(ui.mobileQuote)}
    </a>
    <a href="mailto:sale@hydoilpress.com" class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-steel-900 text-white font-bold rounded-xl text-sm">
      {tr(ui.mobileEmail)}
    </a>
  </div>
  <div class="h-16 md:hidden"></div>
</BaseLayout>
