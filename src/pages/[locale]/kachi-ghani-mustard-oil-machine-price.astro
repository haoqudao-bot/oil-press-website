      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {L.factors.map(f => (
          <div class="bg-white rounded-xl p-6 border border-steel-100 hover:shadow-lg hover:border-amber-200 transition-all">
            <div class="text-amber-500 font-bold text-2xl mb-3">{f.num}</div>
            <h3 class="font-bold text-charcoal-900 mb-2">{f.title}</h3>
            <p class="text-steel-600 text-sm leading-relaxed" set:html={richHtml(f.desc)}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Budget Tiers -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">{L.budgetBadge}</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">{L.budgetTitle}</h2>
        <p class="text-steel-500 mt-3">{L.budgetSub}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {L.budget.map(b => (
          <div class="bg-steel-50 rounded-xl p-6 border border-steel-200 hover:border-amber-400 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">{b.emoji}</span>
              <h3 class="font-bold text-charcoal-900 text-lg">{b.label}</h3>
            </div>
            <p class="text-steel-600 text-sm leading-relaxed" set:html={richHtml(b.desc)}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products & Company -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">{L.modelsBadge}</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">{L.modelsTitle}</h2>
        <p class="text-steel-500 mt-3">{L.modelsSub}</p>
      </div>

      <!-- Kachi Ghani HN Model Table -->
      <div class="overflow-x-auto mb-10">
        <table class="w-full text-sm bg-white rounded-xl overflow-hidden border border-steel-200">
          <thead class="bg-amber-900 text-white">
            <tr>
              <th class="px-5 py-3 text-left font-bold">{L.modelsHeader.model}</th>
              <th class="px-5 py-3 text-left font-bold">{L.modelsHeader.tonnage}</th>
              <th class="px-5 py-3 text-left font-bold">{L.modelsHeader.pressure}</th>
              <th class="px-5 py-3 text-left font-bold">{L.modelsHeader.bestFor}</th>
            </tr>
          </thead>
          <tbody>
            {L.hnModels.map((m, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                <td class="px-5 py-3 font-bold text-amber-600">{m.code}</td>
                <td class="px-5 py-3 text-charcoal-900">{m.tonnage}</td>
                <td class="px-5 py-3 text-charcoal-900">{m.pressure}</td>
                <td class="px-5 py-3 text-steel-600">{m.best}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Factory Photos -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/painting-workshop.webp" alt="Haonuo factory painting workshop" class="w-full h-full object-cover">
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/quality-control.webp" alt="Haonuo quality control lab" class="w-full h-full object-cover">
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/warehouse.webp" alt="Haonuo finished machine warehouse" class="w-full h-full object-cover">
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/office-building.webp" alt="Haonuo factory office building" class="w-full h-full object-cover">
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">{L.faqBadge}</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">{L.faqTitle}</h2>
      </div>
      <div class="space-y-3" id="faq-container">
        {L.faqs.map((item, idx) => (
          <div class="faq-item bg-steel-50 rounded-xl border border-steel-200 overflow-hidden">
            <button class="faq-q w-full text-left px-5 py-4 flex items-center justify-between gap-4 hover:bg-white transition-colors" onclick={`toggleFaq(${idx})`}>
              <span class="font-semibold text-charcoal-900 pr-4">{item.q}</span>
              <span class="chev text-amber-500 text-xl font-bold shrink-0 transition-transform duration-200">+</span>
            </button>
            <div class="faq-a hidden px-5 pb-5 text-steel-600 text-sm leading-relaxed bg-white">{item.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inquiry form -->
  <section id="price-form" class="py-14 md:py-20 bg-gradient-to-br from-amber-900 via-steel-900 to-emerald-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div>
          <h2 class="font-display text-3xl md:text-4xl text-white font-bold leading-tight mb-4">
            {L.formTitle}<br>
            <span class="text-amber-400">{L.formTitleAccent}</span>
          </h2>
          <p class="text-steel-300 mb-5 leading-relaxed">
            {L.formP}
          </p>
          <ul class="space-y-2.5 text-steel-200 text-sm mb-6">
            {L.formGuarantee.map(line => (
              <li class="flex items-start gap-2.5"><span class="text-amber-400 mt-0.5 text-base leading-none">✓</span><span set:html={line.html}></span></li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-4 text-xs text-steel-400 mb-4">
            {L.formMeta.map(meta => (
              <span class="flex items-center gap-1.5"><span class="text-amber-400">✓</span>{meta}</span>
            ))}
          </div>
          <p class="text-steel-400 text-xs">{L.formEmailPref} <a href={`mailto:${L.formEmailLabel}`} class="text-amber-400 hover:underline">{L.formEmailLabel}</a> · <span class="text-amber-400">{L.formEmailPhone}</span></p>
        </div>
        <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
          <h3 class="text-charcoal-900 text-xl font-bold mb-1">{L.formSubTitle}</h3>
          <p class="text-steel-500 text-sm mb-5">{L.formSubP}</p>
          <form id="quote-form" action="/api/inquiry" method="POST" class="space-y-3" onsubmit="return submitPriceForm(event)">
            <input type="hidden" name="source" value="Price page inquiry" />
            <input type="text" name="_gotcha" style="display:none" />
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAFIiDuJVsJp4_WlY"></div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.name} <span class="text-red-500">*</span></label>
                <input type="text" name="name" required class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.namePh}>
              </div>
              <div>
                <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.email} <span class="text-red-500">*</span></label>
                <input type="email" name="email" required class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.emailPh}>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.whatsapp} <span class="text-red-500">*</span></label>
              <input type="tel" name="whatsapp" required class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.whatsappPh}>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.capacity}</label>
                <input type="text" name="capacity" class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.capacityPh}>
              </div>
              <div>
                <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.process}</label>
                <input type="text" name="process" class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.processPh}>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.voltage}</label>
                <input type="text" name="voltage" class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.voltagePh}>
              </div>
              <div>
                <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.port}</label>
                <input type="text" name="port" class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20" placeholder={L.form.portPh}>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-steel-700 mb-1">{L.form.message}</label>
              <textarea name="message" rows="2" class="w-full px-3 py-2.5 border border-steel-300 rounded-lg text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 resize-none" placeholder={L.form.messagePh}></textarea>
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold py-3 px-5 rounded-lg text-sm shadow-lg shadow-amber-500/30 transition-all transform hover:-translate-y-0.5">
              {L.form.submit} →
            </button>
            <p class="text-center text-xs text-steel-400">{L.form.noSpam}</p>
          </form>
          <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 text-center text-sm font-semibold mt-3">✗ Failed to send. Please email info@hydoilpress.com directly.</div>
          <div id="form-success" class="hidden bg-green-50 border border-green-200 text-green-700 rounded-lg p-4 text-center text-sm font-semibold mt-3">
            ✓ {L.form.success}
          </div>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
  function toggleFaq(idx) {
    const items = document.querySelectorAll('.faq-item');
    const item = items[idx];
    const answer = item.querySelector('.faq-a');
    const chev = item.querySelector('.chev');
    item.classList.toggle('open');
    answer.classList.toggle('hidden');
    chev.textContent = item.classList.contains('open') ? '×' : '+';
    chev.classList.toggle('rotate-45');
  }
  function submitPriceForm(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type=submit]');
    const btnText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    const formData = new FormData(form);
    const tr = form.querySelector('input[name="cf-turnstile-response"]');
    if (tr) formData.append('cf-turnstile-response', tr.value);

    fetch(form.action, {
      method: 'POST',
      body: formData,
      headers: { 'Accept': 'application/json' }
    })
    .then(r => {
      if (r.ok) {
        form.reset();
        form.classList.add('hidden');
        document.getElementById('form-success').classList.remove('hidden');
      } else throw new Error('fail');
    })
    .catch(() => {
      form.classList.add('hidden');
      document.getElementById('form-error').classList.remove('hidden');
    })
    .finally(() => {
      btn.disabled = false;
      btn.textContent = btnText;
    });
    return false;
  }
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
