    dualP1: "Press hidrolik Haonuo tidak terkunci hanya untuk press dingin. Mesin yang sama menjalankan **press dingin** (biji mentah, di bawah 60°C) untuk minyak premium dan **press panas** (biji sangrai/kukus) untuk hasil lebih tinggi — Anda beralih lewat cara menyiapkan biji, bukan membeli mesin lain.",
    dualP2: "Inilah keunggulan utama tekanan hidrolik statis: tidak ada panas gesekan dari sekrup, sehingga suhu minyak ditentukan oleh persiapan biji Anda. Produksi minyak cold-press premium hari ini dan minyak panas curah besok pada peralatan yang sama. Untuk press panas, pasangkan press dengan roaster atau steamer terpisah — press itu sendiri tidak memiliki pemanas bawaan.",
    profitTitle: "Apakah press dingin lebih menguntungkan?",
    profitIntro: "Press dingin biasanya memberi **hasil minyak 5–8% lebih rendah** dibanding press panas, tetapi minyaknya terjual dengan **harga premium**. Apakah menguntungkan tergantung pasar, jenis minyak, dan kesenjangan harga yang benar-benar bisa Anda capai.",
    chips: [
      "Hingga 100 kg biji per barrel per siklus — ukuran batch komersial",
      "Siklus dingin hingga ~2 jam vs 30–40 menit panas",
      "Premium khas 30–80% — verifikasi di pasar lokal Anda"],
    winsTitle: "Kapan press dingin menang",
    wins: [
      "Pasar premium / organik / kosmetik (VCO, kenari, argan, wijen).",
      "Jika minyak cold-press mendapat premium harga yang jelas dan pasti di atas minyak refined.",
      "Jika premium per liter melebihi nilai hasil tambahan press panas — kesenjangan margin ini, bukan ukuran batch, yang jadi faktor penentu."],
    hotTitle: "Kapan press panas masuk akal",
    hot: [
      "Minyak goreng curah di mana volume dan biaya rendah paling penting.",
      "Pasokan kontinu volume tinggi ke distributor atau refinery.",
      "Biji di mana penyangraian awal meningkatkan hasil secara nyata dan pasar Anda tidak membayar premium cold-press."],
    roiLink: "Hitung estimasi keuntungan Anda dengan kalkulator ROI",
    matBadge: "PILIH BERDASARKAN BAHAN",
    matTitle: "Mesin press dingin mana untuk biji Anda?",
    matIntro: "Dalam press dingin, **kekerasan bahan menentukan mesinnya**: semakin keras biji atau kacang, semakin tinggi tekanan cake yang dibutuhkan. Setiap press hidrolik Haonuo bisa press dingin — pilih kelas tekanan yang cocok dengan bahan Anda.",
    materials: [
      {
        tag: "Biji lunak",
        title: "Biji minyak lunak",
        seeds: "Wijen · kacang tanah · bunga matahari · kanola · kedelai",
        pressure: "325–365 ton · tekanan cake standar",
        desc: "Minyak wijen dan kacang tanah cold-press laku kuat di pasar Timur Tengah dan Asia. HN325 adalah terlaris level pemula; HN365 menambah stasiun ganda untuk batch sepanjang hari.",
        models: [
          { name: "HN325", href: "/products/standard-hydraulic-oil-press/", note: "terlaris" },
          { name: "HN365", href: "/products/commercial-hydraulic-oil-press/", note: "stasiun ganda" }],
      },
      {
        tag: "Kacang premium",
        title: "Biji setengah keras & kacang pohon",
        seeds: "Kenari · almond · kamelia / biji teh · biji rami · perilla · biji aprikot · biji labu",
        pressure: "500–600 ton · tekanan cake 42–48 MPa",
        desc: "Di sinilah press dingin mendapatkan marginnya — minyak bernilai tinggi yang sensitif. Tekanan cake 42 MPa+ memecah sel keras tanpa panas, menjaga omega-3 dan rasa.",
        models: [
          { name: "HN426", href: "/products/cold-press-hydraulic-oil-press/", note: "unggulan press dingin" }],
      },
      {
        tag: "Keras / bercangkang",
        title: "Bahan keras, bercangkang & berserat",
        seeds: "Kopra untuk VCO · kenari bercangkang · rumput teki · shea · yellowhorn · rami",
        pressure: "620 ton · hingga 75 MPa",
        desc: "Bahan terkeras membutuhkan gaya tertinggi dalam rentang. HN500 mengekstraksi minyak maksimum dalam lebih sedikit lintasan — termasuk kacang yang dipress bercangkang.",
        models: [
{ name: "HN500", href: "/products/ultra-high-pressure-hydraulic-oil-press/", note: "620 t, flagship" }],
      }],
    ssBold: "Press basah santan, atau butuh baja nirkarat food-grade penuh untuk ekspor?",
    ssSee: "Lihat model baja nirkarat 304",
    ssAnd: "dan",
    rangeTitle: "Rentang gaya HN300–HN500",
    rangeSub: "Biji lebih keras atau bercangkang → butuh tekanan cake lebih tinggi. Klik model untuk membuka halamannya.",
    compareAll: "Bandingkan semua model — matriks lengkap",
    oilsSub: "Hasil khas pada biji bergradasi kadar air 6–8%. Hasil aktual bervariasi menurut varietas, persiapan, dan pengaturan siklus.",
    vsTitle: "Cold press vs hot press — perbandingan cepat",
  },
};

const L = ui[currentLocale];

const richHtml = (s: string, cls = 'text-charcoal-900') =>
  s.replace(/\*\*(.+?)\*\*/g, `<b class="${cls}">$1</b>`);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.nav.products, item: `https://www.hydoilpress.com/${currentLocale}/products` },
    { '@type': 'ListItem', position: 3, name: t.common.coldPressOilMachine, item: `https://www.hydoilpress.com/${currentLocale}/cold-press-oil-machine` }],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.coldPress.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const rangeModels = [
  { model: 'HN300', force: '300 t', pressure: '25 MPa', href: '/products/mini-hydraulic-oil-press/' },
  { model: 'HN325', force: '325 t', pressure: '27 MPa', href: '/products/standard-hydraulic-oil-press/' },
  { model: 'HN365', force: '365 t', pressure: '30 MPa', href: '/products/commercial-hydraulic-oil-press/' },
  { model: 'HN426', force: '500 t', pressure: '42 MPa', href: '/products/cold-press-hydraulic-oil-press/' },
  { model: 'HN500', force: '620 t', pressure: '52 MPa', href: '/products/ultra-high-pressure-hydraulic-oil-press/' },
];
---

<BaseLayout
  locale={currentLocale}
  title={pageTitle}
  description={pageDesc}
  keywords={currentLocale === 'fr' ? ['presse à huile à froid', 'machine presse à froid', 'pression à froid huile', 'extraction huile à froid', 'machine huile presse à froid'] : currentLocale === 'ar' ? ['مكينة عصر الزيت على البارد', 'مكينة ضغط بارد', 'عصر الزيت البارد', 'استخراج الزيت بالضغط البارد', 'مكينة زيت ضغط بارد'] : ['mesin press minyak dingin', 'cold press', 'press dingin minyak', 'mesin ekstraksi minyak dingin', 'mesin minyak cold press']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products/')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.common.coldPressOilMachine}</span>
      </nav>
    </div>
  </section>

  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.coldPress.heroTitle}</h1>
        <p class="text-steel-300 text-lg max-w-3xl mb-8">{t.coldPress.heroDesc}</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={localePath('/contact/')} class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
            {t.coldPress.requestQuote}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href={localePath('/resources/cold-press-vs-hot-press-oil/')} class="inline-flex items-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors text-lg">
            {t.coldPress.learnHow}
          </a>
        </div>
      </div>
      <div class="relative">
        <picture class="block overflow-hidden rounded-2xl shadow-2xl">
          <img src="/images/products/commercial-hydraulic-oil-press.webp" alt="Haonuo commercial hydraulic oil press — cold pressing below 60°C for premium oil" class="w-full h-full object-cover" loading="eager" width="800" height="600">
        </picture>
        <div class="absolute -bottom-4 -right-4 bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-display font-semibold text-sm shadow-lg">No chemicals · no solvents · no screw friction</div>
      </div>
    </div>
  </section>

  <!-- What is cold pressing -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-4">{L.badge}</span>
          <h2 class="font-display text-3xl md:text-4xl text-charcoal-900 mb-4">{L.coldTitle}</h2>
          <p class="text-steel-600 leading-relaxed mb-4" set:html={richHtml(L.p1)}></p>
          <p class="text-steel-600 leading-relaxed mb-4" set:html={richHtml(L.p2)}></p>
          <p class="text-steel-600 leading-relaxed" set:html={richHtml(L.p3)}></p>
        </div>
        <div class="bg-steel-50 rounded-2xl border border-steel-100 overflow-hidden">
          <div class="bg-steel-900 px-6 py-4">
            <h3 class="font-display text-lg text-white">{L.factsTitle}</h3>
          </div>
          <dl class="divide-y divide-steel-100">
            {L.facts.map(f => (
              <div class="flex items-center justify-between px-6 py-3.5">
                <dt class="text-steel-500 text-sm">{f.label}</dt>
                <dd class="text-charcoal-900 font-semibold text-sm text-right">{f.value}</dd>
              </div>
            ))}
          </dl>
          <div class="px-6 py-4 bg-amber-50">
            <p class="text-xs text-amber-800">{L.factsNote}</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        {L.cards.map((card, i) => (
          <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
            <div class="text-2xl mb-3">{i === 0 ? '\u{1F33E}' : i === 1 ? '\u{1F4B0}' : '\u{1F9EA}'}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{card.title}</h3>
            <p class="text-steel-600 text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- One machine, cold AND hot -->
  <section class="py-12 md:py-16 bg-steel-50 border-y border-steel-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-steel-900 to-charcoal-900 rounded-3xl p-8 md:p-12 grid grid-cols-1 lg:grid-cols-5 gap-10 items-center">
        <div class="lg:col-span-3 text-center lg:text-left">
          <div class="text-4xl mb-4">&#9889;</div>
          <h2 class="font-display text-3xl md:text-4xl text-white mb-4">{L.dualTitle}</h2>
          <p class="text-steel-300 text-lg max-w-3xl mx-auto lg:mx-0 mb-6" set:html={richHtml(L.dualP1, 'text-white')}></p>
          <p class="text-steel-400 text-sm max-w-2xl mx-auto lg:mx-0">{L.dualP2}</p>
        </div>
        <div class="lg:col-span-2">
          <picture class="block overflow-hidden rounded-2xl shadow-xl">
            <img src="/images/products/cold-press-hydraulic-oil-press.webp" alt="Haonuo cold press hydraulic oil press — same machine switches between raw and roasted seed" class="w-full h-full object-cover" loading="lazy" width="600" height="600">
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Profitability -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl md:text-4xl text-charcoal-900 text-center mb-3">{L.profitTitle}</h2>
      <p class="text-center text-steel-600 max-w-3xl mx-auto mb-6" set:html={richHtml(L.profitIntro)}></p>
      <div class="flex flex-wrap justify-center gap-3 mb-10 text-sm">
        {L.chips.map(chip => (
          <span class="bg-steel-50 border border-steel-100 text-steel-600 px-4 py-2 rounded-full">{chip}</span>
        ))}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <h3 class="font-display text-xl text-charcoal-900 mb-3">{L.winsTitle}</h3>
          <ul class="text-steel-600 text-sm space-y-2 leading-relaxed">
            {L.wins.map(line => <li>{line}</li>)}
          </ul>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <h3 class="font-display text-xl text-charcoal-900 mb-3">{L.hotTitle}</h3>
          <ul class="text-steel-600 text-sm space-y-2 leading-relaxed">
            {L.hot.map(line => <li>{line}</li>)}
          </ul>
        </div>
      </div>
      <p class="text-center mt-8">
        <a href={localePath('/roi-calculator/')} class="inline-flex items-center gap-2 text-amber-600 font-semibold hover:underline">
          {L.roiLink}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </p>
    </div>
  </section>

  <!-- Material gateway + range bar -->
  <section class="py-12 md:py-16 bg-steel-50 border-y border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-4">{L.matBadge}</span>
      <h2 class="font-display text-3xl md:text-4xl text-charcoal-900 mb-3">{L.matTitle}</h2>
      <p class="text-steel-600 max-w-3xl mb-10" set:html={richHtml(L.matIntro)}></p>

      <!-- Model lineup for visual confidence -->
      <div class="mb-10">
        <div class="flex flex-wrap justify-center gap-4 md:gap-6">
          <a href={localePath('/products/standard-hydraulic-oil-press/')} class="group">
            <div class="bg-white rounded-xl overflow-hidden border border-steel-100 w-40 md:w-48">
              <img src="/images/models/hn325.webp" alt="HN325 — 325 ton hydraulic oil press, for soft seeds" class="w-full h-28 md:h-32 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="240">
              <p class="text-xs text-charcoal-900 font-semibold text-center py-2">HN325 · soft seeds</p>
            </div>
          </a>
          <a href={localePath('/products/commercial-hydraulic-oil-press/')} class="group">
            <div class="bg-white rounded-xl overflow-hidden border border-steel-100 w-40 md:w-48">
              <img src="/images/models/hn365.webp" alt="HN365 — 365 ton hydraulic oil press, mid-range cold pressing" class="w-full h-28 md:h-32 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="240">
              <p class="text-xs text-charcoal-900 font-semibold text-center py-2">HN365 · premium seeds</p>
            </div>
          </a>
          <a href={localePath('/products/cold-press-hydraulic-oil-press/')} class="group">
            <div class="bg-white rounded-xl overflow-hidden border border-steel-100 w-40 md:w-48">
              <img src="/images/models/hn426.webp" alt="HN426 — 426 ton hydraulic oil press, commercial capacity" class="w-full h-28 md:h-32 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="240">
              <p class="text-xs text-charcoal-900 font-semibold text-center py-2">HN426 · commercial</p>
            </div>
          </a>
          <a href={localePath('/products/ultra-high-pressure-hydraulic-oil-press/')} class="group">
            <div class="bg-white rounded-xl overflow-hidden border border-steel-100 w-40 md:w-48">
              <img src="/images/models/hn500.webp" alt="HN500 — 500 ton hydraulic oil press, industrial" class="w-full h-28 md:h-32 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="240">
              <p class="text-xs text-charcoal-900 font-semibold text-center py-2">HN500 · industrial</p>
            </div>
          </a>
        </div>
        <p class="text-center text-xs text-steel-500 mt-3">All four models run cold press natively — choose pressure by your seed hardness.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        {L.materials.map(c => (
          <div class="flex flex-col bg-white rounded-2xl p-7 border border-steel-100 hover:border-amber-300 transition-colors">
            <span class="self-start text-xs font-semibold uppercase tracking-wide bg-steel-900 text-white px-3 py-1 rounded-full mb-4">{c.tag}</span>
            <h3 class="font-display text-xl text-charcoal-900 mb-2">{c.title}</h3>
            <p class="text-amber-700 text-sm font-medium mb-1">{c.seeds}</p>
            <p class="text-steel-500 text-sm mb-3">{c.pressure}</p>
            <p class="text-steel-600 text-sm leading-relaxed mb-5">{c.desc}</p>
            <div class="mt-auto flex flex-wrap gap-2">
              {c.models.map(m => (
                <a href={localePath(m.href)} class="inline-flex items-center gap-1.5 bg-steel-50 border border-steel-200 hover:border-amber-400 hover:text-amber-600 text-charcoal-900 text-sm font-semibold px-3.5 py-2 rounded-lg transition-colors">
                  {m.name}
                  <span class="text-xs font-normal text-steel-400">{m.note}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="bg-white border border-dashed border-amber-300 rounded-2xl px-6 py-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <p class="text-steel-600 text-sm">
          <b class="text-charcoal-900">{L.ssBold}</b><br/>
          {L.ssSee}{' '}
          <a href={localePath('/products/coconut-oil-hydraulic-press/')} class="text-amber-600 font-semibold hover:underline">300 Type Coconut</a>.
        </p>
      </div>

      <div class="bg-steel-900 rounded-2xl p-7 md:p-9 mt-8">
        <h3 class="font-display text-xl text-white mb-1">{L.rangeTitle}</h3>
        <p class="text-steel-400 text-sm mb-8">{L.rangeSub}</p>
        <div class="relative">
          <div class="hidden md:block absolute top-[42px] left-6 right-6 h-1 bg-gradient-to-r from-amber-300 via-amber-500 to-amber-600 rounded"></div>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4 relative">
            {rangeModels.map(m => (
              <a href={localePath(m.href)} class="flex md:flex-col items-center gap-3 md:gap-0 group">
                <div class="w-4 h-4 rounded-full bg-amber-500 ring-4 ring-steel-900 shrink-0 md:mb-4 group-hover:scale-125 transition-transform"></div>
                <div class="text-left md:text-center">
                  <div class="text-white font-display font-semibold group-hover:text-amber-400 transition-colors">{m.model}</div>
                  <div class="text-steel-400 text-xs">{m.force}</div>
                  <div class="text-steel-500 text-xs">{m.pressure}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="mt-8 text-center">
          <a href={localePath('/products/model-comparison/')} class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-7 py-3.5 rounded-lg hover:bg-amber-400 transition-colors">
            {L.compareAll}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <p class="text-sm text-steel-500 mt-3">
            {(L.priceHint || 'Cold-press machine pricing')}
            <a href={localePath('/cold-press-oil-machine-price/')} class="text-amber-600 hover:text-amber-500 ml-1">{(L.priceLink || 'see our factory price page')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How cold press works -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.coldPress.howWorksTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-amber-500 text-white flex items-center justify-center text-2xl font-display mx-auto mb-6">1</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-3">{t.coldPress.howWorksStep1.title}</h3>
