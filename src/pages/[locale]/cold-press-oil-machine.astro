  badge: string;
  coldTitle: string;
  p1: string; p2: string; p3: string;
  factsTitle: string;
  facts: { label: string; value: string }[];
  factsNote: string;
  cards: { title: string; desc: string }[];
  dualTitle: string; dualP1: string; dualP2: string;
  profitTitle: string; profitIntro: string;
  chips: string[];
  winsTitle: string; wins: string[];
  hotTitle: string; hot: string[];
  roiLink: string;
  matBadge: string; matTitle: string; matIntro: string;
  materials: {
    tag: string; title: string; seeds: string; pressure: string; desc: string;
    models: { name: string; href: string; note: string }[];
