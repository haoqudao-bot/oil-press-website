---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } },
  ];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');
const coldPressProducts = allProducts.filter(p =>
  p.data.category === 'hydraulic-oil-press' && (
    p.data.title?.en?.toLowerCase().includes('cold press') ||
    p.data.title?.en?.toLowerCase().includes('ultra-high-pressure') ||
    p.data.applicableSeeds?.some(s =>
      s.toLowerCase().includes('coconut') ||
      s.toLowerCase().includes('walnut') ||
      s.toLowerCase().includes('almond') ||
      s.toLowerCase().includes('avocado') ||
      s.toLowerCase().includes('flaxseed') ||
      s.toLowerCase().includes('olive')
    )
  )
).slice(0, 6);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const pageTitle = currentLocale === 'fr' ? 'Presse à Huile à Froid — Préserver la Qualité Naturelle' :
                  currentLocale === 'ar' ? 'مكينة الضغط البارد — الحفاظ على الجودة الطبيعية' :
                  'Mesin Press Minyak Dingin — Pelihara Kualitas Alami';

const pageDesc = currentLocale === 'fr' ? 'Presse à huile à froid professionnelle pour extraction d\'huile premium en dessous de 60°C. Peut aider à préserver plus de nutriments et de saveurs que le pressage à chaud. Directe d\'usine chez Haonuo. Garantie 1 an.' :
                 currentLocale === 'ar' ? 'مكينة ضغط زيت باردة محترفة لاستخراج زيت فاخر تحت 60 درجة مئوية. يمكن أن تساعد في الحفاظ على المزيد من العناصر الغذائية والنكهات مقارنة بالضغط الساخن. مباشرة من المصنع. ضمان سنة واحدة.' :
                 'Mesin press minyak dingin profesional untuk ekstraksi minyak premium di bawah 60°C. Dapat membantu melestarikan lebih banyak nutrisi dan rasa dibanding press panas. Langsung dari pabrik. Garansi 1 tahun.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: t.nav.products, item: `https://www.hydoilpress.com/${currentLocale}/products` },
    { '@type': 'ListItem', position: 3, name: t.common.coldPressOilMachine, item: `https://www.hydoilpress.com/${currentLocale}/cold-press-oil-machine` },
  ],
};

const faqs = [
  { question: currentLocale === 'fr' ? 'Qu\'est-ce qu\'une presse à huile à froid ?' :
              currentLocale === 'ar' ? 'ما هو ماكينة الضغط البارد؟' :
              'Apa itu mesin press minyak dingin?',
    answer: currentLocale === 'fr' ? 'Une presse à huile à froid extrait l\'huile des graines à des températures en dessous de 60°C, aidant à préserver les nutriments naturels, la saveur et l\'arôme de l\'huile. Contrairement aux méthodes de pressage à chaud qui chauffent les graines à 120-180°C, le pressage à froid utilise uniquement la pression hydraulique pour extraire l\'huile, ce qui le rend bien adapté à la production d\'huiles premium non raffinées comme l\'huile de coco vierge, l\'huile de sésame à froid et l\'huile de noix. Les presses à huile à froid Haonuo offrent une extraction de qualité professionnelle. Les rendements du pressage à froid sont généralement légèrement inférieurs à ceux du pressage à chaud mais produisent des huiles de qualité supérieure, vendues à des prix plus élevés.' :
            currentLocale === 'ar' ? 'مكينة الضغط البارد تستخرج الزيت من البذور عند درجات حرارة تحت 60 درجة مئوية، مما يساعد على الحفاظ على العناصر الغذائية الطبيعية والنكهة والرائحة للزيت. على عكس أساليب الضغط الساخن التي تسخن البذور إلى 120-180 درجة مئوية، يستخدم الضغط البارد الضغط الهيدروليكي فقط لاستخراج الزيت، مما يجعله مناسبًا لإنتاج الأزياء الفاخرة غير المرصّحة مثل الجوز الهنديadi البري والسمسم البارد والجوز. مكائن الضغط البارد Haonuo توفر استخراجًا احترافيًا. عائد الضغط البارد عادة ما يكون أقل قليلاً من الضغط الساخن ولكن ينتج أزياء عالية الجودة التي تُباع بأسعار أعلى.' :
            'Mesin press minyak dingin mengekstraksi minyak dari biji pada suhu di bawah 60°C, membantu melestarikan nutrisi alami, rasa, dan aroma minyak. Tidak seperti metode press panas yang memanaskan biji hingga 120-180°C, press dingin hanya menggunakan tekanan hidrolik untuk mengekstraksi minyak, membuatnya cocok untuk produksi minyak premium tidak dimurnikan seperti minyak kelapa virgin, wijen press dingin, dan minyak walnut. Mesin press minyak dingin Haonuo memberikan ekstraksi kualitas profesional. Hasil press dingin biasanya sedikit lebih rendah daripada press panas tetapi menghasilkan minyak berkualitas tinggi yang dijual dengan harga lebih tinggi.' },
  { question: currentLocale === 'fr' ? 'Quelle est la différence entre pressage à froid et pressage à chaud ?' :
              currentLocale === 'ar' ? 'ما هو الفرق بين الضغط البارد والضغط الساخن؟' :
              'Apa perbedaan antara press dingin dan press panas?',
    answer: currentLocale === 'fr' ? 'Le pressage à froid fonctionne en dessous de 60°C en aidant à préserver les nutriments, la saveur naturelle et l\'arôme, tandis que le pressage à chaud chauffe les graines à 120-180°C ce qui augmente le rendement mais peut réduire la qualité de l\'huile. Les huiles à froid sont des produits premium non raffinés qui commandent généralement des prix de marché plus élevés que les huiles raffinées, bien que les primes réelles varient considérablement selon le marché, la région et le type d\'huile. Les huiles à chaud nécessitent un raffinage chimique et conviennent à la production d\'huile de cuisson en vrac. Pour les marchés d\'huile premium et bio, le pressage à froid est souvent préféré.' :
            currentLocale === 'ar' ? 'الضغط البارد يعمل تحت 60 درجة مئوية مع مساعدة في الحفاظ على العناصر الغذائية والنكهة الطبيعية والرائحة، بينما يسخن الضغط الساخن البذور إلى 120-180 درجة مئوية مما يزيد العائد ولكن قد يقلل من جودة الزيت. الأزياء الباردة هي منتجات فاخرة غير مرصّحة التي تُطلب عادةً أسعار سوق أعلى من الأزياء المرصّحة، على الرغم من أن البروتينات الفعلية تختلف بشكل كبير حسب السوق والمنطقة ونوع الزيت. الأزياء الساخنة تحتاج إلى مرصّح كيميائي وتناسب إنتاج زيت الطهي بالجملة. للأسواق الفاخرة والعضوية، غالبًا ما يُفضل الضغط البارد.' :
            'Press dingin beroperasi di bawah 60°C membantu melestarikan nutrisi, rasa alami, dan aroma, sedangkan press panas memanaskan biji hingga 120-180°C yang meningkatkan hasil tetapi dapat mengurangi kualitas minyak. Minyak press dingin adalah produk premium tidak dimurnikan yang biasanya memiliki harga pasar lebih tinggi daripada minyak dimurnikan, meskipun premium aktual dapat bervariasi signifikan sesuai pasar, wilayah, dan jenis minyak. Minyak press panas membutuhkan pemurnian kimia dan cocok untuk produksi minyak goreng massal. Untuk pasar minyak premium dan organik, press dingin seringkali lebih disukai.' },
  { question: currentLocale === 'fr' ? 'Quelles graines peuvent être pressées à froid ?' :
              currentLocale === 'ar' ? 'أي بذور يمكن ضغطها بارداً؟' :
              'Biji apa saja yang dapat dipress dingin?',
    answer: currentLocale === 'fr' ? 'La plupart des graines oléagineuses peuvent être pressées à froid dont le sésame, l\'arachide, le coco, la noix, l\'amande, le tournesol, le lin, la moutarde, le colza, la graine de thé, la noisette et bien plus. Les matériaux à coque dure comme la noix et la noisette bénéficient particulièrement du pressage à froid avec des presses hydrauliques haute pression. Le coco pour le VCO (Virgin Coconut Oil) et le sésame pour l\'huile de cuisson premium sont les huiles à froid les plus populaires dans le monde.' :
            currentLocale === 'ar' ? 'معظم البذور الزيتية يمكن ضغطها بارداً بما في ذلك السمسم والفول السوداني والجوز الهنديadi والجوز واللوز والذرة الصفراء والخس والخردل والكركديهadi وجوز الهند واللوز الصنوبريadi وغيرها. المواد الصلبة مثل الجوز واللوز الصنوبريadi تستفيد بشكل خاص من الضغط البارد مع المكائن الهيدروليكية عالية الضغط. الجوز الهنديadi لجوز الهند البري (VCO) والسمسم لزيت الطهي الفاخر هي الأزياء الباردة الأكثر شيوعًا في العالم.' :
            'Sebagian besar biji minyak dapat dipress dingin termasuk wijen, kacang tanah, kelapa, walnut, almond, bunga matahari, biji rami, sawi, rapeseed, biji teh, apricot kernel, dan banyak lagi. Bahan keras seperti walnut dan apricot kernel terutama mendapat manfaat dari press dingin dengan mesin press hidrolik bertekanan tinggi. Kelapa untuk VCO (Virgin Coconut Oil) dan wijen untuk minyak goreng premium adalah minyak press dingin paling populer di dunia.' },
  { question: currentLocale === 'fr' ? 'L\'huile pressée à froid est-elle meilleure ?' :
              currentLocale === 'ar' ? 'هل الزيت المضغوط بارداً أفضل؟' :
              'Apakah minyak press dingin lebih baik?',
    answer: currentLocale === 'fr' ? 'L\'huile pressée à froid conserve généralement davantage de certains nutriments, de la saveur naturelle et de l\'arôme par rapport aux huiles pressées à chaud ou raffinées. Certains vitamines et antioxydants peuvent être réduits lors du traitement à haute température, bien que le degré varie selon le type d\'huile et la méthode de traitement. Les huiles pressées à froid ne sont pas traitées avec des agents de raffinage chimiques. Cependant, le profil chimique de toute huile dépend de la qualité et de la manipulation de la matière première. Bien que le rendement puisse être légèrement inférieur, la valeur marchande généralement plus élevée des huiles pressées à froid rend le pressage à froid potentiellement plus rentable pour les producteurs ciblant les marchés premium et biologiques, bien que les primes de prix réelles varient considérablement.' :
            currentLocale === 'ar' ? 'زيت الضغط البارد يحتفظ عموماً بمزيد من العناصر الغذائية والنكهة الطبيعية والرائحة مقارنة بالأزياء المضغوطة ساخناً أو المرصّحة. بعض الفيتامينات ومضادات الأكسدة قد تنخفض أثناء المعالجة في درجة حرارة عالية، رغم أن الدرجة تختلف حسب نوع الزيت وطريقة المعالجة. الأزياء المضغوطة بارداً لا تُعالج بعوامل مرصّحة كيميائية. لكن التركيب الكيميائي لأي زيت يعتمد على جودة المواد الخام وطريقة التعامل معها. بينما قد يكون العائد أقل قليلاً، القيمة السوقية الأعلى عادةً للأزياء المضغوطة بارداً تجعل الضغط البارد أكثر ربحية محتملة للمنتجين الذين يستهدفون الأسواق الفاخرة والعضوية، رغم أن العلاوات السعرية الفعلية تختلف بشكل كبير.' :
            'Minyak press dingin umumnya mempertahankan lebih banyak nutrisi tertentu, rasa alami, dan aroma dibandingkan minyak press panas atau dimurnikan. Beberapa vitamin dan antioksidan mungkin berkurang selama pemrosesan suhu tinggi, meskipun tingkatannya bervariasi tergantung jenis minyak dan metode pemrosesan. Minyak press dingin tidak diproses dengan agen pemurnian kimia. Namun, profil kimia minyak apa pun tergantung pada kualitas dan penanganan bahan baku. Meskipun hasilnya mungkin sedikit lebih rendah, nilai pasar yang biasanya lebih tinggi dari minyak press dingin membuat press dingin berpotensi lebih menguntungkan bagi produsen yang menargetkan pasar premium dan organik, meskipun premium harga aktual bervariasi signifikan.' },
  { question: currentLocale === 'fr' ? 'Quel est le rendement d\'une presse à huile à froid ?' :
              currentLocale === 'ar' ? 'ما هو عائد ماكينة الضغط البارد؟' :
              'Berapa hasil mesin press minyak dingin?',
    answer: currentLocale === 'fr' ? 'Le rendement varie selon le type de graine : coco 55-65%, sésame 42-50%, arachide 38-45%, noix 50-60%, tournesol 35-45%, lin 30-38%, colza 35-42%. Les presses hydrauliques à froid Haonuo avec conception de fût rainuré de type barre atteignent environ 2-3% de rendement supérieur aux presses traditionnelles à fût percé (selon nos tests internes, les résultats varient), minimisant l\'écart de rendement entre les méthodes de pressage à froid et à chaud.' :
            currentLocale === 'ar' ? 'يختلف العائد حسب نوع البذرة: جوز هندادى 55-65%، سمسم 42-50%، فول سوداني 38-45%، جوز 50-60%، دوار الشمس 35-45%، كتان 30-38%، كرنب 35-42%. مكائن الضغط البارد الهيدروليكية Haonuo بتصميم البرميل المقطر من نوع القضبان تحقق حوالي 2-3% عائد أعلى من المكائن الضاغطة التقليدية بالبرميل المثقوب (حسب اختباراتنا الداخلية، النتائج تختلف)، مما يقلل الفجوة في العائد بين طريقتي الضغط البارد والساخن.' :
            'Hasil bervariasi tergantung jenis biji: kelapa 55-65%, wijen 42-50%, kacang tanah 38-45%, walnut 50-60%, bunga matahari 35-45%, biji rami 30-38%, rapeseed 35-42%. Mesin press dingin hidrolik Haonuo dengan desain barrel beralur tipe batang mencapai hasil sekitar 2-3% lebih tinggi daripada press konvensional dengan barrel bolong (berdasarkan pengujian internal, hasil dapat bervariasi), meminimalkan kesenjangan hasil antara metode press dingin dan press panas.' },
  { question: currentLocale === 'fr' ? 'Combien coûte une presse à huile à froid ?' :
              currentLocale === 'ar' ? 'كم تكلفة ماكينة الضغط البارد؟' :
              'Berapa harga mesin press minyak dingin?',
    answer: currentLocale === 'fr' ? 'Contactez Haonuo pour un prix d\'usine direct. Nos presses à huile à froid hydrauliques sont disponibles en plusieurs modèles (HN325, HN355, HN426, HN500) avec des capacités de 50 à 125 kg/h. En tant que fabricant direct, nous proposons des tarifs compétitifs sans majoration d\'intermédiaire. Toutes les machines incluent une garantie de 1 an, un support technique à vie et une personnalisation gratuite de la tension pour votre alimentation locale.' :
            currentLocale === 'ar' ? 'اتصل بـ Haonuo للحصول على أسعار مصنع مباشرة. مكائن الضغط البارد الهيدروليكية متوفرة في عدة موديلات (HN325, HN355, HN426, HN500) بقدرات من 50 إلى 125 كجم/ساعة. كمصنع مباشر، نقدم أسعاراً تنافسية بدون ربح وسيط. جميع الماكينات تتضمن ضمان سنة واحدة، دعم فني مدى الحياة، وتخصيص مجاني للجهد حسب مصدر الطاقة المحلي.' :
            'Hubungi Haonuo untuk harga pabrik langsung. Mesin press dingin hidrolik kami tersedia dalam beberapa model (HN325, HN355, HN426, HN500) dengan kapasitas 50 hingga 125 kg/jam. Sebagai pabrik langsung, kami menawarkan harga kompetitif tanpa markup perantara. Semua mesin termasuk garansi 1 tahun, dukungan teknis seumur hidup, dan penyesuaian tegangan gratis untuk pasokan daya lokal Anda.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  locale={currentLocale}
  title={pageTitle}
  description={pageDesc}
  keywords={currentLocale === 'fr' ? ['presse à huile à froid', 'machine pressage à froid', 'prix presse à huile à froid', 'machine huile pressée à froid'] : currentLocale === 'ar' ? ['مكينة ضغط زيت بارد', 'مكينة ضغط بارد', 'سعر مكينة الضغط البارد', 'مكينة زيت مضغوط بارد'] : ['mesin press minyak dingin', 'mesin press dingin', 'harga mesin press minyak dingin', 'mesin minyak press dingin']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/products')} class="hover:text-amber-500 transition-colors">{t.nav.products}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{t.common.coldPressOilMachine}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{pageTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl mb-8">{pageDesc}</p>
      <div class="flex flex-wrap gap-4">
        <a href={localePath('/contact')} class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          {currentLocale === 'fr' ? 'Demander un devis' : currentLocale === 'ar' ? 'طلب عرض أسعار' : 'Minta Penawaran'}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={localePath('/resources/does-cold-pressing-make-difference')} class="inline-flex items-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors text-lg">
          {currentLocale === 'fr' ? 'Apprendre comment fonctionne le pressage à froid' : currentLocale === 'ar' ? 'تعلم كيف يعمل الضغط البارد' : 'Pelajari Cara Kerja Press Dingin'}
        </a>
      </div>
    </div>
  </section>

  <!-- Why Cold Press Matters -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{currentLocale === 'fr' ? 'Pourquoi le Pressage à Froid Est Important' : currentLocale === 'ar' ? 'لماذا الضغط البارد مهم' : 'Mengapa Press Dingin Penting'}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-steel-50 rounded-2xl p-8 border border-steel-100">
          <div class="text-3xl mb-4">&#127793;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-3">{currentLocale === 'fr' ? 'Conservation des Nutriments' : currentLocale === 'ar' ? 'حفظ العناصر الغذائية' : 'Pelestarian Nutrisi'}</h3>
          <p class="text-steel-600 leading-relaxed">{currentLocale === 'fr' ? 'Le pressage à froid en dessous de 60°C aide à conserver les vitamines, antioxydants et acides gras essentiels qui peuvent être perdus lors du pressage à chaud. Vos clients obtiennent de l\'huile à froid de qualité premium.' : currentLocale === 'ar' ? 'الضغط البارد تحت 60 درجة مئوية يساعد على الحفاظ على الفيتامينات ومضادات الأكسدة والأحماض الدهنية الأساسية التي قد تضيع أثناء الضغط الساخن. عملاؤكم يحصلون على زيت بارد عالي الجودة.' : 'Press dingin di bawah 60°C membantu melestarikan vitamin, antioksidan, dan asam lemak esensial yang mungkin hilang selama press panas. Pelanggan Anda mendapatkan minyak press dingin berkualitas premium.'}</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-8 border border-steel-100">
          <div class="text-3xl mb-4">&#128067;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-3">{currentLocale === 'fr' ? 'Saveur & Aroma Naturels' : currentLocale === 'ar' ? 'نكهة و رائحة طبيعية' : 'Rasa & Aroma Alami'}</h3>
          <p class="text-steel-600 leading-relaxed">{currentLocale === 'fr' ? 'Pas de chauffage signifie que l\'huile conserve son goût original — essentiel pour les marchés premium et bio. Le sésame reste noisette, le coco reste parfumé, la noix reste riche.' : currentLocale === 'ar' ? 'لا توجد حرارة تعني أن الزيت يحتفظ بنكهته الأصلية — أساسي للسوق الفاخر والعضوية. السمسم يبقى حامض، الجوز الهنديadi يبقى عطراً، الجوز يبقى غنياً.' : 'Tidak ada pemanasan berarti minyak tetap mempertahankan rasa aslinya — penting untuk pasar premium dan organik. Wijen tetap beraroma kacang, kelapa tetap harum, walnut tetap kaya.'}</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-8 border border-steel-100">
          <div class="text-3xl mb-4">&#128142;</div>
