---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'fr' } },
    { params: { locale: 'ar' } },
    { params: { locale: 'id' } }];
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

function localePath(path: string): string {
  return `/${currentLocale}${path}`;
}

const pageTitle = currentLocale === 'fr' ? 'Presse à Huile à Froid — Pressage Froid et Chaud en Une Machine' :
                  currentLocale === 'ar' ? 'مكبس عصر الزيت البارد — عصر بارد وساخن على نفس الماكينة' :
                  'Mesin Press Minyak Dingin — Press Dingin & Panas di Satu Mesin';

const pageDesc = currentLocale === 'fr' ? 'Presse à huile à froid pour une huile premium en dessous de 60°C. La même presse hydraulique Haonuo fait du pressage à froid et à chaud. Directe d\'usine, garantie 1 an, test de charge 48 h.' :
                 currentLocale === 'ar' ? 'مكبس عصر زيت بارد لزيت ممتاز بدرجة حرارة أقل من 60°م. نفس المكبس الهيدروليكي من هاونو يعمل للعصر البارد والساخن. بيع مباشر من المصنع، ضمان سنة، اختبار حمل 48 ساعة.' :
                 'Mesin press minyak dingin untuk minyak premium di bawah 60°C. Mesin hidrolik Haonuo yang sama bisa press dingin DAN panas. Langsung pabrik, garansi 1 tahun, uji beban 48 jam.';

