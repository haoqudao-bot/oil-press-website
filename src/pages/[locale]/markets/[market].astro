---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';
import { enMarketData } from '../../../data/en-market-data';
import { frMarketData } from '../../../data/fr-market-data';
import { arMarketData } from '../../../data/ar-market-data';
import { idMarketData } from '../../../data/id-market-data';
import { getMarketProducts } from '../../../data/market-products';
import MarketPageContent from '../../../components/markets/MarketPageContent.astro';

// Seed keywords for product filtering per market (same across locales)
const marketSeedKeywords: Record<string, string[]> = {
  nigeria: ['peanut', 'palm kernel', 'cottonseed', 'sesame', 'shea'],
  india: ['mustard', 'sesame', 'peanut', 'coconut', 'sunflower'],
  indonesia: ['coconut', 'palm kernel', 'peanut'],
  pakistan: ['sesame', 'mustard', 'peanut', 'cottonseed', 'sunflower'],
  philippines: ['coconut', 'peanut', 'sesame', 'sunflower', 'moringa'],
  egypt: ['sesame', 'olive', 'peanut', 'sunflower'],
  'south-africa': ['sunflower', 'peanut', 'soybean', 'canola', 'rapeseed'],
  kenya: ['sunflower', 'peanut', 'sesame', 'cottonseed'],
  uk: ['rapeseed', 'canola', 'sunflower', 'hemp', 'flaxseed', 'linseed'],
  usa: ['sunflower', 'peanut', 'hemp', 'almond'],
  'middle-east': ['sesame', 'walnut', 'olive', 'almond'],
};

const marketNameMap: Record<string, Record<string, string>> = {
  nigeria: { en: 'Nigeria', fr: 'Nigéria', ar: 'نيجيريا', id: 'Nigeria' },
  india: { en: 'India', fr: 'Inde', ar: 'الهند', id: 'India' },
  indonesia: { en: 'Indonesia', fr: 'Indonésie', ar: 'إندونيسيا', id: 'Indonesia' },
  pakistan: { en: 'Pakistan', fr: 'Pakistan', ar: 'باكستان', id: 'Pakistan' },
  philippines: { en: 'Philippines', fr: 'Philippines', ar: 'الفلبين', id: 'Filipina' },
  egypt: { en: 'Egypt', fr: 'Égypte', ar: 'مصر', id: 'Mesir' },
  'south-africa': { en: 'South Africa', fr: 'Afrique du Sud', ar: 'جنوب أفريقيا', id: 'Afrika Selatan' },
  kenya: { en: 'Kenya', fr: 'Kenya', ar: 'كينيا', id: 'Kenya' },
  uk: { en: 'UK', fr: 'Royaume-Uni', ar: 'المملكة المتحدة', id: 'Inggris' },
  usa: { en: 'USA', fr: 'États-Unis', ar: 'الولايات المتحدة', id: 'Amerika Serikat' },
  'middle-east': { en: 'Middle East', fr: 'Moyen-Orient', ar: 'الشرق الأوسط', id: 'Timur Tengah' },
};

export function getStaticPaths() {
  const marketSlugs = Object.keys(enMarketData);
  const locales = ['fr', 'ar', 'id'] as const;
  return locales.flatMap(locale =>
    marketSlugs.map(market => ({ params: { locale, market } }))
  );
}

const { locale, market } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');
const seedKeywords = marketSeedKeywords[market] || [];
const { mainProducts, auxProducts } = getMarketProducts(allProducts, seedKeywords);

// Get localized market data - id > ar > fr > en fallback chain
const marketData = currentLocale === 'id' && idMarketData[market] ? idMarketData[market]
                  : currentLocale === 'ar' && arMarketData[market] ? arMarketData[market]
                  : currentLocale === 'fr' && frMarketData[market] ? frMarketData[market]
                  : enMarketData[market];

if (!marketData) return Astro.redirect(`/${currentLocale}/markets`);

function localePath(path: string): string {
  if (currentLocale === 'en') return path;
  return `/${currentLocale}${path}`;
}

const shippingLabels: Record<string, { port: string; transit: string; cost: string }> = {
  fr: { port: 'Port', transit: 'Délai de Transit', cost: "Coût d'Expédition" },
  ar: { port: 'الميناء', transit: 'مدة العبور', cost: 'تكلفة الشحن' },
  id: { port: 'Pelabuhan', transit: 'Waktu Transit', cost: 'Biaya Pengiriman' },
};
const shippingLabel = shippingLabels[currentLocale] || shippingLabels.fr;

const productGroupLabels: Record<string, { core: string; matching: string }> = {
  fr: { core: 'Presses Hydrauliques Principales', matching: 'Équipements Complémentaires' },
  ar: { core: 'المكابس الهيدروليكية الأساسية', matching: 'المعدات الملحقة' },
  id: { core: 'Mesin Press Hidrolik Utama', matching: 'Peralatan Pendukung' },
};
const productGroupLabel = productGroupLabels[currentLocale] || productGroupLabels.fr;

const breadcrumbHome = t.nav.home;
const breadcrumbMarkets = t.common.allMarkets || 'Markets';
const breadcrumbMarket = marketNameMap[market]?.[currentLocale] || marketNameMap[market]?.en || market;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: breadcrumbHome, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: breadcrumbMarkets, item: `https://www.hydoilpress.com/${currentLocale}/markets/` },
    { '@type': 'ListItem', position: 3, name: breadcrumbMarket, item: `https://www.hydoilpress.com/${currentLocale}/markets/${market}/` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: marketData.faqs.map(faq => ({
    '@type': 'Question', name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  locale={currentLocale}
  title={marketData.title}
  description={marketData.description}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <MarketPageContent
    locale={currentLocale}
    marketData={marketData}
    market={market}
    mainProducts={mainProducts}
    auxProducts={auxProducts}
    localePath={localePath}
    shippingLabels={shippingLabel}
    productGroupLabels={productGroupLabel}
    breadcrumbHome={breadcrumbHome}
    breadcrumbMarkets={breadcrumbMarkets}
    breadcrumbMarket={breadcrumbMarket}
  />
</BaseLayout>
