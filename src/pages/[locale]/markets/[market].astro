---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';
import { frMarketData } from '../../../data/fr-market-data';
import { arMarketData } from '../../../data/ar-market-data';
import { idMarketData } from '../../../data/id-market-data';

// Seed keywords for product filtering per market
const marketSeedKeywords: Record<string, string[]> = {
  nigeria: ['peanut', 'palm kernel', 'cottonseed', 'sesame', 'shea'],
  india: ['mustard', 'sesame', 'peanut', 'coconut', 'sunflower'],
  indonesia: ['coconut', 'palm kernel', 'peanut'],
  pakistan: ['sesame', 'mustard', 'peanut', 'cottonseed', 'sunflower'],
  philippines: ['coconut', 'peanut', 'sesame', 'sunflower', 'moringa'],
  egypt: ['sesame', 'olive', 'peanut', 'sunflower'],
  'south-africa': ['sunflower', 'peanut', 'soybean', 'canola', 'rapeseed'],
  kenya: ['sunflower', 'peanut', 'sesame', 'cottonseed'],
  uk: ['rapeseed', 'canola', 'sunflower', 'hemp', 'flaxseed', 'linseed'],
  usa: ['sunflower', 'peanut', 'hemp', 'almond'],
  'middle-east': ['sesame', 'walnut', 'olive', 'almond'],
};

// Market names per locale for breadcrumbs
const marketNameMap: Record<string, Record<string, string>> = {
  nigeria: { en: 'Nigeria', fr: 'Nigéria', ar: 'نيجيريا', id: 'Nigeria' },
  india: { en: 'India', fr: 'Inde', ar: 'الهند', id: 'India' },
  indonesia: { en: 'Indonesia', fr: 'Indonésie', ar: 'إندونيسيا', id: 'Indonesia' },
  pakistan: { en: 'Pakistan', fr: 'Pakistan', ar: 'باكستان', id: 'Pakistan' },
  philippines: { en: 'Philippines', fr: 'Philippines', ar: 'الفلبين', id: 'Filipina' },
  egypt: { en: 'Egypt', fr: 'Égypte', ar: 'مصر', id: 'Mesir' },
  'south-africa': { en: 'South Africa', fr: 'Afrique du Sud', ar: 'جنوب أفريقيا', id: 'Afrika Selatan' },
  kenya: { en: 'Kenya', fr: 'Kenya', ar: 'كينيا', id: 'Kenya' },
  uk: { en: 'UK', fr: 'Royaume-Uni', ar: 'المملكة المتحدة', id: 'Inggris' },
  usa: { en: 'USA', fr: 'États-Unis', ar: 'الولايات المتحدة', id: 'Amerika Serikat' },
  'middle-east': { en: 'Middle East', fr: 'Moyen-Orient', ar: 'الشرق الأوسط', id: 'Timur Tengah' },
};

export function getStaticPaths() {
  const marketSlugs = Object.keys({
    nigeria: 1, india: 1, indonesia: 1, pakistan: 1, philippines: 1,
    egypt: 1, 'south-africa': 1, kenya: 1, uk: 1, usa: 1, 'middle-east': 1,
  });
  const locales = ['fr', 'ar', 'id'];
  return locales.flatMap(locale =>
    marketSlugs.map(market => ({ params: { locale, market } }))
  );
}

const { locale, market } = Astro.params;
const currentLocale = locale as Locale;
const t = getTranslations(currentLocale);

const allProducts = await getCollection('products');
const seedKeywords = marketSeedKeywords[market] || [];
const seedProducts = allProducts.filter(p =>
  p.data.applicableSeeds.some(s => seedKeywords.some(kw => s.toLowerCase().includes(kw)))
).slice(0, 4);

// Get localized market data - id > ar > fr fallback chain
const marketData = currentLocale === 'id' && idMarketData[market] ? idMarketData[market]
                  : currentLocale === 'ar' && arMarketData[market] ? arMarketData[market]
                  : frMarketData[market];

if (!marketData) {
  return Astro.redirect(`/${currentLocale}/markets`);
}

// Localized breadcrumb and UI strings
const breadcrumbHome = t.nav.home;
const breadcrumbMarkets = t.common.allMarkets || 'Markets';
const breadcrumbMarket = marketNameMap[market]?.[currentLocale] || marketNameMap[market]?.en || market;

function localePath(path: string): string {
  if (currentLocale === 'en') return path;
  return `/${currentLocale}${path}`;
}

// Localized shipping section labels
const shippingLabels: Record<string, { port: string; transit: string; cost: string }> = {
  fr: { port: 'Port', transit: 'Délai de Transit', cost: "Coût d'Expédition" },
  ar: { port: 'الميناء', transit: 'مدة العبور', cost: 'تكلفة الشحن' },
  id: { port: 'Pelabuhan', transit: 'Waktu Transit', cost: 'Biaya Pengiriman' },
};
const shippingLabel = shippingLabels[currentLocale] || shippingLabels.fr;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: breadcrumbHome, item: `https://www.hydoilpress.com/${currentLocale}` },
    { '@type': 'ListItem', position: 2, name: breadcrumbMarkets, item: `https://www.hydoilpress.com/${currentLocale}/markets` },
    { '@type': 'ListItem', position: 3, name: breadcrumbMarket, item: `https://www.hydoilpress.com/${currentLocale}/markets/${market}` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: marketData.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  locale={currentLocale}
  title={marketData.title}
  description={marketData.description}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{breadcrumbHome}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/markets')} class="hover:text-amber-500 transition-colors">{breadcrumbMarkets}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{breadcrumbMarket}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{marketData.heroTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl">{marketData.heroDesc}</p>
    </div>
  </section>

  <!-- Popular Oilseeds -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{marketData.seedsTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {marketData.seeds.map(seed => (
          <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
            <div class="text-3xl mb-3">{seed.emoji}</div>
            <h3 class="font-display text-xl text-charcoal-900 mb-2">{seed.name}</h3>
            <p class="text-sm text-steel-600 mb-3">{seed.description}</p>
            <div class="text-amber-500 font-semibold text-sm">{seed.yield}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recommended Products -->
  {seedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{marketData.productsTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {seedProducts.map(product => (
            <a
              href={localePath(`/products/${product.slug}`)}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title[currentLocale] || product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{currentLocale === 'id' && product.data.modelId ? product.data.modelId : currentLocale === 'fr' && product.data.modelFr ? product.data.modelFr : product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title[currentLocale] || product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {(currentLocale === 'id' && product.data.specificationsId?.length > 0 ? product.data.specificationsId : currentLocale === 'ar' && product.data.specificationsAr?.length > 0 ? product.data.specificationsAr : currentLocale === 'fr' && product.data.specificationsFr?.length > 0 ? product.data.specificationsFr : product.data.specifications).slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">{marketData.quoteTitle}</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">{marketData.quoteDesc}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        {marketData.quoteCards.map(card => (
          <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
            <div class="text-3xl mb-3">{card.emoji}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{card.title}</h3>
            <p class="text-steel-600 text-sm">{card.description}</p>
          </div>
        ))}
      </div>
      <a href={localePath('/contact')} class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        {marketData.quoteCta}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{marketData.shippingTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">{shippingLabel.port}</h3>
          <p class="text-steel-600">{marketData.shipping.port}</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">{shippingLabel.transit}</h3>
          <p class="text-steel-600">{marketData.shipping.transitTime}</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">{shippingLabel.cost}</h3>
          <p class="text-steel-600">{marketData.shipping.cost}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">{marketData.faqTitle}</h2>
      <div class="space-y-4">
        {marketData.faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">{marketData.ctaTitle}</h2>
      <p class="text-steel-300 text-lg mb-8">{marketData.ctaDesc}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localePath('/contact')} class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          {marketData.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={`https://wa.me/8618957149128?text=${encodeURIComponent(marketData.whatsappText)}`} target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white font-semibold px-8 py-4 rounded-lg hover:bg-green-500 transition-colors text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
