﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const seedProducts = allProducts.filter(p =>
  p.data.applicableSeeds.some(s => s.toLowerCase().includes('sesame'))
).slice(0, 3);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
    { '@type': 'ListItem', position: 3, name: 'Sesame Oil Press Machine', item: 'https://www.hydoilpress.com/products/sesame-oil-press-machine' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the oil yield of sesame using a hydraulic press?',
      acceptedAnswer: { '@type': 'Answer', text: 'A hydraulic oil press can extract approximately 42-47% of oil from sesame seeds. The exact yield depends on the sesame variety, moisture content, and pressing parameters. Haonuo\'s sesame-specific models achieve higher yields thanks to concentrated pressing force of 47-51 Mpa/cm².' },
    },
    {
      '@type': 'Question',
      name: 'Why is cold pressing important for sesame oil?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sesame oil is prized for its nutty aroma and flavor, which are easily destroyed by high temperatures. Cold pressing at low temperatures preserves the natural sesame flavor, antioxidants (sesamin and sesamol), and nutritional value, producing premium-quality sesame oil that commands higher market prices.' },
    },
    {
      '@type': 'Question',
      name: 'How long does it take to press one batch of sesame?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sesame pressing must be completed quickly to prevent heat loss and reduced yield. Haonuo\'s sesame-specific hydraulic press completes a full pressing cycle in approximately 8-12 minutes per batch, thanks to the concentrated pressing force and optimized barrel design.' },
    },
    {
      '@type': 'Question',
      name: 'How much sesame can the machine process per batch?',
      acceptedAnswer: { '@type': 'Answer', text: 'Haonuo\'s sesame-specific models feature a 300 mm inner diameter, 800 mm high barrel that holds 32.5 kg of sesame per batch. With pre-compression to create additional space, a single batch can process up to 50 kg of sesame — ideal for commercial-scale production.' },
    },
    {
      '@type': 'Question',
      name: 'Can the same machine press other oilseeds besides sesame?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, Haonuo\'s sesame oil hydraulic press is versatile and can also press in-shell walnuts, tea seeds, rapeseed, peanuts, soybeans, lacquer oil seeds, and flaxseed. In fact, it achieves even lower residual oil rates on these conventional materials compared to standard models.' },
    },
  ],
};

const faqs = [
  { question: 'What is the oil yield of sesame using a hydraulic press?', answer: 'A hydraulic oil press can extract approximately 42-47% of oil from sesame seeds. The exact yield depends on the sesame variety, moisture content, and pressing parameters. Haonuo\'s sesame-specific models achieve higher yields thanks to concentrated pressing force of 47-51 Mpa/cm².' },
  { question: 'Why is cold pressing important for sesame oil?', answer: 'Sesame oil is prized for its nutty aroma and flavor, which are easily destroyed by high temperatures. Cold pressing at low temperatures preserves the natural sesame flavor, antioxidants (sesamin and sesamol), and nutritional value, producing premium-quality sesame oil that commands higher market prices.' },
  { question: 'How long does it take to press one batch of sesame?', answer: 'Sesame pressing must be completed quickly to prevent heat loss and reduced yield. Haonuo\'s sesame-specific hydraulic press completes a full pressing cycle in approximately 8-12 minutes per batch, thanks to the concentrated pressing force and optimized barrel design.' },
  { question: 'How much sesame can the machine process per batch?', answer: 'Haonuo\'s sesame-specific models feature a 300 mm inner diameter, 800 mm high barrel that holds 32.5 kg of sesame per batch. With pre-compression to create additional space, a single batch can process up to 50 kg of sesame — ideal for commercial-scale production.' },
  { question: 'Can the same machine press other oilseeds besides sesame?', answer: 'Yes, Haonuo\'s sesame oil hydraulic press is versatile and can also press in-shell walnuts, tea seeds, rapeseed, peanuts, soybeans, lacquer oil seeds, and flaxseed. In fact, it achieves even lower residual oil rates on these conventional materials compared to standard models.' },
];
---

<BaseLayout
  title="Sesame Oil Press Machine - Hydraulic Cold Press for Premium Sesame Oil"
  description="Professional sesame oil press machine by Haonuo Machinery. Hydraulic cold press technology preserves natural aroma and nutrients. 42-47% oil yield, 50 kg/batch capacity. Factory-direct pricing."
  keywords={['sesame oil press machine', 'sesame oil hydraulic press', 'hydraulic oil press for sesame', 'sesame oil extraction machine', 'cold press sesame oil', 'sesame oil maker']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products" class="hover:text-amber-500 transition-colors">Products</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">Sesame Oil Press Machine</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Sesame Oil Press Machine</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Hydraulic cold press for premium sesame oil — preserves natural aroma and nutrients, 42-47% oil yield, up to 50 kg/batch capacity.</p>
    </div>
  </section>

  <!-- SEO Introduction -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose-solution">
        <p>Sesame oil is one of the most valuable edible oils in the world, cherished for its distinctive nutty flavor, rich aroma, and impressive nutritional profile. Producing premium sesame oil demands specialized equipment that can extract maximum oil while preserving the delicate flavor compounds and antioxidants like sesamin and sesamol. A sesame oil press machine using hydraulic cold press technology is the ideal solution, applying intense pressure at low temperatures to achieve oil yields of 42-47% without degrading oil quality.</p>
        <p>Haonuo Machinery's sesame oil press machines are purpose-built for commercial sesame processing, featuring a narrower 300 mm barrel that concentrates pressing force to 47-51 Mpa/cm² for complete extraction in a single rapid cycle. The temperature-sensitive design minimizes heat loss during pressing — critical for sesame, where prolonged exposure to heat reduces both yield and quality. With batch capacities up to 50 kg and cycle times of just 8-12 minutes, these machines deliver exceptional throughput and production efficiency for commercial-scale sesame oil production.</p>
      </div>
    </div>
  </section>

  <!-- Products -->
  {seedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">Our Sesame Oil Press Machines</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {seedProducts.map(product => (
            <a
              href={`/products/${product.slug}`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20sesame%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Solutions -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Related Solutions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href="/solutions/sesame-oil-pressing" class="card-hover bg-white rounded-2xl p-6 border border-steel-100 group hover:border-amber-300">
          <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">Sesame Oil Pressing Solution</h3>
          <p class="text-sm text-steel-600 line-clamp-2">Complete sesame oil production line from seed selection to premium oil.</p>
        </a>
        <a href="/solutions/small-business-oil-press" class="card-hover bg-white rounded-2xl p-6 border border-steel-100 group hover:border-amber-300">
          <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">Small Business Oil Press Solution</h3>
          <p class="text-sm text-steel-600 line-clamp-2">Affordable oil pressing solutions for small-scale entrepreneurs.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Sesame Oil Business?</h2>
      <p class="text-steel-300 text-lg mb-8">Contact us for a free quotation and professional equipment recommendation.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get a Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
