﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const t = getTranslations('en');

const allProducts = await getCollection('products');
const relatedProducts = product.data.related
  .map(slug => allProducts.find(p => p.slug === slug))
  .filter(Boolean)
  .slice(0, 3);

const isCoconutProduct = product.data.applicableSeeds.includes('coconut milk');

const allCategories = await getCollection('categories');
const category = allCategories.find(c => c.slug === product.data.category);

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.title.en,
  description: product.data.description?.en || '',
  image: product.data.images[0] || '',
  brand: {
    '@type': 'Brand',
    name: 'Haonuo',
  },
  manufacturer: {
    '@type': 'Organization',
    name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.',
    url: 'https://www.hydoilpress.com',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `https://www.hydoilpress.com/products/${product.slug}`,
    seller: {
      '@type': 'Organization',
      name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.',
    },
  },
};

const faqLd = product.data.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.data.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
    { '@type': 'ListItem', position: 3, name: product.data.title.en, item: `https://www.hydoilpress.com/products/${product.slug}` },
  ],
};

const allLd = [productLd, breadcrumbLd];
if (faqLd) allLd.push(faqLd);
---

<BaseLayout title={product.data.title.en} description={product.data.description?.en || `Professional ${product.data.title.en.toLowerCase()} by Haonuo Machinery.`} keywords={product.data.seoKeywords} jsonLd={allLd} ogImage={product.data.images[0] ? `https://www.hydoilpress.com${product.data.images[0]}` : undefined}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products" class="hover:text-amber-500 transition-colors">{t.products.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900">{product.data.title.en}</span>
      </nav>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Image Gallery -->
        <div class="lg:sticky lg:top-24 lg:h-fit">
          <div class="aspect-[4/3] bg-steel-100 rounded-2xl overflow-hidden mb-4">
            <img
              id="main-image"
              src={product.data.images[0]}
              alt={product.data.title.en}
              width="800"
              height="600"
              class="w-full h-full object-cover"
              onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo%20on%20white%20background%2C%20professional%20product%20photography&image_size=landscape_4_3'"
            />
          </div>
          {product.data.images.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {product.data.images.map((img, i) => (
                <button
                  class="aspect-square bg-steel-100 rounded-lg overflow-hidden border-2 border-transparent hover:border-amber-500 transition-colors thumbnail-btn"
                  data-src={img}
                >
                  <img
                    src={img}
                    alt={`${product.data.title.en} ${i + 1}`}
                    width="150"
                    height="150"
                    class="w-full h-full object-cover"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20detail%20photo%2C%20professional%20photography&image_size=square'"
                  />
                </button>
              ))}
            </div>
          )}

          <!-- Product Video -->
          {product.data.videoUrl && (
            <div class="mt-4">
              <h3 class="font-display text-lg text-charcoal-900 mb-3">Product Video</h3>
              <div class="aspect-video bg-steel-100 rounded-2xl overflow-hidden">
                <iframe
                  src={product.data.videoUrl}
                  title={`${product.data.title.en} - Product Demo`}
                  class="w-full h-full"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}
        </div>

        <!-- Product Info -->
        <div>
          {category && (
            <span class="inline-block bg-amber-100 text-amber-700 text-xs font-medium px-3 py-1 rounded-full mb-3">
              {category.data.name.en}
            </span>
          )}
          <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-2">
            {product.data.title.en}
          </h1>
          <p class="text-steel-500 text-sm mb-6">Model: {product.data.model}</p>

          <!-- Warranty Badge -->
          <div class="flex items-center gap-2 mb-6 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span class="text-green-700 font-medium text-sm">1-Year Warranty &bull; Lifetime Technical Support</span>
          </div>

          <!-- Specifications -->
          <div class="mb-8">
            <h2 class="font-display text-2xl text-charcoal-900 mb-4">{t.products.specifications}</h2>
            <div class="bg-steel-50 rounded-xl overflow-hidden">
              {product.data.specifications.map((spec, i) => (
                <div class:list={[
                  'flex justify-between px-5 py-3 text-sm',
                  i % 2 === 0 ? 'bg-steel-50' : 'bg-white'
                ]}>
                  <span class="text-steel-600">{spec.name}</span>
                  <span class="text-charcoal-900 font-medium">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Recommended Seeds -->
          {product.data.applicableSeeds.length > 0 && (
            <div class="mb-8">
              <h2 class="font-display text-2xl text-charcoal-900 mb-3">{t.products.applicableSeeds}</h2>
              <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-4 flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                <p class="text-sm text-blue-800" set:html={isCoconutProduct ? t.products.seedInfoCoconut : t.products.seedInfo} />
              </div>
              <div class="flex flex-wrap gap-2">
                {product.data.applicableSeeds.map(seed => (
                  <span class="text-sm bg-green-50 text-green-700 px-3 py-1.5 rounded-full font-medium">
                    {seed}
                  </span>
                ))}
                {!isCoconutProduct && (
                  <span class="text-sm text-steel-500 px-3 py-1.5 italic">+ more oil seeds available</span>
                )}
              </div>
            </div>
          )}

          <!-- CTA Buttons -->
          <div class="space-y-3">
            <a href="/contact" class="btn-primary text-base w-full justify-center">
              {t.products.requestQuote}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="https://wa.me/8618957149128" target="_blank" rel="noopener noreferrer" class="btn-outline text-base w-full justify-center border-green-500 text-green-600 hover:bg-green-500 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
            
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="mt-12 md:mt-16">
        <h2 class="font-display text-3xl text-charcoal-900 mb-6">Description</h2>
        <div class="prose-product max-w-none text-steel-700 leading-relaxed">
          <Content />
        </div>
      </div>

      <!-- FAQ Section -->
      {product.data.faq.length > 0 && (
        <div class="mt-12 md:mt-16">
          <h2 class="font-display text-3xl text-charcoal-900 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {product.data.faq.map((item, i) => (
              <details class="group bg-steel-50 rounded-xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
                  <span class="font-display text-lg text-charcoal-900">{item.question}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- Related Products -->
      {relatedProducts.length > 0 && (
        <div class="mt-12 md:mt-16">
          <h2 class="font-display text-3xl text-charcoal-900 mb-6">{t.products.relatedProducts}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedProducts.map(rp => rp && (
              <a
                href={`/products/${rp.slug}`}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img
                    src={rp.data.images[0]}
                    alt={rp.data.title.en}
                    width="400"
                    height="300"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-4">
                  <div class="text-xs text-amber-500 font-medium mb-1">{rp.data.model}</div>
                  <h3 class="font-display text-lg text-charcoal-900">{rp.data.title.en}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back Button -->
      <div class="mt-12">
        <a href="/products" class="inline-flex items-center gap-2 text-steel-600 hover:text-amber-500 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back to Products
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Thumbnail image switching
  document.querySelectorAll('.thumbnail-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mainImg = document.getElementById('main-image') as HTMLImageElement;
      const src = btn.getAttribute('data-src');
      if (mainImg && src) mainImg.src = src;
      document.querySelectorAll('.thumbnail-btn').forEach(b => b.classList.remove('border-amber-500'));
      btn.classList.add('border-amber-500');
    });
  });

  // FAQ accordion
  document.querySelectorAll('.faq-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as SVGElement;
      const isOpen = !content.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(ic => ic.style.transform = 'rotate(0deg)');

      // Toggle current
      if (!isOpen) {
        content.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
