﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('en');

const allProducts = await getCollection('products');

const categoryOrder: Record<string, number> = {
  'hydraulic-oil-press': 1,
  'seed-processing-equipment': 2,
  'roasting-steaming-equipment': 3,
  'filtration-refining-equipment': 4,
};

const hydraulicOrder: Record<string, number> = {
  'mini-hydraulic-oil-press': 1,
  'standard-hydraulic-oil-press': 2,
  'stainless-steel-hydraulic-oil-press': 3,
  'heavy-duty-hydraulic-oil-press': 4,
  'medium-hydraulic-oil-press': 5,
  'cold-press-hydraulic-oil-press': 6,
  'high-pressure-hydraulic-oil-press': 7,
  'ultra-high-pressure-cold-press': 8,
  'ultra-high-pressure-hydraulic-oil-press': 9,
  'sesame-oil-hydraulic-press': 10,
  'coconut-oil-hydraulic-press': 11,
  'large-barrel-hydraulic-oil-press': 12,
  'animal-fat-hydraulic-press': 13,
};

const sortedProducts = allProducts.sort((a, b) => {
  const catA = categoryOrder[a.data.category] ?? 99;
  const catB = categoryOrder[b.data.category] ?? 99;
  if (catA !== catB) return catA - catB;

  if (a.data.category === 'hydraulic-oil-press') {
    const orderA = hydraulicOrder[a.slug] ?? 99;
    const orderB = hydraulicOrder[b.slug] ?? 99;
    if (orderA !== orderB) return orderA - orderB;
  }

  const numA = parseInt(a.data.model.replace(/\D/g, '')) || 0;
  const numB = parseInt(b.data.model.replace(/\D/g, '')) || 0;
  return numA - numB;
});
const allCategories = await getCollection('categories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Hydraulic Oil Press & Auxiliary Equipment - Haonuo Machinery',
  numberOfItems: allProducts.length,
  itemListElement: allProducts.map((product, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: product.data.title.en,
    url: `https://www.hydoilpress.com/products/${product.slug}`,
  })),
};

const allLd = [breadcrumbLd, itemListLd];

const productKeywords = [
  'hydraulic oil press machine', 'oil press machine', 'cold press oil machine',
  'coconut oil press', 'sesame oil press', 'peanut oil press',
  'seed processing equipment', 'oil roasting equipment', 'oil filtration equipment',
  'Haonuo Machinery', 'oil extraction machine', 'oil press manufacturer',
];
---

<BaseLayout title={t.products.title} description={t.products.subtitle} keywords={productKeywords} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.products.title}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{t.products.title}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{t.products.subtitle}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filter -->
        <aside class="lg:w-56 shrink-0">
          <div class="sticky top-24 space-y-8">
            <div>
              <h3 class="font-display text-lg text-charcoal-900 mb-4">Category</h3>
              <nav class="space-y-1">
                <a
                  href="/products/"
                  class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-amber-500 text-charcoal-900"
                >
                  {t.products.allCategories}
                </a>
                {sortedCategories.map(cat => (
                  <a
                    href={`/products/${cat.slug}`}
                    class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                  >
                    {cat.data.name.en}
                  </a>
                ))}
              </nav>
            </div>

            <div class="pt-6 border-t border-steel-100">
              <nav class="space-y-1">
                <a
                  href="/hydraulic-oil-press-machine/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  <span>{t.common.hydraulicOilPressMachine}</span>
                </a>
                <a
                  href="/cold-press-oil-machine/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <span>{t.common.coldPressOilMachine}</span>
                </a>
                <a
                  href="/manual-oil-press-machine/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m-7.07-3.93l4.24-4.24m5.66-5.66l4.24-4.24M1 12h6m6 0h6m-3.93 7.07l-4.24-4.24m-5.66-5.66L4.93 4.93"/></svg>
                  <span>{t.common.manualOilPressMachine}</span>
                </a>
              </nav>
            </div>

            <div class="pt-6 border-t border-steel-100">
              <a
                href="/catalog/"
                class="flex items-center gap-3 px-4 py-3 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors group mb-2"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                <div>
                  <div class="text-sm font-semibold">{t.nav.catalog}</div>
                  <div class="text-xs opacity-70">{t.common.browseCatalog}</div>
                </div>
              </a>
              <a
                href="/products/model-comparison/"
                class="flex items-center gap-3 px-4 py-3 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                <div>
                  <div class="text-sm font-semibold">{t.nav.modelComparison}</div>
                  <div class="text-xs opacity-70">{t.common.compareAllModels}</div>
                </div>
              </a>
            </div>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="flex-1">
          <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {sortedProducts.map((product) => (
              <a
                href={`/products/${product.slug}`}
                class="product-card card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden relative">
                  <img
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    width="400"
                    height="300"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo%20on%20white%20background%2C%20professional%20product%20photography&image_size=landscape_4_3'"
                  />
                  <div class="absolute inset-0 bg-steel-900/0 group-hover:bg-steel-900/20 transition-colors duration-300 flex items-center justify-center">
                    <span class="bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-medium text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      {t.products.viewDetails}
                    </span>
                  </div>
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title.en}</h3>
                  <p class="text-sm text-steel-500 mb-3 line-clamp-2">{product.data.description?.en}</p>
                  <div class="flex flex-wrap gap-2 items-center">
                    {product.data.applicableSeeds.slice(0, 3).map(seed => (
                      <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded-full">
                        {seed}
                      </span>
                    ))}
                    <span class="text-xs text-steel-400">+ more</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
          <div id="load-more-wrap" class="mt-8 text-center hidden">
            <button id="load-more-btn" class="bg-amber-500 hover:bg-amber-400 text-charcoal-900 font-semibold px-8 py-3 rounded-lg transition-colors">
              Load More Products
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment Overview by Category -->
  <section class="py-12 md:py-16 bg-white border-t border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-4 text-charcoal-900">Equipment Categories</h2>
      <p class="text-steel-600 mb-8 leading-relaxed">Haonuo provides four equipment categories covering the complete oil pressing workflow — from seed preparation through pressing to filtration. Each category serves a specific stage in the production line, and most operations need equipment from two or more categories to produce finished oil.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center text-amber-600 font-bold text-sm">1</span>
            <h3 class="font-display text-lg text-charcoal-900">Seed Processing</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed">Cleaning, dehulling, and crushing equipment that prepares raw seeds for pressing. Removes debris and foreign matter and increases surface area for more complete oil release during pressing.</p>
          <a href="/products/seed-processing-equipment/" class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">View equipment <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold text-sm">2</span>
            <h3 class="font-display text-lg text-charcoal-900">Roasting & Steaming</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed">Controlled heat application that breaks down cell walls, reduces oil viscosity, and develops flavor. Increases oil yield by 5–15% compared to pressing unheated seeds.</p>
          <a href="/products/roasting-steaming-equipment/" class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">View equipment <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center text-green-600 font-bold text-sm">3</span>
            <h3 class="font-display text-lg text-charcoal-900">Hydraulic Oil Press</h3>
          </div>
          <p class="text-steel-600 leading-relaxed text-sm">Batch pressing with low temperature retention (below 60°C). 12 models from 300 to 620 tonnes pressing force with 100 kg per batch capacity. Best for high-value seeds where oil quality matters more than throughput.</p>
          <a href="/products/hydraulic-oil-press/" class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">View equipment <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600 font-bold text-sm">4</span>
            <h3 class="font-display text-lg text-charcoal-900">Filtration & Refining</h3>
          </div>
          <p class="text-sm text-steel-600 leading-relaxed">Transforms crude pressed oil into clear, stable, market-ready product. From basic 50-micron filtration for bulk sale to full refining for food-grade retail oil.</p>
          <a href="/products/filtration-refining-equipment/" class="inline-flex items-center gap-1 text-amber-500 text-sm font-medium mt-3 hover:text-amber-600">View equipment <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
      </div>

      <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg">
        <p class="text-steel-700"><strong>Not sure which category you need?</strong> If you are starting from scratch, most operations need equipment from all four categories. For an overview of the complete production process from seed to bottled oil, see our <a href="/resources/complete-oil-production-line-guide/" class="text-amber-600 underline hover:text-amber-700">Complete Oil Production Line Guide</a>.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-steel-900 to-steel-800 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-bold text-2xl md:text-4xl mb-5">Need Help Choosing the Right Equipment?</h2>
      <p class="text-steel-300 text-base md:text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
        Our engineers can recommend the best machine for your oil seeds, capacity, and budget. Get a free quotation within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-amber-400 text-charcoal-900 font-bold px-8 py-4 rounded-xl hover:from-amber-400 hover:to-amber-300 transition-all shadow-lg hover:shadow-xl">
          Get Factory Price
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="https://wa.me/8618957149128" class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-8 py-4 rounded-xl transition-all shadow-lg hover:shadow-xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var grid = document.getElementById('product-grid');
      if (!grid) return;
      var cards = grid.querySelectorAll('.product-card');
      var isMobile = !window.matchMedia('(min-width: 1280px)').matches;
      var initial = isMobile ? 12 : cards.length;
      var step = isMobile ? 9 : cards.length;
      var shown = initial;
      cards.forEach(function (c, i) { if (i >= initial) c.style.display = 'none'; });
      var wrap = document.getElementById('load-more-wrap');
      var btn = document.getElementById('load-more-btn');
      function update() {
        if (shown < cards.length) { wrap.classList.remove('hidden'); btn.textContent = 'Load More (' + (cards.length - shown) + ' left)'; }
        else wrap.classList.add('hidden');
      }
      btn.addEventListener('click', function () {
        var next = Math.min(shown + step, cards.length);
        for (var i = shown; i < next; i++) cards[i].style.display = '';
        shown = next;
        update();
      });
      update();
    })();
  </script>
</BaseLayout>
