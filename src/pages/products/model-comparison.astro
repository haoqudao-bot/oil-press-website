---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';

const t = getTranslations('en');

// ===== Standard models =====
const models = [
  {
    model: 'HN300', name: 'Mini', pressingForce: '300 Tons', systemPressure: '60 Mpa',
    cakePressure: '25 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '1.2 / 1.5 T', dimensions: '1100×1100×2350 mm',
    bestFor: 'Small business, startup',
    seeds: ['Sesame', 'Peanut', 'Rapeseed', 'Tea Seed'],
    slug: 'mini-hydraulic-oil-press', highlight: false,
  },
  {
    model: 'HN325', name: 'Standard', pressingForce: '325 Tons', systemPressure: '60 Mpa',
    cakePressure: '27.78 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '1.42 / 1.72 T', dimensions: '1200×1200×2450 mm',
    bestFor: 'Most popular, versatile',
    seeds: ['Tea Seed', 'Rapeseed', 'Peanut', 'Soybean', 'Flaxseed'],
    slug: 'standard-hydraulic-oil-press', highlight: true,
  },
  {
    model: 'HN355', name: 'Heavy Duty', pressingForce: '360 Tons', systemPressure: '63 Mpa',
    cakePressure: '30.15 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '2.1 / 2.5 T', dimensions: '1200×1200×2650 mm',
    bestFor: 'Higher yield, commercial',
    seeds: ['Tea Seed', 'Rapeseed', 'Peanut', 'Soybean', 'Flaxseed'],
    slug: 'heavy-duty-hydraulic-oil-press', highlight: false,
  },
  {
    model: 'HN400', name: 'Medium', pressingForce: '500 Tons', systemPressure: '63 Mpa',
    cakePressure: '38 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '2.0 / 2.3 T', dimensions: '1200×1200×2600 mm',
    bestFor: 'Walnut, high oil content',
    seeds: ['Tea Seed', 'Rapeseed', 'Peanut', 'Walnut', 'Flaxseed'],
    slug: 'medium-hydraulic-oil-press', highlight: false,
  },
  {
    model: 'HN426', name: 'Cold Press', pressingForce: '500 Tons', systemPressure: '70 Mpa',
    cakePressure: '42 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '2.4 / 2.7 T', dimensions: '1200×1200×2750 mm',
    bestFor: 'Cold press, premium quality',
    seeds: ['Walnut', 'Almond', 'Apricot', 'Tiger Nut', 'Yellowhorn'],
    slug: 'cold-press-hydraulic-oil-press', highlight: true,
  },
  {
    model: 'HN480', name: 'Cold Press', pressingForce: '600 Tons', systemPressure: '72 Mpa',
    cakePressure: '48 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '2.8 / 3.1 T', dimensions: '1300×1300×2800 mm',
    bestFor: 'Hard seeds, max yield',
    seeds: ['Walnut', 'Pine Nut', 'Almond', 'Sesame', 'Apricot'],
    slug: 'ultra-high-pressure-cold-press', highlight: false,
  },
  {
    model: 'HN500', name: 'Ultra High Pressure', pressingForce: '620 Tons', systemPressure: '75 Mpa',
    cakePressure: '52 Mpa/cm²', barrelDiameter: '390 mm', barrelHeight: '800 mm',
    motorPower: '2.2 KW', weight: '3.5 / 3.88 T', dimensions: '1200×1200×2750 mm',
    bestFor: 'Industrial, max capacity',
    seeds: ['All seeds', 'In-shell Walnut', 'Yellowhorn', 'Tiger Nut'],
    slug: 'ultra-high-pressure-hydraulic-oil-press', highlight: false,
  },
];

// ===== Specialty models =====
const specialtyModels = [
  {
    model: 'HN325/355 Sesame', name: 'Sesame Special', pressingForce: '325 / 360 T',
    barrelDiameter: '300 mm', cakePressure: '47 / 51 Mpa/cm²',
    bestFor: 'Sesame oil specialist',
    seeds: ['Sesame', 'In-shell Walnut', 'Tea Seed', 'Rapeseed'],
    slug: 'sesame-oil-hydraulic-press',
  },
  {
    model: '300 Type Coconut', name: 'Coconut Milk', pressingForce: '300 Tons',
    barrelDiameter: '600 mm', cakePressure: '10.83 Mpa/cm²',
    bestFor: 'Coconut milk extraction',
    seeds: ['Coconut Milk'],
    slug: 'coconut-oil-hydraulic-press',
  },
  {
    model: 'HN325LB', name: 'Large Barrel', pressingForce: '325 Tons',
    barrelDiameter: '630 mm', cakePressure: '10.64 Mpa/cm²',
    bestFor: 'Oil residue, dehydration',
    seeds: ['Oil Residue', 'Sludge', 'Dehydration'],
    slug: 'large-barrel-hydraulic-oil-press',
  },
];

// ===== Seed cards — seeds are the HERO, model is secondary =====
const seedCards = [
  {
    badge: 'Best Seller', badgeColor: 'amber',
    seeds: ['Peanut', 'Rapeseed', 'Soybean', 'Sunflower'],
    seedHint: 'Soft seeds',
    model: 'HN325', modelColor: 'amber',
    desc: 'First choice for everyday oils. ≤100 kg/batch. Hot or cold press. Industry entry point.',
    href: '/products/standard-hydraulic-oil-press',
  },
  {
    badge: 'Cold Press', badgeColor: 'blue',
    seeds: ['Tea Seed', 'Walnut', 'Flaxseed'],
    seedHint: 'Multi-seed workshop',
    model: 'HN355 / 400', modelColor: 'steel',
    desc: '370–410 real tons. Entry to mid cold-press for most medium seeds — bottled-oil grade.',
    href: '/products/heavy-duty-hydraulic-oil-press',
  },
  {
    badge: 'Most Popular', badgeColor: 'green',
    seeds: ['Flaxseed', 'Perilla', 'Pumpkin Seed'],
    seedHint: 'Med-hard seeds',
    model: 'HN426', modelColor: 'green',
    desc: 'Real 500 tons, 42 MPa/cm² cake pressure. Sweet spot for all medium-hard premium seeds.',
    href: '/products/cold-press-hydraulic-oil-press',
  },
  {
    badge: 'Heavy Duty', badgeColor: 'steel',
    seeds: ['Copra', 'Hemp', 'Pine Nut'],
    seedHint: 'Hard seeds',
    model: 'HN480 / 500', modelColor: 'steel',
    desc: '600–630 real ton flagship. Only reliable choice for super-hard seeds. High volume → double-barrel.',
    href: '/products/ultra-high-pressure-hydraulic-oil-press',
  },
  {
    badge: 'Sesame Only', badgeColor: 'purple',
    seeds: ['Sesame'],
    seedHint: 'Specialty',
    model: 'HN325/355 Sesame', modelColor: 'purple',
    desc: '300 mm small barrel concentrates pressure 47–51 MPa/cm². Fast cycle preserves aroma, max yield.',
    href: '/products/sesame-oil-hydraulic-press',
  },
  {
    badge: 'Coconut Only', badgeColor: 'cyan',
    seeds: ['Coconut Milk', 'VCO'],
    seedHint: 'Specialty',
    model: '300 Type Coconut', modelColor: 'cyan',
    desc: 'Wide 600 mm barrel. Full 304 stainless steel (barrel + oil pan) resists corrosion.',
    href: '/products/coconut-oil-hydraulic-press',
  },
  {
    badge: 'Specialty', badgeColor: 'orange',
    seeds: ['Oil Sludge', 'Fruit/Veg Dehydration'],
    seedHint: 'Industrial',
    model: 'HN325LB', modelColor: 'orange',
    desc: '630×1000 mm large barrel (~312 L). High-volume low-pressure specialist.',
    href: '/products/large-barrel-hydraulic-oil-press',
  },
  {
    badge: 'Add-On', badgeColor: 'amber-light',
    seeds: ['Any seed + double barrel'],
    seedHint: 'Add-on',
    model: 'Any Model + Double-Barrel', modelColor: 'amber',
    desc: 'Pick model by seed type first, then add double-barrel. One presses while the other loads — eliminates idle time. +30–50% more daily batches.',
    href: '/contact',
  },
];

// ===== Scenario cards (kept EXACTLY as original) =====
const scenarioCards = [
  {
    badge: 'Best Seller', badgeColor: 'amber',
    subtitle: 'Common soft seeds · startup / small shop',
    model: 'HN325', modelColor: 'amber',
    desc: 'First choice for peanut & everyday oils. ≤100 kg / batch. Hot or cold press. Industry entry point.',
    href: '/products/standard-hydraulic-oil-press',
  },
  {
    badge: 'Cold Press', badgeColor: 'blue',
    subtitle: 'Mid workshop · variable premium seeds',
    model: 'HN355 / 400', modelColor: 'blue',
    desc: '370–410 real tons. Entry to mid cold-press for tea seed, walnut, flax — bottled-oil grade.',
    href: '/products/heavy-duty-hydraulic-oil-press',
  },
  {
    badge: 'Most Popular', badgeColor: 'green',
    subtitle: 'Hard seeds · or high throughput',
    model: 'HN426', modelColor: 'green',
    desc: 'Real 500 tons. Covers soft and hard seeds alike. Cold + hot press. Industry "sweet spot" upgrade model.',
    href: '/products/cold-press-hydraulic-oil-press',
  },
  {
    badge: 'Large Scale', badgeColor: 'steel',
    subtitle: 'Factory · bulk exporter',
    model: 'HN480 / 500', modelColor: 'steel',
    desc: '600–630 real ton flagship. Only reliable choice for super-hard seeds. Double-barrel = max cycles.',
    href: '/products/ultra-high-pressure-hydraulic-oil-press',
  },
  {
    badge: 'High Output', badgeColor: 'amber-light',
    subtitle: 'Very large daily volume',
    model: 'Double-Barrel', modelColor: 'amber',
    desc: 'Add-on for any model. One barrel presses while the other loads/unloads — eliminates idle time between batches. +30–50% more daily batches, not larger batches.',
    href: '/contact',
  },
  {
    badge: 'Specialty', badgeColor: 'purple',
    subtitle: 'Sesame / coconut milk / sludge',
    model: 'Specialty', modelColor: 'purple',
    desc: 'Sesame → 300 mm small barrel. Coconut milk → 600 mm 304 stainless. Sludge/dehydration → 630 mm LB.',
    href: '/products/sesame-oil-hydraulic-press',
  },
];

// ===== Color mappings =====
const badgeColors = {
  amber: 'bg-amber-500',
  'amber-light': 'bg-amber-400 text-charcoal-900',
  blue: 'bg-blue-600',
  green: 'bg-green-600',
  steel: 'bg-steel-700',
  purple: 'bg-purple-600',
  cyan: 'bg-cyan-600',
  orange: 'bg-orange-600',
};

const modelAccentColors = {
  amber: 'text-amber-500',
  'amber-light': 'text-amber-500',
  blue: 'text-blue-600',
  green: 'text-green-600',
  steel: 'text-steel-700',
  purple: 'text-purple-600',
  cyan: 'text-cyan-600',
  orange: 'text-orange-600',
};

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
    { '@type': 'ListItem', position: 3, name: 'Oil Press Comparison', item: 'https://www.hydoilpress.com/products/model-comparison' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How do I choose the right Haonuo oil press model?',
      acceptedAnswer: { '@type': 'Answer', text: 'Pick by seed type or scenario above. Every standard model presses most oil seeds — the difference is pressing force (harder seeds need larger tonnage) and barrel config (single for startup, double for commercial). For sesame use the Sesame Special, for coconut milk use the 300 Type Coconut.' } },
    { '@type': 'Question', name: 'Does a higher model number mean more kg per batch?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. The model number indicates pressing force (real tonnage), not batch capacity. Every standard model from HN300 to HN500 uses the same 390 mm barrel holding up to 100 kg per batch. To press more batches per shift, add a double barrel rather than a bigger model number.' } },
    { '@type': 'Question', name: 'What is the difference between cold press and standard models?',
      acceptedAnswer: { '@type': 'Answer', text: 'Cold press models (HN426, HN480) run at 70+ MPa system pressure, extracting oil without pre-heating seeds. This preserves nutrients, flavor, and color for premium-grade oil. Standard models (HN325, HN355) use lower pressure and typically pre-roast seeds for faster yield at standard market prices.' } },
    { '@type': 'Question', name: 'Should I choose single or double barrel?',
      acceptedAnswer: { '@type': 'Answer', text: 'Single barrel is ideal for startups testing the market. Double barrel is recommended for commercial continuous operation: one barrel presses while the other loads/unloads, eliminating idle time between batches on the same hydraulic system. The double barrel does not press two batches simultaneously.' } },
    { '@type': 'Question', name: 'Can I upgrade from single to double barrel later?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. The hydraulic system is the same — you can start with a single barrel HN325 and add a second barrel later when your order volume grows. This is why many startups begin with HN300 or HN325 single barrel and upgrade to double barrel within 6-12 months.' } },
  ],
};

const allLd = [breadcrumbLd, faqLd];
---

<BaseLayout title="Hydraulic Oil Press Model Comparison | Haonuo Machinery" description="Compare all Haonuo hydraulic oil press models side by side. Pick by seed type or scenario — find your model instantly. HN300 to HN500 plus sesame, coconut, sludge specialists." keywords={['oil press model comparison','hydraulic oil press comparison','HN325 vs HN426','oil press by seed type','cold press model guide','coconut oil press machine']} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-3 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products" class="hover:text-amber-500 transition-colors">Products</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Oil Press Comparison</span>
      </nav>
    </div>
  </section>

  <!-- ===== HERO ===== -->
  <section class="bg-gradient-to-br from-steel-900 via-steel-800 to-charcoal-900 text-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-4">
          Find your oil press in seconds
        </h1>
        <p class="text-steel-300 text-lg md:text-xl leading-relaxed">
          Pick by <b class="text-amber-400">seed type</b> or <b class="text-amber-400">scenario</b> → see your recommended model instantly.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-6 pt-4">
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">15+</div>
          <div class="text-xs text-steel-300 mt-1">Years of manufacturing</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">50+</div>
          <div class="text-xs text-steel-300 mt-1">Countries served</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">200+</div>
          <div class="text-xs text-steel-300 mt-1">Engineers &amp; workers</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">3,000</div>
          <div class="text-xs text-steel-300 mt-1">m² production facility</div>
        </div>
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl text-amber-400 font-bold leading-tight">2,000+</div>
          <div class="text-xs text-steel-300 mt-1">Machines delivered</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TAB: Seed / Scenario (centered, prominent) ===== -->
  <section class="py-6 md:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center mb-8">
        <div id="sel-tabs" class="inline-flex p-1.5 bg-white rounded-2xl shadow-lg border border-steel-200">
          <button type="button" data-sel-tab="seed" class="sel-tab-btn active px-6 py-3 rounded-xl font-bold text-base bg-amber-500 text-charcoal-900 shadow-md">
            📊 Pick by Seed
          </button>
          <button type="button" data-sel-tab="scenario" class="sel-tab-btn px-6 py-3 rounded-xl font-bold text-base text-steel-600 hover:text-amber-600 hover:bg-amber-50 transition-colors">
            🎴 Pick by Scenario
          </button>
        </div>
      </div>

      <!-- Tab A: Pick by Seed — SEEDS are the HERO -->
      <div id="sel-tab-seed" class="sel-tab-panel">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {seedCards.map(card => (
            <a href={card.href} class="relative bg-white border border-steel-100 rounded-2xl p-5 shadow-sm overflow-hidden hover:shadow-lg hover:border-steel-200 transition-all group flex flex-col">
              <span class={`absolute top-0 right-0 text-white text-[0.7rem] font-bold px-3 py-1 rounded-bl-xl ${badgeColors[card.badgeColor]}`}>{card.badge}</span>
              <!-- Seed chips as HERO -->
              <div class="mb-3">
                <div class="flex flex-wrap gap-1.5">
                  {card.seeds.map(seed => (
                    <span class={`inline-block text-sm font-bold px-2.5 py-1 rounded-lg border ${
                      card.badgeColor === 'amber' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                      card.badgeColor === 'amber-light' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                      card.badgeColor === 'blue' ? 'bg-blue-50 text-blue-700 border-blue-200' :
                      card.badgeColor === 'green' ? 'bg-green-50 text-green-700 border-green-200' :
                      card.badgeColor === 'steel' ? 'bg-steel-100 text-steel-700 border-steel-200' :
                      card.badgeColor === 'purple' ? 'bg-purple-50 text-purple-700 border-purple-200' :
                      card.badgeColor === 'cyan' ? 'bg-cyan-50 text-cyan-700 border-cyan-200' :
                      card.badgeColor === 'orange' ? 'bg-orange-50 text-orange-700 border-orange-200' :
                      'bg-steel-50 text-steel-700 border-steel-200'
                    }`}>{seed}</span>
                  ))}
                </div>
              </div>
              <!-- Model as secondary info -->
              <div class="flex items-center gap-2 mb-3 pb-3 border-b border-steel-100">
                <span class="text-xs text-steel-400">Model</span>
                <span class={`font-bold text-base ${modelAccentColors[card.modelColor]}`}>{card.model}</span>
                <span class="text-xs text-steel-400 ml-auto">{card.seedHint}</span>
              </div>
              <p class="text-sm text-steel-600 leading-relaxed flex-1">{card.desc}</p>
              <div class="mt-3 flex items-center text-xs font-semibold text-amber-600 group-hover:text-amber-700 transition-colors">
                View Details
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Tab B: Pick by Scenario (kept EXACTLY as original) -->
      <div id="sel-tab-scenario" class="sel-tab-panel hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {scenarioCards.map(card => (
            <a href={card.href} class="relative bg-white border border-steel-100 rounded-2xl p-5 shadow-sm overflow-hidden hover:shadow-lg transition-all group">
              <span class={`absolute top-0 right-0 text-white text-[0.7rem] font-bold px-3 py-1 rounded-bl-xl ${badgeColors[card.badgeColor]}`}>{card.badge}</span>
              <div class="text-xs text-steel-500 mb-1">{card.subtitle}</div>
              <div class="font-black text-2xl text-steel-900 mb-2">
                {card.model.split(/(\d{3}[-/].*?|Double-Barrel|Specialty)/).map((part, i) => {
                  if (i % 2 === 1) {
                    return <span class={modelAccentColors[card.modelColor]}>{part}</span>;
                  }
                  return part;
                })}
              </div>
              <p class="text-sm text-steel-600 leading-relaxed">{card.desc}</p>
              <div class="mt-3 flex items-center text-xs font-semibold text-amber-600 group-hover:text-amber-700 transition-colors">
                View Details
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== NOTE: One model, many seeds ===== -->
  <section class="py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-green-50 via-white to-blue-50 rounded-2xl p-5 md:p-6 border-2 border-green-200">
        <div class="flex items-start gap-3 md:gap-4">
          <span class="shrink-0 text-2xl md:text-3xl">🫒</span>
          <div>
            <h3 class="font-display text-lg md:text-xl text-charcoal-900 font-bold mb-2">One model, many seeds</h3>
            <p class="text-steel-700 text-sm md:text-base leading-relaxed mb-3">
              Every standard 390 mm model presses peanut, rapeseed, sesame, tea seed, walnut, sunflower, flaxseed, and more. Hard seeds just need higher tonnage. If your seed isn't listed, <a href="/contact" class="text-amber-600 font-semibold hover:text-amber-700 underline underline-offset-2">contact us</a>.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">Peanut</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">Rapeseed</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">Sesame</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">Tea Seed</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">Walnut</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">Flaxseed</span>
              <span class="text-xs bg-white border border-green-200 text-green-700 px-2.5 py-1 rounded-md font-semibold">+More</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== QUICK TIPS (selection knowledge, before spec table) ===== -->
  <section class="py-6 md:py-8 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-5">
        <h2 class="font-display text-lg md:text-xl text-charcoal-900 font-bold mb-1">Selection tips</h2>
        <p class="text-steel-500 text-sm">Three things to know before comparing specs.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
