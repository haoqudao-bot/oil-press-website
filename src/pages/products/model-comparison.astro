  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Which model is best for sesame oil?',
      acceptedAnswer: { '@type': 'Answer', text: 'For sesame oil, we recommend the HN325/355 Sesame Special model. It features a smaller 300mm barrel diameter that creates higher cake pressure (47-51 Mpa/cm²), which is ideal for extracting maximum oil from small sesame seeds. The standard HN325 also works well for sesame.' },
    },
    {
      '@type': 'Question',
      name: 'What is the difference between cold press and standard models?',
      acceptedAnswer: { '@type': 'Answer', text: 'Cold press models (HN426, HN480) operate at higher system pressure (70 Mpa) and cake pressure (42-48 Mpa/cm²), allowing them to extract oil without heating the seeds. This preserves natural nutrients, flavor, and color — resulting in premium-grade oil that commands higher prices. Standard models use lower pressure and may require pre-heating seeds for optimal yield.' },
    },
    {
      '@type': 'Question',
      name: 'Should I choose single or double barrel?',
      acceptedAnswer: { '@type': 'Answer', text: 'If you are just starting out, a single barrel is sufficient and more affordable. For commercial operations, we strongly recommend double barrel — it nearly doubles your throughput while sharing the same hydraulic system, making it much more cost-effective per kg of oil produced.' },
    },
    {
      '@type': 'Question',
      name: 'Can the barrel size be customized?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes! The standard barrel inner diameter is 390mm and height is 800mm, but both can be customized to suit your specific oil seed and production requirements. For example, our sesame model uses a 300mm barrel for higher pressure, and our coconut model uses a 600mm barrel for larger volume.' },
    },
  ],
};

const allLd = [breadcrumbLd, faqLd];
---

<BaseLayout title="Hydraulic Oil Press Model Comparison | Haonuo Machinery" description="Compare all Haonuo hydraulic oil press models side by side. HN300 to HN500 specifications including pressing force, pressure, barrel size, and best applications." keywords={['hydraulic oil press comparison', 'oil press model comparison', 'HN325 vs HN426', 'cold press vs standard press']} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products" class="hover:text-amber-500 transition-colors">Products</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Oil Press Comparison</span>
      </nav>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-4">Hydraulic Oil Press Model Comparison</h1>
        <p class="text-steel-500 text-lg max-w-3xl mx-auto">Compare all Haonuo hydraulic oil press models side by side. Find the right machine for your oil seed type, production scale, and budget.</p>
      </div>

      <!-- Quick Guide -->
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-12">
        <h2 class="font-display text-xl text-charcoal-900 mb-4">How to Choose the Right Model</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="flex items-start gap-3">
            <span class="shrink-0 w-8 h-8 bg-amber-500 text-white rounded-lg flex items-center justify-center font-bold text-sm">1</span>
            <div>
              <h3 class="font-semibold text-charcoal-900 text-sm">By Oil Seed Type</h3>
              <p class="text-steel-600 text-sm">Soft seeds (sesame, peanut) → HN325/355. Hard seeds (walnut, almond) → HN426/480/500.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="shrink-0 w-8 h-8 bg-amber-500 text-white rounded-lg flex items-center justify-center font-bold text-sm">2</span>
            <div>
              <h3 class="font-semibold text-charcoal-900 text-sm">By Production Scale</h3>
              <p class="text-steel-600 text-sm">Startup/small → HN300/325 single barrel. Commercial → HN355/400 double barrel. Industrial → HN500 double barrel.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="shrink-0 w-8 h-8 bg-amber-500 text-white rounded-lg flex items-center justify-center font-bold text-sm">3</span>
            <div>
              <h3 class="font-semibold text-charcoal-900 text-sm">By Oil Quality</h3>
              <p class="text-steel-600 text-sm">Standard quality → Standard models. Premium cold-pressed → HN426/480 with higher cake pressure.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Comparison Table -->
      <div class="mb-16">
        <h2 class="font-display text-2xl text-charcoal-900 mb-6">Standard & High-Pressure Models</h2>
        <p class="text-steel-500 mb-6">
          <strong class="text-charcoal-900">All Haonuo hydraulic oil press machines are versatile</strong> — they can process most oil seeds including peanuts, sesame, rapeseed, tea seeds, walnuts, almonds, and more. 
          The "Recommended Seeds" column below highlights seeds for which each model is particularly optimized. 
          If your oil seed isn't listed, <a href="/contact" class="text-amber-600 hover:text-amber-700">contact us</a> — we can help you select the right machine.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
            <thead>
              <tr class="bg-steel-900 text-white">
                <th class="px-4 py-3 text-left text-sm font-semibold">Specification</th>
                {models.map(m => (
                  <th class={`px-3 py-3 text-center text-sm font-semibold whitespace-nowrap ${m.highlight ? 'bg-amber-500' : ''}`}>
                    <div>{m.model}</div>
                    <div class="text-xs font-normal opacity-80">{m.name}</div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Pressing Force</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.pressingForce}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">System Pressure</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.systemPressure}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Cake Pressure</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.cakePressure}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Barrel Diameter</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.barrelDiameter}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Barrel Height</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.barrelHeight}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Motor Power</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.motorPower}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Weight (Single/Double)</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700">{m.weight}</td>)}
              </tr>
              <tr class="border-b border-steel-100">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Dimensions (Single)</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-steel-700 text-xs">{m.dimensions}</td>)}
              </tr>
              <tr class="border-b border-steel-100 bg-amber-50/50">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Best For</td>
                {models.map(m => <td class="px-3 py-3 text-sm text-center text-amber-700 font-medium">{m.bestFor}</td>)}
              </tr>
              <tr>
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Recommended Seeds</td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <div class="flex flex-wrap gap-1 justify-center">
                      {m.seeds.slice(0, 3).map(seed => (
                        <span class="text-xs bg-green-50 text-green-700 px-1.5 py-0.5 rounded">{seed}</span>
                      ))}
                      {m.seeds.length > 3 && (
                        <span class="text-xs text-steel-400">+{m.seeds.length - 3}</span>
                      )}
                    </div>
                  </td>
                ))}
              </tr>
              <tr class="bg-steel-50/50">
                <td class="px-4 py-3 text-sm font-medium text-charcoal-900">Also Works With</td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <span class="text-xs text-steel-500">Most oil seeds</span>
                  </td>
                ))}
              </tr>
            </tbody>
            <tfoot>
              <tr class="bg-steel-50">
                <td class="px-4 py-3"></td>
                {models.map(m => (
                  <td class="px-3 py-3 text-center">
                    <a href={`/products/${m.slug}`} class="inline-flex items-center text-xs font-semibold text-amber-600 hover:text-amber-700 transition-colors">
                      View Specifications
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                  </td>
                ))}
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Specialty Models -->
      <div class="mb-16">
        <h2 class="font-display text-2xl text-charcoal-900 mb-6">Specialty Models</h2>
        <p class="text-steel-500 mb-6">Purpose-built machines for specific oil seeds and applications with optimized barrel design and pressing parameters.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {specialtyModels.map(m => (
            <a href={`/products/${m.slug}`} class="bg-white rounded-2xl border border-steel-100 p-6 hover:shadow-lg transition-shadow group">
              <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <h3 class="font-display text-lg text-charcoal-900 mb-1">{m.model}</h3>
              <p class="text-sm text-amber-600 font-medium mb-3">{m.name}</p>
              <div class="space-y-2 text-sm text-steel-600">
                <div class="flex justify-between">
                  <span>Pressing Force</span>
                  <span class="font-medium text-charcoal-900">{m.pressingForce}</span>
                </div>
                <div class="flex justify-between">
                  <span>Barrel Diameter</span>
                  <span class="font-medium text-charcoal-900">{m.barrelDiameter}</span>
                </div>
                <div class="flex justify-between">
                  <span>Cake Pressure</span>
                  <span class="font-medium text-charcoal-900">{m.cakePressure}</span>
                </div>
              </div>
              <div class="flex flex-wrap gap-1 mt-3">
                {m.seeds.map(seed => (
                  <span class="text-xs bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded">{seed}</span>
                ))}
              </div>
              <div class="mt-4 flex items-center text-amber-600 group-hover:text-amber-700 transition-colors text-sm font-medium">
                View Specifications
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Single vs Double Barrel -->
      <div class="mb-16">
        <h2 class="font-display text-2xl text-charcoal-900 mb-6">Single Barrel vs Double Barrel</h2>
        <p class="text-steel-500 mb-6">Most Haonuo models are available in both single and double barrel configurations. Double barrel machines double your throughput with shared hydraulic system.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl border border-steel-100 p-8">
            <div class="w-14 h-14 bg-steel-100 rounded-xl flex items-center justify-center mb-4">
              <span class="text-2xl font-bold text-steel-700">1</span>
            </div>
            <h3 class="font-display text-xl text-charcoal-900 mb-3">Single Barrel</h3>
            <ul class="space-y-2 text-steel-600">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Lower investment, ideal for startups</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Compact footprint, fits smaller workshops</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Batch processing: load → press → unload cycle</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Processing capacity: 100 kg per batch</span>
              </li>
            </ul>
          </div>
          <div class="bg-white rounded-2xl border-2 border-amber-400 p-8 relative">
