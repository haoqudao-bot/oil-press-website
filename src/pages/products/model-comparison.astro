                  </td>
                  <td class="px-3 py-3 text-center">Soft–Med</td>
                  <td class="px-3 py-3 text-center">
                    <div class="font-black text-lg text-steel-800">HN355 / HN400</div>
                  </td>
                  <td class="px-3 py-3 text-center">390 mm</td>
                  <td class="px-3 py-3 text-center font-semibold">≤ 100 kg</td>
