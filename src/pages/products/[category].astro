---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';
import { getCategoryContent, type CategoryContent } from '../../data/category-content';

export async function getStaticPaths() {
  const allCategories = await getCollection('categories');
  return allCategories.map(cat => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const t = getTranslations('en');

const allProducts = await getCollection('products');
const allCategories = await getCollection('categories');
const sortedCategories = allCategories.sort((a, b) => a.data.order - b.data.order);

const sortPriority: Record<string, number> = {
  'standard-hydraulic-oil-press': 1,
  'commercial-hydraulic-oil-press': 2,
  'cold-press-hydraulic-oil-press': 3,
  'ultra-high-pressure-hydraulic-oil-press': 4,
  'sesame-oil-hydraulic-press': 5,
  'coconut-oil-hydraulic-press': 6,
  'large-barrel-hydraulic-oil-press': 7,
  'ultra-high-pressure-cold-press': 8,
  'animal-fat-hydraulic-press': 9,
};

/* Old/previous-generation models shown in a collapsed archive section */
const archivedSlugs = [
  'mini-hydraulic-oil-press',
  'medium-hydraulic-oil-press',
  'heavy-duty-hydraulic-oil-press',
  'high-pressure-hydraulic-oil-press',
];
const hiddenOldSlugs = new Set(archivedSlugs);

/* Successor model shown on archive cards */
const successorLabel: Record<string, string> = {
  'mini-hydraulic-oil-press': 'HN325',
  'medium-hydraulic-oil-press': 'HN365',
  'heavy-duty-hydraulic-oil-press': 'HN426 / HN500',
  'high-pressure-hydraulic-oil-press': 'HN426 / HN500',
};

// Custom display order for non-hydraulic categories
const seedProcessingOrder: Record<string, number> = {
  'integrated-feeder-crusher-roaster': 1,
  'high-speed-seed-crusher': 2,
  'oilseed-pre-press': 3,
  'vertical-screw-conveyor': 4,
  'industrial-seed-crusher': 5,
};
const roastingOrder: Record<string, number> = {
  'automatic-drum-roaster': 1,
  'thermal-oil-roasting-pan': 2,
  'electric-seed-steamer': 3,
  'wood-fired-seed-steamer': 4,
};

const filteredProducts = allProducts.filter(p => p.data.category === category.slug && !hiddenOldSlugs.has(p.slug))
  .sort((a, b) => {
    if (category.slug === 'hydraulic-oil-press') {
      const orderA = sortPriority[a.slug] ?? 99;
      const orderB = sortPriority[b.slug] ?? 99;
      if (orderA !== orderB) return orderA - orderB;
    } else if (category.slug === 'seed-processing-equipment') {
      const orderA = seedProcessingOrder[a.slug] ?? 99;
      const orderB = seedProcessingOrder[b.slug] ?? 99;
      if (orderA !== orderB) return orderA - orderB;
    } else if (category.slug === 'roasting-steaming-equipment') {
      const orderA = roastingOrder[a.slug] ?? 99;
      const orderB = roastingOrder[b.slug] ?? 99;
      if (orderA !== orderB) return orderA - orderB;
    }
    const numA = parseInt(a.data.model.replace(/\D/g, '')) || 0;
    const numB = parseInt(b.data.model.replace(/\D/g, '')) || 0;
    return numA - numB;
  });

const categoryLabels: Record<string, string> = {
  'hydraulic-oil-press': t.products.hydraulicOilPress,
  'seed-processing-equipment': t.products.seedProcessing,
  'roasting-steaming-equipment': t.products.roastingSteaming,
  'filtration-refining-equipment': t.products.filtrationRefining,
};

// Hydraulic category is split into the four flagship core models and specialized/custom machines
const hydraulicCoreSlugs = [
  'standard-hydraulic-oil-press',
  'commercial-hydraulic-oil-press',
  'cold-press-hydraulic-oil-press',
  'ultra-high-pressure-hydraulic-oil-press',
];
const isHydraulicCategory = category.slug === 'hydraulic-oil-press';
const hydraulicCoreProducts = isHydraulicCategory
  ? hydraulicCoreSlugs.flatMap(slug => {
      const p = filteredProducts.find(pr => pr.slug === slug);
      return p ? [p] : [];
    })
  : [];
const hydraulicSpecializedProducts = isHydraulicCategory
  ? filteredProducts.filter(p => !hydraulicCoreSlugs.includes(p.slug))
  : [];
const productGroups = isHydraulicCategory
  ? [
      {
        badge: 'CORE RANGE',
        title: 'Core hydraulic oil presses',
        subtitle: 'The four flagship models most buyers choose — HN325 · HN365 · HN426 · HN500.',
        products: hydraulicCoreProducts,
      },
      {
        badge: 'SPECIALIZED & CUSTOM',
        title: 'Specialized & custom hydraulic presses',
        subtitle: 'Compact starters, previous generations and application-specific machines, made to order.',
        products: hydraulicSpecializedProducts,
      },
    ]
  : [{ badge: '', title: '', subtitle: '', products: filteredProducts }];

/* Previous-generation models for the hydraulic category archive section */
const previousProducts = isHydraulicCategory
  ? archivedSlugs.flatMap(slug => {
      const p = allProducts.find(pr => pr.slug === slug);
      return p ? [p] : [];
    })
  : [];

const categoryLabel = categoryLabels[category.slug] || category.data.name.en;

// Keywords mapping per category
const categoryKeywords: Record<string, string[]> = {
  'hydraulic-oil-press': ['hydraulic oil press', 'hydraulic oil press machine', 'cold press hydraulic oil press', 'hydraulic oil extractor', 'industrial hydraulic press', 'hydraulic press for oil extraction', 'cold press oil machine', 'hydraulic oil press price', 'double barrel hydraulic press', 'hydraulic seed press'],
  'seed-processing-equipment': ['seed processing equipment', 'seed crusher machine', 'seed grinding machine', 'oil seed processing', 'seed crushing machine', 'industrial seed crusher', 'seed mill equipment', 'seed preparation machine', 'oil seed crusher', 'seed processing plant'],
  'roasting-steaming-equipment': ['seed roasting machine', 'seed steamer', 'seed roasting pan', 'oil seed roaster', 'seed cooking machine', 'seed conditioning equipment', 'steam seed cooker', 'thermal seed roaster', 'electric seed steamer', 'seed pre-treatment machine'],
  'filtration-refining-equipment': ['oil filtration equipment', 'oil refining machine', 'oil filter press', 'edible oil refinery', 'oil purification system', 'oil decolorization machine', 'oil deodorization equipment', 'crude oil filter', 'oil processing equipment', 'edible oil refining plant'],
};
const pageKeywords = categoryKeywords[category.slug] || ['oil press equipment', 'oil processing machine'];

// ItemList JSON-LD
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${categoryLabel} - Haonuo Machinery`,
  description: category.data.description.en,
  numberOfItems: filteredProducts.length,
  itemListElement: filteredProducts.map((product, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: product.data.title.en,
    url: `https://www.hydoilpress.com/products/${product.slug}`,
  })),
};

// BreadcrumbList JSON-LD
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.hydoilpress.com/products' },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: `https://www.hydoilpress.com/products/${category.slug}` },
  ],
};

const catContent = getCategoryContent(category.slug, 'en') as CategoryContent | null;

const catFaqLd = catContent && catContent.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: catContent.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const allLd = [itemListLd, breadcrumbLd];
if (catFaqLd) allLd.push(catFaqLd);
---

<BaseLayout title={categoryLabel} description={category.data.description.en} keywords={pageKeywords} jsonLd={allLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products/" class="hover:text-amber-500 transition-colors">{t.products.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{categoryLabel}</span>
      </nav>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{categoryLabel}</h1>
      <p class="text-steel-300 text-lg max-w-2xl">{category.data.description.en}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filter -->
        <aside class="lg:w-56 shrink-0">
          <div class="sticky top-24 space-y-8">
            <div>
              <h2 class="font-display text-lg text-charcoal-900 mb-4">Category</h2>
              <nav class="space-y-1">
                <a
                  href="/products/"
                  class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  {t.products.allCategories}
                </a>
                {sortedCategories.map(cat => (
                  <a
                    href={`/products/${cat.slug}/`}
                    class:list={[
                      'block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors',
                      category.slug === cat.slug ? 'bg-amber-500 text-charcoal-900' : 'text-steel-600 hover:bg-steel-50'
                    ]}
                  >
                    {cat.data.name.en}
                  </a>
                ))}
              </nav>
            </div>

            <div class="pt-6 border-t border-steel-100">
              <nav class="space-y-1">
                <a
                  href="/hydraulic-oil-press-machine/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  <span>{t.common.hydraulicOilPressMachine}</span>
                </a>
                <a
                  href="/cold-press-oil-machine/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <span>{t.common.coldPressOilMachine}</span>
                </a>
                <a
                  href="/oil-machine-price/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  <span>Oil Machine Price Guide</span>
                </a>
                <a
                  href="/cold-press-oil-machine-price/"
                  class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-steel-600 hover:bg-steel-50"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-cyan-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  <span>Cold Press Machine Price</span>
                </a>
              </nav>
            </div>

            <div class="pt-6 border-t border-steel-100">
              <a
                href="/catalog/"
                class="flex items-center gap-3 px-4 py-3 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors group mb-2"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                <div>
                  <div class="text-sm font-semibold">{t.nav.catalog}</div>
                  <div class="text-xs opacity-70">{t.common.browseCatalog}</div>
                </div>
              </a>
              <a
                href="/products/model-comparison/"
                class="flex items-center gap-3 px-4 py-3 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 transition-colors group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                <div>
                  <div class="text-sm font-semibold">{t.nav.modelComparison}</div>
                  <div class="text-xs opacity-70">{t.common.compareAllModels}</div>
                </div>
              </a>
            </div>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="flex-1 space-y-12">
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {productGroups.map((group) => (
              <Fragment>
                {group.title && (
                  <div class="col-span-full pt-2">
                    <div class="border-t border-steel-200 pt-6">
                      <div class="inline-block text-xs font-bold tracking-widest text-amber-600 bg-amber-50 px-3 py-1 rounded-full mb-2">{group.badge}</div>
                      <h2 class="font-display text-2xl text-charcoal-900 font-bold">{group.title}</h2>
                      <p class="text-steel-500 text-sm mt-1">{group.subtitle}</p>
                    </div>
                  </div>
                )}
                {group.products.map((product) => (
                  <a
                    href={`/products/${product.slug}/`}
                    class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
                  >
                    <div class="aspect-[4/3] bg-steel-100 overflow-hidden relative">
                      <img
                        src={product.data.images[0]}
                        alt={product.data.title.en}
                        width="400"
                        height="300"
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo%20on%20white%20background%2C%20professional%20product%20photography&image_size=landscape_4_3'"
                      />
                      <div class="absolute inset-0 bg-steel-900/0 group-hover:bg-steel-900/20 transition-colors duration-300 flex items-center justify-center">
                        <span class="bg-amber-500 text-charcoal-900 px-4 py-2 rounded-lg font-medium text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                          {t.products.viewDetails}
                        </span>
                      </div>
                    </div>
                    <div class="p-5">
                      <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                      <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title.en}</h3>
                      <p class="text-sm text-steel-500 mb-3 line-clamp-2">{product.data.description?.en}</p>
                      <div class="flex flex-wrap gap-2 items-center">
                        {product.data.applicableSeeds.slice(0, 3).map(seed => (
                          <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded-full">
                            {seed}
                          </span>
                        ))}
                        <span class="text-xs text-steel-400">+ more</span>
                      </div>
                    </div>
                  </a>
                ))}
              </Fragment>
            ))}
          </div>

          {isHydraulicCategory && previousProducts.length > 0 && (
            <details class="archive-details border border-steel-200 rounded-2xl bg-steel-50/70">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5">
                <div>
                  <div class="inline-block text-xs font-bold tracking-widest text-steel-500 bg-white border border-steel-200 px-3 py-1 rounded-full mb-2">PREVIOUS MODELS</div>
                  <h2 class="font-display text-2xl text-charcoal-900 font-bold">Previous-generation models (archive)</h2>
                  <p class="text-steel-500 text-sm mt-1">HN300 · HN355 · HN400 · HN480 — superseded by the current HN325 · HN365 · HN426 · HN500 line, but still manufactured and supported.</p>
                </div>
                <span class="shrink-0 hidden sm:inline-flex items-center gap-2 text-sm font-medium text-amber-600">
                  <span class="archive-label-closed">Show previous models</span>
                  <span class="archive-label-open hidden">Hide</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform archive-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-steel-400 sm:hidden archive-chevron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="px-6 pb-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                  {previousProducts.map(product => (
                    <a
                      href={`/products/${product.slug}/`}
                      class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-200 group"
                    >
                      <div class="aspect-[4/3] bg-steel-100 overflow-hidden relative">
                        <img
                          src={product.data.images[0]}
                          alt={product.data.title.en}
                          width="400"
                          height="300"
                          loading="lazy"
                          class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-500"
                          onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo%20on%20white%20background%2C%20professional%20product%20photography&image_size=landscape_4_3'"
                        />
                        <span class="absolute top-3 left-3 bg-steel-700/90 text-white text-[11px] font-bold tracking-wide px-2.5 py-1 rounded-full">PREVIOUS GEN</span>
                      </div>
                      <div class="p-5">
                        <div class="text-xs text-steel-500 font-medium mb-1">{product.data.model}</div>
                        <h3 class="font-display text-xl text-charcoal-900 mb-2">{product.data.title.en}</h3>
                        <p class="text-xs text-amber-700 mb-2">Current model: <span class="font-semibold">{successorLabel[product.slug]}</span></p>
                        <p class="text-sm text-steel-500 mb-3 line-clamp-2">{product.data.description?.en}</p>
                        <div class="flex flex-wrap gap-2 items-center">
                          {product.data.applicableSeeds.slice(0, 3).map(seed => (
                            <span class="text-xs bg-steel-100 text-steel-600 px-2 py-0.5 rounded-full">
                              {seed}
                            </span>
                          ))}
                          <span class="text-xs text-steel-400">+ more</span>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </details>
          )}

          {filteredProducts.length === 0 && (
            <div class="text-center py-20">
              <p class="text-steel-400 text-lg">No products in this category</p>
            </div>
          )}

          {catContent && (
            <div class="pt-8 border-t border-steel-100">
              <!-- Category Overview -->
              <div class="mb-10">
                {catContent.overview.map((para, i) => (
                  <p class="text-steel-700 leading-relaxed mb-4" set:html={para}>{para}</p>
                ))}
              </div>

              <!-- Model Range -->
              <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Model Range</h2>
              <div class="mb-10 space-y-4">
                {catContent.modelRange.map((para, i) => (
                  <p class="text-steel-700 leading-relaxed">{para}</p>
                ))}
              </div>

              <!-- Selection Criteria -->
              <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Selection Criteria</h2>

              <!-- Mobile: stacked cards -->
              <div class="sm:hidden mb-10 space-y-3">
                {catContent.selectionCriteria.map((item, i) => (
                  <div class="bg-white rounded-xl border border-steel-100 shadow-sm p-4">
                    <div class="font-semibold text-amber-600 mb-2">{item.label}</div>
                    <div class="text-steel-700 text-sm leading-relaxed">{item.desc}</div>
                  </div>
                ))}
              </div>

              <!-- Desktop: table -->
              <div class="hidden sm:block mb-10 overflow-x-auto">
                <table class="w-full bg-white rounded-xl border border-steel-100 shadow-sm">
                  <thead class="bg-steel-50">
                    <tr>
                      <th class="px-4 py-3 text-left font-semibold text-charcoal-900">Factor</th>
                      <th class="px-4 py-3 text-left font-semibold text-charcoal-900">What to Consider</th>
                    </tr>
                  </thead>
                  <tbody>
                    {catContent.selectionCriteria.map((item, i) => (
                      <tr class={i % 2 === 0 ? 'bg-white' : 'bg-steel-50/50'}>
                        <td class="px-4 py-3 font-semibold text-amber-600 whitespace-nowrap">{item.label}</td>
                        <td class="px-4 py-3 text-steel-700">{item.desc}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- Process Position -->
              <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg mb-10">
                <p class="text-steel-700"><strong>Process position:</strong> {catContent.processPosition}</p>
              </div>

              <!-- FAQ -->
              <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">{categoryLabel} — {t.solutions.faq}</h2>
              <div class="space-y-3">
                {catContent.faq.map((item, i) => (
                  <details class="bg-steel-50 rounded-lg border border-steel-100 overflow-hidden">
                    <summary class="px-5 py-4 cursor-pointer font-semibold text-charcoal-900 hover:bg-steel-100 transition-colors">
                      {item.question}
                    </summary>
                    <div class="px-5 pb-4 text-steel-700 leading-relaxed">
                      {item.answer}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
