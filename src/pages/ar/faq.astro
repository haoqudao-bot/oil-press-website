---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';

const t = getTranslations('ar');

const title = 'الأسئلة الشائعة حول مكابس الزيت الهيدروليكية';
const description = 'إجابات على الأسئلة الشائعة حول مكابس الزيت الهيدروليكية، بما في ذلك التشغيل والصيانة واستكشاف الأخطاء وإصلاحها وإنتاج الزيت.';
const keywords = ['الأسئلة الشائعة حول مكابس الزيت', 'استكشاف أخطاء مكبس الزيت', 'صيانة المكبس الهيدروليكي'];

const faqCategories = [
  {
    id: 'operation',
    title: 'التشغيل والاستخدام',
    faqs: [
      {
        question: 'كيف يعمل مكبس الزيت الهيدروليكي؟',
        answer: 'يستخدم المكبس الهيدروليكي الضغط الهيدروليكي لاستخراج الزيت من البذور الزيتية. يتكون الماكينة من إطار رئيسي، واسطوانة هيدروليكية، وغرفة ضغط، ونظام تحكم. يتم تحميل البذور الزيتية في غرفة الضغط، ويطبق الاسطوانة الهيدروليكية ضغطًا متحكمًا لاستخراج الزيت. يتدفق الزيت عبر الفلاتر ويتم جمعه في خزان التخزين.'
      },
      {
        question: 'ما هو أقصى ضغط هيدروليكي؟',
        answer: 'تعمل مكابس الزيت الهيدروليكية الخاصة بنا بضغوط تتراوح بين 60 و 75 ميجاباسكال، حسب الطراز والتطبيق. يستخدم طراز HN325 ضغط 60 ميجاباسكال للتشغيل القياسي، بينما يمكن لطراز HN500 فائق الضغط أن يصل إلى 75 ميجاباسكال للمواد الصعبة مثل جوز الهند.'
      },
      {
        question: 'كم كمية الزيت يمكنني استخراجها لكل دفعة؟',
        answer: 'يعتمد إنتاج الزيت على نوع المادة ومحتوى الرطوبة ومعلمات الضغط. تشمل الإنتاجيات النموذجية: السمسم (45-54٪)، الفول السوداني (42-50٪)، القنب (38-45٪)، فول الصويا (18-22٪)، الجوز (45-50٪)، وجوز الهند (60-65٪). تعالج كل دفعة 100 كجم من المواد مع الطرازات القياسية.'
      },
      {
        question: 'كم يستغرق دورة الضغط؟',
        answer: 'تستغرق دورة الضغط النموذجية 30-90 دقيقة، بما في ذلك التحميل والضغط والتفريغ. يعتمد الوقت الدقيق على نوع المادة وحجم الدفعة وإعدادات الضغط. تعمل المكابس الهيدروليكية في وضع الدفعات، بخلاف مكابس اللولب التي تعمل بشكل مستمر.'
      },
      {
        question: 'هل يمكنني استخدام الماكينة للضغط البارد؟',
        answer: 'نعم! تم تصميم مكابس الزيت الهيدروليكية الخاصة بنا خصيصًا للضغط الساخن والبارد. للضغط البارد، يتم الحفاظ على درجة الحرارة تحت 60 درجة مئوية للحفاظ على النكهة والعناصر الغذائية الطبيعية للزيت. هذا مثالي للزيوت عالية الجودة والمنتجات العضوية.'
      }
    ]
  },
  {
    id: 'maintenance',
    title: 'الصيانة والرعاية',
    faqs: [
      {
        question: 'كم مرة يجب علي إجراء الصيانة؟',
        answer: 'نوصي بفحوصات يومية (مستوى الزيت، مقاس الضغط)، وصيانة أسبوعية (التنظيف، فحص الفلتر)، وفحص شهري (الخواتم الهيدروليكية، التوصيلات الكهربائية)، وإصلاح سنوي (التفكيك الكامل، استبدال الأجزاء البالية). الصيانة المنتظمة تطيل عمر الماكينة إلى 15-20 سنة.'
      },
      {
        question: 'ما الزيت الهيدروليكي الذي يجب استخدامه؟',
        answer: 'استخدم زيت هيدروليكي مضاد للتآكل بدرجة لزوجة ISO VG 46 (موصى به) أو ISO VG 32 للمناخات الباردة. يجب أن يفي الزيت بالمعيار DIN 51524-2 أو ما يعادله. احتفظ دائمًا بالزيت نظيفًا واستبدل الفلتر كل 500 ساعة تشغيل.'
      },
      {
        question: 'كيف أنظف غرفة الضغط؟',
        answer: 'بعد كل استخدام، امسح غرفة الضغط بقطعة قماش نظيفة لإزالة الزيت المتبقي وكعكة البذور. للتنظيف العميق، استخدم ماء دافئ مع منظف معتدل. لا تستخدم أبدًا المنظفات الكاشطة أو نفاثات الماء عالية الضغط على المكونات الهيدروليكية.'
      },
      {
        question: 'ما هي الأجزاء البالية الشائعة؟',
        answer: 'الأجزاء البالية الرئيسية هي: الخواتم الهيدروليكية (تستبدل كل 2000 ساعة)، عناصر الفلتر (كل 500 ساعة)، قماش الضغط (كل 3-6 أشهر)، وصمام تخفيف الضغط (كل 5000 ساعة). نحن نحافظ على مخزون كامل من قطع الغيار لجميع الطرازات.'
      }
    ]
  },
  {
    id: 'troubleshooting',
    title: 'استكشاف الأخطاء وإصلاحها',
    faqs: [
      {
        question: 'لا يبنى المكبس الضغط. ماذا يجب أن أفحص؟',
        answer: 'افحص أولاً مستوى الزيت الهيدروليكي - يجب أن يكون بين العلامتين الدنيا والقصوى على الخزان. بعد ذلك، افحص التسريبات في النظام الهيدروليكي (الخراطيم، الوصلات، الخواتم). تحقق من أن صمام تخفيف الضغط ليس عالقًا في وضع الفتح. إذا لم يبنى الضغط بعد ذلك، فقد تحتاج المضخة الهيدروليكية إلى فحص أو استبدال.'
      },
      {
        question: 'إنتاج الزيت أقل من المتوقع. لماذا؟',
        answer: 'يمكن أن يكون سبب انخفاض إنتاج الزيت: ضغط غير كافٍ (افحص مقاس الضغط)، إعدادات درجة حرارة خاطئة (ساخن جدًا أو بارد جدًا)، مادة غير محضرة بشكل صحيح (محتوى الرطوبة)، خواتم ضغط بالية، أو انسداد الفلتر. افحص هذه العوامل بشكل منهجي واضبط المعلمات وفقًا لذلك.'
      },
      {
        question: 'الماكينة تصدر أصواتًا غير عادية. هل هذا طبيعي؟',
        answer: 'بعض أصوات التشغيل طبيعية، لكن الأصوات غير العادية مثل الطحن أو الضرب أو الصفير تشير إلى مشاكل محتملة. افحص المكونات المفككة، التروس البالية، انخفاض مستوى الزيت الهيدروليكي، أو الهواء المحبوس في النظام. إذا استمر الصوت، أوقف الماكينة واتصل بفريق الدعم الفني الخاص بنا.'
      },
      {
        question: 'كيف أصلح تسرب الزيت الهيدروليكي؟',
        answer: 'حدد مصدر التسرب (خرطوم، وصلة، خاتم، أو اسطوانة). شد الوصلات المفككة، استبدل الخراطيم التالفة، وأصلح الخواتم البالية. قم دائمًا بتخفيف ضغط النظام قبل محاولة أي إصلاح. إذا كان التسرب من الاسطوانة الهيدروليكية، فيجب استبدال مجموعة الخواتم.'
      }
    ]
  },
  {
    id: 'technical',
    title: 'المواصفات الفنية',
    faqs: [
      {
        question: 'ما هو استهلاك الطاقة؟',
        answer: 'يختلف استهلاك الطاقة حسب الطراز: HN325 يستخدم 5.5 كيلووات، HN500 يستخدم 7.5 كيلووات، وHN800 يستخدم 11 كيلووات. يعتمد الاستهلاك الفعلي على ضغط التشغيل والحمل. المكابس الهيدروليكية هي بشكل عام أكثر كفاءة في استخدام الطاقة من مكابس اللولب للإنتاج الصغير والمتوسط.'
      },
      {
        question: 'ما هي أبعاد الماكينة؟',
        answer: 'HN325: 1200 x 800 x 1800 ملم (طول x عرض x ارتفاع)، الوزن 450 كجم. HN500: 1500 x 1000 x 2000 ملم، الوزن 680 كجم. HN800: 1800 x 1200 x 2200 ملم، الوزن 950 كجم. الأحجام المخصصة متاحة عند الطلب.'
      },
      {
        question: 'ما هي المتطلبات الكهربائية اللازمة؟',
        answer: 'تحتاج ماكيناتنا إلى مصدر طاقة ثلاثي الأطوار 400 فولت قياسي مع قاطع دائرة مخصص. يستخدم نظام التحكم 24 فولت تيار مستمر للسلامة. نوصي بتركيب مثبت جهد في المناطق ذات الإمداد غير المستقر. يجب أن يقوم كهربائي مؤهل بعمليات التثبيت.'
      },
      {
        question: 'هل يمكن استخدام الماكينة لعدة بذور زيتية؟',
        answer: 'نعم! مكابس الزيت الهيدروليكية الخاصة بنا متعددة الاستخدامات ويمكنها معالجة مجموعة واسعة من البذور الزيتية والمكسرات، بما في ذلك السمسم والفول السوداني والقنب وفول الصويا والجوز واللوز وجوز الهند وعباد الشمس وبذور الكتان وأكثر من ذلك. فقط اضبط إعدادات الضغط ودرجة الحرارة لكل مادة.'
      }
    ]
  },
  {
    id: 'commercial',
    title: 'التجارية والخدمة',
    faqs: [
      {
        question: 'ما هي فترة الضمان؟',
        answer: 'نقدم ضمانًا لمدة عام واحد على جميع مكابس الزيت الهيدروليكية، يغطي عيوب التصنيع وأعطال المكونات. يشمل الضمان الدعم الفني المجاني وقطع الغيار. الضمان الممتد متاح للشراء.'
      },
      {
        question: 'هل تقدمون التثبيت والتدريب؟',
        answer: 'نعم، نقدم خدمات التثبيت والتدريب الكاملة. للعملاء الدوليين، نقدم أدلة تثبيت مفصلة، ودروس فيديو، ودعمًا فنيًا عن بُعد. التثبيت في الموقع متاح برسم إضافي.'
      },
      {
        question: 'ما هو وقت التسليم؟',
        answer: 'الطرازات القياسية موجودة في المخزون ويمكن شحنها خلال 7-14 يومًا. تتطلب الطلبات المخصصة 30-45 يومًا للإنتاج. نقوم بالشحن في جميع أنحاء العالم عبر الشحن البحري (FCL/LCL) أو الشحن الجوي. يختلف وقت التسليم حسب الوجهة: 15-30 يومًا للشحن البحري، 3-7 أيام للشحن الجوي.'
      },
      {
        question: 'هل تقدمون قطع غيار لما بعد البيع؟',
        answer: 'نعم، نحافظ على مخزون كامل من قطع الغيار بما في ذلك الخواتم الهيدروليكية والفلاتر والخراطيم ومقاسات الضغط والمكونات الكهربائية. يمكن طلب قطع الغيار مباشرة أو عبر موزعينا المعتمدين. نقدم أيضًا مجموعات قطع الغيار للصيانة الروتينية.'
      }
    ]
  }
];

const allFaqs = faqCategories.flatMap(cat => cat.faqs);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://www.hydoilpress.com/ar' },
    { '@type': 'ListItem', position: 2, name: 'الأسئلة الشائعة', item: 'https://www.hydoilpress.com/ar/faq' }
  ]
};

const allLd = [faqLd, breadcrumbLd];
---

<BaseLayout title={title} description={description} keywords={keywords} jsonLd={allLd} locale="ar">
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/ar" class="hover:text-amber-500 transition-colors">الرئيسية</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <span class="text-charcoal-900 font-semibold">الأسئلة الشائعة</span>
      </nav>
    </div>
  </section>

  <!-- Header -->
  <section class="py-12 md:py-16 bg-gradient-to-br from-steel-50 to-amber-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-3xl md:text-5xl text-charcoal-900 mb-4">
        الأسئلة الشائعة
      </h1>
      <p class="text-lg text-steel-600 max-w-3xl mx-auto">
        اعثر على إجابات للأسئلة الأكثر شيوعًا حول مكابس الزيت الهيدروليكية، بما في ذلك التشغيل والصيانة واستكشاف الأخطاء وإصلاحها والمواصفات الفنية.
      </p>
    </div>
  </section>

  <!-- FAQ Categories -->
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        {faqCategories.map(cat => (
          <a
            href={`#${cat.id}`}
            class="px-4 py-2 rounded-full bg-steel-100 hover:bg-amber-500 hover:text-white text-steel-700 font-medium text-sm transition-colors"
          >
            {cat.title}
          </a>
        ))}
      </div>

      <!-- FAQ Sections -->
      {faqCategories.map(cat => (
        <section id={cat.id} class="mb-16 scroll-mt-24">
          <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 mb-6 pb-3 border-b border-steel-200">
            {cat.title}
          </h2>
          <div class="space-y-4">
            {cat.faqs.map((faq, index) => (
              <details
                class="group bg-white rounded-xl border border-steel-200 hover:border-amber-300 transition-colors shadow-sm overflow-hidden"
              >
                <summary class="flex items-start gap-4 p-5 cursor-pointer list-none">
                  <span class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500 text-charcoal-900 font-bold text-sm flex items-center justify-center group-open:rotate-45 transition-transform">
                    {index + 1}
                  </span>
                  <h3 class="font-display text-lg text-charcoal-900 flex-1">
                    {faq.question}
                  </h3>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-steel-400 group-open:rotate-180 transition-transform flex-shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="px-5 pb-5 pl-17 text-steel-600 leading-relaxed border-t border-steel-100 pt-4 ml-12">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}

      <!-- Contact CTA -->
      <section class="mt-16 bg-gradient-to-r from-steel-900 to-steel-700 rounded-2xl p-8 md:p-12 text-center">
        <h2 class="font-display text-2xl md:text-3xl text-white mb-4">
          هل لا تزال لديك أسئلة؟
        </h2>
        <p class="text-steel-300 mb-6 max-w-xl mx-auto">
          فريقنا الفني جاهز للمساعدة. اتصل بنا للحصول على نصائح مخصصة وعروض أسعار ودعم ما بعد البيع.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/ar/contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-amber-500 hover:bg-amber-600 text-charcoal-900 font-semibold rounded-lg transition-colors"
          >
            اتصل بنا
          </a>
          <a
            href="/ar/products"
            class="inline-flex items-center gap-2 px-6 py-3 border border-steel-500 hover:border-white text-white font-semibold rounded-lg transition-colors"
          >
            عرض المنتجات
          </a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
