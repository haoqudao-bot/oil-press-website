---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-buying-guide');
const t = getTranslations('ar');

const title = resource?.data.title.ar || resource?.data.title.en || 'دليل شراء مكبس الزيت الهيدروليكي';
const description = resource?.data.description.ar || resource?.data.description.en || 'استثمر في المكبس المناسب بثقة';
const seoKeywords = resource?.data.seoKeywords || ['دليل شراء مكبس الزيت', 'كيفية اختيار مكبس زيت', 'قائمة شراء مكبس الزيت'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/buying-guide-hero.webp',
  author: { '@type': 'Person', name: 'Eason', jobTitle: 'Senior Hydraulic Press Engineer', url: 'https://www.hydoilpress.com/about/', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.', url: 'https://www.hydoilpress.com' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/ar/' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/ar/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/ar/resources/hydraulic-oil-press-buying-guide/' },
  ],
};

const buyingChecklist = [
  { category: 'احتياجات الإنتاج', items: ['هدف الإنتاج اليومي (كجم/يوم)', 'أنواع المواد المراد معالجتها', 'جودة الزيت المطلوبة (بكر، طبخ، إلخ)', 'الحاجة إلى الضغط البارد؟'] },
  { category: 'المواصفات الفنية', items: ['الضغط الهيدروليكي (40-60 MPa مستحسن)', 'قوة المحرك (2.2 kW قياسي)', 'الجهد الكهربائي (220V أو 380V)', 'أبعاد الآلة ووزنها'] },
  { category: 'الجودة والضمان', items: ['سمعة الشركة المصنعة وخبرتها', 'فترة الضمان (سنة واحدة على الأقل)', 'توفر خدمة ما بعد البيع', 'توفر قطع الغيار'] },
  { category: 'اعتبارات التشغيل', items: ['سعة الإنتاج اليومية المستهدفة', 'تكاليف التركيب والتدريب', 'قطع الغيار والصيانة', 'تكاليف التشغيل (الطاقة، العمالة)'] },
];

const questionsToAsk = [
  'ما هو هدفك الإنتاجي اليومي؟',
  'ما هي البذور/المكسرات التي ستعالجها؟',
  'هل تحتاج إلى قدرة الضغط البارد؟',
  'ما هو هدفك الإنتاجي السنوي؟',
  'هل لديك مصدر طاقة؟',
  'ما هو مساحة العمل المتاحة؟',
  'هل تحتاج إلى دعم التدريب والتركيب؟',
  'ما هو سوق الزيت المستهدف (بكر، طبخ، تجميلي)؟',
];

const redFlags = [
  'سعر منخفض بشكل غير واقعي',
  'لا يوجد ضمان',
  'لا توجد خدمة ما بعد البيع',
  'موقع الشركة المصنعة غير معروف',
  'لا توجد وثائق تقنية',
  'الضغط أقل من 40 MPa',
  'معدات مستعملة/مجددة',
];

function localePath(path: string): string {
  return `/ar${path}`;
}
---

<BaseLayout locale="ar" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/resources/')} class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">دليل الشراء</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">فريق هندسة هاونو</div>
            <div class="text-sm text-steel-500">مهندس مكبس زيت أول · +15 سنة من الخبرة</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">ما يجب معرفته قبل شراء معصرة زيت هيدروليكية</h2>
        <p class="text-steel-700 leading-relaxed mb-4">يعد الاستثمار في مكبس زيت هيدروليكي قراراً مهماً يمكنه تحويل أعمال إنتاج الزيت الخاصة بك. يغطي هذا الدليل الشامل كل ما تحتاج إلى معرفته لاتخاذ قرار الشراء الصحيح.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic">يمكن للمكبس الجيد أن يدفع ثمنه في 1-3 أشهر. أما الشراء السيئ فييمكن أن يؤدي إلى سنوات من الإحباط وخسارة الإيرادات. سيساعدك هذا الدليل على تجنب الأخطاء المكلفة.</p>
        </div>
      </section>

      <section id="checklist" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">قائمة الفحص قبل شراء معصرة الزيت الهيدروليكية</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {buyingChecklist.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-md overflow-hidden">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <h3 class="font-semibold text-white flex items-center gap-2">
                  <span class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.category}
                </h3>
              </div>
              <div class="p-5">
                <ul class="space-y-2">
                  {item.items.map((item2, idx) => (
                    <li key={idx} class="flex items-start gap-3">
                      <div class="w-5 h-5 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                      </div>
                      <span class="text-steel-700 text-sm">{item2}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="models" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">اختيار موديل معصرة الزيت الهيدروليكية المناسب</h2>
        <p class="text-steel-600 mb-6">يعتمد الموديل المناسب على <strong>نوع البذور الرئيسي</strong> (البذور اللينة تحتاج ضغطاً أقل؛ الجوز الصلب وجوز الهند بقشرته يحتاجان قوة أعلى)، و<strong>هدف الإنتاج اليومي</strong>، وما إذا كان الإنتاج غالباً <strong>بارداً أم ساخناً</strong>.</p>
        <p class="text-steel-600 mb-6">يغطي هذا الدليل الأسئلة التي يجب طرحها على <em>أي</em> مورد. للحصول على مقارنة مباشرة لكامل سلسلة هاونو (من HN300 إلى HN500) مع المواصفات الفعلية والتوصيات حسب نوع البذور، راجع صفحة <a href="/ar/products/model-comparison/" class="text-amber-600 hover:underline font-semibold">مقارنة الموديلات</a>. وللاطلاع السريع على كامل الماكينات الهيدروليكية، تفضل بزيارة <a href="/ar/hydraulic-oil-press-machine/" class="text-amber-600 hover:underline font-semibold">دليل شراء المكابس الهيدروليكية</a>.</p>
      </section>

      <section id="questions" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">أسئلة تطرحها على مورد معصرة الزيت</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {questionsToAsk.map((question, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-xl border border-blue-100 flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{index + 1}</div>
              <p class="text-steel-700">{question}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="red-flags" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">إشارات تحذيرية عند شراء معصرة الزيت</h2>
        <div class="bg-red-50 rounded-xl border border-red-200 p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {redFlags.map((flag, index) => (
              <div key={index} class="bg-white p-3 rounded-lg flex items-center gap-3 border border-red-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="text-steel-700">{flag}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="total-cost-ownership" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">التكلفة الإجمالية للملكية</h2>
        <p class="text-steel-700 leading-relaxed mb-4">سعر الآلة المعلن عادةً لا يمثل سوى 60–75% من التكلفة الكلية للوصول والتشغيل في السنة الأولى. فالشحن ورسوم الموانئ والرسوم الجمركية والتركيب الكهربائي وأعمال الأساسات والتشغيل التجريبي وتدريب المشغلين وحزمة قطع الغيار الأولية كلها تُضاف إلى الفاتورة، والآلة الرخيصة التي تفتقر إلى دعم محلي كثيراً ما تصبح أغلى عرض على الطاولة. لذلك تبدأ معرفة كيفية اختيار معصرة زيت بالفاتورة الإجمالية، لا بالرقم الأول المذكور.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">اطلب من كل مورد في قائمتك القصيرة تسعير النطاق نفسه</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>سعر الآلة مع إعداد أسطوانة العصر الدقيق — فأسطوانة العصر المفردة أو المزدوجة تغيّر السعر والإنتاجية معاً.</li>
            <li>قطع الغيار القياسية الموردة مع الآلة وسعر طقم سنوي موصى به.</li>
            <li>نطاق لوحة الكهرباء: ما هو موصول مسبقاً على الآلة وما يجب على العميل تركيبه.</li>
            <li>دعم التركيب: إرشاد عن بُعد أو فني في الموقع، ومن يدفع تكاليف السفر والأيام.</li>
            <li>شروط الضمان: المدة، وما يغطيه، وكيف تُعالج المطالبات عبر الحدود.</li>
            <li>التسليم بعدد أسابيع مقابل تاريخ عربون محدد، لا ادعاءات "متوفر في المخزون".</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">قارن الإجماليات الناتجة، لا السطر الأول. فسعر آلة أقل بنسبة 10% يتبخر في أسبوع واحد من تأخر التشغيل التجريبي أو طقم مانعات تسرب واحد يُشحن جواً.</p>
      </section>

      <section id="verifying-manufacturer" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">التحقق من الشركة المصنعة قبل الدفع</h2>
        <p class="text-steel-700 leading-relaxed mb-4">صور المصنع في الكتيبات مجانية؛ أما الدليل فليس كذلك. قبل دفع العربون، تحقق من الشركة المصنعة بالجدية نفسها التي تطبقها على مواصفات الآلة.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>اطلب جولة فيديو مباشرة في الورشة تُظهر الطراز الذي تشتريه أثناء التجميع، لا صالة عرض.</li>
          <li>اطلب اسمين أو ثلاثة عملاء مرجعيين في أسواق مماثلة وتواصل معهم حول دعم التركيب، لا حول جودة الآلة فقط.</li>
          <li>تحقق من أن تصنيف الضغط وسُمك الفولاذ وعلامة المحرك في عرض السعر تطابق ما نوقش شفهياً — فآلات فئة HN تعمل من 325 طناً / 60 ميجاباسكال فما فوق بمحركات 2.2–3 كيلوواط، وأوراق المواصفات الغامضة علامة تحذير.</li>
          <li>تأكد من لوحات بيانات تحمل أرقاماً تسلسلية، وشهادة ضغط مختومة لأسطوانة العصر والأسطوانة الهيدروليكية، ووثائق كهربائية بلغة يستطيع كهربائيك قراءتها.</li>
          <li>ادفع عبر أدوات تجارية قابلة للتتبع بهيكل محدد للعربون والرصيد مرتبط بمراحل الفحص والشحن؛ وتجنب الدفع الكامل مقدماً أو الضغط للدفع خارج المنصة.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed mt-4">تنتمي أساليب الضغط أيضاً إلى قائمة إشارات التحذير هذه. فالبائع الذي يصر على عربون فوري، أو يرفض تدوين المواصفات وتواريخ التسليم المتفق عليها، أو يعيد كل سؤال تقني إلى "ثق بنا، نحن نصدر إلى كل مكان"، يبيع الثقة لا المعدات. الشركات المصنعة الشرعية مرتاحة للأسئلة والمراجع والمراحل — لأن آلة جيدة البناء ومصنعاً موثقاً يصمدان أمام الثلاثة جميعاً.</p>
      </section>

      <section id="installation-training" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">التركيب والتدريب والشهر الأول</h2>
        <p class="text-steel-700 leading-relaxed mb-4">المورد الجيد يعامل التسليم كمنتصف الصفقة، لا نهايتها. اتفق قبل الطلب على ما يشمله دعم التشغيل التجريبي: تحديد موضع الآلة وتثبيتها، والتوصيل الهيدروليكي والكهربائي، وأول تجارب العصر ببذورك الفعلية، وضبط الضغط والتوقيت، وتدريب المشغلين على التحميل والتثبيت والتفريغ والتنظيف وروتين الفحص اليومي.</p>
        <p class="text-steel-700 leading-relaxed mb-4">خطّط للشهر الأول بتأنٍّ: شغّل بذرة واحدة ووصفة واحدة، واحتفظ بسجلات الدفعات، وتحقق من الزيت المتبقي في الكسب مقابل الرقم الذي يذكره المورد — 6–8% لأسطوانة العصر المشقّقة للضغط البارد، ونحو 5–7% للضغط الساخن المُدار جيداً. فالمشكلات التي تُقبل بصمت في الشهر الأول تصبح "طبيعية" بحلول الشهر السادس. أما اختيار الحجم والطراز المناسب لحجم العمل نفسه — HN325 للإنتاج صغير الدفعات والمبتدئ، وHN365 لأحجام يومية أكبر، وHN426 للضغط البارد المخصص، وHN500 للأحمال الأثقل — فمبيّن في <a href="/ar/products/" class="text-amber-600 hover:underline">مجموعة منتجاتنا</a>، ومتطلبات المنشأة والطاقة مفصلة في <a href="/ar/resources/oil-press-electrical-requirements-guide/" class="text-amber-600 hover:underline">دليل المتطلبات الكهربائية</a>.</p>
        <h3 class="font-semibold text-lg mb-3 text-charcoal-900">الآلات المستعملة وتوقيت التسليم</h3>
        <p class="text-steel-700 leading-relaxed mb-4">يمكن أن تكون المعصرة الهيدروليكية المستعملة قيمة ممتازة لأن الإطار ووعاء الضغط يعيشان أطول من عدة أجيال من المانعات ولوحات التحكم — لكن فقط عندما يكون تاريخها قابلاً للتحقق. افحص حالة أسطوانة العصر والأسطوانة الهيدروليكية، واطلب سجلات الصيانة وتحليل الزيت، واختبر الضغط قبل الشراء، وأدرج في المقارنة مع الجديد تكلفة تجديد كامل للمانعات والخراطيم والنظام الكهربائي. أما الآلة المستعملة التي تُباع دون سجلات، فهي وعاء ضغط مجهول لا تقف خلفه أي شركة مصنعة، والوفر نادراً ما ينجو من أول إعادة تأهيل.</p>
        <p class="text-steel-700 leading-relaxed">وأخيراً، خطّط لتوقيت الشراء وفق البذور لا وفق العاطفة. فالطلب في بداية موسم الحصاد يعني التنافس على أماكن المصنع والشحن بينما تنتظر أرخص مادة خام في الساحة؛ والورش الأفضل إدارة تقدم طلباتها بحيث ينتهي التشغيل التجريبي قبل موسم الشراء، وتقضي الأشهر الهادئة في التدريب وتشغيل دفعات تجريبية على بذور أرخص.</p>
      </section>

