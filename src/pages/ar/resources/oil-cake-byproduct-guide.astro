---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';

const t = getTranslations('ar');

const title = 'دليل استغلال المنتجات الثانوية لقالب الزيت';
const description = 'دليل شامل لتحقيق أقصى القيمة من منتجات القالب الزيتية الثانوية';
const seoKeywords = ['استغلال القالب', 'استخدامات القالب الفول الصنوبري', 'إدارة المنتجات الثانوية'];
const publishedAt = new Date();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/cake-byproduct-hero.webp',
  author: { '@type': 'Person', name: 'فريق هندسة هاونو', jobTitle: 'مهندس مكبس زيت رئيسي', worksFor: { '@type': 'Organization', name: 'مجموعة شاندونغ هاونو للمعدات الميكانيكية المحدودة' } },
  publisher: { '@type': 'Organization', name: 'هاونو الميكانيكا', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://www.hydoilpress.com/ar/' },
    { '@type': 'ListItem', position: 2, name: 'الموارد', item: 'https://www.hydoilpress.com/ar/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/ar/resources/oil-cake-byproduct-guide' },
  ],
};

const nutritionalAnalysis = [
  { component: 'البروتين', peanut: '45-50%', sesame: '35-40%', rapeseed: '38-42%', soybean: '40-45%' },
  { component: 'الدهون', peanut: '6-10%', sesame: '8-12%', rapeseed: '3-6%', soybean: '1-3%' },
  { component: 'الألياف', peanut: '8-12%', sesame: '6-8%', rapeseed: '10-15%', soybean: '5-8%' },
  { component: 'الكربوهيدرات', peanut: '20-25%', sesame: '25-30%', rapeseed: '25-30%', soybean: '25-30%' },
  { component: 'الرماد', peanut: '5-7%', sesame: '5-7%', rapeseed: '6-8%', soybean: '5-7%' },
];

const keyNutrients = [
  { icon: 'droplet', title: 'البروتين', desc: 'بروتين نباتي عالي الجودة لغذاء الحيوانات' },
  { icon: 'dna', title: 'الأحماض الأمينية', desc: 'يحتوي على أحماض أمينية أساسية مثل الليسين والميثيونين' },
  { icon: 'gem', title: 'المعادن', desc: 'غني بالفوسفور والكالسيوم والمغنيسيوم والبوتاسيوم' },
  { icon: 'sun', title: 'الفيتامينات', desc: 'فيتامينات المجموعة ب، فيتامين إ' },
];

const poultryFeed = { benefits: ['البروتين العالي يُعزز النمو وإنتاج البيض', 'مصدر طاقة جيد', 'بديل اقتصادي لفلفل الصويا'], inclusion: ['الدجاجة الدائمة: 10-20% من النظام الغذائي', 'الدجاجة البياض: 8-15% من النظام الغذائي', 'الديك الرومي: 10-18% من النظام الغذائي'] };
const livestockFeed = { benefits: ['يُحسن إنتاج الحليب في البقرة الدائمة', 'يُعزز زيادة الوزن في البقرة اللحمية', 'مناسب للغنم والماعز'], inclusion: ['البقرة الدائمة: 15-25% من مزيج المُركّز', 'البقرة اللحمية: 10-20% من النظام الغذائي', 'الغنم/الماعز: 10-15% من النظام الغذائي'] };
const aquacultureFeed = { benefits: ['بروتين عالي لنمو الأسماك', 'بديل مستدام لفلفل السمك', 'هضم جيد'], inclusion: ['التيلابيا: 15-25%', 'سمك القط: 10-20%', 'الجمبري: 10-15%'] };
const swineFeed = { benefits: ['يُعزز زيادة الوزن', 'يُحسن نسبة تحويل الأغذية', 'اقتصادي'], inclusion: ['الخنازير النامية: 10-20%', 'الخنازير النهائية: 8-15%', 'الخنازير الصنوبرية: 10-15%'] };

const traditionalUses = [
  { name: 'قالب الفول الصنوبري (كولي كولي)', desc: 'وجبة خفيفة شائعة في غرب إفريقيا (نيجيريا، غانا). كرات القالب المقليّة. عالية البروتين، كثيفة الطاقة.' },
  { name: 'إنتاج التمبيه', desc: 'قالب الصويا المخمّر. طعام إندونيسي تقليدي. قيمة غذائية عالية.' },
];

const modernUses = [
  { name: 'عزل البروتين', desc: 'بروتين مستخرج للمنتجات الغذائية. يستخدم في بدائل اللحم النباتي. مكملات بروتينية.' },
  { name: 'المنتجات الخالية من الغلوتين', desc: 'دقيق القالب للخبز الخالي من الغلوتين. محتوى عالي من الألياف. غني بالعناصر الغذائية.' },
];

const organicFertilizer = { benefits: ['مصدر نيتروجين نزول بطيء', 'يُحسن بنية التربة', 'يُعزز النشاط الميكروبي للتربة'], methods: ['التطبيق المباشر: 500-1000 كغ/هكتار', 'التسميد: مزج مع النفايات العضوية', 'المخترع السائل: استخلاص العناصر الغذائية'] };
const soilAmendment = { benefits: ['يُحسن الاحتفاظ بالماء', 'يُعزز تهوية التربة', 'يزيد من قدرة التبادل المائي'] };
const animalBedding = { benefits: ['مادة امتصاصية', 'اقتصادية', 'يمكن تسقيحها بعد الاستخدام'] };

const biogasProduction = { process: ['مزج القالب بالماء', 'الهضم اللاهوائي', 'إنتاج البيوجاز (الميثان)', 'الاستخدام لإنتاج الطاقة'], yield: ['200-300 م3 بيوجاز لكل طن من القالب', '50-60% محتوى الميثان'] };
const biofuelProduction = { process: ['استخلاص الزيت المتبقي', 'التحويل إلى بيوديزل', 'الاستخدام كوقود نقل'] };
const activatedCarbon = { process: ['كربنة القالب', 'تنشيط بالبخار أو المواد الكيميائية', 'الاستخدام للفلترة والتنقية'] };

const crushingEquipment = ['مطحنة الصنوبر', 'مطحنة الأسطوانة', 'مطحنة الأقراص'];
const particleSizes = [
  { use: 'غذاء الحيوانات', size: '1-3 مم' },
  { use: 'المخترع', size: '2-5 مم' },
  { use: 'صناعي', size: 'مسحوق دقيق' },
];

const pelletizingInfo = { benefits: ['معالجة محسنة', 'غبار مخفض', 'كثافة حجمية أعلى'], equipment: ['مكبس اللُباد بالقالب المسطحة', 'مكبس اللُباد بالقالب الدائري'], size: '4-8 مم قطر' };

const valueAddedProducts = [
  { title: 'استخلاص الزيت المتبقي', desc: 'استخلاص بالمذيب، استخلاص CO2 فوق الحرجة، استعادة زيت إضافي 2-3%' },
  { title: 'استخلاص البروتين', desc: 'استخلاص قلوي، ترسيب حمضي، إنتاج عزل بروتيني' },
  { title: 'استخلاص المركبات النباتية', desc: 'مضادات الأكسدة، الفيتوستيرولات، الصابونات' },
];

const qualityControl = [
  { parameter: 'محتوى البروتين', standard: '> 40%', method: 'طريقة كيجلد' },
  { parameter: 'الرطوبة', standard: '< 12%', method: 'الجفاف في الفرن' },
  { parameter: 'الرماد', standard: '< 8%', method: 'الاحتراق' },
  { parameter: 'الأفلوتوكسين', standard: '< 20 µg/kg', method: 'HPLC' },
  { parameter: 'الأحماض الدهنية الحرة', standard: '< 2%', method: 'ال титر' },
];

const storageRequirements = ['تخزين جاف ومتوفر الهواء', 'درجة الحرارة < 25 درجة مئوية', 'رطوبة względية < 65%', 'استخدام أكياس مقاومة للرطوبة'];

const marketValue = [
  { application: 'غذاء الحيوانات', price: 'اتصل للحصول على الأسعار' },
  { application: 'مخترع عضوي', price: 'اتصل للحصول على الأسعار' },
  { application: 'غذاء بشري', price: 'اتصل للحصول على الأسعار' },
  { application: 'صناعي', price: 'اتصل للحصول على الأسعار' },
];

const profitExample = [
  'إنتاج 100 طن/شهر',
  'معدل القالب: 55 طن/شهر',
  'إمكانية إيراد إضافي كبير',
  'هامش الأرباح يزداد مع المعالجة',
  'يعتمد على أسعار السوق ومستوى المعالجة',
];

const investmentRequirements = [
  { level: 'تكسير أساسي', investment: 'اتصل للحصول على الأسعار', capacity: '50-100 طن' },
  { level: 'لُباد', investment: 'اتصل للحصول على الأسعار', capacity: '100-300 طن' },
  { level: 'معالجة مضافة القيمة', investment: 'اتصل للحصول على الأسعار', capacity: '200-500 طن' },
];

const wasteReduction = ['القالب هو مورد قيم، ليس نفايات', 'الاستخدام السليم يقلل من النفايات في المقابر', 'نهج الاقتصاد الدائري'];
const sustainability = ['مورد متجدد', 'قابل للتحلل الحيوي', 'إنتاج محايد الكربون'];
const pollutionControl = ['التخزين السليم يمنع نمو العفن', 'التحكم في الغبار أثناء المعالجة', 'معالجة مياه الصرف الصحي لعملية الاستخلاص'];

const caseStudy = [
  'القدرة اليومية: 1000 كجم الفول الصنوبري',
  'معدل الزيت: 45% = 450 كجم زيت',
  'معدل القالب: 55% = 550 كجم قالب',
  '400 كجم قالب مبيع كغذاء حيوان',
  '150 كجم قالب معالج لصنع لُباد',
  'إيراد القالب الشهري: ~4500 دولار',
  'تكاليف التخلص من النفايات مخفضة',
  'الربحية العامة محسنة',
  'نموذج أعمال مستدام',
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="ar">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/ar" class="hover:text-amber-500 transition-colors">الرئيسية</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/ar/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">دليل الاستغلال</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">فريق هندسة هاونو</div>
            <div class="text-sm text-steel-500">مهندس مكبس زيت رئيسي · أكثر من 15 عامة من الخبرة</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">المقدمة</h2>
        <p class="text-steel-700 leading-relaxed">قالب الزيت هو البقايا الصلبة المتبقية بعد استخلاص الزيت من البذور الزيتية. هذا المنتج الثانوي القيم يمثل حوالي 50-60% من وزن البذرة الأصلي ويحتوي على مستويات عالية من البروتين والألياف والعناصر الغذائية الأخرى. الاستخدام المناسب للقالب يمكن أن يحسن بشكل كبير الربحية العامة لأعمال إنتاج الزيت.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>القالب ليس نفايات - هو مورد قيم يمكن أن يزيد من أرباحك.</p>
        </div>
      </section>

      <section id="composition" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">فهم تركيب قالب الزيت</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">التحليل الغذائي</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-amber-500 to-orange-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">المكون</th><th class="px-4 py-3 text-left font-semibold">قالب الفول الصنوبري</th><th class="px-4 py-3 text-left font-semibold">قالب السمسم</th><th class="px-4 py-3 text-left font-semibold">قالب الكولزا</th><th class="px-4 py-3 text-left font-semibold">قالب الصويا</th></tr>
            </thead>
            <tbody>
              {nutritionalAnalysis.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-amber-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.component}</td>
                  <td class="px-4 py-3 text-steel-600">{item.peanut}</td>
                  <td class="px-4 py-3 text-steel-600">{item.sesame}</td>
                  <td class="px-4 py-3 text-steel-600">{item.rapeseed}</td>
                  <td class="px-4 py-3 text-steel-600">{item.soybean}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">العناصر الغذائية الرئيسية</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {keyNutrients.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center mb-3">
                {item.icon === 'droplet' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S6 13 6 15a7 7 0 0 0 7 7z"/></svg>}
                {item.icon === 'dna' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 10c0 3.866-3.582 7-8 7a8.841 8.841 0 0 1-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM12 14c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/></svg>}
                {item.icon === 'gem' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>}
                {item.icon === 'sun' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>}
              </div>
              <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
              <p class="text-steel-600 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="animal-feed" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">تطبيقات تغذية الحيوانات</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-green-50 p-5 rounded-xl border border-green-100">
            <h3 class="font-semibold text-green-800 mb-3">تغذية الطيور</h3>
            <h4 class="font-medium text-steel-700 mb-2">المزايا:</h4>
            <ul class="space-y-1 text-sm text-steel-600 mb-4">
              {poultryFeed.benefits.map((item, index) => (
                <li key={index}>{item}</li>
              ))}
            </ul>
            <h4 class="font-medium text-steel-700 mb-2">التضمين المقترح:</h4>
            <ul class="space-y-1 text-sm text-steel-600">
              {poultryFeed.inclusion.map((item, index) => (
                <li key={index}>{item}</li>
              ))}
            </ul>
          </div>
          <div class="bg-blue-50 p-5 rounded-xl border border-blue-100">
            <h3 class="font-semibold text-blue-800 mb-3">تغذية الماشية</h3>
            <h4 class="font-medium text-steel-700 mb-2">المزايا:</h4>
            <ul class="space-y-1 text-sm text-steel-600 mb-4">
              {livestockFeed.benefits.map((item, index) => (
                <li key={index}>{item}</li>
              ))}
            </ul>
            <h4 class="font-medium text-steel-700 mb-2">التضمين المقترح:</h4>
            <ul class="space-y-1 text-sm text-steel-600">
              {livestockFeed.inclusion.map((item, index) => (
                <li key={index}>{item}</li>
              ))}
            </ul>
          </div>
          <div class="bg-cyan-50 p-5 rounded-xl border border-cyan-100">
            <h3 class="font-semibold text-cyan-800 mb-3">تغذية الأحياء المائية</h3>
            <h4 class="font-medium text-steel-700 mb-2">المزايا:</h4>
            <ul class="space-y-1 text-sm text-steel-600 mb-4">
              {aquacultureFeed.benefits.map((item, index) => (
                <li key={index}>{item}</li>
              ))}
            </ul>
            <h4 class="font-medium text-steel-700 mb-2">التضمين المقترح:</h4>
            <ul class="space-y-1 text-sm text-steel-600">
              {aquacultureFeed.inclusion.map((item, index) => (
