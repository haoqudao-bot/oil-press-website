---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'aflatoxin-control-guide');
const t = getTranslations('ar');

const title = resource?.data.title.ar || resource?.data.title.en || 'دليل مراقبة الأفلاتوكسين';
const description = resource?.data.description.ar || resource?.data.description.en || 'إستراتيجيات شاملة لمنع ومراقبة تلوث الأفلاتوكسين في بذور الزيت';
const seoKeywords = resource?.data.seoKeywords || ['مراقبة الأفلاتوكسين', 'منع الأفلاتوكسين', 'سلامة الغذاء'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/aflatoxin-guide-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' },
  },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/ar' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/ar/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/ar/resources/aflatoxin-control-guide' },
  ],
};

const typesOfAflatoxins = [
  { type: 'الأفلاتوكسين B1', danger: 'مُسمٍّ جداً', sources: 'الذرة، الفول السوداني، الأرز', effects: 'مسرطنة، تآكل الكبد' },
  { type: 'الأفلاتوكسين B2', danger: 'مُسمٍّ', sources: 'الفول السوداني، الذرة', effects: 'أقل سمية من B1' },
  { type: 'الأفلاتوكسين G1', danger: 'مُسمٍّ', sources: 'الحبوب، المكسرات', effects: 'مسرطنة' },
  { type: 'الأفلاتوكسين G2', danger: 'أقل سمية', sources: 'الحبوب', effects: 'آثار طفيفة' },
];

const contaminationSources = [
  { title: 'ظروف التخزين الرطبة', desc: 'التخزين في مناطق رطبة أو منحلة تعزز النمو الفطري' },
  { title: 'مدة التخزين الطويلة', desc: 'كلما طالت مدة تخزين الحبوب، زاد المخاطر' },
  { title: 'الظروف المناخية', desc: 'درجات الحرارة المرتفعة والرطوبة العالية تعزز النمو' },
  { title: 'قبل الحصاد', desc: 'الطقس الرطب قبل الحصاد يمكن أن يلوث المحاصيل' },
];

const preventionStrategies = [
  { title: 'مراقبة الحبوب', items: ['التحقق من الجودة قبل الشراء', 'تجنب الحبوب التالفة أو العفنة', 'اختبار الدفاتر على الأفلاتوكسين'] },
  { title: 'التخزين المناسب', items: ['الاحتفاظ في ظروف جافة', 'استخدام أكياس غير منفذة للماء', 'مراقبة نسبة الرطوبة'] },
  { title: 'التجفيف الفوري', items: ['تجفيف الحبوب في غضون 24 ساعة', 'الاحتفاظ بالرطوبة تحت 12%', 'استخدام مجففات صناعية'] },
];

const detectionMethods = [
  { method: 'اختبار الحقل السريع', time: '5-10 دقائق', accuracy: 'منخفض', useCase: 'التحقق الأولي' },
  { method: 'اختبار ELISA', time: '2-4 ساعات', accuracy: 'متوسط', useCase: 'مراقبة الجودة' },
  { method: 'HPLC', time: '4-6 ساعات', accuracy: 'مرتفع', useCase: 'الشهادة' },
];

const regulations = [
  { region: 'الاتحاد الأوروبي', limit: '2 بيكوغرام/غرام', products: 'الأعواد الغذائية' },
  { region: 'الولايات المتحدة', limit: '20 بيكوغرام/غرام', products: 'الحبوب والأعواد' },
  { region: 'كودكس الأغذية', limit: '10 بيكوغرام/غرام', products: 'المنتجات الغذائية' },
];

function localePath(path: string): string {
  return `/ar${path}`;
}
---

<BaseLayout locale="ar" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/resources/')} class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-red-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-red-500/10 text-red-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">
          سلامة الغذاء
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">
          {title.toUpperCase()}
        </h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">
          {description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-red-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">فريق هندسة هاونو</div>
              <div class="text-sm text-steel-500">مهندس المكبس الزيتي الرئيسي · +15 سنوات من الخبرة</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">لماذا تهم مكافحة الأفلاتوكسين في معاصر الزيت</h2>
        <p class="text-steel-700 leading-relaxed">
          الأفلاتوكسينات هي سموم تنتجها بعض الفطريات (Aspergillus flavus و Aspergillus parasiticus) التي يمكن أن تلوث الحبوب المستخدمة لإنتاج الزيت. مراقبة الأفلاتوكسين أمر حيوي لضمان سلامة الغذاء والامتثال للمعايير الدولية.
        </p>
      </section>

      <section id="types" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">أنواع الأفلاتوكسين</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {typesOfAflatoxins.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="font-bold text-lg text-red-600 mb-3">{item.type}</div>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">الخطر:</span>
                  <span class="text-sm text-charcoal-900">{item.danger}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">المصادر:</span>
                  <span class="text-sm text-charcoal-900">{item.sources}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">التأثيرات:</span>
                  <span class="text-sm text-charcoal-900">{item.effects}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="sources" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">من أين يبدأ تلوث الأفلاتوكسين</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {contaminationSources.map((item, index) => (
            <div key={index} class="bg-orange-50 p-5 rounded-xl border border-orange-200">
              <h3 class="font-semibold text-lg text-orange-800 mb-2">{item.title}</h3>
              <p class="text-steel-700 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="prevention" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">الوقاية من الأفلاتوكسين من الحقل إلى المخزن</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {preventionStrategies.map((item, index) => (
            <div key={index} class="bg-green-50 p-5 rounded-xl border border-green-200">
              <h3 class="font-semibold text-lg text-green-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {task}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="detection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">كيفية فحص الأفلاتوكسين قبل العصر</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-indigo-500 text-white">
              <tr>
                <th class="px-4 py-3 text-right font-semibold">الطريقة</th>
                <th class="px-4 py-3 text-right font-semibold">الوقت</th>
                <th class="px-4 py-3 text-right font-semibold">الدقة</th>
                <th class="px-4 py-3 text-right font-semibold">الاستخدام</th>
              </tr>
            </thead>
            <tbody>
              {detectionMethods.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.method}</td>
                  <td class="px-4 py-3 text-amber-600">{item.time}</td>
                  <td class="px-4 py-3 text-emerald-600">{item.accuracy}</td>
                  <td class="px-4 py-3 text-steel-700">{item.useCase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="regulations" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">حدود الأفلاتوكسين في أسواق التصدير الرئيسية</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {regulations.map((item, index) => (
            <div key={index} class="bg-purple-50 p-5 rounded-xl border border-purple-200">
              <h3 class="font-semibold text-lg text-purple-800 mb-3">{item.region}</h3>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">الحد:</span>
                  <span class="text-sm text-red-600 font-bold">{item.limit}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">المنتجات:</span>
                  <span class="text-sm text-charcoal-900">{item.products}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="processing-reduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">هل يزيل العصر أو التكرير الأفلاتوكسين؟</h2>
        <p class="text-steel-700 leading-relaxed mb-4">هذا هو السؤال الذي يطرحه أصحاب المعاصر أكثر من غيره — والإجابة الصادقة: جزئياً، وليس كلياً أبداً. الأفلاتوكسينات تذوب في الكتلة الصلبة بكثير أكثر من ذوبانها في الزيت، لذا يوجّه العصر الميكانيكي معظم أي تلوث إلى الكيك؛ والزيت الخام من بذور ملوثة يحمل عادة كمية أقل بكثير من السم مقارنة بالبذور نفسها. والتكرير الكامل — المعالجة القلوية، والتبييض بالطين المنشّط، وإزالة الروائح — يخفض الأفلاتوكسين في الزيت أكثر، وغالباً إلى ما دون الحدود التنظيمية. أما الترشيح وحده فيزيل فقط الجزء المرتبط بالمواد الصلبة.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">لماذا لا تُعد المعالجة استراتيجية سلامة</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>الإزالة متغيّرة وتعتمد على مستوى التلوث ونوع البذور والعملية — ولا يمكن ضمانها من دفعة إلى أخرى.</li>
            <li>الكيك يركّز السموم؛ ودخول كيك ملوث إلى سلاسل الغذاء أو العلف يخلق مشكلة امتثال ثانية وأكبر.</li>
            <li>الورش الصغيرة والمتوسطة التي تبيع زيتاً خاماً أو مُرشَّحاً ترشيحاً خفيفاً لا تمتلك خطوات التكرير التي تقوم بمعظم الإزالة.</li>
            <li>لا يقبل أي مشترٍ أو جهة تنظيمية عبارة "المكبس يزيلها" كإجراء رقابي؛ ونقطة الرقابة الموثقة هي البذور المقبولة عند الاستلام، وليس المعالجة.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">عامل المعالجة كحاجز ثانوي يقلل المخاطر، وابنِ الحاجز الأساسي عند الاستلام: ارفض البذور الملوثة قبل دخولها المبنى.</p>
      </section>

      <section id="mill-testing-protocol" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">بروتوكول فحص عملي على مستوى المعصرة</h2>
        <p class="text-steel-700 leading-relaxed mb-4">اختبارات HPLC المخبرية واختبارات ELISA المعتمدة هي الطرق المرجعية، لكن المعصرة لا تحتاج مختبراً للسيطرة على المخاطر — بل تحتاج روتين استلام قابلاً للتكرار باستخدام أدوات فرز سريعة تنبّه إلى الدفعات المشبوهة قبل تفريغها.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li><strong>الفحص البصري والحسي أولاً:</strong> العفن أو تغيّر اللون أو الحبات المجعدة أو الرائحة العفنة أو آثار الحشرات الظاهرة تعني رفض الدفعة أو عزلها فوراً.</li>
          <li><strong>خذ العينات بشكل صحيح:</strong> اسحب زيادات صغيرة كثيرة من أكياس وأعماق متعددة — التلوث يتركز في جزء ضئيل من الحبات، وقبضة واحدة لا تحسم شيئاً.</li>
          <li><strong>الفرز السريع:</strong> أشرطة التدفق الجانبي أو مجموعات اختبار ELISA النوعية تعطي نتيجة نعم/لا مقابل حدّك المحدد في دقائق، وهي فعّالة من حيث التكلفة لكل دفعة استلام أو كل شحنة مورد.</li>
          <li><strong>تصعيد النتائج الإيجابية:</strong> أرسل الدفعات الحدية أو الفاشلة إلى مختبر معتمد للتأكيد الكمي قبل أي قرار بشأن المصير.</li>
          <li><strong>احتفظ بعينات</strong> من كل دفعة مقبولة، موسومة بالمورد والتاريخ والدفعة، حتى ما بعد العمر التخزيني للمنتج بفترة طويلة.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed">الفرز رخيص مقارنةً بشحنة تصدير مرفوضة واحدة أو قائمة علامة تجارية محظورة؛ أدخل تكلفته في سعر الطن من البذور المقبولة بدلاً من اعتباره مصروفاً اختيارياً.</p>
      </section>

      <section id="lot-disposition-suppliers" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">الدفعات الفاشلة وعقود الموردين</h2>
        <p class="text-steel-700 leading-relaxed mb-4">يجب أن يُقرَّر مصير الدفعة الفاشلة قبل أول شحنة، لا عند البوابة وشاحنة تنتظر. خلط دفعة فاشلة ببذور جيدة "لتخفيفها" غير قانوني في كل سوق منظّمة تقريباً ويدمّر سلسلة الأدلة؛ اعزل المواد المشبوهة ووسمها وفصلها مادياً، وتخلّص من الدفعات المؤكدة عبر القناة التي تحددها اللوائح المحلية — غالباً إتلاف بإشراف أو توجيه إلى استخدامات غير غذائية مسموحة، وليس أبداً بصمت إلى كيك علف الأبقار أو الدواجن.</p>
        <p class="text-steel-700 leading-relaxed mb-4">الحل الدائم يكون من المنبع. ضع حدود الأفلاتوكسين وطرق أخذ العينات وشروط الرفض أو الاستبدال كتابةً مع كل مورد، وادفع علاوة موثقة مقابل المكسرات والبذور الجافة النظيفة المحفوظة بشكل صحيح، وقدّم للموردين المفضلين نصيحة الحصاد البسيطة التي تضبط معظم التلوث: النضج الكامل، والتجفيف السريع إلى رطوبة أقل من 8%، وتخزين جاف نظيف بعيداً عن الأرض، والتناوب على أساس "الأول داخل، الأول خارج". الموردون الذين لا يقبلون هذه الشروط ليسوا بذوراً رخيصة — بل التزامات طارئة.</p>
        <p class="text-steel-700 leading-relaxed">نفس انضباط الرطوبة والتخزين الذي يحمي من الأفلاتوكسين يحسّن أيضاً إنتاج الزيت ويحمي المعدات، وهو ما يربط سلامة الغذاء مباشرة بالاقتصاد الموضح في <a href="/ar/resources/oil-press-raw-materials-guide/" class="text-amber-600 hover:underline">دليل المواد الخام</a> و<a href="/ar/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">دليل تعظيم الإنتاجية</a>: الاستلام المنضبط والجاف والقابل للتتبع هو في آنٍ واحد أكثر طرق تشغيل المعصرة أماناً وربحية.</p>
        <h3 class="font-semibold text-lg mt-6 mb-3 text-charcoal-900">حفظ السجلات وجاهزية الاستدعاء</h3>
        <p class="text-steel-700 leading-relaxed mb-4">يُطلب من المصدرين والبائعين ذوي العلامات التجارية بشكل متزايد إثبات نظام الرقابة، لا مجرد اجتياز اختبار واحد. يحتاج النظام القابل للتطبيق إلى أربعة سجلات مترابطة فقط لكل دفعة: المورد والمصدر، نتيجة فرز الاستلام مع التاريخ، دفعات العصر والترشيح التي استهلكت الدفعة، والعملاء الذين استلموا الزيت النهائي. على الورق أو في جدول بيانات بسيط، تتيح هذه السلسلة للمعصرة تتبّع أي زجاجة إلى بذورها خلال ساعة — وهي القدرة التي يبحث عنها المشترون والمدققون فعلاً — وتحدّ أي استدعاء إلى دفعات محددة بدلاً من شهر إنتاج كامل.</p>
        <p class="text-steel-700 leading-relaxed">راجع السجلات شهرياً: الموردون المرتبطون بنتائج حدّية متكررة يحصلون على تحذيرات أو شروط استبدال، ونوافذ المخاطر الموسمية تصبح مرئية عاماً بعد عام، وينقل هذا الانضباط امتثال سلامة الغذاء بهدوء من كلفة إلى نقطة بيع لدى المستوردين الذين تعرضوا لخسائر مع موردين بلا وثائق.</p>
        <p class="text-steel-700 leading-relaxed mt-4">يُكمل التدريب النظام. يجب أن يكون العاملون الذين يفرغون الشاحنات ويقلبون الصوامع قادرين على ذكر إشارات الرفض الثلاث — العفن والرطوبة والرائحة العفنة — وأن يعرفوا أن قبول شحنة مشبوهة لتجنب جدال هو القرار الوحيد الذي لا يمكن لبقية العملية التراجع عنه. محادثة سلامة لمدة خمس دقائق في كل أسبوع حصاد، تتكرر لكل عامل جديد، تحافظ على الإجراء الموثق حقيقياً عند البوابة، لا مجرد صحيح على الورق.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">خطة عملية لمكافحة الأفلاتوكسين في معصرتك</h2>
        <p class="text-steel-700 leading-relaxed">
          مراقبة الأفلاتوكسين تتطلب نهجاً استباقياً في كل مرحلة من سلسلة التوريد. من خلال الجمع بين اختيار مادة أولية صارم، تخزين مناسب، وطرق كشف موثوقة، يمكنك ضمان سلامة منتجاتك والامتثال للمعايير الدولية.
        </p>
      </section>
    </div>
  </main>

