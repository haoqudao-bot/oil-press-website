---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'complete-oil-production-line-guide');
const t = getTranslations('ar');

const title = resource?.data.title.ar || resource?.data.title.en || 'دليل خط إنتاج الزيت الكامل';
const description = resource?.data.description.ar || resource?.data.description.en || 'من البذور إلى الزيت المعبأ';
const seoKeywords = resource?.data.seoKeywords || ['خط إنتاج الزيت', 'مصنع زيت كامل', 'معدات معالجة الزيت'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/production-line-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'مهندس إنتاج أول', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/ar' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/ar/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/ar/resources/complete-oil-production-line-guide' },
  ],
};

const productionStages = [
  { stage: '1', title: 'تنظيف البذور', equipment: 'شاشة اهتزازية، فاصل مغناطيسي', desc: 'إزالة الحطام والحجارة والمعادن والبذور التالفة. ضرورية للجودة وحماية المعدات.' },
  { stage: '2', title: 'إزالة القشور', equipment: 'مقشّر، فاصل', desc: 'إزالة أغلفة البذور لتحسين عائد الزيت وجودة الكيك.' },
  { stage: '3', title: 'التحميص', equipment: 'محفّض دوار، متحكم في درجة الحرارة', desc: 'تسخين البذور لتفكيك جدران الخلايا، تحسين النكهة والعائد.' },
  { stage: '4', title: 'الطحن', equipment: 'مطحنة مطرية، مطحنة أسطوانية', desc: 'تقليل البذور إلى حجم جسيمات مثالي للضغط الفعال.' },
  { stage: '5', title: 'الضغط', equipment: 'مكبس زيت هيدروليكي', desc: 'استخراج الزيت باستخدام ضغط عالي (40-60 MPa). قلب خط الإنتاج.' },
  { stage: '6', title: 'الترشيح', equipment: 'مرشح ضغط، طارد مركزي', desc: 'إزالة الجسيمات الصلبة والماء من الزيت الخام.' },
  { stage: '7', title: 'التجفيف', equipment: 'مجفف زيت، مسخّن', desc: 'تقليل محتوى الرطوبة إلى <0.1% لاستقرار التخزين.' },
  { stage: '8', title: 'التعبئة', equipment: 'آلة تعبئة، غطّاء، ملصّق', desc: 'تعبئة الزيت في حاويات نهائية للبيع بالتجزئة أو بالجملة.' },
];

const capacityOptions = [
  { scale: 'ورشة منزلية', capacity: '100-500 كجم/يوم', equipment: ['مكبس HN325', 'محفّض صغير', 'مرشح يدوي', 'أدوات يدوية'] },
  { scale: 'شركة صغيرة', capacity: '500-2000 كجم/يوم', equipment: ['مكبس HN355', 'محفّض دوار', 'نظام ترشيح', 'مطحنة', 'خزانات تخزين'] },
  { scale: 'مصنع متوسط', capacity: '2000-5000 كجم/يوم', equipment: ['مكبس HN426/HN480', 'محفّض كامل', 'طارد مركزي', 'خط كامل', 'أتمتة'] },
  { scale: 'صناعي كبير', capacity: '5000+ كجم/يوم', equipment: ['مكابس HN500 متعددة', 'محفّضات صناعية', 'خط تكرير كامل', 'أتمتة كاملة'] },
];

const layoutTips = [
  { tip: 'تخطيط التدفق', desc: 'ترتيب المعدات في تدفق منطقي: مادة أولية ← معالجة ← تعبئة' },
  { tip: 'تخطيط المساحة', desc: 'السماح بمساحة 2-3 أضعاف حجم المعدات للتشغيل والصيانة' },
  { tip: 'المرافق', desc: 'تخطيط الكهرباء والماء والصرف قبل التثبيت' },
  { tip: 'التهوية', desc: 'تركيب تهوية مناسبة لمناطق التحميص والضغط' },
  { tip: 'مناطق السلامة', desc: 'إنشاء مناطق آمنة حول المعدات المضغوطة' },
];

const costAnalysis = [
  { item: 'المعدات الأساسية (مكبس + ملحقات)', percentage: '40-50%' },
  { item: 'التركيب والتشغيل التجريبي', percentage: '10-15%' },
  { item: 'المبنى والبنية التحتية', percentage: '15-25%' },
  { item: 'المواد الأولية الأولية', percentage: '5-10%' },
  { item: 'رأس المال العامل', percentage: '10-15%' },
];

const maintenanceSchedule = [
  { frequency: 'يومي', tasks: ['تنظيف المعدات', 'فحص مستوى زيت الهيدروليك', 'فحص فلاتر الضغط', 'التحقق من أجهزة السلامة'] },
  { frequency: 'أسبوعي', tasks: ['استبدال الفلاتر', 'فحص وصلات الحزام', 'فحص غرفة الضغط', 'تشحيم الأجزاء المتحركة'] },
  { frequency: 'شهري', tasks: ['تغيير زيت الهيدروليك', 'فحص الخراطيم الهيدروليكية', 'معايرة أجهزة استشعار درجة الحرارة', 'فحص التوصيلات الكهربائية'] },
  { frequency: 'ربع سنوي', tasks: ['فحص النظام بالكامل', 'استبدال الأجزاء البالية', 'اختبار أنظمة السلامة', 'تنظيف خزانات التخزين'] },
  { frequency: 'سنوي', tasks: ['صيانة النظام الهيدروليكي', 'استبدال الأختام الهيدروليكية', 'فحص كهربائي كامل', 'تحديث سجلات الصيانة'] },
];

function localePath(path: string): string {
  return `/ar${path}`;
}
---

<BaseLayout locale="ar" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/resources')} class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">الدليل الشامل</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">فريق هندسة هاونو</div>
            <div class="text-sm text-steel-500">مهندس إنتاج أول · +15 سنة من الخبرة</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">المقدمة</h2>
        <p class="text-steel-700 leading-relaxed mb-4">يحول خط إنتاج الزيت الكامل البذور الخام إلى زيت معبأ قابل للتسويق. يساعد فهم العملية الكاملة في التخطيط والميزانية وتحسين عملية التشغيل.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic">يعد إنشاء خط إنتاج كامل استثماراً كبيراً ولكنه يمكن أن يوفر هوامش ربح أعلى بنسبة 10-30% مقارنة ببيع الزيت الخام. التخطيط السليم ضروري للنجاح.</p>
        </div>
      </section>

      <section id="stages" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">مراحل الإنتاج</h2>
        <div class="space-y-4">
          {productionStages.map((stage, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{stage.stage}</div>
                {index < productionStages.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < productionStages.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{stage.title}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  <p class="text-amber-600 text-sm mb-1"><strong>المعدات:</strong> {stage.equipment}</p>
                  <p class="text-steel-600 text-sm">{stage.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="capacity" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">خيارات حجم الإنتاج</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {capacityOptions.map((option, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden shadow-md hover:shadow-lg transition-shadow">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <div class="flex justify-between items-center">
                  <h3 class="font-display text-lg text-white">{option.scale}</h3>
                  <span class="bg-white/20 text-white text-sm px-2 py-1 rounded">{option.capacity}</span>
                </div>
              </div>
              <div class="p-5">
                <p class="text-sm text-steel-500 mb-2">المعدات الرئيسية:</p>
                <ul class="space-y-1">
                  {option.equipment.map((equip, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                      {equip}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="layout" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">نصائح تخطيط المنشأة</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {layoutTips.map((tip, index) => (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-indigo-50 p-5 rounded-xl border border-blue-100">
              <h4 class="font-semibold text-blue-800 mb-2">{tip.tip}</h4>
              <p class="text-steel-700 text-sm">{tip.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="cost" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">تحليل تكلفة الاستثمار</h2>
        <p class="text-steel-700 mb-6">توزيع الاستثمار النموذجي لخط إنتاج زيت كامل:</p>
        <div class="space-y-3">
          {costAnalysis.map((item, index) => (
            <div key={index} class="bg-white p-4 rounded-lg border border-steel-100 flex justify-between items-center">
              <span class="text-steel-700">{item.item}</span>
              <div class="flex items-center gap-3">
                <div class="w-32 bg-steel-100 rounded-full h-2">
                  <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-2 rounded-full" style={`width: ${parseInt(item.percentage)}%`}></div>
                </div>
                <span class="font-semibold text-amber-600 text-sm w-16 text-left">{item.percentage}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">جدول الصيانة</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {maintenanceSchedule.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-sm overflow-hidden">
              <div class={`p-3 ${index === 0 ? 'bg-green-100' : index === 1 ? 'bg-blue-100' : index === 2 ? 'bg-amber-100' : index === 3 ? 'bg-purple-100' : 'bg-red-100'}`}>
                <h3 class="font-semibold text-charcoal-900">{item.frequency}</h3>
              </div>
              <div class="p-4">
                <ul class="space-y-2">
                  {item.tasks.map((task, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {task}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">الخلاصة</h2>
        <p class="text-steel-700 leading-relaxed">خط إنتاج الزيت الكامل هو استثمار تجاري قوي. من خلال التخطيط Carefully لكل مرحلة والعمل مع موردي المعدات ذوي الخبرة، يمكنك بناء عملية إنتاج زيت مربحة ومستدامة. اتصل بفريقنا للحصول على تصميم خط إنتاج مخصص وعرض سعر.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">ابني إمبراطوريتك في إنتاج الزيت</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">يمكن لفريق هندستنا تصميم خط إنتاج كامل مصمم لتلبية احتياجاتك وميزانيتك المحددة.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localePath('/contact')} class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          طلب استشارة
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={localePath('/products')} class="btn-outline border-white text-white hover:bg-white/10">عرض المعدات</a>
        <a href={localePath('/resources')} class="btn-outline border-white text-white hover:bg-white/10">العودة للموارد</a>
      </div>
    </div>
  </section>
</BaseLayout>