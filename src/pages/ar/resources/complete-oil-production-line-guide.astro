---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'complete-oil-production-line-guide');
const t = getTranslations('ar');

const title = resource?.data.title.ar || 'دليل شامل لخط إنتاج الزيت';
const description = resource?.data.description.ar || 'تصميم نظام إنتاج فعال';
const seoKeywords = resource?.data.seoKeywords || ['تصميم خط إنتاج الزيت', 'خط المكبس الهيدروليكي', 'معدات مصنع الزيت'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/production-line-guide-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'مهندس مكبس زيتي كبار', worksFor: { '@type': 'Organization', name: 'مجموعة شاندونغ هاونواو لمعدات الميكانيكا' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://www.hydoilpress.com/ar/' },
    { '@type': 'ListItem', position: 2, name: 'الموارد', item: 'https://www.hydoilpress.com/ar/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/ar/resources/complete-oil-production-line-guide' },
  ],
};

const components = [
  { name: 'نظام تنظيف البذور', items: ['مصفح الهواء الاهتزازي', 'فاصل المغناطيسي', 'فاصل الجاذبية', 'يجب أن تكون السعة تساوي أو تزيد من معدل مدخلات المواد الخام'] },
  { name: 'نظام التجفيف', items: ['مجفف الأقراص', 'مطحنة المطرقة التجفيف', 'التطبيقات: الفلفل، دوار الشمس، جوز الهند، السمسم'] },
  { name: 'نظام ضبط الرطوبة', items: ['معدل البخار', 'مجفف الهواء الساخن', 'أهداف الرطوبة: الضغط الساخن 5-8%، الضغط البارد 7-9%'] },
  { name: 'نظام التحمص (الضغط الساخن فقط)', items: ['محمص الأسطوانة', 'محمص السطح المسطح', 'الدرجة الحرارية: 160-180 درجة مئوية، الوقت: 25-35 دقيقة'] },
  { name: 'نظام طحن البذور', items: ['مطحنة الأسطوانات', 'مطحنة المطرقة', 'حجم الجسيمات: 2-4 مم لاستخراج مثالي'] },
  { name: 'المكبس الهيدروليكي للزيت', items: ['مكبس الزيت الهيدروليكي هاونواو (HN325, HN355, HN426, HN480, HN500)', 'السعة: 100 كجم لكل دفعة', 'وقت الدورة: الضغط الساخن 30-40 دقيقة، الضغط البارد ~2 ساعات'] },
  { name: 'نظام تصفية الزيت', items: ['مكبس المرشح الصفيح', 'مرشح الكيس', 'مرشح الطرد المركزي', 'مستويات الترشيح: الأولي 100-200 شبكية، الدقيقة 200-300 شبكية'] },
  { name: 'نظام تخزين الزيت', items: ['خزانات الفولاذ المقاوم للصدأ', 'خزانات الفولاذ الناعم (مع طلاء)', 'الزيت المضغوط بارداً: تخزين عند < 25 درجة مئوية، محمية من الضوء'] },
  { name: 'نظام معالجة الكيك', items: ['ناقل الكيك', 'مطحنة الكيك', 'استخدامات الكيك: تغذية الحيوانات، الأسمدة، المعالجة الثانوية'] },
];

const capacityPlanning = [
  { scale: 'صغير', capacity: '500-1,000 كجم', model: 'HN325' },
  { scale: 'متوسط', capacity: '1,000-2,500 كجم', model: 'HN355/HN426' },
  { scale: 'كبير', capacity: '2,500-4,000 كجم', model: 'HN480/HN500' },
];

const spaceRequirements = [
  { scale: 'صغير', area: '50-80 م2', height: '3 م' },
  { scale: 'متوسط', area: '100-150 م2', height: '3-4 م' },
  { scale: 'كبير', area: '200-300 م2', height: '4-5 م' },
];

const costAnalysis = [
  { scale: 'خط الصناعة الصغير', items: [{ name: 'المكبس الهيدروليكي', cost: 'اتصل للحصول على السعر' }, { name: 'المعدات الداعمة', cost: 'اتصل للحصول على السعر' }, { name: 'التثبيت', cost: 'اتصل للحصول على السعر' }] },
  { scale: 'خط الصناعة المتوسط', items: [{ name: 'المكبس الهيدروليكي', cost: 'اتصل للحصول على السعر' }, { name: 'المعدات الداعمة', cost: 'اتصل للحصول على السعر' }, { name: 'التثبيت', cost: 'اتصل للحصول على السعر' }] },
  { scale: 'خط الصناعة الكبير', items: [{ name: 'المكبس الهيدروليكي', cost: 'اتصل للحصول على السعر' }, { name: 'المعدات الداعمة', cost: 'اتصل للحصول على السعر' }, { name: 'التثبيت', cost: 'اتصل للحصول على السعر' }] },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="ar">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/ar" class="hover:text-amber-500 transition-colors">الرئيسية</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        <a href="/ar/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-purple-50 to-pink-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-purple-500/10 text-purple-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">تصميم خط الإنتاج</span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-purple-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-right">
              <div class="font-semibold text-charcoal-900">فريق هندسة هاونواو</div>
              <div class="text-sm text-steel-500">مهندس مكبس زيتي كبار · 15+ سنة خبرة</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">المقدمة</h2>
        <p class="text-steel-700 leading-relaxed">تصميم خط إنتاج زيت شامل يتطلب تخطيطًا دقيقًا وتكاملًا لمكونات متعددة. الخط المصمم جيدًا يزيد من الكفاءة، يقلل من النفايات، ويساعد على الحفاظ على جودة المنتج.</p>
      </section>

      <section id="components" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">مكونات خط الإنتاج</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {components.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <h3 class="font-semibold text-lg text-purple-600 mb-3">{item.name}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm">{task}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="capacity-planning" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">تخطيط السعة</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">متطلبات السعة حسب المقاس</h3>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-indigo-500 text-white">
              <tr>
                <th class="px-4 py-3 text-right font-semibold">المقاس</th>
                <th class="px-4 py-3 text-right font-semibold">السعة اليومية</th>
                <th class="px-4 py-3 text-right font-semibold">النموذج الموصى به</th>
              </tr>
            </thead>
            <tbody>
              {capacityPlanning.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.scale}</td>
                  <td class="px-4 py-3 text-steel-600">{item.capacity}</td>
                  <td class="px-4 py-3 text-amber-600 font-medium">{item.model}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-6 bg-gradient-to-r from-steel-50 to-steel-100 p-5 rounded-xl">
          <h4 class="font-semibold text-charcoal-900 mb-3">اعتبارات توازن الخط</h4>
          <ol class="space-y-2 list-decimal list-inside text-steel-700">
            <li>سعة التحمص: يجب أن تكون >= 2 x معدل الضغط</li>
            <li>سعة الطحن: يجب أن تتناسب مع معدل الضغط</li>
            <li>سعة الترشيح: يجب أن تتناسب مع ناتج الضغط</li>
            <li>سعة التخزين: يجب أن تستوعب 3-5 أيام من الإنتاج</li>
          </ol>
        </div>
      </section>

      <section id="layout-design" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">تصميم التخطيط</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">مبادئ التصميم</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-green-50 p-4 rounded-xl border border-green-200">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="font-semibold text-green-800">كفاءة تدفق العمل</span>
            </div>
            <p class="text-steel-700 text-sm mt-1">تقليل معالجة المواد</p>
          </div>
          <div class="bg-red-50 p-4 rounded-xl border border-red-200">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><shield/></svg>
              <span class="font-semibold text-red-800">السلامة</span>
            </div>
            <p class="text-steel-700 text-sm mt-1">ضمان الوصول الآمن للعمليات والصيانة</p>
          </div>
          <div class="bg-blue-50 p-4 rounded-xl border border-blue-200">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><refresh-cw/></svg>
              <span class="font-semibold text-blue-800">المرونة</span>
            </div>
            <p class="text-steel-700 text-sm mt-1">السماح بالتوسع المستقبلي</p>
          </div>
          <div class="bg-amber-50 p-4 rounded-xl border border-amber-200">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><user/></svg>
              <span class="font-semibold text-amber-800">الاستخدام السهل</span>
            </div>
            <p class="text-steel-700 text-sm mt-1">التصميم لراحة المشغل</p>
          </div>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900 mt-8">متطلبات المساحة</h3>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-amber-500 to-orange-500 text-white">
              <tr>
                <th class="px-4 py-3 text-right font-semibold">المقاس</th>
                <th class="px-4 py-3 text-right font-semibold">المساحة المطلوبة</th>
                <th class="px-4 py-3 text-right font-semibold">الارتفاع</th>
              </tr>
            </thead>
            <tbody>
              {spaceRequirements.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-amber-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.scale}</td>
                  <td class="px-4 py-3 text-steel-600">{item.area}</td>
                  <td class="px-4 py-3 text-blue-600">{item.height}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="cost-analysis" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">تحليل التكلفة</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">الاستثمار الرأسمالي</h3>
        <div class="space-y-6">
          {costAnalysis.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <h4 class="font-semibold text-lg text-charcoal-900 mb-3">{item.scale}</h4>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {item.items.map((cost, idx) => (
                  <div key={idx} class="bg-gradient-to-br from-steel-50 to-steel-100 p-4 rounded-lg">
                    <span class="text-steel-500 text-sm">{cost.name}</span>
                    <p class="font-bold text-amber-600">{cost.cost}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 bg-gradient-to-r from-green-500 to-emerald-500 p-6 rounded-xl text-white">
          <h4 class="font-semibold text-lg mb-3">العودة على الاستثمار</h4>
          <div class="flex flex-wrap gap-6">
            <div>
              <span class="text-white/80">صغير:</span>
              <span class="font-bold text-xl ml-2">12-18 شهر</span>
            </div>
            <div>
              <span class="text-white/80">متوسط:</span>
              <span class="font-bold text-xl ml-2">10-15 شهر</span>
            </div>
            <div>
              <span class="text-white/80">كبير:</span>
              <span class="font-bold text-xl ml-2">8-12 شهر</span>
            </div>
          </div>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">الخلاصة</h2>
        <p class="text-steel-700 leading-relaxed">تصميم خط إنتاج زيت شامل هو استثمار كبير يتطلب تخطيطًا دقيقًا. هاونواو يوفر دعمًا كاملًا لتصميم خطوط إنتاج الزيت، بما في ذلك اختيار المعدات، تخطيط التخطيط، ومساعدة في التثبيت.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">هل أنت مستعد لبدء إنتاج الزيت الخاص بك؟</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">فريق هندستنا يمكنه مساعدتك في اختيار أفضل المعدات وتحسين استثمارك لتحقيق أقصى عوائد.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/ar/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">اتصل بخبرائنا<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/ar/products" class="btn-outline border-white text-white hover:bg-white/10">تصفح المعدات</a>
        <a href="/ar/resources" class="btn-outline border-white text-white hover:bg-white/10">العودة للموارد</a>
      </div>
    </div>
  </section>
</BaseLayout>

