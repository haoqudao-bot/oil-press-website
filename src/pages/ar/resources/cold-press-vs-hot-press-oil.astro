---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'cold-press-vs-hot-press-oil');
const t = getTranslations('ar');

const title = resource?.data.title.ar || resource?.data.title.en || 'الضغط البارد مقابل الضغط الساخن';
const description = resource?.data.description.ar || resource?.data.description.en || 'أي الطرق المناسبة لك؟';
const seoKeywords = resource?.data.seoKeywords || ['الضغط البارد مقابل الساخن', 'فوائد الزيت المضغوط بارداً'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/cold-vs-hot-press-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about' },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/ar' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/ar/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/ar/resources/cold-press-vs-hot-press-oil' },
  ],
};

const comparisonData = [
  {
    name: 'الزيت المضغوط بارداً',
    color: 'blue',
    temp: 'درجة حرارة الغرفة (< 60°C)',
    pros: ['يحتفظ بالعناصر الغذائية الطبيعية (الفيتامينات، مضادات الأكسدة)', 'يحافظ على النكهة والرائحة الأصلية', 'قيمة سوقية أعلى (زيادة 20-50%)', 'يُسمى "خام" أو "بكر"', 'يفضله المستهلكون المهتمون بالصحة', 'لا يوجد تدهور حراري'],
    cons: ['عائد أقل (5-15% أقل)', 'محتوى رطوبة أعلى', 'مدة صلاحية أقصر (3-6 أشهر)', 'تكلفة إنتاج أعلى', 'قد يحتوي على المزيد من الرواسب'],
    bestFor: ['زيوت خاصة ممتازة', 'سوق الأغذية الصحية', 'الاستخدام التجميلي والصيدلاني', 'منتجات الذواقة والحرفية']
  },
  {
    name: 'الزيت المضغوط ساخناً',
    color: 'amber',
    temp: 'مسخّن (120-200°C)',
    pros: ['عائد أعلى (5-15% أكثر)', 'محتوى رطوبة أقل', 'مدة صلاحية أطول (12-24 شهر)', 'تكلفة إنتاج أقل', 'مناسب لزيت الطبخ بالجملة', 'يقتل البكتيريا والجراثيم'],
    cons: ['فقدان العناصر الغذائية الحساسة للحرارة', 'ملف نكهة متغير', 'قد يحتوي على دهون متحولة', 'قيمة سوقية أقل', 'غير مناسب للاستخدام التجميلي/الصيدلاني'],
    bestFor: ['زيت الطبخ اليومي', 'الإنتاج واسع النطاق', 'خدمات الطعام المؤسسية', 'التطبيقات الصناعية']
  },
];

const nutritionComparison = [
  { nutrient: 'فيتامين E', cold: 'مرتفع (محفوظ)', hot: 'منخفض (مدمر جزئياً)' },
  { nutrient: 'الفيتوستيرولات', cold: 'مرتفع', hot: 'مخفض' },
  { nutrient: 'مضادات الأكسدة', cold: 'مرتفع', hot: 'مخفض' },
  { nutrient: 'أوميغا 3', cold: 'محفوظ', hot: 'مدمر جزئياً' },
  { nutrient: 'مركبات النكهة', cold: 'كامل، أصلي', hot: 'متغير، جوزي' },
  { nutrient: 'اللون', cold: 'فاتح، طبيعي', hot: 'داكن، محمص' },
];

const yieldComparison = [
  { material: 'السمسم', coldYield: '42-48%', hotYield: '48-54%', difference: '+6%' },
  { material: 'الفول السوداني', coldYield: '38-42%', hotYield: '45-50%', difference: '+7%' },
  { material: 'بذور اللفت', coldYield: '32-36%', hotYield: '38-42%', difference: '+6%' },
  { material: 'الجوز', coldYield: '45-50%', hotYield: 'غير مستحسن', difference: 'N/A' },
  { material: 'اللوز', coldYield: '42-48%', hotYield: 'غير مستحسن', difference: 'N/A' },
];

const equipment = [
  { type: 'المكبس الهيدروليكي — يُستخدم للطريقتين معاً', machines: 'سلسلة HN300–HN500', features: 'ضغط هيدروليكي ساكن مع تحكم بالضغط عبر كمبيوتر دقيق؛ لا احتكاك برغي ولا سخان مدمج. العصر البارد = تحميل بذور خام مجففة؛ العصر الساخن = تحميل بذور محمصة أو مبخرة مسبقاً.' },
  { type: 'المحمصة / المبخرة — لازمة للعصر الساخن', machines: 'محمصة أسطوانية كهرومغناطيسية، مقلاة تحميص بزيت حراري، مبخرة بذور كهربائية (ماكينات منفصلة)', features: 'معدات معالجة مسبقة مستقلة بتحكم حراري خاص بها قابل للضبط؛ تُنقل البذور المحمصة بعدها إلى المكبس الهيدروليكي.' },
];

const decisionGuide = [
  { question: 'ما هو سوقك المستهدف؟', answer: 'الممتاز/الصحة ← ضغط بارد | السوق الشامل ← ضغط ساخن' },
  { question: 'ما هي أولويتك الرئيسية؟', answer: 'الجودة قبل الكمية ← ضغط بارد | العائد قبل الجودة ← ضغط ساخن' },
  { question: 'ما هو حجم إنتاجك؟', answer: 'النطاق الصغير ← ضغط بارد (قيمة أعلى) | النطاق الكبير ← ضغط ساخن (حجم أعلى)' },
  { question: 'ما هي قدرتك التخزينية؟', answer: 'تخزين محدود ← ضغط ساخن (مدة صلاحية أطول) | تخزين كافٍ ← ضغط بارد' },
];

function localePath(path: string): string {
  return `/ar${path}`;
}
---

<BaseLayout locale="ar" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/resources/')} class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">دليل المقارنة</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">فريق هندسة هاونو</div>
            <div class="text-sm text-steel-500">متخصص في معالجة الزيت · +15 سنة من الخبرة</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">طريقتان للعصر وزيتان مختلفان</h2>
        <p class="text-steel-700 leading-relaxed mb-4">الاختيار بين الضغط البارد والساخن هو أحد أهم القرارات لمنتجي الزيت. تنتج الطريقتان زيتاً عالي الجودة، لكنهما يخدمان أسواقاً وأغراضاً مختلفة.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic">عادةً ما يفرض الزيت المضغوط بارداً علاوة سعرية بنسبة 20-50% على الزيت المضغوط ساخناً في السوق. فهم المقايضات هو المفتاح لاختيار الاستراتيجية المناسبة لعملك.</p>
        </div>
      </section>

      <section id="comparison" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">الضغط البارد مقابل الضغط الساخن</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {comparisonData.map((item, index) => (
            <div key={index} class={`bg-white rounded-2xl border-2 overflow-hidden shadow-lg ${item.color === 'blue' ? 'border-blue-400' : 'border-amber-400'}`}>
              <div class={`p-5 ${item.color === 'blue' ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : 'bg-gradient-to-r from-amber-500 to-orange-500'}`}>
                <h3 class="font-display text-xl text-white">{item.name}</h3>
                <p class="text-white/80 text-sm mt-1">درجة الحرارة: {item.temp}</p>
              </div>
              <div class="p-5 space-y-4">
                <div>
                  <h4 class="font-semibold text-green-700 mb-2 text-sm">المزايا</h4>
                  <ul class="space-y-1">
                    {item.pros.map((pro, idx) => <li key={idx} class="text-steel-700 text-sm flex items-start gap-2"><span class="text-green-500">+</span>{pro}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="font-semibold text-red-700 mb-2 text-sm">العيوب</h4>
                  <ul class="space-y-1">
                    {item.cons.map((con, idx) => <li key={idx} class="text-steel-700 text-sm flex items-start gap-2"><span class="text-red-500">-</span>{con}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="font-semibold text-blue-700 mb-2 text-sm">الأفضل لـ</h4>
                  <div class="flex flex-wrap gap-1">
                    {item.bestFor.map((b, idx) => <span key={idx} class="bg-blue-50 text-blue-700 text-xs px-2 py-1 rounded">{b}</span>)}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="nutrition" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">القيمة الغذائية: ما الذي تزيله الحرارة</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead>
              <tr class="bg-gradient-to-r from-charcoal-800 to-charcoal-900 text-white">
                <th class="px-4 py-3 text-right font-semibold">العنصر/الخاصية</th>
                <th class="px-4 py-3 text-right font-semibold">المضغوط بارداً</th>
                <th class="px-4 py-3 text-right font-semibold">المضغوط ساخناً</th>
              </tr>
            </thead>
            <tbody>
              {nutritionComparison.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.nutrient}</td>
                  <td class="px-4 py-3 text-blue-600">{item.cold}</td>
                  <td class="px-4 py-3 text-amber-600">{item.hot}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="yield" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">العائد: ما الذي تقدمه كل طريقة فعلاً</h2>
        <p class="text-steel-700 mb-6">معدلات العائد النموذجية للمواد المختلفة:</p>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-green-500 to-emerald-500 text-white">
              <tr><th class="px-4 py-3 text-right font-semibold">المادة</th><th class="px-4 py-3 text-right font-semibold">عائد الضغط البارد</th><th class="px-4 py-3 text-right font-semibold">عائد الضغط الساخن</th><th class="px-4 py-3 text-right font-semibold">ميزة الساخن</th></tr>
            </thead>
            <tbody>
              {yieldComparison.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.material}</td>
                  <td class="px-4 py-3 text-blue-600">{item.coldYield}</td>
                  <td class="px-4 py-3 text-amber-600">{item.hotYield}</td>
                  <td class="px-4 py-3 text-green-600 font-medium">{item.difference}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="equipment" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">المعدات اللازمة للضغط البارد والساخن</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {equipment.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden shadow-md">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : 'bg-gradient-to-r from-amber-500 to-orange-500'}`}>
                <h3 class="font-semibold text-white">{item.type}</h3>
              </div>
              <div class="p-5 space-y-2">
                <p class="text-sm"><span class="text-steel-500">الموصى به:</span> <span class="font-semibold text-charcoal-900">{item.machines}</span></p>
                <p class="text-sm text-steel-600">{item.features}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="decision" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">كيف تختار بين الضغط البارد والضغط الساخن</h2>
        <div class="bg-gradient-to-br from-steel-50 to-steel-100 p-6 rounded-xl border border-steel-200">
          <div class="space-y-4">
            {decisionGuide.map((item, index) => (
              <div key={index} class="bg-white p-4 rounded-lg border border-steel-100">
                <p class="font-semibold text-charcoal-900 mb-2">س: {item.question}</p>
                <p class="text-steel-600">ج: {item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="economics-worked-example" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">مقارنة اقتصادية بمثال عملي</h2>
        <p class="text-steel-700 leading-relaxed mb-4">العائد والسعر لا يرويان القصة منفصلين — بل يتحدان عبر قيمة الكسب والإنتاجية. خذ 1,000 كجم من الفول السوداني بمحتوى زيت لب 45%. قد يستعيد الضغط الساخن 420–440 لتراً من الزيت المصفى في نحو ثلاث إلى أربع دورات على HN325؛ أما الضغط البارد، بدورات أطول بكثير تستغرق ساعتين، فقد يستعيد 340–370 لتراً. على الورق يتقدم المسار الساخن بـ 60–80 لتراً. لا يفوز المسار البارد إلا عندما تتجاوز علاوة سعر الزجاجة وسعر الكسب الأعلى معاً تلك الفجوة زائد ساعات العمل الإضافية لكل لتر.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">املأ هذه الأسطر الأربعة قبل القرار</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>سعر الجملة لكل لتر، وعلاوة البارد مقابل الزيت الساخن القياسي في سوقك.</li>
            <li>الزيت المستعاد لكل 100 كجم من البذور بكل طريقة (شغّل تجربة، ولا تفترض عوائد الكتيبات).</li>
            <li>سعر الكسب لكل كجم لكسب الضغط البارد الغذائي مقابل كسب الضغط الساخن العلفي.</li>
            <li>تكلفة العمالة والطاقة لكل لتر عند إنتاجية الضغط البارد الأقل — نحو 300–700 كجم لكل وردية مقابل 900–1,400 كجم بالطريقة الساخنة.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">كثير من المعاصر الناجحة تشغّل الطريقتين معاً: الضغط الساخن لكميات الأسطوانات بالجملة، ومعصرة <a href="/ar/products/cold-press-hydraulic-oil-press/" class="text-amber-600 hover:underline">HN426 للضغط البارد</a> مخصصة لخطوط الزجاجات المتميزة، مع إبقاء قصتي المنتجين وقنوات العملاء منفصلتين.</p>
      </section>

      <section id="pressing-profile" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">لماذا يختلف ملف الضغط</h2>
        <p class="text-steel-700 leading-relaxed mb-4">تفعل الحرارة أمرين فيزيائيين: تخفض لزوجة الزيت فيتدفق بحرية عبر فجوات التصريف الصغيرة، وتجمع أجسام الزيت المجهرية داخل خلايا البذرة. الزيت البارد أكثر كثافة ويتحرك ببطء، لذا يحتاج الضغط البارد إلى تصعيد تدريجي للضغط بدلاً من دفعة سريعة واحدة، وإلى زمن ثبات كامل عند الضغط الأقصى، وأسطوانة عصر مشقّقة بمساحة تصريف إجمالية أكبر. وخط HN426 للضغط البارد مبني حول هذا الملف تحديداً — ضغط نظام 70 ميجاباسكال مع أسطوانة عصر مشقّقة تحافظ على الزيت المتبقي في الكسب عند 6–8% رغم كثافة الزيت الأعلى.</p>
        <p class="text-steel-700 leading-relaxed">يتحمل الضغط الساخن دورات أسرع، 30–40 دقيقة لكل دفعة، لأن البذور المحمصة والمهيأة تطلق الزيت بسرعة؛ المقابل أن الحرارة نفسها تسرّع الأكسدة وتُنتج النكهة المحمصة المميزة. لا طريقة "أفضل" في المجرد — فهما منتجان مختلفان من البذرة نفسها، ولهذا يجب قراءة جدولي العائد والقيمة الغذائية أعلاه مع السعر الذي يدفعه عملاؤك فعلاً.</p>
      </section>

      <section id="shelf-life-labeling" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">مدة الصلاحية والتخزين وادعاءات الملصق</h2>
        <p class="text-steel-700 leading-relaxed mb-4">يحتفظ الزيت المضغوط بارداً بمزيد من مضادات الأكسدة الطبيعية لكن أيضاً بمزيد من المركبات التي تجعل الزيت حساساً للضوء والحرارة؛ وهو ليس أكثر ثباتاً في التخزين تلقائياً. يحتاج المنتجان إلى تخزين نظيف وجاف بإدارة النيتروجين أو الفراغ العلوي في حاويات معتمة أو داكنة، بعيداً عن أشعة الشمس. وانضباط الترشيح أهم للزيت المضغوط بارداً، لأن الجسيمات العالقة تحمل رطوبة وتتأكسد في الزجاجة — راجع <a href="/ar/resources/crude-oil-filtration-guide/" class="text-amber-600 hover:underline">دليل الترشيح</a> للإجراء.</p>
        <p class="text-steel-700 leading-relaxed">على الملصقات، يجب أن تكون ادعاءات "مضغوط بارداً" صادقة تجاه العملية — دون تحميص أو تهيئة حرارية فوق حرارة المحيط — وأسواق الاستيراد تتوقع بشكل متزايد أن يطابق الادعاء درجة حرارة عملية موثقة، لا مجرد ملصق تسويقي. احتفظ بسجلات الدفعات لدرجات حرارة التحميص (أو غيابها)، والضغوط، والتواريخ، حتى يكون الادعاء قابلاً للدفاع أمام المشترين والجهات التنظيمية على حد سواء.</p>
        <p class="text-steel-700 leading-relaxed mt-4">أياً كان المسار السائد، أبقِ المنتجين منفصلين مادياً وتجارياً من الاستقبال فصاعداً: أسطوانات عصر منفصلة أو تغيير صارم، وترسيب وترشيح منفصلان، ومخزون زجاجات منفصل، وتسعير منفصل. فدفعة واحدة من الضغط الساخن تُباع تحت ملصق الضغط البارد تلحق ضرراً تجارياً أكبر من أي حجم وفّره المزج، لأن المشترين المتميزين يشترون العملية الموثقة، لا الطعم وحده.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">الضغط البارد أم الساخن: الخلاصة العملية</h2>
        <p class="text-steel-700 leading-relaxed">لكل من الضغط البارد والساخن مكانه في صناعة الزيت. يفرض الضغط البارد أسعاراً أعلى لكن بعائد أقل. يقدم الضغط الساخن عوائد أعلى لكن بأسعار أقل. الاختيار الصحيح يعتمد على سوقك المستهدف وحجم إنتاجك وأهدافك التجارية.</p>
      </section>
