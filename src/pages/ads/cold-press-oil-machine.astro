table.models .best{display:inline-block;background:#f0fdfa;color:#0f766e;font-size:12px;font-weight:600;padding:3px 8px;border-radius:6px}
.model-tip{text-align:center;margin-top:18px;font-size:13px;color:#334155}
.model-tip strong{color:#0e7490}
.model-note{text-align:center;margin-top:14px;font-size:12px;color:#475569;line-height:1.7}

/* ===== Select Table (Fig.2 style, rows=models) ===== */
