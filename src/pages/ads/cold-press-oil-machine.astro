.col-badge{display:block;background:#0ea5e9;color:#fff;font-size:10px;font-weight:700;padding:3px 8px;border-radius:4px;margin-bottom:4px;letter-spacing:.4px}
.check-yes{display:inline-block;background:#dcfce7;color:#166534;padding:3px 10px;border-radius:6px;font-weight:700;font-size:12px}

/* ===== Video Section ===== */
.video-section{background:linear-gradient(135deg,#0c4a6e,#0f766e);color:#fff;border-radius:20px;padding:48px;margin:0 auto;max-width:1100px}
.video-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:36px;align-items:center}
.video-wrap{aspect-ratio:16/9;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3);background:#000}
.press-video{width:100%;height:100%;display:block;background:#000}
.video-info h3{font-size:24px;font-weight:800;margin-bottom:12px}
.video-info p{font-size:15px;color:#cbd5e1;margin-bottom:20px}
.video-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}
.video-stat{text-align:center;padding:14px;background:rgba(255,255,255,.05);border-radius:10px;border:1px solid rgba(255,255,255,.08)}
.video-stat .num{font-size:22px;font-weight:800;color:#67e8f9}
.video-stat .label{font-size:12px;color:#94a3b8;margin-top:4px}
@media(max-width:900px){.video-grid{grid-template-columns:1fr}.video-section{padding:32px 20px}}

/* ===== Factory ===== */
.factory-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
.factory-photos{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.factory-photo{aspect-ratio:4/3;border-radius:12px;display:flex;align-items:flex-end;justify-content:flex-start;padding:12px;color:#fff;font-size:12px;font-weight:600;position:relative;overflow:hidden;background:#e2e8f0}
.factory-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.factory-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.55),transparent 50%);z-index:1}
.factory-photo span{position:relative;z-index:2}
.factory-list{margin-top:16px;display:grid;gap:12px}
.factory-list li{list-style:none;display:flex;align-items:flex-start;gap:10px;font-size:14px;color:#475569}
.factory-list li::before{content:"✓";flex-shrink:0;background:#cffafe;color:#155e75;font-weight:800;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;border-radius:6px;font-size:12px;margin-top:1px}
@media(max-width:900px){.factory-grid{grid-template-columns:1fr}}

/* ===== Cases ===== */
.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.case-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:24px;transition:all .25s}
