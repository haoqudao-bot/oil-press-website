table.select-table td{padding:14px 12px;font-size:13px;vertical-align:middle;line-height:1.6}
table.select-table td.model-name-cell{font-weight:700;color:#0f172a;white-space:nowrap}
table.select-table td.model-name-cell .tag-badge{margin-right:8px}
table.select-table td.td-seed{color:#334155;font-weight:500}
table.select-table td.td-note{color:#64748b;font-size:12px;max-width:260px}
