.mcard-row.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.mcard-row.two > div{display:flex;flex-direction:column;gap:3px}
.mcard-label{font-size:11px;color:#94a3b8;font-weight:600;letter-spacing:.3px;flex-shrink:0;min-width:72px;padding-top:2px}
.mcard-val{font-size:13px;color:#334155;font-weight:500;line-height:1.5}
