table.select-table tr.row-featured td{background:#fffbeb;border-top:3px solid #f59e0b}
table.select-table tr.row-featured td.model-name-cell{color:#0369a1;font-weight:900}

/* ===== Mobile model cards (show on mobile only, hide on desktop) ===== */
.model-cards{display:none}
.mcard{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:16px;margin-bottom:12px;box-shadow:0 4px 14px rgba(0,0,0,.04)}
.mcard-featured{border:2px solid #f59e0b;background:#fffbeb;box-shadow:0 6px 20px rgba(245,158,11,.18);position:relative}
.mcard-badge{display:inline-block;background:#f59e0b;color:#fff;font-size:11px;font-weight:700;padding:4px 10px;border-radius:6px;margin-bottom:10px;letter-spacing:.4px}
.mcard-row{display:flex;gap:12px;padding:7px 0;border-bottom:1px dashed #f1f5f9}
