.case-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid #f1f5f9}
.case-head .flag{font-size:14px;font-weight:800;background:#cffafe;color:#155e75;padding:6px 10px;border-radius:6px;letter-spacing:.5px}
.case-head .cname{font-size:13px;font-weight:700;color:#0f172a}
.case-head .ccountry{font-size:12px;color:#64748b}
.case-row{margin-bottom:10px}
.case-row .label{font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.case-row .val{font-size:13px;color:#334155;font-weight:500}
.case-row .result{background:#ecfdf5;color:#047857;padding:8px 10px;border-radius:8px;font-size:13px;font-weight:600}
@media(max-width:900px){.case-grid{grid-template-columns:1fr}}

/* ===== FAQ ===== */
.faq-list{max-width:820px;margin:0 auto;display:grid;gap:12px}
.faq-item{background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;transition:all .2s}
.faq-q{width:100%;background:none;border:none;text-align:left;padding:18px 20px;font-size:15px;font-weight:700;color:#0f172a;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;font-family:inherit}
.faq-q .chev{color:#0ea5e9;font-size:18px;transition:transform .25s}
.faq-item.open .faq-q .chev{transform:rotate(45deg)}
.faq-item.open{border-color:#67e8f9;box-shadow:0 6px 16px rgba(0,0,0,.05)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;padding:0 20px}
.faq-item.open .faq-a{max-height:500px;padding:0 20px 18px}
.faq-a p{color:#475569;font-size:14px;line-height:1.7}

/* ===== CTA Final ===== */
.final-cta{background:linear-gradient(135deg,#0c4a6e,#0f766e);color:#fff;padding:64px 0;border-radius:20px;margin:40px auto;max-width:1180px;position:relative;overflow:hidden}
.final-cta::before{content:"";position:absolute;top:-150px;right:-150px;width:400px;height:400px;background:radial-gradient(circle,rgba(14,165,233,.2),transparent 70%);border-radius:50%}
.final-cta-inner{position:relative;z-index:1;padding:0 20px;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.final-cta h2{font-size:36px;font-weight:800;margin-bottom:12px;letter-spacing:-.4px;text-align:left}
.final-cta h2 .accent{color:#67e8f9}
.final-cta .text-lead{font-size:16px;color:#cbd5e1;margin-bottom:20px;text-align:left}
.final-cta ul{display:grid;gap:10px;margin:22px 0;text-align:left;max-width:460px}
.final-cta li{list-style:none;font-size:14px;color:#e2e8f0;display:flex;align-items:center;gap:10px}
.final-cta li::before{content:"✓";color:#22d3ee;font-weight:800;font-size:16px}
@media(max-width:900px){.final-cta-inner{grid-template-columns:1fr}.final-cta h2{font-size:28px}}

/* ===== Footer ===== */
.mini-footer{background:#0c4a6e;color:#94a3b8;padding:32px 0;font-size:13px}
.mini-foot-inner{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center}
