<script is:inline>
function handleInquiry(e){
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('.submit');
  const successDiv = form.querySelector('.form-success');
  btn.disabled = true;
  btn.textContent = 'Sending...';

  fetch(form.action, {
    method: 'POST',
    body: new FormData(form),
    headers: { 'Accept': 'application/json' }
  })
  .then(response => {
    if (response.ok) {
      form.reset();
      if (successDiv) { successDiv.classList.add('show'); }
      btn.textContent = '✅ Sent! We\'ll reply in 24h';
      btn.disabled = true;
    } else {
      throw new Error('Failed');
    }
  })
  .catch(() => {
    btn.textContent = '❌ Error — Please call +86 189 5714 9128';
    btn.style.background = '#dc2626';
  });
  return false;
}
window.handleInquiry = handleInquiry;
</script>
