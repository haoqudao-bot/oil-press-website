/* ===== Floating CTA ===== */
.float-cta{position:fixed;right:16px;bottom:16px;z-index:90;display:flex;flex-direction:column;gap:8px}
.float-cta .fc{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;font-weight:700;padding:12px 16px;border-radius:999px;font-size:13px;box-shadow:0 10px 30px rgba(34,197,94,.4);transition:all .2s;white-space:nowrap}
.float-cta .fc.quote{background:linear-gradient(135deg,#16a34a,#65a30d);box-shadow:0 10px 30px rgba(22,163,74,.45)}
.float-cta .fc:hover{transform:translateY(-2px) scale(1.03)}
@media(min-width:768px){.float-cta .fc svg{display:inline}.float-cta .fc span.full{display:inline}.float-cta .fc span.short{display:none}}
@media(max-width:767px){.float-cta .fc svg{display:none}.float-cta .fc span.full{display:none}.float-cta .fc span.short{display:flex;align-items:center;justify-content:center}.float-cta .fc{width:48px;height:48px;padding:0;border-radius:50%;font-size:20px;box-shadow:0 6px 20px rgba(0,0,0,.25)}.float-cta{gap:8px}}
</style>
</head>
