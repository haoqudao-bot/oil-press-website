.factory-list{margin-top:16px;display:grid;gap:12px}
.factory-list li{list-style:none;display:flex;align-items:flex-start;gap:10px;font-size:14px;color:#475569}
.factory-list li::before{content:"✓";flex-shrink:0;background:#dcfce7;color:#365314;font-weight:800;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;border-radius:6px;font-size:12px;margin-top:1px}
