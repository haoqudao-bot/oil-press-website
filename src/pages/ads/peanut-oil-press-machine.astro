@media(max-width:900px){.video-grid{grid-template-columns:1fr}.video-section{padding:32px 20px}}

/* ===== Factory ===== */
.factory-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
