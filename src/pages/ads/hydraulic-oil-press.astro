<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font-family:'Inter',sans-serif;background:#fff;color:#0f172a;line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.container{max-width:1180px;margin:0 auto;padding:0 20px}

/* ===== Top Nav ===== */
.topnav{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid #e2e8f0;backdrop-filter:blur(8px)}
.topnav-inner{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;color:#0f172a}
.brand-badge{background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;font-size:11px;padding:3px 8px;border-radius:6px;font-weight:700;letter-spacing:.3px}
.nav-cta{display:inline-flex;align-items:center;gap:6px;background:#f59e0b;color:#111;font-weight:700;padding:10px 18px;border-radius:8px;font-size:14px;transition:all .2s}
.nav-cta:hover{background:#f97316;transform:translateY(-1px)}
@media(max-width:640px){.brand span.desc{display:none}.nav-cta{padding:8px 14px;font-size:13px}}

/* ===== Hero ===== */
.hero{background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);color:#fff;padding:56px 0 64px;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;top:-200px;right:-200px;width:500px;height:500px;background:radial-gradient(circle,rgba(245,158,11,.12),transparent 70%);border-radius:50%}
.hero::after{content:"";position:absolute;bottom:-180px;left:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(59,130,246,.1),transparent 70%);border-radius:50%}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;position:relative;z-index:1}
.hero h1{font-size:44px;line-height:1.15;font-weight:800;margin-bottom:16px;letter-spacing:-.5px}
.hero h1 .accent{background:linear-gradient(90deg,#fbbf24,#f97316);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .sub{font-size:17px;line-height:1.7;color:#cbd5e1;margin-bottom:24px}
.hero .highlight{display:inline-block;background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.3);color:#fbbf24;font-weight:600;padding:6px 14px;border-radius:20px;font-size:13px;margin-bottom:20px}
.trust-row{display:flex;flex-wrap:wrap;gap:16px 28px;margin:28px 0 24px;padding:18px 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
.trust-row .item{display:flex;align-items:center;gap:8px;color:#cbd5e1;font-size:14px;font-weight:500}
.trust-row .item strong{color:#fff;font-weight:700}
.cta-row{display:flex;flex-wrap:wrap;gap:12px}
.btn-primary{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#111;font-weight:700;padding:16px 26px;border-radius:10px;font-size:15px;transition:all .2s;box-shadow:0 10px 30px rgba(245,158,11,.25)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(245,158,11,.35)}
.btn-secondary{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;font-weight:600;padding:15px 24px;border-radius:10px;font-size:15px;transition:all .2s}
.btn-secondary:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.35)}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:36px}.hero h1{font-size:34px}}

/* ===== Form Card ===== */
.form-card{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.4);padding:26px;color:#0f172a}
.form-card h3{font-size:18px;font-weight:800;margin-bottom:4px;color:#0f172a}
.form-card .lead{font-size:13px;color:#64748b;margin-bottom:18px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.form-row.full{grid-template-columns:1fr}
.form-card label{display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px}
.form-card label .req{color:#ef4444}
.form-card input,.form-card select,.form-card textarea{width:100%;padding:11px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:14px;font-family:inherit;background:#fff;transition:all .15s;color:#0f172a}
.form-card input:focus,.form-card select:focus,.form-card textarea:focus{outline:none;border-color:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.15)}
.form-card textarea{resize:vertical;min-height:70px}
.form-card .submit{width:100%;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#111;font-weight:700;padding:14px 20px;border-radius:10px;font-size:15px;cursor:pointer;border:none;transition:all .2s;box-shadow:0 8px 24px rgba(245,158,11,.3)}
.form-card .submit:hover{transform:translateY(-1px)}
.form-card .note{text-align:center;font-size:12px;color:#64748b;margin-top:12px}
.form-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;border-radius:10px;padding:14px;text-align:center;font-size:14px;font-weight:600;margin-top:12px;display:none}
.form-success.show{display:block}

/* ===== Offer Banner ===== */
.offer{background:linear-gradient(90deg,#fef3c7,#fed7aa);padding:16px 0;border-bottom:1px solid #fde68a}
.offer-inner{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;font-size:14px;font-weight:600;color:#78350f}
.offer .chip{background:#f59e0b;color:#fff;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:700}
.offer .countdown{background:#fff;padding:4px 10px;border-radius:6px;color:#b45309;font-weight:800;border:1px solid #fde68a}

/* ===== Section Shell ===== */
section{padding:72px 0}
.section-head{text-align:center;margin-bottom:48px}
.section-head .eyebrow{display:inline-block;background:#fef3c7;color:#92400e;font-size:12px;font-weight:700;padding:5px 14px;border-radius:20px;letter-spacing:.6px;text-transform:uppercase;margin-bottom:14px}
.section-head h2{font-size:34px;font-weight:800;letter-spacing:-.4px;margin-bottom:12px}
.section-head p{font-size:16px;color:#64748b;max-width:640px;margin:0 auto}
.bg-alt{background:#f8fafc}

/* ===== Pain Points ===== */
.pain-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.pain-card{background:#fff;border:1px solid #fee2e2;border-radius:14px;padding:24px;position:relative;transition:all .25s}
.pain-card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(0,0,0,.06);border-color:#fca5a5}
.pain-card .icon{font-size:32px;margin-bottom:12px}
.pain-card h3{font-size:17px;font-weight:700;color:#b91c1c;margin-bottom:8px}
.pain-card p{font-size:14px;color:#475569;line-height:1.6}
@media(max-width:900px){.pain-grid{grid-template-columns:repeat(2,1fr)}}
