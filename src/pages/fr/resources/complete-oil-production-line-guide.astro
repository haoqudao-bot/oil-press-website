---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'complete-oil-production-line-guide');
const t = getTranslations('fr');

const title = resource?.data.title.fr || resource?.data.title.en || 'Guide Complet de la Ligne de Production d\'Huile';
const description = resource?.data.description.fr || resource?.data.description.en || 'De la graine à l\'huile en bouteille';
const seoKeywords = resource?.data.seoKeywords || ['ligne de production d\'huile', 'usine d\'huile complète', 'équipement de transformation d\'huile'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/production-line-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about/' },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/complete-oil-production-line-guide/' },
  ],
};

const productionStages = [
  { stage: '1', title: 'Nettoyage des graines', equipment: 'Tamis vibrant, séparateur magnétique', desc: 'Éliminer les débris, pierres, métaux et graines endommagées. Essentiel pour la qualité et la protection de l\'équipement.' },
  { stage: '2', title: 'Décorticage', equipment: 'Égreneur, séparateur', desc: 'Retirer les enveloppes des graines pour améliorer le rendement en huile et la qualité du tourteau.' },
  { stage: '3', title: 'Torréfaction', equipment: 'Torréfacteur rotatif, contrôleur de température', desc: 'Chauffer les graines pour décomposer les parois cellulaires, améliorer la saveur et le rendement.' },
  { stage: '4', title: 'Broyage', equipment: 'Moulin à marteaux, moulin à rouleaux', desc: 'Réduire les graines à une taille de particule optimale pour un pressage efficace.' },
  { stage: '5', title: 'Pressage', equipment: 'Presse à huile hydraulique', desc: 'Extraire l\'huile à haute pression (40-60 MPa). Cœur de la ligne de production.' },
  { stage: '6', title: 'Filtration', equipment: 'Presse filtrante, centrifugeuse', desc: 'Éliminer les particules solides et l\'eau de l\'huile brute.' },
  { stage: '7', title: 'Séchage', equipment: 'Séchoir à huile, chauffeur', desc: 'Réduire la teneur en humidité à <0,1% pour la stabilité au stockage.' },
  { stage: '8', title: 'Mise en bouteille', equipment: 'Remplisseuse, capsuleuse, étiqueteuse', desc: 'Conditionner l\'huile dans les conteneurs finaux pour la vente au détail ou en gros.' },
];

const capacityOptions = [
  { scale: 'Atelier domestique', capacity: '100-500 kg/jour', equipment: ['Presse HN325', 'Petit torréfacteur', 'Filtre manuel', 'Outils manuels'] },
  { scale: 'Petite entreprise', capacity: '500-2000 kg/jour', equipment: ['Presse HN365', 'Torréfacteur rotatif', 'Système de filtration', 'Broyeur', 'Réservoirs de stockage'] },
  { scale: 'Usine moyenne', capacity: '2000-5000 kg/jour', equipment: ['Presse HN426/HN480', 'Torréfacteur complet', 'Centrifugeuse', 'Ligne complète', 'Automatisation'] },
  { scale: 'Grande usine industrielle', capacity: '5000+ kg/jour', equipment: ['Presses HN500 multiples', 'Torréfacteurs industriels', 'Ligne de raffinage complète', 'Automatisation complète'] },
];

const layoutTips = [
  { tip: 'Aménagement en flux', desc: 'Disposer l\'équipement dans un flux logique : matière première → transformation → conditionnement' },
  { tip: 'Planification de l\'espace', desc: 'Prévoir 2-3x la superficie de l\'équipement pour l\'opération et la maintenance' },
  { tip: 'Utilités', desc: 'Planifier l\'électricité, l\'eau et l\'évacuation avant l\'installation' },
  { tip: 'Ventilation', desc: 'Installer une ventilation adéquate pour les zones de torréfaction et de pressage' },
  { tip: 'Zones de sécurité', desc: 'Créer des zones de sécurité autour de l\'équipement sous pression' },
];

const costAnalysis = [
  { item: 'Équipement principal (Presse + Auxiliaire)', percentage: '40-50%' },
  { item: 'Installation et mise en service', percentage: '10-15%' },
  { item: 'Bâtiment et infrastructure', percentage: '15-25%' },
  { item: 'Matières premières initiales', percentage: '5-10%' },
  { item: 'Fonds de roulement', percentage: '10-15%' },
];

const maintenanceSchedule = [
  { frequency: 'Quotidien', tasks: ['Nettoyer l\'équipement', 'Vérifier le niveau d\'huile hydraulique', 'Inspecter les filtres', 'Vérifier les dispositifs de sécurité'] },
  { frequency: 'Hebdomadaire', tasks: ['Remplacer les filtres', 'Vérifier la tension des courroies', 'Inspecter la chambre de pressage', 'Lubrifier les pièces mobiles'] },
  { frequency: 'Mensuel', tasks: ['Changer l\'huile hydraulique', 'Inspecter les tuyaux hydrauliques', 'Calibrer les contrôles de température', 'Vérifier les connexions électriques'] },
  { frequency: 'Trimestriel', tasks: ['Inspection complète du système', 'Remplacer les pièces usées', 'Tester les systèmes de sécurité', 'Nettoyer les réservoirs de stockage'] },
  { frequency: 'Annuel', tasks: ['Révision du système hydraulique', 'Remplacer les joints hydrauliques', 'Inspection électrique complète', 'Mettre à jour les enregistrements de maintenance'] },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr/" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE COMPLET</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Ingénieur Senior en Production · Plus de 15 ans d'expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">À quoi ressemble une ligne de production d'huile complète</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Une ligne de production d'huile complète convertit les graines brutes en huile en bouteille commercialisable. Comprendre l'ensemble du processus vous aide à planifier, budgétiser et optimiser votre opération.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>La mise en place d'une ligne de production complète est un investissement important mais peut offrir des marges bénéficiaires 10-30% plus élevées par rapport à la vente d'huile brute. Une planification adéquate est essentielle pour le succès.</p>
        </div>
      </section>

      <section id="stages" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Les étapes d'une ligne de production d'huile, expliquées</h2>
        <div class="space-y-4">
          {productionStages.map((stage, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{stage.stage}</div>
                {index < productionStages.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < productionStages.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{stage.title}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  <p class="text-amber-600 text-sm mb-1"><strong>Équipement :</strong> {stage.equipment}</p>
                  <p class="text-steel-600 text-sm">{stage.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="capacity" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Choisir la bonne capacité pour votre ligne de production d'huile</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {capacityOptions.map((option, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden shadow-md hover:shadow-lg transition-shadow">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <div class="flex justify-between items-center">
                  <h3 class="font-display text-lg text-white">{option.scale}</h3>
                  <span class="bg-white/20 text-white text-sm px-2 py-1 rounded">{option.capacity}</span>
                </div>
              </div>
              <div class="p-5">
                <p class="text-sm text-steel-500 mb-2">Équipement clé :</p>
                <ul class="space-y-1">
                  {option.equipment.map((equip, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                      {equip}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="layout" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Planifier l'aménagement de votre ligne de production d'huile</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {layoutTips.map((tip, index) => (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-indigo-50 p-5 rounded-xl border border-blue-100">
              <h3 class="font-semibold text-blue-800 mb-2">{tip.tip}</h3>
              <p class="text-steel-700 text-sm">{tip.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="cost" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Combien coûte une ligne de production d'huile</h2>
        <p class="text-steel-700 mb-6">Répartition typique des investissements pour une ligne de production d'huile complète :</p>
        <div class="space-y-3">
          {costAnalysis.map((item, index) => (
            <div key={index} class="bg-white p-4 rounded-lg border border-steel-100 flex justify-between items-center">
              <span class="text-steel-700">{item.item}</span>
              <div class="flex items-center gap-3">
                <div class="w-32 bg-steel-100 rounded-full h-2">
                  <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-2 rounded-full" style={`width: ${parseInt(item.percentage)}%`}></div>
                </div>
                <span class="font-semibold text-amber-600 text-sm w-16 text-right">{item.percentage}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Maintenir votre ligne de production d'huile en marche</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {maintenanceSchedule.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-sm overflow-hidden">
              <div class={`p-3 ${index === 0 ? 'bg-green-100' : index === 1 ? 'bg-blue-100' : index === 2 ? 'bg-amber-100' : index === 3 ? 'bg-purple-100' : 'bg-red-100'}`}>
                <h3 class="font-semibold text-charcoal-900">{item.frequency}</h3>
              </div>
              <div class="p-4">
                <ul class="space-y-2">
                  {item.tasks.map((task, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {task}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="line-balance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Équilibrer la ligne autour de la presse</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Une ligne n'est pas plus rapide que son poste le plus lent. Une erreur courante consiste à acheter une grande presse tout en laissant le torréfacteur, le concasseur ou le filtre sous-dimensionnés — la machine coûteuse reste alors inactive une partie de chaque heure, à attendre des graines ou à s'engorger d'huile non filtrée. Équilibrez les équipements de support sur le débit de <em>pointe</em> de la presse, car les dix premières minutes de chaque cycle libèrent bien plus d'huile que la moyenne du cycle.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li><strong>La capacité de torréfaction</strong> doit être au moins le double du débit de pressage, afin que la presse n'attende jamais les graines torréfiées.</li>
            <li><strong>Le concassage et le conditionnement</strong> doivent correspondre au débit de pressage heure par heure.</li>
            <li><strong>La filtration</strong> doit suivre le débit d'huile ; un goulot d'étranglement du filtre renvoie l'huile brute dans la salle de presse.</li>
            <li><strong>Les cuves de stockage</strong> doivent contenir au moins 3–5 jours de production, découplant le rythme de pressage de l'enlèvement par camion.</li>
            <li><strong>Le nettoyage</strong> fonctionne par courtes séquences et se dimensionne au mieux à 1,5–2× le débit d'entrée.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed mb-4">Rappelez-vous que le pressage à chaud et à froid offrent des capacités très différentes sur la même machine. Une <a href="/fr/products/standard-hydraulic-oil-press/" class="text-amber-600 hover:underline">HN325</a> en lots complets de 100 kg presse à chaud environ 900–1 000 kg par poste de 8 heures avec un fût simple, et 1 200–1 400 kg avec un fût double ; le pressage à froid tourne à environ 300–400 kg en simple ou 600–700 kg en double, car chaque cycle dure environ deux heures au lieu de 30–40 minutes. Dimensionnez la ligne pour le mix produit que vous ferez réellement.</p>
      </section>

      <section id="utilities" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Besoins en utilités</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Le moteur de la presse ne fait que 2,2 kW, mais une ligne complète consomme bien davantage. Avant de signer un bail ou de commander du matériel, confirmez l'alimentation triphasée, le kVA total et l'eau disponibles sur le site — leur absence est la cause la plus fréquente de mise en service retardée.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-steel-100 rounded-lg">
            <thead class="bg-steel-100">
              <tr><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Équipement</th><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Puissance typique</th></tr>
            </thead>
            <tbody class="divide-y divide-steel-100">
              <tr><td class="px-4 py-2">Presse hydraulique</td><td class="px-4 py-2">2,2 kW (pointe ~3 kW)</td></tr>
              <tr><td class="px-4 py-2">Nettoyeur vibrant et épierreur</td><td class="px-4 py-2">1,5–3 kW</td></tr>
              <tr><td class="px-4 py-2">Torréfacteur électrique</td><td class="px-4 py-2">15–40 kW (les modèles au gaz réduisent cette valeur)</td></tr>
              <tr><td class="px-4 py-2">Concasseur</td><td class="px-4 py-2">3–7,5 kW</td></tr>
              <tr><td class="px-4 py-2">Presse à filtre</td><td class="px-4 py-2">1,5–3 kW</td></tr>
              <tr><td class="px-4 py-2">Convoyeurs et pompes</td><td class="px-4 py-2">3–8 kW</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-steel-700 leading-relaxed mt-4 mb-2">Prévoyez 20–40 kVA pour une ligne complète petite ou moyenne. La consommation d'eau reste modeste : environ 0,5–1 m³/jour pour le nettoyage et la vapeur dans une petite huilerie, plus 2–5 m³/jour d'eau de refroidissement en recirculation dans les climats chauds. Le gaz ou le bois pour le torréfacteur est souvent le poste énergétique le plus coûteux après les graines, alors comparez les prix localement avant de choisir un torréfacteur électrique.</p>
      </section>

      <section id="implementation" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Séquence de mise en œuvre</h2>
        <div class="space-y-3">
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">1</div><p class="text-steel-700 text-sm pt-1">Confirmez les graines cibles, le tonnage journalier et le mix produit chaud/froid avant de chiffrer quoi que ce soit.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">2</div><p class="text-steel-700 text-sm pt-1">Fixez le modèle de presse et le nombre de fûts — cela détermine la taille de tous les autres postes.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">3</div><p class="text-steel-700 text-sm pt-1">Listez les équipements de support avec des capacités calées sur le débit de pointe de la presse, pas sur les moyennes.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">4</div><p class="text-steel-700 text-sm pt-1">Dessinez le plan de masse et confirmez la hauteur sous plafond, l'électricité, l'eau et le drainage.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">5</div><p class="text-steel-700 text-sm pt-1">Commandez avec un lot de pièces de rechange et un accompagnement à l'installation ; planifiez la formation des opérateurs à la mise en service.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">6</div><p class="text-steel-700 text-sm pt-1">Démarrez avec une graine, une recette et des registres de lots écrits avant d'ajouter une seconde matière.</p></div>
        </div>
        <p class="text-steel-700 leading-relaxed mt-4">Dans le budget total, la presse ne représente généralement que 35–45 % des dépenses d'équipement ; le nettoyage, le concassage, la torréfaction, la filtration, les convoyeurs et l'installation composent le reste. Ajoutez le fret, les droits de douane, une fenêtre de mise en service de 30–45 jours et le fonds de roulement pour les graines. Comme les graines représentent habituellement 80–90 % du coût par litre d'huile, la discipline de rendement décrite dans notre <a href="/fr/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">guide du rendement en huile</a> se rembourse plus vite que toute remise sur la machine.</p>
        <p class="text-steel-700 leading-relaxed mt-4">Concevez l'aménagement pour le nettoyage autant que pour la production. Des sols inclinés et lavables près de la presse et du filtre, des évacuations qui ne refoulent pas et un parcours de balayage dédié entre la manutention des graines et du tourteau économisent une heure de main-d'œuvre chaque jour ouvré et gardent l'humidité et la contamination hors du côté graines. Laissez de la place pour la ligne que vous pourriez ajouter dans deux ans — un second emplacement de presse, un filtre supplémentaire ou un poste d'embouteillage — car agrandir une petite ligne judicieusement aménagée coûte peu, tandis que reconvertir une ligne à l'étroit signifie généralement la reconstruire.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Votre ligne de production d'huile : du plan au premier lot</h2>
        <p class="text-steel-700 leading-relaxed">Une ligne de production d'huile complète est un investissement commercial puissant. En planifiant soigneusement chaque étape et en travaillant avec des fournisseurs d'équipement expérimentés, vous pouvez construire une opération de production d'huile rentable et durable. Contactez notre équipe pour une conception et un devis personnalisés de ligne de production.</p>
      </section>
