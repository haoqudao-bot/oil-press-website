---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-vs-other-types');
const t = getTranslations('fr');

const title = resource?.data.title.fr || 'Presse hydraulique vs autres types de presses à huile';
const description = resource?.data.description.fr || 'Choisissez la bonne presse pour vos besoins';
const seoKeywords = resource?.data.seoKeywords || ['presse hydraulique vs presse à vis', 'comparatif presse à huile', 'quelle presse à huile choisir'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/oil-press-comparison-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Ingénieur Technique en Presse à Huile', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/hydraulic-oil-press-vs-other-types' },
  ],
};

const comparisonData = [
  {
    name: 'Presse à huile hydraulique',
    color: 'amber',
    pros: ['Haute pression (jusqu\'à 60 MPa)', 'Adaptée aux graines à haute teneur en huile', 'Pressage doux = meilleure qualité', 'Faible bruit, faible vibration', 'Longue durée de vie (15-20 ans)', 'Moins de maintenance requise', 'Peut presser sans chauffage (pressage à froid)', 'Empreinte au sol plus réduite', 'Fonctionnement par lots - flexible'],
    cons: ['Production continue plus faible', 'Coût initial plus élevé', 'Nécessite plus d\'attention de l\'opérateur'],
    best: ['Production petite à moyenne échelle', 'Huile premium (vierge, pressée à froid)', 'Huiles de spécialité à haute valeur', 'Producteurs artisanaux et de boutique']
  },
  {
    name: 'Presse à huile à vis',
    color: 'blue',
    pros: ['Fonctionnement continu', 'Débit élevé', 'Prix plus bas', 'Bonne pour grande échelle', 'Peut traiter divers matériaux'],
    cons: ['Pression plus basse (20-30 MPa)', 'Chauffage souvent requis', 'Bruit plus élevé', 'Pièces d\'usure à remplacer', 'Pas idéale pour le pressage à froid', 'Qualité peut être inférieure'],
    best: ['Production commerciale à grande échelle', 'Huile de cuisson standard', 'Production d\'aliments pour animaux', 'Transformation d\'huile en vrac']
  },
  {
    name: 'Presse à piston',
    color: 'green',
    pros: ['Méthode traditionnelle', 'Construction simple', 'Pression très élevée possible', 'Bonne pour petite échelle'],
    cons: ['Très labor intensive', 'Faible taux de production', 'Fonctionnement manuel requis', 'Capacité limitée'],
    best: ['Production artisanale', 'Très petits lots', 'Méthodes traditionnelles', 'Zones reculées sans électricité']
  },
];

const specsTable = [
  { feature: 'Pression', hydraulic: '40-60 MPa', screw: '20-30 MPa', ram: '30-50 MPa' },
  { feature: 'Fonctionnement', hydraulic: 'Par lots (semi-auto)', screw: 'Continu', ram: 'Lot manuel' },
  { feature: 'Production Quotidienne', hydraulic: '500-1500 kg', screw: '100-1000 kg', ram: '2-10 kg' },
  { feature: 'Qualité de l\'Huile', hydraulic: 'Excellente (vierge)', screw: 'Bonne', ram: 'Très bonne' },
  { feature: 'Pressage à Froid', hydraulic: 'Oui', screw: 'Limité', ram: 'Oui' },
  { feature: 'Maintenance', hydraulic: 'Faible', screw: 'Élevée (usure de la vis)', ram: 'Très faible' },
  { feature: 'Durée de Vie', hydraulic: '15-20 ans', screw: '5-10 ans', ram: '20+ ans' },
  { feature: 'Consommation d\'Énergie', hydraulic: '2-3 kW', screw: '5-15 kW', ram: 'Manuel/1 kW' },
  { feature: 'Gamme de Prix', hydraulic: 'Contactez-nous pour le prix', screw: 'Contactez-nous pour le prix', ram: 'Contactez-nous pour le prix' },
];

const decisionFramework = [
  { question: 'Quel est votre objectif de production quotidienne ?', hydraulic: '500-1500 kg/jour', screw: '100-1000 kg/jour', ram: '2-10 kg/jour' },
  { question: 'Quelle qualité d\'huile recherchez-vous ?', hydraulic: 'Vierge/pressée à froid premium', screw: 'Huile de cuisson standard', ram: 'Artisane traditionnelle' },
  { question: 'Quel est votre budget ?', hydraulic: 'Contactez-nous pour le prix', screw: 'Contactez-nous pour le prix', ram: 'Contactez-nous pour le prix' },
  { question: 'Avez-vous besoin d\'un fonctionnement continu ?', hydraulic: 'Non (par lots)', screw: 'Oui', ram: 'Non' },
];

const myths = [
  { myth: 'Les presses hydrauliques sont uniquement pour petite échelle', fact: 'Faux - les presses hydrauliques modernes traitent 100 kg par lot, avec des cycles allant de 40 minutes à 1,5 heure selon le matériau' },
  { myth: 'Les presses à vis produisent toujours plus d\'huile', fact: 'Faux - les presses hydrauliques peuvent atteindre des rendements plus élevés avec certains matériaux' },
  { myth: 'Le pressage à froid donne toujours moins d\'huile', fact: 'Faux - avec un prétraitement adéquat, le rendement à froid peut être de 42-50%' },
  { myth: 'Les presses hydrauliques nécessitent plus de maintenance', fact: 'Faux - les presses hydrauliques ont moins de pièces d\'usure' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE DE COMPARAISON</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Ingénieur Technique en Presse à Huile · Plus de 15 ans d'expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Lors du choix d'une presse à huile, comprendre les différences entre les presses hydrauliques, à vis et à piston est crucial. Chaque type a ses propres avantages et est adapté à différents besoins de production.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Il n'y a pas de "meilleure" presse à huile - seulement la meilleure presse pour vos besoins spécifiques. Ce guide vous aidera à comprendre les différences clés et à prendre une décision éclairée.</p>
        </div>
      </section>

      <section id="comparison" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comparaison Détaillée</h2>
        <div class="space-y-6">
          {comparisonData.map((item, index) => (
            <div key={index} class="bg-white rounded-2xl border-2 overflow-hidden shadow-lg" style={item.color === 'amber' ? 'border-color: #f59e0b' : item.color === 'blue' ? 'border-color: #3b82f6' : 'border-color: #10b981'}>
              <div class={`p-5 ${item.color === 'amber' ? 'bg-gradient-to-r from-amber-500 to-orange-500' : item.color === 'blue' ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : 'bg-gradient-to-r from-green-500 to-emerald-500'}`}>
                <h3 class="font-display text-xl text-white">{item.name}</h3>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
                <div class="p-5 bg-green-50 border-r border-steel-100">
                  <h4 class="font-semibold text-green-700 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Avantages
                  </h4>
                  <ul class="space-y-2">
                    {item.pros.map((pro, idx) => (
                      <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                        <span class="text-green-500 mt-0.5">+</span>
                        {pro}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="p-5 bg-red-50 border-r border-steel-100">
                  <h4 class="font-semibold text-red-700 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Inconvénients
                  </h4>
                  <ul class="space-y-2">
                    {item.cons.map((con, idx) => (
                      <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                        <span class="text-red-500 mt-0.5">-</span>
                        {con}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="p-5 bg-blue-50">
                  <h4 class="font-semibold text-blue-700 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Idéal Pour
                  </h4>
                  <ul class="space-y-2">
                    {item.best.map((b, idx) => (
                      <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {b}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="specs" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comparatif des Spécifications Techniques</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead>
              <tr class="bg-gradient-to-r from-charcoal-800 to-charcoal-900 text-white">
                <th class="px-4 py-3 text-left font-semibold">Caractéristique</th>
                <th class="px-4 py-3 text-left font-semibold">Hydraulique</th>
                <th class="px-4 py-3 text-left font-semibold">À Vis</th>
                <th class="px-4 py-3 text-left font-semibold">À Piston</th>
              </tr>
            </thead>
            <tbody>
              {specsTable.map((row, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{row.feature}</td>
                  <td class="px-4 py-3 text-amber-600">{row.hydraulic}</td>
                  <td class="px-4 py-3 text-blue-600">{row.screw}</td>
                  <td class="px-4 py-3 text-green-600">{row.ram}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="decision" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Cadre de Décision</h2>
        <p class="text-steel-700 mb-6">Répondez à ces questions clés pour déterminer le meilleur type de presse à huile pour vos besoins :</p>
        <div class="space-y-4">
          {decisionFramework.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-sm overflow-hidden">
              <div class="bg-steel-50 p-4">
                <h3 class="font-semibold text-charcoal-900 flex items-center gap-2">
                  <span class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.question}
                </h3>
              </div>
              <div class="grid grid-cols-3 gap-0">
                <div class="p-4 bg-amber-50 border-r border-steel-100">
                  <p class="text-xs text-steel-500 mb-1">Hydraulique</p>
                  <p class="text-amber-700 font-medium text-sm">{item.hydraulic}</p>
                </div>
                <div class="p-4 bg-blue-50 border-r border-steel-100">
                  <p class="text-xs text-steel-500 mb-1">À Vis</p>
                  <p class="text-blue-700 font-medium text-sm">{item.screw}</p>
                </div>
                <div class="p-4 bg-green-50">
                  <p class="text-xs text-steel-500 mb-1">À Piston</p>
                  <p class="text-green-700 font-medium text-sm">{item.ram}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="myths" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Idées Reçues à Démolir</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {myths.map((item, index) => (
            <div key={index} class="bg-gradient-to-r from-purple-50 to-pink-50 p-5 rounded-xl border border-purple-100">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <div>
                  <p class="font-semibold text-charcoal-900 mb-1">Idée reçue : {item.myth}</p>
                  <p class="text-steel-700 text-sm">Fait : {item.fact}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Pour une production petite à moyenne, une qualité d'huile premium et des capacités de pressage à froid, une presse à huile hydraulique est le choix supérieur. Pour des recommandations personnalisées, contactez notre équipe technique.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">TOUJOURS INDÉCIS ?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Nos ingénieurs peuvent vous aider à choisir la presse à huile parfaite pour vos exigences de production et votre budget spécifiques.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Obtenez un Avis d'Expert<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/fr/products" class="btn-outline border-white text-white hover:bg-white/10">Voir les Presses Hydrauliques</a>
        <a href="/fr/resources" class="btn-outline border-white text-white hover:bg-white/10">Retour aux Ressources</a>
      </div>
    </div>
  </section>
</BaseLayout>