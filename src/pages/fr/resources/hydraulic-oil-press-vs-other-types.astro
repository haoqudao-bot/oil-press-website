---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-vs-other-types');
const t = getTranslations('fr');

const title = resource?.data.title.fr || 'Presse hydraulique vs autres types de presses à huile';
const description = resource?.data.description.fr || 'Comparaison avec les presses à vis et l\'extraction par solvant';
const seoKeywords = resource?.data.seoKeywords || ['hydraulic vs screw oil press', 'méthodes d\'extraction d\'huile', 'avantages de la presse hydraulique'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/comparison-guide-hero.webp',
  author: {
    '@type': 'Person',
    name: 'Haonuo Engineering Team',
    jobTitle: 'Ingénieur senior en presse à huile',
    worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' },
  },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/hydraulic-oil-press-vs-other-types' },
  ],
};

const extractionMethods = [
  { name: 'Presse à huile hydraulique', description: 'Utilise la pression hydraulique pour extraire l\'huile', features: ['Traitement par lots', 'Extraction à haute pression', 'Adaptée à divers matériaux', 'Bonne qualité d\'huile'] },
  { name: 'Presse à vis', description: 'Utilise une vis rotative pour comprimer et extraire l\'huile', features: ['Fonctionnement continu', 'Pression plus basse', 'Débit plus élevé', 'Coût initial plus bas'] },
  { name: 'Extraction par solvant', description: 'Utilise des solvants chimiques pour dissoudre l\'huile', features: ['Rendement le plus élevé', 'Échelle industrielle', 'Processus complexe'] },
];

const productionEfficiency = [
  { aspect: 'Fonctionnement', hydraulic: 'Par lots', screw: 'Continu', solvent: 'Continu' },
  { aspect: 'Temps de cycle', hydraulic: '30-120 min', screw: '2-5 min/kg', solvent: 'Continu' },
  { aspect: 'Production quotidienne', hydraulic: '800-2 000 kg', screw: '1 500-5 000 kg', solvent: '10 000+ kg' },
];

const oilQuality = [
  { aspect: 'Température', hydraulic: '60-100°C', screw: '120-150°C', solvent: 'Ambient' },
  { aspect: 'Conservation des nutriments', hydraulic: 'Excellent', screw: 'Modéré', solvent: 'Bon' },
  { aspect: 'Résidus de solvant', hydraulic: 'Aucun', screw: 'Aucun', solvent: 'Possible' },
  { aspect: 'Saveur', hydraulic: 'Naturelle', screw: 'Chauffée', solvent: 'Neutre' },
];

const oilYield = [
  { material: 'Sésame', hydraulic: '48-54%', screw: '45-50%', solvent: '54-58%' },
  { material: 'Arachide', hydraulic: '45-50%', screw: '42-47%', solvent: '48-52%' },
  { material: 'Noix de walnuts', hydraulic: '45-50%', screw: 'Non adaptée', solvent: 'Non adaptée' },
];

const equipmentCosts = [
  { aspect: 'Coût initial', hydraulic: 'Moyen-élevé', screw: 'Bas-moyen', solvent: 'Très élevé' },
  { aspect: 'Maintenance', hydraulic: 'Modérée', screw: 'Élevée', solvent: 'Très élevée' },
  { aspect: 'Consommation d\'énergie', hydraulic: 'Bas-moyen', screw: 'Moyen', solvent: 'Élevée' },
];

const advantages = [
  { title: 'Polyvalence', desc: 'Large gamme de matériaux : sésame, arachide, colza, soja, noix de walnuts, amande, noix de coco. Plusieurs méthodes de pressage : pressage chaud, pressage froid. Voir nos modèles <a href="/fr/products/standard-hydraulic-oil-press">HN325</a> et <a href="/fr/products/ultra-high-pressure-hydraulic-oil-press">HN500</a>.' },
  { title: 'Qualité de l\'huile', desc: 'Capacité de pressage froid : maintenir la température en dessous de 60°C. Préserver la saveur et les nutriments naturels. Aucune contamination par solvant. Adapté aux marchés biologiques.' },
  { title: 'Contrôle de la pression', desc: 'Extraction à haute pression : jusqu\'à 75 MPa de pression système. Contrôle de précision pour une extraction optimale.' },
];

const chooseHydraulic = ['Marchés d\'huile premium : huiles pressées à froid, produits biologiques', 'Plusieurs types de matériaux : traiter diverses graines et noix', 'Échelle petite à moyenne : start-up, installations de production petites', 'Production orientée qualité : différenciation de marque'];
const chooseScrew = ['Production à haut volume : grande production quotidienne, fonctionnement continu', 'Graines d\'huile conventionnelles : sésame, arachide, colza', 'Acheteurs soucieux du coût : investissement initial plus bas'];
const chooseSolvent = ['Opérations à l\'échelle industrielle : capacité 10 000+ kg/jour', 'Exigences de rendement maximal : extraire chaque goutte d\'huile', 'Production d\'huile raffinée : grandes installations de raffinage'];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-blue-50 to-indigo-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-blue-500/10 text-blue-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">
          GUIDE DE COMPARAISON
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">
          {title.toUpperCase()}
        </h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">
          {description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-blue-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
              <div class="text-sm text-steel-500">Ingénieur Senior en Presse à Huile · Plus de 15 ans d'expérience</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed">
          Le choix de la bonne méthode d'extraction d'huile est une décision critique qui affecte votre efficacité de production, la qualité de votre produit et votre rentabilité globale.
        </p>
      </section>

      <section id="methods-overview" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Vue d'ensemble des méthodes d'extraction</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {extractionMethods.map((item, index) => (
            <div key={index} class="bg-white p-6 rounded-xl border border-steel-100 shadow-md hover:shadow-lg transition-all duration-300">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${index === 0 ? 'bg-amber-100 text-amber-600' : index === 1 ? 'bg-blue-100 text-blue-600' : 'bg-purple-100 text-purple-600'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
                </div>
                <h3 class="font-semibold text-xl text-charcoal-900">{item.name}</h3>
              </div>
              <p class="text-steel-600 mb-4">{item.description}</p>
              <ul class="space-y-2">
                {item.features.map((feature, idx) => (
                  <li key={idx} class="flex items-center gap-2 text-steel-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="production-efficiency" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Efficacité de production</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-indigo-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Aspect</th>
                <th class="px-4 py-3 text-left font-semibold">Presse hydraulique</th>
                <th class="px-4 py-3 text-left font-semibold">Presse à vis</th>
                <th class="px-4 py-3 text-left font-semibold">Extraction par solvant</th>
              </tr>
            </thead>
            <tbody>
              {productionEfficiency.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.aspect}</td>
                  <td class="px-4 py-3 text-amber-600 font-medium">{item.hydraulic}</td>
                  <td class="px-4 py-3 text-blue-600">{item.screw}</td>
                  <td class="px-4 py-3 text-purple-600">{item.solvent}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="oil-quality" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Qualité de l'huile</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Aspect</th>
                <th class="px-4 py-3 text-left font-semibold">Presse hydraulique</th>
                <th class="px-4 py-3 text-left font-semibold">Presse à vis</th>
                <th class="px-4 py-3 text-left font-semibold">Extraction par solvant</th>
              </tr>
            </thead>
            <tbody>
              {oilQuality.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-emerald-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.aspect}</td>
                  <td class="px-4 py-3 text-amber-600 font-medium">{item.hydraulic}</td>
                  <td class="px-4 py-3 text-blue-600">{item.screw}</td>
                  <td class="px-4 py-3 text-purple-600">{item.solvent}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="oil-yield" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Rendement en huile</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-orange-500 to-amber-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Matériau</th>
                <th class="px-4 py-3 text-left font-semibold">Presse hydraulique</th>
                <th class="px-4 py-3 text-left font-semibold">Presse à vis</th>
                <th class="px-4 py-3 text-left font-semibold">Extraction par solvant</th>
              </tr>
            </thead>
            <tbody>
              {oilYield.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-orange-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.material}</td>
                  <td class="px-4 py-3 text-amber-600 font-medium">{item.hydraulic}</td>
                  <td class="px-4 py-3 text-blue-600">{item.screw}</td>
                  <td class="px-4 py-3 text-purple-600">{item.solvent}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="equipment-costs" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Coûts d'équipement</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-purple-500 to-pink-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Aspect</th>
                <th class="px-4 py-3 text-left font-semibold">Presse hydraulique</th>
                <th class="px-4 py-3 text-left font-semibold">Presse à vis</th>
                <th class="px-4 py-3 text-left font-semibold">Extraction par solvant</th>
              </tr>
            </thead>
            <tbody>
              {equipmentCosts.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-purple-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.aspect}</td>
                  <td class="px-4 py-3 text-amber-600 font-medium">{item.hydraulic}</td>
                  <td class="px-4 py-3 text-blue-600">{item.screw}</td>
                  <td class="px-4 py-3 text-purple-600">{item.solvent}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="advantages" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Avantages de la presse à huile hydraulique</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {advantages.map((item, index) => (
            <div key={index} class="bg-gradient-to-br from-amber-50 to-orange-50 p-5 rounded-xl border border-amber-200">
              <h3 class="font-semibold text-amber-800 mb-2">{item.title}</h3>
              <p class="text-steel-700 text-sm leading-relaxed" set:html={item.desc}></p>
            </div>
          ))}
        </div>
      </section>

      <section id="when-to-choose" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Quand choisir chaque méthode</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-amber-50 p-5 rounded-xl border border-amber-200">
            <h3 class="font-semibold text-amber-800 mb-4">Presse à huile hydraulique</h3>
            <ul class="space-y-2">
              {chooseHydraulic.map((item, index) => (
                <li key={index} class="flex items-start gap-2 text-steel-700 text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-blue-50 p-5 rounded-xl border border-blue-200">
            <h3 class="font-semibold text-blue-800 mb-4">Presse à vis</h3>
            <ul class="space-y-2">
              {chooseScrew.map((item, index) => (
                <li key={index} class="flex items-start gap-2 text-steel-700 text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-purple-50 p-5 rounded-xl border border-purple-200">
            <h3 class="font-semibold text-purple-800 mb-4">Extraction par solvant</h3>
            <ul class="space-y-2">
              {chooseSolvent.map((item, index) => (
                <li key={index} class="flex items-start gap-2 text-steel-700 text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">
          Le choix de la bonne méthode d'extraction d'huile dépend de vos besoins commerciaux spécifiques. Les presses à huile hydrauliques Haonuo offrent le meilleur équilibre entre qualité, efficacité et polyvalence pour la plupart des opérations de production d'huile.
        </p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">PRÊT À COMMENCER VOTRE PRODUCTION D'HUILE ?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Notre équipe d'ingénieurs peut vous aider à sélectionner le meilleur équipement et à optimiser votre investissement pour des rendements maximaux.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          Contacter nos experts
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/fr/products" class="btn-outline border-white text-white hover:bg-white/10">
          Parcourir l'équipement
        </a>
        <a href="/fr/resources" class="btn-outline border-white text-white hover:bg-white/10">
          Retour aux ressources
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

