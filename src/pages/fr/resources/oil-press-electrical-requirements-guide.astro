---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'oil-press-electrical-requirements-guide');
const t = getTranslations('fr');

const title = resource?.data.title.fr || 'Guide des exigences électriques de la presse à huile';
const description = resource?.data.description.fr || 'Configuration de l\'alimentation électrique et du générateur';
const seoKeywords = resource?.data.seoKeywords || ['exigences électriques presse à huile', 'générateur pour presse à huile', 'configuration alimentation électrique'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/electrical-guide-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Ingénieur Senior en Presse à Huile', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/oil-press-electrical-requirements-guide' },
  ],
};

const voltageSpecs = ['220V Monophasé (commun dans de nombreux pays)', '380V Triphasé (norme industrielle)', '415V Triphasé (certaines régions)', 'Fréquence: 50Hz ou 60Hz', 'La tension peut être personnalisée sans frais supplémentaires'];
const powerConsumption = ['Puissance du moteur: Tous les modèles Haonuo: 2.2 KW', 'Veille: 0.5-1.0 KW', 'Pressage: 1.5-2.2 KW', 'Pic: Jusqu\'à 3.0 KW (durant la montée en pression)'];
const currentRequirements = ['Monophasé (220V): En marche 10-15 A, Démarrage 20-30 A', 'Triphasé (380V): En marche 5-8 A, Démarrage 10-15 A', 'Disjoncteur recommandé: Monophasé 30 A, Triphasé 16 A par phase'];

const generatorCapacity = [
  { model: 'HN325', singlePhase: '5 kVA', threePhase: '5 kVA' },
  { model: 'HN355', singlePhase: '5.5 kVA', threePhase: '5.5 kVA' },
  { model: 'HN426', singlePhase: '5.5 kVA', threePhase: '5.5 kVA' },
  { model: 'HN480', singlePhase: '5.5 kVA', threePhase: '5.5 kVA' },
  { model: 'HN500', singlePhase: '7 kVA', threePhase: '7 kVA' },
];

const safetyMargin = ['Ajouter 20-30% pour le courant de démarrage', 'Prendre en compte d\'autres équipements sur le même circuit', 'Tenir compte des chutes de tension'];
const recommendedGenerator = [
  { models: 'HN325/HN355', size: '6-7 kVA' },
  { models: 'HN426/HN480', size: '7-8 kVA' },
  { models: 'HN500', size: '8-10 kVA' },
];

const generatorSelection = [
  { title: 'Type', desc: 'Diesel (le plus courant), Essence, Solaire' },
  { title: 'Qualité', desc: 'Marques réputées, type onduleur recommandé' },
  { title: 'Caractéristiques', desc: 'Régulation de tension, protection contre les surcharges, démarrage/arrêt automatique' },
];

const wiringRequirements = [
  { distance: '10m', singlePhase: '2.5 mm²', threePhase: '2.5 mm²' },
  { distance: '20m', singlePhase: '4 mm²', threePhase: '2.5 mm²' },
  { distance: '30m', singlePhase: '6 mm²', threePhase: '4 mm²' },
  { distance: '50m', singlePhase: '10 mm²', threePhase: '6 mm²' },
];

const controlPanelComponents = ['Interrupteur principal', 'Disjoncteurs', 'Démarreur de moteur', 'Boutons de commande', 'Arrêt d\'urgence', 'Lumières indicateurs'];
const electricalSafety = ['Porter des gants isolants', 'Utiliser des outils isolants', 'Suivre les procédures de verrouillage'];
const voltageFluctuations = [
  { type: 'Tension basse', effects: 'Surchauffe du moteur, performance réduite', solution: 'Stabilisateur de tension' },
  { type: 'Tension haute', effects: 'Endommagement du moteur, défaillance des composants', solution: 'Protection contre les surtensions' },
];

const lightningProtection = ['Installation de paratonnerre', 'Dispositifs de protection contre les surtensions', 'Système de mise à la terre'];
const upsInfo = ['Applications: Sauvegarde du panneau de commande, arrêt d\'urgence', 'Dimensionnement: 500-1000 VA généralement suffisant'];
const solarInfo = ['Applications: Emplacements hors réseau, opérations durables', 'Considérations: Dimensionnement des panneaux solaires, stockage de batterie, générateur de secours recommandé'];

const powerManagement = ['Fonctionner pendant les heures creuses si possible', 'Traitement par lots pour réduire les cycles de démarrage'];
const costCalculation = ['Coût énergétique par jour = (Consommation d\'énergie x Heures x Taux) / 1000', 'Exemple: 2.0 KW x 8 heures x 0.15€/KWh = 2.40€/jour'];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE TECHNIQUE</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Ingénieur Senior en Presse à Huile · 15+ Ans d'Expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed">Comprendre les exigences électriques de votre presse à huile hydraulique est crucial pour un fonctionnement sûr et efficace.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Une configuration électrique appropriée garantit un fonctionnement sûr et prolonge la durée de vie de l'équipement.</p>
        </div>
      </section>

      <section id="basic-requirements" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Exigences électriques de base</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Spécifications de tension</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
          {voltageSpecs.map((spec, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-lg border border-blue-100 flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span class="text-steel-700 text-sm">{spec}</span>
            </div>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Consommation d'énergie</h3>
        <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl p-6 border border-purple-100 mb-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {powerConsumption.map((item, index) => (
              <div key={index} class="bg-white p-3 rounded-lg text-center">
                <p class="text-sm text-steel-600">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Exigences en courant</h3>
        <div class="space-y-2">
          {currentRequirements.map((req, index) => (
            <div key={index} class="bg-white p-4 rounded-lg border border-steel-100 shadow-sm flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="text-steel-700">{req}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="generator" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Exigences en générateur</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Capacité du générateur</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-green-500 to-emerald-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Modèle</th><th class="px-4 py-3 text-left font-semibold">Monophasé</th><th class="px-4 py-3 text-left font-semibold">Triphasé</th></tr>
            </thead>
            <tbody>
              {generatorCapacity.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-green-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.model}</td>
                  <td class="px-4 py-3 text-green-600">{item.singlePhase}</td>
                  <td class="px-4 py-3 text-green-600">{item.threePhase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="bg-orange-50 p-5 rounded-xl border border-orange-100">
            <h4 class="font-semibold text-orange-800 mb-3">Marge de sécurité</h4>
            <ul class="space-y-2">
              {safetyMargin.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-amber-50 p-5 rounded-xl border border-amber-100">
            <h4 class="font-semibold text-amber-800 mb-3">Taille recommandée du générateur</h4>
            <ul class="space-y-2">
              {recommendedGenerator.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-center justify-between">
                  <span>{item.models}</span>
                  <span class="font-bold text-amber-600">{item.size}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Critères de sélection du générateur</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {generatorSelection.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-sm">
              <h4 class="font-semibold text-charcoal-900 mb-2">{item.title}</h4>
              <p class="text-steel-600 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="power-supply" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Configuration de l'alimentation électrique</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Connexion au réseau</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="bg-blue-50 p-5 rounded-xl border border-blue-100">
            <h4 class="font-semibold text-blue-800 mb-3">Connexion monophasée</h4>
            <ul class="space-y-1 text-steel-700 text-sm">
              <li>L1 -> Disjoncteur -> Moteur</li>
              <li>N -> Moteur</li>
              <li>PE -> Châssis de l'équipement</li>
            </ul>
          </div>
          <div class="bg-green-50 p-5 rounded-xl border border-green-100">
            <h4 class="font-semibold text-green-800 mb-3">Connexion triphasée</h4>
            <ul class="space-y-1 text-steel-700 text-sm">
              <li>L1, L2, L3 -> Disjoncteur -> Moteur</li>
              <li>N -> Panneau de commande</li>
              <li>PE -> Châssis de l'équipement</li>
            </ul>
          </div>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Exigences en câblage</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Distance</th><th class="px-4 py-3 text-left font-semibold">Monophasé (220V)</th><th class="px-4 py-3 text-left font-semibold">Triphasé (380V)</th></tr>
            </thead>
            <tbody>
              {wiringRequirements.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.distance}</td>
                  <td class="px-4 py-3 text-blue-600">{item.singlePhase}</td>
                  <td class="px-4 py-3 text-blue-600">{item.threePhase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Composants du panneau de commande</h3>
        <div class="flex flex-wrap gap-2">
          {controlPanelComponents.map((item, index) => (
            <span key={index} class="bg-steel-100 text-steel-700 px-4 py-2 rounded-lg text-sm font-medium">{item}</span>
          ))}
        </div>
      </section>

      <section id="safety" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Considérations de sécurité</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-red-50 p-5 rounded-xl border border-red-100">
            <h3 class="font-semibold text-red-800 mb-3">Sécurité électrique</h3>
            <ul class="space-y-2">
              {electricalSafety.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-orange-50 p-5 rounded-xl border border-orange-100">
            <h3 class="font-semibold text-orange-800 mb-3">Fluctuations de tension</h3>
            <ul class="space-y-3">
              {voltageFluctuations.map((item, index) => (
                <li key={index} class="text-sm">
                  <p class="font-medium text-steel-700">{item.type}</p>
                  <p class="text-steel-500">{item.effects}</p>
                  <p class="text-green-600 font-medium">Solution: {item.solution}</p>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-purple-50 p-5 rounded-xl border border-purple-100">
            <h3 class="font-semibold text-purple-800 mb-3">Protection contre la foudre</h3>
            <ul class="space-y-2">
              {lightningProtection.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 16.326A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.973"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="backup-power" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Solutions d'alimentation de secours</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-blue-50 p-5 rounded-xl border border-blue-100">
            <h3 class="font-semibold text-blue-800 mb-3">UPS (Alimentation sans interruption)</h3>
            <ul class="space-y-2">
              {upsInfo.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M7 6V4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-green-50 p-5 rounded-xl border border-green-100">
            <h3 class="font-semibold text-green-800 mb-3">Systèmes d'énergie solaire</h3>
            <ul class="space-y-2">
              {solarInfo.map((item, index) => (
                <li key={index} class="text-steel-700 flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="energy-efficiency" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conseils d'efficacité énergétique</h2>
        
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Gestion de l'énergie</h3>
        <div class="flex flex-wrap gap-2 mb-8">
          {powerManagement.map((item, index) => (
            <span key={index} class="bg-green-100 text-green-700 px-4 py-2 rounded-lg text-sm font-medium">{item}</span>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Calcul du coût</h3>
        <div class="bg-gradient-to-r from-charcoal-800 to-charcoal-900 p-6 rounded-xl text-white">
          <div class="space-y-2">
            {costCalculation.map((item, index) => (
              <p key={index}>{item}</p>
            ))}
          </div>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Une configuration électrique appropriée est essentielle pour un fonctionnement sûr et efficace des presses à huile hydrauliques. Pour des conseils personnalisés sur la configuration électrique, contactez l'équipe de support technique de Haonuo.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">PRÊT À COMMENCER VOTRE PRODUCTION D'HUILE?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Notre équipe d'ingénieurs peut vous aider à configurer l'alimentation électrique optimale pour votre équipement de presse à huile.</p>
