---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-buying-guide');
const t = getTranslations('fr');

const title = resource?.data.title.fr || resource?.data.title.en || 'Guide d\'Achat de Presse à Huile Hydraulique';
const description = resource?.data.description.fr || resource?.data.description.en || 'Investissez dans la bonne presse en toute confiance';
const seoKeywords = resource?.data.seoKeywords || ['guide achat presse huile', 'comment choisir presse huile', 'checklist achat presse'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/buying-guide-hero.webp',
  author: { '@type': 'Person', name: 'Eason', jobTitle: 'Senior Hydraulic Press Engineer', url: 'https://www.hydoilpress.com/about/', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.', url: 'https://www.hydoilpress.com' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/fr/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/hydraulic-oil-press-buying-guide/' },
  ],
};

const buyingChecklist = [
  { category: 'Besoins de Production', items: [
    'Objectif de production journalière (kg/jour)',
    'Types de matériaux à transformer',
    'Qualité d\'huile requise (vierge, cuisson, etc.)',
    'Besoin de capacité de pressage à froid ?',
  ]},
  { category: 'Spécifications Techniques', items: [
    'Pression hydraulique (40-60 MPa recommandée)',
    'Puissance moteur (2.2 kW standard)',
    'Tension (220V ou 380V)',
    'Dimensions et poids de la machine',
  ]},
  { category: 'Qualité et Garantie', items: [
    'Réputation et expérience du fabricant',
    'Période de garantie (1 an minimum)',
    'Disponibilité du service après-vente',
    'Disponibilité des pièces détachées',
  ]},
  { category: 'Considérations Opérationnelles', items: [
    'Capacité de production journalière cible',
    'Coûts d\'installation et de formation',
    'Pièces détachées et maintenance',
    'Coûts d\'exploitation (énergie, main-d\'œuvre)',
  ]},
];

const questionsToAsk = [
  'Quel est votre objectif de production journalière ?',
  'Quelles graines/noix allez-vous transformer ?',
  'Avez-vous besoin de la capacité de pressage à froid ?',
  'Quelle est votre capacité de production cible ?',
  'Avez-vous une source d\'électricité ?',
  'Quel est votre espace de travail disponible ?',
  'Avez-vous besoin de formation et d\'installation ?',
  'Quel est votre marché cible (vierge, cuisson, cosmétique) ?',
];

const redFlags = [
  'Prix irréaliste et bas',
  'Aucune garantie offerte',
  'Aucun service après-vente',
  'Lieu de fabricant inconnu',
  'Aucune documentation technique',
  'Pression inférieure à 40 MPa',
  'Équipement d\'occasion/reconditionné',
];

---

<BaseLayout locale="fr" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE D'ACHAT</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Eason</div>
            <div class="text-sm text-steel-500">Ingénieur Senior en Presse à Huile · 15+ ans d'expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Ce qu'il faut savoir avant d'acheter une presse à huile hydraulique</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Investir dans une presse à huile hydraulique est une décision importante qui peut transformer votre entreprise de production d'huile. Ce guide complet couvre tout ce que vous devez savoir pour faire le bon achat.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Une bonne presse à huile peut s'amortir en 1-3 mois. Un mauvais achat peut entraîner des années de frustration et de pertes de revenus. Ce guide vous aidera à éviter les erreurs coûteuses.</p>
        </div>
      </section>

      <section id="checklist" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Votre checklist avant l'achat d'une presse à huile hydraulique</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {buyingChecklist.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-md overflow-hidden">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <h3 class="font-semibold text-white flex items-center gap-2">
                  <span class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.category}
                </h3>
              </div>
              <div class="p-5">
                <ul class="space-y-2">
                  {item.items.map((item2, idx) => (
                    <li key={idx} class="flex items-start gap-3">
                      <div class="w-5 h-5 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                      </div>
                      <span class="text-steel-700 text-sm">{item2}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="models" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Choisir le bon modèle de presse à huile hydraulique</h2>
        <p class="text-steel-600 mb-6">Le bon modèle dépend de votre <strong>type de graine principal</strong> (les graines molles demandent moins de pression ; les noix dures et la noix de coco avec coque demandent plus de force), de votre <strong>objectif de production journalier</strong> et de la part de <strong>pressage à froid ou à chaud</strong> envisagée.</p>
        <p class="text-steel-600 mb-6">Ce guide liste les questions à poser à <em>n'importe quel</em> fournisseur. Pour une comparaison côte à côte de toute la gamme Haonuo (HN300 à HN500) avec les vraies spécifications et des recommandations par graine, consultez la page dédiée <a href="/fr/products/model-comparison/" class="text-amber-600 hover:underline font-semibold">Comparaison des Modèles</a>. Pour un aperçu rapide de toute la gamme hydraulique, visitez le <a href="/fr/hydraulic-oil-press-machine/" class="text-amber-600 hover:underline font-semibold">Guide d'achat des presses hydrauliques</a>.</p>
      </section>

      <section id="questions" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Questions à poser à votre fournisseur de presse à huile</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {questionsToAsk.map((question, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-xl border border-blue-100 flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{index + 1}</div>
              <p class="text-steel-700">{question}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="red-flags" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Signaux d'alerte lors de l'achat d'une presse à huile</h2>
        <div class="bg-red-50 rounded-xl border border-red-200 p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {redFlags.map((flag, index) => (
              <div key={index} class="bg-white p-3 rounded-lg flex items-center gap-3 border border-red-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="text-steel-700">{flag}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="total-cost-ownership" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Coût total de possession</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Le prix de la machine indiqué ne représente généralement que 60 à 75 % du coût rendu et opérationnel la première année. Le fret, les frais portuaires et les droits de douane, l'installation électrique, les travaux de fondation, la mise en service, la formation des opérateurs et un premier lot de pièces de rechange s'ajoutent tous à la facture, et une machine bon marché qui manque de support local devient souvent le devis le plus cher sur la table. Apprendre à choisir une presse à huile commence donc par le montant total, pas par le premier chiffre annoncé.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Demandez à chaque fournisseur présélectionné de chiffrer le même périmètre</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>Prix de la machine avec la configuration exacte du fût — un fût simple ou double change à la fois le prix et le débit.</li>
            <li>Pièces de rechange standard fournies avec la machine et prix d'un kit annuel recommandé.</li>
            <li>Périmètre du panneau électrique : ce qui est précâblé sur la machine et ce que le client doit installer.</li>
            <li>Support d'installation : assistance à distance ou technicien sur site, et qui paie les déplacements et les journées.</li>
            <li>Conditions de garantie : durée, ce qui est couvert et comment les réclamations sont traitées au-delà des frontières.</li>
            <li>Délai de livraison en semaines par rapport à une date d'acompte définie, et non des affirmations de « stock disponible ».</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">Comparez les totaux obtenus, pas la première ligne. Un prix de machine inférieur de 10 % disparaît en une semaine de mise en service retardée ou pour un seul kit de joints d'étanchéité expédié par avion.</p>
      </section>

      <section id="verifying-manufacturer" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Vérifier le fabricant avant de payer</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Les photos d'usine dans une brochure sont gratuites ; les preuves ne le sont pas. Avant de verser un acompte, vérifiez le constructeur avec le même sérieux que celui que vous appliquez à la spécification de la machine.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Demandez une visite vidéo en direct de l'atelier montrant le modèle que vous achetez en cours d'assemblage, et non un showroom.</li>
          <li>Demandez deux ou trois clients de référence sur des marchés similaires et contactez-les au sujet du support d'installation, pas seulement de la qualité de la machine.</li>
          <li>Vérifiez que la pression nominale, l'épaisseur d'acier et la marque du moteur indiquées dans le devis correspondent à ce qui a été discuté oralement — les machines de classe HN vont de 325 t / 60 MPa et au-delà sur des entraînements de 2,2–3 kW, et des fiches techniques vagues sont un signal d'alerte.</li>
          <li>Confirmez les plaques signalétiques numérotées, un certificat de pression estampillé pour le fût et le vérin, et une documentation électrique dans une langue que votre électricien peut lire.</li>
          <li>Payez par des instruments commerciaux traçables avec une structure acompte–solde définie, liée à des jalons d'inspection et d'expédition ; évitez le prépaiement intégral ou la pression au paiement hors plateforme.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed mt-4">Les tactiques de pression font aussi partie de cette liste de signaux d'alerte. Un vendeur qui exige un acompte immédiat, refuse de consigner par écrit les spécifications et les dates de livraison convenues, ou ramène chaque question technique à « faites-nous confiance, nous exportons partout » vend de la confiance plutôt que de l'équipement. Les fabricants légitimes sont à l'aise avec les questions, les références et les jalons — parce qu'une machine bien construite et une usine documentée survivent aux trois.</p>
      </section>

      <section id="installation-training" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Installation, formation et premier mois</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Un bon fournisseur considère la livraison comme le milieu de la transaction, et non sa fin. Convenez avant la commande du support de mise en service inclus : positionnement et ancrage de la machine, raccordement hydraulique et électrique, premiers essais de pressage avec vos graines réelles, réglage de la pression et des temps, et formation des opérateurs au chargement, au maintien, au déchargement, au nettoyage et à la routine d'inspection quotidienne.</p>
        <p class="text-steel-700 leading-relaxed mb-4">Planifiez le premier mois de manière délibérée : utilisez une seule graine et une seule recette, tenez des registres de lots et vérifiez l'huile résiduelle du tourteau par rapport au chiffre annoncé par le fournisseur — 6 à 8 % pour un fût à fentes de pressage à froid, environ 5 à 7 % pour un pressage à chaud bien mené. Les problèmes acceptés en silence le premier mois deviennent « normaux » au sixième mois. Le dimensionnement et le choix du modèle pour la charge de travail elle-même — HN325 pour les petits lots et la production d'entrée de gamme, HN365 pour des volumes journaliers plus élevés, HN426 pour le pressage à froid dédié, HN500 pour le service le plus lourd — sont décrits dans notre <a href="/fr/products/" class="text-amber-600 hover:underline">gamme de produits</a>, et les prérequis d'installation et d'alimentation sont détaillés dans le <a href="/fr/resources/oil-press-electrical-requirements-guide/" class="text-amber-600 hover:underline">guide des exigences électriques</a>.</p>
        <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Machines d'occasion et calendrier de livraison</h3>
        <p class="text-steel-700 leading-relaxed mb-4">Une presse hydraulique d'occasion peut offrir un excellent rapport qualité-prix, car le châssis et l'enceinte sous pression survivent à plusieurs générations de joints et de commandes — mais seulement si l'historique est vérifiable. Inspectez l'état du fût et du vérin, demandez les registres de maintenance et d'analyse d'huile, effectuez un essai de pression avant l'achat, et intégrez le prix d'un rafraîchissement complet des joints, flexibles et composants électriques dans la comparaison avec le neuf. À l'inverse, une machine d'occasion vendue sans registres est une enceinte sous pression inconnue sans fabricant derrière elle, et l'économie survit rarement à la première révision.</p>
        <p class="text-steel-700 leading-relaxed">Enfin, planifiez le calendrier d'achat en fonction des graines, pas de l'émotion. Commander au début de la récolte signifie se battre pour les créneaux d'usine et le fret alors que la matière première la moins chère attend dans la cour ; les ateliers les mieux gérés passent commande pour que la mise en service se termine avant leur saison d'achat, et consacrent les mois calmes à la formation et à des lots d'essai sur des graines moins chères.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Achetez votre presse à huile hydraulique en toute confiance</h2>
        <p class="text-steel-700 leading-relaxed">Choisir la bonne presse à huile hydraulique est crucial pour le succès de votre entreprise. En suivant la checklist de ce guide et en travaillant avec un fabricant réputé, vous pouvez faire un investissement en toute confiance qui sera rentable pendant des années.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">OBTENEZ VOTRE DEVIS GRATUIT DÈS AUJOURD'HUI</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Envoyez-nous vos besoins de production et obtenez une recommandation personnalisée adaptée à votre activité.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/contact/" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          {t.resources.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/fr/products/" class="btn-outline border-white text-white hover:bg-white/10">{t.nav.products}</a>
        <a href="/fr/resources/" class="btn-outline border-white text-white hover:bg-white/10">{t.resources.backToResources}</a>
      </div>
    </div>
  </section>
</BaseLayout>