---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';

const t = getTranslations('fr');
const title = 'Guide d\'achat de presse à huile hydraulique';
const description = 'Comment choisir la bonne machine pour votre entreprise';
const seoKeywords = ['achat presse hydraulique', 'guide selection presse', 'machine hydraulique'];
const publishedAt = new Date();
const updatedAt = publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/buying-guide-hero.webp',
  author: {
    '@type': 'Person',
    name: 'Haonuo Engineering Team',
    jobTitle: 'Ingénieur Senior en Presse à Huile',
    worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' },
  },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/hydraulic-oil-press-buying-guide' },
  ],
};

const keyFactors = [
  { title: 'Type de matière première', items: ['Graines classiques : sésame, arachide, colza, soja, graine de thé', 'Matériaux à coque dure : noyer, amande, noyau d\'abricot, noix de tigre', 'Pressage à froid uniquement : matériaux nécessitant une extraction à basse température'] },
  { title: 'Échelle de production', items: ['Petite échelle : 500-1 500 kg/jour', 'Moyenne échelle : 1 500-3 000 kg/jour', 'Grande échelle : 3 000+ kg/jour'] },
  { title: 'Méthode de pressage', items: ['Pressage à chaud : rendement plus élevé, temps de cycle plus rapide (30-40 minutes/charge)', 'Pressage à froid : huile de qualité supérieure, temps de cycle plus long (2 heures/charge)'] },
];

const models = [
  { name: 'HN325 Standard', bestFor: ['Producteurs à petite échelle', 'Graines oléagineuses classiques (sésame, arachide, colza, soja)', 'Opérations de pressage à chaud'], specs: ['Force de pressage 325 tonnes', 'Pression système 60 Mpa', 'Pression de surface de gâteau 27,78 Mpa/cm2', 'Capacité par charge 100 kg', 'Puissance moteur 2,2 KW'] },
  { name: 'HN355 Heavy Duty', bestFor: ['Opérations commerciales à moyenne échelle', 'Traitement de matériaux légèrement plus durs', 'Fonctionnement intensif continu'], specs: ['Force de pressage 360 tonnes', 'Pression système 63 Mpa', 'Pression de surface de gâteau 30,15 Mpa/cm2', 'Capacité par charge 100 kg'] },
  { name: 'HN426 Cold Press', bestFor: ['Opérations de pressage à froid', 'Matériaux à coque dure (noyer, amande, noyau d\'abricot)', 'Production d\'huile de qualité supérieure'], specs: ['Force de pressage 500 tonnes', 'Pression système 70 Mpa', 'Pression de surface de gâteau 42 Mpa/cm2', 'Capacité par charge 100 kg'] },
  { name: 'HN480 High Pressure', bestFor: ['Exigences de production mixtes', 'Opérations de taille moyenne à grande', 'Matériaux classiques et de pressage à froid'], specs: ['Force de pressage 560 tonnes', 'Pression système 72 Mpa', 'Pression de surface de gâteau 48 Mpa/cm2', 'Capacité par charge 100 kg'] },
  { name: 'HN500 Ultra High Pressure', bestFor: ['Opérations industrielles à grande échelle', 'Matériaux de pressage à froid les plus durs', 'Exigences de rendement maximal'], specs: ['Force de pressage 620 tonnes', 'Pression système 75 Mpa', 'Pression de surface de gâteau 52 Mpa/cm2', 'Capacité par charge 100 kg'] },
];

const decisionTree = [
  { category: 'Graines classiques uniquement', options: ['Petite échelle -> HN325', 'Moyenne échelle -> HN355', 'Grande échelle -> HN500'] },
  { category: 'Matériaux de pressage à froid', options: ['Pressage à froid standard -> HN426', 'Pressage à froid haute capacité -> HN480', 'Pressage à froid rendement maximal -> HN500'] },
  { category: 'Matériaux mixtes', options: ['Performance équilibrée -> HN480', 'Polyvalence maximale -> HN500'] },
];

const barrelConfig = [
  { type: 'Tonneau simple', features: ['Coût initial plus bas', 'Fonctionnement plus simple', 'Idéal pour les opérations à petite échelle ou les startups'] },
  { type: 'Tonneau double', features: ['Double presque le débit', 'Capacité de fonctionnement continu', 'Recommandé pour les utilisations commerciales et industrielles'] },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr/" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">
          GUIDE D'ACHAT
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">
          {title.toUpperCase()}
        </h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">
          {description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
              <div class="text-sm text-steel-500">Ingénieur Senior en Presse à Huile · 15+ Ans d'Expérience</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed">
          Choisir la bonne presse à huile hydraulique est une décision d'investissement critique qui affecte directement votre capacité de production, votre rendement en huile et votre rentabilité globale. Avec plusieurs modèles disponibles, comprendre les différences clés entre eux est essentiel pour prendre une décision éclairée.
        </p>
      </section>

      <section id="key-factors" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Facteurs clés à considérer</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {keyFactors.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <h3 class="font-semibold text-lg text-amber-600 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm">{task}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="model-comparison" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comparaison des modèles</h2>
        <div class="space-y-6">
          {models.map((item, index) => (
            <div key={index} class="bg-white p-6 rounded-xl border border-steel-100 shadow-md">
              <h3 class="font-semibold text-xl text-charcoal-900 mb-4">{item.name} Presse à Huile Hydraulique</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-medium text-amber-600 mb-3">Idéal pour:</h4>
                  <ul class="space-y-2">
                    {item.bestFor.map((feature, idx) => (
                      <li key={idx} class="flex items-center gap-2 text-steel-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="font-medium text-blue-600 mb-3">Spécifications clés:</h4>
                  <ul class="space-y-2">
                    {item.specs.map((spec, idx) => (
                      <li key={idx} class="text-steel-700">{spec}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="decision-tree" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Arbre de décision de sélection</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Étape 1: Déterminez votre matière première principale</h3>
        <div class="space-y-4">
          {decisionTree.map((item, index) => (
            <div key={index} class="bg-gradient-to-br from-steel-50 to-steel-100 p-5 rounded-xl border border-steel-200">
              <h4 class="font-semibold text-charcoal-900 mb-2">{item.category}</h4>
              <ul class="space-y-1">
                {item.options.map((option, idx) => (
                  <li key={idx} class="text-steel-700">{option}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="barrel-configuration" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Configuration tonneau simple vs double</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {barrelConfig.map((item, index) => (
            <div key={index} class="bg-white p-6 rounded-xl border border-steel-100 shadow-md">
              <h3 class="font-semibold text-lg text-charcoal-900 mb-4">{item.type}</h3>
              <ul class="space-y-2">
                {item.features.map((feature, idx) => (
                  <li key={idx} class="flex items-center gap-2 text-steel-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">
          Sélectionner la bonne presse à huile hydraulique nécessite une évaluation attentive de vos exigences de production spécifiques, de vos matériaux et de vos contraintes opérationnelles. Pour des recommandations personnalisées basées sur vos besoins spécifiques, contactez notre équipe d'ingénieurs pour une consultation gratuite.
        </p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">PRÊT À DÉBUTER VOTRE PRODUCTION D'HUILE?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Notre équipe d'ingénieurs peut vous aider à sélectionner le meilleur équipement et à optimiser votre investissement pour des rendements maximaux.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          Contacter nos experts
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/fr/products" class="btn-outline border-white text-white hover:bg-white/10">
          Parcourir l'équipement
        </a>
        <a href="/fr/resources" class="btn-outline border-white text-white hover:bg-white/10">
          Retour aux ressources
        </a>
      </div>
    </div>
  </section>
</BaseLayout>