---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'oil-press-raw-materials-guide');
const t = getTranslations('fr');

const title = resource?.data.title.fr || 'Guide des matières premières pour presse à huile';
const description = resource?.data.description.fr || 'Meilleures graines et noix pour l\'extraction';
const seoKeywords = resource?.data.seoKeywords || ['matieres premieres huile', 'graines extraction'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/raw-materials-guide-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about' },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/oil-press-raw-materials-guide' },
  ],
};

const keyCharacteristics = [
  { icon: 'droplet', title: 'Teneur en huile', desc: 'Une teneur en huile plus élevée = un rendement plus élevé par kg' },
  { icon: 'thermometer', title: 'Teneur en humidité', desc: 'Critique pour une extraction optimale (trop sec = rendement réduit, trop humide = émulsification)' },
  { icon: 'circle', title: 'Taille et forme des graines', desc: 'Influencent l\'efficacité du broyage' },
  { icon: 'hammer', title: 'Dureté', desc: 'Détermine la pression de pressage nécessaire' },
  { icon: 'trending-up', title: 'Valeur marchande', desc: 'Huiles de qualité supérieure = marge bénéficiaire plus élevée' },
];

const modelToSlug = {
  'HN325': 'standard-hydraulic-oil-press',
  'HN365': 'commercial-hydraulic-oil-press',
  'HN426': 'cold-press-hydraulic-oil-press',
  'HN480': 'high-pressure-hydraulic-oil-press',
  'HN500': 'ultra-high-pressure-hydraulic-oil-press',
};

const oilMaterials = [
  { name: 'Graine de sésame', oilContent: '45-55%', moisture: '5-6% chaud, 7-8% froid', dehulling: '98%+', roasting: '160-180°C, 25-30 min', yield: 'Chaud 48-54%, Froid 42-48%', models: ['HN325', 'HN365', 'HN426'], hot: true, cold: true },
  { name: 'Arachides', oilContent: '45-50%', moisture: '5-7% chaud', dehulling: '95%+', roasting: '165-185°C, 30-35 min', yield: 'Chaud 45-50%, Froid 38-42%', models: ['HN325', 'HN365', 'HN480'], hot: true, cold: true },
  { name: 'Colza', oilContent: '40-45%', moisture: '6-8% chaud', dehulling: '85-90%', roasting: '150-170°C, 20-25 min', yield: 'Chaud 38-42%, Froid 32-36%', models: ['HN325', 'HN365', 'HN500'], hot: true, cold: true },
  { name: 'Noix', oilContent: '60-70%', moisture: '7-9% froid', dehulling: 'Enlèvement complet', roasting: 'Pas de torréfaction', yield: 'Froid 45-50%', models: ['HN426', 'HN480', 'HN500'], hot: false, cold: true },
  { name: 'Amandes', oilContent: '50-60%', moisture: '7-9% froid', dehulling: 'Enlèvement complet', roasting: 'Pas de torréfaction', yield: 'Froid 42-48%', models: ['HN426', 'HN480', 'HN500'], hot: false, cold: true },
  { name: 'Noix de coco', oilContent: '60-70%', moisture: '6-8%', dehulling: 'Retirer la coque et la balle', roasting: 'N/A', yield: 'Chaud 60-65%, Froid 55-60%', models: ['HN426', 'HN480', 'HN500'], hot: true, cold: true },
  { name: 'Soja', oilContent: '18-22%', moisture: '7-9% chaud', dehulling: '90%+', roasting: '140-160°C, 25-30 min', yield: 'Chaud 18-22%, Froid 15-18%', models: ['HN480', 'HN500'], hot: true, cold: true },
  { name: 'Graines de thé', oilContent: '30-40%', moisture: '5-7% chaud', dehulling: 'Retirer les coques', roasting: '150-170°C, 25-30 min', yield: 'Chaud 28-35%', models: ['HN325', 'HN365', 'HN426'], hot: true, cold: false },
];

const preparationSteps = [
  { step: '1', title: 'Nettoyage des graines', details: ['Retirer les impuretés (pierres, métal, saleté)', 'Séparer les graines endommagées', 'Cible: < 0,5% d\'impuretés'] },
  { step: '2', title: 'Conditionnement d\'humidité', details: ['Trop sec: Ajouter de l\'humidité avec humidificateur', 'Trop humide: Sécher avec séchoir à air chaud ou séchage au soleil'] },
  { step: '3', title: 'Torréfaction (Pressage chaud)', details: ['Sésame: 160-180°C, 25-30 min', 'Arachides: 165-185°C, 30-35 min', 'Colza: 150-170°C, 20-25 min'] },
  { step: '4', title: 'Broyage', details: ['Taille de particule optimale: 2-4 mm pour la plupart des matériaux', '3-5 mm pour les noix'] },
];

const storageTips = [
  { icon: 'thermometer', title: 'Température', desc: '15-25°C' },
  { icon: 'cloud', title: 'Humidité', desc: '< 65% d\'humidité relative' },
  { icon: 'clock', title: 'Durée', desc: '< 6 mois pour une qualité optimale' },
  { icon: 'shield', title: 'Protection contre les nuisibles', desc: 'Utiliser des conteneurs anti-rodents, inspection régulière' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr/" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE DE PRODUCTION</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Ingénieur Senior en Presse à Huile · 15+ Ans d'Expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">La qualité de votre huile commence avec la matière première</h2>
        <p class="text-steel-700 leading-relaxed mb-4">La sélection des bonnes matières premières est cruciale pour une production d'huile réussie. Différentes graines et noix ont des teneurs en huile, des exigences de traitement et des valeurs marchandes variables.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Choisir les bonnes matières premières peut avoir un impact significatif sur votre efficacité de production et la qualité de votre produit. Comprendre les caractéristiques de chaque matériau est la clé pour maximiser les rendements.</p>
        </div>
      </section>

      <section id="properties" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comprendre les propriétés des matières premières</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Caractéristiques clés</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {keyCharacteristics.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'droplet' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S6 13 6 15a7 7 0 0 0 7 7z"/></svg>}
                  {item.icon === 'thermometer' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>}
                  {item.icon === 'circle' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>}
                  {item.icon === 'hammer' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 2H5a2 2 0 0 0-2 2v7l3.45 3.45a2 2 0 0 0 1.41.55H13l5 5V4a2 2 0 0 0-2-2z"/></svg>}
                  {item.icon === 'trending-up' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="materials" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Graines oléagineuses courantes et ce que chacune rapporte</h2>
        <div class="space-y-6">
          {oilMaterials.map((material, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden hover:shadow-lg transition-all duration-300">
              <div class="bg-gradient-to-r from-amber-500 to-orange-500 p-4">
                <div class="flex items-center justify-between">
                  <h3 class="font-display text-xl text-white">{material.name}</h3>
                  <div class="flex gap-2">
                    {material.hot && <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><path d="M18.07 16.94a8 8 0 1 1-11.31 0"/></svg> Chaud</span>}
                    {material.cold && <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9"/><path d="M3 3v5h5"/><path d="M3 16a9 9 0 0 0 9 9"/><path d="M16 21h5v-5"/></svg> Froid</span>}
                  </div>
                </div>
              </div>
              <div class="p-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Teneur en huile</p>
                    <p class="font-semibold text-charcoal-900">{material.oilContent}</p>
                  </div>
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Humidité</p>
                    <p class="font-semibold text-charcoal-900 text-sm">{material.moisture}</p>
                  </div>
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Décortication</p>
                    <p class="font-semibold text-charcoal-900 text-sm">{material.dehulling}</p>
                  </div>
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Rendement</p>
                    <p class="font-semibold text-charcoal-900 text-sm">{material.yield}</p>
                  </div>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-4">
                  <div class="flex items-center gap-2">
                    <span class="text-steel-500 text-sm">Torréfaction:</span>
                    <span class="text-steel-700 font-medium">{material.roasting}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-steel-500 text-sm">Modèles recommandés:</span>
                    <div class="flex gap-2">
                      {material.models.map((model, idx) => (
                        <a key={idx} href={`/fr/products/${modelToSlug[model] || model}/`} class="bg-amber-100 text-amber-700 text-xs px-2 py-1 rounded font-medium hover:bg-amber-200 transition-colors">{model}</a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="preparation" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Bonnes pratiques de préparation des matériaux</h2>
        <div class="space-y-6">
          {preparationSteps.map((step, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{step.step}</div>
                {index < preparationSteps.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < preparationSteps.length - 1 ? 'pb-8' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{step.title}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  {step.details.map((detail, idx) => (
                    <p key={idx} class="mb-1 text-steel-700 flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {detail}
                    </p>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="storage" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Stockage et manipulation</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Conditions de stockage</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          {storageTips.map((tip, index) => (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-blue-100 p-5 rounded-xl border border-blue-200">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-3">
                {tip.icon === 'thermometer' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>}
                {tip.icon === 'cloud' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 16.5A2.5 2.5 0 0 0 20 14a2.5 2.5 0 0 0-2.5-2.5h-5.5a4.5 4.5 0 1 0 0 9h2a2.5 2.5 0 0 0 2.5-2.5Z"/></svg>}
                {tip.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                {tip.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              </div>
              <h4 class="font-semibold text-blue-800 mb-1">{tip.title}</h4>
              <p class="text-steel-600 text-sm">{tip.desc}</p>
            </div>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Protection contre les nuisibles</h3>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg">
          <ul class="space-y-2 text-steel-700">
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Utiliser des conteneurs anti-rodents
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Inspection régulière
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Mesures appropriées de lutte contre les nuisibles
            </li>
          </ul>
        </div>
      </section>

      <section id="yield-economics" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Teneur en huile et économie de l'achat de graines</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Les graines représentent 80–90 % du coût d'un litre d'huile, si bien que l'offre la moins chère est rarement l'huile la moins chère. Une différence de 2 points de teneur en huile de l'amande ou d'humidité fait varier le coût par litre bien plus qu'une négociation serrée sur le prix. Achetez en fonction du rendement en huile, pas du poids : décotez les lots humides, ratatinés ou très chargés en impuretés et payez une prime pour des graines propres, sèches et fraîchement récoltées.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-steel-100 rounded-lg">
            <thead class="bg-steel-100">
              <tr><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Graine</th><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Teneur typique en huile de l'amande</th><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Remarques</th></tr>
            </thead>
            <tbody class="divide-y divide-steel-100">
              <tr><td class="px-4 py-2">Arachide / cacahuète</td><td class="px-4 py-2">42–50 %</td><td class="px-4 py-2">À chaud ou à froid ; le tourteau est un aliment de valeur pour le bétail et l'alimentation humaine</td></tr>
              <tr><td class="px-4 py-2">Sésame</td><td class="px-4 py-2">45–55 %</td><td class="px-4 py-2">Marché haut de gamme en pressage à froid ; la faible teneur en fibres protège le fût</td></tr>
              <tr><td class="px-4 py-2">Tournesol</td><td class="px-4 py-2">38–48 %</td><td class="px-4 py-2">Les coques augmentent l'usure ; le décorticage améliore l'huile et le tourteau</td></tr>
              <tr><td class="px-4 py-2">Colza / canola</td><td class="px-4 py-2">38–46 %</td><td class="px-4 py-2">Conditionner avec soin ; la petite graine se compacte densément</td></tr>
              <tr><td class="px-4 py-2">Amande de palme</td><td class="px-4 py-2">45–50 %</td><td class="px-4 py-2">Amande dure ; le broyage et le préchauffage sont essentiels</td></tr>
              <tr><td class="px-4 py-2">Noix de coco (coprah)</td><td class="px-4 py-2">60–68 %</td><td class="px-4 py-2">Rendement en huile très élevé ; garder l'humidité basse pour éviter les moisissures</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-steel-700 leading-relaxed mt-4">Ces plages varient selon la variété, la saison et la région de culture ; considérez-les comme des chiffres de présélection et confirmez le rendement avec un petit lot d'essai avant de vous engager sur un gros achat.</p>
      </section>

      <section id="seasonal-sourcing" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Approvisionnement saisonnier et acceptation de l'humidité</h2>
        <p class="text-steel-700 leading-relaxed mb-4">La qualité des graines oléagineuses se fixe à la récolte et se dégrade au stockage, sans jamais s'améliorer. Acheter à la récolte coûte moins cher, mais les graines fraîchement récoltées dépassent souvent la plage de 5–8 % d'humidité nécessaire à un pressage sûr ; elles doivent être séchées et ventilées avant la mise en silo, sinon elles chauffent, moisissent et perdent leur qualité d'huile en quelques semaines. Fixez une limite d'acceptation écrite — généralement moins de 8 % d'humidité et moins de 1–2 % d'impuretés — et refusez ou réévaluez le prix des lots hors limite.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Inspectez plusieurs points dans le camion, pas seulement le dessus ; les graines humides se cachent au milieu.</li>
          <li>Sentez et croquez les amandes : croustillantes, avec un goût de noisette et sèches, c'est bon ; molles, moisies ou amères, c'est un refus.</li>
          <li>Ventilez les graines stockées et retournez les silos en saison humide ; même une graine sèche reprend de l'humidité par l'espace de tête.</li>
          <li>Gardez les lots de récolte séparés ; un seul lot moisi peut déclasser tout un silo de bonnes graines.</li>
        </ul>
        <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Comment vérifier l'humidité sans laboratoire</h3>
        <p class="text-steel-700 leading-relaxed mb-4">Un humidimètre étalonné est le meilleur outil, mais les contrôles de terrain suffisent à trier les camions à l'entrée. Une amande sèche craque ou se fend sous la dent ou l'ongle avec un bruit sec ; des amandes molles, collantes ou qui plient sont trop humides. Pour confirmer, pesez un petit échantillon, séchez-le doucement dans un plateau peu profond jusqu'à ce que le poids cesse de baisser, puis pesez-le à nouveau — la perte de poids correspond au pourcentage d'humidité, et deux mesures par camion prennent moins d'une heure. Refusez sur le contrôle de terrain, acceptez sur la mesure.</p>
        <p class="text-steel-700 leading-relaxed">Des graines qui arrivent légèrement au-dessus de la limite peuvent parfois être sauvées en les étalant et en les ventilant immédiatement, mais seulement si le dépassement est faible et le temps sec ; des graines humides laissées en sac ou en tas même 48 heures dans des conditions chaudes présentent un risque de moisissure et d'aflatoxine, pas de séchage, ce qui explique pourquoi le filtre d'entrée de notre <a href="/fr/resources/aflatoxin-control-guide/" class="text-amber-600 hover:underline">guide de l'aflatoxine</a> doit se trouver au même point de contrôle que la mesure d'humidité.</p>
      </section>

      <section id="cake-and-changeover" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Valeur du tourteau et changement multi-graines</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Le tourteau n'est pas un déchet — il représente généralement 50–60 % du poids produit et décide souvent de la rentabilité d'une graine. Le tourteau d'arachide et de sésame de qualité alimentaire se négocie bien au-dessus du tourteau fourrager générique, et le véritable tourteau de pressage à froid bénéficie d'une prime supplémentaire ; planifiez le marché du tourteau avant de fixer le prix de l'huile. La manutention et le stockage du tourteau sont traités dans notre <a href="/fr/resources/oil-cake-byproduct-guide/" class="text-amber-600 hover:underline">guide du tourteau</a>.</p>
        <p class="text-steel-700 leading-relaxed">Une presse hydraulique change de graine rapidement, mais un changement rapide n'est pas un changement nul. Entre deux graines, videz et essuyez entièrement le fût, les tamis et le bac de décantation afin qu'une graine très aromatique comme le sésame ou le coprah ne contamine pas le produit suivant, et lancez un petit lot de rinçage vendu comme huile de mélange. Planifiez la semaine du plus léger au plus fort en goût — l'ordre inverse laisse le produit haut de gamme porter le goût de la graine précédente. Lorsque la qualité des graines varie au fil de la saison, conservez des recettes de torréfaction et d'humidité par fournisseur, car la presse ne peut pas récupérer l'huile qu'une matière humide ou endommagée n'a jamais libérée — voir le <a href="/fr/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">guide du rendement</a> pour les détails opératoires.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Achetez vos graines comme si elles décidaient de votre marge — c'est le cas</h2>
        <p class="text-steel-700 leading-relaxed">La sélection des bonnes matières premières est essentielle pour une production d'huile réussie. Pour des recommandations personnalisées sur les matériaux à traiter et la façon d'optimiser votre production, contactez l'équipe technique de Haonuo.</p>
      </section>
    </div>
  </main>

