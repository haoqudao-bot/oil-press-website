---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'aflatoxin-control-guide');
const t = getTranslations('fr');

const title = resource?.data.title.fr || resource?.data.title.en || 'Guide de contrôle de l\'aflatoxine';
const description = resource?.data.description.fr || resource?.data.description.en || 'Stratégies complètes pour prévenir et contrôler la contamination par l\'aflatoxine';
const seoKeywords = resource?.data.seoKeywords || ['contrôle aflatoxine', 'prévention aflatoxine', 'sécurité alimentaire huile'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/aflatoxin-guide-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about/' },
  publisher: {
    '@type': 'Organization',
    name: 'Haonuo Machinery',
    logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' },
  },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/fr/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/aflatoxin-control-guide/' },
  ],
};

const typesOfAflatoxins = [
  { type: 'Aflatoxine B1', danger: 'Très toxique', sources: 'Maïs, arachides, riz', effects: 'Carcinogène, hépatotoxique' },
  { type: 'Aflatoxine B2', danger: 'Toxique', sources: 'Arachides, maïs', effects: 'Moins toxique que B1' },
  { type: 'Aflatoxine G1', danger: 'Toxique', sources: 'Grains, noix', effects: 'Carcinogène' },
  { type: 'Aflatoxine G2', danger: 'Moins toxique', sources: 'Grains', effects: 'Effets mineurs' },
];

const contaminationSources = [
  { title: 'Conditions de stockage humides', desc: 'Stockage dans des zones humides ou inondées favorise la croissance fongique', icon: 'droplet' },
  { title: 'Temps de stockage prolongé', desc: 'Plus les graines sont stockées, plus le risque augmente', icon: 'clock' },
  { title: 'Conditions climatiques', desc: 'Températures chaudes et humidité élevée favorisent la croissance', icon: 'sun' },
  { title: 'Pré-récolte', desc: 'Météo humide avant la récolte peut contaminer les cultures', icon: 'cloud-rain' },
];

const preventionStrategies = [
  { title: 'Contrôle des graines', items: ['Vérifier la qualité avant achat', 'Éviter les graines endommagées ou moisies', 'Tester les lots pour l\'aflatoxine'] },
  { title: 'Stockage approprié', items: ['Conserver dans des conditions secs', 'Utiliser des sacs imperméables', 'Contrôler l\'humidité relative'] },
  { title: 'Séchage immédiat', items: ['Sécher les graines dans les 24 heures', 'Maintenir l\'humidité en dessous de 12%', 'Utiliser des séchoirs industriels'] },
];

const detectionMethods = [
  { method: 'Test de champ rapide', time: '5-10 minutes', accuracy: 'Bas', useCase: 'Vérification initiale' },
  { method: 'Test ELISA', time: '2-4 heures', accuracy: 'Moyen', useCase: 'Contrôle qualité' },
  { method: 'HPLC', time: '4-6 heures', accuracy: 'Haute', useCase: 'Certification' },
];

const regulations = [
  { region: 'UE', limit: '2 ppb', products: 'Huiles comestibles' },
  { region: 'USA', limit: '20 ppb', products: 'Graines et huiles' },
  { region: 'Codex Alimentarius', limit: '10 ppb', products: 'Produits alimentaires' },
];

function localePath(path: string): string {
  return `/fr${path}`;
}
---

<BaseLayout locale="fr" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/resources/')} class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-red-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-red-500/10 text-red-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">
          SÉCURITÉ ALIMENTAIRE
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">
          {title.toUpperCase()}
        </h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">
          {description}
        </p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-red-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
              <div class="text-sm text-steel-500">Engineering Team · Haonuo Machinery</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Pourquoi le contrôle des aflatoxines est vital pour une huilerie</h2>
        <p class="text-steel-700 leading-relaxed">
          Les aflatoxines sont des toxines produites par certains champignons (Aspergillus flavus et Aspergillus parasiticus) qui peuvent contaminer les graines utilisées pour la production d'huile. Le contrôle de l'aflatoxine est crucial pour garantir la sécurité alimentaire et respecter les normes internationales.
        </p>
      </section>

      <section id="types" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Types d'aflatoxines</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {typesOfAflatoxins.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="font-bold text-lg text-red-600 mb-3">{item.type}</div>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Danger:</span>
                  <span class="text-sm text-charcoal-900">{item.danger}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Sources:</span>
                  <span class="text-sm text-charcoal-900">{item.sources}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Effets:</span>
                  <span class="text-sm text-charcoal-900">{item.effects}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="sources" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Où commence la contamination par les aflatoxines</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {contaminationSources.map((item, index) => (
            <div key={index} class="bg-orange-50 p-5 rounded-xl border border-orange-200">
              <h3 class="font-semibold text-lg text-orange-800 mb-2">{item.title}</h3>
              <p class="text-steel-700 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="prevention" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Prévenir les aflatoxines du champ au stockage</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {preventionStrategies.map((item, index) => (
            <div key={index} class="bg-green-50 p-5 rounded-xl border border-green-200">
              <h3 class="font-semibold text-lg text-green-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {task}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="detection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comment tester les aflatoxines avant pressage</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-indigo-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Méthode</th>
                <th class="px-4 py-3 text-left font-semibold">Temps</th>
                <th class="px-4 py-3 text-left font-semibold">Précision</th>
                <th class="px-4 py-3 text-left font-semibold">Utilisation</th>
              </tr>
            </thead>
            <tbody>
              {detectionMethods.map((item, index) => (
                <tr key={index} class="border-b border-steel-100 hover:bg-blue-50 transition-colors">
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.method}</td>
                  <td class="px-4 py-3 text-amber-600">{item.time}</td>
                  <td class="px-4 py-3 text-emerald-600">{item.accuracy}</td>
                  <td class="px-4 py-3 text-steel-700">{item.useCase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="regulations" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Limites d'aflatoxines sur les principaux marchés d'exportation</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {regulations.map((item, index) => (
            <div key={index} class="bg-purple-50 p-5 rounded-xl border border-purple-200">
              <h3 class="font-semibold text-lg text-purple-800 mb-3">{item.region}</h3>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Limite:</span>
                  <span class="text-sm text-red-600 font-bold">{item.limit}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-steel-500">Produits:</span>
                  <span class="text-sm text-charcoal-900">{item.products}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="processing-reduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Le pressage ou le raffinage élimine-t-il l'aflatoxine ?</h2>
        <p class="text-steel-700 leading-relaxed mb-4">C'est la question que les propriétaires d'huilerie posent le plus souvent — et la réponse honnête est partielle, jamais complète. Les aflatoxines sont bien plus solubles dans la matière solide que dans l'huile ; le pressage mécanique répartit donc la majeure partie de la contamination dans le tourteau, et l'huile brute issue de graines contaminées porte généralement beaucoup moins de toxine que la graine elle-même. Le raffinage complet — neutralisation alcaline, décoloration à la terre activée et désodorisation — réduit encore l'aflatoxine présente dans l'huile, souvent sous les limites réglementaires. La filtration seule n'élimine que la fraction liée aux solides.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Pourquoi le procédé n'est pas une stratégie de sécurité</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>L'élimination est variable et dépend du niveau de contamination, du type de graine et du procédé — elle ne peut pas être garantie lot après lot.</li>
            <li>Le tourteau concentre la toxine ; un tourteau contaminé qui entre dans les circuits alimentaires ou d'alimentation animale crée un second problème de conformité, plus large.</li>
            <li>Les petits et moyens ateliers qui vendent de l'huile brute ou légèrement filtrée ne disposent pas des étapes de raffinage qui assurent l'essentiel de l'élimination.</li>
            <li>Aucun acheteur ni régulateur n'accepte « la presse l'élimine » comme mesure de contrôle ; le point de contrôle documenté est la graine acceptée, pas le procédé.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">Considérez le procédé comme une barrière secondaire qui réduit le risque, et construisez la barrière principale à la réception : refusez les graines contaminées avant qu'elles n'entrent dans le bâtiment.</p>
      </section>

      <section id="mill-testing-protocol" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Protocole pratique de test à l'huilerie</h2>
        <p class="text-steel-700 leading-relaxed mb-4">La HPLC en laboratoire et l'ELISA accrédité sont les méthodes de référence, mais une huilerie n'a pas besoin d'un laboratoire pour maîtriser le risque — elle a besoin d'une routine de réception reproductible, utilisant des outils de dépistage qui signalent les chargements suspects avant le déchargement.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li><strong>Dépistage visuel et organoleptique d'abord :</strong> moisissure, décoloration, amandes ratatinées, odeur de moisi et dégâts d'insectes visibles rejettent ou mettent immédiatement un chargement en quarantaine.</li>
          <li><strong>Échantillonnez correctement :</strong> prélevez de nombreux petits prélèvements dans plusieurs sacs et à plusieurs profondeurs — la contamination se concentre dans une infime fraction des amandes, et une seule poignée ne décide rien.</li>
          <li><strong>Dépistage rapide :</strong> les kits de test à flux latéral ou ELISA qualitatif donnent un résultat oui/non par rapport à votre limite en quelques minutes et sont rentables sur chaque lot réceptionné ou chaque livraison de fournisseur.</li>
          <li><strong>Faites escalader les positifs :</strong> envoyez les lots limites ou refusés à un laboratoire accrédité pour une confirmation quantitative avant toute décision de destination.</li>
          <li><strong>Conservez des échantillons</strong> de chaque lot accepté, étiquetés avec le fournisseur, la date et le lot, bien au-delà de la durée de conservation du produit.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed">Le dépistage est bon marché comparé à une seule expédition d'export refusée ou à une inscription de marque bloquée ; intégrez son coût dans le prix par tonne de graines acceptées plutôt que de le traiter comme une dépense facultative.</p>
      </section>

      <section id="lot-disposition-suppliers" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Lots refusés et contrats fournisseurs</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Le sort d'un lot refusé doit être décidé avant la première livraison, pas au portail avec un camion qui attend. Mélanger un lot refusé à de bonnes graines pour le « diluer » est illégal dans pratiquement tous les marchés réglementés et détruit la piste de preuve ; mettez en quarantaine, étiquetez et isolez physiquement la matière suspecte, et éliminez les lots confirmés par la filière prescrite par la réglementation locale — souvent une destruction supervisée ou une affectation à des usages non alimentaires autorisés, jamais en silence dans du tourteau destiné à l'alimentation des vaches laitières ou de la volaille.</p>
        <p class="text-steel-700 leading-relaxed mb-4">La solution durable est en amont. Consignez par écrit les limites d'aflatoxine, les méthodes d'échantillonnage et les clauses de refus ou de remplacement avec chaque fournisseur, payez une prime documentée pour des noix et des graines sèches, propres et correctement stockées, et donnez à vos fournisseurs privilégiés le conseil de récolte simple qui maîtrise l'essentiel de la contamination : maturité complète, séchage rapide sous 8 % d'humidité, stockage sec et propre hors du sol, et rotation premier entré, premier sorti. Les fournisseurs qui ne peuvent pas accepter ces conditions ne sont pas des graines bon marché — c'est un passif conditionnel.</p>
        <p class="text-steel-700 leading-relaxed">La même discipline d'humidité et de stockage qui protège contre l'aflatoxine améliore aussi le rendement en huile et protège l'équipement, ce qui lie directement la sécurité alimentaire à l'économie couverte dans notre <a href="/fr/resources/oil-press-raw-materials-guide/" class="text-amber-600 hover:underline">guide des matières premières</a> et notre <a href="/fr/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">guide du rendement</a> : une réception contrôlée, sèche et traçable est à la fois la façon la plus sûre et la plus rentable d'exploiter une huilerie.</p>
        <h3 class="font-semibold text-lg mt-6 mb-3 text-charcoal-900">Tenue des registres et préparation aux rappels</h3>
        <p class="text-steel-700 leading-relaxed mb-4">On demande de plus en plus aux exportateurs et aux vendeurs de marque de démontrer le système de contrôle, et pas seulement de réussir un test. Un système viable ne nécessite que quatre registres liés par lot : fournisseur et origine, résultat du dépistage à la réception avec date, lots de pressage et de filtration qui ont consommé le lot, et clients ayant reçu l'huile finie. Sur papier ou dans un simple tableur, cette chaîne permet à une huilerie de remonter de n'importe quelle bouteille à ses graines en une heure — la capacité que les acheteurs et auditeurs recherchent réellement — et limite tout rappel à des lots définis au lieu d'un mois de production entier.</p>
        <p class="text-steel-700 leading-relaxed">Examinez les registres chaque mois : les fournisseurs liés à des résultats limites répétés reçoivent des avertissements ou des clauses de remplacement, les fenêtres de risque saisonnières deviennent visibles d'une année sur l'autre, et la discipline transforme discrètement la conformité en sécurité alimentaire d'un coût en argument de vente auprès d'importateurs échaudés par des fournisseurs non documentés.</p>
        <p class="text-steel-700 leading-relaxed mt-4">La formation complète le système. Les personnes qui déchargent les camions et vident les trémies doivent pouvoir nommer les trois signaux de refus — moisissure, humidité et odeur de moisi — et savoir qu'accepter un chargement suspect pour éviter une dispute est la seule décision que le reste du procédé ne peut pas annuler. Une causerie de cinq minutes chaque semaine de récolte, répétée pour chaque nouvel ouvrier, maintient la procédure documentée réelle au portail plutôt que simplement correcte sur le papier.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Mettre en place un contrôle des aflatoxines durable</h2>
        <p class="text-steel-700 leading-relaxed">
          Le contrôle de l'aflatoxine exige une approche proactive à chaque étape de la chaîne d'approvisionnement. En combinant une sélection rigoureuse des matières premières, un stockage approprié et des méthodes de détection fiables, vous pouvez garantir la sécurité de vos produits et respecter les normes internationales.
        </p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">PRÊT À GARANTIR LA SÉCURITÉ DE VOTRE PRODUCTION?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Notre équipe d'ingénieurs peut vous aider à mettre en place des procédures de contrôle de qualité complètes.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localePath('/contact/')} class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          {t.resources.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={localePath('/resources/')} class="btn-outline border-white text-white hover:bg-white/10">
          {t.resources.backToResources}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

