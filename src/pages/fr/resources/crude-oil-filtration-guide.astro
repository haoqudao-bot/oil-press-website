---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'crude-oil-filtration-guide');
const t = getTranslations('fr');

const title = resource?.data.title.fr || resource?.data.title.en || 'Guide de Filtrage de l\'Huile Brute';
const description = resource?.data.description.fr || resource?.data.description.en || 'Une huile propre et pure à chaque pressage';
const seoKeywords = resource?.data.seoKeywords || ['filtrage huile', 'raffinage huile brute', 'système de filtrage'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/filtration-guide-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Ingénieur en Transformation d\'Huile', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/fr' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/crude-oil-filtration-guide' },
  ],
};

const filtrationImportance = [
  { icon: 'shield', title: 'Éliminer les Impuretés', desc: 'Éliminer les particules solides, l\'humidité et les contaminants' },
  { icon: 'star', title: 'Améliorer la Qualité', desc: 'Huile plus claire et plus pure avec une meilleure apparence' },
  { icon: 'trending-up', title: 'Valeur Plus Élevée', desc: 'L\'huile propre commande un prix premium sur le marché' },
  { icon: 'clock', title: 'Durée de Conservation Plus Longue', desc: 'Prévient l\'oxydation et le rancissement' },
  { icon: 'flask', title: 'Meilleur Goût', desc: 'Élimine les composés amers et les sédiments' },
];

const filtrationMethods = [
  { name: 'Filtrage par Gravité', pros: ['Simple, pas besoin d\'électricité', 'Coût faible', 'Bon pour les petits lots'], cons: ['Processus lent', 'Pas complètement efficace', 'Grand espace nécessaire'], bestFor: 'Production domestique, petits lots < 20L' },
  { name: 'Filtrage par Pression', pros: ['Processus rapide', 'Élimination efficace', 'Design compact'], cons: ['Nécessite une pompe', 'Cartouches filtrantes nécessaires'], bestFor: 'Ateliers petits à moyens, lots de 20-200L' },
  { name: 'Filtrage par Vide', pros: ['Très rapide', 'Haute pureté', 'Peut gérer de grands volumes'], cons: ['Installation plus complexe', 'Coût plus élevé'], bestFor: 'Production commerciale, lots de 200L+' },
  { name: 'Séparation Centrifuge', pros: ['Extrêmement rapide', 'Élimine l\'eau et les solides', 'Pas de consommables filtrants'], cons: ['Coût initial élevé', 'Nécessite l\'électricité'], bestFor: 'Grandes opérations commerciales' },
];

const stepByStep = [
  { step: '1', title: 'Décantation', desc: 'Laisser reposer l\'huile brute dans un réservoir pendant 24-48 heures. L\'eau et les solides lourds se déposent au fond.' },
  { step: '2', title: 'Pré-Filtrage', desc: 'Passer l\'huile à travers un filtre grossier (50-100 microns) pour éliminer les grosses particules.' },
  { step: '3', title: 'Filtrage Principal', desc: 'Filtrer à travers un filtre fin (5-20 microns) pour éliminer les fins sédiments.' },
  { step: '4', title: 'Polissage', desc: 'En option : filtrer à travers du charbon actif ou de la terre de blanchiment pour une huile cristalline.' },
  { step: '5', title: 'Séchage', desc: 'Chauffer l\'huile à 80-90°C pour éliminer l\'humidité résiduelle (pour le stockage à long terme).' },
  { step: '6', title: 'Test Final', desc: 'Vérifier la clarté, la teneur en humidité et la pureté avant l\'embouteillage.' },
];

const filterSelection = [
  { filter: 'Filtre Papier', micron: '5-20', life: 'Usage unique ou 10-50L', cost: 'Contacter pour prix', use: 'Le plus courant, bon pour usage domestique/petit atelier' },
  { filter: 'Grille Métallique', micron: '50-100', life: 'Réutilisable (nettoyage)', cost: 'Contacter pour prix', use: 'Pré-filtrage, élimination grossière' },
  { filter: 'Centrifugeuse', micron: '0.1-5', life: 'Permanente', cost: 'Contacter pour prix', use: 'Commercial, production à grand volume' },
  { filter: 'Filtre à Flux Tangentiel', micron: '1-10', life: 'Réutilisable', cost: 'Contacter pour prix', use: 'Production moyenne à grande' },
];

const qualityChecks = [
  { test: 'Clarté Visuelle', method: 'Tenir l\'huile à la lumière - elle doit être claire, sans sédiment visible', standard: 'Aucune particule visible' },
  { test: 'Teneur en Humidité', method: 'Utiliser un humidimètre ou un test par chauffage', standard: '< 0.1% d\'humidité' },
  { test: 'Goût et Odeur', method: 'Sentir et goûter un échantillon', standard: 'Goût et arôme propres et frais' },
  { test: 'Niveau de pH', method: 'Utiliser des bandelettes ou un pH-mètre', standard: 'pH 6-7 (neutre)' },
];

const storageTips = [
  'Stocker l\'huile filtrée dans des bouteilles en verre foncé propres',
  'Éloigner de la lumière directe du soleil',
  'Utiliser uniquement des conteneurs de qualité alimentaire',
  'Laisser un espace vide dans les conteneurs pour éviter l\'oxydation',
  'Étiqueter avec la date de production et le type d\'huile',
];
---

<BaseLayout locale="fr" title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE DE TRANSFORMATION</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Ingénieur en Transformation d'Huile · 15+ ans d'expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Le filtrage de l'huile brute est une étape critique dans la production d'huile qui sépare l'huile extraite brute des particules solides, de l'eau et d'autres impuretés. Un filtrage approprié transforme l'huile pressée brute en un produit précieux et commercialisable.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Après pressage, l'huile brute contient généralement 2-5% de particules solides et 0.5-2% d'eau. Le filtrage élimine ces impuretés pour produire une huile propre et commercialisable.</p>
        </div>
      </section>

      <section id="importance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Pourquoi le Filtrage est Important</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filtrationImportance.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
                  {item.icon === 'star' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
                  {item.icon === 'trending-up' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                  {item.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                  {item.icon === 'flask' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3h6M10 3v18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3"/><path d="M14 3v18a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V3"/></svg>}
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="methods" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comparaison des Méthodes de Filtrage</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {filtrationMethods.map((method, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden hover:shadow-lg transition-all duration-300">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-gray-500 to-gray-600' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-purple-500 to-pink-500' : 'bg-gradient-to-r from-green-500 to-emerald-500'}`}>
                <h3 class="font-display text-lg text-white">{method.name}</h3>
              </div>
              <div class="p-5">
                <div class="grid grid-cols-3 gap-3">
                  <div class="bg-green-50 p-3 rounded-lg">
                    <p class="text-xs text-green-600 mb-1">Avantages</p>
                    {method.pros.map((pro, idx) => <p key={idx} class="text-xs text-steel-700">+ {pro}</p>)}
                  </div>
                  <div class="bg-red-50 p-3 rounded-lg">
                    <p class="text-xs text-red-600 mb-1">Inconvénients</p>
                    {method.cons.map((con, idx) => <p key={idx} class="text-xs text-steel-700">- {con}</p>)}
                  </div>
                  <div class="bg-blue-50 p-3 rounded-lg">
                    <p class="text-xs text-blue-600 mb-1">Idéal pour</p>
                    <p class="text-xs text-steel-700">{method.bestFor}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="step-by-step" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Processus de Filtrage Étape par Étape</h2>
        <div class="space-y-4">
          {stepByStep.map((step, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{step.step}</div>
                {index < stepByStep.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < stepByStep.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{step.title}</h3>
                <p class="text-steel-600">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="filter-selection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Guide de Sélection des Médias Filtrants</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Type de Filtre</th>
                <th class="px-4 py-3 text-left font-semibold">Évaluation Micron</th>
                <th class="px-4 py-3 text-left font-semibold">Durée de Vie</th>
                <th class="px-4 py-3 text-left font-semibold">Coût</th>
                <th class="px-4 py-3 text-left font-semibold">Utilisation Recommandée</th>
              </tr>
            </thead>
            <tbody>
              {filterSelection.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.filter}</td>
                  <td class="px-4 py-3 text-blue-600">{item.micron}</td>
                  <td class="px-4 py-3">{item.life}</td>
                  <td class="px-4 py-3 text-green-600">{item.cost}</td>
                  <td class="px-4 py-3 text-steel-600 text-sm">{item.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="quality-checks" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Contrôles de Qualité</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {qualityChecks.map((check, index) => (
            <div key={index} class="bg-gradient-to-br from-green-50 to-emerald-50 p-5 rounded-xl border border-green-100">
              <h3 class="font-semibold text-green-800 mb-2">{check.test}</h3>
              <p class="text-steel-700 text-sm mb-2"><strong>Méthode :</strong> {check.method}</p>
              <p class="text-green-700 text-sm"><strong>Norme :</strong> {check.standard}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="storage" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Stockage Approprié Après Filtrage</h2>
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <ul class="space-y-3">
            {storageTips.map((tip, index) => (
              <li key={index} class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-steel-700">{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Investir dans un équipement de filtrage approprié est essentiel pour produire une huile de haute qualité et commercialisable. En suivant les méthodes et techniques décrites dans ce guide, vous pouvez améliorer significativement la qualité et la rentabilité de votre huile. Pour des recommandations d'équipement, contactez notre équipe.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">PRODUISEZ UNE HUILE PREMIUM DÈS AUJOURD'HUI</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Notre équipe peut recommander l'équipement de filtrage adapté à votre échelle de production et votre budget.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">
          {t.resources.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/fr/products" class="btn-outline border-white text-white hover:bg-white/10">{t.nav.products}</a>
        <a href="/fr/resources" class="btn-outline border-white text-white hover:bg-white/10">{t.resources.backToResources}</a>
      </div>
    </div>
  </section>
</BaseLayout>