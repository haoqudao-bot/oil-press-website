---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'how-to-maximize-oil-yield');
const t = getTranslations('fr');

const title = resource?.data.title.fr || resource?.data.title.en || 'Comment maximiser le rendement en huile';
const description = resource?.data.description.fr || resource?.data.description.en || 'Obtenez plus d\'huile de chaque graine';
const seoKeywords = resource?.data.seoKeywords || ['maximiser rendement huile', 'augmenter extraction huile', 'optimisation rendement'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/maximize-yield-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Ingénieur Senior en Presse à Huile', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hydoilpress.com/fr/' },
    { '@type': 'ListItem', position: 2, name: 'Ressources', item: 'https://www.hydoilpress.com/fr/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/fr/resources/how-to-maximize-oil-yield' },
  ],
};

const yieldFactors = [
  { icon: 'seed', title: 'Qualité de la matière première', desc: 'Des graines de haute qualité = rendement plus élevé' },
  { icon: 'droplet', title: 'Teneur en humidité', desc: 'Humidité optimale = 5-8%' },
  { icon: 'flame', title: 'Torréfaction', desc: 'Une torréfaction adéquate décompose les parois cellulaires' },
  { icon: 'gear', title: 'Broyage', desc: 'Une taille de particule adéquate augmente la surface' },
  { icon: 'pressure', title: 'Pression', desc: 'Une pression plus élevée = plus d\'extraction d\'huile' },
  { icon: 'clock', title: 'Temps de pressage', desc: 'Temps de maintien adéquat à la pression maximale' },
];

const moistureGuide = [
  { material: 'Sésame', optimal: '5-6%', tooDry: 'Cassant, rendement réduit', tooWet: 'Émulsification, tourteau collant' },
  { material: 'Arachide', optimal: '5-7%', tooDry: 'Difficile à presser', tooWet: 'Glissant, extraction inégale' },
  { material: 'Colza', optimal: '6-8%', tooDry: 'Tourteau dur, faible rendement', tooWet: 'Tourteau humide, perte d\'huile' },
  { material: 'Noix', optimal: '7-9%', tooDry: 'S\'émiette, difficile à presser', tooWet: 'Risque de moisissure' },
];

const roastingGuide = [
  { material: 'Sésame', temp: '160-180°C', time: '25-30 min', color: 'Brun doré', yield: '48-54%' },
  { material: 'Arachide', temp: '165-185°C', time: '30-35 min', color: 'Brun clair', yield: '45-50%' },
  { material: 'Colza', temp: '150-170°C', time: '20-25 min', color: 'Brun foncé', yield: '38-42%' },
];

const pressureGuide = [
  { step: 'Chargement', pressure: 'Pression de chargement initiale', time: 'Charger la matière uniformément dans la chambre de pressage' },
  { step: 'Pré-pressage', pressure: '30-40 MPa', time: 'Maintenir pendant 2-3 minutes pour expulser l\'air' },
  { step: 'Pressage principal', pressure: '50-60 MPa', time: 'Maintenir pendant 5-10 minutes selon la matière' },
  { step: 'Libération', pressure: 'Libération progressive', time: 'Une libération lente évite la perte d\'huile par la mousse' },
];

const proTips = [
  { title: 'Nettoyer soigneusement les graines', desc: 'Éliminer toutes les pierres, métaux et débris avant le traitement. Même de petites pierres peuvent endommager la presse et réduire le rendement.' },
  { title: 'Décortiquer correctement', desc: 'Retirer les enveloppes des graines car elles absorbent l\'huile et réduisent le rendement. Viser 95%+ de décorticage pour la plupart des graines.' },
  { title: 'Contrôler précisément l\'humidité', desc: 'Utiliser un humidimètre si possible. Ou tester en pressant - la matière doit tenir ensemble mais s\'effriter facilement.' },
  { title: 'Torréfier de manière constante', desc: 'Utiliser un thermomètre pour maintenir une température de torréfaction constante. Une torréfaction inégale = rendement inégal.' },
  { title: 'Broyer à la taille optimale', desc: '2-4 mm pour la plupart des graines, 3-5 mm pour les noix. Trop fin = difficile à presser, trop grossier = extraction inégale.' },
  { title: 'Charger uniformément', desc: 'Répartir la matière uniformément dans la chambre de pressage. Un chargement inégal cause une pression inégale et un rendement réduit.' },
  { title: 'Temps de maintien en pression maximale', desc: 'Maintenir à la pression maximale pendant 5-10 minutes. Précipiter cette étape peut réduire le rendement de 5-10%.' },
  { title: 'Pressage progressif', desc: 'Appliquer la pression progressivement plutôt que soudainement. Une pression soudaine peut piéger l\'huile dans le tourteau.' },
];

const yieldComparison = [
  { scenario: 'Mauvaise préparation', sesam: '30-35%', peanut: '28-32%', rapeseed: '25-28%' },
  { scenario: 'Préparation moyenne', sesam: '40-45%', peanut: '38-42%', rapeseed: '32-35%' },
  { scenario: 'Excellente préparation', sesam: '48-54%', peanut: '45-50%', rapeseed: '38-42%' },
];

const maintenanceTips = [
  'Maintenir le système hydraulique en bon état pour une pression constante',
  'Vérifier et remplacer régulièrement les filtres pour éviter la restriction de débit',
  'Garder la chambre de pressage propre pour éviter la contamination',
  'Suivre le calendrier de maintenance du fabricant',
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="fr">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/fr" class="hover:text-amber-500 transition-colors">Accueil</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/fr/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">GUIDE DE PRODUCTION</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Ingénieur Senior en Presse à Huile · Plus de 15 ans d'expérience</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Introduction</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Maximiser le rendement en huile est la clé de la rentabilité dans la production d'huile. De petites améliorations du processus peuvent augmenter considérablement votre production d'huile et vos revenus.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Une bonne technique peut augmenter le rendement de 10-20%. Cela représente 10-20 kg d'huile en plus pour chaque 100 kg de graines transformées.</p>
        </div>
      </section>

      <section id="factors" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Facteurs Clés Affectant le Rendement</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {yieldFactors.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'seed' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a10 10 0 0 0 10-10V2H12a10 10 0 0 0 0 20Z"/><path d="M12 22V12h10"/></svg>}
                  {item.icon === 'droplet' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S6 13 6 15a7 7 0 0 0 7 7z"/></svg>}
                  {item.icon === 'flame' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>}
                  {item.icon === 'gear' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>}
                  {item.icon === 'pressure' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10M18 20V4M6 20v-6"/></svg>}
                  {item.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="moisture" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Optimisation de la Teneur en Humidité</h2>
        <div class="overflow-x-auto mb-4">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Matière</th><th class="px-4 py-3 text-left font-semibold">Humidité Optimale</th><th class="px-4 py-3 text-left font-semibold">Trop Sec</th><th class="px-4 py-3 text-left font-semibold">Trop Humide</th></tr>
            </thead>
            <tbody>
              {moistureGuide.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.material}</td>
                  <td class="px-4 py-3 text-green-600 font-medium">{item.optimal}</td>
                  <td class="px-4 py-3 text-red-500 text-sm">{item.tooDry}</td>
                  <td class="px-4 py-3 text-red-500 text-sm">{item.tooWet}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="roasting" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Torréfaction pour un Rendement Maximum</h2>
        <p class="text-steel-700 mb-6">Une torréfaction adéquate est l'un des facteurs les plus critiques pour maximiser le rendement en huile. Elle décompose les parois cellulaires et libère l'huile piégée.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {roastingGuide.map((item, index) => (
            <div key={index} class="bg-gradient-to-br from-orange-50 to-amber-50 p-5 rounded-xl border border-orange-100">
              <h3 class="font-display text-lg mb-3 text-orange-800">{item.material}</h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between"><span class="text-steel-500">Température :</span><span class="font-semibold text-orange-700">{item.temp}</span></div>
                <div class="flex justify-between"><span class="text-steel-500">Durée :</span><span class="font-semibold text-orange-700">{item.time}</span></div>
                <div class="flex justify-between"><span class="text-steel-500">Couleur :</span><span class="font-semibold text-orange-700">{item.color}</span></div>
                <div class="flex justify-between"><span class="text-steel-500">Rendement :</span><span class="font-bold text-green-600">{item.yield}</span></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="pressure" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Technique de Pressage Optimale</h2>
        <div class="space-y-4">
          {pressureGuide.map((item, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{index + 1}</div>
                {index < pressureGuide.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < pressureGuide.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{item.step}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  <p class="text-amber-600 font-medium mb-1">{item.pressure}</p>
                  <p class="text-steel-600">{item.time}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="pro-tips" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conseils Professionnels</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {proTips.map((tip, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 p-5 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{tip.title}</h4>
                  <p class="text-steel-600 text-sm">{tip.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="comparison" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Comparaison de Rendement</h2>
        <p class="text-steel-700 mb-6">Voyez la différence spectaculaire qu'une bonne préparation apporte sur le rendement final en huile :</p>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-green-500 to-emerald-500 text-white">
              <tr><th class="px-4 py-3 text-left font-semibold">Niveau de Préparation</th><th class="px-4 py-3 text-left font-semibold">Sésame</th><th class="px-4 py-3 text-left font-semibold">Arachide</th><th class="px-4 py-3 text-left font-semibold">Colza</th></tr>
            </thead>
            <tbody>
              {yieldComparison.map((item, index) => (
                <tr key={index} class={index === 0 ? 'bg-red-50' : index === 1 ? 'bg-amber-50' : 'bg-green-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.scenario}</td>
                  <td class={`px-4 py-3 font-medium ${index === 0 ? 'text-red-600' : index === 1 ? 'text-amber-600' : 'text-green-600'}`}>{item.sesam}</td>
                  <td class={`px-4 py-3 font-medium ${index === 0 ? 'text-red-600' : index === 1 ? 'text-amber-600' : 'text-green-600'}`}>{item.peanut}</td>
                  <td class={`px-4 py-3 font-medium ${index === 0 ? 'text-red-600' : index === 1 ? 'text-amber-600' : 'text-green-600'}`}>{item.rapeseed}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Maintenance de l'Équipement pour un Rendement Constant</h2>
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <ul class="space-y-3">
            {maintenanceTips.map((tip, index) => (
              <li key={index} class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-steel-700">{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Conclusion</h2>
        <p class="text-steel-700 leading-relaxed">Maximiser le rendement en huile est une combinaison de bonne préparation, de technique correcte et de pratique constante. En mettant en œuvre les conseils de ce guide, vous pouvez augmenter considérablement votre production d'huile et votre rentabilité. Pour des conseils d'optimisation personnalisés, contactez notre équipe d'ingénieurs.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">AUGMENTEZ VOTRE RENDEMENT DÈS AUJOURD'HUI</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Nos ingénieurs peuvent vous aider à optimiser chaque étape de votre processus de production d'huile pour un rendement maximum.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Contactez Nos Experts<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
