---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Cookie Policy', item: 'https://www.hydoilpress.com/cookie-policy' },
  ],
};
---

<BaseLayout title="Cookie Policy" description="Haonuo Machinery Cookie Policy - Learn about how we use cookies on our website and how you can manage your cookie preferences.">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Cookie Policy</span>
      </nav>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-6">Cookie Policy</h1>
      <p class="text-steel-600 text-lg mb-8">Last Updated: July 20, 2026</p>

      <div class="space-y-8">
        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">1. What Are Cookies?</h2>
          <p class="text-steel-600 leading-relaxed">
            Cookies are small text files that are stored on your device when you visit a website. They help websites remember information about your visit, such as your language preference and other settings.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">2. How We Use Cookies</h2>
          <p class="text-steel-600 leading-relaxed mb-4">
            We use cookies for the following purposes:
          </p>
          <ul class="list-disc list-inside text-steel-600 space-y-2">
            <li><strong>Essential Cookies:</strong> These cookies are necessary for the website to function properly. They cannot be disabled.</li>
            <li><strong>Performance Cookies:</strong> These cookies help us analyze how visitors use our website and improve its performance.</li>
            <li><strong>Functionality Cookies:</strong> These cookies allow the website to remember your preferences and provide enhanced features.</li>
            <li><strong>Marketing Cookies:</strong> These cookies are used to deliver personalized advertising and marketing messages.</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">3. Third-Party Cookies</h2>
          <p class="text-steel-600 leading-relaxed">
            We may use third-party services that set cookies on our website, such as Google Analytics for website analytics. These third parties have their own privacy policies and cookie policies.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">4. Managing Cookies</h2>
          <p class="text-steel-600 leading-relaxed mb-4">
            You can manage your cookie preferences through your browser settings. Most browsers allow you to:
          </p>
          <ul class="list-disc list-inside text-steel-600 space-y-2">
            <li>Accept all cookies</li>
            <li>Reject all cookies</li>
            <li>Accept only essential cookies</li>
            <li>Delete existing cookies</li>
          </ul>
          <p class="text-steel-600 leading-relaxed mt-4">
            Please note that disabling certain cookies may affect the functionality of our website.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">5. Changes to This Policy</h2>
          <p class="text-steel-600 leading-relaxed">
            We may update this Cookie Policy from time to time. We will notify you of any significant changes by posting the updated policy on our website. Your continued use of our website after any changes constitutes your acceptance of the updated policy.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">6. Contact Us</h2>
          <p class="text-steel-600 leading-relaxed">
            If you have any questions about this Cookie Policy, please contact us:
          </p>
          <ul class="list-disc list-inside text-steel-600 space-y-2 mt-4">
            <li>Email: contact@hydoilpress.com</li>
            <li>Phone: +86-18957149128</li>
            <li>Address: Qingzhou, Weifang, Shandong, China</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>