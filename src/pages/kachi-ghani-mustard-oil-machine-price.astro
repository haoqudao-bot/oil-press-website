---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Kachi Ghani Mustard Oil Machine Price', item: 'https://www.hydoilpress.com/kachi-ghani-mustard-oil-machine-price' },
  ],
};

const faqItems = [
  { q: 'Will my Kachi Ghani mustard oil machine price include shipping to India?', a: 'Yes — we can quote FOB Qingdao, CIF to Mundra/Nhava Sheva/Kandla, or DAP door-to-door anywhere in India. Sea freight to Mundra takes ~28–32 days. Tell us your nearest port or factory address and we\'ll include the exact freight in your quotation.' },
  { q: 'I\'m new to Kachi Ghani — do you help Indian buyers choose the right machine?', a: 'Absolutely. Kachi Ghani needs cold-press at low temperature (below 60°C) to preserve authentic pungency. Tell us your daily mustard seed target. HN325 for small workshops, HN426 for serious Kachi Ghani producers (the flagship — extra pressure for mustard\'s tough seed coat). We build all machines to 415V/50Hz or 220V/50Hz for India — no extra charge.' },
  { q: 'What factors shape a Kachi Ghani mustard oil machine price?', a: 'Five key differences from standard hot-press mustard: (1) cold-press pressure — 42–50 MPa vs 30 MPa standard, (2) temperature control for pressing below 60°C, (3) single vs double barrel station, (4) Indian voltage winding (free on standard), (5) shipping to Indian ports (varies by port). The pressure difference alone can affect the quote by ~15–25%.' },
  { q: 'What are payment terms and delivery to India?', a: 'Payment: 30% T/T deposit, 70% before shipment. L/C at sight available. Production: 15–25 working days for standard HN models, 30–45 days for double-station or custom barrels. Sea freight to Mundra: ~28–32 days. Spare parts ship DHL/FedEx in 5–7 days.' },
  { q: 'How long to get a Kachi Ghani quote, and is it free?', a: 'Free, no obligation, and typically within 24 hours. If you just want a rough budget first, send mustard seed target and we\'ll reply in 1–2 hours. We know Indian buyers often WhatsApp — you can send directly to our number above for faster reply.' },
  { q: 'Can one machine do both Kachi Ghani cold press and regular hot-press mustard?', a: 'Yes — our manual/semi-automatic HN models support both modes. Pressure, stroke, holding time, and rise-speed are adjustable. Cold pressing runs below 60°C; hot pressing after roasting gives higher yield with a different flavor profile.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const priceFactors = [
  { num: '01', title: 'Pressure for Mustard Hardness', desc: 'Mustard seed has a tough seed coat. Kachi Ghani cold-pressing needs 42–50 MPa vs 30 MPa for standard hot-press. **This single difference can affect the quote by ~15–25%** — thicker barrels, stronger 27SiMn cylinders, and higher-rated pumps are real steel costs.' },
  { num: '02', title: 'Cold-Press Temperature Control', desc: 'Authentic Kachi Ghani keeps pressing below 60°C to preserve pungency and aroma. Machines need precise holding-time and pressure-rise adjustment — standard hot-press models lack this control.' },
  { num: '03', title: 'Single vs Double Station', desc: 'Single barrel presses one batch at a time. Double station (one presses while other loads) nearly doubles daily throughput — ideal for commercial Kachi Ghani mills. The second barrel adds material cost but eliminates idle time.' },
  { num: '04', title: 'Voltage & India-Specific Setup', desc: 'India uses 415V/50Hz 3-phase (commercial) or 220V/50Hz single-phase (small workshops). We wind motors to your exact standard at **no extra charge** on standard models.' },
  { num: '05', title: 'Shipping to Indian Ports', desc: 'FOB Qingdao covers loading only. CIF to Mundra/Nhava Sheva adds ~28–32 days sea freight + insurance. Different ports have slightly different rates. We\'ll show you the full breakdown including estimated import duty.' },
];

const kachiGhaniTiers = [
  { label: 'Startup', emoji: '🌾', desc: '500–1,500 kg mustard seed/day. **HN325 single-barrel press** — entry point for small Kachi Ghani workshops. 220V single-phase or 415V 3-phase available.' },
  { label: 'Commercial', emoji: '❄️', desc: '1,500–3,000 kg mustard seed/day. **HN426 cold-press flagship** — higher pressure for mustard\'s tough seed coat, pressing below 60°C to preserve authentic Kachi Ghani pungency.' },
  { label: 'Industrial', emoji: '🏭', desc: '3,000 kg+ mustard seed/day. **HN426 double-station or HN500 multiple presses** — one barrel presses while other loads. 415V/50Hz standard.' },
];

const trustStats = [
  { num: '50+', label: 'Countries Served' },
  { num: '15+', label: 'Years Manufacturing' },
  { num: '24h', label: 'Quote Reply Time' },
  { num: '1,000+', label: 'Client Projects' },
];
const trustCountries = ['🇮🇳', '🇳🇬', '🇮🇩', '🇵🇭', '🇵🇰', '🇧🇩', '🇪🇬', '🇰🇪', '🇻🇳', '🇲🇲', '🇺🇸', '🇬🇧'];

const kachiGhaniModels = [
  { code: 'HN325', tonnage: '325', pressure: '27 MPa', best: 'Kachi Ghani Starter — small Indian workshops, single barrel, 415V/50Hz' },
  { code: 'HN426', tonnage: '500', pressure: '42 MPa', best: 'Kachi Ghani Flagship — authentic cold-press below 60°C, mustard hard seed coat' },
];
