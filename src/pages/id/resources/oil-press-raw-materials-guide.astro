---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'oil-press-raw-materials-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Panduan Bahan Baku Mesin Press Minyak';
const description = resource?.data.description.id || 'Biji dan kacang terbaik untuk ekstraksi';
const seoKeywords = resource?.data.seoKeywords || ['bahan baku minyak', 'biji ekstraksi'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/raw-materials-guide-hero.webp',
  author: { '@type': 'Person', name: 'Haonuo Engineering Team', jobTitle: 'Senior Oil Press Engineer', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/oil-press-raw-materials-guide' },
  ],
};

const keyCharacteristics = [
  { icon: 'droplet', title: 'Kadar Minyak', desc: 'Kadar minyak lebih tinggi = hasil per kg lebih tinggi' },
  { icon: 'thermometer', title: 'Kadar Air', desc: 'Kritis untuk ekstraksi optimal (terlalu kering = hasil berkurang, terlalu basah = emulsifikasi)' },
  { icon: 'circle', title: 'Ukuran & Bentuk Biji', desc: 'Mempengaruhi efisiensi penggilingan' },
  { icon: 'hammer', title: 'Kekerasan', desc: 'Menentukan tekanan press yang dibutuhkan' },
  { icon: 'trending-up', title: 'Nilai Pasar', desc: 'Minyak premium = margin keuntungan lebih tinggi' },
];

const modelToSlug = {
  'HN325': 'standard-hydraulic-oil-press',
  'HN355': 'heavy-duty-hydraulic-oil-press',
  'HN426': 'cold-press-hydraulic-oil-press',
  'HN480': 'high-pressure-hydraulic-oil-press',
  'HN500': 'ultra-high-pressure-hydraulic-oil-press',
};

const oilMaterials = [
  { name: 'Biji wijen', oilContent: '45-55%', moisture: '5-6% panas, 7-8% dingin', dehulling: '98%+', roasting: '160-180°C, 25-30 menit', yield: 'Panas 48-54%, Dingin 42-48%', models: ['HN325', 'HN355', 'HN426'], hot: true, cold: true },
  { name: 'Kacang tanah', oilContent: '45-50%', moisture: '5-7% panas', dehulling: '95%+', roasting: '165-185°C, 30-35 menit', yield: 'Panas 45-50%, Dingin 38-42%', models: ['HN325', 'HN355', 'HN480'], hot: true, cold: true },
  { name: 'Biji kolza', oilContent: '40-45%', moisture: '6-8% panas', dehulling: '85-90%', roasting: '150-170°C, 20-25 menit', yield: 'Panas 38-42%, Dingin 32-36%', models: ['HN325', 'HN355', 'HN500'], hot: true, cold: true },
  { name: 'Kacang walnut', oilContent: '60-70%', moisture: '7-9% dingin', dehulling: 'Penghapusan lengkap', roasting: 'Tanpa panggang', yield: 'Dingin 45-50%', models: ['HN426', 'HN480', 'HN500'], hot: false, cold: true },
  { name: 'Kacang almond', oilContent: '50-60%', moisture: '7-9% dingin', dehulling: 'Penghapusan lengkap', roasting: 'Tanpa panggang', yield: 'Dingin 42-48%', models: ['HN426', 'HN480', 'HN500'], hot: false, cold: true },
  { name: 'Kelapa', oilContent: '60-70%', moisture: '6-8%', dehulling: 'Hapus cangkang & kulit', roasting: 'Tidak berlaku', yield: 'Panas 60-65%, Dingin 55-60%', models: ['HN426', 'HN480', 'HN500'], hot: true, cold: true },
  { name: 'Biji kedelai', oilContent: '18-22%', moisture: '7-9% panas', dehulling: '90%+', roasting: '140-160°C, 25-30 menit', yield: 'Panas 18-22%, Dingin 15-18%', models: ['HN480', 'HN500'], hot: true, cold: true },
  { name: 'Biji teh', oilContent: '30-40%', moisture: '5-7% panas', dehulling: 'Hapus cangkang', roasting: '150-170°C, 25-30 menit', yield: 'Panas 28-35%', models: ['HN325', 'HN355', 'HN426'], hot: true, cold: false },
];

const preparationSteps = [
  { step: '1', title: 'Pembersihan Biji', details: ['Hapus kotoran (batu, logam, debu)', 'Pisahkan biji rusak dan pecah', 'Target: < 0.5% kotoran'] },
  { step: '2', title: 'Pengaturan Kadar Air', details: ['Terlalu kering: Tambah air dengan humidifier spray', 'Terlalu basah: Keringkan dengan pengering udara panas atau pengeringan matahari'] },
  { step: '3', title: 'Panggang (Press Panas)', details: ['Wijen: 160-180°C, 25-30 menit', 'Kacang tanah: 165-185°C, 30-35 menit', 'Kolza: 150-170°C, 20-25 menit'] },
  { step: '4', title: 'Penggilingan', details: ['Ukuran partikel optimal: 2-4 mm untuk sebagian besar bahan', '3-5 mm untuk kacang'] },
];

const storageTips = [
  { icon: 'thermometer', title: 'Suhu', desc: '15-25°C' },
  { icon: 'cloud', title: 'Kelembaban', desc: '< 65% kelembaban relatif' },
  { icon: 'clock', title: 'Durasi', desc: '< 6 bulan untuk kualitas terbaik' },
  { icon: 'shield', title: 'Pengendalian Hama', desc: 'Gunakan wadah tahan tikus, inspeksi rutin' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN PRODUKSI</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Haonuo Engineering Team</div>
            <div class="text-sm text-steel-500">Insinyur Teknik Press Minyak Senior · Pengalaman 15+ Tahun</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Pendahuluan</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Memilih bahan baku yang tepat sangat penting untuk produksi minyak yang sukses. Biji dan kacang yang berbeda memiliki kadar minyak, persyaratan pengolahan, dan nilai pasar yang bervariasi.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Memilih bahan baku yang tepat dapat secara signifikan mempengaruhi efisiensi produksi dan kualitas produk. Memahami karakteristik setiap bahan adalah kunci untuk memaksimalkan hasil.</p>
        </div>
      </section>

      <section id="properties" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Memahami Karakteristik Bahan Baku</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Karakteristik Utama</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {keyCharacteristics.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'droplet' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S6 13 6 15a7 7 0 0 0 7 7z"/></svg>}
                  {item.icon === 'thermometer' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>}
                  {item.icon === 'circle' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>}
                  {item.icon === 'hammer' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 2H5a2 2 0 0 0-2 2v7l3.45 3.45a2 2 0 0 0 1.41.55H13l5 5V4a2 2 0 0 0-2-2z"/></svg>}
                  {item.icon === 'trending-up' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                </div>
                <div>
                  <h4 class="font-semibold text-charcoal-900 mb-1">{item.title}</h4>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="materials" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Bahan Kayu Minyak Umum</h2>
        <div class="space-y-6">
          {oilMaterials.map((material, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden hover:shadow-lg transition-all duration-300">
              <div class="bg-gradient-to-r from-amber-500 to-orange-500 p-4">
                <div class="flex items-center justify-between">
                  <h3 class="font-display text-xl text-white">{material.name}</h3>
                  <div class="flex gap-2">
                    {material.hot && <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><path d="M18.07 16.94a8 8 0 1 1-11.31 0"/></svg> Panas</span>}
                    {material.cold && <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9"/><path d="M3 3v5h5"/><path d="M3 16a9 9 0 0 0 9 9"/><path d="M16 21h5v-5"/></svg> Dingin</span>}
                  </div>
                </div>
              </div>
              <div class="p-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Kadar Minyak</p>
                    <p class="font-semibold text-charcoal-900">{material.oilContent}</p>
                  </div>
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Kadar Air</p>
                    <p class="font-semibold text-charcoal-900 text-sm">{material.moisture}</p>
                  </div>
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Pengupasan</p>
                    <p class="font-semibold text-charcoal-900 text-sm">{material.dehulling}</p>
                  </div>
                  <div class="bg-steel-50 p-3 rounded-lg">
                    <p class="text-xs text-steel-500 mb-1">Hasil</p>
                    <p class="font-semibold text-charcoal-900 text-sm">{material.yield}</p>
                  </div>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-4">
                  <div class="flex items-center gap-2">
                    <span class="text-steel-500 text-sm">Panggangan:</span>
                    <span class="text-steel-700 font-medium">{material.roasting}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-steel-500 text-sm">Model Direkomendasikan:</span>
                    <div class="flex gap-2">
                      {material.models.map((model, idx) => (
                        <a key={idx} href={`/id/products/${modelToSlug[model] || model}`} class="bg-amber-100 text-amber-700 text-xs px-2 py-1 rounded font-medium hover:bg-amber-200 transition-colors">{model}</a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="preparation" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Praktik Terbaik Persiapan Bahan</h2>
        <div class="space-y-6">
          {preparationSteps.map((step, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{step.step}</div>
                {index < preparationSteps.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < preparationSteps.length - 1 ? 'pb-8' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{step.title}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  {step.details.map((detail, idx) => (
                    <p key={idx} class="mb-1 text-steel-700 flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {detail}
                    </p>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="storage" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Penyimpanan dan Penanganan</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Kondisi Penyimpanan</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          {storageTips.map((tip, index) => (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-blue-100 p-5 rounded-xl border border-blue-200">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-3">
                {tip.icon === 'thermometer' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>}
                {tip.icon === 'cloud' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 16.5A2.5 2.5 0 0 0 20 14a2.5 2.5 0 0 0-2.5-2.5h-5.5a4.5 4.5 0 1 0 0 9h2a2.5 2.5 0 0 0 2.5-2.5Z"/></svg>}
                {tip.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                {tip.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              </div>
              <h4 class="font-semibold text-blue-800 mb-1">{tip.title}</h4>
              <p class="text-steel-600 text-sm">{tip.desc}</p>
            </div>
          ))}
        </div>

        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Pengendalian Hama</h3>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg">
          <ul class="space-y-2 text-steel-700">
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Gunakan wadah tahan tikus
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Inspeksi rutin
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Langkah pengendalian hama yang tepat
            </li>
          </ul>
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Kesimpulan</h2>
        <p class="text-steel-700 leading-relaxed">Memilih bahan baku yang tepat sangat penting untuk produksi minyak yang sukses. Untuk rekomendasi personalisasi tentang bahan apa yang harus diproses dan cara mengoptimalkan produksi Anda, hubungi tim teknis Haonuo.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">SIAP MEMULAI PRODUKSI MINYAK ANDA?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Tim insinyur kami dapat membantu Anda memilih bahan baku dan peralatan terbaik untuk kebutuhan produksi spesifik Anda.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Hubungi Ahli Kami<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/id/products" class="btn-outline border-white text-white hover:bg-white/10">Telusuri Peralatan</a>
        <a href="/id/resources" class="btn-outline border-white text-white hover:bg-white/10">Kembali ke Sumber Daya</a>
      </div>
    </div>
  </section>
</BaseLayout>

