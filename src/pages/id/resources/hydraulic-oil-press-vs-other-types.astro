---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-vs-other-types');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Pengepres Minyak Hidrolik vs Jenis Lainnya';
const description = resource?.data.description.id || 'Pilih pengepres yang tepat untuk kebutuhan Anda';
const seoKeywords = resource?.data.seoKeywords || ['pengepres minyak hidrolik vs ulir', 'perbandingan pengepres minyak', 'pengepres minyak mana yang harus dipilih'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/oil-press-comparison-hero.webp',
  author: { '@type': 'Person', name: 'Tim Teknik Haonuo', jobTitle: 'Insinyur Teknis Pengepres Minyak', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/hydraulic-oil-press-vs-other-types' },
  ],
};

const comparisonData = [
  { name: 'Pengepres Minyak Hidrolik', color: 'amber', pros: ['Tekanan tinggi (hingga 60MPa)', 'Cocok untuk biji berkadar minyak tinggi', 'Pengepresan lembut = kualitas lebih baik', 'Noise rendah, getaran rendah', 'Umur pakai panjang (15-20 tahun)', 'Perawatan lebih sedikit', 'Bisa dipres tanpa pemanasan (pengepresan dingin)', 'Jejak kaki lebih kecil', 'Operasi batch - fleksibel'], cons: ['Output kontinu lebih rendah', 'Biaya awal lebih tinggi', 'Butuh lebih banyak perhatian operator'], best: ['Produksi skala kecil hingga menengah', 'Minyak premium (pervak, dingin)', 'Minyak spesial bernilai tinggi', 'Produsen artisanal dan butik'] },
  { name: 'Pengepres Minyak Ulir', color: 'blue', pros: ['Operasi kontinu', 'Throughput tinggi', 'Harga lebih rendah', 'Bagus untuk skala besar', 'Dapat menangani berbagai bahan'], cons: ['Tekanan lebih rendah (20-30MPa)', 'Seringkali butuh pemanasan', 'Noise lebih tinggi', 'Suku cadang aus perlu diganti', 'Tidak ideal untuk pengepresan dingin', 'Kualitas bisa lebih rendah'], best: ['Produksi komersial skala besar', 'Minyak memasak standar', 'Produksi pakan hewan', 'Pemrosesan minyak curah'] },
  { name: 'Pengepres Ram', color: 'green', pros: ['Metode tradisional', 'Konstruksi sederhana', 'Tekanan sangat tinggi mungkin', 'Bagus untuk skala kecil'], cons: ['Sangat padat karya', 'Tingkat produksi rendah', 'Butuh operasi manual', 'Kapasitas terbatas'], best: ['Produksi artisanal', 'Batch sangat kecil', 'Metode tradisional', 'Area terpencil tanpa daya'] },
];

const specsTable = [
  { feature: 'Tekanan', hydraulic: '40-60 MPa', screw: '20-30 MPa', ram: '30-50 MPa' },
  { feature: 'Operasi', hydraulic: 'Batch (semi-otomatis)', screw: 'Kontinu', ram: 'Batch manual' },
  { feature: 'Output Harian', hydraulic: '500-1500 kg', screw: '100-1000 kg', ram: '2-10 kg' },
  { feature: 'Kualitas Minyak', hydraulic: 'Luar biasa (pervak)', screw: 'Baik', ram: 'Sangat baik' },
  { feature: 'Pengepresan Dingin', hydraulic: 'Ya', screw: 'Terbatas', ram: 'Ya' },
  { feature: 'Perawatan', hydraulic: 'Rendah', screw: 'Tinggi (keausan ulir)', ram: 'Sangat rendah' },
  { feature: 'Umur Pakai', hydraulic: '15-20 tahun', screw: '5-10 tahun', ram: '20+ tahun' },
  { feature: 'Konsumsi Daya', hydraulic: '2-3 kW', screw: '5-15 kW', ram: 'Manual/1 kW' },
  { feature: 'Rentang Harga', hydraulic: 'Hubungi untuk harga', screw: 'Hubungi untuk harga', ram: 'Hubungi untuk harga' },
];

const decisionFramework = [
  { question: 'Berapa target produksi harian Anda?', hydraulic: '500-1500 kg/hari', screw: '100-1000 kg/hari', ram: '2-10 kg/hari' },
  { question: 'Kualitas minyak apa yang Anda butuhkan?', hydraulic: 'Pervak premium/dingin', screw: 'Minyak memasak standar', ram: 'Tradisional buatan tangan' },
  { question: 'Berapa anggaran Anda?', hydraulic: 'Hubungi untuk harga', screw: 'Hubungi untuk harga', ram: 'Hubungi untuk harga' },
  { question: 'Apakah Anda membutuhkan operasi kontinu?', hydraulic: 'Tidak (batch)', screw: 'Ya', ram: 'Tidak' },
];

const myths = [
  { myth: 'Pengepres hidrolik hanya untuk skala kecil', fact: 'Salah - pengepres hidrolik modern menangani 100 kg per batch, dengan waktu siklus dari 40 menit hingga 1,5 jam tergantung bahan' },
  { myth: 'Pengepres ulir selalu menghasilkan lebih banyak minyak', fact: 'Salah - pengepres hidrolik dapat mencapai hasil lebih tinggi dengan bahan tertentu' },
  { myth: 'Pengepresan dingin selalu menghasilkan lebih sedikit minyak', fact: 'Salah - dengan pra-perlakuan yang tepat, hasil dingin bisa 42-50%' },
  { myth: 'Pengepres hidrolik butuh lebih banyak perawatan', fact: 'Salah - pengepres hidrolik memiliki lebih sedikit bagian yang aus' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN PERBANDINGAN</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Tim Teknik Haonuo</div>
            <div class="text-sm text-steel-500">Insinyur Teknis Pengepres Minyak · 15+ Tahun Pengalaman</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Pendahuluan</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Saat memilih pengepres minyak, memahami perbedaan antara pengepres hidrolik, ulir, dan ram sangat penting. Setiap jenis memiliki kelebihan sendiri dan cocok untuk kebutuhan produksi yang berbeda.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Tidak ada pengepres minyak "terbaik" - hanya pengepres terbaik untuk kebutuhan spesifik Anda. Panduan ini akan membantu Anda memahami perbedaan utama dan membuat keputusan yang tepat.</p>
        </div>
      </section>

      <section id="comparison" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Perbandingan Mendalam</h2>
        <div class="space-y-6">
          {comparisonData.map((item, index) => (
            <div key={index} class="bg-white rounded-2xl border-2 overflow-hidden shadow-lg" style={item.color === 'amber' ? 'border-color: #f59e0b' : item.color === 'blue' ? 'border-color: #3b82f6' : 'border-color: #10b981'}>
              <div class={`p-5 ${item.color === 'amber' ? 'bg-gradient-to-r from-amber-500 to-orange-500' : item.color === 'blue' ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : 'bg-gradient-to-r from-green-500 to-emerald-500'}`}>
                <h3 class="font-display text-xl text-white">{item.name}</h3>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
                <div class="p-5 bg-green-50 border-r border-steel-100">
                  <h4 class="font-semibold text-green-700 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    Kelebihan
                  </h4>
                  <ul class="space-y-2">
                    {item.pros.map((pro, idx) => (
                      <li key={idx} class="text-steel-700 text-sm flex items-start gap-2"><span class="text-green-500 mt-0.5">+</span>{pro}</li>
                    ))}
                  </ul>
                </div>
                <div class="p-5 bg-red-50 border-r border-steel-100">
                  <h4 class="font-semibold text-red-700 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Kekurangan
                  </h4>
                  <ul class="space-y-2">
                    {item.cons.map((con, idx) => (
                      <li key={idx} class="text-steel-700 text-sm flex items-start gap-2"><span class="text-red-500 mt-0.5">-</span>{con}</li>
                    ))}
                  </ul>
                </div>
                <div class="p-5 bg-blue-50">
                  <h4 class="font-semibold text-blue-700 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Cocok Untuk
                  </h4>
                  <ul class="space-y-2">
                    {item.best.map((b, idx) => (
                      <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {b}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="specs" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Perbandingan Spesifikasi Teknis</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead>
              <tr class="bg-gradient-to-r from-charcoal-800 to-charcoal-900 text-white">
                <th class="px-4 py-3 text-left font-semibold">Fitur</th>
                <th class="px-4 py-3 text-left font-semibold">Hidrolik</th>
                <th class="px-4 py-3 text-left font-semibold">Ulir</th>
                <th class="px-4 py-3 text-left font-semibold">Ram</th>
              </tr>
            </thead>
            <tbody>
              {specsTable.map((row, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{row.feature}</td>
                  <td class="px-4 py-3 text-amber-600">{row.hydraulic}</td>
                  <td class="px-4 py-3 text-blue-600">{row.screw}</td>
                  <td class="px-4 py-3 text-green-600">{row.ram}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="decision" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Kerangka Pengambilan Keputusan</h2>
        <p class="text-steel-700 mb-6">Jawab pertanyaan kunci ini untuk menentukan jenis pengepres minyak terbaik untuk kebutuhan Anda:</p>
        <div class="space-y-4">
          {decisionFramework.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-sm overflow-hidden">
              <div class="bg-steel-50 p-4">
                <h3 class="font-semibold text-charcoal-900 flex items-center gap-2">
                  <span class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.question}
                </h3>
              </div>
              <div class="grid grid-cols-3 gap-0">
                <div class="p-4 bg-amber-50 border-r border-steel-100">
                  <p class="text-xs text-steel-500 mb-1">Hidrolik</p>
                  <p class="text-amber-700 font-medium text-sm">{item.hydraulic}</p>
                </div>
                <div class="p-4 bg-blue-50 border-r border-steel-100">
                  <p class="text-xs text-steel-500 mb-1">Ulir</p>
                  <p class="text-blue-700 font-medium text-sm">{item.screw}</p>
                </div>
                <div class="p-4 bg-green-50">
                  <p class="text-xs text-steel-500 mb-1">Ram</p>
                  <p class="text-green-700 font-medium text-sm">{item.ram}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="myths" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Mitos Umum yang Disangkal</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {myths.map((item, index) => (
            <div key={index} class="bg-gradient-to-r from-purple-50 to-pink-50 p-5 rounded-xl border border-purple-100">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <div>
                  <p class="font-semibold text-charcoal-900 mb-1">Mitos: {item.myth}</p>
                  <p class="text-steel-700 text-sm">Fakta: {item.fact}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Kesimpulan</h2>
        <p class="text-steel-700 leading-relaxed">Untuk produksi skala kecil hingga menengah, kualitas minyak premium, dan kemampuan pengepresan dingin, pengepres minyak hidrolik adalah pilihan yang lebih unggul. Untuk rekomendasi yang dipersonalisasi, hubungi tim teknis kami.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">MASIH RAGU?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Insinyur kami dapat membantu Anda memilih pengepres minyak yang sempurna untuk kebutuhan dan anggaran produksi spesifik Anda.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Dapatkan Saran Ahli<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/id/products" class="btn-outline border-white text-white hover:bg-white/10">Lihat Pengepres Hidrolik</a>
        <a href="/id/resources" class="btn-outline border-white text-white hover:bg-white/10">Kembali ke Sumber Daya</a>
      </div>
    </div>
  </section>
</BaseLayout>
