---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-buying-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Panduan Membeli Pengepres Minyak Hidrolik';
const description = resource?.data.description.id || 'Investasikan pada pengepres yang tepat dengan percaya diri';
const seoKeywords = resource?.data.seoKeywords || ['panduan membeli pengepres minyak', 'cara memilih pengepres minyak', 'daftar periksa pembelian pengepres minyak'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/buying-guide-hero.webp',
  author: { '@type': 'Person', name: 'Eason', jobTitle: 'Senior Hydraulic Press Engineer', url: 'https://www.hydoilpress.com/about/', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.', url: 'https://www.hydoilpress.com' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/hydraulic-oil-press-buying-guide/' },
  ],
};

const buyingChecklist = [
  { category: 'Kebutuhan Produksi', items: [
    'Target produksi harian (kg/hari)',
    'Jenis bahan yang akan diproses',
    'Kualitas minyak yang dibutuhkan (pervak, memasak, dll.)',
    'Apakah kemampuan pengepresan dingin dibutuhkan?',
  ]},
  { category: 'Spesifikasi Teknis', items: [
    'Tekanan hidrolik (40-60 MPa direkomendasikan)',
    'Daya motor (2,2 kW standar)',
    'Tegangan (220V atau 380V)',
    'Dimensi dan berat mesin',
  ]},
  { category: 'Kualitas & Garansi', items: [
    'Reputasi dan pengalaman pabrikan',
    'Periode garansi (minimal 1 tahun)',
    'Ketersediaan layanan purna jual',
    'Ketersediaan suku cadang',
  ]},
  { category: 'Pertimbangan Operasional', items: [
    'Target kapasitas produksi harian',
    'Biaya instalasi dan pelatihan',
    'Suku cadang dan perawatan',
    'Biaya operasional (daya, tenaga kerja)',
  ]},
];

const questionsToAsk = [
  'Berapa target produksi harian Anda?',
  'Biji/kacang apa yang akan Anda proses?',
  'Apakah Anda membutuhkan kemampuan pengepresan dingin?',
  'Berapa target kapasitas produksi Anda?',
  'Apakah Anda memiliki sumber daya listrik?',
  'Berapa ruang kerja yang tersedia?',
  'Apakah Anda membutuhkan dukungan pelatihan dan instalasi?',
  'Apa pasar minyak target Anda (pervak, memasak, kosmetik)?',
];

const redFlags = [
  'Harga tidak realistis rendah',
  'Tidak ada garansi yang ditawarkan',
  'Tidak ada layanan purna jual',
  'Lokasi pabrikan tidak diketahui',
  'Tidak ada dokumentasi teknis',
  'Tekanan di bawah 40 MPa',
  'Peralatan bekas/peremajaan',
];

---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id/" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN PEMBELIAN</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Tim Teknik Haonuo</div>
            <div class="text-sm text-steel-500">Insinyur Senior Pengepres Minyak · 15+ Tahun Pengalaman</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Yang Perlu Diketahui Sebelum Membeli Mesin Press Minyak Hidrolik</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Berinvestasi dalam pengepres minyak hidrolik adalah keputusan penting yang dapat mengubah bisnis produksi minyak Anda. Panduan komprehensif ini mencakup semua yang perlu Anda ketahui untuk melakukan pembelian yang tepat.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Pengepres minyak yang baik dapat membayar dirinya sendiri dalam 1-3 bulan. Pembelian yang buruk dapat mengakibatkan frustrasi selama bertahun-tahun dan pendapatan yang hilang. Panduan ini akan membantu Anda menghindari kesalahan yang mahal.</p>
        </div>
      </section>

      <section id="checklist" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Daftar Periksa Sebelum Membeli Mesin Press Minyak Hidrolik</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {buyingChecklist.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-md overflow-hidden">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <h3 class="font-semibold text-white flex items-center gap-2">
                  <span class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center text-sm font-bold">{index + 1}</span>
                  {item.category}
                </h3>
              </div>
              <div class="p-5">
                <ul class="space-y-2">
                  {item.items.map((item2, idx) => (
                    <li key={idx} class="flex items-start gap-3">
                      <div class="w-5 h-5 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                      </div>
                      <span class="text-steel-700 text-sm">{item2}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="models" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Memilih Model Mesin Press Minyak Hidrolik yang Tepat</h2>
        <p class="text-steel-600 mb-6">Model yang tepat bergantung pada <strong>jenis biji utama</strong> (biji lunak butuh tekanan lebih rendah; kacang keras dan kelapa dengan tempurung butuh gaya lebih tinggi), <strong>target produksi harian</strong>, dan apakah produksi didominasi <strong>press dingin atau panas</strong>.</p>
        <p class="text-steel-600 mb-6">Panduan ini berisi pertanyaan yang harus diajukan ke <em>setiap</em> pemasok. Untuk perbandingan berdampingan seluruh lini Haonuo (HN300 hingga HN500) dengan spesifikasi asli dan rekomendasi per jenis biji, lihat halaman <a href="/id/products/model-comparison/" class="text-amber-600 hover:underline font-semibold">Perbandingan Model</a>. Untuk gambaran cepat seluruh mesin hidrolik, kunjungi <a href="/id/hydraulic-oil-press-machine/" class="text-amber-600 hover:underline font-semibold">Panduan Mesin Press Hidrolik</a>.</p>
      </section>

      <section id="questions" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Pertanyaan untuk Pemasok Mesin Press Minyak Anda</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {questionsToAsk.map((question, index) => (
            <div key={index} class="bg-blue-50 p-4 rounded-xl border border-blue-100 flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">{index + 1}</div>
              <p class="text-steel-700">{question}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="red-flags" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Tanda Bahaya Saat Membeli Mesin Press Minyak</h2>
        <div class="bg-red-50 rounded-xl border border-red-200 p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {redFlags.map((flag, index) => (
              <div key={index} class="bg-white p-3 rounded-lg flex items-center gap-3 border border-red-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="text-steel-700">{flag}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="total-cost-ownership" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Total Biaya Kepemilikan</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Harga mesin yang dikutip biasanya hanya 60–75% dari biaya landed dan operasional pada tahun pertama. Ongkos angkut, biaya pelabuhan dan bea masuk, instalasi listrik, pekerjaan pondasi, commissioning, pelatihan operator, dan paket suku cadang awal semuanya menambah di atas nilai invoice, dan mesin murah yang tidak memiliki dukungan lokal sering menjadi penawaran termahal di meja. Mempelajari cara memilih mesin press minyak karena itu dimulai dari total tagihan, bukan angka pertama yang dikutip.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Minta setiap pemasok dalam daftar pendek mengutip cakupan yang sama</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>Harga mesin dengan konfigurasi tabung press yang tepat — tabung press tunggal atau ganda mengubah harga sekaligus kapasitas.</li>
            <li>Suku cadang standar yang disertakan bersama mesin dan harga paket tahunan yang direkomendasikan.</li>
            <li>Cakupan panel listrik: apa yang sudah terpasang kabelnya di mesin dan apa yang harus dipasang pelanggan.</li>
            <li>Dukungan instalasi: panduan jarak jauh atau teknisi di lokasi, dan siapa yang menanggung perjalanan serta hari kerja.</li>
            <li>Ketentuan garansi: durasi, apa yang ditanggung, dan bagaimana klaim ditangani lintas negara.</li>
            <li>Waktu pengiriman dalam minggu terhadap tanggal deposit yang ditetapkan, bukan klaim "siap stok".</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">Bandingkan total yang dihasilkan, bukan baris pertama. Harga mesin 10% lebih rendah hilang dalam satu minggu commissioning yang tertunda atau satu kit seal yang dikirim lewat udara.</p>
      </section>

      <section id="verifying-manufacturer" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Memverifikasi Pabrikan Sebelum Membayar</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Foto pabrik dalam brosur gratis; bukti tidak. Sebelum membayar deposit, verifikasi pembuat mesin dengan keseriusan yang sama seperti Anda memeriksa spesifikasi mesin.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Minta tur video langsung ke bengkel yang menunjukkan model yang Anda beli sedang dirakit, bukan ruang pamer.</li>
          <li>Minta dua atau tiga pelanggan referensi di pasar serupa dan hubungi mereka tentang dukungan instalasi, bukan hanya kualitas mesin.</li>
          <li>Periksa bahwa rating tekanan, ketebalan baja, dan merek motor dalam penawaran sesuai dengan yang dibahas secara lisan — mesin kelas HN berjalan dari 325 t / 60 MPa ke atas dengan penggerak 2.2–3 kW, dan lembar spesifikasi yang kabur adalah tanda peringatan.</li>
          <li>Pastikan pelat nama bernomor seri, sertifikat tekanan tercetak untuk tabung press dan silinder, serta dokumentasi listrik dalam bahasa yang dapat dibaca teknisi listrik Anda.</li>
          <li>Bayar melalui instrumen perdagangan yang dapat dilacak dengan struktur deposit–pelunasan yang ditetapkan dan terkait tonggak inspeksi serta pengiriman; hindari pembayaran penuh di muka atau tekanan pembayaran di luar platform.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed mt-4">Taktik tekanan juga masuk dalam daftar tanda peringatan ini. Penjual yang mendesak deposit segera, menolak menuliskan spesifikasi dan tanggal pengiriman yang disepakati, atau mengalihkan setiap pertanyaan teknis kembali ke "percayai kami, kami mengekspor ke mana-mana" sedang menjual keyakinan, bukan peralatan. Pabrikan yang sah nyaman dengan pertanyaan, referensi, dan tonggak — karena mesin yang dibangun dengan baik dan pabrik yang terdokumentasi lolos ketiganya.</p>
      </section>

      <section id="installation-training" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Instalasi, Pelatihan, dan Bulan Pertama</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Pemasok yang baik memperlakukan pengiriman sebagai pertengahan transaksi, bukan akhir. Sepakati sebelum memesan dukungan commissioning apa yang termasuk: penempatan dan penjangkaran mesin, koneksi hidrolik dan listrik, uji press pertama dengan biji Anda yang sebenarnya, pengaturan tekanan dan waktu, serta pelatihan operator untuk pemuatan, penahanan, pembongkaran, pembersihan, dan rutinitas inspeksi harian.</p>
        <p class="text-steel-700 leading-relaxed mb-4">Rencanakan bulan pertama dengan sengaja: jalankan satu jenis biji dan satu resep, simpan catatan batch, dan verifikasi oli sisa di bungkil terhadap angka yang dinyatakan pemasok — 6–8% untuk tabung press cold-press berslot, sekitar 5–7% untuk press panas yang dijalankan dengan baik. Masalah yang diterima diam-diam pada bulan pertama menjadi "normal" pada bulan keenam. Pemilihan ukuran dan model untuk beban kerja itu sendiri — HN325 untuk produksi batch kecil dan pemula, HN365 untuk volume harian lebih tinggi, HN426 untuk press dingin khusus, HN500 untuk tugas terberat — dipetakan dalam <a href="/id/products/" class="text-amber-600 hover:underline">rangkaian produk</a>, dan prasyarat fasilitas serta daya dijelaskan dalam <a href="/id/resources/oil-press-electrical-requirements-guide/" class="text-amber-600 hover:underline">panduan persyaratan listrik</a>.</p>
        <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Mesin bekas dan waktu pengiriman</h3>
        <p class="text-steel-700 leading-relaxed mb-4">Mesin press hidrolik bekas dapat menjadi nilai yang sangat baik karena rangka dan bejana tekan bertahan melewati beberapa generasi seal dan kontrol — tetapi hanya jika riwayatnya dapat diverifikasi. Periksa kondisi tabung press dan silinder, minta catatan perawatan dan analisis oli, uji tekanan sebelum membeli, dan masukkan biaya pembaruan penuh seal, selang, dan listrik ke dalam perbandingan dengan mesin baru. Sebaliknya, mesin bekas yang dijual tanpa catatan adalah bejana tekan tak dikenal tanpa pabrikan yang mendukungnya, dan penghematan jarang bertahan melewati rebuild pertama.</p>
        <p class="text-steel-700 leading-relaxed">Terakhir, rencanakan waktu pembelian mengikuti biji, bukan sentimen. Memesan pada awal musim panen berarti bersaing untuk slot pabrik dan angkutan sementara bahan mentah termurah menunggu di halaman; bengkel yang dikelola terbaik menempatkan pesanan agar commissioning selesai sebelum musim pembelian mereka, dan menghabiskan bulan-bulan sepi untuk pelatihan dan menjalankan batch uji dengan biji yang lebih murah.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Beli Mesin Press Minyak Hidrolik dengan Percaya Diri</h2>
        <p class="text-steel-700 leading-relaxed">Memilih pengepres minyak hidrolik yang tepat sangat penting untuk keberhasilan bisnis Anda. Dengan mengikuti daftar periksa panduan ini dan bekerja dengan pabrikan yang bereputasi, Anda dapat melakukan investasi percaya diri yang akan membuahkan hasil selama bertahun-tahun.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">DAPATKAN PENAWARAN GRATIS ANDA HARI INI</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Kirimkan kebutuhan produksi Anda dan dapatkan rekomendasi yang dipersonalisasi sesuai dengan bisnis Anda.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact/" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Dapatkan Harga Pabrik<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/id/products/" class="btn-outline border-white text-white hover:bg-white/10">Lihat Semua Model</a>
        <a href="/id/resources/" class="btn-outline border-white text-white hover:bg-white/10">Kembali ke Sumber Daya</a>
      </div>
    </div>
  </section>
</BaseLayout>
