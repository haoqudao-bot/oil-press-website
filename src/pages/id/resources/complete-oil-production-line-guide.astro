---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'complete-oil-production-line-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Panduan Lengkap Garis Produksi Minyak';
const description = resource?.data.description.id || 'Dari biji hingga minyak kemasan';
const seoKeywords = resource?.data.seoKeywords || ['garis produksi minyak', 'pabrik minyak lengkap', 'peralatan pengolahan minyak'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/production-line-hero.webp',
  author: { '@type': 'Person', name: 'Tim Teknik Haonuo', jobTitle: 'Insinyur Produksi Senior', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/images/logo.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/complete-oil-production-line-guide' },
  ],
};

const productionStages = [
  { stage: '1', title: 'Pembersihan Biji', equipment: 'Layar getar, pemisah magnetik', desc: 'Buang kotoran, batu, logam, dan biji rusak. Sangat penting untuk kualitas dan perlindungan peralatan.' },
  { stage: '2', title: 'Pengupasan', equipment: 'Pengupas, pemisah', desc: 'Buang kulit biji untuk meningkatkan hasil minyak dan kualitas cake.' },
  { stage: '3', title: 'Penggorengan', equipment: 'Penggoreng putar, pengontrol suhu', desc: 'Panaskan biji untuk memecah dinding sel, meningkatkan rasa dan hasil.' },
  { stage: '4', title: 'Penggilingan', equipment: 'Hammer mill, roller mill', desc: 'Haluskan biji ke ukuran partikel optimal untuk pemerasan efisien.' },
  { stage: '5', title: 'Pemerasan', equipment: 'Mesin press minyak hidrolik', desc: 'Ekstraksi minyak dengan tekanan tinggi (40-60 MPa). Jantung garis produksi.' },
  { stage: '6', title: 'Filtrasi', equipment: 'Press filter, sentrifugal', desc: 'Buang partikel padat dan air dari minyak mentah.' },
  { stage: '7', title: 'Pengeringan', equipment: 'Pengering minyak, pemanas', desc: 'Turunkan kadar air hingga <0,1% untuk stabilitas masa simpan.' },
  { stage: '8', title: 'Pengemasan', equipment: 'Mesin pengisi, penutup, pelabel', desc: 'Kemas minyak dalam wadah akhir untuk ritel atau grosir.' },
];

const capacityOptions = [
  { scale: 'Workshop Rumah', capacity: '100-500 kg/hari', equipment: ['Press HN325', 'Penggoreng kecil', 'Filter manual', 'Peralatan tangan'] },
  { scale: 'Bisnis Kecil', capacity: '500-2000 kg/hari', equipment: ['Press HN355', 'Penggoreng putar', 'Sistem filter', 'Penggiling', 'Tangki penyimpanan'] },
  { scale: 'Pabrik Sedang', capacity: '2000-5000 kg/hari', equipment: ['Press HN426/HN480', 'Penggoreng lengkap', 'Sentrifugal', 'Garis lengkap', 'Otomasi'] },
  { scale: 'Industri Besar', capacity: '5000+ kg/hari', equipment: ['Multi press HN500', 'Penggoreng industri', 'Garis penyulingan lengkap', 'Otomasi lengkap'] },
];

const layoutTips = [
  { tip: 'Tata Alir', desc: 'Susun peralatan sesuai alur logis: bahan baku → pengolahan → pengemasan' },
  { tip: 'Perencanaan Ruang', desc: 'Sediakan ruang 2-3x luas peralatan untuk operasi dan perawatan' },
  { tip: 'Utilitas', desc: 'Rencanakan listrik, air, dan drainase sebelum instalasi' },
  { tip: 'Ventilasi', desc: 'Pasang ventilasi yang tepat untuk area penggorengan dan pemerasan' },
  { tip: 'Zona Keamanan', desc: 'Buat zona aman di sekitar peralatan bertekanan' },
];

const costAnalysis = [
  { item: 'Peralatan Inti (Press + Auxiliary)', percentage: '40-50%' },
  { item: 'Instalasi & Komisioning', percentage: '10-15%' },
  { item: 'Bangunan & Infrastruktur', percentage: '15-25%' },
  { item: 'Bahan Baku Awal', percentage: '5-10%' },
  { item: 'Modal Kerja', percentage: '10-15%' },
];

const maintenanceSchedule = [
  { frequency: 'Harian', tasks: ['Bersihkan peralatan', 'Periksa level oli hidrolik', 'Periksa filter', 'Periksa perangkat keamanan'] },
  { frequency: 'Mingguan', tasks: ['Ganti filter', 'Periksa tegangan sabuk', 'Periksa ruang pemerasan', 'Lumasi bagian yang bergerak'] },
  { frequency: 'Bulanan', tasks: ['Ganti oli hidrolik', 'Periksa selang hidrolik', 'Kalibrasi kontrol suhu', 'Periksa koneksi listrik'] },
  { frequency: 'Kuartalan', tasks: ['Inspeksi sistem lengkap', 'Ganti bagian aus', 'Uji sistem keamanan', 'Bersihkan tangki penyimpanan'] },
  { frequency: 'Tahunan', tasks: ['Overhaul sistem hidrolik', 'Ganti seal hidrolik', 'Inspeksi listrik lengkap', 'Perbarui catatan perawatan'] },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN LENGKAP</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Tim Teknik Haonuo</div>
            <div class="text-sm text-steel-500">Insinyur Produksi Senior · 15+ Tahun Pengalaman</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Pendahuluan</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Garis produksi minyak lengkap mengubah biji mentah menjadi minyak kemasan yang siap dipasarkan. Memahami proses penuh membantu Anda merencanakan, menganggarkan, dan mengoptimalkan operasi Anda.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Menyiapkan garis produksi lengkap adalah investasi signifikan namun dapat memberikan margin keuntungan 10-30% lebih tinggi dibanding menjual minyak mentah. Perencanaan yang matang sangat penting untuk keberhasilan.</p>
        </div>
      </section>

      <section id="stages" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Tahapan Produksi</h2>
        <div class="space-y-4">
          {productionStages.map((stage, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{stage.stage}</div>
                {index < productionStages.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < productionStages.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{stage.title}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  <p class="text-amber-600 text-sm mb-1"><strong>Peralatan:</strong> {stage.equipment}</p>
                  <p class="text-steel-600 text-sm">{stage.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="capacity" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Pilihan Skala Produksi</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {capacityOptions.map((option, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden shadow-md hover:shadow-lg transition-shadow">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <div class="flex justify-between items-center">
                  <h3 class="font-display text-lg text-white">{option.scale}</h3>
                  <span class="bg-white/20 text-white text-sm px-2 py-1 rounded">{option.capacity}</span>
                </div>
              </div>
              <div class="p-5">
                <p class="text-sm text-steel-500 mb-2">Peralatan Utama:</p>
                <ul class="space-y-1">
                  {option.equipment.map((equip, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                      {equip}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="layout" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Tips Tata Letak Fasilitas</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {layoutTips.map((tip, index) => (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-indigo-50 p-5 rounded-xl border border-blue-100">
              <h4 class="font-semibold text-blue-800 mb-2">{tip.tip}</h4>
              <p class="text-steel-700 text-sm">{tip.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="cost" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Analisis Biaya Investasi</h2>
        <p class="text-steel-700 mb-6">Rincian investasi khas untuk garis produksi minyak lengkap:</p>
        <div class="space-y-3">
          {costAnalysis.map((item, index) => (
            <div key={index} class="bg-white p-4 rounded-lg border border-steel-100 flex justify-between items-center">
              <span class="text-steel-700">{item.item}</span>
              <div class="flex items-center gap-3">
                <div class="w-32 bg-steel-100 rounded-full h-2">
                  <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-2 rounded-full" style={`width: ${parseInt(item.percentage)}%`}></div>
                </div>
                <span class="font-semibold text-amber-600 text-sm w-16 text-right">{item.percentage}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Jadwal Perawatan</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {maintenanceSchedule.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-sm overflow-hidden">
              <div class={`p-3 ${index === 0 ? 'bg-green-100' : index === 1 ? 'bg-blue-100' : index === 2 ? 'bg-amber-100' : index === 3 ? 'bg-purple-100' : 'bg-red-100'}`}>
                <h3 class="font-semibold text-charcoal-900">{item.frequency}</h3>
              </div>
              <div class="p-4">
                <ul class="space-y-2">
                  {item.tasks.map((task, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {task}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Kesimpulan</h2>
        <p class="text-steel-700 leading-relaxed">Garis produksi minyak lengkap adalah investasi bisnis yang kuat. Dengan merencanakan setiap tahap secara hati-hati dan bekerja sama dengan pemasok peralatan yang berpengalaman, Anda dapat membangun operasi produksi minyak yang menguntungkan dan berkelanjutan. Hubungi tim kami untuk desain garis produksi yang dipersonalisasi dan penawaran harga.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">BANGUN KEKINYAAN PRODUKSI MINYAK ANDA</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Tim insinyur kami dapat merancang garis produksi lengkap yang disesuaikan dengan kebutuhan dan anggaran spesifik Anda.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Minta Konsultasi<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/id/products" class="btn-outline border-white text-white hover:bg-white/10">Lihat Peralatan</a>
        <a href="/id/resources" class="btn-outline border-white text-white hover:bg-white/10">Kembali ke Sumber Daya</a>
      </div>
    </div>
  </section>
</BaseLayout>
