---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'complete-oil-production-line-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Panduan Lengkap Garis Produksi Minyak';
const description = resource?.data.description.id || 'Dari biji hingga minyak kemasan';
const seoKeywords = resource?.data.seoKeywords || ['garis produksi minyak', 'pabrik minyak lengkap', 'peralatan pengolahan minyak'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/production-line-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about/' },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/complete-oil-production-line-guide/' },
  ],
};

const productionStages = [
  { stage: '1', title: 'Pembersihan Biji', equipment: 'Layar getar, pemisah magnetik', desc: 'Buang kotoran, batu, logam, dan biji rusak. Sangat penting untuk kualitas dan perlindungan peralatan.' },
  { stage: '2', title: 'Pengupasan', equipment: 'Pengupas, pemisah', desc: 'Buang kulit biji untuk meningkatkan hasil minyak dan kualitas cake.' },
  { stage: '3', title: 'Penggorengan', equipment: 'Penggoreng putar, pengontrol suhu', desc: 'Panaskan biji untuk memecah dinding sel, meningkatkan rasa dan hasil.' },
  { stage: '4', title: 'Penggilingan', equipment: 'Hammer mill, roller mill', desc: 'Haluskan biji ke ukuran partikel optimal untuk pemerasan efisien.' },
  { stage: '5', title: 'Pemerasan', equipment: 'Mesin press minyak hidrolik', desc: 'Ekstraksi minyak dengan tekanan tinggi (40-60 MPa). Jantung garis produksi.' },
  { stage: '6', title: 'Filtrasi', equipment: 'Press filter, sentrifugal', desc: 'Buang partikel padat dan air dari minyak mentah.' },
  { stage: '7', title: 'Pengeringan', equipment: 'Pengering minyak, pemanas', desc: 'Turunkan kadar air hingga <0,1% untuk stabilitas masa simpan.' },
  { stage: '8', title: 'Pengemasan', equipment: 'Mesin pengisi, penutup, pelabel', desc: 'Kemas minyak dalam wadah akhir untuk ritel atau grosir.' },
];

const capacityOptions = [
  { scale: 'Workshop Rumah', capacity: '100-500 kg/hari', equipment: ['Press HN325', 'Penggoreng kecil', 'Filter manual', 'Peralatan tangan'] },
  { scale: 'Bisnis Kecil', capacity: '500-2000 kg/hari', equipment: ['Press HN365', 'Penggoreng putar', 'Sistem filter', 'Penggiling', 'Tangki penyimpanan'] },
  { scale: 'Pabrik Sedang', capacity: '2000-5000 kg/hari', equipment: ['Press HN426/HN480', 'Penggoreng lengkap', 'Sentrifugal', 'Garis lengkap', 'Otomasi'] },
  { scale: 'Industri Besar', capacity: '5000+ kg/hari', equipment: ['Multi press HN500', 'Penggoreng industri', 'Garis penyulingan lengkap', 'Otomasi lengkap'] },
];

const layoutTips = [
  { tip: 'Tata Alir', desc: 'Susun peralatan sesuai alur logis: bahan baku → pengolahan → pengemasan' },
  { tip: 'Perencanaan Ruang', desc: 'Sediakan ruang 2-3x luas peralatan untuk operasi dan perawatan' },
  { tip: 'Utilitas', desc: 'Rencanakan listrik, air, dan drainase sebelum instalasi' },
  { tip: 'Ventilasi', desc: 'Pasang ventilasi yang tepat untuk area penggorengan dan pemerasan' },
  { tip: 'Zona Keamanan', desc: 'Buat zona aman di sekitar peralatan bertekanan' },
];

const costAnalysis = [
  { item: 'Peralatan Inti (Press + Auxiliary)', percentage: '40-50%' },
  { item: 'Instalasi & Komisioning', percentage: '10-15%' },
  { item: 'Bangunan & Infrastruktur', percentage: '15-25%' },
  { item: 'Bahan Baku Awal', percentage: '5-10%' },
  { item: 'Modal Kerja', percentage: '10-15%' },
];

const maintenanceSchedule = [
  { frequency: 'Harian', tasks: ['Bersihkan peralatan', 'Periksa level oli hidrolik', 'Periksa filter', 'Periksa perangkat keamanan'] },
  { frequency: 'Mingguan', tasks: ['Ganti filter', 'Periksa tegangan sabuk', 'Periksa ruang pemerasan', 'Lumasi bagian yang bergerak'] },
  { frequency: 'Bulanan', tasks: ['Ganti oli hidrolik', 'Periksa selang hidrolik', 'Kalibrasi kontrol suhu', 'Periksa koneksi listrik'] },
  { frequency: 'Kuartalan', tasks: ['Inspeksi sistem lengkap', 'Ganti bagian aus', 'Uji sistem keamanan', 'Bersihkan tangki penyimpanan'] },
  { frequency: 'Tahunan', tasks: ['Overhaul sistem hidrolik', 'Ganti seal hidrolik', 'Inspeksi listrik lengkap', 'Perbarui catatan perawatan'] },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id/" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN LENGKAP</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Tim Teknik Haonuo</div>
            <div class="text-sm text-steel-500">Insinyur Produksi Senior · 15+ Tahun Pengalaman</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Seperti Apa Lini Produksi Minyak yang Lengkap</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Garis produksi minyak lengkap mengubah biji mentah menjadi minyak kemasan yang siap dipasarkan. Memahami proses penuh membantu Anda merencanakan, menganggarkan, dan mengoptimalkan operasi Anda.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Menyiapkan garis produksi lengkap adalah investasi signifikan namun dapat memberikan margin keuntungan 10-30% lebih tinggi dibanding menjual minyak mentah. Perencanaan yang matang sangat penting untuk keberhasilan.</p>
        </div>
      </section>

      <section id="stages" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Tahap-Tahap Lini Produksi Minyak, Dijelaskan</h2>
        <div class="space-y-4">
          {productionStages.map((stage, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{stage.stage}</div>
                {index < productionStages.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < productionStages.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{stage.title}</h3>
                <div class="bg-steel-50 p-4 rounded-lg">
                  <p class="text-amber-600 text-sm mb-1"><strong>Peralatan:</strong> {stage.equipment}</p>
                  <p class="text-steel-600 text-sm">{stage.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="capacity" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Memilih Kapasitas yang Tepat untuk Lini Produksi Minyak Anda</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {capacityOptions.map((option, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden shadow-md hover:shadow-lg transition-shadow">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-green-500 to-emerald-500' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-amber-500 to-orange-500' : 'bg-gradient-to-r from-purple-500 to-pink-500'}`}>
                <div class="flex justify-between items-center">
                  <h3 class="font-display text-lg text-white">{option.scale}</h3>
                  <span class="bg-white/20 text-white text-sm px-2 py-1 rounded">{option.capacity}</span>
                </div>
              </div>
              <div class="p-5">
                <p class="text-sm text-steel-500 mb-2">Peralatan Utama:</p>
                <ul class="space-y-1">
                  {option.equipment.map((equip, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                      {equip}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="layout" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Merencanakan Tata Letak Lini Produksi Minyak</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {layoutTips.map((tip, index) => (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-indigo-50 p-5 rounded-xl border border-blue-100">
              <h3 class="font-semibold text-blue-800 mb-2">{tip.tip}</h3>
              <p class="text-steel-700 text-sm">{tip.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="cost" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Berapa Biaya Sebuah Lini Produksi Minyak</h2>
        <p class="text-steel-700 mb-6">Rincian investasi khas untuk garis produksi minyak lengkap:</p>
        <div class="space-y-3">
          {costAnalysis.map((item, index) => (
            <div key={index} class="bg-white p-4 rounded-lg border border-steel-100 flex justify-between items-center">
              <span class="text-steel-700">{item.item}</span>
              <div class="flex items-center gap-3">
                <div class="w-32 bg-steel-100 rounded-full h-2">
                  <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-2 rounded-full" style={`width: ${parseInt(item.percentage)}%`}></div>
                </div>
                <span class="font-semibold text-amber-600 text-sm w-16 text-right">{item.percentage}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Menjaga Lini Produksi Minyak Tetap Berjalan</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {maintenanceSchedule.map((item, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 shadow-sm overflow-hidden">
              <div class={`p-3 ${index === 0 ? 'bg-green-100' : index === 1 ? 'bg-blue-100' : index === 2 ? 'bg-amber-100' : index === 3 ? 'bg-purple-100' : 'bg-red-100'}`}>
                <h3 class="font-semibold text-charcoal-900">{item.frequency}</h3>
              </div>
              <div class="p-4">
                <ul class="space-y-2">
                  {item.tasks.map((task, idx) => (
                    <li key={idx} class="text-steel-700 text-sm flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-steel-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      {task}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="line-balance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Menyeimbangkan Lini di Sekitar Press</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Lini hanya secepat stasiun paling lambatnya. Kesalahan umum adalah membeli press besar sementara roaster, crusher, atau filter dibiarkan kekurangan kapasitas — mesin mahal itu lalu menganggur sebagian setiap jam, menunggu biji atau tertahan oleh oli yang belum tersaring. Seimbangkan peralatan pendukung terhadap keluaran <em>puncak</em> press, karena sepuluh menit pertama setiap siklus melepaskan oli jauh lebih banyak daripada rata-rata sepanjang siklus.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li><strong>Kapasitas penyangraian</strong> setidaknya dua kali laju pengepresan, agar press tidak pernah menunggu biji yang sudah disangrai.</li>
            <li><strong>Penghancuran dan pengondisian</strong> harus sesuai dengan laju pengepresan dari jam ke jam.</li>
            <li><strong>Filtrasi</strong> harus mengikuti keluaran oli; bottleneck filter membuat oli mentah menumpuk di ruang press.</li>
            <li><strong>Tangki penyimpanan</strong> sebaiknya menampung setidaknya 3–5 hari produksi, memisahkan ritme pengepresan dari pengambilan truk.</li>
            <li><strong>Pembersihan</strong> berjalan dalam semburan singkat dan sebaiknya berkapasitas 1,5–2× laju input.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed mb-4">Ingat bahwa press panas dan dingin memiliki kapasitas yang sangat berbeda pada mesin yang sama. <a href="/id/products/standard-hydraulic-oil-press/" class="text-amber-600 hover:underline">HN325</a> dengan batch penuh 100 kg press panas kira-kira 900–1.000 kg per shift 8 jam dengan tabung press tunggal dan 1.200–1.400 kg dengan tabung press ganda; press dingin berjalan sekitar 300–400 kg tunggal atau 600–700 kg ganda karena setiap siklus memakan waktu sekitar dua jam alih-alih 30–40 menit. Sesuaikan ukuran lini dengan campuran produk yang benar-benar akan Anda jalankan.</p>
      </section>

      <section id="utilities" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Kebutuhan Utilitas</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Motor press hanya 2,2 kW, tetapi lini lengkap menarik daya jauh lebih besar. Sebelum menandatangani sewa atau memesan peralatan, pastikan pasokan tiga fase, total kVA, dan air di lokasi — kelalaian ini adalah penyebab paling umum keterlambatan commissioning.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-steel-100 rounded-lg">
            <thead class="bg-steel-100">
              <tr><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Peralatan</th><th class="px-4 py-3 text-left font-semibold text-charcoal-900">Daya tipikal</th></tr>
            </thead>
            <tbody class="divide-y divide-steel-100">
              <tr><td class="px-4 py-2">Press hidrolik</td><td class="px-4 py-2">2,2 kW (puncak ~3 kW)</td></tr>
              <tr><td class="px-4 py-2">Pembersih getar dan destoner</td><td class="px-4 py-2">1,5–3 kW</td></tr>
              <tr><td class="px-4 py-2">Roaster listrik</td><td class="px-4 py-2">15–40 kW (model gas mengurangi ini)</td></tr>
              <tr><td class="px-4 py-2">Crusher</td><td class="px-4 py-2">3–7,5 kW</td></tr>
              <tr><td class="px-4 py-2">Filter press</td><td class="px-4 py-2">1,5–3 kW</td></tr>
              <tr><td class="px-4 py-2">Konveyor dan pompa</td><td class="px-4 py-2">3–8 kW</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-steel-700 leading-relaxed mt-4 mb-2">Anggarkan 20–40 kVA untuk lini kecil atau menengah yang lengkap. Penggunaan air sederhana: sekitar 0,5–1 m³/hari untuk pembersihan dan uap di pabrik kecil, ditambah 2–5 m³/hari air pendingin resirkulasi di iklim panas. Gas atau kayu untuk roaster sering menjadi biaya energi operasional terbesar setelah biji, jadi bandingkan harga keduanya secara lokal sebelum memilih roaster listrik.</p>
      </section>

      <section id="implementation" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Urutan Implementasi</h2>
        <div class="space-y-3">
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">1</div><p class="text-steel-700 text-sm pt-1">Konfirmasi biji target, tonase harian, dan campuran produk panas versus dingin sebelum mengutip apa pun.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">2</div><p class="text-steel-700 text-sm pt-1">Kunci model press dan jumlah tabung press — ini menetapkan ukuran setiap stasiun lainnya.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">3</div><p class="text-steel-700 text-sm pt-1">Daftar peralatan pendukung dengan kapasitas yang disesuaikan dengan keluaran puncak press, bukan rata-rata.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">4</div><p class="text-steel-700 text-sm pt-1">Buat draf denah lantai dan konfirmasi tinggi plafon, daya, air, dan drainase.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">5</div><p class="text-steel-700 text-sm pt-1">Pesan dengan paket suku cadang dan panduan instalasi; jadwalkan pelatihan operator saat commissioning.</p></div>
          <div class="flex gap-4 items-start"><div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">6</div><p class="text-steel-700 text-sm pt-1">Mulai dengan satu biji, satu resep, dan catatan batch tertulis sebelum menambahkan bahan kedua.</p></div>
        </div>
        <p class="text-steel-700 leading-relaxed mt-4">Dalam anggaran total, press biasanya hanya menyumbang 35–45% dari belanja peralatan; pembersihan, penghancuran, penyangraian, filtrasi, konveyor, dan instalasi merupakan sisanya. Tambahkan pengiriman, bea masuk, jendela commissioning 30–45 hari, dan modal kerja biji. Karena biji biasanya 80–90% dari biaya per liter oli, disiplin rendemen yang dijelaskan dalam <a href="/id/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">panduan hasil oli</a> kami membayar kembali lebih cepat daripada diskon mesin apa pun.</p>
        <p class="text-steel-700 leading-relaxed mt-4">Bangun tata letak untuk pembersihan sekaligus produksi. Lantai miring yang dapat dicuci di dekat press dan filter, saluran pembuangan yang tidak tersumbat, dan jalur sapu bersih khusus antara penanganan biji dan bungkil menghemat satu jam tenaga kerja setiap hari kerja dan menjaga kelembapan serta kontaminasi dari sisi biji. Sisakan ruang untuk lini yang mungkin Anda tambahkan dalam dua tahun — posisi press kedua, filter tambahan, atau stasiun pengemasan botol — karena memperluas lini kecil yang ditata dengan baik itu murah, sementara retrofit lini yang sempit biasanya berarti membangunnya ulang.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Lini Produksi Minyak Anda: dari Rencana ke Batch Pertama</h2>
        <p class="text-steel-700 leading-relaxed">Garis produksi minyak lengkap adalah investasi bisnis yang kuat. Dengan merencanakan setiap tahap secara hati-hati dan bekerja sama dengan pemasok peralatan yang berpengalaman, Anda dapat membangun operasi produksi minyak yang menguntungkan dan berkelanjutan. Hubungi tim kami untuk desain garis produksi yang dipersonalisasi dan penawaran harga.</p>
      </section>
