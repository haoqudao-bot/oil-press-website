---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'crude-oil-filtration-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Panduan Filtrasi Minyak Mentah';
const description = resource?.data.description.id || 'Minyak bersih dan murni dari setiap pemerasan';
const seoKeywords = resource?.data.seoKeywords || ['filtrasi minyak', 'pemurnian minyak mentah', 'sistem filter minyak'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/filtration-guide-hero.webp',
  author: { '@type': 'Organization', name: 'Haonuo Engineering Team', url: 'https://www.hydoilpress.com/about' },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/crude-oil-filtration-guide' },
  ],
};

const filtrationImportance = [
  { icon: 'shield', title: 'Buang Kotoran', desc: 'Hilangkan partikel padat, air, dan kontaminan' },
  { icon: 'star', title: 'Tingkatkan Kualitas', desc: 'Minyak lebih jernih dan murni dengan tampilan lebih baik' },
  { icon: 'trending-up', title: 'Nilai Lebih Tinggi', desc: 'Minyak bersih memiliki harga pasar premium' },
  { icon: 'clock', title: 'Masa Simpan Lebih Lama', desc: 'Cegah oksidasi dan ketengikan' },
  { icon: 'flask', title: 'Rasa Lebih Baik', desc: 'Buang senyawa pahit dan endapan' },
];

const filtrationMethods = [
  { name: 'Filtrasi Gravitasi', pros: ['Sederhana, tidak perlu daya', 'Biaya rendah', 'Bagus untuk batch kecil'], cons: ['Proses lambat', 'Tidak sepenuhnya efektif', 'Butuh ruang besar'], bestFor: 'Produksi rumahan, batch kecil < 20L' },
  { name: 'Filtrasi Tekanan', pros: ['Proses cepat', 'Penghilangan efektif', 'Desain kompak'], cons: ['Butuh pompa', 'Perlu kartrid filter'], bestFor: 'Workshop kecil hingga menengah, batch 20-200L' },
  { name: 'Filtrasi Vakum', pros: ['Sangat cepat', 'Kemurnian tinggi', 'Bisa menangani volume besar'], cons: ['Setup lebih kompleks', 'Biaya lebih tinggi'], bestFor: 'Produksi komersial, batch 200L+' },
  { name: 'Pemisahan Sentrifugal', pros: ['Sangat cepat', 'Buang air dan padatan', 'Tanpa bahan habis filter'], cons: ['Biaya awal tinggi', 'Butuh listrik'], bestFor: 'Operasi komersial besar' },
];

const stepByStep = [
  { step: '1', title: 'Pengendapan', desc: 'Biarkan minyak mentah diam di tangki selama 24-48 jam. Air dan padatan berat mengendap di dasar.' },
  { step: '2', title: 'Pra-Filtrasi', desc: 'Lewatkan minyak melalui filter kasar (50-100 mikron) untuk buang partikel besar.' },
  { step: '3', title: 'Filtrasi Utama', desc: 'Filter melalui filter halus (5-20 mikron) untuk buang endapan halus.' },
  { step: '4', title: 'Pemolesan', desc: 'Opsional: filter melalui karbon aktif atau tanah pemutih untuk minyak jernih kristal.' },
  { step: '5', title: 'Pengeringan', desc: 'Panaskan minyak hingga 80-90°C untuk buang sisa air (untuk penyimpanan jangka panjang).' },
  { step: '6', title: 'Pengujian Akhir', desc: 'Periksa kejernihan, kadar air, dan kemurnian sebelum pengemasan.' },
];

const filterSelection = [
  { filter: 'Filter Kertas', micron: '5-20', life: 'Sekali pakai atau 10-50L', cost: 'Hubungi untuk harga', use: 'Paling umum, bagus untuk rumahan/workshop kecil' },
  { filter: 'Mesh Logam', micron: '50-100', life: 'Bisa digunakan kembali (dibersihkan)', cost: 'Hubungi untuk harga', use: 'Pra-filtrasi, penghilangan kasar' },
  { filter: 'Sentrifugal', micron: '0.1-5', life: 'Permanen', cost: 'Hubungi untuk harga', use: 'Produksi komersial, volume tinggi' },
  { filter: 'Cross-flow Filter', micron: '1-10', life: 'Bisa digunakan kembali', cost: 'Hubungi untuk harga', use: 'Produksi menengah hingga besar' },
];

const qualityChecks = [
  { test: 'Kejernihan Visual', method: 'Arahkan minyak ke cahaya - harus jernih, tanpa endapan terlihat', standard: 'Tidak ada partikel terlihat' },
  { test: 'Kadar Air', method: 'Gunakan pengukur air atau uji panas', standard: '< 0,1% air' },
  { test: 'Rasa & Aroma', method: 'Cium dan rasakan sampel', standard: 'Rasa dan aroma bersih segar' },
  { test: 'Tingkat pH', method: 'Gunakan strip atau pengukur pH', standard: 'pH 6-7 (netral)' },
];

const storageTips = [
  'Simpan minyak yang sudah difiltrasi dalam botol kaca gelap bersih',
  'Jauhkan dari sinar matahari langsung',
  'Gunakan hanya wadah food-grade',
  'Sisakan ruang kosong di wadah untuk mencegah oksidasi',
  'Beri label dengan tanggal produksi dan jenis minyak',
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id/" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-amber-50 to-orange-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-amber-500/10 text-amber-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN PENGOLAHAN</span>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
      <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
      <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-500/10 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="text-left">
            <div class="font-semibold text-charcoal-900">Tim Teknik Haonuo</div>
            <div class="text-sm text-steel-500">Insinyur Pengolahan Minyak · 15+ Tahun Pengalaman</div>
          </div>
        </div>
        <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Filtrasi Minyak Mentah: Langkah yang Menjual Minyak Anda</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Filtrasi minyak mentah adalah langkah kritis dalam produksi minyak yang memisahkan minyak hasil ekstraksi dari partikel padat, air, dan kotoran lainnya. Filtrasi yang tepat mengubah minyak mentah hasil pemerasan menjadi produk berharga yang siap dipasarkan.</p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-lg my-6">
          <p class="text-steel-700 italic"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Setelah pemerasan, minyak mentah biasanya mengandung 2-5% partikel padat dan 0,5-2% air. Filtrasi menghilangkan kotoran ini untuk menghasilkan minyak bersih yang siap dipasarkan.</p>
        </div>
      </section>

      <section id="importance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Mengapa Filtrasi Penting</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filtrationImportance.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  {item.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
                  {item.icon === 'star' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
                  {item.icon === 'trending-up' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                  {item.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                  {item.icon === 'flask' && <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3h6M10 3v18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3"/><path d="M14 3v18a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V3"/></svg>}
                </div>
                <div>
                  <h3 class="font-semibold text-charcoal-900 mb-1">{item.title}</h3>
                  <p class="text-steel-600 text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="methods" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Perbandingan Metode Filtrasi</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {filtrationMethods.map((method, index) => (
            <div key={index} class="bg-white rounded-xl border border-steel-100 overflow-hidden hover:shadow-lg transition-all duration-300">
              <div class={`p-4 ${index === 0 ? 'bg-gradient-to-r from-gray-500 to-gray-600' : index === 1 ? 'bg-gradient-to-r from-blue-500 to-cyan-500' : index === 2 ? 'bg-gradient-to-r from-purple-500 to-pink-500' : 'bg-gradient-to-r from-green-500 to-emerald-500'}`}>
                <h3 class="font-display text-lg text-white">{method.name}</h3>
              </div>
              <div class="p-5">
                <div class="grid grid-cols-3 gap-3">
                  <div class="bg-green-50 p-3 rounded-lg">
                    <p class="text-xs text-green-600 mb-1">Kelebihan</p>
                    {method.pros.map((pro, idx) => <p key={idx} class="text-xs text-steel-700">+ {pro}</p>)}
                  </div>
                  <div class="bg-red-50 p-3 rounded-lg">
                    <p class="text-xs text-red-600 mb-1">Kekurangan</p>
                    {method.cons.map((con, idx) => <p key={idx} class="text-xs text-steel-700">- {con}</p>)}
                  </div>
                  <div class="bg-blue-50 p-3 rounded-lg">
                    <p class="text-xs text-blue-600 mb-1">Cocok Untuk</p>
                    <p class="text-xs text-steel-700">{method.bestFor}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="step-by-step" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Proses Filtrasi Langkah demi Langkah</h2>
        <div class="space-y-4">
          {stepByStep.map((step, index) => (
            <div key={index} class="flex gap-5">
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">{step.step}</div>
                {index < stepByStep.length - 1 && <div class="w-0.5 h-full bg-steel-200 mt-2"></div>}
              </div>
              <div class={index < stepByStep.length - 1 ? 'pb-6' : ''}>
                <h3 class="font-semibold text-xl mb-2 text-charcoal-900">{step.title}</h3>
                <p class="text-steel-600">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="filter-selection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Panduan Pemilihan Media Filter</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl border border-steel-100 shadow-md">
            <thead class="bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
              <tr>
                <th class="px-4 py-3 text-left font-semibold">Jenis Filter</th>
                <th class="px-4 py-3 text-left font-semibold">Rating Mikron</th>
                <th class="px-4 py-3 text-left font-semibold">Masa Pakai</th>
                <th class="px-4 py-3 text-left font-semibold">Biaya</th>
                <th class="px-4 py-3 text-left font-semibold">Penggunaan Direkomendasikan</th>
              </tr>
            </thead>
            <tbody>
              {filterSelection.map((item, index) => (
                <tr key={index} class={index % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                  <td class="px-4 py-3 font-semibold text-charcoal-900">{item.filter}</td>
                  <td class="px-4 py-3 text-blue-600">{item.micron}</td>
                  <td class="px-4 py-3">{item.life}</td>
                  <td class="px-4 py-3 text-green-600">{item.cost}</td>
                  <td class="px-4 py-3 text-steel-600 text-sm">{item.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="quality-checks" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Pemeriksaan Kualitas Setelah Filtrasi Minyak Mentah</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {qualityChecks.map((check, index) => (
            <div key={index} class="bg-gradient-to-br from-green-50 to-emerald-50 p-5 rounded-xl border border-green-100">
              <h3 class="font-semibold text-green-800 mb-2">{check.test}</h3>
              <p class="text-steel-700 text-sm mb-2"><strong>Metode:</strong> {check.method}</p>
              <p class="text-green-700 text-sm"><strong>Standar:</strong> {check.standard}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="storage" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Penyimpanan yang Benar Setelah Filtrasi</h2>
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <ul class="space-y-3">
            {storageTips.map((tip, index) => (
              <li key={index} class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-steel-700">{tip}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="filter-press-operation" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Pengoperasian Plate-and-Frame: Tekanan dan Ketebalan Bungkil</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Filter press plate-and-frame adalah pekerja utama pabrik kecil dan menengah karena menghilangkan partikel halus secara tajam dan menghasilkan bungkil kering yang mudah ditangani. Hasilnya bergantung pada tiga variabel: tekanan umpan, kondisi kain filter, dan kapan siklus dihentikan. Pompa pada tekanan rendah lebih dulu untuk membangun pre-coat padatan yang merata pada kain, lalu naikkan ke tekanan kerja — memulai langsung dengan tekanan tinggi akan memadatkan partikel halus ke dalam kain dan membutakannya dalam beberapa siklus.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Aturan praktis pengoperasian</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li>Bentuk bungkil secara bertahap; hentikan ketika aliran filtrat turun menjadi tetesan alih-alih terus berjalan hanya dengan tekanan.</li>
            <li>Targetkan bungkil yang padat dan kering setebal 20–30 mm per ruang; bungkil basah tipis berarti siklus berakhir terlalu cepat atau kain filter membuta.</li>
            <li>Cuci kain dengan air hangat antar batch dan ganti kain segera setelah filtrat konsisten keruh — filtrat keruh berarti kain robek atau aliran bypass, bukan "endapan alami halus".</li>
            <li>Jaga set kain tetap cocok menurut usianya; mencampur kain baru dan melar menyebabkan pembebanan plate tidak merata dan kebocoran frame.</li>
          </ul>
        </div>
      </section>

      <section id="sizing-filtration" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Menyesuaikan Ukuran Filtrasi dengan Keluaran Press</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Filtrasi harus menyerap aliran puncak press — menit-menit pertama setiap siklus pengepresan melepaskan sebagian besar oli — sambil mengikuti tonase hariannya. Filter yang berukuran untuk keluaran "rata-rata" membuat minyak mentah menumpuk di ruang press dan menggoda operator untuk mengemas minyak keruh alih-alih menunggu. Aturan praktisnya adalah kapasitas filter sekitar 1,5–2× keluaran oli rata-rata per jam press, ditambah tangki pengendapan atau buffer antara press dan filter agar batch datang dengan umpan yang stabil dan sudah mengendap.</p>
        <p class="text-steel-700 leading-relaxed">Untuk bengkel kelas HN325 yang menghasilkan 30–80 L oli per jam pengepresan aktual, mesin filter oli pneumatik kecil — filter press plate-and-frame — dipasangkan dengan tangki pengendapan 200–500 L biasanya menjaga lini tetap seimbang di seluruh batch press panas; oli cold-press mengalir lebih lambat dan partikel halus lebih mudah mengendap, tetapi kurang toleran terhadap sedimen sisa di botol. Jika ragu, lebihkan ukuran sisi filter — biayanya kecil relatif terhadap press, dan bottleneck filtrasi membuat mesin termahal di gedung itu menganggur.</p>
      </section>

      <section id="troubleshooting-consumables" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Pemecahan Masalah dan Biaya Bahan Habis Pakai</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Kesalahan filtrasi mengumumkan dirinya melalui tiga gejala. Oli keruh atau kembali keruh setelah filtrat awalnya bening berarti kain bypass atau plate retak. Siklus lambat dengan tekanan tinggi berarti kain membuta, padatan terlalu halus akibat penghancuran berlebihan, atau oli terlalu dingin — menghangatkan minyak mentah dengan lembut hingga 35–45 °C menurunkan viskositas secara dramatis tanpa merusak minyak. Oli yang tampak bening tetapi mengendapkan sedimen di botol setelah beberapa hari menunjuk pada polishing halus yang tidak memadai setelah filter utama; satu lintasan kedua melalui kain lebih halus atau filter polish menyelesaikannya.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Anggarkan kain filter sebagai bahan habis pakai rutin: harganya murah, biaya per liternya dapat diabaikan, dan menjalankannya sampai rusak memakan lebih banyak oli yang hilang daripada biaya penggantian.</li>
          <li>Simpan satu set kain cadangan dan satu set seal dalam stok; kain robek adalah penyebab stop lini tak terencana paling umum setelah press itu sendiri.</li>
          <li>Jangan pernah mengembalikan lumpur tangki pengendapan langsung ke botol; saring ulang atau jual sebagai minyak mentah, karena sedimen di botol memicu retur dan menghancurkan merek premium.</li>
        </ul>
        <p class="text-steel-700 leading-relaxed">Minyak bersih menyimpan lebih lama, berharga lebih tinggi, dan memfilter reputasi setiap proses lain di pabrik — disiplin hulu <a href="/id/resources/how-to-maximize-oil-yield/" class="text-amber-600 hover:underline">memaksimalkan hasil</a> hanya menjadi uang setelah oli mencapai botol dengan bening dan stabil.</p>
        <p class="text-steel-700 leading-relaxed mt-4">Standarkan siklus dengan prosedur tertulis alih-alih penilaian operator: waktu pump-up, tekanan kerja, sinyal akhir siklus, rutinitas pencucian kain, dan pemeriksaan kejernihan harian terhadap sampel botol berlabel. Filtrasi adalah gerbang kualitas terakhir di gedung, dan gerbang yang bergantung pada siapa yang sedang shift, cepat atau lambat, adalah gerbang yang gagal.</p>
