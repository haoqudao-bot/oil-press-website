---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'oil-press-machine-india-selection-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || resource?.data.title.en || 'Panduan Pemilihan Mesin Press Minyak untuk India';
const description = resource?.data.description.id || resource?.data.description.en || 'Panduan lengkap untuk pabrik minyak baru di India';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/id' },
    { '@type': 'ListItem', position: 2, name: t.resources.title, item: 'https://www.hydoilpress.com/id/resources' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/oil-press-machine-india-selection-guide' },
  ],
};
---

<BaseLayout locale="id" title={title} description={description} jsonLd={[breadcrumbLd]}>
<section class="bg-steel-50 py-4 border-b border-steel-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-2 text-sm text-steel-500">
      <a href="/id/" class="hover:text-amber-500 transition-colors">{t.nav.home}</a>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <a href="/id/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="text-charcoal-900 font-semibold">Panduan India</span>
    </nav>
  </div>
</section>

<section class="bg-gradient-to-br from-steel-900 to-steel-800 py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="inline-block bg-amber-500 text-charcoal-900 text-xs font-semibold px-3 py-1 rounded-full mb-4">Panduan Pasar India</div>
    <h1 class="font-display text-3xl md:text-4xl text-white mb-4">{title}</h1>
    <p class="text-steel-300 text-lg">Panduan keputusan lengkap untuk pabrik minyak kecil &amp; menengah di India — biji minyak, kapasitas harian, Kachi Ghani vs pengepresan panas, tegangan 415V/50Hz, pengiriman pelabuhan.</p>
    <p class="text-steel-500 text-sm mt-4">Panduan ini khusus untuk pasar India. Pembaca Indonesia yang menargetkan pasar lain disarankan membaca panduan pembelian umum.</p>
  </div>
</section>

<!-- Oilseed cards (ID) -->
<section class="py-12 bg-white border-b border-steel-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl text-charcoal-900 mb-6">1. Biji minyak dan pembeli Anda</h2>
    <div class="space-y-4">
      <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
        <h3 class="font-display text-xl text-charcoal-900 mb-2">🟡 Mustar / Rapeseed — India Utara</h3>
        <p class="text-steel-600 text-sm">Minyak masak paling banyak dikonsumsi (~ 5,5 juta ton / tahun). Rajasthan, Uttar Pradesh, Haryana, Benggala Barat. Produk "Kachi Ghani" (pengepresan dingin, rasa tajam) mendapatkan premium ₹20–30 / L.</p>
        <div class="flex flex-wrap gap-2 text-xs mt-3">
          <span class="bg-white border border-steel-200 px-3 py-1 rounded-full">Yield dingin : 30–38 %</span>
          <span class="bg-white border border-steel-200 px-3 py-1 rounded-full">Yield panas : 33–41 %</span>
        </div>
      </div>
      <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
        <h3 class="font-display text-xl text-charcoal-900 mb-2">🥜 Kacang Tanah — India Barat &amp; Selatan</h3>
        <p class="text-steel-600 text-sm">Gujarat (produsen terbesar), Maharashtra, Tamil Nadu. Rasa lembut, harga stabil.</p>
        <div class="flex flex-wrap gap-2 text-xs mt-3">
          <span class="bg-white border border-steel-200 px-3 py-1 rounded-full">Yield : 38–45 %</span>
        </div>
      </div>
      <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
        <h3 class="font-display text-xl text-charcoal-900 mb-2">🌴 Kelapa — Kerala</h3>
        <p class="text-steel-600 text-sm">Virgin Coconut Oil (VCO) pengepresan dingin, premium. Yield tinggi 55–65 %. Disarankan kontak baja tahan karat 304.</p>
        <div class="flex flex-wrap gap-2 text-xs mt-3">
          <span class="bg-white border border-steel-200 px-3 py-1 rounded-full">Yield : 55–65 %</span>
        </div>
      </div>
      <div class="bg-steel-50 rounded-xl p-6 border border-steel-100">
        <h3 class="font-display text-xl text-charcoal-900 mb-2">🌿 Wijen — Niche premium</h3>
        <p class="text-steel-600 text-sm">Tamil Nadu, Karnataka, Gujarat. "Minyak til" premium untuk Ayurveda dan kosmetik.</p>
        <div class="flex flex-wrap gap-2 text-xs mt-3">
          <span class="bg-white border border-steel-200 px-3 py-1 rounded-full">Yield : 42–50 %</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Capacity table (ID) -->
<section class="py-12 bg-steel-50 border-b border-steel-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl text-charcoal-900 mb-6">2. Kapasitas harian — model rekomendasi</h2>
    <p class="text-steel-600 text-sm mb-4">Biji bersih, pengepresan panas, 8 jam / hari. Pengepresan dingin : siklus ~ 2 jam — sekitar setengah volume harian ; premium Kachi Ghani mengompensasi.</p>
    <div class="overflow-x-auto bg-white rounded-2xl border border-steel-200 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-steel-900 text-white">
          <tr>
            <th class="px-4 py-3 text-left font-semibold">Throughput harian</th>
            <th class="px-4 py-3 text-left font-semibold">Minyak / hari</th>
            <th class="px-4 py-3 text-left font-semibold">Model Haonuo</th>
            <th class="px-4 py-3 text-left font-semibold">Catatan</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-steel-100">
          <tr class="bg-steel-50/50"><td class="px-4 py-3">500 – 800 kg</td><td class="px-4 py-3">150 – 300 L</td><td class="px-4 py-3 text-amber-700 font-medium">HN325 tabung tunggal</td><td class="px-4 py-3 text-steel-600">Model terkecil kami kirim</td></tr>
          <tr><td class="px-4 py-3">800 – 1,200 kg</td><td class="px-4 py-3">250 – 450 L</td><td class="px-4 py-3 text-amber-700 font-medium">HN325 panas</td><td class="px-4 py-3 text-steel-600">Siklus 35–45 menit / batch</td></tr>
          <tr class="bg-steel-50/50"><td class="px-4 py-3">1,500 – 2,500 kg</td><td class="px-4 py-3">450 – 800 L</td><td class="px-4 py-3 text-amber-700 font-medium">HN365 ganda</td><td class="px-4 py-3 text-steel-600">Dua tabung bergantian</td></tr>
          <tr><td class="px-4 py-3">> 2,500 kg</td><td class="px-4 py-3">> 800 L</td><td class="px-4 py-3 text-amber-700 font-medium">Hubungi kami</td><td class="px-4 py-3 text-steel-600">Butuh lini produksi lengkap</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Kachi vs Hot (ID) -->
<section class="py-12 bg-white border-b border-steel-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl text-charcoal-900 mb-6">3. Kachi Ghani (pengepresan dingin) vs pengepresan panas</h2>
    <p class="text-steel-600 text-sm mb-4">Mesin yang sama bisa keduanya — hanya persiapan bijinya yang berubah.</p>
    <div class="overflow-x-auto bg-steel-50 rounded-2xl border border-steel-200">
      <table class="w-full text-sm">
        <thead class="bg-steel-200">
          <tr><th class="px-3 py-2 text-left">Fitur</th><th class="px-3 py-2 text-left">Kachi Ghani</th><th class="px-3 py-2 text-left">Pengepresan Panas</th></tr>
        </thead>
        <tbody class="divide-y divide-steel-200 text-steel-700">
          <tr><td class="px-3 py-2 font-medium">Pra-perlakuan</td><td class="px-3 py-2">Tidak ada</td><td class="px-3 py-2">Kukus 10–15 menit</td></tr>
          <tr><td class="px-3 py-2 font-medium">Suhu</td><td class="px-3 py-2">≤ 60 °C</td><td class="px-3 py-2">~ 80 °C</td></tr>
          <tr><td class="px-3 py-2 font-medium">Yield mustar</td><td class="px-3 py-2">30–38 %</td><td class="px-3 py-2">33–41 %</td></tr>
          <tr><td class="px-3 py-2 font-medium">Rasa</td><td class="px-3 py-2">Tajam, aromatik</td><td class="px-3 py-2">Lembut, ringan</td></tr>
          <tr><td class="px-3 py-2 font-medium">Premium ritel</td><td class="px-3 py-2">₹20–30 / L</td><td class="px-3 py-2">Dekati minyak rafinasi</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Local specs (ID) -->
<section class="py-12 bg-steel-50 border-b border-steel-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl text-charcoal-900 mb-6">4. Spesifik Pasar India</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-steel-600">
      <div class="bg-white rounded-xl p-5 border border-steel-200">
        <strong class="text-charcoal-900">Tegangan :</strong> 415V / 50Hz tiga fase — gratis untuk India. Motor 2.2 kW.
      </div>
      <div class="bg-white rounded-xl p-5 border border-steel-200">
        <strong class="text-charcoal-900">Pelabuhan :</strong> Mundra / Nhava Sheva (Mumbai) 18–22 hari. Kolkata 25–30 hari. Chennai 20–25 hari.
      </div>
      <div class="bg-white rounded-xl p-5 border border-steel-200">
        <strong class="text-charcoal-900">Dokumen :</strong> Faktur komersial, BL, daftar pengepakan, sertifikat asal. Kode HS 8479.82.
      </div>
      <div class="bg-white rounded-xl p-5 border border-steel-200">
        <strong class="text-charcoal-900">Layanan purna jual :</strong> Dukungan WhatsApp gratis untuk operasi pertama. Suku cadang DHL 48 jam.
      </div>
    </div>
  </div>
</section>

<!-- Budget (ID) -->
<section class="py-12 bg-white border-b border-steel-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl text-charcoal-900 mb-4">5. Anggaran — referensi operasional India</h2>
    <p class="text-steel-600 text-sm mb-4">Kami tidak mempublikasikan daftar harga FOB publik. Angka di bawah adalah benchmark operasional : ampas minyak (residu setelah pengepresan) dijual di India sebagai pakan ternak, mengompensasi <strong>15–25 % dari biaya pembelian biji</strong>. Hitung ROI Anda pada kalkulator ROI online kami.</p>
    <div class="bg-steel-50 rounded-xl p-5 border border-steel-200 text-sm text-steel-700 space-y-2">
      <li><strong>Listrik (2.2 kW, 200 jam / bulan) :</strong> ₹1.800 – 2.500</li>
      <li><strong>Gaji operator :</strong> ₹15.000 – 22.000 / bulan</li>
      <li><strong>Perawatan &amp; suku cadang :</strong> ₹2.000 – 3.500 / bulan</li>
      <li><strong>Pembelian biji :</strong> 85 % dari biaya variabel — <em>gunakan harga mandi lokal</em></li>
    </div>
  </div>
</section>

<!-- Boundary (ID) -->
<section class="py-12 bg-amber-50 border-b border-amber-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl text-charcoal-900 mb-4">6. Apa yang TIDAK disediakan Haonuo</h2>
    <div class="bg-white rounded-xl p-6 border border-amber-200 text-steel-700 space-y-3 text-sm">
      <div><strong class="text-red-600">✕</strong> Mesin pengepres sekrup 6-bolt / 9-bolt</div>
      <div><strong class="text-red-600">✕</strong> Kolhu / ghani tradisional (tangan atau hewan)</div>
      <div><strong class="text-red-600">✕</strong> Mesin pengepres meja atau penggunaan rumah tangga</div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-14 bg-steel-900 text-center">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="font-display text-2xl text-white mb-3">Butuh rekomendasi spesifik?</h2>
    <p class="text-steel-300 mb-6 text-sm">Biji, kapasitas harian, pelabuhan — insinyur balas dalam 24 jam dengan model, penawaran, dan estimasi pengiriman.</p>
    <a href="/id/contact/" class="inline-flex items-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-6 py-3 rounded-lg hover:bg-amber-400 transition-colors">
      Minta Penawaran Pabrik →
    </a>
  </div>
</section>
</BaseLayout>
