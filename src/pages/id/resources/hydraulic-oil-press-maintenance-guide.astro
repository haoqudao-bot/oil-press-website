---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const resource = resources.find(r => r.slug === 'hydraulic-oil-press-maintenance-guide');
const t = getTranslations('id');

const title = resource?.data.title.id || 'Perawatan Pengepres Minyak Hidrolik';
const description = resource?.data.description.id || 'Panduan perawatan yang lengkap';
const seoKeywords = resource?.data.seoKeywords || ['perawatan pengepres minyak hidrolik', 'servis pengepres minyak'];
const publishedAt = resource?.data.publishedAt || new Date();
const updatedAt = resource?.data.updatedAt || publishedAt;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: 'https://www.hydoilpress.com/images/maintenance-guide-hero.webp',
  author: { '@type': 'Person', name: 'Eason', jobTitle: 'Senior Hydraulic Press Engineer', url: 'https://www.hydoilpress.com/about/', worksFor: { '@type': 'Organization', name: 'Shandong Haonuo Machinery Equipment Group Co., Ltd.', url: 'https://www.hydoilpress.com' } },
  publisher: { '@type': 'Organization', name: 'Haonuo Machinery', logo: { '@type': 'ImageObject', url: 'https://www.hydoilpress.com/apple-touch-icon.png' } },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  keywords: seoKeywords.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.hydoilpress.com/id/' },
    { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: 'https://www.hydoilpress.com/id/resources/' },
    { '@type': 'ListItem', position: 3, name: title, item: 'https://www.hydoilpress.com/id/resources/hydraulic-oil-press-maintenance-guide/' },
  ],
};

const maintenanceSchedule = [
  { frequency: 'Harian', tasks: ['Bersihkan mesin dan area sekitar', 'Periksa level oli dalam sistem hidrolik', 'Periksa ruang pengepres dari sisa residu', 'Verifikasi perangkat pengaman berfungsi'] },
  { frequency: 'Mingguan', tasks: ['Bersihkan filter tangki oli hidrolik', 'Periksa koneksi hidrolik untuk kebocoran', 'Periksa koneksi listrik', 'Lumasi bagian yang bergerak'] },
  { frequency: 'Bulanan', tasks: ['Periksa kualitas oli hidrolik', 'Periksa segel dan gasket', 'Ukur pengukur tekanan', 'Kalibrasi sensor suhu'] },
  { frequency: 'Triwulan', tasks: ['Ganti oli hidrolik (setiap 2.000 jam)', 'Periksa silinder hidrolik', 'Periksa rangka dan komponen struktural', 'Ukur fungsi penghentian darurat'] },
];

const hydraulicSystem = [
  { title: 'Manajemen Oli Hidrolik', items: ['Gunakan oli hidrolik ISO VG 46', 'Jaga suhu yang tepat (30-50°C)', 'Ganti oli setiap 2.000 jam operasi', 'Kapasitas: HN325/HN365: 30-40 liter, HN500: 50-60 liter'] },
  { title: 'Perawatan Silinder Hidrolik', items: ['Jaga batang silinder tetap bersih', 'Lindungi dari debu dan puing', 'Periksa segel untuk keausan', 'Ganti jika bocor'] },
  { title: 'Perawatan Filter Hidrolik', items: ['Bersihkan setiap 50-100 jam operasi', 'Ganti jika rusak atau terlalu kotor', 'Gunakan filter pengganti Haonuo asli'] },
];

const electricalSystem = [
  { title: 'Pemeriksaan Sumber Daya', items: ['Verifikasi tegangan input', 'Periksa fluktuasi tegangan', 'Gunakan pelindung lonjakan'] },
  { title: 'Perawatan Motor', items: ['Periksa rumah motor dari kerusakan', 'Periksa kipas dan sistem pendingin', 'Bersihkan sirip pendingin secara teratur'] },
  { title: 'Perawatan Panel Kontrol', items: ['Bersihkan debu dari panel', 'Periksa fungsi tombol', 'Kencangkan koneksi terminal'] },
];

const troubleshooting = [
  { problem: 'Tekanan Rendah', causes: ['Level oli hidrolik rendah', 'Oli terkontaminasi', 'Pompa aus', 'Segel bocor'], solutions: ['Tambahkan oli', 'Saring atau ganti oli', 'Periksa pompa', 'Ganti segel'] },
  { problem: 'Siklus Pengepresan Lambat', causes: ['Suhu oli hidrolik rendah', 'Filter kotor', 'Pompa aus', 'Tegangan rendah'], solutions: ['Panaskan sistem', 'Bersihkan filter', 'Periksa pompa', 'Periksa sumber daya'] },
  { problem: 'Kebocoran Oli', causes: ['Segel aus', 'Koneksi longgar', 'Selang rusak'], solutions: ['Ganti segel', 'Kencangkan koneksi', 'Ganti selang'] },
  { problem: 'Mesin Tidak Bisa Menyala', causes: ['Tidak ada daya', 'Penghentian darurat aktif', 'Pengaman terbuka'], solutions: ['Periksa sumber daya', 'Atur ulang penghentian darurat', 'Tutup pengaman'] },
];

const spareParts = [
  { name: 'Elemen filter oli hidrolik', stock: 'Kritis' },
  { name: 'Segel dan gasket', stock: 'Kritis' },
  { name: 'Selang hidrolik', stock: 'Aus' },
  { name: 'Piringan pengepres', stock: 'Aus' },
  { name: 'Cincin-O', stock: 'Habis Pakai' },
];
---

<BaseLayout title={title} description={description} keywords={seoKeywords} jsonLd={[articleLd, breadcrumbLd]} locale="id">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/id/" class="hover:text-amber-500 transition-colors">Beranda</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/id/resources/" class="hover:text-amber-500 transition-colors">{t.resources.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold line-clamp-1">{title}</span>
      </nav>
    </div>
  </section>

  <section class="bg-gradient-to-br from-green-50 to-emerald-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="inline-block bg-green-500/10 text-green-600 px-4 py-1 rounded-full text-sm font-semibold mb-6">PANDUAN PERAWATAN</span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-charcoal-900 mb-6 leading-tight">{title.toUpperCase()}</h1>
        <p class="text-xl text-steel-600 mb-8 leading-relaxed">{description}</p>
        <div class="flex flex-wrap justify-center items-center gap-6 text-steel-600">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-green-500/10 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-charcoal-900">Tim Teknik Haonuo</div>
              <div class="text-sm text-steel-500">Insinyur Senior Pengepres Minyak · 15+ Tahun Pengalaman</div>
            </div>
          </div>
          <div class="h-8 w-px bg-steel-300 hidden md:block"></div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{publishedAt.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section id="introduction" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Mengapa Perawatan Mesin Press Minyak Hidrolik Menguntungkan</h2>
        <p class="text-steel-700 leading-relaxed">Perawatan yang tepat sangat penting untuk memastikan kinerja dan keandalan jangka panjang pengepres minyak hidrolik Anda.</p>
      </section>

      <section id="maintenance-schedule" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Jadwal Perawatan untuk Mesin Press Minyak Hidrolik Anda</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {maintenanceSchedule.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${index === 0 ? 'bg-red-100 text-red-600' : index === 1 ? 'bg-orange-100 text-orange-600' : index === 2 ? 'bg-blue-100 text-blue-600' : 'bg-green-100 text-green-600'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                </div>
                <h3 class="font-semibold text-lg text-charcoal-900">{item.frequency}</h3>
              </div>
              <ul class="space-y-2">
                {item.tasks.map((task, idx) => (
                  <li key={idx} class="flex items-center gap-2 text-steel-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    {task}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="hydraulic-system" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Perawatan Sistem Hidrolik</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {hydraulicSystem.map((item, index) => (
            <div key={index} class="bg-blue-50 p-5 rounded-xl border border-blue-200">
              <h3 class="font-semibold text-blue-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm">{task}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="electrical-system" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Perawatan Sistem Listrik</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {electricalSystem.map((item, index) => (
            <div key={index} class="bg-purple-50 p-5 rounded-xl border border-purple-200">
              <h3 class="font-semibold text-purple-800 mb-3">{item.title}</h3>
              <ul class="space-y-2">
                {item.items.map((task, idx) => (
                  <li key={idx} class="text-steel-700 text-sm">{task}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="safety-maintenance" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Pemeriksaan Keselamatan yang Melindungi Operator Press Anda</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="bg-red-50 p-5 rounded-xl border border-red-200">
            <h3 class="font-semibold text-red-800 mb-4">Sistem Darurat</h3>
            <ul class="space-y-2">
              <li class="text-steel-700">• Uji penghentian darurat setiap bulan</li>
              <li class="text-steel-700">• Pastikan respons cepat</li>
              <li class="text-steel-700">• Ganti jika rusak</li>
            </ul>
          </div>
          <div class="bg-orange-50 p-5 rounded-xl border border-orange-200">
            <h3 class="font-semibold text-orange-800 mb-4">Prosedur Penguncian/Penandaan</h3>
            <ol class="space-y-1 list-decimal list-inside text-steel-700 text-sm">
              <li>Matikan daya</li>
              <li>Kunci saklar daya</li>
              <li>Pasang label "Jangan Dioperasikan"</li>
              <li>Verifikasi daya mati</li>
              <li>Lakukan perawatan</li>
            </ol>
          </div>
        </div>
      </section>

      <section id="troubleshooting" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Mengatasi Masalah Umum Mesin Press Minyak Hidrolik</h2>
        <div class="space-y-6">
          {troubleshooting.map((item, index) => (
            <div key={index} class="bg-white p-5 rounded-xl border border-steel-100 shadow-md">
              <h3 class="font-semibold text-lg text-red-600 mb-3">{item.problem}</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <h4 class="font-medium text-steel-500 mb-2">Penyebab:</h4>
                  <ul class="space-y-1">
                    {item.causes.map((cause, idx) => (
                      <li key={idx} class="text-steel-700 text-sm">{cause}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="font-medium text-steel-500 mb-2">Solusi:</h4>
                  <ul class="space-y-1">
                    {item.solutions.map((solution, idx) => (
                      <li key={idx} class="text-green-600 text-sm">{solution}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="spare-parts" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Inventaris Suku Cadang</h2>
        <h3 class="font-semibold text-xl mb-4 text-charcoal-900">Suku Cadang Penting</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {spareParts.map((item, index) => (
            <div key={index} class="bg-white p-4 rounded-xl border border-steel-100 shadow-sm flex justify-between items-center">
              <span class="text-charcoal-900 font-medium">{item.name}</span>
              <span class={`px-2 py-1 rounded text-xs font-bold ${item.stock === 'Kritis' ? 'bg-red-100 text-red-700' : item.stock === 'Aus' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'}`}>{item.stock}</span>
            </div>
          ))}
        </div>
        <div class="mt-6 bg-steel-50 p-4 rounded-xl">
          <h4 class="font-semibold text-charcoal-900 mb-2">Tingkat Stok yang Direkomendasikan</h4>
          <ul class="text-steel-700 text-sm space-y-1">
            <li>• Suku cadang kritis: 1-2 unit stok</li>
            <li>• Suku cadang aus: 2-3 unit stok</li>
            <li>• Habis pakai: persediaan 3-6 bulan</li>
          </ul>
        </div>
      </section>

      <section id="hydraulic-oil-detail" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Spesifikasi, Suhu, dan Interval Penggantian Oli Hidrolik</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Oli hidrolik adalah komponen mesin, bukan bahan habis pakai yang diisi ulang secara sembarangan. Gunakan oli hidrolik anti-wear ISO VG 46 (seperti grade HM) di hampir semua iklim; beralih ke VG 32 hanya di bengkel yang konsisten dingin dan VG 68 pada suhu lingkungan tinggi yang berkelanjutan. Mencampur merek atau grade viskositas merusak kestabilan paket aditif dan harus dihindari — ganti total, jangan dicampur.</p>
        <div class="bg-steel-50 rounded-xl p-6 border border-steel-100 my-4">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Aturan Praktis Servis Oli</h3>
          <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
            <li><strong>Suhu operasi:</strong> jaga oli tangki antara 30 dan 50 °C; operasi terus-menerus di atas 60 °C kurang lebih memangkas umur oli dan seal hingga setengahnya.</li>
            <li><strong>Interval penggantian:</strong> penggantian pertama setelah 3 bulan atau 500 jam pada mesin baru, lalu setiap 2.000 jam operasi atau tahunan, mana yang lebih dulu.</li>
            <li><strong>Volume sistem:</strong> mesin kelas HN325/HN365 menampung sekitar 30–40 L; mesin kelas HN426/HN500 50–60 L — beli cukup untuk penggantian penuh, bukan sekadar penambahan.</li>
            <li><strong>Selalu ganti</strong> elemen filter saluran balik bersamaan dengan oli; oli baru di belakang filter yang sudah jenuh adalah pemborosan.</li>
          </ul>
        </div>
        <p class="text-steel-700 leading-relaxed">Penampilan oli adalah alat diagnosis: oli keruh seperti susu berarti masuknya air (seal pendingin atau praktik pencucian), oli gelap terbakar dengan bau tajam berarti panas berlebih yang berkelanjutan, dan kilau logam dalam sampel oli bekas berarti pompa atau silinder sudah aus. Salah satu kondisi ini menuntut pemeriksaan segera, bukan penambahan sesuai jadwal.</p>
      </section>

      <section id="barrel-seal-inspection" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Inspeksi Keausan Tabung Press, Paking, dan Seal</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Sebagian besar kehilangan hasil yang disalahkan pada "mesin yang sudah tua" sebenarnya adalah keausan tabung press dan paking. Periksa dinding tabung press dan celah drainase setiap bulan: celah yang membesar atau terkikis mengilap memungkinkan bubur halus lolos bersama oli, sedangkan dinding yang tergores atau bergelombang meningkatkan gesekan dan menahan oli sisa di bungkil. Tabung press cold-press berslot dirancang untuk menjaga oli sisa pada 6–8%; ketika oli sisa di bungkil naik di atas 10%, tabung press atau kain saring — bukan pompa — biasanya menjadi tersangka.</p>
        <ul class="space-y-2 text-steel-700 list-disc pl-5 mb-4">
          <li>Ganti seal ram utama dan seal tabung press pada tanda pertama rembesan eksternal; kebocoran eksternal yang lambat menyembunyikan bypass internal yang lebih cepat.</li>
          <li>Periksa kain saring dan kasa drainase setiap shift terhadap penyumbatan; kasa yang tersumbat menahan oli yang akhirnya tertinggal di bungkil.</li>
          <li>Periksa ketebalan dan pola permukaan bungkil: bungkil yang konsisten miring menunjukkan ketidaksejajaran ram atau pengisian yang tidak merata.</li>
          <li>Simpan satu set paking lengkap dan satu set kain saring di rak; berhenti satu hari karena seal seharga USD 20 menghapus penghematan perawatan selama berminggu-minggu.</li>
        </ul>
      </section>

      <section id="downtime-economics" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-4 text-charcoal-900">Mengukur Perawatan dari Sisi Biaya, Bukan Hanya Jam</h2>
        <p class="text-steel-700 leading-relaxed mb-4">Di bengkel dengan satu mesin press, mesin press adalah seluruh bisnis: setiap hari menganggur yang tidak direncanakan tetap menelan biaya sewa, upah, dan — yang terburuk — biji yang mudah rusak dan tidak bisa menunggu. Catat dua angka: jam downtime tidak terencana per bulan, dan tren oli sisa di bungkil. Angka pertama mengukur keandalan; angka kedua menangkap degradasi lambat yang tidak pernah muncul dalam laporan kerusakan, karena tabung press yang aus menghasilkan minyak sedikit lebih sedikit setiap hari tanpa pernah menghentikan mesin.</p>
        <p class="text-steel-700 leading-relaxed">Anggarkan 2–3% dari nilai peralatan per tahun untuk bahan habis pakai dan suku cadang, dan sisihkan waktu untuk inspeksi bulanan terdokumentasi alih-alih menunggu gejala. Pekerjaan preventif dapat dijadwalkan mengikuti pasokan biji; perbaikan terjadi pada saat yang paling buruk. Saat merencanakan suku cadang mana yang disimpan lokal dan mana yang dipesan lewat angkutan laut, gunakan jadwal di atas dan minta tim kami untuk daftar spesifik model — dimensi seal dan elemen filter berbeda antara <a href="/id/products/standard-hydraulic-oil-press/" class="text-amber-600 hover:underline">kelas HN325</a> dan mesin HN426/HN500 yang lebih besar.</p>
        <p class="text-steel-700 leading-relaxed mt-4">Simpan log mesin sederhana di samping mesin press: jam operasi, level dan suhu oli, setiap seal atau kain saring yang diganti, dan segala hal tidak biasa pada suara atau tekanan. Ini tidak memakan biaya, mengubah setiap operator menjadi bagian dari sistem inspeksi, dan — ketika teknisi atau pemasok suku cadang membutuhkan informasi — menjawab dalam satu menit pertanyaan yang jika tidak akan membutuhkan seminggu tebakan. Mesin yang dilengkapi log lengkap juga memiliki harga jual kembali lebih baik, karena riwayat yang terdokumentasi adalah bukti terkuat bahwa bejana tekan telah diperlakukan dengan baik.</p>
      </section>

      <section id="conclusion" class="mb-12">
        <h2 class="font-display font-bold text-2xl mb-6 text-charcoal-900">Jadikan Perawatan Press Rutinitas yang Tak Bisa Ditawar</h2>
        <p class="text-steel-700 leading-relaxed">Perawatan rutin adalah kunci untuk memaksimalkan umur dan kinerja pengepres minyak hidrolik Anda. Untuk saran perawatan yang dipersonalisasi atau untuk memesan suku cadang, hubungi tim dukungan teknis Haonuo.</p>
      </section>
    </div>
  </main>

  <section class="bg-gradient-to-br from-amber-500 via-amber-400 to-orange-500 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-6">SIAP MEMULAI PRODUKSI MINYAK ANDA?</h2>
      <p class="text-lg text-white/90 mb-10 max-w-2xl mx-auto">Tim teknik kami dapat membantu Anda memilih peralatan terbaik dan mengoptimalkan investasi Anda untuk pengembalian maksimal.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact/" class="btn-primary bg-white text-charcoal-900 hover:bg-gray-100">Hubungi Ahli Kami<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="/id/products/" class="btn-outline border-white text-white hover:bg-white/10">Lihat Peralatan</a>
        <a href="/id/resources/" class="btn-outline border-white text-white hover:bg-white/10">Kembali ke Sumber Daya</a>
      </div>
    </div>
  </section>
</BaseLayout>
