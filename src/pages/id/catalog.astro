---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('id');
const products = await getCollection('products');

const categories = {
  'hydraulic-oil-press': 'Press Minyak Hidrolik',
  'oil-refining': 'Peralatan Pemisahan Minyak',
  'seed-processing': 'Peralatan Pengolahan Benih',
  'oil-filtration': 'Peralatan Filter Minyak',
};

const hydraulicSortOrder = [
  'HN325',
  'HN355',
  'HN426',
  'HN480',
  'HN500',
  'HN325 Large Barrel',
  'HN325/355 Sesame',
  '300 Type Coconut',
  'HN325S',
];

function getHydraulicSortIndex(product) {
  const model = product.data.model;
  const index = hydraulicSortOrder.indexOf(model);
  return index >= 0 ? index : hydraulicSortOrder.length + products.indexOf(product);
}

const categorizedProducts = products.reduce((acc, product) => {
  const category = product.data.category || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(product);
  return acc;
}, {});

if (categorizedProducts['hydraulic-oil-press']) {
  categorizedProducts['hydraulic-oil-press'].sort((a, b) => {
    return getHydraulicSortIndex(a) - getHydraulicSortIndex(b);
  });
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/id' },
    { '@type': 'ListItem', position: 2, name: 'Katalog Produk', item: 'https://www.hydoilpress.com/id/catalog' },
  ],
};
---

<BaseLayout title="Katalog Produk - Haonuo Machinery" description="Katalog lengkap press minyak hidrolik dan peralatan pengolahan minyak dari Haonuo Machinery." locale="id">
  <section class="bg-amber-500 py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-amber-100 text-sm mb-4">
        <a href="/id" class="hover:text-white transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-white font-semibold">Katalog Produk</span>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4">Katalog Produk</h1>
      <p class="text-amber-100 text-lg md:text-xl max-w-2xl">Rangkaian lengkap press minyak hidrolik dan peralatan pengolahan minyak untuk bisnis Anda</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-8">
        <p class="text-steel-600">{(t as any).footer?.companyName || 'Shandong Haonuo Machinery Equipment Group Co., Ltd.'}</p>
        <button onclick="window.print()" class="bg-amber-500 hover:bg-amber-600 text-white px-6 py-2 rounded-lg font-medium transition-colors hidden md:block no-print">
          Cetak Katalog
        </button>
      </div>

      {Object.entries(categorizedProducts).map(([category, items]) => (
        <div key={category} class="mb-4">
          <h2 class="font-display text-3xl text-charcoal-900 mb-6 pb-2 border-b-2 border-amber-500">
            {categories[category] || category.replace('-', ' ')}
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {items.map(product => {
              const specs = product.data.specificationsId || product.data.specifications || [];
              return (
                <div key={product.slug} class="border border-steel-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow break-inside-avoid">
                  <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                    <img 
                      src={product.data.images?.[0] || '/images/products/default-product.webp'} 
                      alt={product.data.title.id || product.data.title.en}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                      <h3 class="font-display text-xl text-charcoal-900">{product.data.title.id || product.data.title.en}</h3>
                      <span class="bg-amber-100 text-amber-700 text-sm px-2 py-1 rounded font-medium">
                        {product.data.model}
                      </span>
                    </div>
                    <p class="text-steel-600 text-sm mb-4 line-clamp-2">
                      {product.data.description.id || product.data.description.en}
                    </p>
                    <div class="border-t border-steel-100 pt-4">
                      <h4 class="font-semibold text-charcoal-900 mb-2 text-sm">Spesifikasi:</h4>
                      <ul class="text-steel-600 text-xs space-y-1">
                        {specs.slice(0, 4).map(spec => (
                          <li key={spec.name} class="flex justify-between">
                            <span>{spec.name}:</span>
                            <span class="font-medium">{spec.value}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="mt-4">
                      <a href={`/id/products/${product.slug}`} class="inline-block text-amber-600 hover:text-amber-700 font-medium text-sm hover:underline">
                        Lihat Detail →
                      </a>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-charcoal-900 py-12 no-print">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl text-white mb-4">Hubungi Kami untuk Informasi Lebih Lanjut</h2>
      <p class="text-steel-400 mb-6">Dapatkan penawaran personalisasi untuk kebutuhan Anda</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact" class="bg-amber-500 hover:bg-amber-600 text-white px-8 py-3 rounded-lg font-medium transition-colors">
          Minta Penawaran
        </a>
        <a href="mailto:info@hydoilpress.com" class="border border-steel-600 hover:border-amber-500 text-white px-8 py-3 rounded-lg font-medium transition-colors">
          Kirim Email
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

