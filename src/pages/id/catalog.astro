      display: none !important;
    }
    header#main-navbar,
    header#main-navbar *,
    footer.bg-charcoal-900,
    footer.bg-charcoal-900 *,
    .chat-widget,
    .chat-widget *,
    .cookie-consent-banner,
    .cookie-consent-banner *,
