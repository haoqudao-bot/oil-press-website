---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = getTranslations('id');
const products = await getCollection('products');

const categories = {
  'hydraulic-oil-press': 'Press Minyak Hidrolik',
  'roasting-steaming-equipment': 'Peralatan Pemanggangan & Pengukusan',
  'seed-processing-equipment': 'Peralatan Pengolahan Benih',
  'filtration-refining-equipment': 'Peralatan Filtrasi & Pemurnian',
};

const categoryOrder = [
  'hydraulic-oil-press',
  'roasting-steaming-equipment',
  'seed-processing-equipment',
  'filtration-refining-equipment',
];

const hydraulicSortOrder = [
  'HN325',
  'HN365',
  'HN426',
  'HN500',
  'HN325 Large Barrel',
  'HN325/355 Sesame',
  '300 Type Coconut',
];

/* Catalog-facing model labels (HN355 superseded by HN365) */
const modelLabelOverrides = {
  'HN325/355 Sesame': 'HN325/365 Sesame',
};

/* Catalog-facing text: retired HN355 references display as HN365 (product page unchanged) */
const catalogText = (s: string) => (s || '').replace(/355/g, '365');

/* Model generasi sebelumnya: ditampilkan di bagian arsip yang dapat dilipat */
const archivedSlugs = [
  'mini-hydraulic-oil-press',
  'medium-hydraulic-oil-press',
  'heavy-duty-hydraulic-oil-press',
  'high-pressure-hydraulic-oil-press',
];
const catalogHiddenSlugs = new Set(archivedSlugs);

/* Model penerus yang ditampilkan pada kartu arsip */
const successorLabel: Record<string, string> = {
  'mini-hydraulic-oil-press': 'HN325',
  'medium-hydraulic-oil-press': 'HN365',
  'heavy-duty-hydraulic-oil-press': 'HN426 / HN500',
  'high-pressure-hydraulic-oil-press': 'HN426 / HN500',
};

const archivedProducts = archivedSlugs
  .map(slug => products.find(p => p.slug === slug))
  .filter(Boolean);

function getHydraulicSortIndex(product) {
  const model = product.data.model;
  const index = hydraulicSortOrder.indexOf(model);
  return index >= 0 ? index : hydraulicSortOrder.length + products.indexOf(product);
}

const categorizedProducts = products.reduce((acc, product) => {
  if (catalogHiddenSlugs.has(product.slug)) return acc;
  const category = product.data.category || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(product);
  return acc;
}, {});

if (categorizedProducts['hydraulic-oil-press']) {
  categorizedProducts['hydraulic-oil-press'].sort((a, b) => {
    return getHydraulicSortIndex(a) - getHydraulicSortIndex(b);
  });
}

const sortedCategoryEntries = Object.entries(categorizedProducts).sort(([a], [b]) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  if (ai === -1 && bi === -1) return a.localeCompare(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: 'https://www.hydoilpress.com/id' },
    { '@type': 'ListItem', position: 2, name: 'Katalog Produk', item: 'https://www.hydoilpress.com/id/catalog' },
  ],
};
---

<BaseLayout title="Katalog Mesin Press Minyak Hidrolik & Daftar Harga" description="Katalog produk cetak untuk press minyak hidrolik dan peralatan pengolahan minyak Haonuo. Unduh, cetak, atau kirimkan ke pelanggan." locale="id">
  <section class="bg-amber-500 py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-amber-100 text-sm mb-4">
        <a href="/id/" class="hover:text-white transition-colors">{t.nav.home}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-white font-semibold">Katalog Cetak</span>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4">Katalog Produk</h1>
      <p class="text-amber-100 text-lg md:text-xl max-w-2xl">Rangkaian lengkap press minyak hidrolik dan peralatan pengolahan minyak untuk bisnis Anda</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-8">
        <p class="text-steel-600">{(t as any).footer?.companyName || 'Shandong Haonuo Machinery Equipment Group Co., Ltd.'}</p>
        <button onclick="window.print()" class="bg-amber-500 hover:bg-amber-600 text-white px-6 py-2 rounded-lg font-medium transition-colors hidden md:block no-print">
          Cetak Katalog
        </button>
      </div>

      {sortedCategoryEntries.map(([category, items]) => (
        <div key={category} class="mb-4">
          <h2 class="font-display text-3xl text-charcoal-900 mb-6 pb-2 border-b-2 border-amber-500">
            {categories[category] || category.replace('-', ' ')}
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {items.map(product => {
              const specs = product.data.specificationsId || product.data.specifications || [];
              return (
                <div key={product.slug} class="border border-steel-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow break-inside-avoid">
                  <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                    <img
                      src={product.data.images?.[0] || '/images/products/default-product.webp'}
                      alt={product.data.title.id || product.data.title.en}
                      width="400"
                      height="300"
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                      <h3 class="font-display text-xl text-charcoal-900">{product.data.title.id || product.data.title.en}</h3>
                      <span class="bg-amber-100 text-amber-700 text-sm px-2 py-1 rounded font-medium">
                        {modelLabelOverrides[product.data.model] || product.data.model}
                      </span>
                    </div>
                    <p class="text-steel-600 text-sm mb-4 line-clamp-2">
                      {catalogText(product.data.description.id || product.data.description.en)}
                    </p>
                    <div class="border-t border-steel-100 pt-4">
                      <h4 class="font-semibold text-charcoal-900 mb-2 text-sm">Spesifikasi:</h4>
                      <ul class="text-steel-600 text-xs space-y-1">
                        {specs.slice(0, 4).map(spec => (
                          <li key={spec.name} class="flex justify-between">
                            <span>{catalogText(spec.name)}:</span>
                            <span class="font-medium">{catalogText(spec.value)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="mt-4">
                      <a href={`/id/products/${product.slug}/`} class="inline-block text-amber-600 hover:text-amber-700 font-medium text-sm hover:underline">
                        Lihat Detail →
                      </a>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}

      {archivedProducts.length > 0 && (
        <div class="mt-10">
          <details class="archive-details border border-steel-200 rounded-xl bg-steel-50/60">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5">
              <div>
                <div class="inline-block text-xs font-bold tracking-widest text-steel-500 bg-white border border-steel-200 px-3 py-1 rounded-full mb-2">MODEL LAMA</div>
                <h2 class="font-display text-2xl md:text-3xl text-charcoal-900">Model generasi sebelumnya (arsip)</h2>
                <p class="text-steel-500 text-sm mt-1 max-w-2xl">HN300 · HN355 · HN400 · HN480 — digantikan lini terbaru HN325 · HN365 · HN426 · HN500, tetapi masih diproduksi dan didukung.</p>
              </div>
              <span class="shrink-0 hidden md:inline-flex items-center gap-2 text-sm font-medium text-amber-600 no-print">
                <span class="archive-label-closed">Tampilkan model lama</span>
                <span class="archive-label-open hidden">Sembunyikan</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform archive-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-steel-400 md:hidden archive-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-6 archive-content">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {archivedProducts.map(product => (
                  <div key={product.slug} class="border border-steel-200 rounded-xl overflow-hidden shadow-sm bg-white break-inside-avoid">
                    <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                      <img
                        src={product.data.images?.[0] || '/images/products/default-product.webp'}
                        alt={product.data.title.id || product.data.title.en}
                        width="400"
                        height="300"
                        loading="lazy"
                        class="w-full h-full object-cover opacity-90"
                      />
                    </div>
                    <div class="p-6">
                      <div class="flex justify-between items-start mb-2 gap-2">
                        <h3 class="font-display text-xl text-charcoal-900">{product.data.title.id || product.data.title.en}</h3>
                        <span class="bg-steel-200 text-steel-600 text-sm px-2 py-1 rounded font-medium whitespace-nowrap">
                          {product.data.model}
                        </span>
                      </div>
                      <p class="text-xs text-steel-500 mb-3">
                        Generasi sebelumnya — model terbaru: <span class="font-semibold text-amber-700">{successorLabel[product.slug]}</span>
                      </p>
                      <p class="text-steel-600 text-sm mb-4 line-clamp-2">
                        {catalogText(product.data.description.id || product.data.description.en)}
                      </p>
                      <div class="border-t border-steel-100 pt-4">
                        <h4 class="font-semibold text-charcoal-900 mb-2 text-sm">Spesifikasi:</h4>
                        <ul class="text-steel-600 text-xs space-y-1">
                          {((product.data.specificationsId || product.data.specifications || [])).slice(0, 4).map(spec => (
                            <li key={spec.name} class="flex justify-between">
                              <span>{catalogText(spec.name)}:</span>
                              <span class="font-medium">{catalogText(spec.value)}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="mt-4">
                        <a href={`/id/products/${product.slug}/`} class="inline-block text-amber-600 hover:text-amber-700 font-medium text-sm hover:underline">
                          Lihat Detail →
                        </a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </details>
        </div>
      )}
    </div>
  </section>

  <section class="bg-charcoal-900 py-12 no-print">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl text-white mb-4">Hubungi Kami untuk Informasi Lebih Lanjut</h2>
      <p class="text-steel-400 mb-6">Dapatkan penawaran personalisasi untuk kebutuhan Anda</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/id/contact/" class="bg-amber-500 hover:bg-amber-600 text-white px-8 py-3 rounded-lg font-medium transition-colors">
          Dapatkan Harga Pabrik
        </a>
        <a href="mailto:info@hydoilpress.com" class="border border-steel-600 hover:border-amber-500 text-white px-8 py-3 rounded-lg font-medium transition-colors">
          Kirim Email
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .break-inside-avoid {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .archive-details summary::-webkit-details-marker {
    display: none;
  }
  .archive-details[open] .archive-chevron {
    transform: rotate(180deg);
  }
  .archive-details[open] .archive-label-closed {
    display: none;
  }
  .archive-details:not([open]) .archive-label-open {
    display: none;
  }

  .page-break-inside-avoid {
    page-break-inside: avoid;
  }

  @media print {
    .archive-details .archive-content {
      display: block !important;
    }
    .archive-details summary {
      list-style: none;
    }
    .archive-details .archive-chevron,
    .archive-details .archive-label-closed,
