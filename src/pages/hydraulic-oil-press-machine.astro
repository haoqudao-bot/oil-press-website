---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '../i18n';

const t = getTranslations('en');
const allProducts = await getCollection('products');
const hydraulicProducts = allProducts.filter(p => p.data.category === 'hydraulic-oil-press');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.hydraulic.breadcrumbHome, item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: t.hydraulic.breadcrumbProducts, item: 'https://www.hydoilpress.com/products' },
    { '@type': 'ListItem', position: 3, name: t.hydraulic.breadcrumbCurrent, item: 'https://www.hydoilpress.com/hydraulic-oil-press-machine' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.hydraulic.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const techComparison = [
  { model: 'HN300', force: '300 Tons', motor: '2.2 KW', bestFor: 'Sesame, small seeds, entry-level' },
  { model: 'HN325', force: '325 Tons', motor: '2.2 KW', bestFor: 'Popular, versatile, peanut & rapeseed' },
  { model: 'HN325S', force: '330 Tons', motor: '2.2 KW', bestFor: 'Stainless steel, food-grade, export markets' },
  { model: 'HN355', force: '360 Tons', motor: '2.2 KW', bestFor: 'Heavy-duty, tea seed & medium seeds' },
  { model: 'HN400', force: '400 Tons', motor: '2.2 KW', bestFor: 'Commercial-scale, high-volume production' },
  { model: 'HN426', force: '500 Tons', motor: '2.2 KW', bestFor: 'Cold press, walnut, coconut & premium oils' },
  { model: 'HN480B', force: '560 Tons', motor: '2.2 KW', bestFor: 'Heavy cold press, coconut VCO, industrial' },
  { model: 'HN500', force: '620 Tons', motor: '2.2 KW', bestFor: 'Ultra-high pressure, industrial-scale, all seeds' },
];
---

<BaseLayout
  title={t.hydraulic.title}
  description={t.hydraulic.description}
  keywords={['hydraulic oil press machine', 'hydraulic oil press', 'cold press oil machine', 'hydraulic press for oil extraction', 'oil press machine manufacturer', 'hydraulic oil press machine price', 'hydraulic oil press machine for sale']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">{t.hydraulic.breadcrumbHome}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products" class="hover:text-amber-500 transition-colors">{t.hydraulic.breadcrumbProducts}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{t.hydraulic.breadcrumbCurrent}</span>
      </nav>
    </div>
  </section>

  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4">{t.hydraulic.heroTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl mb-8">{t.hydraulic.heroDesc}</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          {t.hydraulic.requestQuote}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/products/model-comparison" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white hover:text-steel-900 transition-colors text-lg">
          {t.hydraulic.compareModels}
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.hydraulic.whyChoose}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.highYield.title}</h3>
          <p class="text-sm text-steel-600 mb-3">{t.hydraulic.highYield.desc}</p>
          <div class="text-amber-500 font-semibold text-sm">{t.hydraulic.highYield.stat}</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.lowPower.title}</h3>
          <p class="text-sm text-steel-600 mb-3">{t.hydraulic.lowPower.desc}</p>
          <div class="text-amber-500 font-semibold text-sm">{t.hydraulic.lowPower.stat}</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.versatile.title}</h3>
          <p class="text-sm text-steel-600 mb-3">{t.hydraulic.versatile.desc}</p>
          <div class="text-amber-500 font-semibold text-sm">{t.hydraulic.versatile.stat}</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.durable.title}</h3>
          <p class="text-sm text-steel-600 mb-3">{t.hydraulic.durable.desc}</p>
          <div class="text-amber-500 font-semibold text-sm">{t.hydraulic.durable.stat}</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.easyOperation.title}</h3>
          <p class="text-sm text-steel-600 mb-3">{t.hydraulic.easyOperation.desc}</p>
          <div class="text-amber-500 font-semibold text-sm">{t.hydraulic.easyOperation.stat}</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.factoryDirect.title}</h3>
          <p class="text-sm text-steel-600 mb-3">{t.hydraulic.factoryDirect.desc}</p>
          <div class="text-amber-500 font-semibold text-sm">{t.hydraulic.factoryDirect.stat}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.hydraulic.productSeriesTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {hydraulicProducts.map(product => (
          <a
            href={`/products/${product.slug}`}
            class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
          >
            <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
              <img
                src={product.data.images[0]}
                alt={product.data.title.en}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20hydraulic%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
              />
            </div>
            <div class="p-5">
              <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
              <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
              <div class="flex flex-wrap gap-2">
                {product.data.specifications.slice(0, 2).map(spec => (
                  <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                    {spec.name}: {spec.value}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.hydraulic.howWorksTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center text-white font-display text-2xl mx-auto mb-4">1</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.howWorksStep1.title}</h3>
          <p class="text-steel-600">{t.hydraulic.howWorksStep1.desc}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center text-white font-display text-2xl mx-auto mb-4">2</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.howWorksStep2.title}</h3>
          <p class="text-steel-600">{t.hydraulic.howWorksStep2.desc}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center text-white font-display text-2xl mx-auto mb-4">3</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.howWorksStep3.title}</h3>
          <p class="text-steel-600">{t.hydraulic.howWorksStep3.desc}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.hydraulic.applicationsTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">&#127807;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.sesameOilApp.title}</h3>
          <p class="text-steel-600 text-sm">{t.hydraulic.sesameOilApp.desc}</p>
          <div class="text-amber-500 font-semibold text-sm mt-3">{t.hydraulic.sesameOilApp.yield}</div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">&#129381;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.coconutOilApp.title}</h3>
          <p class="text-steel-600 text-sm">{t.hydraulic.coconutOilApp.desc}</p>
          <div class="text-amber-500 font-semibold text-sm mt-3">{t.hydraulic.coconutOilApp.yield}</div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">&#129372;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.peanutOilApp.title}</h3>
          <p class="text-steel-600 text-sm">{t.hydraulic.peanutOilApp.desc}</p>
          <div class="text-amber-500 font-semibold text-sm mt-3">{t.hydraulic.peanutOilApp.yield}</div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">&#129756;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.oliveOilApp.title}</h3>
          <p class="text-steel-600 text-sm">{t.hydraulic.oliveOilApp.desc}</p>
          <div class="text-amber-500 font-semibold text-sm mt-3">{t.hydraulic.oliveOilApp.yield}</div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">&#129361;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.avocadoOilApp.title}</h3>
          <p class="text-steel-600 text-sm">{t.hydraulic.avocadoOilApp.desc}</p>
          <div class="text-amber-500 font-semibold text-sm mt-3">{t.hydraulic.avocadoOilApp.yield}</div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">&#127803;</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.hydraulic.sunflowerOilApp.title}</h3>
          <p class="text-steel-600 text-sm">{t.hydraulic.sunflowerOilApp.desc}</p>
          <div class="text-amber-500 font-semibold text-sm mt-3">{t.hydraulic.sunflowerOilApp.yield}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">{t.hydraulic.comparisonTitle}</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-steel-900 text-white">
              <th class="px-4 py-3 text-left font-display text-sm rounded-tl-lg">{t.hydraulic.comparisonModel}</th>
              <th class="px-4 py-3 text-left font-display text-sm">{t.hydraulic.comparisonForce}</th>
              <th class="px-4 py-3 text-left font-display text-sm">{t.hydraulic.comparisonMotor}</th>
              <th class="px-4 py-3 text-left font-display text-sm rounded-tr-lg">{t.hydraulic.comparisonBestFor}</th>
            </tr>
          </thead>
          <tbody>
            {techComparison.map((item, index) => (
              <tr key={item.model} class={index % 2 === 0 ? 'border-b border-steel-100' : 'border-b border-steel-100 bg-steel-50'}>
                <td class="px-4 py-3 font-semibold text-charcoal-900">{item.model}</td>
                <td class="px-4 py-3 text-steel-600">{item.force}</td>
                <td class="px-4 py-3 text-steel-600">{item.motor}</td>
                <td class="px-4 py-3 text-steel-600">{item.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center text-sm text-steel-500 mt-4">
        All models available in single and double barrel configurations. Barrel size customizable.
        <a href="/products/model-comparison" class="text-amber-500 hover:underline"> {t.hydraulic.compareAllModels} &rarr;</a>
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">{t.hydraulic.faqTitle}</h2>
      <div class="space-y-4">
        {t.hydraulic.faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">{t.hydraulic.ctaTitle}</h2>
      <p class="text-steel-300 text-lg mb-8">{t.hydraulic.ctaDesc}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          {t.hydraulic.requestQuote}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="https://wa.me/8618957149128?text=Hello%20Haonuo%2C%20I%20am%20interested%20in%20hydraulic%20oil%20press%20machine" target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white font-semibold px-8 py-4 rounded-lg hover:bg-green-500 transition-colors text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {t.hydraulic.whatsappUs}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>