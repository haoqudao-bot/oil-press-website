---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMarketProducts } from '../../data/market-products';

const allProducts = await getCollection('products');
const egyptSeeds = ['sesame', 'olive', 'peanut', 'sunflower'];
const { mainProducts, auxProducts } = getMarketProducts(allProducts, egyptSeeds);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Markets', item: 'https://www.hydoilpress.com/markets' },
    { '@type': 'ListItem', position: 3, name: 'Egypt', item: 'https://www.hydoilpress.com/markets/egypt' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the price of an oil press machine in Egypt?',
      acceptedAnswer: { '@type': 'Answer', text: 'Contact us for a customized quote for a complete Haonuo oil press setup including shipping to Alexandria or Port Said. We provide competitive factory-direct pricing and can quote in EGP (Egyptian Pound) at current exchange rates.' },
    },
    {
      '@type': 'Question',
      name: 'Can the machine press sesame for tahini and oil?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Haonuo hydraulic cold press machines are excellent for sesame oil production. Egypt is one of the world\'s top sesame producers, and our machines achieve 42-50% oil yield, producing premium cold-pressed sesame oil well-suited for both tahini production and cooking oil markets.' },
    },
    {
      '@type': 'Question',
      name: 'What voltage does the oil press machine use in Egypt?',
      acceptedAnswer: { '@type': 'Answer', text: 'Haonuo oil press machines are customized for Egypt\'s 220V/50Hz power standard. Our motors are configured to match local electrical requirements, ensuring safe and efficient operation.' },
    },
    {
      '@type': 'Question',
      name: 'How long does shipping take to Alexandria, Egypt?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from Qingdao, China to Alexandria or Port Said takes 20-24 days. We handle all export documentation and can arrange CIF shipping for your convenience. Contact us for current shipping rates.' },
    },
    {
      '@type': 'Question',
      name: 'What are the import regulations for oil press machines in Egypt?',
      acceptedAnswer: { '@type': 'Answer', text: 'Oil press machines are classified under HS code 8479.82. Egypt requires registration with GOEIC (General Organization for Export and Import Control) for machinery imports. We provide all necessary documentation including certificates of origin, commercial invoices, and quality certificates to facilitate smooth customs clearance.' },
    },
  ],
};

const faqs = [
  { question: 'What is the price of an oil press machine in Egypt?', answer: 'Contact us for a customized quote for a complete Haonuo oil press setup including shipping to Alexandria or Port Said. We provide competitive factory-direct pricing and can quote in EGP (Egyptian Pound) at current exchange rates.' },
  { question: 'Can the machine press sesame for tahini and oil?', answer: 'Yes. Haonuo hydraulic cold press machines are excellent for sesame oil production. Egypt is one of the world\'s top sesame producers, and our machines achieve 42-50% oil yield, producing premium cold-pressed sesame oil well-suited for both tahini production and cooking oil markets.' },
  { question: 'What voltage does the oil press machine use in Egypt?', answer: 'Haonuo oil press machines are customized for Egypt\'s 220V/50Hz power standard. Our motors are configured to match local electrical requirements, ensuring safe and efficient operation.' },
  { question: 'How long does shipping take to Alexandria, Egypt?', answer: 'Sea freight from Qingdao, China to Alexandria or Port Said takes 20-24 days. We handle all export documentation and can arrange CIF shipping for your convenience. Contact us for current shipping rates.' },
  { question: 'What are the import regulations for oil press machines in Egypt?', answer: 'Oil press machines are classified under HS code 8479.82. Egypt requires registration with GOEIC (General Organization for Export and Import Control) for machinery imports. We provide all necessary documentation including certificates of origin, commercial invoices, and quality certificates to facilitate smooth customs clearance.' },
];
---

<BaseLayout
  title="Oil Press Machine in Egypt"
  description="Oil press machine in Egypt for sesame, olive and sunflower. ACID/GOEIC documents and inspection support, shipping to Alexandria. Request a quote."
  keywords={['oil press machine Egypt', 'sesame oil press machine Egypt', 'olive oil press Egypt', 'hydraulic oil press Egypt price']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/markets/" class="hover:text-amber-500 transition-colors">Markets</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Egypt</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Oil Press Machine in Egypt — Factory Direct</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Hydraulic oil press machines for sesame, olive, peanut, and sunflower oil production. Factory-direct pricing, shipping to Alexandria in 20-24 days, 1-year warranty.</p>
    </div>
  </section>

  <!-- Popular Oilseeds in Egypt -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Popular Oilseeds for Hydraulic Pressing in Egypt</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫘</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sesame</h3>
          <p class="text-sm text-steel-600 mb-3">Egypt is a top sesame producer. Used for tahini and premium cold-pressed oil with distinctive flavor.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 42-50%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫒</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Olive</h3>
          <p class="text-sm text-steel-600 mb-3">Premium cold-pressed olive oil from Egypt's growing olive cultivation. High-value product for health-conscious consumers.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 15-25%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🥜</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Peanut</h3>
          <p class="text-sm text-steel-600 mb-3">Popular cooking oil in Egyptian households. Versatile oil with high smoke point well-suited for local cuisine.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 38-45%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌻</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sunflower</h3>
          <p class="text-sm text-steel-600 mb-3">Growing market for sunflower oil as a healthier alternative. Light flavor suitable for everyday cooking.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 35-45%</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Import Requirements: ACID, GOEIC -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4">Importing Oil Presses Into Egypt: ACID, GOEIC &amp; Inspection</h2>
      <p class="text-center text-steel-600 mb-12 max-w-3xl mx-auto">Egypt runs one of the region's most document-heavy import regimes. Three things must be in place <em>before the vessel sails</em>; arranging them after arrival means weeks of port storage and demurrage at Alexandria or Sokhna.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">1 · ACID declaration</h3>
          <p class="text-steel-700 text-sm mb-3">The Egyptian importer registers the shipment on the Nafeza customs platform and receives an <strong>ACID number</strong>, which must appear on the commercial invoice, packing list and bill of lading.</p>
          <p class="text-steel-700 text-sm">Exporters complete the cargo-data side through the authorised blockchain platform. Shipments without a valid ACID cannot be loaded at origin.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">2 · GOEIC registration</h3>
          <p class="text-steel-700 text-sm mb-3">Importers of industrial equipment must be registered with the <strong>General Organization for Export and Import Control</strong>, and foreign factory/manufacturer registration rules may apply depending on product category.</p>
          <p class="text-steel-700 text-sm">Your importer of record should verify status well before ordering — this is the check most often left too late.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">3 · Inspection &amp; attested documents</h3>
          <p class="text-steel-700 text-sm mb-3">A pre-shipment inspection certificate from an accredited inspection body, plus commercial documents (invoice, certificate of origin, packing list) attested through the prescribed consular or electronic channels.</p>
          <p class="text-steel-700 text-sm">We provide the manufacturer test report, nameplate and technical file that inspection bodies routinely request.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
          <p class="text-charcoal-900 text-sm font-medium mb-2">Ports and timing</p>
          <p class="text-steel-700 text-sm">Most machinery enters via Alexandria or Port Said; Ain Sokhna serves Red Sea routings. Build the ACID and inspection window into your production schedule — both are completed while the machine is still at our works.</p>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
          <p class="text-charcoal-900 text-sm font-medium mb-2">Power specification</p>
          <p class="text-steel-700 text-sm">Egyptian industrial supply is 220/380V, 50Hz three-phase, matching our standard build. Confirm your site supply and breaker capacity before delivery using our <a href="/resources/oil-press-electrical-requirements-guide/" class="text-amber-700 underline">electrical requirements guide</a>.</p>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-4 text-center">ACID and GOEIC procedures are revised frequently — always confirm the current checklist with your Egyptian importer or customs agent before placing the order.</p>
    </div>
  </section>

  <!-- Customer Cases -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Typical Hydraulic Oil Press Installations in Egypt</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Beheira</span>
            <span class="text-steel-500 text-xs">Sesame &amp; Tahini</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Sesame Oil &amp; Tahini Producer — Nile Delta</p>
          <p class="text-sm text-steel-600 mb-3">HN325 pressing carefully roasted sesame to supply the tahini and halawa industry in Beheira, Egypt's sesame-processing heartland.</p>
          <div class="text-xs text-amber-600 font-medium">Yield: 46-50%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Fayoum</span>
            <span class="text-steel-500 text-xs">Sunflower Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Sunflower Oil Mill — Fayoum</p>
          <p class="text-sm text-steel-600 mb-3">HN365 processing locally grown sunflower seed for bulk cooking oil distributed through Cairo and Upper Egypt markets.</p>
          <div class="text-xs text-amber-600 font-medium">Output: ~500 kg/day</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Ismailia</span>
            <span class="text-steel-500 text-xs">Olive &amp; Cold Press</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Olive Oil Processor — Ismailia</p>
          <p class="text-sm text-steel-600 mb-3">HN426 cold-press model handling small-batch desert olives and second-press olive pomace for blended oils.</p>
          <div class="text-xs text-amber-600 font-medium">Cold-press configuration</div>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-6 text-center">Representative regional installations; actual configurations and outputs vary by seed preparation and buyer requirements.</p>
    </div>
  </section>

  <!-- Recommended Products -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-10">Recommended Hydraulic Oil Presses for Egypt</h2>
      <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Core Hydraulic Presses</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {mainProducts.map(product => (
            <a
              href={`/products/${product.slug}/`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img loading="lazy"
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
      </div>
      {auxProducts.length > 0 && (
        <>
          <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Matching Equipment</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {auxProducts.map(product => (
              <a
                href={`/products/${product.slug}/`}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img loading="lazy"
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                  <div class="flex flex-wrap gap-2">
                    {product.data.specifications.slice(0, 2).map(spec => (
                      <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                        {spec.name}: {spec.value}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">Get a Customized Oil Press Quote for Egypt</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">We provide competitive factory-direct pricing for all our oil press machines. Request a formal quotation in EGP or USD, including shipping to Alexandria/Port Said and estimated clearing costs.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🏭</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Factory-Direct Pricing</h3>
          <p class="text-steel-600 text-sm">No middleman markup &save compared to local distributors (actual savings vary)</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Complete Quotation</h3>
          <p class="text-steel-600 text-sm">Machine price + shipping + estimated duties all included</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Quote in EGP</h3>
          <p class="text-steel-600 text-sm">We can quote in Egyptian Pound at current exchange rates</p>
        </div>
      </div>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get Factory Price
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Shipping Your Oil Press to Egypt</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Port</h3>
          <p class="text-steel-600">Alexandria / Port Said</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Transit Time</h3>
          <p class="text-steel-600">20-24 days from China</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Shipping Cost</h3>
          <p class="text-steel-600">Ask us for current rates</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Oil Press Buying FAQ for Egypt</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Oil Press Business in Egypt?</h2>
      <p class="text-steel-300 text-lg mb-8">Get a free quotation in EGP, shipping estimate to Alexandria, and professional equipment recommendation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Get Factory Price
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
