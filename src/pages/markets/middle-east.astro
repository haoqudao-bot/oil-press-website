﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const middleEastSeeds = ['sesame', 'walnut', 'olive'];
const seedProducts = allProducts.filter(p =>
  p.data.applicableSeeds.some(s => middleEastSeeds.some(ns => s.toLowerCase().includes(ns)))
).slice(0, 4);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Markets', item: 'https://www.hydoilpress.com/markets' },
    { '@type': 'ListItem', position: 3, name: 'Middle East', item: 'https://www.hydoilpress.com/markets/middle-east' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is the oil press machine halal-certified?',
      acceptedAnswer: { '@type': 'Answer', text: 'Our machines are manufactured from food-grade materials and produce 100% pure, natural oil with no chemical processing. The cold press method is inherently halal as it involves only mechanical extraction. We can provide material certificates and factory documentation to support halal certification of your oil products.' },
    },
    {
      '@type': 'Question',
      name: 'Can the machine produce cold-pressed sesame oil (tahini oil)?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, our HN426 Cold Press model is specifically designed for cold pressing sesame at temperatures below 60°C. This preserves the natural flavor and nutritional value of sesame oil, which is highly valued in Middle Eastern cuisine and traditional medicine.' },
    },
    {
      '@type': 'Question',
      name: 'How long does shipping take to Saudi Arabia and UAE?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from Qingdao, China to Jeddah Islamic Port (Saudi Arabia) or Jebel Ali Port (Dubai, UAE) takes 20-25 days. We handle all export documentation including certificate of origin. Contact us for current shipping rates.' },
    },
    {
      '@type': 'Question',
      name: 'Can the machine press olives for extra virgin olive oil?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, our cold press hydraulic press can be used for the final pressing step in olive oil production. The HN426 model maintains temperatures below 27°C, which is required for extra virgin olive oil (EVOO) classification. Additional equipment for olive crushing and malaxation is also available.' },
    },
    {
      '@type': 'Question',
      name: 'What voltage is required for Middle East countries?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most Middle East countries use 220V/50Hz (UAE, Iran, Iraq) or 220V/60Hz (Saudi Arabia). Haonuo customizes the electrical system for your specific country at no extra charge. Simply specify your location when ordering.' },
    },
  ],
};

const faqs = [
  { question: 'Is the oil press machine halal-certified?', answer: 'Our machines are manufactured from food-grade materials and produce 100% pure, natural oil with no chemical processing. The cold press method is inherently halal as it involves only mechanical extraction. We can provide material certificates and factory documentation to support halal certification of your oil products.' },
  { question: 'Can the machine produce cold-pressed sesame oil (tahini oil)?', answer: 'Yes, our HN426 Cold Press model is specifically designed for cold pressing sesame at temperatures below 60°C. This preserves the natural flavor and nutritional value of sesame oil, which is highly valued in Middle Eastern cuisine and traditional medicine.' },
  { question: 'How long does shipping take to Saudi Arabia and UAE?', answer: 'Sea freight from Qingdao, China to Jeddah Islamic Port (Saudi Arabia) or Jebel Ali Port (Dubai, UAE) takes 20-25 days. We handle all export documentation including certificate of origin. Contact us for current shipping rates.' },
  { question: 'Can the machine press olives for extra virgin olive oil?', answer: 'Yes, our cold press hydraulic press can be used for the final pressing step in olive oil production. The HN426 model maintains temperatures below 27°C, which is required for extra virgin olive oil (EVOO) classification. Additional equipment for olive crushing and malaxation is also available.' },
  { question: 'What voltage is required for Middle East countries?', answer: 'Most Middle East countries use 220V/50Hz (UAE, Iran, Iraq) or 220V/60Hz (Saudi Arabia). Haonuo customizes the electrical system for your specific country at no extra charge. Simply specify your location when ordering.' },
];
---

<BaseLayout
  title="Hydraulic Oil Press Middle East | Haonuo"
  description="Professional hydraulic oil press machine for Middle East markets. Cold press technology for sesame, walnut, and olive oil. Factory-direct pricing. Shipping to Jeddah/Dubai 20-25 days. 1-year warranty."
  keywords={['oil press machine Middle East', 'sesame oil press machine', 'walnut oil press machine', 'olive oil press machine', 'cold press oil machine Saudi Arabia', 'hydraulic oil press UAE']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/markets" class="hover:text-amber-500 transition-colors">Markets</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Middle East</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Hydraulic Oil Press Middle East — Factory Direct</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Cold press hydraulic oil machines for sesame, walnut, and olive oil production. Factory-direct pricing, shipping to Jeddah and Dubai in 20-25 days, 1-year warranty.</p>
    </div>
  </section>

  <!-- Popular Oilseeds in Middle East -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Popular Oilseeds in the Middle East</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫘</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sesame</h3>
          <p class="text-sm text-steel-600 mb-3">Sesame oil is a staple in Middle Eastern cuisine and traditional medicine. Cold-pressed sesame oil (tahini oil) commands premium prices across the region.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 42-54%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌰</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Walnut</h3>
          <p class="text-sm text-steel-600 mb-3">Walnut oil is prized for its omega-3 content and rich flavor. Central Asia and the Middle East are major consumers of premium cold-pressed walnut oil.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 50-62%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫒</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Olive</h3>
          <p class="text-sm text-steel-600 mb-3">Extra virgin olive oil production is growing rapidly in Saudi Arabia, Jordan, and Tunisia. Cold pressing below 27°C is essential for EVOO classification.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 12-26%</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recommended Products -->
  {seedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">Recommended Machines for the Middle East</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {seedProducts.map(product => (
            <a
              href={`/products/${product.slug}`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">Get a Customized Quote for the Middle East</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">We provide competitive factory-direct pricing for all our oil press machines. Get a formal quotation in SAR or USD, including shipping to Jeddah or Dubai.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🏭</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Factory-Direct Pricing</h3>
          <p class="text-steel-600 text-sm">No middleman markup &save compared to local distributors (actual savings vary)</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Complete Quotation</h3>
          <p class="text-steel-600 text-sm">Machine price + shipping + estimated duties all included</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Quote in SAR</h3>
          <p class="text-steel-600 text-sm">We can quote in SAR or your preferred currency</p>
        </div>
      </div>
      <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Request a Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Shipping to the Middle East</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Ports</h3>
          <p class="text-steel-600">Jeddah Islamic Port / Jebel Ali (Dubai)</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Transit Time</h3>
          <p class="text-steel-600">20-25 days from China</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Shipping Cost</h3>
          <p class="text-steel-600">Request current rates</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Premium Oil Business?</h2>
      <p class="text-steel-300 text-lg mb-8">Request a free quotation, shipping estimate to Jeddah or Dubai, and professional equipment recommendation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Get a Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="https://wa.me/8618957149128?text=Hello%20Haonuo%2C%20I%20am%20interested%20in%20oil%20press%20machine%20for%20the%20Middle%20East" target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white font-semibold px-8 py-4 rounded-lg hover:bg-green-500 transition-colors text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
