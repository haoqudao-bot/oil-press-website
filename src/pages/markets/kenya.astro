---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMarketProducts } from '../../data/market-products';

const allProducts = await getCollection('products');
const kenyaSeeds = ['sunflower', 'peanut', 'sesame', 'cottonseed'];
const { mainProducts, auxProducts } = getMarketProducts(allProducts, kenyaSeeds);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Markets', item: 'https://www.hydoilpress.com/markets' },
    { '@type': 'ListItem', position: 3, name: 'Kenya', item: 'https://www.hydoilpress.com/markets/kenya' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the price of an oil press machine in Kenya?',
      acceptedAnswer: { '@type': 'Answer', text: 'Contact us for a customized quote for a complete Haonuo oil press setup including shipping to Mombasa. We provide competitive factory-direct pricing and can quote in KES (Kenyan Shilling) at current exchange rates.' },
    },
    {
      '@type': 'Question',
      name: 'What voltage does the oil press machine use in Kenya?',
      acceptedAnswer: { '@type': 'Answer', text: 'Haonuo oil press machines are customized for Kenya\'s 240V/50Hz power standard. Our motors are configured to match local electrical requirements, ensuring safe and efficient operation on both mains power and generator supply.' },
    },
    {
      '@type': 'Question',
      name: 'How long does shipping take to Mombasa, Kenya?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from Qingdao, China to Mombasa port takes 25-30 days. We handle all export documentation and can arrange CIF shipping for your convenience. Contact us for current shipping rates.' },
    },
    {
      '@type': 'Question',
      name: 'Is sunflower oil production profitable in Kenya?',
      acceptedAnswer: { '@type': 'Answer', text: 'It can be profitable, depending on factors like raw material costs, local oil prices, and production volume. Kenya\'s commercial sunflower oil sector is growing. With Haonuo hydraulic cold press machines, you can produce high-quality cold-pressed sunflower oil that may command premium prices in the Kenyan market. Actual returns vary significantly by operator.' },
    },
    {
      '@type': 'Question',
      name: 'Can the oil press machine work with a generator in Kenya?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Haonuo hydraulic oil presses require only 2.2 KW of motor power, making them fully compatible with a 5-7 KVA generator. This is well-suited for areas in Kenya with unreliable grid power. We customize the electrical system for 240V/50Hz to match Kenyan power standards.' },
    },
  ],
};

const faqs = [
  { question: 'What is the price of an oil press machine in Kenya?', answer: 'Contact us for a customized quote for a complete Haonuo oil press setup including shipping to Mombasa. We provide competitive factory-direct pricing and can quote in KES (Kenyan Shilling) at current exchange rates.' },
  { question: 'What voltage does the oil press machine use in Kenya?', answer: 'Haonuo oil press machines are customized for Kenya\'s 240V/50Hz power standard. Our motors are configured to match local electrical requirements, ensuring safe and efficient operation on both mains power and generator supply.' },
  { question: 'How long does shipping take to Mombasa, Kenya?', answer: 'Sea freight from Qingdao, China to Mombasa port takes 25-30 days. We handle all export documentation and can arrange CIF shipping for your convenience. Contact us for current shipping rates.' },
  { question: 'Is sunflower oil production profitable in Kenya?', answer: 'It can be profitable, depending on factors like raw material costs, local oil prices, and production volume. Kenya\'s commercial sunflower oil sector is growing. With Haonuo hydraulic cold press machines, you can produce high-quality cold-pressed sunflower oil that may command premium prices. Actual returns vary significantly by operator.' },
  { question: 'Can the oil press machine work with a generator in Kenya?', answer: 'Yes. Haonuo hydraulic oil presses require only 2.2 KW of motor power, making them fully compatible with a 5-7 KVA generator. This is well-suited for areas in Kenya with unreliable grid power. We customize the electrical system for 240V/50Hz to match Kenyan power standards.' },
];
---

<BaseLayout
  title="Hydraulic Oil Press Machine in Kenya — Factory Direct"
  description="Oil press machine in Kenya for sunflower, sesame and peanut. KEBS PVoC certificate arranged before shipment; 415V/50Hz, shipping to Mombasa. Request a quote."
  keywords={['oil press machine Kenya', 'oil press machine price Kenya', 'sunflower oil press Kenya', 'hydraulic oil press Kenya']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/markets/" class="hover:text-amber-500 transition-colors">Markets</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Kenya</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Oil Press Machine in Kenya — Factory Direct</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Hydraulic oil press machines for sunflower, peanut, sesame, and cottonseed oil production. Factory-direct pricing, shipping to Mombasa in 25-30 days, 1-year warranty.</p>
    </div>
  </section>

  <!-- Popular Oilseeds in Kenya -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Popular Oilseeds for Hydraulic Pressing in Kenya</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌻</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sunflower</h3>
          <p class="text-sm text-steel-600 mb-3">Growing commercial sector across Rift Valley and Western Kenya. Premium cold-pressed oil in high demand.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 35-45%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🥜</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Peanut</h3>
          <p class="text-sm text-steel-600 mb-3">Popular cooking oil in Kenyan households. Groundnut oil with rich flavor for traditional dishes and commercial use.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 38-45%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫘</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sesame</h3>
          <p class="text-sm text-steel-600 mb-3">Significant export potential. Premium cold-pressed sesame oil for both local market and international export.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 42-50%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">☁️</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Cottonseed</h3>
          <p class="text-sm text-steel-600 mb-3">Byproduct of cotton farming in Eastern and Coastal regions. Affordable cooking oil with versatile applications.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 15-34%</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PVoC Compliance -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4">PVoC Compliance: The Certificate That Travels With Your Oil Press</h2>
      <p class="text-center text-steel-600 mb-12 max-w-3xl mx-auto">Regulated imports into Kenya need a Certificate of Conformity under the <strong>KEBS Pre-Export Verification of Conformity (PVoC)</strong> programme. The critical word is <em>pre-export</em>: inspection happens at our works before the container is sealed — not at Mombasa.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <div>
          <h3 class="font-display font-bold text-xl mb-5 text-charcoal-900">How the process works</h3>
          <div class="space-y-4">
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">1</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Request inspection early.</span> Once the machine is built and before loading, your importer books PVoC inspection with an authorised KEBS agent (Intertek, SGS, Bureau Veritas or QIMA).</p>
            </div>
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">2</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Factory verification.</span> The agent checks the machine against applicable standards and reviews the technical file: test report, motor and electrical specification, nameplate, and CE documentation where held.</p>
            </div>
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">3</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">CoC issued.</span> The Certificate of Conformity is issued electronically and the original accompanies the invoice, packing list and bill of lading.</p>
            </div>
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">4</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Clearance.</span> KRA assesses duty and 16% VAT at Mombasa port; containers can then move to the ICD in Nairobi or Naivasha, or directly to your site.</p>
            </div>
          </div>
        </div>
        <div class="space-y-6">
          <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
            <p class="text-charcoal-900 text-sm font-medium mb-2">Why the timing matters</p>
            <p class="text-steel-700 text-sm">Goods arriving without a valid CoC face penalties, costly destination inspection, or return to origin — the most expensive mistake first-time Kenyan importers make. We coordinate the inspector's visit to our works so the certificate is issued before shipment.</p>
          </div>
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
            <p class="text-charcoal-900 text-sm font-medium mb-2">Kenyan power specification</p>
            <p class="text-steel-700 text-sm">Industrial three-phase supply in Kenya is 415V, 50Hz. Motor and control specifications are confirmed at order stage, and the machines operate from generator power when needed — see the <a href="/resources/oil-press-electrical-requirements-guide/" class="text-amber-700 underline">electrical requirements guide</a>.</p>
          </div>
          <p class="text-xs text-steel-500">PVoC scope and routes are revised by KEBS from time to time — confirm the current category requirements with your clearing agent before ordering.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer Cases -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Typical Hydraulic Oil Press Installations in Kenya</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Nakuru</span>
            <span class="text-steel-500 text-xs">Sunflower Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Sunflower Oil Producer — Rift Valley</p>
          <p class="text-sm text-steel-600 mb-3">HN325 serving smallholder sunflower cooperatives around Nakuru, pressing in short campaigns during the harvest season.</p>
          <div class="text-xs text-amber-600 font-medium">Capacity: ~40 kg/batch</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Kakamega</span>
            <span class="text-steel-500 text-xs">Groundnut Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Groundnut Oil Mill — Western Kenya</p>
          <p class="text-sm text-steel-600 mb-3">HN365 producing roasted-groundnut oil for open-air markets and supermarket shelves in Kakamega and Kisumu.</p>
          <div class="text-xs text-amber-600 font-medium">Output: ~450 kg/day</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Meru</span>
            <span class="text-steel-500 text-xs">Sesame Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Sesame Oil Processor — Eastern Kenya</p>
          <p class="text-sm text-steel-600 mb-3">HN426 cold-pressing golden sesame from the Meru/Tharaka region for health-food buyers in Nairobi.</p>
          <div class="text-xs text-amber-600 font-medium">Yield: 44-48%</div>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-6 text-center">Representative regional installations; actual configurations and outputs vary by seed preparation and buyer requirements.</p>
    </div>
  </section>

  <!-- Recommended Products -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-10">Recommended Hydraulic Oil Presses for Kenya</h2>
      <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Core Hydraulic Presses</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {mainProducts.map(product => (
            <a
              href={`/products/${product.slug}/`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img loading="lazy"
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
      </div>
      {auxProducts.length > 0 && (
        <>
          <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Matching Equipment</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {auxProducts.map(product => (
              <a
                href={`/products/${product.slug}/`}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img loading="lazy"
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                  <div class="flex flex-wrap gap-2">
                    {product.data.specifications.slice(0, 2).map(spec => (
                      <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                        {spec.name}: {spec.value}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">Get a Customized Oil Press Quote for Kenya</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">We provide competitive factory-direct pricing for all our oil press machines. Request a formal quotation in KES or USD, including shipping to Mombasa and estimated clearing costs.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🏭</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Factory-Direct Pricing</h3>
          <p class="text-steel-600 text-sm">No middleman markup &save compared to local distributors (actual savings vary)</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Complete Quotation</h3>
          <p class="text-steel-600 text-sm">Machine price + shipping + estimated duties all included</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Quote in KES</h3>
          <p class="text-steel-600 text-sm">We can quote in Kenyan Shilling at current exchange rates</p>
        </div>
      </div>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get Factory Price
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Shipping Your Oil Press to Kenya</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Port</h3>
          <p class="text-steel-600">Mombasa</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Transit Time</h3>
          <p class="text-steel-600">25-30 days from China</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Shipping Cost</h3>
          <p class="text-steel-600">Ask us for current rates</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Oil Press Buying FAQ for Kenya</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Oil Press Business in Kenya?</h2>
      <p class="text-steel-300 text-lg mb-8">Get a free quotation in KES, shipping estimate to Mombasa, and professional equipment recommendation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Get Factory Price
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
