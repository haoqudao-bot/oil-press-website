---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMarketProducts } from '../../data/market-products';

const allProducts = await getCollection('products');
const southAfricaSeeds = ['sunflower', 'peanut', 'soybean', 'canola', 'rapeseed'];
const { mainProducts, auxProducts } = getMarketProducts(allProducts, southAfricaSeeds);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Markets', item: 'https://www.hydoilpress.com/markets' },
    { '@type': 'ListItem', position: 3, name: 'South Africa', item: 'https://www.hydoilpress.com/markets/south-africa' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the price of an oil press machine in South Africa?',
      acceptedAnswer: { '@type': 'Answer', text: 'Contact us for a customized quote for a complete Haonuo oil press setup including shipping to Durban or Cape Town. We provide competitive factory-direct pricing and can quote in ZAR (South African Rand) at current exchange rates.' },
    },
    {
      '@type': 'Question',
      name: 'What voltage does the oil press machine use in South Africa?',
      acceptedAnswer: { '@type': 'Answer', text: 'Haonuo oil press machines are customized for South Africa\'s 220V/50Hz power standard. Our motors are configured to match local electrical requirements, ensuring safe and efficient operation.' },
    },
    {
      '@type': 'Question',
      name: 'How long does shipping take to Durban, South Africa?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from Qingdao, China to Durban or Cape Town takes 22-26 days. We handle all export documentation and can arrange CIF shipping for your convenience. Contact us for current shipping rates.' },
    },
    {
      '@type': 'Question',
      name: 'What is the oil yield for sunflower seeds in South Africa?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sunflower is South Africa\'s #1 oil crop. With Haonuo hydraulic cold press machines, you can achieve 35-45% oil yield from sunflower seeds, producing high-quality cold-pressed sunflower oil that commands premium prices in the local market.' },
    },
    {
      '@type': 'Question',
      name: 'What are the import procedures for oil press machines in South Africa?',
      acceptedAnswer: { '@type': 'Answer', text: 'Oil press machines are classified under HS code 8479.82. South Africa requires an import permit from ITAC (International Trade Administration Commission). We provide all necessary documentation including certificates of origin, commercial invoices, and packing lists to facilitate smooth customs clearance.' },
    },
  ],
};

const faqs = [
  { question: 'What is the price of an oil press machine in South Africa?', answer: 'Contact us for a customized quote for a complete Haonuo oil press setup including shipping to Durban or Cape Town. We provide competitive factory-direct pricing and can quote in ZAR (South African Rand) at current exchange rates.' },
  { question: 'What voltage does the oil press machine use in South Africa?', answer: 'Haonuo oil press machines are customized for South Africa\'s 220V/50Hz power standard. Our motors are configured to match local electrical requirements, ensuring safe and efficient operation.' },
  { question: 'How long does shipping take to Durban, South Africa?', answer: 'Sea freight from Qingdao, China to Durban or Cape Town takes 22-26 days. We handle all export documentation and can arrange CIF shipping for your convenience. Contact us for current shipping rates.' },
  { question: 'What is the oil yield for sunflower seeds in South Africa?', answer: 'Sunflower is South Africa\'s #1 oil crop. With Haonuo hydraulic cold press machines, you can achieve 35-45% oil yield from sunflower seeds, producing high-quality cold-pressed sunflower oil that commands premium prices in the local market.' },
  { question: 'What are the import procedures for oil press machines in South Africa?', answer: 'Oil press machines are classified under HS code 8479.82. South Africa requires an import permit from ITAC (International Trade Administration Commission). We provide all necessary documentation including certificates of origin, commercial invoices, and packing lists to facilitate smooth customs clearance.' },
];
---

<BaseLayout
  title="Oil Press Machine South Africa"
  description="Oil press machine in South Africa for sunflower, soybean and canola. NRCS LOA technical file supplied, 400V/50Hz builds, shipping to Durban. Request a quote."
  keywords={['oil press machine South Africa', 'oil press machine price South Africa', 'sunflower oil press machine South Africa', 'hydraulic oil press South Africa']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/markets/" class="hover:text-amber-500 transition-colors">Markets</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">South Africa</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Oil Press Machine in South Africa — Factory Direct</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Hydraulic oil press machines for sunflower, peanut, soybean, and canola oil production. Factory-direct pricing, shipping to Durban in 22-26 days, 1-year warranty.</p>
    </div>
  </section>

  <!-- Popular Oilseeds in South Africa -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Popular Oilseeds in South Africa</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌻</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sunflower</h3>
          <p class="text-sm text-steel-600 mb-3">South Africa's #1 oil crop. Widely grown in Free State and North West provinces for premium cooking oil.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 35-45%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🥜</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Peanut</h3>
          <p class="text-sm text-steel-600 mb-3">Popular cooking oil across South Africa. Rich nutty flavor well-suited for traditional cuisine and food manufacturing.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 38-45%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫘</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Soybean</h3>
          <p class="text-sm text-steel-600 mb-3">Growing demand for soybean oil in food processing and animal feed industries across the country.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 15-20%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌱</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Canola/Rapeseed</h3>
          <p class="text-sm text-steel-600 mb-3">Western Cape's winter crop. High-quality canola oil for health-conscious consumers and export markets.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 35-40%</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Electrical Compliance: NRCS LOA -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4">Electrical Compliance &amp; Port Entry: NRCS Letter of Authority</h2>
      <p class="text-center text-steel-600 mb-12 max-w-3xl mx-auto">Electrical machinery imported into South Africa can require a <strong>Letter of Authority (LOA)</strong> from the National Regulator for Compulsory Specifications (NRCS) under the applicable SANS standard <em>before customs release</em>. Buyers who discover this at Durban harbour pay storage while the application catches up.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">1 · Confirm LOA scope early</h3>
          <p class="text-steel-700 text-sm">Ask the NRCS or your import broker whether the press and its electrical controls fall under the relevant compulsory specification. If they do, the importer — or a registered manufacturer — submits the LOA application, ideally before the machine ships.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">2 · Build the technical file</h3>
          <p class="text-steel-700 text-sm mb-3">LOA applications are supported by nameplate data, a wiring diagram, test report and a description of safety guarding. We compile this file in the format compliance agents expect.</p>
          <p class="text-steel-700 text-sm">Apply once for repeated imports of the same model where the scheme allows.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">3 · Specify the correct voltage</h3>
          <p class="text-steel-700 text-sm mb-3">South African industrial three-phase supply is <strong>400V, 50Hz</strong> — close to, but not the same as, nominal 380V grids. Motors and controls are built to order against your confirmed supply.</p>
          <p class="text-steel-700 text-sm">See the <a href="/resources/oil-press-electrical-requirements-guide/" class="text-amber-600 hover:underline">electrical requirements guide</a> for site preparation.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
          <p class="text-charcoal-900 text-sm font-medium mb-2">Ports and duty</p>
          <p class="text-steel-700 text-sm">Machinery most often enters through Durban, with Cape Town and Gqeberha (Port Elizabeth) as alternatives. SARS assesses duty and 15% VAT on the SAD501 entry; registered importers can normally reclaim input VAT.</p>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
          <p class="text-charcoal-900 text-sm font-medium mb-2">Installation note</p>
          <p class="text-steel-700 text-sm">South African insurers and factories may expect a site Certificate of Compliance for the installed wiring from a registered electrician — brief your contractor before the machine arrives.</p>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-4 text-center">NRCS scope changes as standards are updated — confirm whether an LOA applies to the exact model with your importer before placing the order.</p>
    </div>
  </section>

  <!-- Customer Cases -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Typical Installations in South Africa</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Free State</span>
            <span class="text-steel-500 text-xs">Sunflower Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Sunflower Oil Producer — Free State</p>
          <p class="text-sm text-steel-600 mb-3">HN365 processing the Free State sunflower harvest for artisanal cooking-oil brands sold at farm stalls and delis.</p>
          <div class="text-xs text-amber-600 font-medium">Output: ~500 kg/day</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Limpopo</span>
            <span class="text-steel-500 text-xs">Groundnut Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Groundnut Oil Mill — Limpopo</p>
          <p class="text-sm text-steel-600 mb-3">HN325 cold-pressing groundnuts for farmers-market and health-shop channels in Polokwane and surrounding towns.</p>
          <div class="text-xs text-amber-600 font-medium">Cold-press configuration</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Western Cape</span>
            <span class="text-steel-500 text-xs">Olive Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Olive Oil Processor — Western Cape</p>
          <p class="text-sm text-steel-600 mb-3">HN426 cold-press unit for boutique olive oil and olive-pomace extraction at small wineland and Karoo estates.</p>
          <div class="text-xs text-amber-600 font-medium">Boutique cold press</div>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-6 text-center">Representative regional installations; actual configurations and outputs vary by seed preparation and buyer requirements.</p>
    </div>
  </section>

  <!-- Recommended Products -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-10">Recommended Machines for South Africa</h2>
      <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Core Hydraulic Presses</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {mainProducts.map(product => (
            <a
              href={`/products/${product.slug}/`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img loading="lazy"
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
      </div>
      {auxProducts.length > 0 && (
        <>
          <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Matching Equipment</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {auxProducts.map(product => (
              <a
                href={`/products/${product.slug}/`}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img loading="lazy"
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                  <div class="flex flex-wrap gap-2">
                    {product.data.specifications.slice(0, 2).map(spec => (
                      <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                        {spec.name}: {spec.value}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">Get a Customized Quote for South Africa</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">We provide competitive factory-direct pricing for all our oil press machines. Request a formal quotation in ZAR or USD, including shipping to Durban/Cape Town and estimated clearing costs.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🏭</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Factory-Direct Pricing</h3>
          <p class="text-steel-600 text-sm">No middleman markup &save compared to local distributors (actual savings vary)</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Complete Quotation</h3>
          <p class="text-steel-600 text-sm">Machine price + shipping + estimated duties all included</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Quote in ZAR</h3>
          <p class="text-steel-600 text-sm">We can quote in South African Rand at current exchange rates</p>
        </div>
      </div>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get Factory Price
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Shipping to South Africa</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Port</h3>
          <p class="text-steel-600">Durban / Cape Town</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Transit Time</h3>
          <p class="text-steel-600">22-26 days from China</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Shipping Cost</h3>
          <p class="text-steel-600">Ask us for current rates</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Oil Business in South Africa?</h2>
      <p class="text-steel-300 text-lg mb-8">Get a free quotation in ZAR, shipping estimate to Durban/Cape Town, and professional equipment recommendation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Get Factory Price
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
