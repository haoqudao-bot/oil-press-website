---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMarketProducts } from '../../data/market-products';

const allProducts = await getCollection('products');
const pakistanSeeds = ['sesame', 'mustard', 'peanut', 'cottonseed', 'sunflower'];
const { mainProducts, auxProducts } = getMarketProducts(allProducts, pakistanSeeds);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Markets', item: 'https://www.hydoilpress.com/markets' },
    { '@type': 'ListItem', position: 3, name: 'Pakistan', item: 'https://www.hydoilpress.com/markets/pakistan' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the price of oil press machine in Pakistan?',
      acceptedAnswer: { '@type': 'Answer', text: 'Contact Haonuo for factory-direct pricing for the Pakistani market. We offer competitive rates with shipping to Karachi included. Pricing available in PKR.' },
    },
    {
      '@type': 'Question',
      name: 'Can the machine extract sunflower oil efficiently?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, Haonuo hydraulic oil presses achieve 35-45% oil yield from sunflower seeds. The cold press method preserves the light flavor preferred in Pakistani cooking.' },
    },
    {
      '@type': 'Question',
      name: 'What voltage is compatible in Pakistan?',
      acceptedAnswer: { '@type': 'Answer', text: 'We customize all machines for 220V/50Hz to match Pakistani electrical standards. Our machines only need 2.2 KW, compatible with a 5 KVA generator.' },
    },
    {
      '@type': 'Question',
      name: 'How long does shipping take to Pakistan?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from Qingdao to Karachi takes 20-25 days. We handle all export documentation and can arrange CIF shipping.' },
    },
    {
      '@type': 'Question',
      name: 'Is there import duty on oil press machines in Pakistan?',
      acceptedAnswer: { '@type': 'Answer', text: 'Oil press machines fall under specific HS codes. We provide complete documentation including certificate of origin to help your customs agent minimize duty. Contact us for guidance on Pakistan import procedures.' },
    },
  ],
};

const faqs = [
  { question: 'What is the price of oil press machine in Pakistan?', answer: 'Contact Haonuo for factory-direct pricing for the Pakistani market. We offer competitive rates with shipping to Karachi included. Pricing available in PKR.' },
  { question: 'Can the machine extract sunflower oil efficiently?', answer: 'Yes, Haonuo hydraulic oil presses achieve 35-45% oil yield from sunflower seeds. The cold press method preserves the light flavor preferred in Pakistani cooking.' },
  { question: 'What voltage is compatible in Pakistan?', answer: 'We customize all machines for 220V/50Hz to match Pakistani electrical standards. Our machines only need 2.2 KW, compatible with a 5 KVA generator.' },
  { question: 'How long does shipping take to Pakistan?', answer: 'Sea freight from Qingdao to Karachi takes 20-25 days. We handle all export documentation and can arrange CIF shipping.' },
  { question: 'Is there import duty on oil press machines in Pakistan?', answer: 'Oil press machines fall under specific HS codes. We provide complete documentation including certificate of origin to help your customs agent minimize duty. Contact us for guidance on Pakistan import procedures.' },
];
---

<BaseLayout
  title="Oil Press Machine in Pakistan"
  description="Oil press machine in Pakistan for sunflower, mustard and sesame. WeBOC clearance and inspection support, 220-240V, shipping to Karachi. Request a quote."
  keywords={['oil press machine in Pakistan', 'oil press machine price in Pakistan', 'sunflower oil press machine Pakistan', 'mustard oil press Pakistan', 'hydraulic oil press Pakistan', 'oil extraction machine Pakistan price']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/markets/" class="hover:text-amber-500 transition-colors">Markets</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Pakistan</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Oil Press Machine in Pakistan — Factory Direct</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Hydraulic oil press machines for sunflower, mustard, sesame, and cottonseed oil production. Factory-direct pricing, shipping to Karachi in 20-25 days, 1-year warranty.</p>
    </div>
  </section>

  <!-- Popular Oilseeds in Pakistan -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Popular Oilseeds in Pakistan</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌻</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sunflower</h3>
          <p class="text-sm text-steel-600 mb-3">Pakistan's fastest-growing oil crop. Punjab and Sindh provinces major producers.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 35-45%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🟡</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Mustard/Rapeseed</h3>
          <p class="text-sm text-steel-600 mb-3">Traditional cooking oil for Pakistani cuisine. Cold-pressed sarson oil in high demand.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 30-38%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫘</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Sesame</h3>
          <p class="text-sm text-steel-600 mb-3">Premium cold-pressed sesame oil for cooking and halwa production. Export potential to Middle East.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 42-50%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">☁️</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Cottonseed</h3>
          <p class="text-sm text-steel-600 mb-3">Pakistan is the 4th largest cotton producer. Abundant cottonseed for affordable cooking oil.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 15-34%</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customs Clearance -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4">Importing Into Pakistan: WeBOC, Inspection &amp; Karachi Ports</h2>
      <p class="text-center text-steel-600 mb-12 max-w-3xl mx-auto">Machinery consignments clear through Pakistan Customs' <strong>WeBOC</strong> electronic system, supported by complete manufacturer documentation and — depending on category and tariff regime — pre-shipment inspection. Prepared paperwork keeps container demurrage at Karachi terminals to zero.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <div>
          <h3 class="font-display font-bold text-xl mb-5 text-charcoal-900">Clearance sequence</h3>
          <div class="space-y-4">
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">1</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Goods Declaration.</span> Your clearing agent files the GD in WeBOC against the correct heading (presses of this type commonly fall near HS 8479.82), attaching invoice, packing list and bill of lading.</p>
            </div>
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">2</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Pre-shipment inspection.</span> Where applicable, an inspection certificate from an accredited company is required; coverage varies, so confirm current PSI requirements with your agent before shipment.</p>
            </div>
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">3</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Compliance file.</span> Manufacturer test report, motor and electrical specification, nameplate, and CE certificates where held. PSQCA is the national standards body your agent may consult on category questions.</p>
            </div>
            <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
              <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">4</div>
              <p class="text-steel-700 text-sm pt-1"><span class="font-semibold text-charcoal-900">Assessment and delivery.</span> After duty assessment and release at Karachi Port (KICT/PICT) or Port Qasim, inland trucking reaches Lahore, Faisalabad, Multan, Hyderabad or Peshawar.</p>
            </div>
          </div>
        </div>
        <div class="space-y-6">
          <div class="bg-white rounded-2xl p-6 border border-steel-100">
            <h3 class="font-semibold text-lg mb-3 text-charcoal-900">Documentation we supply</h3>
            <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
              <li>Signed commercial invoice and detailed packing list</li>
              <li>Original / telex bill of lading</li>
              <li>Factory test report and pressure documentation</li>
              <li>Electrical nameplate, motor data and wiring information</li>
              <li>CE and inspection certificates where the route requires them</li>
            </ul>
          </div>
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
            <p class="text-charcoal-900 text-sm font-medium mb-2">Power &amp; parts support</p>
            <p class="text-steel-700 text-sm">Pakistani industrial supply is 220–240V, 50Hz three-phase, matching our standard build. Seal kits and filter cloths ship as air parcels to Karachi or Lahore within days, so planned spares rarely mean long stops.</p>
          </div>
          <p class="text-xs text-steel-500">Tariff and PSI coverage changes with each finance measure — confirm the current position with a WeBOC-registered clearing agent before ordering.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer Cases -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Typical Installations in Pakistan</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Faisalabad</span>
            <span class="text-steel-500 text-xs">Mustard (Sarsoon) Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Mustard Oil Mill — Punjab</p>
          <p class="text-sm text-steel-600 mb-3">HN365 traditional cold pressing for pungent sarsoon ka tel, the staple cooking oil across Punjab's household and wholesale markets.</p>
          <div class="text-xs text-amber-600 font-medium">Output: ~500 kg/day</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Sindh</span>
            <span class="text-steel-500 text-xs">Sesame Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Sesame Oil Producer — Sindh</p>
          <p class="text-sm text-steel-600 mb-3">HN325 producing cold-pressed til oil for domestic buyers and regional export traders in Karachi.</p>
          <div class="text-xs text-amber-600 font-medium">Yield: 45-49%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Bahawalpur</span>
            <span class="text-steel-500 text-xs">Cottonseed Oil</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Cottonseed Oil Processor — South Punjab</p>
          <p class="text-sm text-steel-600 mb-3">HN426 pressing cottonseed from the southern Punjab cotton belt; the pressed cake is sold as livestock feed.</p>
          <div class="text-xs text-amber-600 font-medium">Cake: feed grade</div>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-6 text-center">Representative regional installations; actual configurations and outputs vary by seed preparation and buyer requirements.</p>
    </div>
  </section>

  <!-- Recommended Products -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-10">Recommended Machines for Pakistan</h2>
      <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Core Hydraulic Presses</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {mainProducts.map(product => (
            <a
              href={`/products/${product.slug}/`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img loading="lazy"
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
      </div>
      {auxProducts.length > 0 && (
        <>
          <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Matching Equipment</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {auxProducts.map(product => (
              <a
                href={`/products/${product.slug}/`}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img loading="lazy"
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                  <div class="flex flex-wrap gap-2">
                    {product.data.specifications.slice(0, 2).map(spec => (
                      <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                        {spec.name}: {spec.value}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">Get a Customized Quote for Pakistan</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">We provide competitive factory-direct pricing for all our oil press machines. Request a formal quotation in PKR or USD, including shipping to Karachi and estimated duty costs.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🏭</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Factory-Direct Pricing</h3>
          <p class="text-steel-600 text-sm">No middleman markup &save compared to local distributors (actual savings vary)</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Complete Quotation</h3>
          <p class="text-steel-600 text-sm">Machine price + shipping + estimated duties all included</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Quote in PKR</h3>
          <p class="text-steel-600 text-sm">We can quote in PKR at current exchange rates</p>
        </div>
      </div>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Get Factory Price
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Shipping to Pakistan</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Port</h3>
          <p class="text-steel-600">Karachi Port / Port Qasim</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Transit Time</h3>
          <p class="text-steel-600">20-25 days from China</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Shipping Cost</h3>
          <p class="text-steel-600">Contact for current rates</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Oil Business in Pakistan?</h2>
      <p class="text-steel-300 text-lg mb-8">Get a free quotation in PKR, shipping estimate to Karachi, and professional equipment recommendation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Get Factory Price
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
