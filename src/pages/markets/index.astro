---

<BaseLayout title="Global Markets & Regional Oil Press Solutions | Haonuo" description="Haonuo hydraulic oil press machines serve 50+ countries worldwide. Explore regional solutions, market insights, and success stories from Africa, Asia, Middle East, and beyond." keywords={['oil press machine global', 'hydraulic oil press 50 countries', 'oil press manufacturer worldwide', 'cold press machine international', 'global oil press market']} jsonLd={breadcrumbLd}>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/markets" class="hover:text-amber-500 transition-colors">Markets</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Markets</span>
      </nav>
    </div>
  </section>

  <!-- Hero Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 bg-amber-50 text-amber-700 px-4 py-2 rounded-full text-sm font-medium mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          50+ Countries & 6 Continents
        </div>
        <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-4">Hydraulic Oil Press Machine — Global Markets & Regional Solutions</h1>
        <p class="text-steel-500 text-lg max-w-3xl mx-auto">Global Reach, Local Expertise. Trusted by oil producers in 50+ countries across Africa, Asia, Middle East, South America, Europe, and Oceania. Below are our featured regional markets with dedicated support and extensive on-the-ground experience.</p>
      </div>

      <!-- Quick Stats Bar -->
      <div class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-2xl p-6 mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="text-center text-white">
            <div class="font-display text-3xl md:text-4xl font-bold mb-1">50+</div>
            <div class="text-amber-100 text-sm">Countries Served</div>
          </div>
          <div class="text-center text-white">
            <div class="font-display text-3xl md:text-4xl font-bold mb-1">6</div>
            <div class="text-amber-100 text-sm">Continents</div>
          </div>
          <div class="text-center text-white">
            <div class="font-display text-3xl md:text-4xl font-bold mb-1">2,000+</div>
            <div class="text-amber-100 text-sm">Happy Clients</div>
          </div>
          <div class="text-center text-white">
            <div class="font-display text-3xl md:text-4xl font-bold mb-1">15+</div>
            <div class="text-amber-100 text-sm">Years Export Experience</div>
          </div>
        </div>
      </div>

      <!-- Regional Stats -->
      <div class="mb-16">
        <div class="text-center mb-10">
          <h2 class="font-display text-3xl text-charcoal-900 mb-3">Regional Footprint</h2>
          <p class="text-steel-500 max-w-2xl mx-auto">Our hydraulic oil press machines are operating successfully across 6 continents. Here's a breakdown of our global presence.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {regionalStats.map((stat) => (
            <div class="bg-white rounded-xl border border-steel-100 p-6 hover:border-amber-300 transition-colors">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-display text-xl text-charcoal-900">{stat.region}</h3>
                <div class="text-2xl">{stat.countries} Countries</div>
              </div>
              <div class="flex gap-4 mb-4">
                <div>
                  <div class="font-display text-xl text-amber-600">{stat.machines}+</div>
                  <div class="text-xs text-steel-500">Machines</div>
                </div>
                <div>
                  <div class="font-display text-xl text-amber-600">{stat.clients}+</div>
                  <div class="text-xs text-steel-500">Clients</div>
                </div>
              </div>
              <p class="text-sm text-steel-600">{stat.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Featured Markets Section -->
      <div class="mb-16">
        <div class="text-center mb-10">
          <h2 class="font-display text-3xl text-charcoal-900 mb-3">Featured Regional Markets</h2>
          <p class="text-steel-500 max-w-2xl mx-auto">These are our largest markets with dedicated local support and extensive on-the-ground experience. Don't see your country? <a href="/contact" class="text-amber-600 hover:text-amber-700 font-medium underline">Contact us</a> — we ship worldwide.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featuredMarkets.map(market => (
            <a href={market.link} class="bg-white rounded-2xl border border-steel-100 overflow-hidden hover:shadow-lg transition-shadow group">
              <div class="h-48 bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center relative">
                <span class="text-8xl opacity-80">{market.flag}</span>
                <div class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="absolute bottom-3 left-3 right-3">
                  <span class="inline-block bg-black/70 text-white text-xs px-2 py-1 rounded-full">{market.marketHighlight}</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="font-display text-xl text-charcoal-900 mb-2">{market.name}</h3>
                <p class="text-steel-600 mb-4">{market.description}</p>
                
                <div class="flex flex-wrap gap-2 mb-4">
                  {market.popularSeeds.map(seed => (
                    <span class="text-xs bg-amber-50 text-amber-700 px-2 py-1 rounded-full">{seed}</span>
                  ))}
                </div>

                <div class="bg-steel-50 rounded-lg p-3 mb-4">
                  <div class="flex items-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <p class="text-xs text-steel-600">{market.caseStudy}</p>
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-3 pt-4 border-t border-steel-100">
                  <div class="text-center">
                    <div class="font-display text-lg text-charcoal-900">{market.stats.machines}</div>
                    <div class="text-xs text-steel-500">Machines</div>
                  </div>
                  <div class="text-center">
                    <div class="font-display text-lg text-charcoal-900">{market.stats.clients}</div>
                    <div class="text-xs text-steel-500">Clients</div>
                  </div>
                  <div class="text-center">
                    <div class="font-display text-lg text-charcoal-900">{market.stats.countries}</div>
                    <div class="text-xs text-steel-500">Countries</div>
                  </div>
                </div>

                <div class="mt-4 flex items-center text-amber-600 group-hover:text-amber-700 transition-colors">
                  <span class="text-sm font-medium">Explore Market</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Why Choose Haonuo Globally -->
      <div class="mb-16 bg-steel-50 rounded-2xl p-8">
        <h2 class="font-display text-2xl text-charcoal-900 mb-6 text-center">Why Haonuo is Trusted Worldwide</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="w-14 h-14 mx-auto mb-4 bg-amber-100 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3 class="font-display text-lg text-charcoal-900 mb-1">15+ Years Experience</h3>
            <p class="text-sm text-steel-600">Since 2010, we've been perfecting hydraulic oil press technology.</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 mx-auto mb-4 bg-amber-100 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3 class="font-display text-lg text-charcoal-900 mb-1">50+ Countries</h3>
            <p class="text-sm text-steel-600">Our machines are operating successfully across 6 continents.</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 mx-auto mb-4 bg-amber-100 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <h3 class="font-display text-lg text-charcoal-900 mb-1">1-year warranty</h3>
            <p class="text-sm text-steel-600">Complete peace of mind with our comprehensive warranty.</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 mx-auto mb-4 bg-amber-100 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="font-display text-lg text-charcoal-900 mb-1">24/7 Support</h3>
            <p class="text-sm text-steel-600">WhatsApp support available anytime, anywhere.</p>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="bg-charcoal-900 rounded-2xl p-8 md:p-12 text-center">
        <h2 class="font-display text-3xl text-white mb-4">Don't See Your Country Listed?</h2>
        <p class="text-steel-300 text-lg max-w-2xl mx-auto mb-8">We actively serve 50+ countries and are expanding rapidly. Chances are, we can ship to your location with full support. Contact our team to discuss your specific requirements.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-amber-500 text-charcoal-900 font-semibold rounded-xl hover:bg-amber-400 transition-colors">
            Get in Touch
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="https://wa.me/8618957149128" target="_blank" rel="noopener" class="inline-flex items-center justify-center px-8 py-4 bg-steel-700 text-white font-semibold rounded-xl hover:bg-steel-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>