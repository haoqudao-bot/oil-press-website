---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMarketProducts } from '../../data/market-products';

const allProducts = await getCollection('products');
const indonesiaSeeds = ['palm', 'coconut', 'peanut'];
const { mainProducts, auxProducts } = getMarketProducts(allProducts, indonesiaSeeds);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Markets', item: 'https://www.hydoilpress.com/markets' },
    { '@type': 'ListItem', position: 3, name: 'Indonesia', item: 'https://www.hydoilpress.com/markets/indonesia' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does an oil press machine cost in Indonesia?',
      acceptedAnswer: { '@type': 'Answer', text: 'Contact us for a Haonuo hydraulic oil press machine quote. Prices include voltage customization to 220V/50Hz for Indonesian electrical standards.' },
    },
    {
      '@type': 'Question',
      name: 'How long is shipping to Jakarta?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from Qingdao, China to Tanjung Priok Port, Jakarta takes 15-20 days. We handle all export documents. Contact us for current shipping costs.' },
    },
    {
      '@type': 'Question',
      name: 'Can the machine process coconut and palm kernel?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, Haonuo hydraulic oil presses are highly versatile and can process coconut (VCO), palm kernel, peanuts, sesame seeds, and more. Simply adjust the pressure and temperature settings for each material.' },
    },
    {
      '@type': 'Question',
      name: 'Is the machine suitable for VCO (Virgin Coconut Oil) production?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, the HN426 Cold Press model is designed specifically for cold pressing below 60°C, preserving the natural aroma and nutrients of coconut. 304 stainless steel construction is available for resistance to coconut water corrosion.' },
    },
    {
      '@type': 'Question',
      name: 'Is after-sales service available in Indonesia?',
      acceptedAnswer: { '@type': 'Answer', text: 'We provide technical support via WhatsApp, a complete English installation manual, and video tutorials. Spare parts ship within 48 hours via DHL to Jakarta. For large orders, we can send a technician for on-site installation.' },
    },
  ],
};

const faqs = [
  { question: 'How much does an oil press machine cost in Indonesia?', answer: 'Contact us for a Haonuo hydraulic oil press machine quote. Prices include voltage customization to 220V/50Hz for Indonesian electrical standards.' },
  { question: 'How long is shipping to Jakarta?', answer: 'Sea freight from Qingdao, China to Tanjung Priok Port, Jakarta takes 15-20 days. We handle all export documents. Contact us for current shipping costs.' },
  { question: 'Can the machine process coconut and palm kernel?', answer: 'Yes, Haonuo hydraulic oil presses are highly versatile and can process coconut (VCO), palm kernel, peanuts, sesame seeds, and more. Simply adjust the pressure and temperature settings for each material.' },
  { question: 'Is the machine suitable for VCO (Virgin Coconut Oil) production?', answer: 'Yes, the HN426 Cold Press model is designed specifically for cold pressing below 60°C, preserving the natural aroma and nutrients of coconut. 304 stainless steel construction is available for resistance to coconut water corrosion.' },
  { question: 'Is after-sales service available in Indonesia?', answer: 'We provide technical support via WhatsApp, a complete English installation manual, and video tutorials. Spare parts ship within 48 hours via DHL to Jakarta. For large orders, we can send a technician for on-site installation.' },
];
---

<BaseLayout
  title="Hydraulic Oil Press Machine in Indonesia"
  description="Hydraulic oil press machines for Indonesian coconut, palm & groundnut mills. API/SNI import docs, 380V/50Hz spec, shipping to Jakarta. Factory-direct quote."
  keywords={['oil press machine Indonesia', 'hydraulic oil press Indonesia', 'coconut oil press machine', 'palm oil press machine', 'mesin press minyak']}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-steel-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/markets/" class="hover:text-amber-600">Markets</a>
        <span class="mx-2">/</span>
        <span class="text-charcoal-900 font-medium">Indonesia</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">Hydraulic Oil Press Machines in Indonesia — Factory-Direct Pricing</h1>
      <p class="text-steel-300 text-lg max-w-3xl">Hydraulic oil press machines for coconut (VCO), palm kernel, and peanuts. Factory-direct pricing, 15–20 day shipping to Jakarta, 1-year warranty.</p>
    </div>
  </section>

  <!-- Popular Oilseeds in Indonesia -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Popular Oilseeds in Indonesia</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🌴</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Coconut</h3>
          <p class="text-sm text-steel-600 mb-3">Indonesia is the world's largest coconut producer. Virgin Coconut Oil (VCO) is in strong demand for culinary and cosmetic applications.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 60-65% (copra)</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🫒</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Palm Kernel</h3>
          <p class="text-sm text-steel-600 mb-3">The world's #1 palm producer. Palm kernels yield high-quality oil for cosmetics and food applications.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 44-48%</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🥜</div>
          <h3 class="font-display text-xl text-charcoal-900 mb-2">Peanut</h3>
          <p class="text-sm text-steel-600 mb-3">Peanut oil is a staple in Indonesian cooking, prized for its distinctive flavor in frying and spice pastes.</p>
          <div class="text-amber-500 font-semibold text-sm">Yield: 38-45%</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Import Requirements & Customs -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-4">Import Requirements &amp; Installation Readiness in Indonesia</h2>
      <p class="text-center text-steel-600 mb-12 max-w-3xl mx-auto">Machine imports go smoothly when documents and electrical specifications are prepared <em>before the vessel departs</em>. The three most common causes of extra cost are importer licensing, SNI conformity documents, and voltage mismatches.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">1 · Importer licensing</h3>
          <p class="text-steel-700 text-sm mb-3">Registered importers require an <strong>API-U/API-P</strong> license and a customs identity number (NIK) integrated through <strong>INSW</strong> (Indonesia National Single Window).</p>
          <p class="text-steel-700 text-sm">Work with a PPJK or a freight forwarder experienced in handling industrial machinery imports.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">2 · SNI &amp; technical documents</h3>
          <p class="text-steel-700 text-sm mb-3">For regulated categories, <strong>SNI</strong> marking and a certificate of conformity from an accredited certification body are required; products outside the mandatory list still undergo customs inspection under HS code 8479.82.</p>
          <p class="text-steel-700 text-sm">We provide a factory document package — test reports, electrical diagrams, nameplate, and held certificates — to support this process.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100">
          <h3 class="font-semibold text-lg mb-3 text-charcoal-900">3 · Power &amp; ports</h3>
          <p class="text-steel-700 text-sm mb-3">Indonesia's industrial supply is <strong>380V three-phase, 50Hz</strong> — identical to our production standard; machines are built to the specification you confirm at ordering.</p>
          <p class="text-steel-700 text-sm">Containers typically arrive at <strong>Tanjung Priok, Jakarta</strong>, then continue to Surabaya, Makassar, or Medan as needed.</p>
        </div>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
        <p class="text-charcoal-900 text-sm font-medium mb-2">Planning tip</p>
        <p class="text-steel-700 text-sm">Confirm on-site power supply and backup generator capacity before the machine arrives, and schedule shipping with customs clearance time in mind. The mandatory SNI product list is updated periodically — always verify the latest requirements with your PPJK before ordering.</p>
      </div>
    </div>
  </section>

  <!-- Typical Installations -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Typical Installations in Indonesia</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">Central Java</span>
            <span class="text-steel-500 text-xs">VCO / Coconut</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">VCO Producer — Central Java</p>
          <p class="text-sm text-steel-600 mb-3">The HN426 with a 600mm food-grade barrel processes coconut meat into virgin coconut oil for export and local cosmetic markets.</p>
          <div class="text-xs text-amber-600 font-medium">600mm food-grade barrel</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">North Sumatra</span>
            <span class="text-steel-500 text-xs">Palm Kernel</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Palm Kernel Oil Mill — North Sumatra</p>
          <p class="text-sm text-steel-600 mb-3">The HN365 presses palm kernel into high-quality vegetable oil; the dense cake is sold as animal feed.</p>
          <div class="text-xs text-amber-600 font-medium">Cake for animal feed</div>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">East Java</span>
            <span class="text-steel-500 text-xs">Peanut</span>
          </div>
          <p class="text-charcoal-900 font-medium mb-2">Peanut Oil SME — East Java</p>
          <p class="text-sm text-steel-600 mb-3">The HN325 serves home-based SMEs producing peanut oil for traditional markets and the food seasoning industry.</p>
          <div class="text-xs text-amber-600 font-medium">Capacity: ~40 kg/batch</div>
        </div>
      </div>
      <p class="text-xs text-steel-500 mt-6 text-center">Representative regional installation examples; actual configurations and results vary depending on material preparation and buyer requirements.</p>
    </div>
  </section>

  <!-- Recommended Products -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-10">Recommended Machines for Indonesia</h2>
      <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Main Hydraulic Press Machines</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {mainProducts.map(product => (
            <a
              href={`/products/${product.slug}/`}
              class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
            >
              <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                <img loading="lazy"
                  src={product.data.images[0]}
                  alt={product.data.title.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                />
              </div>
              <div class="p-5">
                <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                <div class="flex flex-wrap gap-2">
                  {product.data.specifications.slice(0, 2).map(spec => (
                    <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                      {spec.name}: {spec.value}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
      </div>
      {auxProducts.length > 0 && (
        <>
          <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">Supporting Equipment</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {auxProducts.map(product => (
              <a
                href={`/products/${product.slug}/`}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img loading="lazy"
                    src={product.data.images[0]}
                    alt={product.data.title.en}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{product.data.model}</div>
                  <h3 class="font-display text-lg text-charcoal-900 mb-2">{product.data.title.en}</h3>
                  <div class="flex flex-wrap gap-2">
                    {product.data.specifications.slice(0, 2).map(spec => (
                      <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                        {spec.name}: {spec.value}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">Get a Price Quote for Indonesia</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">We offer competitive factory-direct pricing on all our oil press machines. Request a formal quote in Rupiah or USD, including shipping to Jakarta.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">🏭</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Factory-Direct Pricing</h3>
          <p class="text-steel-600 text-sm">No middlemen — savings versus local distributors (actual savings vary)</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Complete Quotes</h3>
          <p class="text-steel-600 text-sm">Machine price + shipping + estimated import duties included</p>
        </div>
        <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Quotes in Rupiah</h3>
          <p class="text-steel-600 text-sm">We can provide quotes in Rupiah at the current exchange rate</p>
        </div>
      </div>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        Request a Price Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">Shipping to Indonesia</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Port</h3>
          <p class="text-steel-600">Tanjung Priok, Jakarta</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Transit Time</h3>
          <p class="text-steel-600">15-20 days from China</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">Shipping Cost</h3>
          <p class="text-steel-600">Ask us for current rates</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-12">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((item, i) => (
          <div class="reveal bg-white rounded-xl p-6" style={`animation-delay: ${i * 80}ms`}>
            <h3 class="font-display text-xl text-charcoal-900 mb-3">{item.question}</h3>
            <p class="text-steel-600 leading-relaxed">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to Start Your Oil Business?</h2>
      <p class="text-steel-300 text-lg mb-8">Get a quote in Rupiah, Jakarta shipping estimates, and the right machine recommendation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          Request a Price Quote
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="https://wa.me/8618957149128?text=Hello%20Haonuo%2C%20I%27m%20interested%20in%20your%20oil%20press%20machines%20for%20Indonesia" target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white font-semibold px-8 py-4 rounded-lg hover:bg-green-500 transition-colors text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
