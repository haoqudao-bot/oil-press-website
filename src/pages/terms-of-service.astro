---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: 'https://www.hydoilpress.com/terms-of-service' },
  ],
};
---

<BaseLayout title="Terms of Service" description="Haonuo Machinery Terms of Service - These terms govern your use of our website and services.">
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Terms of Service</span>
      </nav>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-5xl text-charcoal-900 mb-6">Terms of Service</h1>
      <p class="text-steel-600 text-lg mb-8">Last Updated: July 20, 2026</p>

      <div class="space-y-8">
        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">1. Acceptance of Terms</h2>
          <p class="text-steel-600 leading-relaxed">
            By accessing or using our website, you agree to be bound by these Terms of Service ("Terms"). If you do not agree with any part of these Terms, you may not use our website or services.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">2. Use of Website</h2>
          <p class="text-steel-600 leading-relaxed mb-4">
            You may use our website for legitimate business purposes only. You agree not to:
          </p>
          <ul class="list-disc list-inside text-steel-600 space-y-2">
            <li>Use our website for any illegal or unauthorized purpose</li>
            <li>Interfere with or disrupt the operation of our website</li>
            <li>Copy, modify, or distribute any content from our website without permission</li>
            <li>Use automated tools to scrape or crawl our website</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">3. Intellectual Property</h2>
          <p class="text-steel-600 leading-relaxed">
            All content on our website, including text, images, logos, and trademarks, is the property of Shandong Haonuo Machinery Equipment Group Co., Ltd. or its licensors and is protected by copyright and trademark laws. You may not reproduce, distribute, or use any content without our prior written consent.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">4. Product Information</h2>
          <p class="text-steel-600 leading-relaxed">
            We make every effort to ensure that product information on our website is accurate and up-to-date. However, we do not guarantee the accuracy, completeness, or reliability of any product information. Product specifications and prices are subject to change without notice.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">5. Quotes and Orders</h2>
          <p class="text-steel-600 leading-relaxed">
            All quotes provided by us are subject to our terms and conditions and are valid for a specified period. Orders are subject to acceptance by us, and we reserve the right to reject any order for any reason.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">6. Limitation of Liability</h2>
          <p class="text-steel-600 leading-relaxed">
            To the fullest extent permitted by law, Shandong Haonuo Machinery Equipment Group Co., Ltd. shall not be liable for any indirect, incidental, special, or consequential damages arising from your use of our website or services.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">7. Governing Law</h2>
          <p class="text-steel-600 leading-relaxed">
            These Terms shall be governed by and construed in accordance with the laws of the People's Republic of China, without regard to its conflict of laws principles.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">8. Dispute Resolution</h2>
          <p class="text-steel-600 leading-relaxed">
            Any disputes arising from these Terms shall be resolved through friendly negotiation. If negotiation fails, the dispute shall be submitted to the competent court in Qingzhou, Shandong, China.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">9. Changes to These Terms</h2>
          <p class="text-steel-600 leading-relaxed">
            We may update these Terms from time to time. We will notify you of any significant changes by posting the updated terms on our website. Your continued use of our website after any changes constitutes your acceptance of the updated terms.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl text-charcoal-900 mb-4">10. Contact Us</h2>
          <p class="text-steel-600 leading-relaxed">
            If you have any questions about these Terms, please contact us:
          </p>
          <ul class="list-disc list-inside text-steel-600 space-y-2 mt-4">
            <li>Email: contact@hydoilpress.com</li>
            <li>Phone: +86-18957149128</li>
            <li>Address: Qingzhou, Weifang, Shandong, China</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>