---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n';

const t = getTranslations('en');
const productOptions = [
  'HN300 Hydraulic Oil Press',
  'HN325 Hydraulic Oil Press',
  'HN325S Hydraulic Oil Press',
  'HN365 Hydraulic Oil Press',
  'HN400 Hydraulic Oil Press',
  'HN426 Hydraulic Oil Press',
  'HN480B Hydraulic Oil Press',
  'HN500 Hydraulic Oil Press',
  'Sesame Special Oil Press',
  'Coconut/VCO Special Oil Press',
  'Barrel Type Oil Press',
  'Custom / Other Product',
];

const countryOptions = [
  'India', 'Nigeria', 'Pakistan', 'Philippines', 'Kenya',
  'Saudi Arabia', 'UAE', 'Egypt', 'Ghana', 'Tanzania', 'Indonesia',
  'Vietnam', 'Thailand', 'Myanmar', 'Sri Lanka', 'Turkey', 'Iraq',
  'Uganda', 'Kazakhstan', 'Uzbekistan', 'Other',
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hydoilpress.com/' },
    { '@type': 'ListItem', position: 2, name: 'Oil Machine Price', item: 'https://www.hydoilpress.com/oil-machine-price' },
  ],
};

const faqItems = [
  { q: 'Will my oil machine price quote include shipping to my country?', a: 'Yes — we can quote FOB Qingdao, CIF to your nearest port, or DAP door-to-door. Tell us your destination country and port, and we\'ll include a transparent freight estimate in the same quote. We ship worldwide — common ports include Mundra (India), Lagos (Nigeria), Manila (Philippines), Jakarta (Indonesia), Mombasa (Kenya), Alexandria (Egypt), Karachi (Pakistan).' },
  { q: 'I\'m just starting — do you help new buyers figure out what they need?', a: 'Absolutely. Tell us just two things: which oilseed you want to press, and roughly how many kilograms per day. We\'ll suggest the simplest HN model configuration first — no over-engineering, no upselling. If it turns out you need more, we\'ll show you the path to scale.' },
  { q: 'What are the main factors that shape an oil machine price?', a: 'Five factors account for nearly all quote differences: (1) capacity and barrel configuration — single vs double barrel, (2) pressure class — standard 30 MPa vs hard-shell 42–75 MPa, (3) included equipment — press alone vs complete production line, (4) customization — food-grade stainless steel, double-barrel frame, special barrel sizes, (5) shipping terms — FOB Qingdao vs CIF/DAP to your destination port.' },
  { q: 'What are the payment terms and how long does delivery take?', a: 'Payment: 30% T/T deposit to start production, 70% before shipment. L/C at sight available for established customers. Production time: 15–25 working days for standard HN models, 30–45 days for custom configurations (double station, SS304, special barrels). Sea freight to India/Nigeria/Philippines: ~25–35 days from Qingdao.' },
  { q: 'How long does it take to get a quote, and is it free?', a: 'Free, no obligation, and typically within 24 hours on working days. If you just want a rough budget first, send seed type + daily target and we\'ll reply with a quick hint in 1–2 hours. We never pressure buyers — if the quote doesn\'t fit your budget, we\'ll suggest simpler configurations.' },
  { q: 'Can I negotiate the oil machine price for a larger order?', a: 'We manufacture in-house with transparent line items — there is no reseller markup to negotiate away. That said, complete production lines (multiple presses) do qualify for volume consideration on accessories and spare parts. Tell us the full scope and we\'ll quote accordingly.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const priceFactors = [
  { num: '01', title: 'Capacity & Barrel Configuration', desc: 'Single-barrel machines cost less than double-barrel of the same model — the second barrel nearly doubles throughput while one side is loaded. Example: HN325 single vs HN325 double is roughly a 1.8x price difference, not 2x because the hydraulic system is shared.' },
  { num: '02', title: 'Pressure Class', desc: 'Standard presses run at ~30 MPa cake surface pressure (peanut, soybean, sunflower). Hard-shell and cold-press applications (walnut, almond, mustard) need 42 MPa or more. **This single difference can affect the quote by ~15–25%** — thicker barrels, stronger alloy-steel cylinders, and higher-rated pumps are real steel costs.' },
  { num: '03', title: 'Included Equipment', desc: 'The press alone is one price; a complete line (seed cleaner, roaster/steamer, filter press, oil tank, cake handling) is another. Buyers who quote the press in isolation often discover essential equipment they didn\'t budget for. We always quote the full line so you can compare apples to apples.' },
  { num: '04', title: 'Electrical & Customization', desc: 'Motors are wound to your local grid standard (415V/50Hz India, 220V single-phase small workshops, etc.) — usually free on standard models. Food-grade SS304, double-barrel frames, custom barrel sizes, and operator platforms add 5–20% depending on scope.' },
  { num: '05', title: 'Shipping & Delivery Terms', desc: 'FOB Qingdao covers loading only. CIF or DAP terms add sea freight, marine insurance, and sometimes import duty and inland transport. The same machine landed in Lagos vs Mundra vs Manila can differ by $800–$2,000 in freight alone — we\'ll show you the full breakdown.' },
];

const budgetTiers = [
  { label: 'Startup', emoji: '🏠', desc: '500–1,500 kg seed/day. **One single-barrel press** (HN325 class), seed cleaner, roaster or steamer, filter press. Matches small workshops and first-time buyers. One-time investment per line.' },
  { label: 'Commercial', emoji: '🏪', desc: '1,500–3,000 kg seed/day. **One double-barrel press** (HN365 or HN426) — one barrel presses while the other refills. Matched roaster and filtration for all-day batches.' },
  { label: 'Industrial', emoji: '🏭', desc: '3,000 kg+ seed/day. **Multiple double-barrel presses** (HN500 class), automated feed and cake handling, often a small refining line for packaged retail oil.' },
];

const trustStats = [
  { num: '50+', label: 'Countries Served' },
  { num: '15+', label: 'Years Manufacturing' },
  { num: '24h', label: 'Quote Reply Time' },
  { num: '1,000+', label: 'Client Projects' },
];
const trustCountries = ['🇮🇳', '🇳🇬', '🇮🇩', '🇵🇭', '🇰🇪', '🇪🇬', '🇵🇰', '🇧🇩', '🇻🇳', '🇲🇲', '🇺🇸', '🇬🇧', '🇹🇿', '🇬🇭', '🇪🇹'];

const hnModels = [
  { code: 'HN300', tonnage: '300', pressure: '25 MPa', seed: 'Entry-level — peanut, sesame, rapeseed' },
  { code: 'HN325', tonnage: '325', pressure: '27 MPa', seed: 'Best-seller — peanut, sesame, walnut, most seeds' },
  { code: 'HN365', tonnage: '365', pressure: '30 MPa', seed: 'Commercial — higher daily volume, less cycle wait' },
  { code: 'HN426', tonnage: '500', pressure: '42 MPa', seed: 'Cold-press flagship — olive, walnut, hard nuts, premium oils' },
  { code: 'HN500', tonnage: '620', pressure: '52 MPa', seed: 'Industrial — hardest in-shell materials, maximum yield' },
];
---

<BaseLayout
  title="Oil Machine Price — Get Factory Quote in 24 Hours"
  description="Oil machine price from Haonuo factory. Tell us your seed type and daily capacity — get HN model recommendation, FOB/CIF quote, shipping estimate, and equipment list within 24 hours. No middleman, transparent line items."
  keywords={['oil machine price', 'oil press machine price', 'hydraulic oil press price', 'oil extraction machine price', 'oil mill machine price']}
  jsonLd={[breadcrumbLd, faqLd]}
>

  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href="/" class="hover:text-amber-500 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">Oil Machine Price</span>
      </nav>
    </div>
  </section>

  <!-- Hero — 纯内容，无表单 -->
  <section class="bg-steel-900 py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 left-10 w-72 h-72 bg-amber-500 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-sky-500 rounded-full blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <span class="inline-block bg-amber-500/20 text-amber-400 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-5">
            🏭 Factory Direct · Shandong, China · Since 2010
          </span>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white font-bold leading-tight mb-6">
            Tired of Oil Machine Price<br>
            <span class="text-amber-400">Range Lists That Mean Nothing?</span>
          </h1>
          <p class="text-lg text-steel-300 mb-6 leading-relaxed">
            $8,000 – $25,000 is not a price. It's a distraction. We're a real factory — tell us your seed and daily target, get an <strong class="text-amber-300">exact FOB quote in 24 hours</strong>. No middleman. No games.
          </p>
          <a href="#price-form" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-bold px-6 py-3 rounded-lg shadow-lg shadow-amber-500/30 transition-all transform hover:-translate-y-0.5">
            Get My Exact Factory Quote →
          </a>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-steel-800">
          <img src="/images/models/hn426.webp" alt="HN426 hydraulic oil press machine — factory direct" class="w-full h-full object-cover">
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="py-8 bg-steel-50 border-y border-steel-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        {trustStats.map(s => (
          <div class="text-center">
            <div class="text-amber-600 font-display text-2xl md:text-3xl font-bold">{s.num}</div>
            <div class="text-steel-600 text-xs md:text-sm uppercase tracking-wider mt-1">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="text-center text-steel-500 text-xs uppercase tracking-wider mb-3">Machines shipped to</div>
      <div class="flex justify-center gap-2 flex-wrap">
        {trustCountries.map(c => <span class="text-2xl" title="Shipped here before">{c}</span>)}
        <span class="text-xs text-steel-400 self-center ml-2">+ 35 more</span>
      </div>
    </div>
  </section>

  <!-- Why Factory Quotes (positive framing) -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">Our Pricing Philosophy</span>
      <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold mb-4">
        No Misleading Range Lists — Just Exact Factory Quotes
      </h2>
      <p class="text-steel-600 leading-relaxed mb-4">
        A buyer pressing mustard in India and a buyer pressing sesame in Nigeria may order the same HN365 model — but with different barrel configurations, voltage specs, and shipping terms. A public "price from $X" list would mislead both of you.
      </p>
      <p class="text-steel-600 leading-relaxed">
        Instead we give honest, tailored quotes so you pay for exactly what you need — nothing more, nothing less. Tell us your seed type and daily target, and we'll send your full quotation within 24 hours.
      </p>
    </div>
  </section>

  <!-- 5 Price Factors -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">What Shapes the Quote</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">Five Factors That Determine Your Oil Machine Price</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {priceFactors.map(f => (
          <div class="bg-white rounded-xl p-6 border border-steel-100 hover:shadow-lg hover:border-amber-200 transition-all">
            <div class="text-amber-500 font-bold text-2xl mb-3">{f.num}</div>
            <h3 class="font-bold text-charcoal-900 mb-2">{f.title}</h3>
            <p class="text-steel-600 text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Budget Tiers -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">Budget Framework</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">Three Project Tiers — Find Where You Fit</h2>
        <p class="text-steel-500 mt-3">Tell us your daily target and we recommend the exact HN configuration — no over-buying.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {budgetTiers.map(b => (
          <div class="bg-steel-50 rounded-xl p-6 border border-steel-200 hover:border-amber-400 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-4xl">{b.emoji}</span>
              <h3 class="font-bold text-charcoal-900 text-lg">{b.label}</h3>
            </div>
            <p class="text-steel-600 text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products & Company -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">About Haonuo</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">HN Hydraulic Oil Press Models · Factory-Direct since 2010</h2>
        <p class="text-steel-500 mt-3">From 300-ton small workshops to 620-ton industrial lines — one factory, five models, no middleman.</p>
      </div>

      <!-- HN Model Table -->
      <div class="overflow-x-auto mb-10">
        <table class="w-full text-sm bg-white rounded-xl overflow-hidden border border-steel-200">
          <thead class="bg-steel-900 text-white">
            <tr>
              <th class="px-5 py-3 text-left font-bold">Model</th>
              <th class="px-5 py-3 text-left font-bold">Tonnage</th>
              <th class="px-5 py-3 text-left font-bold">Pressure</th>
              <th class="px-5 py-3 text-left font-bold">Best For</th>
            </tr>
          </thead>
          <tbody>
            {hnModels.map((m, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-steel-50'}>
                <td class="px-5 py-3 font-bold text-amber-600">{m.code}</td>
                <td class="px-5 py-3 text-charcoal-900">{m.tonnage} tons</td>
                <td class="px-5 py-3 text-charcoal-900">{m.pressure}</td>
                <td class="px-5 py-3 text-steel-600">{m.seed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Factory Photos -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/painting-workshop.webp" alt="Haonuo factory painting workshop" class="w-full h-full object-cover">
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/quality-control.webp" alt="Haonuo quality control lab" class="w-full h-full object-cover">
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/warehouse.webp" alt="Haonuo finished machine warehouse" class="w-full h-full object-cover">
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img src="/images/factory/office-building.webp" alt="Haonuo factory office building" class="w-full h-full object-cover">
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">FAQ</span>
        <h2 class="font-display text-2xl md:text-3xl text-charcoal-900 font-bold">Oil Machine Price — Frequently Asked Questions</h2>
      </div>
      <div class="space-y-3" id="faq-container">
        {faqItems.map((item, idx) => (
          <div class="faq-item bg-steel-50 rounded-xl border border-steel-200 overflow-hidden">
            <button class="faq-q w-full text-left px-5 py-4 flex items-center justify-between gap-4 hover:bg-white transition-colors" onclick={`toggleFaq(${idx})`}>
              <span class="font-semibold text-charcoal-900 pr-4" set:html={item.q}></span>
              <span class="chev text-amber-500 text-xl font-bold shrink-0 transition-transform duration-200">+</span>
            </button>
            <div class="faq-a hidden px-5 pb-5 text-steel-600 text-sm leading-relaxed bg-white" set:html={item.a}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 询盘表单（移到底部！） -->
  <section id="price-form" class="py-14 md:py-20 bg-steel-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="font-display text-3xl md:text-4xl text-white font-bold leading-tight mb-4">
            Your Factory Quote Comes With<br>
            <span class="text-amber-400">All 5 of These — Guaranteed</span>
          </h2>
          <p class="text-steel-300 mb-5 leading-relaxed">
            No range lists, no vague "from $X". One tailored quote, transparent line items, no surprise extras. Here's exactly what you get:
          </p>
          <ul class="space-y-2.5 text-steel-200 text-sm mb-6">
            <li class="flex items-start gap-2.5"><span class="text-amber-400 mt-0.5 text-base leading-none">✓</span><span><strong class="text-amber-300">HN model match</strong> — engineered for your seed type and daily target</span></li>
            <li class="flex items-start gap-2.5"><span class="text-amber-400 mt-0.5 text-base leading-none">✓</span><span><strong class="text-amber-300">Exact FOB Qingdao price</strong> — every line item broken out</span></li>
            <li class="flex items-start gap-2.5"><span class="text-amber-400 mt-0.5 text-base leading-none">✓</span><span><strong class="text-amber-300">Shipping to your port</strong> — CIF or DAP, real-time ocean rates</span></li>
            <li class="flex items-start gap-2.5"><span class="text-amber-400 mt-0.5 text-base leading-none">✓</span><span><strong class="text-amber-300">Full equipment list</strong> — press + accessories, no missing pieces</span></li>
            <li class="flex items-start gap-2.5"><span class="text-amber-400 mt-0.5 text-base leading-none">✓</span><span><strong class="text-amber-300">Production + payment timeline</strong> — 15–25 day lead times standard</span></li>
          </ul>
          <div class="flex flex-wrap gap-4 text-xs text-steel-400 mb-4">
            <span class="flex items-center gap-1.5"><span class="text-amber-400">✓</span> Free & no obligation</span>
            <span class="flex items-center gap-1.5"><span class="text-amber-400">✓</span> Reply in 24 working hours</span>
            <span class="flex items-center gap-1.5"><span class="text-amber-400">✓</span> Factory-direct, no middleman</span>
          </div>
          <p class="text-steel-400 text-xs">Prefer email or WhatsApp? <a href="mailto:info@hydoilpress.com" class="text-amber-400 hover:underline">info@hydoilpress.com</a> · <span class="text-amber-400">+86 189 5714 9128</span></p>
        </div>
        <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
            <h2 class="font-display text-2xl text-charcoal-900 mb-2">{t.contact.sendInquiry}</h2>
            <p class="text-sm text-steel-500 mb-6">{t.contact.response24h}</p>
            <form id="contact-form" action="/api/inquiry" method="POST" class="space-y-5" onsubmit="return submitForm(event)">
              <input type="hidden" name="source" value={t.contact.formSubject} />
              <input type="text" name="_gotcha" style="display:none" />
              <div class="cf-turnstile" data-sitekey="0x4AAAAAAFIiDuJVsJp4_WlY"></div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.name} *</label>
                  <input type="text" id="name" name="name" required placeholder={t.contact.namePlaceholder} class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.email} *</label>
                  <input type="email" id="email" name="email" required placeholder="your@email.com" class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.phoneLabel}</label>
                  <input type="tel" id="phone" name="phone" placeholder={t.contact.phonePlaceholder} class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.company}</label>
                  <input type="text" id="company" name="company" placeholder={t.contact.companyPlaceholder} class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="country" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.country}</label>
                  <input type="text" id="country" name="country" list="country-list" placeholder={t.contact.countryPlaceholder} autocomplete="off" class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm" />
                  <datalist id="country-list">
                    {countryOptions.map(country => (
                      <option value={country}>{country}</option>
                    ))}
                  </datalist>
                </div>
                <div>
                  <label for="product" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.productInterestLabel}</label>
                  <input type="text" id="product" name="product" list="product-list" placeholder={t.contact.productPlaceholder} autocomplete="off" class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm" />
                  <datalist id="product-list">
                    {productOptions.map(product => (
                      <option value={product}>{product}</option>
                    ))}
                  </datalist>
                </div>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-charcoal-900 mb-1.5">{t.contact.message} *</label>
                <p class="text-xs text-steel-500 mb-1.5">{t.contact.messageHint}</p>
                <textarea id="message" name="message" required rows="5" placeholder={t.contact.messagePlaceholder} class="w-full px-4 py-3 rounded-lg border border-steel-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition-colors text-sm resize-none"></textarea>
              </div>
              <button type="submit" id="submit-btn" class="btn-primary text-base w-full justify-center">
                <span id="btn-text">{t.contact.submit}</span>
                <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </form>
            <div id="form-success" class="hidden text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-green-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.contact.inquirySent}</h3>
              <p class="text-steel-500">{t.contact.inquirySentDesc}</p>
              <button type="button" id="form-another" class="btn-outline mt-6 mx-auto">{t.contact.sendAnother}</button>
            </div>
            <div id="form-error" class="hidden text-center py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-red-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">{t.contact.inquiryFailed}</h3>
              <p class="text-steel-500">{t.contact.inquiryFailedDesc}</p>
            </div>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
  function toggleFaq(idx) {
    const items = document.querySelectorAll('.faq-item');
    const item = items[idx];
    const answer = item.querySelector('.faq-a');
    const chev = item.querySelector('.chev');
    item.classList.toggle('open');
    answer.classList.toggle('hidden');
    chev.textContent = item.classList.contains('open') ? '×' : '+';
    chev.classList.toggle('rotate-45');
  }
  const form = document.getElementById('contact-form');
  if (form) {
    const inputs = form.querySelectorAll('input[required], textarea[required]');
    inputs.forEach(input => {
      input.addEventListener('invalid', function(e) {
        e.preventDefault();
        if (!input.value.trim()) { input.setCustomValidity('This field is required'); }
        else { input.setCustomValidity(''); }
        input.reportValidity();
      });
      input.addEventListener('input', function() { input.setCustomValidity(''); });
    });
  }
  function submitForm(event) {
    event.preventDefault();
    const form = event.target;
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const successDiv = document.getElementById('form-success');
    const errorDiv = document.getElementById('form-error');
    const formData = new FormData(form);
    const turnstileResponse = form.querySelector('input[name="cf-turnstile-response"]');
    if (turnstileResponse) { formData.append('cf-turnstile-response', turnstileResponse.value); }
    submitBtn.disabled = true;
    btnText.textContent = 'Sending...';
    btnIcon.style.display = 'none';
    fetch(form.action, { method: 'POST', body: formData, headers: { 'Accept': 'application/json' } })
    .then(response => {
      if (response.ok) {
        form.reset();
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
        if (typeof gtag === 'function') { gtag('event', 'generate_lead', { currency: 'USD', value: 1 }); }
      } else { throw new Error('Submission failed'); }
    })
    .catch(() => { form.classList.add('hidden'); errorDiv.classList.remove('hidden'); })
    .finally(() => { submitBtn.disabled = false; btnText.textContent = 'Send Inquiry'; btnIcon.style.display = ''; });
    return false;
  }
  window.submitForm = submitForm;
  document.getElementById('form-another')?.addEventListener('click', () => {
    document.getElementById('form-success')?.classList.add('hidden');
    document.getElementById('form-error')?.classList.add('hidden');
    const f = document.getElementById('contact-form');
    if (f) { f.reset(); f.classList.remove('hidden'); }
    if (window.turnstile) window.turnstile.reset();
  });
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
