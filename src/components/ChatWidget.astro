---
import { type Locale, getTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const whatsappMessage = locale === 'fr'
  ? "Bonjour, je suis intéressé par vos presses à huile hydrauliques. Pourriez-vous m'en dire plus ?"
  : locale === 'ar'
  ? "مرحبا، أنا مهتم بمعاصر الزيت الهيدروليكية الخاصة بكم. يرجى إرسال مزيد من المعلومات."
  : locale === 'id'
  ? "Halo, saya tertarik dengan mesin press minyak hidraulik Anda. Bisakah Anda memberikan informasi lebih lanjut?"
  : "Hello, I'm interested in your oil press products.";

const whatsappUrl = `https://wa.me/8618957149128?text=${encodeURIComponent(whatsappMessage)}`;
const wechatId = '18957149128';
const wechatHint = locale === 'fr'
  ? 'Ajoutez-nous sur WeChat'
  : locale === 'ar'
  ? 'أضفنا على وي تشات'
  : locale === 'id'
  ? 'Tambahkan kami di WeChat'
  : 'Add us on WeChat';
const wechatCopyHint = locale === 'fr'
  ? 'ID WeChat copié !'
  : locale === 'ar'
  ? 'تم نسخ معرف وي تشات!'
  : locale === 'id'
  ? 'ID WeChat disalin!'
  : 'WeChat ID copied!';
const widgetId = `chat-widget-${locale}`;
---

<div id={widgetId} class="fixed bottom-6 right-6 z-50 no-print">
  <div id={`${widgetId}-panel`} class="hidden mb-4 bg-white rounded-2xl shadow-2xl border border-steel-100 w-72 overflow-hidden">
    <div class="bg-steel-900 text-white px-5 py-4 flex items-center justify-between">
      <h3 class="font-display text-lg">{t.chat.title}</h3>
      <button data-close-chat class="text-steel-300 hover:text-white transition-colors" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="p-4 space-y-3">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-xl bg-green-50 hover:bg-green-100 transition-colors group">
        <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </div>
        <div>
          <div class="font-medium text-charcoal-900 text-sm">{t.chat.whatsapp}</div>
          <div class="text-xs text-steel-500">+86 18957149128</div>
        </div>
      </a>

      <button data-wechat-trigger type="button" class="w-full flex items-center gap-3 p-3 rounded-xl bg-green-50 hover:bg-green-100 transition-colors group">
        <div class="w-10 h-10 bg-green-600 rounded-full flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348z"/></svg>
        </div>
        <div class="text-left flex-1">
          <div class="font-medium text-charcoal-900 text-sm">{t.chat.wechat}</div>
          <div class="text-xs text-steel-500">{wechatHint}</div>
        </div>
      </button>

      <div data-wechat-popup class="hidden rounded-xl border border-steel-200 bg-steel-50 p-3">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-steel-600">{wechatHint}</span>
          <button data-copy-wechat type="button" class="text-xs text-amber-600 hover:text-amber-700 font-medium">📋 Copy</button>
        </div>
        <div class="flex items-center gap-2">
          <code class="flex-1 bg-white px-2 py-1.5 rounded text-sm font-mono text-charcoal-900 border border-steel-200">{wechatId}</code>
        </div>
        <div data-copy-toast class="hidden mt-1 text-xs text-green-600">{wechatCopyHint}</div>
      </div>

      <a href="mailto:info@hydoilpress.com" class="flex items-center gap-3 p-3 rounded-xl bg-amber-50 hover:bg-amber-100 transition-colors group">
        <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div>
          <div class="font-medium text-charcoal-900 text-sm">{t.chat.email}</div>
          <div class="text-xs text-steel-500">info@hydoilpress.com</div>
        </div>
      </a>
    </div>
  </div>

  <button data-toggle-chat class="w-14 h-14 bg-amber-500 hover:bg-amber-600 text-charcoal-900 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center" aria-label={t.chat.title}>
    <svg id={`${widgetId}-icon-open`} xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <svg id={`${widgetId}-icon-close`} class="hidden w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<script is:inline define:vars={{ widgetId, wechatId }}>
  (function() {
    const widget = document.getElementById(widgetId);
    if (!widget) return;
    const panel = widget.querySelector('[id$="-panel"]');
    const btn = widget.querySelector('[data-toggle-chat]');
    const closeBtn = widget.querySelector('[data-close-chat]');
    const iconOpen = widget.querySelector('[id$="-icon-open"]');
    const iconClose = widget.querySelector('[id$="-icon-close"]');

    const wechatTrigger = widget.querySelector('[data-wechat-trigger]');
    const wechatPopup = widget.querySelector('[data-wechat-popup]');
    const copyBtn = widget.querySelector('[data-copy-wechat]');
    const copyToast = widget.querySelector('[data-copy-toast]');

    function toggle(show) {
      const willShow = show !== undefined ? show : panel.classList.contains('hidden');
      panel.classList.toggle('hidden', !willShow);
      iconOpen.classList.toggle('hidden', willShow);
      iconClose.classList.toggle('hidden', !willShow);
      if (!willShow && wechatPopup) wechatPopup.classList.add('hidden');
    }

    btn.addEventListener('click', () => toggle());
    closeBtn.addEventListener('click', () => toggle(false));

    if (wechatTrigger && wechatPopup) {
      wechatTrigger.addEventListener('click', () => {
        wechatPopup.classList.toggle('hidden');
      });
    }

    if (copyBtn && copyToast) {
      copyBtn.addEventListener('click', () => {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(wechatId).then(() => {
            copyToast.classList.remove('hidden');
            setTimeout(() => copyToast.classList.add('hidden'), 2000);
          });
        } else {
          const ta = document.createElement('textarea');
          ta.value = wechatId;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          copyToast.classList.remove('hidden');
          setTimeout(() => copyToast.classList.add('hidden'), 2000);
        }
      });
    }
  })();
</script>
