---
import { type Locale, getTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const whatsappMessage = locale === 'fr'
  ? "Bonjour, je suis intéressé par vos presses à huile hydrauliques. Pourriez-vous m'en dire plus ?"
  : locale === 'ar'
  ? "مرحبا، أنا مهتم بمعاصر الزيت الهيدروليكية الخاصة بكم. يرجى إرسال مزيد من المعلومات."
  : locale === 'id'
  ? "Halo, saya tertarik dengan mesin press minyak hidraulik Anda. Bisakah Anda memberikan informasi lebih lanjut?"
  : "Hello, I'm interested in your oil press products.";

const whatsappUrl = `https://wa.me/8618957149128?text=${encodeURIComponent(whatsappMessage)}`;
---

<div class="fixed bottom-6 right-6 z-50 no-print">
  <div class="relative">
    <span data-chat-ripple class="absolute inset-0 block rounded-full pointer-events-none"></span>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="relative w-14 h-14 bg-[#25D366] hover:bg-[#1EBE5D] text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center animate-chat-bob"
      aria-label="WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M22.114 9.857A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>
</div>

<script is:inline>
  (function() {
    const ripple = document.querySelector('[data-chat-ripple]');
    if (!ripple) return;

    // first ripple shortly after page load
    setTimeout(() => {
      ripple.classList.remove('chat-ripple');
      void ripple.offsetWidth;
      ripple.classList.add('chat-ripple');
    }, 1500);

    // recurring ripple every ~3.8s
    setInterval(() => {
      ripple.classList.remove('chat-ripple');
      void ripple.offsetWidth;
      ripple.classList.add('chat-ripple');
    }, 3800);
  })();
</script>

<style is:inline>
  .animate-chat-bob {
    animation: chat-bob 2.4s ease-in-out infinite;
  }
  @keyframes chat-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  [data-chat-ripple] {
    transform: scale(1);
    opacity: 0;
  }
  [data-chat-ripple].chat-ripple {
    animation: chat-ripple 1.6s ease-out forwards;
    background-color: #25D366 !important;
  }
  @keyframes chat-ripple {
    0% { transform: scale(1); opacity: 0.45; }
    80% { opacity: 0; }
    100% { transform: scale(2.6); opacity: 0; }
  }
</style>
