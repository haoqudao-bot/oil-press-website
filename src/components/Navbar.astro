<style>
  /* Transparent overlay mode — used over the homepage hero */
  #main-navbar.nav-overlay.is-scrolled {
    background-color: rgba(16, 42, 67, 0.96);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 24px -12px rgba(10, 26, 43, 0.6);
  }
  #main-navbar.nav-overlay .ov-nav > div > a,
  #main-navbar.nav-overlay .ov-nav > a {
    color: rgba(255, 255, 255, 0.92);
  }
  #main-navbar.nav-overlay .ov-nav a:hover,
  #main-navbar.nav-overlay .ov-nav a.text-amber-500 {
    color: #F0B429;
  }
  #main-navbar.nav-overlay .ov-nav button {
    color: rgba(255, 255, 255, 0.92);
  }
  #main-navbar.nav-overlay .ov-lang {
    color: rgba(255, 255, 255, 0.9);
  }
  #main-navbar.nav-overlay .ov-lang:hover {
    color: #ffffff;
  }
  #main-navbar.nav-overlay .ov-menu {
    color: #ffffff;
  }
  #main-navbar.nav-overlay .ov-logo1 {
    color: #ffffff;
  }
  #main-navbar.nav-overlay .ov-logo2 {
    color: rgba(255, 255, 255, 0.7);
  }
</style>

<script>
  // Scroll shadow / solid background
  const navbar = document.getElementById('main-navbar');
  function onScroll() {
    if (window.scrollY > 10) {
      navbar?.classList.add('shadow-md');
    } else {
      navbar?.classList.remove('shadow-md');
    }
    if (navbar?.classList.contains('nav-overlay')) {
      navbar.classList.toggle('is-scrolled', window.scrollY > 40);
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Mobile accordion
  document.querySelectorAll('.mobile-accordion-btn').forEach(accordionBtn => {
    accordionBtn.addEventListener('click', () => {
      const content = (accordionBtn.parentElement as HTMLElement)?.querySelector('.mobile-accordion-content');
      const arrow = accordionBtn.querySelector('svg');
      content?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });

  // Language switching is now handled by real <a href> links (also enables crawler discovery)
</script>
