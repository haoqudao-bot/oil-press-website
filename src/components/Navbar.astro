  { href: '/solutions/shea-butter-pressing/', label: (t as any).common?.sheaButter || t.nav.sheaButter },
  { href: '/solutions/castor-oil-pressing/', label: t.nav.castorOil },
  { href: '/solutions/avocado-oil-pressing/', label: t.nav.avocadoOil },
