                <!-- Comparisons & Tools -->
                <div>
                  <p class="px-3 py-1 text-xs font-semibold text-steel-400 uppercase tracking-wider">⚖️ {(t as any).common?.comparisons || 'Comparisons'}</p>
                  {comparisonItems.map(item => (
                    <a href={localePath(item.href)} class="block px-3 py-2 text-sm text-steel-600 hover:text-amber-500 hover:bg-amber-50 rounded-lg transition-colors">
