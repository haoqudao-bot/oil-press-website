            <div class="bg-white rounded-xl shadow-xl border border-steel-100 p-4 min-w-[400px]">
              <div class="grid grid-cols-2 gap-x-6 gap-y-1">
                <!-- Guides & Tutorials -->
                <div>
                  <p class="px-3 py-1 text-xs font-semibold text-amber-600 uppercase tracking-wider">📖 {(t as any).common?.guidesTutorials || 'Guides & Tutorials'}</p>
