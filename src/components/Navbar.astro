  class:list={[
    'z-10 no-print transition-[background-color,box-shadow,border-color] duration-300',
    overlay
      ? 'nav-overlay relative bg-transparent border-transparent'
      : 'relative bg-white/95 backdrop-blur-sm border-b border-steel-100'
  ]}
