<script>
  // Scroll shadow
  const navbar = document.getElementById('main-navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      navbar?.classList.add('shadow-md');
    } else {
      navbar?.classList.remove('shadow-md');
    }
  });

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Mobile accordion
  document.querySelectorAll('.mobile-accordion-btn').forEach(accordionBtn => {
    accordionBtn.addEventListener('click', () => {
      const content = (accordionBtn.parentElement as HTMLElement)?.querySelector('.mobile-accordion-content');
      const arrow = accordionBtn.querySelector('svg');
      content?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });

  // Language switcher - navigate to locale URL
  document.querySelectorAll('.lang-switch-btn').forEach(langBtn => {
    langBtn.addEventListener('click', () => {
      const lang = langBtn.getAttribute('data-lang');
      if (!lang) return;

      const currentPath = window.location.pathname;
      const pathWithoutLocale = currentPath.replace(/^\/(fr|ar|id)(\/|$)/, '/');

      if (lang === 'en') {
        window.location.href = pathWithoutLocale + window.location.search;
      } else {
        const cleanPath = pathWithoutLocale === '/' ? '' : pathWithoutLocale;
        window.location.href = `/${lang}${cleanPath}${window.location.search}`;
      }
    });
  });
</script>
