---
import { getTranslations } from '../i18n';

const { locale = 'en', overlay = false } = Astro.props;
const currentPath = Astro.url.pathname || '/';

const t = getTranslations(locale as any);

const localeLabels: Record<string, string> = { en: '🇬🇧 EN', fr: '🇫🇷 FR', ar: '🇸🇦 العربية', id: '🇮🇩 ID' };
const localeFlags: Record<string, string> = { en: '🇬🇧', fr: '🇫🇷', ar: '🇸🇦', id: '🇮🇩' };
const locales = ['en', 'fr', 'ar', 'id'] as const;

// Pages that only exist in English (no [locale] version)
// Value: '' = stay on English page; '/path' = redirect to locale version of that path
const englishOnlyPages: Record<string, string> = {};

function localePath(path: string): string {
  if (locale === 'en') return path;
  // Check if path is an English-only page with a locale fallback
  if (englishOnlyPages[path] !== undefined) {
    const fallback = englishOnlyPages[path];
    return fallback ? `/${locale}${fallback}` : path;
  }
  return `/${locale}${path}`;
}

// Per-locale URLs of the CURRENT page — rendered as real <a href> links so
// search engines can discover and crawl the fr/ar/id equivalents (not just via sitemap).
let currentPathNoLocale = Astro.url.pathname.replace(/^\/(fr|ar|id)(?=\/|$)/, '');
if (!currentPathNoLocale) currentPathNoLocale = '/';
if (!/\.[a-z0-9]+$/i.test(currentPathNoLocale) && !currentPathNoLocale.endsWith('/')) {
  currentPathNoLocale += '/';
}
function switchHref(targetLocale: string): string {
  if (targetLocale === 'en') return currentPathNoLocale;
  return currentPathNoLocale === '/' ? `/${targetLocale}/` : `/${targetLocale}${currentPathNoLocale}`;
}

const productsSubItems = [
  { href: '/products/hydraulic-oil-press/', label: t.nav.hydraulicOilPress },
  { href: '/products/seed-processing-equipment/', label: t.nav.seedProcessing },
  { href: '/products/roasting-steaming-equipment/', label: t.nav.roastingSteaming },
  { href: '/products/filtration-refining-equipment/', label: t.nav.filtrationRefining },
];

// Mega menu: individual products per category (desktop hover only)
const megaMenuColumns = [
  {
    headerHref: '/products/hydraulic-oil-press/',
    headerLabel: t.nav.hydraulicOilPress,
    products: [
      { href: '/products/standard-hydraulic-oil-press/', label: 'Standard (HN325)' },
      { href: '/products/hn365-hydraulic-oil-press/', label: 'Commercial (HN365)' },
      { href: '/products/cold-press-hydraulic-oil-press/', label: 'Cold Press (HN426)' },
      { href: '/products/ultra-high-pressure-hydraulic-oil-press/', label: 'Ultra High Pressure (HN500)' },
      { href: '/products/large-barrel-hydraulic-oil-press/', label: 'Sludge Dewatering Press' },
    ],
  },
  {
    headerHref: '/products/seed-processing-equipment/',
    headerLabel: t.nav.seedProcessing,
    products: [
      { href: '/products/high-speed-seed-crusher/', label: 'High Speed Crusher' },
      { href: '/products/industrial-seed-crusher/', label: 'Industrial Cake Crusher' },
      { href: '/products/integrated-feeder-crusher-roaster/', label: 'Integrated Feeder Crusher' },
      { href: '/products/oilseed-pre-press/', label: 'Oilseed Pre-Press' },
