  { href: '/resources/oil-press-raw-materials-guide/', label: ((t as any).nav?.guideRawMaterials || 'Raw Materials Guide') },
  { href: '/resources/how-to-maximize-oil-yield/', label: ((t as any).nav?.guideYieldImprovement || 'Maximize Oil Yield') },
  { href: '/resources/hydraulic-oil-press-maintenance-guide/', label: ((t as any).nav?.guideMaintenance || 'Maintenance Guide') },
  { href: '/resources/oil-press-electrical-requirements-guide/', label: ((t as any).nav?.guideElectrical || 'Electrical Guide') },
  { href: '/resources/crude-oil-filtration-guide/', label: ((t as any).nav?.guideFiltration || 'Oil Filtration') },
  { href: '/resources/aflatoxin-control-guide/', label: ((t as any).nav?.guideAflatoxin || 'Aflatoxin Control') },
