	                <ul class="space-y-1">
	                  <li class="px-3 py-1 text-xs font-semibold text-steel-400 uppercase tracking-wider">{(t as any).common?.byRegion || 'By Region'}</li>
	                  <li class="mb-1">
	                    <a href={localePath('/markets/')} class="block px-3 py-1.5 text-xs font-semibold text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors">
	                      🌍 {(t as any).common?.allMarkets || 'All Markets'} <span class="ml-1 text-[10px] bg-amber-200 text-amber-800 px-1.5 py-0.5 rounded-full">{(t as any).common?.fiftyPlusCountries || '50+ Countries'}</span>
	                    </a>
	                  </li>
