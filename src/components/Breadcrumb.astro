﻿﻿﻿﻿﻿﻿---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<section class="bg-steel-50 py-4 border-b border-steel-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-2 text-sm text-steel-500" aria-label="Breadcrumb">
      {items.map((item, index) => (
        <>
          {index > 0 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          )}
          {item.href ? (
            <a href={item.href} class="hover:text-amber-500 transition-colors whitespace-nowrap">{item.label}</a>
          ) : (
            <span class="text-charcoal-900 font-semibold truncate">{item.label}</span>
          )}
        </>
      ))}
    </nav>
  </div>
</section>
