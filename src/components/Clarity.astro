---
const CLARITY_ID = 'y148gpq3n6';
---

<script is:inline>
  // GDPR/UK GDPR：仅在访客点击 Accept（或此前已同意）后才加载 Clarity
  (function() {
    function hasConsent() {
      return document.cookie.split(';').some(function(row) {
        return row.trim().indexOf('haonuo_cookie_consent=accepted') === 0;
      });
    }

    var loaded = false;
    function loadClarity() {
      if (loaded || !hasConsent()) return;
      loaded = true;
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y148gpq3n6");
    }

    loadClarity();
    document.addEventListener('haonuo-consent-changed', loadClarity);
  })();
</script>
