---
import type { MarketData } from '../../data/en-market-data';

interface Props {
  locale: 'en' | 'fr' | 'ar' | 'id';
  marketData: MarketData;
  market: string;
  mainProducts: any[];
  auxProducts: any[];
  localePath: (path: string) => string;
  shippingLabels: { port: string; transit: string; cost: string };
  productGroupLabels: { core: string; matching: string };
  breadcrumbHome: string;
  breadcrumbMarkets: string;
  breadcrumbMarket: string;
}

const {
  locale, marketData, market, mainProducts, auxProducts,
  localePath, shippingLabels, productGroupLabels,
  breadcrumbHome, breadcrumbMarkets, breadcrumbMarket,
} = Astro.props;

const isRTL = locale === 'ar';
const whatsappNumber = '8618957149128';
const baseUrl = 'https://www.hydoilpress.com';
const locPrefix = locale === 'en' ? '' : `/${locale}`;

// Seed name → solution slug mapping (covers all name variants across market data)
const seedToSolutionSlug: Record<string, string> = {
  // Peanut / Groundnut variants
  'Peanut': 'peanut-oil-pressing',
  'Groundnut': 'peanut-oil-pressing',
  'Groundnut (Peanut)': 'peanut-oil-pressing',
  'Peanut/Groundnut': 'peanut-oil-pressing',

  // Coconut variants
  'Coconut': 'coconut-oil-pressing',
  'Coconut (VCO)': 'coconut-oil-pressing',

  // Others
  'Sesame': 'sesame-oil-pressing',
  'Olive': 'olive-oil-pressing',
  'Sunflower': 'sunflower-oil-pressing',
  'Mustard': 'mustard-oil-pressing',
  'Shea Butter': 'shea-butter-pressing',
  'Palm Kernel': 'palm-oil-pressing',
  'Cottonseed': 'cottonseed-oil-pressing',
  'Soybean': 'soybean-oil-pressing',
  'Rapeseed': 'flaxseed-oil-pressing',     // no dedicated rapeseed page → fallback
  'Canola': 'flaxseed-oil-pressing',      // same
  'Flaxseed': 'flaxseed-oil-pressing',
  'Linseed': 'flaxseed-oil-pressing',
  'Walnut': 'walnut-oil-pressing',
  'Almond': 'almond-oil-pressing',
  'Avocado': 'avocado-oil-pressing',
  'Castor': 'castor-oil-pressing',
  'Rice Bran': 'rice-bran-oil-pressing',
  'Moringa': '',                           // no page → skip
  'Hemp': '',                              // no page → skip
  'Animal Fat': 'animal-fat-oil-pressing',
};

function productTitle(p: any) {
  return p.data.title[locale] || p.data.title.en;
}
function productModel(p: any) {
  if (locale === 'id' && p.data.modelId) return p.data.modelId;
  if (locale === 'fr' && p.data.modelFr) return p.data.modelFr;
  return p.data.model;
}
function productSpecs(p: any) {
  if (locale === 'id' && p.data.specificationsId?.length > 0) return p.data.specificationsId;
  if (locale === 'ar' && p.data.specificationsAr?.length > 0) return p.data.specificationsAr;
  if (locale === 'fr' && p.data.specificationsFr?.length > 0) return p.data.specificationsFr;
  return p.data.specifications;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: breadcrumbHome, item: `${baseUrl}${locPrefix}/` },
    { '@type': 'ListItem', position: 2, name: breadcrumbMarkets, item: `${baseUrl}${locPrefix}/markets/` },
    { '@type': 'ListItem', position: 3, name: breadcrumbMarket, item: `${baseUrl}${locPrefix}/markets/${market}/` },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: marketData.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---
<div class={isRTL ? 'rtl-content' : ''}>

  <!-- Breadcrumb -->
  <section class="bg-steel-50 py-4 border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-steel-500">
        <a href={localePath('/')} class="hover:text-amber-500 transition-colors">{breadcrumbHome}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href={localePath('/markets/')} class="hover:text-amber-500 transition-colors">{breadcrumbMarkets}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-charcoal-900 font-semibold">{breadcrumbMarket}</span>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-steel-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4">{marketData.heroTitle}</h1>
      <p class="text-steel-300 text-lg max-w-3xl">{marketData.heroDesc}</p>
    </div>
  </section>

  <!-- Popular Oilseeds -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{marketData.seedsTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {marketData.seeds.map(seed => {
          const solutionSlug = seedToSolutionSlug[seed.name];
          const wrapperClass = "bg-steel-50 rounded-2xl p-6 border border-steel-100";
          const cardClass = "card-hover bg-steel-50 rounded-2xl p-6 border border-steel-100 block group cursor-pointer hover:border-amber-300 transition-all";
          if (solutionSlug) {
            return (
              <a href={localePath(`/solutions/${solutionSlug}/`)} class={cardClass}>
                <div class="text-3xl mb-3">{seed.emoji}</div>
                <h3 class="font-display text-xl text-charcoal-900 mb-2 group-hover:text-amber-600 transition-colors">{seed.name}</h3>
                <p class="text-sm text-steel-600 mb-3">{seed.description}</p>
                <div class="text-amber-500 font-semibold text-sm">{seed.yield} →</div>
              </a>
            );
          }
          return (
            <div class={wrapperClass}>
              <div class="text-3xl mb-3">{seed.emoji}</div>
              <h3 class="font-display text-xl text-charcoal-900 mb-2">{seed.name}</h3>
              <p class="text-sm text-steel-600 mb-3">{seed.description}</p>
              <div class="text-amber-500 font-semibold text-sm">{seed.yield}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Import & Customs Clearance (UNIFIED LAYOUT) -->
  {marketData.clearance && (
    <section class="py-12 md:py-16 bg-steel-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-center mb-4">{marketData.clearance.heading}</h2>
        <p class="text-center text-steel-600 mb-12 max-w-3xl mx-auto">{marketData.clearance.intro}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
          <div>
            <h3 class="font-display font-bold text-lg mb-5 text-charcoal-900">{marketData.clearance.stepsTitle}</h3>
            <div class="space-y-4">
              {marketData.clearance.steps.map((step, i) => (
                <div class="flex gap-4 items-start bg-white rounded-xl p-5 border border-steel-100">
                  <div class="w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{i + 1}</div>
                  <div><p class="font-semibold text-charcoal-900 text-sm">{step.title}</p><p class="text-steel-600 text-sm mt-1">{step.description}</p></div>
                </div>
              ))}
            </div>
          </div>
          <div class="space-y-6">
            <div class="bg-white rounded-2xl p-6 border border-steel-100">
              <h3 class="font-display font-bold text-lg mb-5 text-charcoal-900">{marketData.clearance.docsTitle}</h3>
              <ul class="space-y-2 text-steel-700 text-sm list-disc pl-5">
                {marketData.clearance.docs.map(doc => <li>{doc}</li>)}
              </ul>
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
              <p class="text-charcoal-900 text-sm font-medium mb-2">{marketData.clearance.powerNoteTitle}</p>
              <p class="text-steel-700 text-sm">{marketData.clearance.powerNote} <a href={localePath('/resources/oil-press-electrical-requirements-guide/')} class="text-amber-700 underline">{marketData.clearance.powerNoteLink}</a></p>
            </div>
            <p class="text-xs text-steel-500">{marketData.clearance.disclaimer}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Customer Cases -->
  {marketData.cases && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title mb-12">{marketData.cases.heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {marketData.cases.cases.map(item => (
            <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
              <div class="flex items-center gap-2 mb-3">
                <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full">{item.tag}</span>
                <span class="text-steel-500 text-xs">{item.tagLabel}</span>
              </div>
              <p class="text-charcoal-900 font-medium mb-2">{item.name}</p>
              <p class="text-sm text-steel-600 mb-3">{item.description}</p>
              <div class="text-xs text-amber-600 font-medium">{item.stat}</div>
            </div>
          ))}
        </div>
        <p class="text-xs text-steel-500 mt-6 text-center">{marketData.cases.footnote}</p>
      </div>
    </section>
  )}

  <!-- Recommended Products -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-10">{marketData.productsTitle}</h2>
      <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">{productGroupLabels.core}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {mainProducts.map(product => (
          <a
            href={localePath(`/products/${product.slug}/`)}
            class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
          >
            <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
              <img
                src={product.data.images[0]}
                alt={productTitle(product)}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
              />
            </div>
            <div class="p-5">
              <div class="text-xs text-amber-500 font-medium mb-1">{productModel(product)}</div>
              <h3 class="font-display text-lg text-charcoal-900 mb-2">{productTitle(product)}</h3>
              <div class="flex flex-wrap gap-2">
                {productSpecs(product).slice(0, 2).map((spec: any) => (
                  <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                    {spec.name}: {spec.value}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
      {auxProducts.length > 0 && (
        <>
          <h3 class="font-display font-bold text-xl text-charcoal-900 mb-6">{productGroupLabels.matching}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {auxProducts.map(product => (
              <a
                href={localePath(`/products/${product.slug}/`)}
                class="card-hover bg-white rounded-2xl overflow-hidden border border-steel-100 group"
              >
                <div class="aspect-[4/3] bg-steel-100 overflow-hidden">
                  <img
                    src={product.data.images[0]}
                    alt={productTitle(product)}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.src='https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=Industrial%20oil%20press%20machine%20product%20photo&image_size=landscape_4_3'"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs text-amber-500 font-medium mb-1">{productModel(product)}</div>
                  <h3 class="font-display text-lg text-charcoal-900 mb-2">{productTitle(product)}</h3>
                  <div class="flex flex-wrap gap-2">
                    {productSpecs(product).slice(0, 2).map((spec: any) => (
                      <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">
                        {spec.name}: {spec.value}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Get a Customized Quote -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title mb-6">{marketData.quoteTitle}</h2>
      <p class="text-steel-600 text-lg mb-6 max-w-2xl mx-auto">{marketData.quoteDesc}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        {marketData.quoteCards.map(card => (
          <div class="bg-steel-50 rounded-2xl p-6 border border-steel-100">
            <div class="text-3xl mb-3">{card.emoji}</div>
            <h3 class="font-display text-lg text-charcoal-900 mb-2">{card.title}</h3>
            <p class="text-steel-600 text-sm">{card.description}</p>
          </div>
        ))}
      </div>
      <a href={localePath('/contact/')} class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
        {marketData.quoteCta}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- Shipping Info -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-12">{marketData.shippingTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">🚢</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">{shippingLabels.port}</h3>
          <p class="text-steel-600">{marketData.shipping.port}</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">⏱️</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">{shippingLabels.transit}</h3>
          <p class="text-steel-600">{marketData.shipping.transitTime}</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-steel-100 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-display text-lg text-charcoal-900 mb-2">{shippingLabels.cost}</h3>
          <p class="text-steel-600">{marketData.shipping.cost}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-steel-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title text-center mb-8">{marketData.faqTitle}</h2>
      <div class="space-y-4">
        {marketData.faqs.map((item, i) => (
          <details class="reveal group bg-steel-50 rounded-xl overflow-hidden" style={`animation-delay: ${i * 80}ms`}>
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none hover:bg-steel-100 transition-colors">
              <span class="font-display text-lg text-charcoal-900">{item.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-6 pb-4 text-steel-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-steel-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">{marketData.ctaTitle}</h2>
      <p class="text-steel-300 text-lg mb-8">{marketData.ctaDesc}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localePath('/contact/')} class="inline-flex items-center justify-center gap-2 bg-amber-500 text-charcoal-900 font-semibold px-8 py-4 rounded-lg hover:bg-amber-400 transition-colors text-lg">
          {marketData.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(marketData.whatsappText)}`} target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white font-semibold px-8 py-4 rounded-lg hover:bg-green-500 transition-colors text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</div>
