---
// 新款产品页通用决策漏斗组件（V4.4 设计稿结构）
// HN325 / HN365 / HN426 / HN500 共用；型号差异全部通过 strings 数据文件 + product frontmatter 注入
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { HN325Locale, HN325Strings } from '../../data/hn325-page';

interface Props { product: any; locale: HN325Locale; strings: HN325Strings; waLink: string; }
const { product, locale, strings: s, waLink } = Astro.props;

const allProducts = await getCollection('products');
const relatedProducts = product.data.related
  .map((sl: string) => allProducts.find((p) => p.slug === sl))
  .filter(Boolean)
  .slice(0, 3);
const relatedTitle = { en: 'Related Products', fr: 'Produits Associés', ar: 'منتجات ذات صلة', id: 'Produk Terkait' }[locale];

const pageTitle = product.data.seoTitle?.[locale] || product.data.title[locale];
const pageDesc = product.data.description?.[locale] || product.data.title[locale];

const specKey = locale === 'en' ? 'specifications' : `specifications${locale.charAt(0).toUpperCase()}${locale.slice(1)}`;
const faqKey = locale === 'en' ? 'faq' : `faq${locale.charAt(0).toUpperCase()}${locale.slice(1)}`;
const specs = product.data[specKey] || product.data.specifications || [];
const faq = product.data[faqKey] || product.data.faq || [];

const splitRow = (row: string) => row.split('|');
const fitRows = s.fitRows.map(splitRow);
const yieldRows = s.yieldRows.map(splitRow);
const lineRows = s.lineRows.map(splitRow);
const delRows = s.delRows.map(splitRow);

const base = locale === 'en' ? '' : `/${locale}`;
const img = product.data.images[0];
const imgAlt = product.data.imageAlt?.[locale] || product.data.imageAlt?.en || pageTitle;
const selfUrl = `https://www.hydoilpress.com${base}/products/${product.slug}/`;

const faqLd = faq.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((item: any) => ({
    '@type': 'Question', name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.crumbHome, item: `https://www.hydoilpress.com${base}/` },
    { '@type': 'ListItem', position: 2, name: s.crumbProducts, item: `https://www.hydoilpress.com${base}/products/` },
    { '@type': 'ListItem', position: 3, name: product.data.title[locale], item: selfUrl },
  ],
};
const productLd = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: product.data.title[locale],
  brand: { '@type': 'Brand', name: 'Haonuo' },
  category: product.data.category, sku: product.data.model,
  image: `https://www.hydoilpress.com${img}`,
  description: pageDesc,
};
const allLd = [breadcrumbLd, productLd];
if (faqLd) allLd.push(faqLd);
---
<BaseLayout locale={locale} title={pageTitle} description={pageDesc} keywords={product.data.seoKeywords} jsonLd={allLd} ogImage={`https://www.hydoilpress.com${img}`}>
<div class="hnf">
  <div class="page">
    <div class="crumb"><div class="crumb-in">
      <a href={`${base}/`}>{s.crumbHome}</a> › <a href={`${base}/products/`}>{s.crumbProducts}</a> › <a href={`${base}/products/`}>{s.crumbCat}</a> › {s.crumbCurrent}
    </div></div>

    <!-- Hero -->
    <section class="section hero">
      <div class="hero-grid">
        <div class="hero-img">
          <img src={img} alt={imgAlt} width="800" height="600" loading="eager" />
        </div>
        <div>
          <span class="cat-chip">{s.catChip}</span>
          <h1 class="display">{s.h1}</h1>
          <div class="model-line">{s.modelLine}</div>
          <div class="best-line">{s.bestLine}</div>
          <p class="sub">{s.sub}</p>
          <div class="badges">
            {s.badges.map((b) => <Fragment set:html={`<span class="badge">${b}</span>`} />)}
          </div>
          <div class="cta-col">
            <a class="btn btn-amber" href={`${base}/contact/`}>{s.btnQuote}</a>
            <a class="btn btn-wa" href={waLink} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>{s.btnWa}</a>
          </div>
          <div class="trust-bar" set:html={s.trustBar} />
        </div>
      </div>
    </section>

    <!-- 规格 + 材质 -->
    <section class="section">
      <h2>{s.h2Specs}</h2>
      <div class="two-col">
        <div class="col-module">
          <h3>{s.specsH3}</h3>
          <div class="tbl-wrap"><table>
            {specs.map((spec: any) => (
              <tr><td>{spec.name}</td><td set:html={spec.value} /></tr>
            ))}
          </table></div>
        </div>
        <div class="col-module">
          <h3>{s.matH3}</h3>
          <div class="tbl-wrap"><table>
            <tr><th>{s.matHeaders[0]}</th><th>{s.matHeaders[1]}</th></tr>
            {s.matRows.map((row) => (
              <tr><td>{row[0]}</td><td>{row[1]}</td></tr>
            ))}
          </table></div>
          <p class="small-note" set:html={s.matNote} />
        </div>
      </div>
    </section>

    <!-- 产能 -->
    <section class="section">
      <h2>{s.h2Cap}</h2>
      <div class="two-col">
        <div class="col-module">
          <h3>{s.capH3}</h3>
          <div class="tbl-wrap"><table>
            {s.capHeaders ? (
              <tr><th>{s.capHeaders[0]}</th><th>{s.capHeaders[1]}</th><th>{s.capHeaders[2]}</th></tr>
            ) : null}
            {s.capRows.map((row) => (
              <tr><td>{row[0]}</td><td>{row[1]}</td>{row[2] !== undefined && <td>{row[2]}</td>}</tr>
            ))}
          </table></div>
          <p class="small-note" set:html={s.capNote} />
        </div>
        <div class="col-module">
          <h3>{s.cycH3}</h3>
          <div class="tbl-wrap"><table>
            {s.cycRows.map((row) => (
              <tr><td>{row[0]}</td><td>{row[1]}</td></tr>
            ))}
          </table></div>
          <h3 style="margin-top:12px">{s.powerH3}</h3>
          <p style="font-size:13.5px" set:html={s.powerP} />
        </div>
      </div>
    </section>

    <!-- 对比表 -->
    <section class="section">
      <h2>{s.h2Fit}</h2>
      <div class="tbl-wrap"><table>
        <tr>{s.fitHeaders.map((h) => <th>{h}</th>)}</tr>
        {fitRows.map((row, i) => (
          <tr class={i === (s.fitHighlight ?? 1) ? 'hl' : undefined}>
            {row.map((cell) => <td set:html={cell} />)}
          </tr>
        ))}
      </table></div>
      <p class="small-note" set:html={s.fitNote} />
      <div class="cta-strip">
        <div><div class="t">{s.stripT}</div><div class="s">{s.stripS}</div></div>
        <a class="btn btn-amber" href={`${base}/contact/`}>{s.stripBtn}</a>
      </div>
    </section>

    <!-- 油料指南 -->
    <section class="section">
      <h2>{s.h2Oil}</h2>
      <p set:html={s.oilIntro} />
      <div class="two-col">
        <div class="col-module">
          <h3>{s.yieldH3}</h3>
          <div class="tbl-wrap"><table>
            <tr><th>{s.yieldHeaders[0]}</th><th>{s.yieldHeaders[1]}</th><th>{s.yieldHeaders[2]}</th></tr>
            {yieldRows.map((row) => (
              <tr><td>{row[0]}</td><td set:html={row[1]} /><td set:html={row[2]} /></tr>
            ))}
          </table></div>
          <p class="small-note" set:html={s.yieldNote} />
        </div>
        <div class="col-module">
          <h3>{s.lineH3}</h3>
          <div class="tbl-wrap"><table>
            <tr><th>{s.lineHeaders[0]}</th><th>{s.lineHeaders[1]}</th></tr>
            {lineRows.map((row) => (
              <tr><td>{row[0]}</td><td>{row[1]}</td></tr>
            ))}
          </table></div>
          <p style="font-size:13.5px;margin-top:10px" set:html={s.lineP1} />
          <p style="font-size:13.5px" set:html={s.lineP2} />
        </div>
      </div>
    </section>

    <!-- 配套 + 交期 -->
    <section class="section">
      <h2>{s.h2Setup}</h2>
      <p set:html={s.setupP} />
      <h2 style="margin-top:20px">{s.h2Del}</h2>
      <div class="tbl-wrap"><table>
        {delRows.map((row) => (
          <tr><td style="width:38%">{row[0]}</td><td>{row[1]}</td></tr>
        ))}
      </table></div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <h2>{s.h2Faq}</h2>
      {faq.map((item: any, i: number) => (
        <details open={i === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <!-- 相关产品 -->
    {relatedProducts.length > 0 && (
    <section class="section">
      <h2>{relatedTitle}</h2>
      <div class="rel-grid">
        {relatedProducts.map((rp) => (
          <a class="rel-card" href={`${base}/products/${rp.slug}/`}>
            <div class="rel-img"><img src={rp.data.images[0]} alt={rp.data.title[locale]} width="400" height="300" loading="lazy" /></div>
            <div class="rel-body">
              <div class="rel-model">{rp.data.model}</div>
              <h3>{rp.data.title[locale]}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
    )}

    <!-- 底部 CTA -->
    <section class="section cta-final">
      <h2 class="display">{s.finalH2}</h2>
      <p>{s.finalP}</p>
      <div class="cta-row cta-center">
        <a class="btn btn-amber" href={`${base}/contact/`}>{s.finalBtn1}</a>
        <a class="btn btn-wa-solid" href={waLink} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>{s.finalBtn2}</a>
      </div>
      <div class="trust-mini" set:html={s.trustMini} />
    </section>
  </div>
</div>

<style is:global>
.hnf{font-family:'Inter',system-ui,sans-serif;background:#fff;color:#1A1A2E;line-height:1.6;padding:0}
.hnf .display{font-family:'Bebas Neue','Inter',sans-serif;letter-spacing:.5px}
.hnf .page{max-width:none;margin:0;background:#fff}
.hnf .section{padding:28px 36px;border-bottom:1px solid #d9e2ec}
.hnf .section:last-child{border-bottom:none}
.hnf .section > *{max-width:1180px;margin-left:auto;margin-right:auto}
.hnf .crumb{font-size:12px;color:#627d98;padding:12px 36px;background:#f0f4f8;border-bottom:1px solid #d9e2ec}
.hnf .crumb-in{max-width:1180px;margin:0 auto}
.hnf .crumb a{color:#627d98;text-decoration:none}
.hnf .crumb a:hover{text-decoration:underline}
.hnf .hero{background:#f0f4f8}
.hnf .hero-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:28px;align-items:start}
@media(max-width:900px){.hnf .hero-grid{grid-template-columns:1fr}}
.hnf .hero-img{background:#fff;border:1px solid #bcccdc;border-radius:10px;height:400px;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:10px}
.hnf .hero-img img{width:100%;height:100%;object-fit:contain}
.hnf .cat-chip{display:inline-block;background:#F0B429;color:#1A1A2E;font-size:13px;font-weight:600;padding:4px 14px;border-radius:999px;margin-bottom:10px}
.hnf .hero h1{font-size:36px;line-height:1.1;color:#1A1A2E;margin:0}
.hnf .model-line{font-size:15px;color:#627d98;margin:6px 0 8px}
.hnf .best-line{display:inline-block;background:linear-gradient(90deg,#fdf3dd,#f8e7bd);border:1px solid #F0B429;color:#8a6116;font-size:13.5px;font-weight:700;border-radius:8px;padding:6px 14px;margin-bottom:12px}
.hnf .hero .sub{font-size:15px;color:#486581;margin-bottom:12px}
.hnf .badges{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}
.hnf .badge{background:#fff;border:1px solid #bcccdc;border-radius:8px;padding:7px 12px;font-size:12.5px;color:#3D3D56}
.hnf .badge b{color:#486581}
.hnf .cta-row{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 12px}
.hnf .btn{display:inline-block;padding:12px 26px;border-radius:8px;font-size:15px;font-weight:600;text-decoration:none;transition:all .3s}
.hnf .btn-amber{background:#E8A838;color:#1A1A2E}
.hnf .btn-amber:hover{background:#D69E2E}
.hnf .cta-col{display:flex;flex-direction:column;gap:10px;margin:0 0 14px}
.hnf .cta-col .btn{width:100%;text-align:center}
.hnf .btn-wa{display:flex;align-items:center;justify-content:center;gap:8px;border:2px solid #25D366;color:#25D366;background:#fff;padding:10px 24px}
.hnf .btn-wa:hover{background:#25D366;border-color:#25D366;color:#fff}
.hnf .btn-wa-solid{display:flex;align-items:center;justify-content:center;gap:8px;border:2px solid #16a34a;background:#16a34a;color:#fff}
.hnf .btn-wa-solid:hover{background:#22c55e;border-color:#22c55e}
.hnf .btn-wa svg,.hnf .btn-wa-solid svg{width:18px;height:18px;fill:currentColor;flex:none}
.hnf .cta-final .cta-row{justify-content:center;margin-left:auto;margin-right:auto}
.hnf .trust-bar{display:flex;align-items:center;gap:8px;background:#ecfdf5;border:1px solid #a7f3d0;color:#059669;border-radius:8px;padding:10px 16px;font-size:13.5px;font-weight:600;flex-wrap:wrap}
.hnf .section h2{font-size:25px;margin-bottom:12px;color:#1A1A2E}
.hnf .section h3{font-size:16px;margin:0 0 6px;color:#1A1A2E}
.hnf .section p{font-size:14.5px;color:#486581;margin-bottom:10px}
.hnf .section a{color:#486581;font-weight:600}
.hnf .section a.btn-amber{color:#1A1A2E}
.hnf .section a.btn-wa{color:#25D366}
.hnf .section a.btn-wa:hover{color:#fff}
.hnf .section a.btn-wa-solid{color:#fff}
.hnf .two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
@media(max-width:860px){.hnf .two-col{grid-template-columns:1fr}}
.hnf .col-module{background:#f0f4f8;border:1px solid #d9e2ec;border-radius:10px;padding:18px 20px}
.hnf .col-module h3{margin-bottom:8px}
.hnf table{width:100%;border-collapse:collapse;font-size:12.5px;margin:8px 0;background:#fff}
.hnf th{background:#f0f4f8;text-align:left;padding:8px 10px;border:1px solid #bcccdc;font-size:11.5px;color:#486581}
.hnf td{padding:8px 10px;border:1px solid #bcccdc;color:#1A1A2E}
.hnf tr.hl td{background:#fdf3dd;font-weight:700}
.hnf .small-note{font-size:11.5px;color:#627d98}
.hnf .small-note a{color:#486581}
.hnf .cta-strip{display:flex;align-items:center;justify-content:space-between;gap:16px;background:#f0f4f8;border:1px solid #bcccdc;border-radius:10px;padding:16px 22px;flex-wrap:wrap;margin-top:18px}
.hnf .cta-strip .t{font-size:16px;font-weight:700;color:#1A1A2E}
.hnf .cta-strip .s{font-size:13px;color:#486581}
.hnf details{border:1px solid #bcccdc;border-radius:8px;margin-bottom:10px;background:#fff}
.hnf summary{padding:12px 16px;font-size:14.5px;font-weight:600;cursor:pointer;list-style:none;color:#1A1A2E}
.hnf summary::-webkit-details-marker{display:none}
.hnf summary:before{content:"+";float:left;margin-right:10px;color:#486581;font-weight:700}
.hnf details[open] summary:before{content:"–"}
.hnf details p{padding:0 16px 14px 36px;font-size:14px;color:#486581;margin:0}
.hnf .cta-final{background:#1B3A5C;color:#d9e2ec;text-align:center;padding:64px 36px}
.hnf .cta-final h2{color:#fff;font-size:40px}
.hnf .cta-final p{color:#9fb3c8;font-size:16px;max-width:640px;margin:0 auto 28px}
.hnf .cta-final .btn{padding:14px 32px;font-size:16px}
.hnf .cta-final .trust-mini{font-size:12.5px;color:#9fb3c8;margin-top:24px}
.hnf .cta-final .trust-mini b{color:#4ade80}
.hnf .rel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:14px}
@media(max-width:860px){.hnf .rel-grid{grid-template-columns:1fr}}
.hnf .rel-card{display:block;background:#fff;border:1px solid #d9e2ec;border-radius:10px;overflow:hidden;text-decoration:none;transition:box-shadow .3s}
.hnf .rel-card:hover{box-shadow:0 6px 20px rgba(27,58,92,.12)}
.hnf .rel-img{aspect-ratio:4/3;background:#f0f4f8;overflow:hidden}
.hnf .rel-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.hnf .rel-card:hover .rel-img img{transform:scale(1.05)}
.hnf .rel-body{padding:14px 16px}
.hnf .rel-model{font-size:12px;color:#D69E2E;font-weight:600;margin-bottom:4px}
.hnf .rel-body h3{font-size:16px;color:#1A1A2E;margin:0}
.hnf .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
@media(max-width:640px){
  .hnf .section{padding:22px 16px}
  .hnf .crumb{padding:10px 16px}
  .hnf .hero-img{height:260px}
  .hnf .hero h1{font-size:28px}
  .hnf .section h2{font-size:21px}
  .hnf .section h3{font-size:15px}
  .hnf .col-module{padding:14px 12px}
  .hnf table{font-size:12px}
  .hnf th,.hnf td{padding:7px 8px}
  .hnf .cta-strip{padding:14px 16px}
  .hnf .cta-final{padding:44px 16px}
  .hnf .cta-final h2{font-size:28px}
  .hnf .cta-final .btn{padding:13px 20px}
  .hnf details p{padding:0 14px 12px 30px}
  .hnf .cta-row .btn{flex:1;text-align:center;min-width:140px}
}
</style>
</BaseLayout>
