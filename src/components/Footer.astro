﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
const { locale = 'en' } = Astro.props;
import { getTranslations } from '../i18n';
const t = getTranslations(locale as any);

const wechatId = '18957149128';
const wechatQrUrl = `https://api.qrserver.com/v1/create-qr-code/?data=${encodeURIComponent(wechatId)}&size=150x150&margin=10`;
const wechatLabel = locale === 'fr' ? 'Ajoutez sur WeChat' : locale === 'ar' ? 'أضف على وي تشات' : locale === 'id' ? 'Tambahkan di WeChat' : 'Add on WeChat';
const wechatScanHint = locale === 'fr' ? 'Scannez pour ajouter' : locale === 'ar' ? 'امسح للإضافة' : locale === 'id' ? 'Pindai untuk menambahkan' : 'Scan to add';

function localePath(path: string): string {
  if (locale === 'en') return path;
  return `/${locale}${path}`;
}

const quickLinks = [
  { href: '/', label: t.nav.home },
  { href: '/products', label: t.nav.products },
  { href: '/solutions', label: t.nav.solutions },
  { href: '/resources', label: t.nav.resources },
  { href: '/about', label: t.nav.about },
  { href: '/contact', label: t.nav.contact },
];

const productLinks = [
  { href: '/products/hydraulic-oil-press', label: t.nav.hydraulicOilPress },
  { href: '/products/seed-processing-equipment', label: t.nav.seedProcessing },
  { href: '/products/roasting-steaming-equipment', label: t.nav.roastingSteaming },
  { href: '/products/filtration-refining-equipment', label: t.nav.filtrationRefining },
];
---

<footer class="bg-charcoal-900 text-steel-200 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Company Info -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center">
            <span class="text-charcoal-900 font-display text-xl font-bold">HN</span>
          </div>
          <span class="font-display text-lg text-white tracking-wide leading-tight">
            HAONUO<br />
            <span class="text-xs font-normal tracking-widest">MACHINERY</span>
          </span>
        </div>
        <p class="text-steel-400 text-sm leading-relaxed mb-4">
          {t.footer.companyDesc}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-display text-lg text-white mb-4">{t.footer.quickLinks}</h3>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={localePath(link.href)} class="text-sm text-steel-400 hover:text-amber-500 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Products -->
      <div>
        <h3 class="font-display text-lg text-white mb-4">{t.nav.products}</h3>
        <ul class="space-y-2">
          {productLinks.map(link => (
            <li>
              <a href={localePath(link.href)} class="text-sm text-steel-400 hover:text-amber-500 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="font-display text-lg text-white mb-4">{t.footer.contactInfo}</h3>
        <ul class="space-y-3 text-sm text-steel-400">
          <!-- Email -->
          <li class="flex items-start gap-2">
            <div class="w-5 h-5 bg-amber-500 rounded flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-charcoal-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <div class="text-xs text-steel-500">{t.chat.email}</div>
              <a href="mailto:info@hydoilpress.com" class="font-semibold text-amber-400 hover:text-amber-300 transition-colors break-all">info@hydoilpress.com</a>
            </div>
          </li>
          <!-- WeChat -->
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18z"/></svg>
            <div>
              <div class="text-xs text-steel-500">{t.chat.wechat}</div>
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-medium">{wechatId}</span>
                <button data-copy-wechat-footer type="button" class="text-amber-500 hover:text-amber-400 text-xs font-medium transition-colors">{t.chat.copyId}</button>
                <span data-copy-wechat-toast class="hidden text-green-500 text-xs">{t.chat.copied}</span>
              </div>
            </div>
          </li>
          <!-- Phone -->
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <div>
              <div class="text-xs text-steel-500">{t.contact.phone}</div>
              <div class="flex items-center gap-1.5 flex-wrap">
                <a href="tel:+8618957149128" class="hover:text-amber-500 transition-colors font-medium">+86 18957149128</a>
                <button data-copy-phone-footer type="button" class="text-amber-500 hover:text-amber-400 text-xs font-medium transition-colors">{t.chat.copyId}</button>
                <span data-copy-phone-toast class="hidden text-green-500 text-xs">{t.chat.copied}</span>
              </div>
            </div>
          </li>
          <!-- WhatsApp -->
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M22.114 9.857A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <div>
              <div class="text-xs text-steel-500">{t.chat.whatsapp}</div>
              <a href="https://wa.me/8618957149128" target="_blank" rel="noopener noreferrer" class="hover:text-green-400 transition-colors font-medium">+86 18957149128</a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-6 pt-6 border-t border-charcoal-800 text-center text-sm text-steel-500">
      <div class="flex flex-wrap justify-center gap-4 mb-4">
        <a href={localePath('/privacy-policy')} class="hover:text-amber-500 transition-colors">{t.footer.privacy}</a>
        <a href={localePath('/terms-of-service')} class="hover:text-amber-500 transition-colors">{t.footer.terms}</a>
        <a href={localePath('/cookie-policy')} class="hover:text-amber-500 transition-colors">{t.footer.cookie}</a>
      </div>
      <p>{t.footer.copyright}</p>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ wechatId }}>
  function setupCopy(btnSelector, toastSelector, text) {
    const btn = document.querySelector(btnSelector);
    const toast = document.querySelector(toastSelector);
    if (!btn || !toast) return;

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const copyText = typeof text === 'function' ? text() : text;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(copyText).then(() => {
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 2000);
        });
      } else {
        const ta = document.createElement('textarea');
        ta.value = copyText;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2000);
      }
    });
  }

  // WeChat QL popup (for ChatWidget wechat items)
  document.querySelectorAll('[data-wechat-container]').forEach(container => {
    const popup = container.querySelector('[data-wechat-popup]');
    if (!popup) return;

    function showPopup() {
      popup.style.opacity = '1';
      popup.style.visibility = 'visible';
      popup.style.pointerEvents = 'auto';
    }

    function hidePopup() {
      popup.style.opacity = '0';
      popup.style.visibility = 'hidden';
      popup.style.pointerEvents = 'none';
    }

    container.addEventListener('mouseenter', showPopup);
    container.addEventListener('mouseleave', hidePopup);
  });

  // Footer copy buttons
  setupCopy('[data-copy-wechat-footer]', '[data-copy-wechat-toast]', wechatId);
  setupCopy('[data-copy-phone-footer]', '[data-copy-phone-toast]', '+8618957149128');
</script>
