---
interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
function localePath(p: string) { return locale === 'en' ? p : `/${locale}${p}`; }

function getCookieText() {
  const texts = {
    en: {
      message: 'We use cookies to analyse traffic and improve your experience. Continuing to browse means you accept them.',
      accept: 'Accept',
      reject: 'Reject',
      learnMore: 'Cookie Policy',
    },
    fr: {
      message: 'Nous utilisons des cookies pour analyser le trafic et améliorer votre expérience. En continuant à naviguer, vous les acceptez.',
      accept: 'Accepter',
      reject: 'Refuser',
      learnMore: 'Politique de cookies',
    },
    ar: {
      message: 'نستخدم ملفات تعريف الارتباط لتحليل الزيارات وتحسين تجربتك. استمرارك في التصفح يعني موافقتك عليها.',
      accept: 'قبول',
      reject: 'رفض',
      learnMore: 'سياسة ملفات تعريف الارتباط',
    },
    id: {
      message: 'Kami menggunakan cookie untuk menganalisis lalu lintas dan meningkatkan pengalaman Anda. Melanjutkan penjelajahan berarti Anda menyetujui cookie tersebut.',
      accept: 'Terima',
      reject: 'Tolak',
      learnMore: 'Kebijakan Cookie',
    },
  };
  return texts[locale as keyof typeof texts] || texts.en;
}

const text = getCookieText();
---

<div id="cookie-consent-banner" class="relative z-20 bg-charcoal-900 text-white border-b border-charcoal-700 no-print shadow-md">
  <div class="max-w-7xl mx-auto px-4 py-2.5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
    <div class="flex items-center gap-3 flex-1 min-w-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
        <path d="M8.5 8.5v.01"/><path d="M16 15.5v.01"/><path d="M12 12v.01"/><path d="M11 17v.01"/><path d="M7 14v.01"/>
      </svg>
      <p class="text-xs sm:text-sm text-steel-200 leading-snug">{text.message}</p>
    </div>
    <div class="flex items-center gap-2 sm:gap-3 justify-end flex-wrap">
      <a href={localePath('/cookie-policy/')} class="text-amber-500 hover:text-amber-400 text-xs whitespace-nowrap">{text.learnMore}</a>
      <button id="cookie-reject" class="px-3 py-1.5 border border-steel-600 hover:border-amber-500 text-steel-300 hover:text-amber-500 rounded text-xs transition-colors whitespace-nowrap">
        {text.reject}
      </button>
      <button id="cookie-accept" class="px-4 py-1.5 bg-amber-500 hover:bg-amber-600 text-charcoal-900 font-semibold rounded text-xs transition-colors whitespace-nowrap">
        {text.accept}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var cookieName = 'haonuo_cookie_consent';
    var banner = document.getElementById('cookie-consent-banner');
    if (!banner) return;

    var implicitAttached = false;
    var timeoutId = null;

    function hasStoredChoice() {
      return document.cookie.split(';').some(function(row) {
        return row.trim().indexOf(cookieName + '=') === 0;
      });
    }

    function setConsent(accepted) {
      document.cookie = cookieName + '=' + (accepted ? 'accepted' : 'rejected') + '; expires=' + new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString() + '; path=/';
      banner.style.display = 'none';
      // Explicit choice wins: stop implicit listeners so a later scroll cannot flip a Reject to Accept
      detachImplicitConsent();
      // Notify GA/Clarity and other third-party scripts: only load after consent
      document.dispatchEvent(new CustomEvent('haonuo-consent-changed', { detail: accepted }));
    }

    // Implicit consent (EDPB-recognised): scrolling / tapping / clicking the page
    // counts as accepting analytics cookies. Banner stays visible until then,
    // and clicking the banner's own buttons is handled explicitly, not here.
    function onFirstInteraction(event) {
      if (event && event.target && banner.contains(event.target)) return;
      if (hasStoredChoice()) { detachImplicitConsent(); return; }
      setConsent(true);
    }

    function attachImplicitConsent() {
      if (implicitAttached) return;
      implicitAttached = true;
      window.addEventListener('scroll', onFirstInteraction, { passive: true, capture: true });
      document.addEventListener('click', onFirstInteraction, true);
      document.addEventListener('touchstart', onFirstInteraction, { passive: true, capture: true });
      // Fallback: 5 s of staying on the page also counts as implicit acceptance,
      // catching visitors who read the hero and leave without scrolling/tapping.
      timeoutId = setTimeout(function() {
        if (implicitAttached && !hasStoredChoice()) setConsent(true);
      }, 5000);
    }

    function detachImplicitConsent() {
      if (!implicitAttached) return;
      implicitAttached = false;
      if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; }
      window.removeEventListener('scroll', onFirstInteraction, true);
      document.removeEventListener('click', onFirstInteraction, true);
      document.removeEventListener('touchstart', onFirstInteraction, true);
    }

    // Hide immediately if user already chose (inline script runs right after the banner node to avoid flicker)
    if (hasStoredChoice()) {
      banner.style.display = 'none';
    } else {
      attachImplicitConsent();
    }

    document.getElementById('cookie-accept').addEventListener('click', function() { setConsent(true); });
    document.getElementById('cookie-reject').addEventListener('click', function() { setConsent(false); });
  })();
</script>
