{
  "name": "oil-press-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/strip-html-comments.mjs && node scripts/add-html-alias.mjs",
    "postbuild": "node scripts/site-audit.mjs && node scripts/verify-gptbot.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "audit": "node scripts/site-audit.mjs",
    "verify-gptbot": "node scripts/verify-gptbot.mjs",
    "release": "npm run build",
    "verify-live": "node scripts/verify-gptbot.mjs --url https://www.hydoilpress.com"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "adm-zip": "^0.5.17",
    "astro": "^5.18.2",
    "docx": "^9.15.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "sharp": "^0.35.2",
    "typescript": "^5.7.3"
  }
}
